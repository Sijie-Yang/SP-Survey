# Default local ports match README: Admin :3000, API :3001.
# CRA and Express both read .env, so do not set PORT here or both processes
# will fight for the same port.

# ── Change ports (split the files) ───────────────────────────────────────────
# .env (Express only)
# PORT=3021
# CLIENT_ORIGIN=http://localhost:3020
#
# .env.local (CRA only)
# PORT=3020
# REACT_APP_API_URL=http://localhost:3021

CLIENT_ORIGIN=http://localhost:3000

# ── Supabase (optional — can also configure per-project in Admin UI) ─────────
# REACT_APP_SUPABASE_URL=https://your-project.supabase.co
# REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key

# Per-project Supabase credentials (service role + anon) are saved in the
# Admin → Media → Supabase Storage Configuration panel.

# ── AI Assistant ─────────────────────────────────────────────────────────────
# Add your own provider keys in Assistant settings. This app never supplies
# free or subsidized models.
