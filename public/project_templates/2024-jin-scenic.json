  "spSite": {
   "id": "site-44d68237ae058991",
   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Scenic Beauty of Waterfront Planting</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Scenic Beauty of Waterfront Planting\",\n    \"description\": \"Scenic Beauty Estimation (SBE) of 32 waterfront plant landscape units in Xingqing Palace Park, Xi'an. Each unit is shown as two photos; rate the landscape from 1 (poor) to 5 (high scenic beauty). Rebuilt from Jin & Miao (2024), PLOS ONE.\",\n    \"locale\": \"en\",\n    \"mediaFolders\": [\"garden\"],\n    \"pages\": [\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" },\n        { \"type\": \"radiogroup\", \"name\": \"rater_group\", \"title\": \"Which describes you best?\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"design_or_aesthetics\", \"text\": \"I study or teach landscape design, environmental aesthetics or a related field\" },\n          { \"value\": \"visitor\", \"text\": \"I am visiting the park (or parks like it) as a visitor\" },\n          { \"value\": \"other\", \"text\": \"Other\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"male\", \"text\": \"Male\" }, { \"value\": \"other\", \"text\": \"Other / prefer not to say\" } ] }\n      ]},\n      { \"name\": \"units\", \"elements\": [\n        { \"type\": \"imagerating\", \"name\": \"scenic_beauty\", \"title\": \"How beautiful is this waterfront plant landscape?\", \"description\": \"One record per landscape unit: key = unit01 … unit32 (the paper's NO.1 … NO.32); shown = the unit's two photos (a and b).\", \"imageCount\": 2, \"rateMin\": 1, \"rateMax\": 5, \"rateLabels\": [\"Poor landscape effect\", \"Average landscape effect\", \"Fairly good landscape effect\", \"Good landscape effect\", \"High scenic beauty\"], \"minRateDescription\": \"Poor landscape effect\", \"maxRateDescription\": \"High scenic beauty\", \"isRequired\": true }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f1f4f1;--card:#fff;--ink:#17231d;--muted:#56645c;--accent:#2f6b57;--accent-ink:#fff;--line:#d2ddd6;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1000px;margin:0 auto;padding:24px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:8px 0 14px}.progress>i{display:block;height:100%;background:var(--accent)}\n.pair{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n@media (max-width:640px){.pair{grid-template-columns:1fr}}\n.pair div{background:#dfe5e1;border-radius:12px;overflow:hidden;display:flex;align-items:center;min-height:120px}\n.pair img{width:100%;height:auto;display:block}\n@media (min-width:641px){.pair div{aspect-ratio:4/3}.pair img{height:100%;object-fit:contain}}\n.row{margin-top:14px}.row b{display:block;margin-bottom:8px}\n.scale{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}\n.scale button{appearance:none;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:10px;padding:8px 4px;font:inherit;cursor:pointer;line-height:1.25}\n.scale button span{display:block;font-weight:700;font-size:1.1rem}.scale button small{display:block;font-size:.75rem;color:var(--muted)}\n.scale button.on{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}.scale button.on small{color:#e4efe9}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:16px}.q>b{display:block;margin-bottom:4px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:1000px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photos: Jin &amp; Miao (2024), PLOS ONE 19(5): e0302855, S1 Fig (sample landscape photos of Xingqing Palace Park, Xi'an, taken by the authors), Creative Commons Attribution License (CC BY 4.0).</footer>\n<script>\n(function(){\n  var app=document.getElementById('app'), Q={}, files={}, order=[], done={}, i=0;\n  var ABOUT=['rater_group','gender'], N=32;\n  var LABELS=['Poor landscape effect','Average landscape effect','Fairly good landscape effect','Good landscape effect','High scenic beauty'];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function shuffle(a){a=a.slice();for(var k=a.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1));var x=a[k];a[k]=a[j];a[j]=x;}return a;}\n  function units(){var u=[];for(var k=1;k<=N;k++)u.push('unit'+(k<10?'0':'')+k);return u;}\n  function radios(n){return (Q[n].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');}\n  function setup(){\n    var all=units(), saved=null;\n    try{saved=JSON.parse(localStorage.getItem('jin2024:order'));}catch(e){}\n    if(Array.isArray(saved)&&saved.length===N&&saved.every(function(u){return all.indexOf(u)>=0;}))order=saved;\n    else{order=shuffle(all);try{localStorage.setItem('jin2024:order',JSON.stringify(order));}catch(e){}} // unit order randomised per participant\n  }\n  function intro(){\n    var miss=[];units().forEach(function(u){['a','b'].forEach(function(s){if(!files[u+'_'+s+'.jpg'])miss.push(u+'_'+s+'.jpg');});});\n    if(miss.length){app.innerHTML='<h1>Images missing</h1><p>Missing in folder “garden”: '+esc(miss.join(', '))+'</p>';return;}\n    app.innerHTML='<h1>How beautiful is this waterfront?</h1><p>You will see 32 places along the water in Xingqing Palace Park, a historic garden in Xi’an, China. Each place is shown in two photos. Look at both and rate how beautiful the plant landscape is, from 1 (poor) to 5 (high scenic beauty). About 8 minutes.</p>'+\n      '<div class=\"card\">'+ABOUT.map(function(n){return '<div class=\"q\"><b>'+esc(Q[n].title)+'</b>'+radios(n)+'</div>';}).join('')+'</div>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var vals={},miss=ABOUT.filter(function(n){var r=app.querySelector('input[name='+n+']:checked');if(r)vals[n]=r.value;return !r;});\n      if(miss.length)return err('Please answer: '+miss.map(function(n){return Q[n].title;}).join('; '));\n      var b=this;b.disabled=true;var calls=[SPSite.answer('consent',true)];ABOUT.forEach(function(n){calls.push(SPSite.answer(n,vals[n]));});\n      Promise.all(calls).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}i=0;trial();});\n    };\n  }\n  function trial(){\n    while(i<order.length&&done[order[i]])i++;\n    if(i>=order.length)return finish();\n    var u=order[i], fa=files[u+'_a.jpg'], fb=files[u+'_b.jpg'], val=null, n=Object.keys(done).length, labels=(Q.scenic_beauty.rateLabels&&Q.scenic_beauty.rateLabels.length===5)?Q.scenic_beauty.rateLabels:LABELS;\n    var b='';for(var v=1;v<=5;v++)b+='<button data-v=\"'+v+'\"><span>'+v+'</span><small>'+esc(labels[v-1]||'')+'</small></button>';\n    app.innerHTML='<p>Place '+(n+1)+' of '+N+'</p><div class=\"progress\"><i style=\"width:'+(100*n/N)+'%\"></i></div>'+\n      '<div class=\"pair\"><div><img src=\"'+esc(fa.url)+'\" alt=\"Photo 1 of this place\"></div><div><img src=\"'+esc(fb.url)+'\" alt=\"Photo 2 of this place\"></div></div>'+\n      '<div class=\"row\"><b>'+esc(Q.scenic_beauty.title)+'</b><div class=\"scale\">'+b+'</div></div>'+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"nx\">Next</button></div><div class=\"err\"></div>';\n    var nxt=order[i+1];if(nxt){[new Image(),new Image()].forEach(function(im,k){im.src=files[nxt+'_'+'ab'[k]+'.jpg'].url;});}\n    app.querySelectorAll('.scale button').forEach(function(x){x.onclick=function(){err('');val=Number(x.getAttribute('data-v'));app.querySelectorAll('.scale button').forEach(function(y){y.classList.toggle('on',y===x);});};});\n    document.getElementById('nx').onclick=function(){\n      if(val==null)return err('Please choose a rating.');\n      var bt=this;bt.disabled=true;\n      SPSite.answer('scenic_beauty',val,{key:u,shown:[u+'_a.jpg',u+'_b.jpg']}).then(function(r){if(!ok(r)){bt.disabled=false;return err(r.error);}done[u]=true;i++;window.scrollTo(0,0);trial();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"st\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){if(m.some(function(x){return x!=='scenic_beauty';}))intro();else{done={};i=0;trial();}},1800);}else{var s=document.getElementById('st');if(s)s.textContent='Your ratings are saved.';}});\n  }\n  SPSite.onReady(function(ctx){\n    ['consent','scenic_beauty'].concat(ABOUT).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('garden')||[]).forEach(function(f){files[f.name]=f;});\n    setup();\n    var a=(ctx&&ctx.answers)||{}, p=a.scenic_beauty;\n    (p&&Array.isArray(p.trials)?p.trials:[]).forEach(function(x){if(x&&x.key!=null&&x.value!=null)done[x.key]=true;});\n    if(a.consent===true)trial();else intro();\n  });\n})();\n</script>\n</body>\n</html>\n",
