    ]\n       },\n       {\n        \"key\": \"U44\",\n        \"text\": \"The aesthetic design of the building gave me a sense of the cultural depth behind the town.\",\n        \"levels\": [\n         \"Very unconcerned\",\n         \"Not concerned\",\n         \"Neutral\",\n         \"Concerned\",\n         \"Very concerned\"\n        ]\n       },\n       {\n        \"key\": \"U45\",\n        \"text\": \"The exterior of the building is attractive to both cultural enthusiasts and casual visitors.\",\n        \"levels\": [\n         \"Very unconcerned\",\n         \"Not concerned\",\n         \"Neutral\",\n         \"Concerned\",\n         \"Very concerned\"\n        ]\n       },\n       {\n        \"key\": \"U51\",\n        \"text\": \"The building co-exists harmoniously with its surroundings without damaging the overall landscape.\",\n        \"levels\": [\n         \"Very unconcerned\",\n         \"Not concerned\",\n         \"Neutral\",\n         \"Concerned\",\n         \"Very concerned\"\n        ]\n       },\n       {\n        \"key\": \"U52\",\n        \"text\": \"The conservation of the building minimizes damage to the original structure of the building.\",\n        \"levels\": [\n         \"Very unconcerned\",\n         \"Not concerned\",\n         \"Neutral\",\n         \"Concerned\",\n         \"Very concerned\"\n        ]\n       },\n       {\n        \"key\": \"U53\",\n        \"text\": \"The conservation of buildings promotes the continuity of architectural culture.\",\n        \"levels\": [\n         \"Very unconcerned\",\n         \"Not concerned\",\n         \"Neutral\",\n         \"Concerned\",\n         \"Very concerned\"\n        ]\n       },\n       {\n        \"key\": \"U54\",\n        \"text\": \"The cultural preservation of buildings is key to the sustainability of local culture.\",\n        \"levels\": [\n         \"Very unconcerned\",\n         \"Not concerned\",\n         \"Neutral\",\n         \"Concerned\",\n         \"Very concerned\"\n        ]\n       }\n      ],\n      \"trials\": [\n       {\n        \"id\": \"liu_ancestral_hall\",\n        \"label\": \"Liu Family Ancestral Hall\",\n        \"images\": [\n         \"liu_ancestral_hall.jpg\"\n        ]\n       },\n       {\n        \"id\": \"liu_courtyard\",\n        \"label\": \"Liu Family Courtyard\",\n        \"images\": [\n         \"liu_courtyard.jpg\"\n        ]\n       },\n       {\n        \"id\": \"huaxia_ancestral_hall\",\n        \"label\": \"Huaxia Ancestral Hall\",\n        \"images\": [\n         \"huaxia_ancestral_hall.jpg\"\n        ]\n       },\n       {\n        \"id\": \"longxing_temple\",\n        \"label\": \"Longxing Temple\",\n        \"images\": [\n         \"longxing_temple.jpg\"\n        ]\n       },\n       {\n        \"id\": \"longzang_palace\",\n        \"label\": \"Longzang Palace\",\n        \"images\": [\n         \"longzang_palace.jpg\"\n        ]\n       }\n      ],\n      \"order\": \"random\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#f3f0ea;--card:#fff;--ink:#1f2328;--muted:#5d646c;--accent:#8a3b2d;--accent-ink:#fff;--line:#ddd6cc;--warn:#b3261e;--miss:#fdecea}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1000px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q>b{display:block;margin-bottom:4px}\n.q.miss{background:var(--miss);border-radius:10px;padding:6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.photo{position:sticky;top:0;z-index:2;background:var(--card);padding-bottom:8px}\n.photo img{width:100%;max-height:48vh;object-fit:contain;display:block;border-radius:10px;background:#e9e4dc}\n.photo .cap{font-weight:600;margin-top:6px}\n.it{padding:10px 6px;border-top:1px solid var(--line);border-radius:8px;margin-top:8px}\n.it .x{font-weight:500;margin-bottom:6px}\n.sc{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px}\n.sc label{display:flex;flex-direction:column;align-items:center;text-align:center;font-size:.85rem;color:var(--muted);cursor:pointer;padding:4px 2px;min-width:0;border:1px solid var(--line);border-radius:8px}\n.sc input{width:20px;height:20px;margin:0 0 4px}\n@media(max-width:600px){.sc{grid-template-columns:1fr}.sc label{flex-direction:row;gap:10px;text-align:left;padding:8px 10px}.sc input{margin:0}.photo{position:static}}\n.it.miss{background:var(--miss)}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:1000px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Huang, Mat Sulaiman, Harun, He &amp; Wen (2026), PLOS ONE 21(6): e0350924, Figure 3, doi:10.1371/journal.pone.0350924 (CC BY 4.0; cropped to remove panel letters). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='huanglx2026:';\n  var app=document.getElementById('app'), Q={}, files={}, ans={}, GR=[], ITEMS=[], done={}, ORD=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function q(n){return Q[n]||{};}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function page(html,btn,cb){app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn)+'</button></div><div class=\"err\"></div>';document.getElementById('go').onclick=cb;app.onchange=hideErr;}\n  function send(list,b,fin){b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}fin();});}\n  function order(){\n    var ids=GR.map(function(g){return g.id;});\n    ORD=load('o');\n    if(!ORD||ORD.length!==ids.length||ORD.some(function(x){return ids.indexOf(x)<0;})){ORD=shuffle(ids);save('o',ORD);}\n    return ORD.map(function(id){return GR.filter(function(g){return g.id===id;})[0];});\n  }\n  function next(){\n    window.scrollTo(0,0);\n    if(!ans.intro)return intro();\n    if(!ans.about)return about();\n    var L=order();\n    for(var i=0;i<L.length;i++)if(!done[L[i].id])return building(L[i],i,L.length);\n    finish();\n  }\n  function intro(){\n    var miss=GR.some(function(g){return g.images.some(function(n){return !files[n];});});\n    if(miss){app.innerHTML='<h1>Pictures missing</h1><p>Media folder buildings must hold the five building photos (liu_ancestral_hall.jpg, liu_courtyard.jpg, huaxia_ancestral_hall.jpg, longxing_temple.jpg, longzang_palace.jpg).</p>';return;}\n    page('<h1>Cultural value of heritage buildings</h1><p>This questionnaire asks how you see the cultural value of five heritage buildings in Longxing Ancient Town, Chongqing, China. You will see one photo of each building and score 24 statements about it.</p><p>It takes about 15 minutes. Your answers are anonymous and used only for research.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      send([SPSite.answer('consent',true)],this,function(){ans.intro=true;save('a',ans);next();});});\n  }\n  var DEMO=['gender','age','education','occupation'];\n  function about(){\n    page('<h1>About you</h1><div class=\"card\">'+DEMO.map(function(n,k){var d=q(n);return '<div class=\"q\" data-n=\"'+n+'\"'+(k?'':' style=\"margin-top:0\"')+'><b>'+esc(d.title)+'</b>'+(d.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+'</div>','Continue',function(){\n      var v={},miss=[];DEMO.forEach(function(n){var x=app.querySelector('input[name=\"'+n+'\"]:checked');var r=app.querySelector('.q[data-n=\"'+n+'\"]');if(x){v[n]=Number(x.value);r.classList.remove('miss');}else{miss.push(r);r.classList.add('miss');}});\n      if(miss.length){err('Please answer every question (marked in red).');miss[0].scrollIntoView({block:'center'});return;}\n      send(DEMO.map(function(n){return SPSite.answer(n,v[n]);}),this,function(){ans.about=true;save('a',ans);next();});});\n  }\n  function building(g,i,n){\n    var f=files[g.images[0]];\n    var rows=ITEMS.map(function(it,k){return '<div class=\"it\" data-k=\"'+it.key+'\"><div class=\"x\">'+(k+1)+'. '+esc(it.text)+'</div><div class=\"sc\" role=\"radiogroup\" aria-label=\"'+esc(it.key)+'\">'+it.levels.map(function(l,v){return '<label><input type=\"radio\" name=\"'+it.key+'\" value=\"'+(v+1)+'\">'+(v+1)+' '+esc(l)+'</label>';}).join('')+'</div></div>';}).join('');\n    page('<div class=\"top\"><span class=\"t\">Building '+(i+1)+' of '+n+'</span><div class=\"bar\"><i style=\"width:'+(100*i/n)+'%\"></i></div></div><div class=\"card\"><div class=\"photo\"><img alt=\"'+esc(g.label)+'\" src=\"'+esc(f.url)+'\"><div class=\"cap\">'+esc(g.label)+'</div></div><p style=\"color:var(--ink);margin:10px 0 0\">'+esc(q('cultural_value').title)+': score each statement from 1 to 5.</p>'+rows+'</div>','Next',function(){\n      var v={},miss=[];\n      ITEMS.forEach(function(it){var x=app.querySelector('input[name=\"'+it.key+'\"]:checked');var r=app.querySelector('.it[data-k=\"'+it.key+'\"]');if(x){v[it.key]=Number(x.value);r.classList.remove('miss');}else{miss.push(r);r.classList.add('miss');}});\n      if(miss.length){err(miss.length+' statement'+(miss.length>1?'s are':' is')+' not scored yet (marked in red).');miss[0].scrollIntoView({block:'center'});return;}\n      send([SPSite.answer('cultural_value',v,{key:g.id,shown:[f.name]})],this,function(){done[g.id]=true;next();});});\n    app.onchange=function(e){hideErr();var r=e.target.closest&&e.target.closest('.it');if(r)r.classList.remove('miss');};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>In the original survey, 192 visitors to Longxing Ancient Town rated these buildings. Aesthetic value received the highest mean score (3.40 of 5) and local value the lowest (3.14); the 24 statements formed five clear factors (local, scientific, historic, aesthetic and sustainability value).</p><p style=\"font-size:.82rem\">Photos and scale: Huang, H., Mat Sulaiman, M. K. A., Harun, N. Z., He, W., &amp; Wen, B. (2026). An evaluation scale for the cultural value of heritage buildings. PLOS ONE 21(6): e0350924, doi:10.1371/journal.pone.0350924.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')ans.intro=false;else if(x==='cultural_value')done={};else ans.about=false;});save('a',ans);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    var SPEC;try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='cultural_value'){GR=e.trials;ITEMS=e.items;}});});\n    (SPSite.getMedia('buildings')||[]).forEach(function(f){files[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};ans=load('a')||{};\n    ((a.cultural_value&&a.cultural_value.trials)||[]).forEach(function(t){if(t.key)done[t.key]=true;});\n    ans.intro=a.consent===true;ans.about=a.gender!=null&&a.occupation!=null;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
