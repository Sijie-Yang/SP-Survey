   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Flower Border Ratings</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Flower Borders in Urban Green Space: Aesthetic Preference and Visual Attributes\",\n  \"description\": \"Participants rate 18 photographs of flower borders in Chinese urban green spaces, in random order and without a time limit, on four statements printed in the paper's Table A1: aesthetic preference ('This vegetation landscape is very beautiful.') and perceived colour contrast, colour brightness and visual richness, each on a 5-point agreement scale. Rebuilt from Zhuang, Qiao, Zhang, Su & Xia (2021), IJERPH 18(17): 9318, with the paper's Figure 1 photographs (CC BY 4.0). Analysis as in the paper: mean of each item per photo; preference by level of contrast, brightness and richness (one-way ANOVA); regression of preference on the three attributes (plus the paper's colour measures if you compute them); preference by gender (t-test).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"flowers\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part in this study.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"photos\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"aesthetic_preference\",\n      \"title\": \"This vegetation landscape is very beautiful.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true,\n      \"description\": \"Aesthetic preference (dependent variable). Keyed by photo: flower_a … flower_r = panels (a)–(r) of the paper's Figure 1. 5-point scale, 1 = strongly disagree, 5 = strongly agree (Table A1).\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"color_contrast\",\n      \"title\": \"The color contrast of this flower border is strong.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true,\n      \"description\": \"Perceived colour contrast (CC), one of the three 'visual attractiveness' attributes. Keyed by photo: flower_a … flower_r = panels (a)–(r) of the paper's Figure 1. 5-point scale, 1 = strongly disagree, 5 = strongly agree (Table A1).\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"color_brightness\",\n      \"title\": \"The color brightness of this flower border is strong.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true,\n      \"description\": \"Perceived colour brightness (CB), 'visual attractiveness' attribute. Keyed by photo: flower_a … flower_r = panels (a)–(r) of the paper's Figure 1. 5-point scale, 1 = strongly disagree, 5 = strongly agree (Table A1).\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"visual_richness\",\n      \"title\": \"The visual richness of this flower border is high.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true,\n      \"description\": \"Perceived visual richness (VR), 'visual attractiveness' attribute. Keyed by photo: flower_a … flower_r = panels (a)–(r) of the paper's Figure 1. 5-point scale, 1 = strongly disagree, 5 = strongly agree (Table A1).\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"role\",\n      \"title\": \"Which describes you best?\",\n      \"isRequired\": true,\n      \"description\": \"The paper's sample were students, teachers and staff of one university; this question is not printed in the paper.\",\n      \"choices\": [\n       {\n        \"value\": \"student\",\n        \"text\": \"Student\"\n       },\n       {\n        \"value\": \"teacher\",\n        \"text\": \"Teacher / researcher\"\n       },\n       {\n        \"value\": \"staff\",\n        \"text\": \"Other university staff\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"None of these\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"flower-original\">{\"source\": \"Zhuang, Qiao, Zhang, Su & Xia (2021) International Journal of Environmental Research and Public Health 18(17): 9318\", \"n\": 113, \"participants\": \"42 men and 71 women aged 18–52 recruited on the Zhejiang University forum (students, teachers, staff); online survey; 35 of them also took part in a lab facial-expression session (8 s per photo after a 10 s white screen)\", \"result\": \"Mean ratings about 3.3 of 5 for contrast, brightness and richness. Preference rose steadily with each attribute (e.g. brightness level 1 → 1.65, level 5 → 4.12). Backward regression (adjusted R² = 0.437): visual richness (β = 0.29), colour contrast (0.24) and colour brightness (0.20) were the strongest predictors, with small effects of green-vegetation share, number of plant patches and number of hues. Men gave higher preference than women (3.31 vs 3.17). Preference correlated with facial valence (R = 0.51).\"}</script>\n<style>\n:root{--bg:#f3f6f2;--card:#fff;--ink:#1f2620;--muted:#5e6a60;--accent:#a8326e;--line:#dbe1da;--warn:#b3261e;--sel:#f8e6ef}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.1rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.photo{width:100%;max-width:620px;border-radius:8px;display:block;margin:0 auto 12px}\n.dim{margin-top:14px;font-style:italic;color:var(--ink)}\n.it{padding:8px 0}\n.it b{display:block;font-weight:500;margin-bottom:4px}\n.ends{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-top:2px}\n.row{display:grid;grid-template-columns:repeat(5,1fr);gap:4px}\n.row label{display:flex;flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:8px;padding:5px 0;cursor:pointer;font-size:.8rem}\n.row label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.row input{margin:0 0 2px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:760px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Zhuang, Qiao, Zhang, Su &amp; Xia (2021), International Journal of Environmental Research and Public Health 18(17): 9318, Figure 1 (doi:10.3390/ijerph18179318, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='flower-borders:state';\n  var app=document.getElementById('app'), Q={}, files={}, ids=[], st=null;\n  var ITEMS=['aesthetic_preference','color_contrast','color_brightness','visual_richness'];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function item(n){var h='<div class=\"it\"><b>'+esc(Q[n].title)+'</b><div class=\"row\">';for(var i=1;i<=5;i++)h+='<label><input type=\"radio\" name=\"q_'+n+'\" value=\"'+i+'\">'+i+'</label>';\n    return h+'</div><div class=\"ends\"><span>Strongly disagree</span><span>Strongly agree</span></div></div>';}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function intro(){\n    app.innerHTML='<h1>Flower borders</h1><p>You will see '+st.order.length+' photographs of flower borders in city parks, one at a time. Imagine you are in the scene shown in the photo and say how much you agree with four short statements, from 1 (strongly disagree) to 5 (strongly agree). There is no time limit. It takes about 8 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Please tick the box to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='trial';st.k=0;save();route();});};\n  }\n  function trial(){\n    var id=st.order[st.k];\n    app.innerHTML='<div class=\"prog\">Photo '+(st.k+1)+' of '+st.order.length+'</div><div class=\"card\"><img class=\"photo\" alt=\"Flower border photograph\" src=\"'+esc(files[id].url)+'\"><div class=\"dim\">Imagine you are in the scene shown in the photo. How much do you agree?</div>'+ITEMS.map(item).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next photo</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var vals=ITEMS.map(function(n){return val('q_'+n);});if(vals.some(function(x){return x==null;}))return err('Please answer all four statements.');\n      var sh=[files[id].name];\n      send(ITEMS.map(function(n,i){return SPSite.answer(n,Number(vals[i]),{key:id,shown:sh});}),this,function(){st.k++;if(st.k>=st.order.length)st.step='about';save();route();});\n    };\n  }\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+radios('gender')+'<div class=\"f\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"110\"></div>'+radios('role')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var age=Number(document.getElementById('age').value),g=val('gender'),r=val('role');\n      if(!g||!r)return err('Please answer every question.');if(!(age>=18&&age<=110))return err('Please enter your age.');\n      send([SPSite.answer('gender',g),SPSite.answer('age',age),SPSite.answer('role',r)],this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='trial')return trial();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','role'].concat(ITEMS).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('flowers')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name)){var k=f.name.replace(/\\.[^.]+$/,'');files[k]=f;ids.push(k);}});\n    if(ids.length<2){app.innerHTML='<h1>Photos missing</h1><p>Upload the photographs to the media folder \"flowers\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var valid=st&&st.order&&st.order.length===ids.length&&st.order.every(function(x){return files[x];});\n    if(!valid)st={step:'intro',order:shuffle(ids),k:0};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
