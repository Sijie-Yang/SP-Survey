   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Rooftop Green Spaces</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Rooftop Green Spaces: Activity and Social Well-being\",\n  \"description\": \"Faithful replication with the original scenes, shown as flat images instead of in VR: 27 rendered views of one open rooftop garden in Chengdu, built from a real podium-roof garden and varied in three steps on each of three design variables, functional type (A1 recreation and sightseeing, A2 catering and entertainment, A3 sports and fitness), green view index (B1 32.8%, B2 19.8%, B3 10.5%) and sky view factor (C1 27.5%, C2 17.4%, C3 9.2%). Participants see all 27 scenes in random order, each for 20 s, with a short break halfway. After each scene they rate, on 7-point scales, how willing they would be to do six activities there during a work break (walking, exercise, eating and drinking, viewing, conversation, reading) and the five social-health senses of the paper's supplement (belonging, support, trust, pleasure, safety). Rebuilt from Chen, Shen, Zhu, Gan, Zhou, Fang & Zeng (2026), Assessing the restorative benefits of open rooftop green spaces characteristics using virtual reality and EEG analysis, Frontiers in Psychology 17: 1807425, with the 27 scenes taken from its Table 1 (CC BY 4.0). Image ids: A(function)B(GVI)C(SVF), e.g. A1B1C1 = recreation, high greenery, most sky. Analysis as in the paper: correlations and regressions of each rating on GVI, SVF and functional type (dummy coded, recreation / low GVI / low SVF as reference), plus ANOVA by functional type; the paper (97 students) found social senses and walking willingness highest with high GVI and high SVF, and exercise willingness highest in fitness rooftops with high GVI. Differences from the original study: (1) flat images of about 560 px on a screen instead of 360-degree panoramas in an HTC Vive headset; (2) no EEG, so the six EEG indices (attention, engagement, excitement, stress, relaxation, interest) are not measured, and there is no baseline recording, stress-induction task or eyes-closed rest; (3) the paper gives the six activities and the five social senses with their definitions but not the question wording or scale anchors, so the question stems and the 1-7 anchor labels are ours; (4) the paper's demographic and baseline stress questionnaire is not printed, so only age and gender are asked (our wording); (5) the break after 14 scenes is ours (the paper split the session into two blocks with a 5-minute rest without saying where); (6) the intro asking participants to imagine an office break on their building's rooftop is our wording, based on the paper's work-break framing.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"rooftops\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 16,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"scenes\",\n    \"elements\": [\n     {\n      \"type\": \"matrix\",\n      \"name\": \"activity\",\n      \"title\": \"How willing would you be to do each of these here during a work break?\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"walking\",\n        \"text\": \"Walking\"\n       },\n       {\n        \"value\": \"exercise\",\n        \"text\": \"Exercise\"\n       },\n       {\n        \"value\": \"eating\",\n        \"text\": \"Eating and drinking\"\n       },\n       {\n        \"value\": \"viewing\",\n        \"text\": \"Viewing the scenery\"\n       },\n       {\n        \"value\": \"conversation\",\n        \"text\": \"Conversation\"\n       },\n       {\n        \"value\": \"reading\",\n        \"text\": \"Reading\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1 (not at all willing)\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"6\"\n       },\n       {\n        \"value\": 7,\n        \"text\": \"7 (very willing)\"\n       }\n      ],\n      \"description\": \"Activity willingness (physiological health benefits), 1-7. Keyed by image id A?B?C?.\"\n     },\n     {\n      \"type\": \"matrix\",\n      \"name\": \"social\",\n      \"title\": \"How strongly does this space give you each of these feelings?\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"belonging\",\n        \"text\": \"Sense of belonging\"\n       },\n       {\n        \"value\": \"support\",\n        \"text\": \"Sense of support\"\n       },\n       {\n        \"value\": \"trust\",\n        \"text\": \"Sense of trust\"\n       },\n       {\n        \"value\": \"pleasure\",\n        \"text\": \"Sense of pleasure\"\n       },\n       {\n        \"value\": \"safety\",\n        \"text\": \"Sense of safety\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1 (very weak)\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"6\"\n       },\n       {\n        \"value\": 7,\n        \"text\": \"7 (very strong)\"\n       }\n      ],\n      \"description\": \"Social health benefits (supplement Table S8 dimensions), 1-7. Keyed by image id.\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"rooftop-original\">{\"source\": \"Chen, Shen, Zhu, Gan, Zhou, Fang & Zeng (2026) Frontiers in Psychology 17: 1807425\", \"n\": 97, \"participants\": \"97 university students (55 male, 42 female), Southwest University of Science and Technology\", \"design\": \"27 scenes = 3 functional types x 3 GVI x 3 SVF, random order, 40 s each (20 s viewing + EEG snapshot, 20 s eyes-closed rest), ratings after each scene, two blocks with 5-min rest; HTC Vive + Emotiv EPOC+\", \"levels\": {\"A\": {\"A1\": \"Recreation and Sightseeing\", \"A2\": \"Catering and Entertainment\", \"A3\": \"Sports and Fitness\"}, \"B_GVI\": {\"B1\": 0.3279, \"B2\": 0.1984, \"B3\": 0.1054}, \"C_SVF\": {\"C1\": 0.2747, \"C2\": 0.1743, \"C3\": 0.0919}}, \"results\": {\"social_high_GVI_high_SVF\": {\"belonging\": 3.428, \"support\": 3.4465, \"trust\": 3.488, \"pleasure\": 3.692, \"safety\": 3.341}, \"walking_best\": [3.891, 3.73, 3.652], \"exercise_best_fitness_high_GVI\": 4.001, \"social_scale_alpha\": 0.9}}</script>\n<style>\n:root{--bg:#eef2ee;--card:#fff;--ink:#1c241f;--muted:#5a665e;--accent:#2f6b4a;--line:#d5ddd7;--warn:#b3261e;--sel:#e1efe6}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.ins{color:var(--ink)}\n.view{position:fixed;inset:0;background:#111;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:5;gap:12px}\n.view img{width:min(100vw,1100px);height:auto;max-height:88vh;object-fit:contain;display:block}\n.view .t{color:#999;font-size:.85rem}\n.pic{position:sticky;top:0;z-index:2;background:var(--bg);padding:6px 0}\n.pic img{width:100%;max-height:34vh;object-fit:contain;display:block;border-radius:8px;background:#ddd}\n.mx{margin-top:18px}.mx:first-child{margin-top:0}\n.mx h3{font-size:1rem;margin:0 0 4px}\n.it{padding:7px 0;border-top:1px solid var(--line)}\n.it .q{font-size:.95rem;margin-bottom:4px}\n.it .o{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}\n.it label{display:flex;flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:8px;padding:3px 0;cursor:pointer;font-size:.8rem;color:var(--muted)}\n.it label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.it input{margin:0 0 1px}\n.it.miss .o{outline:2px solid var(--warn);outline-offset:2px;border-radius:8px}\n.ends{display:flex;justify-content:space-between;font-size:.74rem;color:var(--muted);margin-bottom:2px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}.f:first-child{margin-top:0}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Scenes: Chen, Shen, Zhu, Gan, Zhou, Fang &amp; Zeng (2026), Frontiers in Psychology 17: 1807425, Table 1 (doi:10.3389/fpsyg.2026.1807425, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='rooftop-green:state', T={view:window.__VIEWMS||20000};\n  var IDS=[];[1,2,3].forEach(function(a){[1,2,3].forEach(function(b){[1,2,3].forEach(function(c){IDS.push('A'+a+'B'+b+'C'+c);});});});\n  var SC=['activity','social'], BREAK=14;\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function fresh(){return {step:'intro',order:shuffle(IDS),k:0,phase:'view'};}\n  function ends(c){return String(c.text).replace(/^\\d+\\s*\\(?/,'').replace(/\\)$/,'');}\n  function intro(){\n    app.innerHTML='<h1>Rooftop gardens</h1><p>Imagine you work in an office in a busy city centre and take a break on the rooftop garden of your building. You will see 27 versions of a rooftop garden, one at a time, each for 20 seconds (the page moves on by itself). After each one you rate how willing you would be to do some activities there and how the space makes you feel. There is a short break halfway. It takes about 30 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div class=\"f\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"16\" max=\"110\"></div><div class=\"f\"><b>'+esc(Q.gender.title)+'</b>'+(Q.gender.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"gender\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var age=Number(document.getElementById('age').value),g=val('gender');if(!(age>=16&&age<=110))return err('Please enter your age.');if(!g)return err('Please choose your gender.');\n      send([SPSite.answer('consent',true),SPSite.answer('age',age),SPSite.answer('gender',g)],this,function(){st.step='trial';st.phase='view';save();route();});};\n  }\n  function trial(){\n    if(st.k>=st.order.length){st.step='done';save();return route();}\n    if(st.phase==='break')return brk();\n    if(st.phase==='q')return ask();\n    var id=st.order[st.k],v=document.createElement('div');v.className='view';app.innerHTML='';app.appendChild(v);\n    v.innerHTML='<img alt=\"Rooftop garden\" src=\"'+esc(files[id].url)+'\"><div class=\"t\" id=\"tm\"></div>';\n    var end=Date.now()+T.view,tm=document.getElementById('tm');\n    (function tick(){var s=Math.ceil((end-Date.now())/1000);if(s<=0){st.phase='q';save();return route();}if(tm)tm.textContent='Scene '+(st.k+1)+' of '+st.order.length+' · '+s+' s';setTimeout(tick,250);})();\n  }\n  function brk(){\n    app.innerHTML='<h2>Short break</h2><div class=\"card\"><p class=\"ins\">You are halfway. Take a few minutes to rest your eyes, then continue with the remaining '+(st.order.length-st.k)+' scenes.</p><button class=\"btn\" id=\"go\">Continue</button></div>';\n    document.getElementById('go').onclick=function(){st.phase='view';save();route();};\n  }\n  function block(n){var q=Q[n],cs=q.columns||[];return '<div class=\"mx\"><h3>'+esc(q.title)+'</h3><div class=\"ends\"><span>1 '+esc(ends(cs[0]))+'</span><span>7 '+esc(ends(cs[cs.length-1]))+'</span></div>'+(q.rows||[]).map(function(r){var nm=n+'__'+r.value;return '<div class=\"it\" data-n=\"'+nm+'\"><div class=\"q\">'+esc(r.text)+'</div><div class=\"o\">'+cs.map(function(c){return '<label><input type=\"radio\" name=\"'+nm+'\" value=\"'+c.value+'\">'+c.value+'</label>';}).join('')+'</div></div>';}).join('')+'</div>';}\n  function ask(){\n    var id=st.order[st.k],f=files[id];\n    app.innerHTML='<div class=\"prog\">Scene '+(st.k+1)+' of '+st.order.length+'</div><div class=\"pic\"><img alt=\"The rooftop garden you just saw\" src=\"'+esc(f.url)+'\"></div><div class=\"card\">'+SC.map(block).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    if(st.k+1<st.order.length){var p=new Image();p.src=files[st.order[st.k+1]].url;}\n    document.getElementById('go').onclick=function(){\n      var out={},miss=0,first=null;\n      SC.forEach(function(n){out[n]={};(Q[n].rows||[]).forEach(function(r){var nm=n+'__'+r.value,x=val(nm),el=app.querySelector('.it[data-n=\"'+nm+'\"]');if(x==null){miss++;el.classList.add('miss');if(!first)first=el;}else{el.classList.remove('miss');out[n][r.value]=Number(x);}});});\n      if(miss){if(first)first.scrollIntoView({block:'center'});return err('Please answer every row ('+miss+' missing).');}\n      send(SC.map(function(n){return SPSite.answer(n,out[n],{key:id,shown:[f.name]});}),this,function(){st.k++;st.phase=(st.k===BREAK)?'break':'view';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var r=e.target.closest&&e.target.closest('.it');if(r)r.classList.remove('miss');});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='trial')return trial();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','activity','social'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('rooftops')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=IDS.filter(function(k){return !files[k];});\n    if(need.length){app.innerHTML='<h1>Scenes missing</h1><p>Upload '+need.join(', ')+' (.jpg) to the media folder \"rooftops\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.order)||a.consent!==true)st=fresh();\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
