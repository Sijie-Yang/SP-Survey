   "id": "site-49cb711ea9c9685e",
   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Wayfinding Signage Preferences</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Which wayfinding signs work best in the city?\",\n  \"description\": \"Faithful replication of the online questionnaire of Zhou, Ujang, Abd Manan & Abdul Aziz (2024), Bridging Perceptual Gaps: Designers vs. Non-Designers in Urban Wayfinding Signage Preferences, Sustainability 16(22):9653. Part 1 classifies participants as designers or non-designers by their wayfinding-signage experience and records age, gender and education. Part 2 shows four sets of four simulated signs (text information, shape, color coding, decorative patterns); for each set participants pick the one they prefer for urban environments and explain why in their own words.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"signs\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I understand the purpose of this study, that my answers are anonymous, and I agree to take part voluntarily.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"design_background\",\n      \"title\": \"Which describes your experience with wayfinding signage design?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"course_only\",\n        \"text\": \"I have only received wayfinding signage course training\"\n       },\n       {\n        \"value\": \"projects\",\n        \"text\": \"I have participated in wayfinding signage design projects\"\n       },\n       {\n        \"value\": \"unfamiliar\",\n        \"text\": \"I am completely unfamiliar with wayfinding signage design\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age_group\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"19_below\",\n        \"text\": \"19 and below\"\n       },\n       {\n        \"value\": \"19_39\",\n        \"text\": \"19–39\"\n       },\n       {\n        \"value\": \"40_49\",\n        \"text\": \"40–49\"\n       },\n       {\n        \"value\": \"50_59\",\n        \"text\": \"50–59\"\n       },\n       {\n        \"value\": \"60_plus\",\n        \"text\": \"Over 60\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Education level\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"high_school\",\n        \"text\": \"High school and below\"\n       },\n       {\n        \"value\": \"associate\",\n        \"text\": \"Associate degree\"\n       },\n       {\n        \"value\": \"bachelor\",\n        \"text\": \"Bachelor's degree\"\n       },\n       {\n        \"value\": \"graduate\",\n        \"text\": \"Graduate degree and above\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"signs\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"text_choice\",\n      \"title\": \"Which amount of information on the signage is more suitable for placement in urban environments?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"1. Text and arrow\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2. Text, English, and arrow\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3. Text, English, destination icon, and arrow\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4. Text, English, destination icon, number, and arrow\"\n       }\n      ],\n      \"description\": \"Text information: one of four simulated signage images (media folder signs, text_1..text_4).\"\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"text_reason\",\n      \"title\": \"Why did you choose this option?\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"shape_choice\",\n      \"title\": \"Which shape of signage do you prefer for use in urban environments?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"1. Pole signage\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2. Rectangular signage\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3. Multi-directional signage\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4. Symbolic shape signage\"\n       }\n      ],\n      \"description\": \"Shape: one of four simulated signage images (media folder signs, shape_1..shape_4).\"\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"shape_reason\",\n      \"title\": \"Why did you choose this option?\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"color_choice\",\n      \"title\": \"Which type of color coding do you prefer for signage in urban environments?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"1. No color\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2. Monochromatic coding\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3. Two-color coding\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4. Multicolor coding\"\n       }\n      ],\n      \"description\": \"Color coding: one of four simulated signage images (media folder signs, color_1..color_4).\"\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"color_reason\",\n      \"title\": \"Why did you choose this option?\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"pattern_choice\",\n      \"title\": \"Which type of signage do you prefer in an urban environment?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"1. No patterns\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2. Geometric patterns\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3. Large number of local-meaning patterns\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4. Small number of local-meaning patterns\"\n       }\n      ],\n      \"description\": \"Patterns: one of four simulated signage images (media folder signs, pattern_1..pattern_4).\"\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"pattern_reason\",\n      \"title\": \"Why did you choose this option?\",\n      \"isRequired\": true\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"results-table\">{\"source\": \"Zhou et al. (2024) Sustainability 16:9653, Table 4; share choosing each option, N=321 (153 designers, 168 non-designers)\", \"text\": [7.8, 2.2, 57.3, 32.7], \"shape\": [12.1, 2.8, 51.1, 34.0], \"color\": [5.3, 10.0, 26.2, 58.6], \"pattern\": [6.9, 20.9, 3.4, 68.8]}</script>\n<style>\n:root{--bg:#f3f2ee;--card:#fff;--ink:#1d1f1c;--muted:#5d6159;--accent:#3d6b4f;--line:#d9dad2;--warn:#b3261e;--sel:#e0ece4}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1100px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.grid{display:grid;grid-template-columns:1fr;gap:14px;margin-top:14px}\n.b{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px}\n.b img{width:100%;height:auto;display:block;border-radius:8px}\n.b .no{font-weight:700;margin:6px 0 4px}\n.o{display:grid;grid-template-columns:repeat(5,1fr);gap:3px}.anch{display:flex;justify-content:space-between;font-size:.75rem;color:var(--muted);margin-top:3px}\ninput.txt{font:inherit;width:100%;max-width:360px;padding:9px 11px;border:1px solid var(--line);border-radius:10px;margin-top:6px}\n.o label{display:flex;flex-direction:column;align-items:center;gap:2px;border:1px solid var(--line);border-radius:8px;padding:9px 1px;cursor:pointer;font-size:.68rem;line-height:1.15;text-align:center;color:var(--muted)}\n.o label b{font-size:.95rem;color:var(--ink)}\n.o label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.o input{display:none}\n.b.miss{outline:2px solid var(--warn);outline-offset:2px}\n.blk{margin-top:14px}.blk:first-child{margin-top:0}\n.blk.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.err{color:var(--warn);margin-top:8px;min-height:1.5em;line-height:1.5}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:700px){.b{padding:8px}.o{gap:2px}.o label b{font-size:.88rem}}\n\n.o label{font-size:.66rem;padding:8px 1px}\n\n.prog{font-size:.9rem;color:var(--muted);margin-top:6px}\n@media (max-width:700px){.grid{grid-template-columns:1fr}}\n.sg{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}\n.sg label{display:block;background:var(--card);border:2px solid var(--line);border-radius:12px;padding:6px;cursor:pointer}\n.sg label img{width:100%;aspect-ratio:1/1;object-fit:contain;background:#ececec;border-radius:8px;display:block}\n.sg label span{display:block;font-size:.85rem;margin-top:6px;line-height:1.3}\n.sg label:has(input:checked){border-color:var(--accent);background:var(--sel)}\n.sg input{display:none}\ntextarea{font:inherit;width:100%;min-height:90px;padding:9px 11px;border:1px solid var(--line);border-radius:10px;margin-top:6px}\n@media (min-width:900px){.sg{grid-template-columns:repeat(4,1fr)}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Signage images and questionnaire: Zhou, Ujang, Abd Manan &amp; Abdul Aziz (2024), Bridging Perceptual Gaps: Designers vs. Non-Designers in Urban Wayfinding Signage Preferences, Sustainability 16(22):9653 (doi:10.3390/su16229653, CC BY 4.0). Images cropped from Figures 1–4. Removed on request of the authors.</footer>\n<script>\n(function(){\n  var KEY='zhou2024signs:state', SETS=[[\"text\", \"Text information\"], [\"shape\", \"Shape\"], [\"color\", \"Color coding\"], [\"pattern\", \"Patterns\"]], BG=['design_background','age_group','gender','education'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='';}}\n  function hideErr(){var e=app.querySelector('.err');if(e&&!app.querySelector('.miss'))e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function intro(){\n    app.innerHTML='<h1>Wayfinding signs in the city</h1><p>This survey asks which designs of street wayfinding signs you prefer. First we ask a few questions about you. Then you will see four groups of four simulated signs, about the amount of text, the shape, the colors and the decorative patterns. In each group, pick the sign you prefer for use in a city and tell us why. It takes about 5 minutes and your answers are anonymous.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+BG.map(function(n){var q=Q[n];\n      return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var L=[],miss=[];\n      BG.forEach(function(n){var x=app.querySelector('input[name=\"'+n+'\"]:checked');if(!x){miss.push(app.querySelector('.blk[data-n=\"'+n+'\"]'));return;}L.push(SPSite.answer(n,x.value));});\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please answer the marked questions.');}\n      send(L,this,function(){st.step='sign';st.p=0;save();route();});};\n  }\n  function sign(){\n    var k=SETS[st.p][0], q=Q[k+'_choice'], cs=q.choices||[];\n    app.innerHTML='<h2>Question '+(st.p+1)+' of '+SETS.length+': '+esc(SETS[st.p][1])+'</h2><p>'+esc(q.title)+'</p>'+\n      '<div class=\"blk\" data-n=\"c\"><div class=\"sg\">'+cs.map(function(c,i){var f=files[k+'_'+(i+1)];return '<label><input type=\"radio\" name=\"c\" value=\"'+c.value+'\"><img alt=\"'+esc(c.text)+'\" src=\"'+esc(f.url)+'\"><span>'+esc(c.text)+'</span></label>';}).join('')+'</div></div>'+\n      '<div class=\"card\"><div class=\"blk\" data-n=\"r\"><b>'+esc(Q[k+'_reason'].title)+'</b><textarea id=\"why\" maxlength=\"1000\"></textarea></div><div style=\"margin-top:14px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var miss=[];\n      var x=app.querySelector('input[name=\"c\"]:checked');if(!x)miss.push(app.querySelector('.blk[data-n=\"c\"]'));\n      var why=document.getElementById('why').value.trim();if(!why)miss.push(app.querySelector('.blk[data-n=\"r\"]'));\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err(!x?'Please pick one sign.':'Please tell us why you chose it.');}\n      var shown=[1,2,3,4].map(function(i){return files[k+'_'+i].name;});\n      send([SPSite.answer(k+'_choice',Number(x.value),{shown:shown}),SPSite.answer(k+'_reason',why)],this,function(){if(st.p<SETS.length-1)st.p++;else st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var b=e.target.closest&&e.target.closest('.blk');if(b){b.classList.remove('miss');hideErr();}});\n  app.addEventListener('input',function(e){if(e.target.id==='why'){var b=e.target.closest('.blk');if(b&&e.target.value.trim()){b.classList.remove('miss');hideErr();}}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='sign')return sign();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent'].concat(BG).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    SETS.forEach(function(s){Q[s[0]+'_choice']=SPSite.getQuestion(s[0]+'_choice')||{};Q[s[0]+'_reason']=SPSite.getQuestion(s[0]+'_reason')||{};});\n    (SPSite.getMedia('signs')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=[];SETS.forEach(function(s){for(var i=1;i<=4;i++)if(!files[s[0]+'_'+i])need.push(s[0]+'_'+i);});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"signs\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.step)||a.consent!==true)st={step:'intro'};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
