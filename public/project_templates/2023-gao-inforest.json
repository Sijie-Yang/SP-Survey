"Scene E\",\n        \"angular_scale\": 0.5,\n        \"layout\": \"random\"\n       },\n       {\n        \"id\": \"F\",\n        \"label\": \"Scene F\",\n        \"angular_scale\": 0.5,\n        \"layout\": \"random\"\n       },\n       {\n        \"id\": \"G\",\n        \"label\": \"Scene G\",\n        \"angular_scale\": 0.531,\n        \"layout\": \"cluster\"\n       },\n       {\n        \"id\": \"H\",\n        \"label\": \"Scene H\",\n        \"angular_scale\": 0.521,\n        \"layout\": \"cluster\"\n       },\n       {\n        \"id\": \"I\",\n        \"label\": \"Scene I\",\n        \"angular_scale\": 0.613,\n        \"layout\": \"cluster\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"ratings\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"scene_evaluation\",\n      \"title\": \"Please rate this forest scene on each point.\",\n      \"isRequired\": true,\n      \"description\": \"One trial per photograph A–I (same order). Value: {rco, nsi, rcl, bco, spe, sun, shi, sap, rvi}, each 1 = lowest … 7 = highest. rco…shi = seven spatial cognitive indexes, sap = satisfaction preference, rvi = re-viewing intention. Analysis as in the paper: compare landscape majors (major = 1) with others; regress rvi on sap; regress sap on the seven indexes per spatial layout (uniform / random / cluster) and per major group.\",\n      \"items\": [\n       {\n        \"name\": \"rco\",\n        \"group\": \"Spatial cognition\",\n        \"text\": \"Richness of landscape content\"\n       },\n       {\n        \"name\": \"nsi\",\n        \"group\": \"Spatial cognition\",\n        \"text\": \"Near–far stereoscopic impression\"\n       },\n       {\n        \"name\": \"rcl\",\n        \"group\": \"Spatial cognition\",\n        \"text\": \"Richness of color\"\n       },\n       {\n        \"name\": \"bco\",\n        \"group\": \"Spatial cognition\",\n        \"text\": \"Brightness of color\"\n       },\n       {\n        \"name\": \"spe\",\n        \"group\": \"Spatial cognition\",\n        \"text\": \"Scene permeability (how far you can see into it)\"\n       },\n       {\n        \"name\": \"sun\",\n        \"group\": \"Spatial cognition\",\n        \"text\": \"Spatial uniformity\"\n       },\n       {\n        \"name\": \"shi\",\n        \"group\": \"Spatial cognition\",\n        \"text\": \"Sense of hierarchy\"\n       },\n       {\n        \"name\": \"sap\",\n        \"group\": \"Overall\",\n        \"text\": \"How satisfied are you with this scene?\"\n       },\n       {\n        \"name\": \"rvi\",\n        \"group\": \"Overall\",\n        \"text\": \"How much would you like to view this scene again?\"\n       }\n      ],\n      \"min\": 1,\n      \"max\": 7,\n      \"trials\": [\n       {\n        \"id\": \"A\",\n        \"label\": \"Scene A\",\n        \"angular_scale\": 0.375,\n        \"layout\": \"uniform\"\n       },\n       {\n        \"id\": \"B\",\n        \"label\": \"Scene B\",\n        \"angular_scale\": 0.438,\n        \"layout\": \"uniform\"\n       },\n       {\n        \"id\": \"C\",\n        \"label\": \"Scene C\",\n        \"angular_scale\": 0.458,\n        \"layout\": \"uniform\"\n       },\n       {\n        \"id\": \"D\",\n        \"label\": \"Scene D\",\n        \"angular_scale\": 0.479,\n        \"layout\": \"random\"\n       },\n       {\n        \"id\": \"E\",\n        \"label\": \"Scene E\",\n        \"angular_scale\": 0.5,\n        \"layout\": \"random\"\n       },\n       {\n        \"id\": \"F\",\n        \"label\": \"Scene F\",\n        \"angular_scale\": 0.5,\n        \"layout\": \"random\"\n       },\n       {\n        \"id\": \"G\",\n        \"label\": \"Scene G\",\n        \"angular_scale\": 0.531,\n        \"layout\": \"cluster\"\n       },\n       {\n        \"id\": \"H\",\n        \"label\": \"Scene H\",\n        \"angular_scale\": 0.521,\n        \"layout\": \"cluster\"\n       },\n       {\n        \"id\": \"I\",\n        \"label\": \"Scene I\",\n        \"angular_scale\": 0.613,\n        \"layout\": \"cluster\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#eef1ea;--card:#fff;--ink:#20231d;--muted:#5d6456;--accent:#4f6b3a;--accent-ink:#fff;--line:#d6dccf;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q>b{display:block;margin-bottom:4px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;max-width:160px;background:#fff;color:var(--ink)}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem;font-variant-numeric:tabular-nums}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.stage{background:#808080;border-radius:12px;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;overflow:hidden}\n.stage img{width:100%;height:100%;object-fit:contain;display:block}\n.cross{color:#fff;font-size:3rem;font-weight:300;line-height:1}\n.pic{background:#e3e7df;border-radius:12px;overflow:hidden}.pic img{width:100%;max-height:min(40vh,380px);object-fit:contain;display:block}\n.lk{display:grid;grid-template-columns:1fr repeat(7,40px);gap:3px;align-items:center;padding:7px 0;border-top:1px solid var(--line)}\n.lk.hd{border-top:0;padding:2px 0}.lk .h{font-size:.78rem;color:var(--muted);text-align:center}\n.lk label{display:flex;justify-content:center}.lk input{width:20px;height:20px}\n.lk span.it{font-size:.92rem}.lk span.it small{display:block;color:var(--muted);font-size:.74rem;text-transform:uppercase;letter-spacing:.03em}\n.anch{font-size:.8rem;color:var(--muted);margin-top:4px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:560px){.lk{grid-template-columns:1fr repeat(7,30px);gap:2px}.lk input{width:18px;height:18px}.lk span.it{font-size:.85rem}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Gao, Wang, Zhang, Meng, Zhang, Zhang &amp; Sun (2023), Forests 14:1319, Figure 1, doi:10.3390/f14071319 (CC BY 4.0; in-forest scenes in Shenyang, Heyi and Caohekou forest parks, Liaoning, China). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='inforest2023:';\n  var app=document.getElementById('app'), Q={}, files={}, ans={}, rated={}, SPEC=null, TR=[], ITEMS=[], vorder=[], rorder=[], viewed=0, timer=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function q(n){return Q[n]||{};}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function page(html,btn,cb){app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn)+'</button></div><div class=\"err\"></div>';document.getElementById('go').onclick=cb;app.onchange=hideErr;}\n  function next(){\n    window.scrollTo(0,0);clearTimeout(timer);\n    if(!ans.intro)return intro();\n    if(!ans.about)return about();\n    if(viewed<vorder.length){if(viewed===0&&!ans.vstart)return viewIntro();return view();}\n    for(var i=0;i<rorder.length;i++){if(!rated[rorder[i]])return rate(rorder[i]);}\n    finish();\n  }\n  function intro(){\n    var miss=!files['filler.jpg']||TR.some(function(t){return !files[t.id+'.jpg'];});\n    if(miss){app.innerHTML='<h1>Pictures missing</h1><p>Media folder inforest must hold A.jpg … I.jpg and filler.jpg.</p>';return;}\n    page('<h1>Inside the forest</h1><p>This study has two parts. First you simply look at ten photographs taken inside forest parks, one after another. Each is shown for 15 seconds, with a short grey screen in between; you do not need to do anything. Then you see nine of them again and rate each scene on nine short points.</p><p>It takes about 10 minutes. Please use a computer or tablet if you can, in a quiet place. Your answers are anonymous and used only for research.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      var b=this;b.disabled=true;SPSite.answer('consent',true).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}ans.intro=true;save('a',ans);next();});});\n  }\n  function about(){\n    var ns=['gender','age','education','major'];\n    var h=ns.map(function(n){var d=q(n);if(n==='age')return '<div class=\"q\"><b>'+esc(d.title)+'</b><input type=\"number\" inputmode=\"numeric\" name=\"age\" min=\"16\" max=\"99\"></div>';\n      return '<div class=\"q\"><b>'+esc(d.title)+'</b>'+(d.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('');\n    page('<h1>About you</h1><div class=\"card\">'+h+'</div>','Continue',function(){\n      var l=[];for(var i=0;i<ns.length;i++){var n=ns[i];if(n==='age'){var v=app.querySelector('input[name=age]').value.trim(),a=Number(v);if(!v||!(a>=16&&a<=99)||Math.round(a)!==a)return err('Please enter your age in years.');l.push(['age',a]);continue;}\n        var x=app.querySelector('input[name=\"'+n+'\"]:checked');if(!x)return err('Please answer: '+q(n).title);l.push([n,Number(x.value)]);}\n      var b=this;b.disabled=true;Promise.all(l.map(function(x){return SPSite.answer(x[0],x[1]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}ans.about=true;save('a',ans);next();});});\n  }\n  function viewIntro(){\n    page('<h1>Part 1: just look</h1><div class=\"card\"><p style=\"margin:0\">You will now see ten photographs, each for 15 seconds, with a short grey screen between them. Simply look at each scene as if you were standing in the forest. The next photograph appears by itself.</p></div>','Begin',function(){ans.vstart=true;save('a',ans);next();});\n  }\n  function view(){\n    var filler=!ans.filler, k=filler?'filler':vorder[viewed], f=files[k+'.jpg'], gap=filler?0:3000, n=filler?1:viewed+2, tot=vorder.length+1;\n    app.innerHTML='<div class=\"top\"><span class=\"t\">Part 1 · photograph '+n+' of '+tot+'</span><div class=\"bar\"><i style=\"width:'+(100*(n-1)/tot)+'%\"></i></div></div><div class=\"stage\" id=\"st\"></div>';\n    var im=new Image();im.src=f.url;\n    timer=setTimeout(function(){var st=document.getElementById('st');if(!st)return;st.innerHTML='<img alt=\"Forest scene photograph\" src=\"'+esc(f.url)+'\">';\n      timer=setTimeout(function(){if(filler){ans.filler=true;save('a',ans);next();return;}SPSite.answer('free_viewing',15,{key:k,shown:[f.name]});viewed++;save('viewed',viewed);next();},15000);},gap);\n  }\n  function rate(k){\n    var n=0;rorder.forEach(function(x){if(rated[x])n++;});var f=files[k+'.jpg'],S=[1,2,3,4,5,6,7];\n    var h='<div class=\"lk hd\"><span></span>'+S.map(function(v){return '<span class=\"h\">'+v+'</span>';}).join('')+'</div>'+\n      ITEMS.map(function(it){return '<div class=\"lk\" role=\"radiogroup\" aria-label=\"'+esc(it.text)+'\"><span class=\"it\"><small>'+esc(it.group)+'</small>'+esc(it.text)+'</span>'+S.map(function(v){return '<label><input type=\"radio\" name=\"'+it.name+'\" value=\"'+v+'\" aria-label=\"'+v+'\"></label>';}).join('')+'</div>';}).join('');\n    page('<div class=\"top\"><span class=\"t\">Part 2 · photograph '+(n+1)+' of '+rorder.length+'</span><div class=\"bar\"><i style=\"width:'+(100*n/rorder.length)+'%\"></i></div></div><div class=\"card\"><div class=\"pic\"><img alt=\"Forest scene photograph\" src=\"'+esc(f.url)+'\"></div><div class=\"q\"><b>'+esc(q('scene_evaluation').title)+'</b><div class=\"anch\">1 = lowest · 7 = highest</div>'+h+'</div></div>',n===rorder.length-1?'Finish':'Next photograph',function(){\n      var v={};for(var i=0;i<ITEMS.length;i++){var x=app.querySelector('input[name=\"'+ITEMS[i].name+'\"]:checked');if(!x)return err('Please rate all nine points.');v[ITEMS[i].name]=Number(x.value);}\n      var b=this;b.disabled=true;SPSite.answer('scene_evaluation',v,{key:k,shown:[f.name]}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}rated[k]=true;next();});});\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>The nine scenes came from three forest parks in Liaoning, northern China, and differ in how the trees are spread: evenly (A–C), at random (D–F) or in clusters (G–I). In the original study, 60 students looked at them on an eye tracker and then rated them. Satisfaction did not differ much between landscape students and students of other subjects, but the more satisfied people were with a scene, the more they wanted to see it again. Which spatial qualities mattered changed with the tree layout and with the viewer’s background.</p><p style=\"font-size:.82rem\">Photographs and method: Gao, Y., Wang, Y., Zhang, W., Meng, H., Zhang, Z., Zhang, T., &amp; Sun, X. (2023). Main Factors of Professional Experience on People’s Visual Behavior and Re-Viewing Intention in Different In-Forest Landscapes. Forests 14:1319, doi:10.3390/f14071319.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')ans.intro=false;else if(x==='free_viewing'){viewed=0;ans.vstart=false;ans.filler=false;}else if(x==='scene_evaluation')rated={};else ans.about=false;});save('a',ans);save('viewed',viewed);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='scene_evaluation'){TR=e.trials;ITEMS=e.items;}});});\n    (SPSite.getMedia('inforest')||[]).forEach(function(f){files[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};ans=load('a')||{};\n    var ids=TR.map(function(t){return t.id;});\n    function ord(n){var o=load(n);return ids.slice();}\n    vorder=ord('vorder');rorder=ord('rorder');\n    var vt=(a.free_viewing&&a.free_viewing.trials)||[];viewed=Math.max(load('viewed')||0,vt.length);if(viewed>vorder.length)viewed=vorder.length;\n    ((a.scene_evaluation&&a.scene_evaluation.trials)||[]).forEach(function(t){if(t.key)rated[t.key]=true;});\n    ans.intro=a.consent===true;ans.about=a.major!=null;if(viewed>0){ans.vstart=true;ans.filler=true;}\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
