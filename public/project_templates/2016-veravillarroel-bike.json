   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Bike Lane Colours</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Bike Lane Colours\",\n  \"description\": \"Faithful replication of the picture survey in Vera-Villarroel, Contreras, Lillo, Beyle, Segovia, Rojo, Moreno & Oyarzo (2016), PLOS ONE 11(8):e0160399, with the authors' 15 pictures of three bike lane intersections in Santiago, Chile, digitally painted in five colours. Participants rate each picture for how distinguishable, pleasant and safe the colour of the intersection seems.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"lanes\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"lanes\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I have read the information above and agree to take part.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"Yes\",\n      \"labelFalse\": \"No\"\n     },\n     {\n      \"type\": \"imageslidergroup\",\n      \"name\": \"ratings\",\n      \"title\": \"Bike lane intersection ratings\",\n      \"isRequired\": true,\n      \"imageCount\": 1,\n      \"scaleMin\": 1,\n      \"scaleMax\": 5,\n      \"description\": \"One row per picture (key = <design>_<colour>). Design: full = fully painted intersection, line = line-delimited intersection, chess = partially painted chessboard design. Colour: yellow (the original), blue, green, white, red (digitally recoloured by the authors). All 15 pictures in random order, three statements each on a 1–5 agreement scale: saliency, liking, safety. Analysis in the paper: MANCOVA of colour × design on the three outcomes with Bonferroni post hoc tests.\",\n      \"dimensions\": [\n       {\n        \"id\": \"saliency\",\n        \"label\": \"The colour of this bike lane intersection is clearly distinguishable.\",\n        \"left\": \"I strongly disagree\",\n        \"right\": \"I strongly agree\",\n        \"min\": 1,\n        \"max\": 5,\n        \"step\": 1\n       },\n       {\n        \"id\": \"liking\",\n        \"label\": \"The colour of this bike lane intersection seems pleasant to me.\",\n        \"left\": \"I strongly disagree\",\n        \"right\": \"I strongly agree\",\n        \"min\": 1,\n        \"max\": 5,\n        \"step\": 1\n       },\n       {\n        \"id\": \"safety\",\n        \"label\": \"The colour of this bike lane intersection seems appropriate for my safety.\",\n        \"left\": \"I strongly disagree\",\n        \"right\": \"I strongly agree\",\n        \"min\": 1,\n        \"max\": 5,\n        \"step\": 1\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"What is your gender?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Male\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"inputType\": \"number\",\n      \"min\": 18,\n      \"max\": 99\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#eef0f2;--card:#fff;--ink:#1b1e22;--muted:#5a616b;--accent:#2f5d62;--accent-ink:#fff;--line:#d5d9de;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.4rem;margin:0 0 10px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q>b{display:block;margin-bottom:4px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:120px}\n.pic{background:#2a2d31;border-radius:12px;overflow:hidden;display:flex;align-items:center;justify-content:center;aspect-ratio:16/10;max-height:min(48vh,500px)}\n.pic img{max-width:100%;max-height:100%;object-fit:contain;display:block}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem;font-variant-numeric:tabular-nums}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.qq{font-weight:600;margin:12px 0 6px}\n.sc{display:grid;grid-template-columns:repeat(5,1fr);gap:5px}\n.sc button{appearance:none;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:9px;padding:11px 0;font:inherit;font-weight:700;cursor:pointer}\n.sc button.on{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}\n.dot{width:10px;height:10px;border-radius:50%;background:#fff;display:block}\n.fix{background:#2a2d31;border-radius:12px;aspect-ratio:4/3;max-height:min(58vh,560px);display:flex;align-items:center;justify-content:center;color:#fff;font-size:3rem;font-weight:300}\n.ends{display:flex;justify-content:space-between;font-size:.82rem;color:var(--muted);margin-top:3px;gap:12px}.ends span:last-child{text-align:right}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Pictures: Vera-Villarroel et al. (2016), PLOS ONE 11(8):e0160399, doi:10.1371/journal.pone.0160399 (CC BY 4.0). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='bikelanes2016:';\n  var app=document.getElementById('app'), Q={}, M={}, D=null, ans={}, done={}, order=[];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function saveAll(l,b,cb){Promise.all(l.map(function(a){return a[2]?SPSite.answer(a[0],a[1],a[2]):SPSite.answer(a[0],a[1]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}cb();});}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function stem(n){return n.replace(/\\.[^.]+$/,'');}\n  function list(){return M.lanes||[];}\n  function byName(n){var l=list();for(var i=0;i<l.length;i++)if(l[i].name===n)return l[i];}\n  function page(title,html,btn,cb){\n    app.innerHTML='<div class=\"card\">'+(title?'<h1>'+esc(title)+'</h1>':'')+html+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">'+esc(btn||'Continue')+'</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=cb;\n  }\n  function radios(name){return (Q[name].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+name+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');}\n  function val(n){var x=app.querySelector('input[name='+n+']:checked');return x?Number(x.value):null;}\n  var DM=[];\n  function intro(){\n    if(list().length<15){app.innerHTML='<h1>Pictures missing</h1><p>Media folder lanes must hold the 15 pictures.</p>';return;}\n    page('Colours of bike lane intersections','<p>In this study you will see 15 pictures of bike lane intersections, one at a time. For each picture, please say how much you agree with three short statements about the colour of the intersection. It takes about 5 minutes.</p><p>Participation is voluntary and anonymous. You must be 18 or older.</p><label class=\"opt\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var b=this;b.disabled=true;saveAll([['consent',true]],b,function(){ans.intro=true;next();});\n    });\n  }\n  function next(){\n    window.scrollTo(0,0);\n    if(!ans.intro)return intro();\n    for(var j=0;j<order.length;j++){if(!done[stem(order[j])])return rate(j);}\n    if(!ans.about)return about();\n    finish();\n  }\n  function scale(d){var b='';for(var v=d.min;v<=d.max;v++)b+='<button type=\"button\" data-d=\"'+d.id+'\" data-v=\"'+v+'\">'+v+'</button>';\n    return '<div class=\"qq\">'+esc(d.label)+'</div><div class=\"sc\">'+b+'</div><div class=\"ends\"><span>'+d.min+' = '+esc(d.left)+'</span><span>'+d.max+' = '+esc(d.right)+'</span></div>';}\n  function rate(j){\n    var f=byName(order[j]), k=stem(f.name), n=0, v={};order.forEach(function(x){if(done[stem(x)])n++;});\n    app.innerHTML='<div class=\"top\"><span class=\"t\">Picture '+(n+1)+' of '+order.length+'</span><div class=\"bar\"><i style=\"width:'+(100*n/order.length)+'%\"></i></div></div>'+\n      '<div class=\"pic\"><img alt=\"Photograph of a bike lane intersection\" src=\"'+esc(f.url)+'\"></div>'+DM.map(scale).join('')+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div>';\n    app.querySelectorAll('.sc button').forEach(function(x){x.onclick=function(){v[x.dataset.d]=Number(x.dataset.v);\n      app.querySelectorAll('.sc button[data-d=\"'+x.dataset.d+'\"]').forEach(function(y){y.classList.toggle('on',y===x);});err('');};});\n    document.getElementById('go').onclick=function(){\n      for(var i=0;i<DM.length;i++)if(!v[DM[i].id])return err('Please answer: '+DM[i].label);\n      var b=this;b.disabled=true;\n      SPSite.answer('ratings',v,{key:k,shown:[f.name]}).then(function(r){\n        if(!ok(r)){b.disabled=false;return err(r.error);}done[k]=true;next();});\n    };\n  }\n  function about(){\n    page('About you','<div class=\"q\"><b>'+esc(Q.gender.title)+'</b>'+radios('gender')+'</div><div class=\"q\"><b>'+esc(Q.age.title)+'</b><input type=\"number\" name=\"age\" min=\"18\" max=\"99\" inputmode=\"numeric\"></div>','Finish',function(){\n      var g=val('gender');if(!g)return err('Please answer: '+Q.gender.title);\n      var a=Number((app.querySelector('input[name=age]')||{}).value);if(!a||a<18||a>99)return err('Please enter your age in years.');\n      var b=this;b.disabled=true;saveAll([['gender',g],['age',a]],b,function(){ans.about=true;next();});\n    });\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>The pictures showed three real bike lane intersections in Santiago, Chile (fully painted, marked with lines, and painted in a chessboard pattern), each digitally recoloured yellow, blue, green, white or red. In the original survey of 538 Chilean adults, red was rated most positively, followed by yellow and blue, and the colour mattered much more than the intersection design.</p><p style=\"font-size:.82rem\">Pictures and task: Vera-Villarroel, P., Contreras, D., Lillo, S., Beyle, C., Segovia, A., Rojo, N., Moreno, S., &amp; Oyarzo, F. (2016). Perception of safety and liking associated to the colour intervention of bike lanes: Contribution from the behavioural sciences to urban design and wellbeing. PLOS ONE 11(8):e0160399, doi:10.1371/journal.pone.0160399. Used with credit and removed if the authors object.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){\n      if(x==='consent')ans.intro=false;else if(x==='ratings')done={};else ans.about=false;});next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    ['consent','gender','age'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    var R=SPSite.getQuestion('ratings')||{};var L='I strongly disagree',Rr='I strongly agree';\n    DM=(R.dimensions&&R.dimensions.length===3)?R.dimensions:[\n      {id:'saliency',label:'The colour of this bike lane intersection is clearly distinguishable.',left:L,right:Rr,min:1,max:5},\n      {id:'liking',label:'The colour of this bike lane intersection seems pleasant to me.',left:L,right:Rr,min:1,max:5},\n      {id:'safety',label:'The colour of this bike lane intersection seems appropriate for my safety.',left:L,right:Rr,min:1,max:5}];\n    M.lanes=(SPSite.getMedia('lanes')||[]).slice();\n    var a=(ctx&&ctx.answers)||{};\n    var names=list().map(function(f){return f.name;});var o=load('order');\n    if(!o||o.length!==names.length||o.some(function(x){return names.indexOf(x)<0;}))o=shuffle(names);order=o;save('order',order);\n    ((a.ratings&&a.ratings.trials)||[]).forEach(function(t){if(t.key)done[t.key]=true;});\n    if(a.consent===true)ans.intro=true;\n    if(a.age!=null)ans.about=true;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
