   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Ceramic Tile Visual Comfort</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Ceramic Tile Visual Comfort\",\n  \"description\": \"Faithful replication with the original renderings: six renderings of the same empty room with a window and a small table and chairs, made in Kujiale and identical except for the floor tiles, in the paper's 3 x 2 design of tile brightness (light, medium and dark toned) and texture (textured marble pattern and non-textured). Participants see the six rooms one at a time and answer, for each, the paper's 12 visual comfort questions (Table 4), each with its five labelled answers from the negative to the positive end (e.g. Do the ceramic tiles here feel ugly or beautiful? Very ugly ... Very beautiful): physiological comfort (temperature, brightness, spaciousness, vitality), aesthetic comfort (order, beauty, refinement, neatness) and emotional comfort (pleasure, intimacy, calm, relaxation). Gender and age are asked first. Rebuilt from Chen, Cheng & Guo (2024), Evaluation Method and the Influence of Visual Comfort of Ceramic Tiles in Indoor Environment—A Study Based on the Delphi and AHP, Buildings 14(9): 2829, with the renderings cropped from its Figure 1 and the questions from its Table 4 (CC BY 4.0). Image ids: a_light_textured, b_medium_textured, c_dark_textured, d_light_nontextured, e_medium_nontextured, f_dark_nontextured (samples a-f of Figure 1); answers are in comfort, keyed by image id, with items C1-C12 scored 1-5; the paper's AHP weights are stored in the page's original-study block. Analysis as in the paper: weighted visual comfort score per participant and room (sum of each answer times the paper's AHP weight, e.g. brightness 0.1632, relaxation 0.1286, spaciousness 0.1276) and per dimension, averaged per room, and repeated-measures ANOVA with brightness and texture within subjects and gender between subjects; the paper (342 valid paper questionnaires from college students, mean age 20.2) found the light-toned non-textured tiles most comfortable (3.949) and the dark-toned textured tiles least (2.657), brightness and texture significant for the total score, and men rating aesthetic comfort lower than women. Differences from the original study: (1) the paper used paper questionnaires handed to college students; here the survey is online and anyone can take part; (2) the paper does not state the order of the rooms, so here they are shown in individually randomized order; (3) the gender and age questions and the instruction text are ours; the paper reports gender and mean age only; (4) the renderings are the figure copies (about 1220 px wide).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"rooms\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 16,\n      \"max\": 110\n     }\n    ]\n   },\n   {\n    \"name\": \"rooms\",\n    \"elements\": [\n     {\n      \"type\": \"matrix\",\n      \"name\": \"comfort\",\n      \"title\": \"Visual comfort of the ceramic tiles\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"C1\",\n        \"text\": \"Does the ceramic tile feel uncomfortable or moderate in temperature?\"\n       },\n       {\n        \"value\": \"C2\",\n        \"text\": \"Does the ceramic tile feel harsh/dim or moderate?\"\n       },\n       {\n        \"value\": \"C3\",\n        \"text\": \"Do the ceramic tiles make people feel cramped or spacious?\"\n       },\n       {\n        \"value\": \"C4\",\n        \"text\": \"Do the ceramic tiles make people feel sleepy or active?\"\n       },\n       {\n        \"value\": \"C5\",\n        \"text\": \"Do the ceramic tiles feel messy or orderly?\"\n       },\n       {\n        \"value\": \"C6\",\n        \"text\": \"Do the ceramic tiles here feel ugly or beautiful?\"\n       },\n       {\n        \"value\": \"C7\",\n        \"text\": \"Do the ceramic tiles here feel rough or delicate?\"\n       },\n       {\n        \"value\": \"C8\",\n        \"text\": \"Do the ceramic tiles feel messy or neat?\"\n       },\n       {\n        \"value\": \"C9\",\n        \"text\": \"Do the ceramic tiles make people sad or happy?\"\n       },\n       {\n        \"value\": \"C10\",\n        \"text\": \"Do the ceramic tiles make people feel distant or close?\"\n       },\n       {\n        \"value\": \"C11\",\n        \"text\": \"Do the ceramic tiles make people feel irritable or calm?\"\n       },\n       {\n        \"value\": \"C12\",\n        \"text\": \"Do the ceramic tiles make people feel nervous or relaxed?\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       }\n      ],\n      \"description\": \"1 = most negative answer (e.g. very ugly), 5 = most positive (e.g. very beautiful). Keyed by image id.\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"tile-original\">{\"source\": \"Chen, Cheng & Guo (2024) Buildings 14: 2829\", \"n\": 342, \"items\": {\"C1\": {\"indicator\": \"temperature\", \"options\": [\"Very uncomfortable\", \"Relatively uncomfortable\", \"Neutral\", \"Relatively suitable\", \"Very suitable\"]}, \"C2\": {\"indicator\": \"brightness\", \"options\": [\"Very harsh/dim\", \"Relatively harsh/dim\", \"Neutral\", \"Relatively moderate\", \"Very moderate\"]}, \"C3\": {\"indicator\": \"spaciousness\", \"options\": [\"Very cramped\", \"Relatively cramped\", \"Neutral\", \"Relatively spacious\", \"Very spacious\"]}, \"C4\": {\"indicator\": \"vitality\", \"options\": [\"Very sleepy\", \"Relatively sleepy\", \"Neutral\", \"Relatively active\", \"Very active\"]}, \"C5\": {\"indicator\": \"order\", \"options\": [\"Very messy\", \"Relatively messy\", \"Neutral\", \"Relatively orderly\", \"Very orderly\"]}, \"C6\": {\"indicator\": \"aesthetics\", \"options\": [\"Very ugly\", \"Relatively ugly\", \"Neutral\", \"Relatively beautiful\", \"Very beautiful\"]}, \"C7\": {\"indicator\": \"refinement\", \"options\": [\"Very rough\", \"Relatively rough\", \"Neutral\", \"Relatively delicate\", \"Very delicate\"]}, \"C8\": {\"indicator\": \"neatness\", \"options\": [\"Very messy\", \"Relatively messy\", \"Neutral\", \"Relatively neat\", \"Very neat\"]}, \"C9\": {\"indicator\": \"pleasure\", \"options\": [\"Very sad\", \"Relatively sad\", \"Neutral\", \"Relatively pleasant\", \"Very pleasant\"]}, \"C10\": {\"indicator\": \"intimacy\", \"options\": [\"Very distant\", \"Relatively distant\", \"Neutral\", \"Relatively close\", \"Very close\"]}, \"C11\": {\"indicator\": \"calm\", \"options\": [\"Very irritable\", \"Relatively irritable\", \"Neutral\", \"Relatively calm\", \"Very calm\"]}, \"C12\": {\"indicator\": \"relaxation\", \"options\": [\"Very nervous\", \"Relatively nervous\", \"Neutral\", \"Relatively relaxed\", \"Very relaxed\"]}}, \"ahp_weights\": {\"C1\": 0.0426, \"C2\": 0.1632, \"C3\": 0.1276, \"C4\": 0.0666, \"C5\": 0.0261, \"C6\": 0.1156, \"C7\": 0.0427, \"C8\": 0.1156, \"C9\": 0.0712, \"C10\": 0.029, \"C11\": 0.0712, \"C12\": 0.1286}, \"dimensions\": {\"physiological\": [\"C1\", \"C2\", \"C3\", \"C4\"], \"aesthetic\": [\"C5\", \"C6\", \"C7\", \"C8\"], \"emotional\": [\"C9\", \"C10\", \"C11\", \"C12\"]}, \"images\": [\"a_light_textured\", \"b_medium_textured\", \"c_dark_textured\", \"d_light_nontextured\", \"e_medium_nontextured\", \"f_dark_nontextured\"], \"total_reported\": {\"a_light_textured\": 3.751, \"b_medium_textured\": 3.087, \"c_dark_textured\": 2.657, \"d_light_nontextured\": 3.949, \"e_medium_nontextured\": 3.396, \"f_dark_nontextured\": 2.895}}</script>\n<style>\n:root{--bg:#f1f0ee;--card:#fff;--ink:#1f1e1c;--muted:#5f5c57;--accent:#7a4e2d;--line:#dcd8d2;--warn:#b3261e;--sel:#f1e4d8}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.08rem;margin:0 0 4px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.prompt{font-size:.92rem;color:var(--muted);margin:6px 0 0;text-align:center}\n.scene{position:sticky;top:0;z-index:3;background:var(--bg);padding-bottom:6px}\n.scene img{max-width:100%;max-height:42vh;width:auto;height:auto;display:block;margin:0 auto;border-radius:10px}\n@media (max-height:700px),(max-width:600px){.scene{position:static}}\n.it{padding:10px 0;border-top:1px solid var(--line)}\n.it .st{font-weight:600;margin-bottom:6px;font-size:.96rem}\n.it .o{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px}\n.it label{display:flex;justify-content:center;align-items:center;text-align:center;gap:4px;border:1px solid var(--line);border-radius:8px;padding:7px 4px;cursor:pointer;font-size:.84rem;line-height:1.25}\n.it label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.it label input{display:none}@media (max-width:600px){.it .o{grid-template-columns:1fr}.it label{justify-content:flex-start;padding:9px 12px;font-size:.92rem}}\n.it .an{display:flex;justify-content:space-between;font-size:.74rem;color:var(--muted);margin-top:3px}\n.it.miss .o,.q.miss{outline:2px solid var(--warn);outline-offset:2px;border-radius:8px}\n.q{margin-top:16px}.q:first-child{margin-top:0}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\ninput[type=text]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:100%;max-width:420px;margin-top:6px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Renderings and questions: Chen, Cheng &amp; Guo (2024), Buildings 14(9): 2829, Figure 1 and Table 4 (doi:10.3390/buildings14092829, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='ceramic-tile-comfort:state';\n  var ORIG=JSON.parse(document.getElementById('tile-original').textContent), IDS=ORIG.images;\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function fresh(){return {step:'intro',order:shuffle(IDS),k:0};}\n  function intro(){\n    app.innerHTML='<h1>Floor tiles in a room</h1><p>You will see the same room six times, each time with different ceramic floor tiles. For each room, answer 12 short questions about how the tiles look and make you feel. It takes about 10 minutes.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"q\" data-q=\"gender\"><b>'+esc(Q.gender.title)+'</b>'+(Q.gender.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"gender\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div><div class=\"q\" data-q=\"age\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"16\" max=\"110\" style=\"font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px;margin-top:6px\"></div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var age=Number(document.getElementById('age').value),g=app.querySelector('input[name=gender]:checked');if(!g)return err('Please choose your gender.');if(!(age>=16&&age<=110))return err('Please enter your age.');\n      send([SPSite.answer('gender',g.value),SPSite.answer('age',age)],this,function(){st.step='room';st.k=0;save();route();});};\n  }\n  function room(){\n    if(st.k>=st.order.length){st.step='done';save();return route();}\n    var id=st.order[st.k],f=files[id],q=Q.comfort;\n    app.innerHTML='<div class=\"prog\">Room '+(st.k+1)+' of '+st.order.length+'</div><div class=\"scene\"><img alt=\"Rendered room with ceramic floor tiles\" src=\"'+esc(f.url)+'\"></div>'+\n      '<div class=\"card\">'+(q.rows||[]).map(function(r){var nm='c__'+r.value,o=(ORIG.items[r.value]||{}).options||['1','2','3','4','5'];\n      return '<div class=\"it\" data-n=\"'+nm+'\"><div class=\"st\">'+esc(r.text)+'</div><div class=\"o\">'+o.map(function(t,i){return '<label><input type=\"radio\" name=\"'+nm+'\" value=\"'+(i+1)+'\">'+esc(t)+'</label>';}).join('')+'</div></div>';}).join('')+'</div>'+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">'+(st.k<st.order.length-1?'Next room':'Finish')+'</button></div><div class=\"err\"></div>';\n    document.getElementById('go').onclick=function(){\n      var a={},miss=[];(q.rows||[]).forEach(function(r){var nm='c__'+r.value,x=app.querySelector('input[name=\"'+nm+'\"]:checked');if(x)a[r.value]=Number(x.value);else miss.push(app.querySelector('.it[data-n=\"'+nm+'\"]'));});\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please answer every question.');}\n      send([SPSite.answer('comfort',a,{key:id,shown:[f.name]})],this,function(){st.k++;save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var r=e.target.closest&&e.target.closest('.it');if(r){r.classList.remove('miss');if(!app.querySelector('.it.miss'))err('');}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='room')return room();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','gender','age','comfort'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{name:n};});\n    (SPSite.getMedia('rooms')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=IDS.filter(function(k){return !files[k];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"rooms\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.order)||a.consent!==true)st=fresh();\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
