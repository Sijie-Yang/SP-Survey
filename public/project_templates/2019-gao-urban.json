   "id": "site-7d5c52cdd55c0d5d",
   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Urban Green Spaces</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Urban Green Space Structure and Landscape Preference\",\n  \"description\": \"Faithful replication of the photo-elicitation condition with the original photographs: three small urban green spaces in China (the paper does not name the sites), photographed in early spring and differing in the horizontal structure of their vegetation, open (less than 10% tree and shrub canopy), semi-open (30-70%) and closed (more than 70%). Each participant is randomly assigned to one green space and sees its three photos as a slide show, each photo for 20 s, the whole set shown twice (as in the paper's slide projection). They then answer the paper's questionnaire: gender, whether they study landscape architecture, preference for the green space on a 5-point scale (1 strongly dislike - 5 strongly like), which recreational activities they would like to do there (the paper's 12 activities in three groups: physical - playing ball games, flying kites, practicing martial arts, walking; social - picnicking, gatherings, chatting, playing games; mental - emptying, meditating, sitting quietly, thinking) and a free comment. Rebuilt from Gao, Liang, Chen & Qiu (2019), Comparisons of Landscape Preferences through Three Different Perceptual Approaches, International Journal of Environmental Research and Public Health 16(23): 4754, with the nine photos cropped from its Figure 1 (CC BY 4.0). Image ids: open_1-3, semi_open_1-3, closed_1-3; green_space records the assignment. Analysis as in the paper: GLM of preference on green-space type, gender and professional background with Duncan post hoc tests, and counts of chosen activities by type; the paper (180 students, 20 per group) found the semi-open space preferred most, then closed, then open, no gender or professional effects, and walking the most chosen activity (45.5%). Differences from the original study: (1) only the photo condition is rebuilt; the on-site visit and the VR-headset panorama conditions of the paper are not included; (2) the question wording, the gloss '(the mind)' after 'emptying', the 'none' option for activities and the comment prompt are ours (the paper lists the content but does not print the questions); (3) the paper's participants were college students in a classroom; anyone can take part here.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"greenspaces\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"green_space\",\n      \"title\": \"Assigned green space\",\n      \"description\": \"Set at random by the page.\",\n      \"choices\": [\n       {\n        \"value\": \"open\",\n        \"text\": \"Open green space (<10% canopy)\"\n       },\n       {\n        \"value\": \"semi_open\",\n        \"text\": \"Semi-open green space (30-70% canopy)\"\n       },\n       {\n        \"value\": \"closed\",\n        \"text\": \"Closed green space (>70% canopy)\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"questionnaire\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"profession\",\n      \"title\": \"Do you study or work in landscape architecture?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"professional\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"non_professional\",\n        \"text\": \"No\"\n       }\n      ]\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"preference\",\n      \"title\": \"How much do you like this green space?\",\n      \"isRequired\": true,\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly dislike\",\n      \"maxRateDescription\": \"Strongly like\",\n      \"description\": \"1-5, keyed by green_space.\"\n     },\n     {\n      \"type\": \"checkbox\",\n      \"name\": \"activities\",\n      \"title\": \"Which activities would you like to do in this green space? Choose all that apply.\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"ball_games\",\n        \"text\": \"Playing ball games (physical)\"\n       },\n       {\n        \"value\": \"kites\",\n        \"text\": \"Flying kites (physical)\"\n       },\n       {\n        \"value\": \"martial_arts\",\n        \"text\": \"Practicing martial arts (physical)\"\n       },\n       {\n        \"value\": \"walking\",\n        \"text\": \"Walking (physical)\"\n       },\n       {\n        \"value\": \"picnicking\",\n        \"text\": \"Picnicking (social)\"\n       },\n       {\n        \"value\": \"gatherings\",\n        \"text\": \"Gatherings (social)\"\n       },\n       {\n        \"value\": \"chatting\",\n        \"text\": \"Chatting (social)\"\n       },\n       {\n        \"value\": \"playing_games\",\n        \"text\": \"Playing games (social)\"\n       },\n       {\n        \"value\": \"emptying\",\n        \"text\": \"Emptying (the mind) (mental)\"\n       },\n       {\n        \"value\": \"meditating\",\n        \"text\": \"Meditating (mental)\"\n       },\n       {\n        \"value\": \"sitting_quietly\",\n        \"text\": \"Sitting quietly (mental)\"\n       },\n       {\n        \"value\": \"thinking\",\n        \"text\": \"Thinking (mental)\"\n       },\n       {\n        \"value\": \"none\",\n        \"text\": \"None of these\"\n       }\n      ]\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"comments\",\n      \"title\": \"What do you like or dislike about this green space?\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"green-structure-original\">{\"source\": \"Gao, Liang, Chen & Qiu (2019) IJERPH 16(23): 4754\", \"n\": 180, \"valid\": 179, \"participants\": \"college students, male:female 1:1.5, landscape-architecture:other 3:7, 9 groups of 20 (3 approaches x 3 green spaces)\", \"photo_condition\": \"slide projection, each photo of one green space shown twice for 20 s in a loop, then questionnaire\", \"results\": {\"preference_order\": [\"semi_open\", \"closed\", \"open\"], \"approach\": \"VR rated highest; photo and on-site did not differ\", \"gender_profession\": \"no effect\", \"activities\": {\"walking\": 0.455, \"picnicking\": 0.099, \"chatting\": 0.099, \"willing_any\": \"121 of 179\"}}}</script>\n<style>\n:root{--bg:#f0f1ea;--card:#fff;--ink:#1f2219;--muted:#5d6352;--accent:#55702a;--line:#dadcd0;--warn:#b3261e;--sel:#e8eed9}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.view{position:fixed;inset:0;background:#111;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:5;gap:12px}\n.view img{width:100vw;height:auto;max-height:86vh;object-fit:contain;display:block}\n.view .t{color:#999;font-size:.85rem}\n.thumbs{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:6px}\n.thumbs img{width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:6px;display:block}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.f{margin-top:18px}.f:first-child{margin-top:0}\n.rate{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;margin-top:6px}\n.rate label{display:flex;flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:8px;padding:4px 0;cursor:pointer;font-size:.85rem}\n.rate label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.ends{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);margin-top:2px}\n.grp{font-size:.8rem;color:var(--muted);margin:10px 0 0;text-transform:capitalize}\ntextarea{font:inherit;width:100%;min-height:80px;padding:8px 10px;border:1px solid var(--line);border-radius:8px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photos: Gao, Liang, Chen &amp; Qiu (2019), IJERPH 16(23): 4754, Figure 1 (doi:10.3390/ijerph16234754, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='green-structure:state', T={view:window.__VIEWMS||20000};\n  var SP=['open','semi_open','closed'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function ids(){return [1,2,3].map(function(i){return st.space+'_'+i;});}\n  function shown(){return ids().map(function(k){return files[k].name;});}\n  function fresh(){return {step:'intro',space:SP[Math.floor(Math.random()*3)],k:0};}\n  function intro(){\n    app.innerHTML='<h1>An urban green space</h1><p>You will see three photos of one green space in a city, as a slide show. Each photo is shown for 20 seconds and the set is shown twice (about two minutes; the page moves on by itself). Then you answer a few short questions about the place. It takes about 5 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true),SPSite.answer('green_space',st.space)],this,function(){st.step='show';st.k=0;save();route();});};\n  }\n  function show(){\n    var seq=ids().concat(ids());\n    if(st.k>=seq.length){st.step='ask';save();return route();}\n    var id=seq[st.k],v=document.createElement('div');v.className='view';app.innerHTML='';app.appendChild(v);\n    v.innerHTML='<img alt=\"Green space\" src=\"'+esc(files[id].url)+'\"><div class=\"t\" id=\"tm\"></div>';\n    if(st.k+1<seq.length){var p=new Image();p.src=files[seq[st.k+1]].url;}\n    var end=Date.now()+T.view,tm=document.getElementById('tm');\n    (function tick(){var s=Math.ceil((end-Date.now())/1000);if(s<=0){st.k++;save();return route();}if(tm)tm.textContent='Photo '+(st.k+1)+' of '+seq.length+' · '+s+' s';setTimeout(tick,250);})();\n  }\n  function radios(n){return '<div class=\"f\"><b>'+esc(Q[n].title)+'</b>'+(Q[n].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function ask(){\n    var q=Q.preference,grp='';\n    var acts=(Q.activities.choices||[]).map(function(c){var m=String(c.text).match(/^(.*) \\((\\w+)\\)$/),g=m?m[2]:'',t=m?m[1]:c.text,h='';if(g!==grp){grp=g;h='<div class=\"grp\">'+esc(g||'')+'</div>';}return h+'<label class=\"opt\"><input type=\"checkbox\" name=\"activities\" value=\"'+esc(c.value)+'\"> '+esc(t)+'</label>';}).join('');\n    app.innerHTML='<h2>About this green space</h2><div class=\"thumbs\">'+ids().map(function(k){return '<img alt=\"\" src=\"'+esc(files[k].url)+'\">';}).join('')+'</div><div class=\"card\">'+radios('gender')+radios('profession')+\n      '<div class=\"f\"><b>'+esc(q.title)+'</b><div class=\"rate\">'+[1,2,3,4,5].map(function(v){return '<label><input type=\"radio\" name=\"preference\" value=\"'+v+'\">'+v+'</label>';}).join('')+'</div><div class=\"ends\"><span>1 '+esc(q.minRateDescription)+'</span><span>5 '+esc(q.maxRateDescription)+'</span></div></div>'+\n      '<div class=\"f\"><b>'+esc(Q.activities.title)+'</b>'+acts+'</div><div class=\"f\"><b>'+esc(Q.comments.title)+'</b> <span style=\"color:var(--muted)\">(optional)</span><textarea id=\"cm\" maxlength=\"2000\"></textarea></div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    app.addEventListener('change',function(e){if(e.target.name!=='activities')return;var b=app.querySelectorAll('input[name=activities]');if(e.target.value==='none'&&e.target.checked)b.forEach(function(x){if(x.value!=='none')x.checked=false;});else if(e.target.checked)b.forEach(function(x){if(x.value==='none')x.checked=false;});});\n    document.getElementById('go').onclick=function(){\n      var g=val('gender'),pr=val('profession'),p=val('preference'),a=[].slice.call(app.querySelectorAll('input[name=activities]:checked')).map(function(x){return x.value;}),c=document.getElementById('cm').value.trim();\n      if(!g||!pr||!p)return err('Please answer every question.');if(!a.length)return err('Please choose at least one activity, or \"None of these\".');\n      var l=[SPSite.answer('gender',g),SPSite.answer('profession',pr),SPSite.answer('preference',Number(p),{key:st.space,shown:shown()}),SPSite.answer('activities',a)];if(c)l.push(SPSite.answer('comments',c));\n      send(l,this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='show')return show();if(s==='ask')return ask();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','green_space','gender','profession','preference','activities','comments'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('greenspaces')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=[];SP.forEach(function(s){[1,2,3].forEach(function(i){if(!files[s+'_'+i])need.push(s+'_'+i);});});\n    if(need.length){app.innerHTML='<h1>Photos missing</h1><p>Upload '+need.join(', ')+' (.jpg) to the media folder \"greenspaces\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.space)||a.consent!==true)st=fresh();\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
