rate\": [5.0, 1.75], \"high\": [5.5, 1.25]}, \"n_participants\": 200, \"per_group\": 40}</script>\n<style>\n:root{--bg:#f4f6f1;--card:#fff;--ink:#212820;--muted:#5e695c;--accent:#3b7a3a;--line:#dde4da;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:920px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.1rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n.cell{background:#000;border-radius:10px;overflow:hidden}\n.cell img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}\n.cell.miss{outline:3px solid var(--warn)}\n.rk{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;padding:6px;background:var(--card)}\n.rk button,.scale button{appearance:none;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:8px;padding:8px 0;font:inherit;font-weight:600;cursor:pointer}\n.rk button.on,.scale button.on{background:var(--accent);border-color:var(--accent);color:#fff}\n.rk button.used{opacity:.35}\n.view{background:#000;border-radius:12px;overflow:hidden;max-width:620px;margin:0 auto}\n.view img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}\n.timer{height:4px;background:var(--line);border-radius:2px;overflow:hidden;margin-top:8px}.timer>i{display:block;height:100%;background:var(--accent);width:0}\n.item{padding:12px 0;border-top:1px solid var(--line)}.item:first-child{border-top:0}\n.item .t{margin-bottom:8px}.item.miss .t{color:var(--warn)}\n.scale{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}\n.anch{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin:4px 0 6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number],input[type=text]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px}\ninput[type=number]{width:110px}input[type=text]{width:100%;max-width:360px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:920px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Wu, Zhuo, Liu, Yu, Huang &amp; Liu (2021), Int. J. Environ. Res. Public Health 18(20):10944, Figure 1, CC BY 4.0 (versions edited by the authors in Photoshop).</footer>\n<script>\n(function(){\n  var VIEW_MS=(window.__VIEWMS||15000), KEY='ugs2021:state', SETS=['a','b','c','d','e'];\n  var PRS=['prs_being_away','prs_extent','prs_fascination','prs_compatibility'];\n  var app=document.getElementById('app'), Q={}, files=[], st=null, tm=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function shuffle(a){a=a.slice();for(var k=a.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1));var x=a[k];a[k]=a[j];a[j]=x;}return a;}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function id(n){return n.replace(/\\.[^.]+$/,'');}\n  function byId(i){for(var k=0;k<files.length;k++)if(id(files[k].name)===i)return files[k];return null;}\n  function newState(){\n    var avail=SETS.filter(function(s){return files.some(function(f){return id(f.name).charAt(0)===s;});});\n    var s=avail[Math.floor(Math.random()*avail.length)];\n    var ids=files.map(function(f){return id(f.name);}).filter(function(i){return i.charAt(0)===s;}).sort();\n    return {step:'intro',set:s,grid:shuffle(ids),order:shuffle(ids),r:0};\n  }\n  function radio(n){var q=Q[n];return '<div class=\"f\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function intro(){\n    app.innerHTML='<h1>Urban green space pictures</h1><p>You will see four pictures of one park scene side by side for 15 seconds. Then you rank them by how much you like them, and rate each picture on four short statements. About 5 minutes.</p>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div class=\"f\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"16\" max=\"99\"></div>'+radio('gender')+radio('education')+'<div class=\"f\"><b>'+esc(Q.major.title)+'</b><br><input type=\"text\" id=\"major\" maxlength=\"120\"></div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var age=Number(document.getElementById('age').value);if(!(age>=16&&age<=99))return err('Please enter your age.');\n      var g=function(n){var x=app.querySelector('input[name='+n+']:checked');return x?x.value:null;};\n      var v={gender:g('gender'),education:g('education')};for(var n in v)if(!v[n])return err('Please answer: '+Q[n].title);\n      var major=document.getElementById('major').value.trim();if(!major)return err('Please answer: '+Q.major.title);\n      var b=this;b.disabled=true;\n      Promise.all([SPSite.answer('consent',true),SPSite.answer('age',age),SPSite.answer('gender',v.gender),SPSite.answer('education',v.education),SPSite.answer('major',major),SPSite.answer('scene_set',st.set)]).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}st.step='ready';save();route();});\n    };\n  }\n  function grid(withRank){\n    return '<div class=\"grid\">'+st.grid.map(function(i){var f=byId(i);var rk='';if(withRank){for(var v=1;v<=4;v++)rk+='<button type=\"button\" data-v=\"'+v+'\">'+v+'</button>';rk='<div class=\"rk\">'+rk+'</div>';}return '<div class=\"cell\" data-i=\"'+esc(i)+'\"><img alt=\"Park picture\" src=\"'+esc(f?f.url:'')+'\">'+rk+'</div>';}).join('')+'</div>';\n  }\n  function ready(){\n    app.innerHTML='<h2>Four pictures</h2><div class=\"card\"><p>Four pictures of the same place will appear together for 15 seconds. Look at them freely.</p><button class=\"btn\" id=\"go\">Show the pictures</button></div>';\n    document.getElementById('go').onclick=function(){st.step='view';save();route();};\n  }\n  function view(){\n    app.innerHTML='<p>Look at the four pictures.</p>'+grid(false)+'<div class=\"timer\"><i id=\"tb\"></i></div>';\n    var tb=document.getElementById('tb');tb.style.transition='width '+(VIEW_MS/1000)+'s linear';requestAnimationFrame(function(){requestAnimationFrame(function(){tb.style.width='100%';});});\n    tm=setTimeout(function(){st.step='rank';save();route();},VIEW_MS);\n  }\n  function rank(){\n    var ranks={};\n    app.innerHTML='<h2>Which do you like most?</h2><p>Give each picture a different rank: 4 = most preferred, 1 = least preferred.</p>'+grid(true)+'<div style=\"margin-top:14px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div>';\n    function paint(){app.querySelectorAll('.cell').forEach(function(c){var i=c.dataset.i;c.querySelectorAll('.rk button').forEach(function(b){var v=Number(b.dataset.v);b.classList.toggle('on',ranks[i]===v);var usedBy=Object.keys(ranks).filter(function(k){return k!==i&&ranks[k]===v;})[0];b.classList.toggle('used',!!usedBy);});});}\n    app.querySelectorAll('.cell').forEach(function(c){c.querySelectorAll('.rk button').forEach(function(b){b.onclick=function(){var v=Number(b.dataset.v),i=c.dataset.i;Object.keys(ranks).forEach(function(k){if(ranks[k]===v)delete ranks[k];});ranks[i]=v;c.classList.remove('miss');paint();};});});\n    document.getElementById('go').onclick=function(){\n      var miss=st.grid.filter(function(i){return !ranks[i];});\n      if(miss.length){miss.forEach(function(i){app.querySelector('.cell[data-i=\"'+i+'\"]').classList.add('miss');});return err('Please give every picture a rank ('+miss.length+' missing).');}\n      var b=this;b.disabled=true;\n      Promise.all(st.grid.map(function(i){var f=byId(i);return SPSite.answer('preference_rank',ranks[i],{key:i,shown:st.grid.map(function(x){var g=byId(x);return g?g.name:x;})});})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}st.step='rate';st.r=0;save();route();});\n    };\n  }\n  function rate(){\n    if(st.r>=st.order.length)return finish();\n    var i=st.order[st.r],f=byId(i);if(!f){st.r++;save();return rate();}\n    var vals={};\n    app.innerHTML='<h2>Picture '+(st.r+1)+' of '+st.order.length+'</h2><p>Imagine yourself in this scene. 1 = fully disagree, 7 = fully agree.</p><div class=\"view\"><img alt=\"Park picture\" src=\"'+esc(f.url)+'\"></div><div class=\"card\">'+\n      PRS.map(function(k){var q=Q[k],b='';for(var v=1;v<=7;v++)b+='<button type=\"button\" data-v=\"'+v+'\" aria-label=\"'+v+'\">'+v+'</button>';return '<div class=\"item\" data-k=\"'+k+'\"><div class=\"t\">'+esc(q.title)+'</div><div class=\"scale\">'+b+'</div><div class=\"anch\"><span>Fully disagree</span><span>Fully agree</span></div></div>';}).join('')+\n      '<div style=\"margin-top:12px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    window.scrollTo(0,0);\n    app.querySelectorAll('.item').forEach(function(it){it.querySelectorAll('button').forEach(function(b){b.onclick=function(){vals[it.dataset.k]=Number(b.dataset.v);it.classList.remove('miss');it.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b);});};});});\n    document.getElementById('go').onclick=function(){\n      var miss=PRS.filter(function(k){return !vals[k];});\n      if(miss.length){miss.forEach(function(k){app.querySelector('.item[data-k=\"'+k+'\"]').classList.add('miss');});return err('Please answer every statement ('+miss.length+' missing, marked).');}\n      var b=this;b.disabled=true;\n      Promise.all(PRS.map(function(k){return SPSite.answer(k,vals[k],{key:i,shown:[f.name]});})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}st.r++;save();rate();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){var m=r.missing||[];if(m.indexOf('preference_rank')>=0)st.step='ready';else if(m.some(function(x){return PRS.indexOf(x)>=0;})){st.step='rate';st.r=0;}else st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){clearTimeout(tm);if(st.step==='ready')return ready();if(st.step==='view')return view();if(st.step==='rank')return rank();if(st.step==='rate')return rate();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','education','major','scene_set','preference_rank'].concat(PRS).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    files=(SPSite.getMedia('ugs')||[]).filter(function(f){return /\\.(jpe?g|png|webp)$/i.test(f.name);});\n    if(!files.length){app.innerHTML='<h1>Pictures missing</h1><p>Upload the pictures to the media folder \"ugs\" (names a1–a4 … e1–e4: set letter + version number).</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!st||!st.grid||!st.grid.length||st.grid.some(function(i){return !byId(i);}))st=newState();\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true)st.step='intro';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
