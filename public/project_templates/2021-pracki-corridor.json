\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#eef1f4;--card:#fff;--ink:#1f2328;--muted:#5d646c;--accent:#5b4a2f;--accent-ink:#fff;--line:#d6dbe0;--warn:#b3261e;--miss:#fdecea}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1000px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q>b{display:block;margin-bottom:4px}\n.q.miss{background:var(--miss);border-radius:10px;padding:6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.pic img{width:100%;max-height:min(55vh,560px);object-fit:contain;display:block;border-radius:10px;background:#222}\n.pl{margin-top:14px;border:1px solid var(--line);border-radius:12px;padding:8px 10px}.pl>b{display:block;background:#efece4;border-radius:8px;padding:6px 10px;text-align:center}\n.it{padding:10px 6px;border-top:1px solid var(--line);border-radius:8px;margin-top:8px}\n.it .x{font-weight:500;margin-bottom:6px}\n.sc{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px}\n.sc label{display:flex;flex-direction:column;align-items:center;text-align:center;font-size:.85rem;color:var(--muted);cursor:pointer;padding:4px 2px;min-width:0;border:1px solid var(--line);border-radius:8px}\n.sc input{width:20px;height:20px;margin:0 0 4px}\n@media(max-width:700px){.sc{grid-template-columns:1fr}.sc label{flex-direction:row;gap:10px;text-align:left;padding:8px 10px}.sc input{margin:0}}\n.it.miss{background:var(--miss)}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:1000px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Visualisations: Pracki &amp; Krupiński (2021), Energies 14:412, Figures 4–13, doi:10.3390/en14020412 (CC BY 4.0). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='prackicor2021:';\n  var app=document.getElementById('app'), Q={}, files={}, ans={}, GR=[], ITEMS=[], done={};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function q(n){return Q[n]||{};}\n  function page(html,btn,cb){app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn)+'</button></div><div class=\"err\"></div>';document.getElementById('go').onclick=cb;app.onchange=hideErr;}\n  function send(list,b,fin){b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}fin();});}\n  function next(){\n    window.scrollTo(0,0);\n    if(!ans.intro)return intro();\n    if(!ans.about)return about();\n    for(var i=0;i<GR.length;i++)if(!done[GR[i].id])return group(GR[i],i);\n    finish();\n  }\n  function intro(){\n    var miss=GR.some(function(g){return !files[g.image];});\n    if(miss){app.innerHTML='<h1>Pictures missing</h1><p>Media folder corridor must hold the ten visualisations (corridor_variant_01.jpg … corridor_variant_10.jpg).</p>';return;}\n    page('<h1>Corridor lighting</h1><p>You will see ten computer visualisations of the same empty corridor, each lit in a different way. For each one, assess how bright and how uniform the lighting of the ceiling, the walls, the floor and the entire corridor looks.</p><p>Please use a computer screen if you can, at normal brightness. It takes about 15 minutes. Your answers are anonymous and used only for research.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      send([SPSite.answer('consent',true)],this,function(){ans.intro=true;save('a',ans);next();});});\n  }\n  var DEMO=['gender','age_group','education','occupation','sight','wellbeing'];\n  function about(){\n    page('<h1>About you</h1><div class=\"card\">'+DEMO.map(function(n,k){var d=q(n);return '<div class=\"q\" data-n=\"'+n+'\"'+(k?'':' style=\"margin-top:0\"')+'><b>'+esc(d.title)+'</b>'+(d.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+'</div>','Continue',function(){\n      var v={},miss=[];DEMO.forEach(function(n){var x=app.querySelector('input[name=\"'+n+'\"]:checked');var r=app.querySelector('.q[data-n=\"'+n+'\"]');if(x){v[n]=Number(x.value);r.classList.remove('miss');}else{miss.push(r);r.classList.add('miss');}});\n      if(miss.length){err('Please answer every question (marked in red).');miss[0].scrollIntoView({block:'center'});return;}\n      send(DEMO.map(function(n){return SPSite.answer(n,v[n]);}),this,function(){ans.about=true;save('a',ans);next();});});\n  }\n  function group(g,i){\n    var f=files[g.image], planes=[];\n    ITEMS.forEach(function(it){var p=planes[planes.length-1];if(!p||p.name!==it.plane){p={name:it.plane,items:[]};planes.push(p);}p.items.push(it);});\n    var html=planes.map(function(p){return '<div class=\"pl\"><b>'+esc(p.name)+'</b>'+p.items.map(function(it){return '<div class=\"it\" data-k=\"'+it.key+'\"><div class=\"x\">'+(it.feature==='brightness'?'Brightness':'Uniformity')+'</div><div class=\"sc\" role=\"radiogroup\" aria-label=\"'+esc(p.name+' '+it.feature)+'\">'+it.levels.map(function(l,v){return '<label><input type=\"radio\" name=\"'+it.key+'\" value=\"'+(7-v)+'\">'+esc(l)+'</label>';}).join('')+'</div></div>';}).join('')+'</div>';}).join('');\n    page('<div class=\"top\"><span class=\"t\">Lighting variant '+(i+1)+' of '+GR.length+'</span><div class=\"bar\"><i style=\"width:'+(100*i/GR.length)+'%\"></i></div></div><div class=\"card\"><div class=\"pic\"><img alt=\"Computer visualisation of the lit corridor, variant '+(i+1)+'\" src=\"'+esc(f.url)+'\"></div>'+html+'</div>','Next',function(){\n      var v={},miss=[];\n      ITEMS.forEach(function(it){var x=app.querySelector('input[name=\"'+it.key+'\"]:checked');var r=app.querySelector('.it[data-k=\"'+it.key+'\"]');if(x){v[it.key]=Number(x.value);r.classList.remove('miss');}else{miss.push(r);r.classList.add('miss');}});\n      if(miss.length){err(miss.length+' question'+(miss.length>1?'s are':' is')+' not answered yet (marked in red).');miss[0].scrollIntoView({block:'center'});return;}\n      send([SPSite.answer('corridor_assessment',v,{key:g.id,shown:[f.name]})],this,function(){done[g.id]=true;next();});});\n    app.onchange=function(e){hideErr();var r=e.target.closest&&e.target.closest('.it');if(r)r.classList.remove('miss');};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>In the original study, two groups of ten lighting students in Warsaw rated these ten variants, one group in a controlled box and one in an ordinary computer room. The two groups agreed closely: in 93.75% of cases they perceived the same changes in brightness and uniformity. Variant 1, with narrow downlights, had the brightest but least uniform floor; continuous light lines gave a more uniform floor than broken ones.</p><p style=\"font-size:.82rem\">Visualisations and method: Pracki, P., &amp; Krupiński, R. (2021). Brightness and Uniformity Perception of Virtual Corridor with Artificial Lighting Systems. Energies 14:412, doi:10.3390/en14020412.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')ans.intro=false;else if(x==='corridor_assessment')done={};else ans.about=false;});save('a',ans);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    var SPEC;try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='corridor_assessment'){GR=e.trials;ITEMS=e.items;}});});\n    (SPSite.getMedia('corridor')||[]).forEach(function(f){files[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};ans=load('a')||{};\n    ((a.corridor_assessment&&a.corridor_assessment.trials)||[]).forEach(function(t){if(t.key)done[t.key]=true;});\n    ans.intro=a.consent===true;ans.about=a.gender!=null&&a.wellbeing!=null;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
