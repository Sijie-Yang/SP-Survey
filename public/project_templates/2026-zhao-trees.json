   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Urban Spaces and Activity</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Trees, Naturalness and Willingness to Be Active\",\n  \"description\": \"Participants see photographs of everyday urban streets and open spaces in random order and, for each, rate how natural the space looks (1–4, no midpoint) and how willing they would be to do physical activity such as walking or group exercise there (0–10). Rebuilt from Zhao et al. (2026), Frontiers in Public Health 14: 1881655, with the 12 stimulus photographs printed in the paper's Figure 1 (CC BY 4.0).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"scenes\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"min\": 16,\n      \"max\": 99\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Sex\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"images\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"naturalness\",\n      \"title\": \"How natural does this space look to you?\",\n      \"description\": \"1 = very unnatural, 2 = somewhat unnatural, 3 = somewhat natural, 4 = very natural (no neutral option). One answer per photo, keyed by photo id (low_/medium_/high_ = the paper's vegetation level).\",\n      \"rateMin\": 1,\n      \"rateMax\": 4,\n      \"minRateDescription\": \"Very unnatural\",\n      \"maxRateDescription\": \"Very natural\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"activity\",\n      \"title\": \"How willing would you be to do physical activity, such as walking or group exercise, in this space?\",\n      \"description\": \"11-point numerical rating scale, 0 = completely unwilling, 10 = very willing. Keyed by photo id.\",\n      \"rateMin\": 0,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Completely unwilling\",\n      \"maxRateDescription\": \"Very willing\",\n      \"isRequired\": true\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"natur-original\">{\"source\": \"Zhao et al. (2026) Front Public Health 14:1881655\", \"n\": 337, \"images\": 40, \"result\": \"Image-level naturalness correlated r = 0.949 with physical-activity willingness; visible tree proportion identified spaces perceived as natural (AUC = 0.90, exploratory cut-off 27.7% tree pixels); naturalness mediated the tree -> willingness association.\"}</script>\n<style>\n:root{--bg:#f3f6f1;--card:#fff;--ink:#1f2a22;--muted:#5f6d63;--accent:#3d7a33;--line:#d9e3ea;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.1rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.view{background:#000;border-radius:12px;overflow:hidden;aspect-ratio:3/2;display:flex;align-items:center;justify-content:center}\n.view img{width:100%;height:100%;object-fit:contain;display:block}\n.thumb{max-width:520px;margin:0 auto}\n.timer{height:4px;background:var(--line);border-radius:2px;overflow:hidden;margin-top:8px}.timer>i{display:block;height:100%;background:var(--accent);width:0}\n.big{font-size:2.4rem;font-weight:700;text-align:center;margin:18px 0;color:var(--ink)}\n.item{padding:12px 0;border-top:1px solid var(--line)}.item:first-child{border-top:0}\n.item .t{margin-bottom:8px}\n.scale{display:grid;gap:6px}\n.scale button{appearance:none;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:8px;padding:9px 0;font:inherit;font-weight:600;cursor:pointer}\n.scale button.on{background:var(--accent);border-color:var(--accent);color:#fff}\n.item.miss .t{color:var(--warn)}\n.anch{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin:4px 0 6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\ntextarea{width:100%;min-height:90px;font:inherit;padding:10px;border:1px solid var(--line);border-radius:10px}\n.mini{font-size:.85rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Zhao et al. (2026), Frontiers in Public Health 14: 1881655, Figure 1, CC BY 4.0.</footer>\n<script>\n(function(){\n  var LBL={naturalness:['Very unnatural','Somewhat unnatural','Somewhat natural','Very natural']}, KEY='trees-activity:state', ITEMS=[['naturalness',1,4],['activity',0,10]];\n  var app=document.getElementById('app'), Q={}, files=[], st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function id(n){return n.replace(/\\.[^.]+$/,'');}\n  function byId(i){for(var k=0;k<files.length;k++)if(id(files[k].name)===i)return files[k];return null;}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function radio(n){var q=Q[n];return '<div class=\"f\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function scale(k,lo,hi){var q=Q[k],b='';for(var v=lo;v<=hi;v++)b+='<button type=\"button\" data-v=\"'+v+'\" aria-label=\"'+v+'\">'+v+(LBL[k]?'<br><small style=\"font-weight:400\">'+LBL[k][v-lo]+'</small>':'')+'</button>';\n    return '<div class=\"item\" data-k=\"'+k+'\"><div class=\"t\"><b>'+esc(q.title)+'</b></div><div class=\"scale\" style=\"grid-template-columns:repeat('+(hi-lo+1)+',1fr)\">'+b+'</div><div class=\"anch\"><span>'+lo+' = '+esc(q.minRateDescription)+'</span><span>'+hi+' = '+esc(q.maxRateDescription)+'</span></div></div>';}\n  function send(list,b,next){b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}next();});}\n  function intro(){\n    app.innerHTML='<h1>Everyday urban spaces</h1><p>You will see '+st.order.length+' photographs of streets and open spaces, one at a time, in random order. For each one, say how natural the space looks and how willing you would be to walk or exercise there. There are no right or wrong answers. About 5 minutes.</p>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div class=\"f\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"16\" max=\"99\"></div>'+radio('gender')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var age=Number(document.getElementById('age').value);if(!(age>=16&&age<=99))return err('Please enter your age.');\n      var g=app.querySelector('input[name=gender]:checked');if(!g)return err('Please answer: '+Q.gender.title);\n      send([SPSite.answer('consent',true),SPSite.answer('age',age),SPSite.answer('gender',g.value)],this,function(){st.step='rate';st.k=0;save();route();});\n    };\n  }\n  function rate(){\n    var c=st.order[st.k],f=byId(c),vals={};\n    app.innerHTML='<p>Photo '+(st.k+1)+' of '+st.order.length+'</p><div class=\"view thumb\"><img alt=\"Urban street or open space\" src=\"'+esc(f.url)+'\"></div><div class=\"card\">'+ITEMS.map(function(x){return scale(x[0],x[1],x[2]);}).join('')+\n      '<div style=\"margin-top:12px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    window.scrollTo(0,0);\n    app.querySelectorAll('.item').forEach(function(it){it.querySelectorAll('button').forEach(function(b){b.onclick=function(){vals[it.dataset.k]=Number(b.dataset.v);it.classList.remove('miss');it.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b);});};});});\n    document.getElementById('go').onclick=function(){\n      var m=ITEMS.filter(function(x){return vals[x[0]]==null;});\n      if(m.length){m.forEach(function(x){app.querySelector('.item[data-k=\"'+x[0]+'\"]').classList.add('miss');});return err('Please answer both questions.');}\n      send(ITEMS.map(function(x){return SPSite.answer(x[0],vals[x[0]],{key:c,shown:[f.name]});}),this,function(){st.k++;if(st.k>=st.order.length)st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';st.k=0;save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;if(s==='rate')return rate();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','naturalness','activity'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    files=(SPSite.getMedia('scenes')||[]).filter(function(f){return /\\.(jpe?g|png|webp)$/i.test(f.name);});\n    if(!files.length){app.innerHTML='<h1>Photos missing</h1><p>Upload the photographs to the media folder \"scenes\".</p>';return;}\n    var ids=files.map(function(f){return id(f.name);});\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!st||!st.order||st.order.some(function(i){return ids.indexOf(i)<0;}))st={step:'intro',order:shuffle(ids),k:0};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
