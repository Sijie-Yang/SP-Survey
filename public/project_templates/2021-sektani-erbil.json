isplay:block;border-radius:6px;cursor:zoom-in}\n.sd{display:grid;grid-template-columns:repeat(5,1fr);gap:2px;padding:8px 6px;border-top:1px solid var(--line);border-radius:8px}\n.sd .w{grid-column:1/-1;display:flex;justify-content:space-between;font-size:.92rem;font-weight:500}\n.sd label{display:flex;flex-direction:column;align-items:center;font-size:.75rem;color:var(--muted);cursor:pointer;padding:2px 0}\n.sd input{width:20px;height:20px;margin:0 0 2px}\n.sd.miss{background:var(--miss)}\n.legend{font-size:.82rem;color:var(--muted)}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.zoom{position:fixed;inset:0;background:rgba(0,0,0,.85);display:none;align-items:center;justify-content:center;z-index:9;cursor:zoom-out}\n.zoom img{max-width:96vw;max-height:92vh}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (min-width:900px){.wrap{grid-template-columns:1fr 1fr}.photos{position:sticky;top:12px;align-self:start}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<div class=\"zoom\" id=\"zoom\"><img alt=\"Enlarged building photograph\"></div>\n<footer class=\"credit\">Photographs: Sektani, Khayat, Mohammadi &amp; Roders (2021), Sustainability 13:3763, Table 3 and Appendix B, doi:10.3390/su13073763 (CC BY 4.0; buildings in the buffer zone of Erbil Citadel, Iraq). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='erbil2021:';\n  var app=document.getElementById('app'), Q={}, files={}, ans={}, TR=[], ITEMS=[], done={};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function q(n){return Q[n]||{};}\n  function page(html,btn,cb){app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn)+'</button></div><div class=\"err\"></div>';document.getElementById('go').onclick=cb;app.onchange=hideErr;}\n  function send(list,b,fin){b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}fin();});}\n  function next(){\n    window.scrollTo(0,0);\n    if(!ans.intro)return intro();\n    if(!ans.about)return about();\n    for(var i=0;i<TR.length;i++)if(!done[TR[i].id])return section(TR[i],i);\n    finish();\n  }\n  function intro(){\n    var miss=TR.some(function(t){return t.images.some(function(n){return !files[n];});});\n    if(miss){app.innerHTML='<h1>Pictures missing</h1><p>Media folder erbil must hold A1.jpg … A6.jpg and B1.jpg … B6.jpg (12 files).</p>';return;}\n    page('<h1>Buildings in Erbil</h1><p>The questions are about buildings and how you see them. Please remember that there is no wrong or right answer and we only ask for your opinion.</p><p>You will see two groups of six buildings from the area around Erbil Citadel. For each group, choose one of five circles for each pair of words. It takes about 8 minutes. Your answers are anonymous and used only for research.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      send([SPSite.answer('consent',true)],this,function(){ans.intro=true;save('a',ans);next();});});\n  }\n  function radios(n){var d=q(n);return '<div class=\"q\"><b>'+esc(d.title)+'</b>'+(d.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function about(){\n    page('<h1>Personal information</h1><div class=\"card\">'+radios('gender')+'<div class=\"q\"><b>'+esc(q('age').title)+'</b><input type=\"number\" id=\"age\" min=\"18\" max=\"99\" inputmode=\"numeric\"></div>'+radios('academic_attainment')+'</div>','Continue',function(){\n      var g=app.querySelector('input[name=gender]:checked');if(!g)return err('Please answer: Gender');\n      var a=Number(document.getElementById('age').value);if(!(a>=18&&a<=99&&Math.round(a)===a))return err('Please enter your age in whole years (18–99).');\n      var e=app.querySelector('input[name=academic_attainment]:checked');if(!e)return err('Please answer: Academic attainment');\n      send([SPSite.answer('gender',Number(g.value)),SPSite.answer('age',a),SPSite.answer('academic_attainment',Number(e.value))],this,function(){ans.about=true;save('a',ans);next();});});\n  }\n  function section(t,i){\n    var pics=t.images.map(function(n){var f=files[n];return '<img alt=\"Building photograph '+esc(n.replace('.jpg',''))+'\" src=\"'+esc(f.url)+'\">';}).join('');\n    var rows=ITEMS.map(function(it){return '<div class=\"sd\" data-k=\"'+it.key+'\" role=\"radiogroup\" aria-label=\"'+esc(it.left+' – '+it.right)+'\"><div class=\"w\"><span>'+esc(it.left)+'</span><span>'+esc(it.right)+'</span></div>'+[2,1,0,-1,-2].map(function(v){return '<label><input type=\"radio\" name=\"'+it.key+'\" value=\"'+v+'\">'+(v>0?'+'+v:v)+'</label>';}).join('')+'</div>';}).join('');\n    page('<div class=\"top\"><span class=\"t\">Section '+t.id+' ('+(i+1)+' of '+TR.length+')</span></div><h1>Please give your opinion on these buildings in Erbil</h1><p class=\"legend\">For each pair of words, choose one circle: +2 = very much the left word, +1 = somewhat the left word, 0 = neither, −1 = somewhat the right word, −2 = very much the right word. Tap a photograph to enlarge it.</p><div class=\"wrap\"><div class=\"photos\">'+pics+'</div><div class=\"card\" style=\"margin-top:0\">'+rows+'</div></div>',i===TR.length-1?'Finish':'Next section',function(){\n      var v={},miss=[];\n      ITEMS.forEach(function(it){var x=app.querySelector('input[name=\"'+it.key+'\"]:checked');var r=app.querySelector('.sd[data-k=\"'+it.key+'\"]');if(x){v[it.key]=Number(x.value);r.classList.remove('miss');}else{miss.push(r);r.classList.add('miss');}});\n      if(miss.length){err(miss.length+' word pair'+(miss.length>1?'s are':' is')+' not answered yet (marked in red).');miss[0].scrollIntoView({block:'center'});return;}\n      send([SPSite.answer('semantic_differential',v,{key:t.id,shown:t.images.map(function(n){return files[n].name;})})],this,function(){done[t.id]=true;next();});});\n    app.onchange=function(e){hideErr();var r=e.target.closest&&e.target.closest('.sd');if(r)r.classList.remove('miss');};\n    Array.prototype.forEach.call(app.querySelectorAll('.photos img'),function(im){im.onclick=function(){var z=document.getElementById('zoom');z.querySelector('img').src=im.src;z.style.display='flex';};});\n  }\n  document.getElementById('zoom').onclick=function(){this.style.display='none';};\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>In the original study, 414 people in Erbil filled in this questionnaire in 2020, about half of them architects. Architects rated the heritage buildings higher on heritage values such as identity, pride and attachment, while non-architects linked them more with dirt, disruption and lack of safety. For the contrasting modern buildings the picture reversed: architects disliked them and called them fake, while non-architects liked them and found them useful and harmonious.</p><p style=\"font-size:.82rem\">Photographs and method: Sektani, H.H.J., Khayat, M., Mohammadi, M., &amp; Roders, A.P. (2021). Erbil City Built Heritage and Wellbeing: An Assessment of Local Perceptions Using the Semantic Differential Scale. Sustainability 13:3763, doi:10.3390/su13073763.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')ans.intro=false;else if(x==='semantic_differential')done={};else ans.about=false;});save('a',ans);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    var SPEC;try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='semantic_differential'){TR=e.trials;ITEMS=e.items;}});});\n    (SPSite.getMedia('erbil')||[]).forEach(function(f){files[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};ans=load('a')||{};\n    ((a.semantic_differential&&a.semantic_differential.trials)||[]).forEach(function(t){if(t.key)done[t.key]=true;});\n    ans.intro=a.consent===true;ans.about=a.academic_attainment!=null;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
