   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Mountain Lakes Survey</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Mountain Lakes: Visual Preferences\",\n  \"description\": \"Faithful replication of the photo-based online questionnaire in Schirpke, Scolozzi & Tappeiner (2021), Water 13:1151: describe a mountain lake in a few words, then choose the preferred image in six picture sets of Alpine lakes (water clarity, water colour, algae, two lake-shore sets, surrounding land cover).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"lakes\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"intro\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"I take part voluntarily and know I can stop at any time.\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"lake_characteristics\",\n      \"title\": \"During an excursion you pass by a natural mountain lake. What best defines the characteristics of this lake? Please briefly describe these in a few words.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"pictures\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"picture_sets\",\n      \"title\": \"Which image do you prefer?\",\n      \"isRequired\": true,\n      \"description\": \"One trial per picture set (key set1 … set6, in the paper's order), images in random order within each set. Value: the chosen image id, e.g. 'set2_a', with letters as in the paper's Figure 3 (set1 water clarity a–b, set2 water colour a–d, set3 algae a–c, set4 lake shore at lower altitudes a–d, set5 lake shore at higher altitudes a–d, set6 surrounding land cover a–d).\",\n      \"items\": [\n       {\n        \"id\": \"set1\",\n        \"text\": \"Water clarity\",\n        \"options\": [\n         \"set1_a\",\n         \"set1_b\"\n        ]\n       },\n       {\n        \"id\": \"set2\",\n        \"text\": \"Water colour\",\n        \"options\": [\n         \"set2_a\",\n         \"set2_b\",\n         \"set2_c\",\n         \"set2_d\"\n        ]\n       },\n       {\n        \"id\": \"set3\",\n        \"text\": \"Presence of algae\",\n        \"options\": [\n         \"set3_a\",\n         \"set3_b\",\n         \"set3_c\"\n        ]\n       },\n       {\n        \"id\": \"set4\",\n        \"text\": \"Lake shore\",\n        \"options\": [\n         \"set4_a\",\n         \"set4_b\",\n         \"set4_c\",\n         \"set4_d\"\n        ]\n       },\n       {\n        \"id\": \"set5\",\n        \"text\": \"Lake shore\",\n        \"options\": [\n         \"set5_a\",\n         \"set5_b\",\n         \"set5_c\",\n         \"set5_d\"\n        ]\n       },\n       {\n        \"id\": \"set6\",\n        \"text\": \"Surrounding land cover\",\n        \"options\": [\n         \"set6_a\",\n         \"set6_b\",\n         \"set6_c\",\n         \"set6_d\"\n        ]\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": false,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"age\",\n      \"inputType\": \"number\",\n      \"title\": \"Age (years)\",\n      \"isRequired\": false\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"cultural_background\",\n      \"title\": \"Which is your first language?\",\n      \"isRequired\": false,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"German\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Italian\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"English\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Other\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"relation_to_alps\",\n      \"title\": \"What is your relation to the Alps?\",\n      \"isRequired\": false,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"I live in and grew up in the Alps\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"I visit the Alps primarily as a tourist\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Other\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"nature_connectedness\",\n      \"title\": \"How often do you spend time in nature?\",\n      \"isRequired\": false,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"At least several times a week\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Several times a month\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Less than several times a month\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"lake_visits\",\n      \"inputType\": \"number\",\n      \"title\": \"About how many times a year do you visit lakes?\",\n      \"isRequired\": false\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#eef3f4;--card:#fff;--ink:#17222a;--muted:#55636d;--accent:#1f5f7a;--accent-ink:#fff;--line:#d3dde1;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q>b{display:block;margin-bottom:4px}.opt-note{font-weight:400;color:var(--muted);font-size:.85rem}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\ntextarea,input[type=text]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:100%;background:#fff;color:var(--ink)}\ntextarea{min-height:80px}input[type=text]{max-width:200px}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem;font-variant-numeric:tabular-nums}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}\n.tile{position:relative;border:4px solid transparent;border-radius:12px;padding:0;background:none;cursor:pointer;overflow:hidden;display:block}\n.tile img{width:100%;aspect-ratio:62/33;object-fit:cover;display:block}\n.tile .no{position:absolute;left:6px;top:6px;background:#fff;color:#000;font-weight:700;font-size:.85rem;padding:0 7px;border-radius:5px}\n.tile.sel{border-color:var(--accent)}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:560px){.grid{grid-template-columns:1fr}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Schirpke, Scolozzi &amp; Tappeiner (2021), Water 13:1151, doi:10.3390/w13091151, Figure 3 (CC BY 4.0), cropped to remove the result labels. Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='mountainlakes2021:';\n  var app=document.getElementById('app'), Q={}, files={}, ans={}, done={}, SETS=[], orders={}, SPEC=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function q(n){return Q[n]||{};}\n  function saveAll(l,b,cb){Promise.all(l.map(function(a){return SPSite.answer(a[0],a[1]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}cb();});}\n  function page(html,btn,cb){\n    app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn||'Continue')+'</button></div><div class=\"err\"></div>';\n    document.getElementById('go').onclick=cb;app.onchange=hideErr;\n  }\n  function next(){\n    window.scrollTo(0,0);\n    if(!ans.intro)return intro();\n    for(var i=0;i<SETS.length;i++){if(!done[SETS[i].id])return set(i);}\n    if(!ans.about)return about();\n    finish();\n  }\n  function intro(){\n    var miss=SETS.some(function(s){return s.options.some(function(o){return !files[o+'.jpg'];});});\n    if(miss){app.innerHTML='<h1>Pictures missing</h1><p>Media folder lakes must hold set1_a.jpg … set6_d.jpg.</p>';return;}\n    page('<h1>Mountain lakes</h1><p>This survey is about what people like in mountain lakes. In this survey, mountain lakes are smaller-sized natural lakes, which are located at least 1000 meters above sea level. It takes about 5 minutes. Participation is anonymous and voluntary, you can stop at any time, and your answers are treated confidentially.</p>'+\n      '<div class=\"card\"><div class=\"q\" style=\"margin-top:0\"><b>'+esc(q('lake_characteristics').title)+'</b><textarea name=\"lake_characteristics\"></textarea></div>'+\n      '<label class=\"opt\" style=\"margin-top:14px\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      var t=app.querySelector('textarea').value.trim();if(!t)return err('Please describe the lake in a few words.');\n      if(!document.getElementById('ok').checked)return err('Please confirm that you take part voluntarily.');\n      var b=this;b.disabled=true;saveAll([['consent',true],['lake_characteristics',t]],b,function(){ans.intro=true;save('a',ans);next();});\n    });\n  }\n  function set(i){\n    var s=SETS[i], ord=orders[s.id], pick=null, n=0;SETS.forEach(function(x){if(done[x.id])n++;});\n    page('<div class=\"top\"><span class=\"t\">Picture set '+(n+1)+' of '+SETS.length+'</span><div class=\"bar\"><i style=\"width:'+(100*n/SETS.length)+'%\"></i></div></div>'+\n      '<div class=\"card\"><h1>'+esc(q('picture_sets').title)+'</h1><p>Tap the image you prefer.</p><div class=\"grid\">'+ord.map(function(o,j){return '<button type=\"button\" class=\"tile\" data-o=\"'+o+'\" aria-label=\"Image '+(j+1)+'\"><img alt=\"Mountain lake image '+(j+1)+'\" src=\"'+esc(files[o+'.jpg'].url)+'\"><span class=\"no\">'+(j+1)+'</span></button>';}).join('')+'</div></div>','Next',function(){\n      if(!pick)return err('Please tap the image you prefer.');\n      var b=this;b.disabled=true;\n      SPSite.answer('picture_sets',pick,{key:s.id,shown:ord.map(function(o){return o+'.jpg';})}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}done[s.id]=true;next();});\n    });\n    [].forEach.call(app.querySelectorAll('.tile'),function(t){t.onclick=function(){pick=t.dataset.o;hideErr();[].forEach.call(app.querySelectorAll('.tile'),function(x){x.classList.toggle('sel',x===t);});};});\n  }\n  function about(){\n    var ns=['gender','age','cultural_background','relation_to_alps','nature_connectedness','lake_visits'];\n    var h=ns.map(function(n){var d=q(n);var head='<b>'+esc(d.title)+' <span class=\"opt-note\">(optional)</span></b>';\n      if(d.type!=='radiogroup')return '<div class=\"q\">'+head+'<input type=\"text\" inputmode=\"numeric\" name=\"'+n+'\"></div>';\n      return '<div class=\"q\">'+head+(d.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('');\n    page('<h1>About you</h1><p>These questions are optional.</p><div class=\"card\">'+h+'</div>','Finish',function(){\n      var l=[];for(var i=0;i<ns.length;i++){var n=ns[i];\n        if(q(n).type==='radiogroup'){var x=app.querySelector('input[name=\"'+n+'\"]:checked');if(x)l.push([n,Number(x.value)]);}\n        else{var v=app.querySelector('input[name=\"'+n+'\"]').value.trim();if(v){var num=Number(v);if(isNaN(num)||num<0||num>(n==='age'?110:1000))return err('Please enter a number: '+q(n).title);l.push([n,num]);}}}\n      var b=this;b.disabled=true;saveAll(l,b,function(){ans.about=true;save('a',ans);next();});\n    });\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>The six picture sets varied water clarity, water colour, algae, the lake shore and the land cover around Alpine lakes. In the original study with 526 people, most preferred clear, blue water without algae, large rocks at the shore and forest around the lake, and preferences for the water were very similar across groups.</p><p style=\"font-size:.82rem\">Photographs and questions: Schirpke, U., Scolozzi, R., &amp; Tappeiner, U. (2021). “A gem among the rocks”—Identifying and measuring visual preferences for mountain lakes. Water 13:1151, doi:10.3390/w13091151.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='picture_sets')done={};else if(x==='consent'||x==='lake_characteristics')ans.intro=false;else ans.about=false;});save('a',ans);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={type:e.type,title:g.title||e.title,isRequired:e.isRequired,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='picture_sets')SETS=e.items;});});\n    (SPSite.getMedia('lakes')||[]).forEach(function(f){files[f.name]=f;});\n    orders=load('orders')||{};SETS.forEach(function(s){if(!orders[s.id]||orders[s.id].length!==s.options.length)orders[s.id]=shuffle(s.options);});save('orders',orders);\n    var a=(ctx&&ctx.answers)||{};ans=load('a')||{};\n    ((a.picture_sets&&a.picture_sets.trials)||[]).forEach(function(t){if(t.key)done[t.key]=true;});\n    ans.intro=a.consent===true&&a.lake_characteristics!=null;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
