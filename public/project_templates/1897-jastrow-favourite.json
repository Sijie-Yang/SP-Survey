   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Favourite colour and colour pair (Jastrow 1897)</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\"format\":\"sp-scheme-package\",\"spScheme\":\"2.0\",\"survey\":{\"title\":\"Favourite colour and colour pair (Jastrow 1897)\",\"description\":\"Jastrow's 1893 World's Fair colour census: choose the most pleasing of 24 colours, then the most pleasing of 24 two-colour combinations, then give sex and age.\",\"locale\":\"en\",\"pages\":[\n{\"name\":\"intro\",\"elements\":[{\"type\":\"boolean\",\"name\":\"consent\",\"title\":\"I agree to take part. My answers are recorded anonymously for research.\",\"isRequired\":true}]},\n{\"name\":\"single\",\"elements\":[{\"type\":\"radiogroup\",\"name\":\"favourite_colour\",\"title\":\"Which of these colours is most pleasing to you?\",\"isRequired\":true,\"description\":\"Value = the colour's number on Jastrow's 1893 placard (1–12 normal colours, 13–24 the lighter shades in the same order, 25 = no choice). Swatches are shown in the placard order; the order is stored with the answer (shown).\",\"choices\":[{\"value\":1,\"text\":\"1 Red\"},{\"value\":2,\"text\":\"2 Red-orange\"},{\"value\":3,\"text\":\"3 Orange\"},{\"value\":4,\"text\":\"4 Yellow-orange\"},{\"value\":5,\"text\":\"5 Yellow\"},{\"value\":6,\"text\":\"6 Yellow-green\"},{\"value\":7,\"text\":\"7 Green\"},{\"value\":8,\"text\":\"8 Blue-green\"},{\"value\":9,\"text\":\"9 Blue\"},{\"value\":10,\"text\":\"10 Blue-violet\"},{\"value\":11,\"text\":\"11 Violet\"},{\"value\":12,\"text\":\"12 Red-violet\"},{\"value\":13,\"text\":\"13 Lighter red\"},{\"value\":14,\"text\":\"14 Lighter red-orange\"},{\"value\":15,\"text\":\"15 Lighter orange\"},{\"value\":16,\"text\":\"16 Lighter yellow-orange\"},{\"value\":17,\"text\":\"17 Lighter yellow\"},{\"value\":18,\"text\":\"18 Lighter yellow-green\"},{\"value\":19,\"text\":\"19 Lighter green\"},{\"value\":20,\"text\":\"20 Lighter blue-green\"},{\"value\":21,\"text\":\"21 Lighter blue\"},{\"value\":22,\"text\":\"22 Lighter blue-violet\"},{\"value\":23,\"text\":\"23 Lighter violet\"},{\"value\":24,\"text\":\"24 Lighter red-violet\"},{\"value\":25,\"text\":\"25 No choice\"}]}]},\n{\"name\":\"pair\",\"elements\":[{\"type\":\"radiogroup\",\"name\":\"favourite_pair\",\"title\":\"Which of these combinations of two colours is most pleasing to you?\",\"isRequired\":true,\"description\":\"Value = the combination's letter on Jastrow's placard (A–X, Y = no choice).\",\"choices\":[{\"value\":\"A\",\"text\":\"A Green / Red\"},{\"value\":\"B\",\"text\":\"B Blue / Orange\"},{\"value\":\"C\",\"text\":\"C Violet / Yellow\"},{\"value\":\"D\",\"text\":\"D Lighter green / Lighter red\"},{\"value\":\"E\",\"text\":\"E Lighter blue / Lighter orange\"},{\"value\":\"F\",\"text\":\"F Lighter violet / Lighter yellow\"},{\"value\":\"G\",\"text\":\"G Lighter green / Red\"},{\"value\":\"H\",\"text\":\"H Lighter blue / Orange\"},{\"value\":\"I\",\"text\":\"I Lighter violet / Yellow\"},{\"value\":\"J\",\"text\":\"J Blue / Red\"},{\"value\":\"K\",\"text\":\"K Violet / Orange\"},{\"value\":\"L\",\"text\":\"L Green / Yellow\"},{\"value\":\"M\",\"text\":\"M Lighter blue / Lighter red\"},{\"value\":\"N\",\"text\":\"N Lighter violet / Lighter orange\"},{\"value\":\"O\",\"text\":\"O Lighter green / Lighter yellow\"},{\"value\":\"P\",\"text\":\"P Orange / Red\"},{\"value\":\"Q\",\"text\":\"Q Yellow / Orange\"},{\"value\":\"R\",\"text\":\"R Violet / Blue\"},{\"value\":\"S\",\"text\":\"S Red / Violet\"},{\"value\":\"T\",\"text\":\"T Yellow / Red\"},{\"value\":\"U\",\"text\":\"U Green / Orange\"},{\"value\":\"V\",\"text\":\"V Blue / Yellow\"},{\"value\":\"W\",\"text\":\"W Violet / Green\"},{\"value\":\"X\",\"text\":\"X Green / Blue\"},{\"value\":\"Y\",\"text\":\"Y No choice\"}]}]},\n{\"name\":\"about\",\"elements\":[\n{\"type\":\"radiogroup\",\"name\":\"sex\",\"title\":\"Your sex\",\"isRequired\":true,\"description\":\"Jastrow recorded sex by card shape (men square cards, women oblong cards).\",\"choices\":[{\"value\":\"male\",\"text\":\"Male\"},{\"value\":\"female\",\"text\":\"Female\"},{\"value\":\"other\",\"text\":\"Other / prefer not to say\"}]},\n{\"type\":\"text\",\"name\":\"age\",\"title\":\"Your age in years\",\"isRequired\":true,\"inputType\":\"number\",\"min\":6,\"max\":110}]}]}}\n</script>\n<style>\n:root{--bg:#f6f2e9;--card:#fff;--ink:#1f1d1a;--muted:#5f5a52;--accent:#6b3f8f;--accent-ink:#fff;--line:#ddd6c8;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:980px;margin:0 auto;padding:20px 16px 40px}h1{font-size:1.3rem;margin:0 0 8px}p{margin:0 0 10px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}.btn:disabled{opacity:.4;cursor:not-allowed}\n.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}\n.grid{display:grid;grid-template-columns:repeat(13,1fr);gap:6px;background:#ece7dc;border-radius:12px;padding:10px}\n.sw{position:relative;border:3px solid transparent;border-radius:8px;background:#fff;cursor:pointer;padding:4px 4px 2px;display:flex;flex-direction:column;align-items:stretch;gap:3px;font:inherit}\n.sw:hover,.sw:focus-visible{border-color:#888}.sw.on{border-color:#1f1d1a;box-shadow:0 0 0 2px #f2b33d}\n.chip{display:block;aspect-ratio:2/3;border:1px solid rgba(0,0,0,.25);border-radius:3px}\n.pair{display:flex;flex-direction:column;aspect-ratio:2/3;border:1px solid rgba(0,0,0,.25);border-radius:3px;overflow:hidden}.pair i{flex:1}\n.nc{display:flex;align-items:center;justify-content:center;aspect-ratio:2/3;border:1px dashed #999;border-radius:3px;font-size:.62rem;color:#555;text-align:center;line-height:1.1}\n.lab{font-size:.72rem;color:#333;text-align:center;font-weight:600}\n.name{margin-top:10px;font-size:.95rem;color:var(--ink);min-height:1.4em}\nlabel.o{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\ninput.num{font:inherit;padding:8px 12px;border:1px solid var(--line);border-radius:10px;width:140px}\n.q{margin-top:14px}.q>b{display:block;margin-bottom:4px}.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:980px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:760px){.grid{grid-template-columns:repeat(5,1fr)}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Method: Jastrow, J. (1897). The popular esthetics of color. <i>Popular Science Monthly</i>, 50, 361–368 (placard on p. 363). Public domain. The original used coloured papers from the Prang Educational Company; the colours here are screen approximations.</footer>\n<script>\n(function(){\n  /* hue (deg) of the 12 placard colours; 1-12 normal shade, 13-24 lighter shade of the same hue */\n  var NAMES=['Red','Red-orange','Orange','Yellow-orange','Yellow','Yellow-green','Green','Blue-green','Blue','Blue-violet','Violet','Red-violet'];\n  var HUE=[0,16,30,42,54,82,125,175,220,250,275,320];\n  function col(n){var k=(n-1)%12,light=n>12;var h=HUE[k];var s=light?60:72,l=light?74:(k===4?52:k===10||k===9?34:44);return 'hsl('+h+','+s+'%,'+l+'%)';}\n  function cname(n){return n===25?'No choice':(n>12?'Lighter '+NAMES[(n-1)%12].toLowerCase():NAMES[n-1]);}\n  var BASE={red:1,orange:3,yellow:5,green:7,blue:9,violet:11};\n  var PAIRS=[['A','green','red'],['B','blue','orange'],['C','violet','yellow'],['D','lighter green','lighter red'],['E','lighter blue','lighter orange'],['F','lighter violet','lighter yellow'],['G','lighter green','red'],['H','lighter blue','orange'],['I','lighter violet','yellow'],['J','blue','red'],['K','violet','orange'],['L','green','yellow'],['M','lighter blue','lighter red'],['N','lighter violet','lighter orange'],['O','lighter green','lighter yellow'],['P','orange','red'],['Q','yellow','orange'],['R','violet','blue'],['S','red','violet'],['T','yellow','red'],['U','green','orange'],['V','blue','yellow'],['W','violet','green'],['X','green','blue']];\n  function num(name){var l=name.indexOf('lighter ')===0;var b=BASE[l?name.slice(8):name];return l?b+12:b;}\n  function cap(s){return s.charAt(0).toUpperCase()+s.slice(1);}\n  var app=document.getElementById('app'),A={},pick={};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function has(n){return A[n]!=null&&A[n]!=='';}\n  function next(){window.scrollTo(0,0);\n    if(A.consent!==true)return intro();\n    if(!has('favourite_colour'))return single();\n    if(!has('favourite_pair'))return pairs();\n    if(!has('sex')||!has('age'))return about();\n    finish();}\n  function intro(){\n    app.innerHTML='<h1>Which colour pleases you most?</h1><p>In 1893, visitors to the psychology laboratory at the World\\'s Columbian Exposition in Chicago were asked to vote for their favourite colour and their favourite pair of colours. You will make the same two choices.</p><p>First pick the single colour that is most pleasing to you, then the combination of two colours that is most pleasing to you. If you have no preference, choose \"No choice\". It takes about 2 minutes.</p><div class=\"card\"><p>'+esc(SPSite.getQuestion('consent').title)+'</p><div class=\"row\"><button class=\"btn\" id=\"yes\">I agree</button></div><div class=\"err\"></div></div>';\n    document.getElementById('yes').onclick=function(){var b=this;b.disabled=true;SPSite.answer('consent',true).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}A.consent=true;next();});};}\n  function grid(name,items,title,hint){\n    var cur=pick[name];var h='<div class=\"card\"><h1>'+title+'</h1><p>'+hint+'</p><div class=\"grid\">';\n    items.forEach(function(it){h+='<button type=\"button\" class=\"sw'+(String(cur)===String(it.v)?' on':'')+'\" data-v=\"'+it.v+'\" aria-label=\"'+esc(it.label)+'\" title=\"'+esc(it.label)+'\">'+it.html+'<span class=\"lab\">'+esc(it.tag)+'</span></button>';});\n    var sel=items.filter(function(it){return String(it.v)===String(cur);})[0];\n    h+='</div><div class=\"name\">'+(sel?'Your choice: <b>'+esc(sel.label)+'</b>':'Nothing chosen yet.')+'</div><div class=\"row\"><button class=\"btn\" id=\"go\"'+(cur!=null?'':' disabled')+'>Continue</button></div><div class=\"err\"></div></div>';\n    app.innerHTML=h;\n    app.querySelectorAll('.sw').forEach(function(b){b.onclick=function(){var v=b.getAttribute('data-v');pick[name]=name==='favourite_colour'?Number(v):v;var y=window.scrollY;grid(name,items,title,hint);window.scrollTo(0,y);};});\n    document.getElementById('go').onclick=function(){if(pick[name]==null)return err('Please choose one.');var b=this;b.disabled=true;\n      SPSite.answer(name,pick[name],{shown:items.map(function(it){return String(it.v);})}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}A[name]=pick[name];next();});};}\n  function single(){var items=[];for(var n=1;n<=25;n++)items.push({v:n,tag:String(n),label:n+' '+cname(n),html:n===25?'<span class=\"nc\">No<br>choice</span>':'<span class=\"chip\" style=\"background:'+col(n)+'\"></span>'});\n    grid('favourite_colour',items,'Which colour is <b>most pleasing</b> to you?','Tap one colour (numbered as on the 1893 placard: 1–12, and their lighter shades 13–24), then press Continue.');}\n  function pairs(){var items=PAIRS.map(function(p){return {v:p[0],tag:p[0],label:p[0]+' '+cap(p[1])+' with '+p[2],html:'<span class=\"pair\"><i style=\"background:'+col(num(p[1]))+'\"></i><i style=\"background:'+col(num(p[2]))+'\"></i></span>'};});\n    items.push({v:'Y',tag:'Y',label:'Y No choice',html:'<span class=\"nc\">No<br>choice</span>'});\n    grid('favourite_pair',items,'Which <b>combination of two colours</b> is most pleasing to you?','Tap one combination (lettered A–X as on the placard), then press Continue.');}\n  function about(){var q=SPSite.getQuestion('sex'),h='<h1>About you</h1><div class=\"card\"><div class=\"q\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"o\"><input type=\"radio\" name=\"sex\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';\n    h+='<div class=\"q\"><b>'+esc(SPSite.getQuestion('age').title)+'</b><input class=\"num\" id=\"age\" type=\"number\" min=\"6\" max=\"110\" inputmode=\"numeric\"></div>';\n    app.innerHTML=h+'<div class=\"row\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var x=app.querySelector('input[name=\"sex\"]:checked');if(!x)return err('Please answer: '+q.title);var a=Number(document.getElementById('age').value);if(!a||a<6||a>110)return err('Please enter your age in years.');\n      var b=this;b.disabled=true;Promise.all([SPSite.answer('sex',x.value),SPSite.answer('age',a)]).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}A.sex=x.value;A.age=a;next();});};}\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>In Chicago in 1893, 4,556 visitors voted. Blue was the clear favourite (just over a quarter of all votes), well ahead of red; the orange shades were chosen least. Men chose blue most often, women red. The favourite pairs were red with violet and red with blue.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');return;}var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';});}\n  SPSite.onReady(function(ctx){A=(ctx&&ctx.answers)||{};next();});\n})();\n</script>\n</body>\n</html>\n",
