   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Rhododendron Forest SBE</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Rhododendron Forest Scenic Beauty (SBE)\",\n  \"description\": \"Faithful replication of Liu et al. (2025), Horticulturae 11:898: preview 16 drone photographs of flowering Rhododendron simsii forest, then rate each one, shown for 60 s in a fixed order, on a 7-point Scenic Beauty Estimation scale (very like 3 … very dislike -3).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"plots\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"intro\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"I understand the above and am willing to participate in this study.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"title\": \"About you\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Female\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age_group\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"<20 years\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"20–30 years\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"31–40 years\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \">40 years\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Education Level\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Junior high school\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Senior high school\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"College diploma\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Bachelor’s degree or above\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"park_familiarity\",\n      \"title\": \"Familiarity with DaWei Mountain National Forest Park\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Unfamiliar\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Have basic knowledge\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Familiar and have visited\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"professional_background\",\n      \"title\": \"Professional Background in Forestry/Landscape Architecture\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"No\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"sbe_familiarity\",\n      \"title\": \"Familiarity with Scenic Beauty Estimation (SBE)\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Unfamiliar\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Have heard of it\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Have some knowledge\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"ratings\",\n    \"title\": \"SBE ratings\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"sbe_rating\",\n      \"isRequired\": true,\n      \"title\": \"SBE Rating for this sample plot\",\n      \"description\": \"16 nadir drone photographs (100 m altitude) of Rhododendron simsii forest in DaWei Mountain National Forest Park, Hunan, China. All 16 are previewed first; then each is shown on its own in a fixed sequence (Sample Plot 1–16) for a fixed 60 s and rated on a 7-point scale. Value: {score: 3 very like … -3 very dislike}. Trial key = plot id. Analysis: SBE = per-rater z-standardised score averaged per photo. unit_inferred = landscape unit in the paper's Table 4 (BSH/BSL/JBI/JBII 1–4), inferred by matching the supplement's rating counts to Table 4 means.\",\n      \"items\": [\n       {\n        \"name\": \"score\",\n        \"choices\": [\n         {\n          \"value\": 3,\n          \"text\": \"Very like (3)\"\n         },\n         {\n          \"value\": 2,\n          \"text\": \"Like (2)\"\n         },\n         {\n          \"value\": 1,\n          \"text\": \"Slightly like (1)\"\n         },\n         {\n          \"value\": 0,\n          \"text\": \"Neutral (0)\"\n         },\n         {\n          \"value\": -1,\n          \"text\": \"Slightly dislike (-1)\"\n         },\n         {\n          \"value\": -2,\n          \"text\": \"Dislike (-2)\"\n         },\n         {\n          \"value\": -3,\n          \"text\": \"Very dislike (-3)\"\n         }\n        ]\n       }\n      ],\n      \"trials\": [\n       {\n        \"id\": \"plot_01\",\n        \"file\": \"plot_01.jpg\",\n        \"unit_inferred\": \"BSH1\"\n       },\n       {\n        \"id\": \"plot_02\",\n        \"file\": \"plot_02.jpg\",\n        \"unit_inferred\": \"BSH2\"\n       },\n       {\n        \"id\": \"plot_03\",\n        \"file\": \"plot_03.jpg\",\n        \"unit_inferred\": \"BSH3\"\n       },\n       {\n        \"id\": \"plot_04\",\n        \"file\": \"plot_04.jpg\",\n        \"unit_inferred\": \"BSH4\"\n       },\n       {\n        \"id\": \"plot_05\",\n        \"file\": \"plot_05.jpg\",\n        \"unit_inferred\": \"BSL1\"\n       },\n       {\n        \"id\": \"plot_06\",\n        \"file\": \"plot_06.jpg\",\n        \"unit_inferred\": \"BSL2\"\n       },\n       {\n        \"id\": \"plot_07\",\n        \"file\": \"plot_07.jpg\",\n        \"unit_inferred\": \"BSL3\"\n       },\n       {\n        \"id\": \"plot_08\",\n        \"file\": \"plot_08.jpg\",\n        \"unit_inferred\": \"BSL4\"\n       },\n       {\n        \"id\": \"plot_09\",\n        \"file\": \"plot_09.jpg\",\n        \"unit_inferred\": \"JBI1\"\n       },\n       {\n        \"id\": \"plot_10\",\n        \"file\": \"plot_10.jpg\",\n        \"unit_inferred\": \"JBI2\"\n       },\n       {\n        \"id\": \"plot_11\",\n        \"file\": \"plot_11.jpg\",\n        \"unit_inferred\": \"JBI3\"\n       },\n       {\n        \"id\": \"plot_12\",\n        \"file\": \"plot_12.jpg\",\n        \"unit_inferred\": \"JBI4\"\n       },\n       {\n        \"id\": \"plot_13\",\n        \"file\": \"plot_13.jpg\",\n        \"unit_inferred\": \"JBII1\"\n       },\n       {\n        \"id\": \"plot_14\",\n        \"file\": \"plot_14.jpg\",\n        \"unit_inferred\": \"JBII2\"\n       },\n       {\n        \"id\": \"plot_15\",\n        \"file\": \"plot_15.jpg\",\n        \"unit_inferred\": \"JBII3\"\n       },\n       {\n        \"id\": \"plot_16\",\n        \"file\": \"plot_16.jpg\",\n        \"unit_inferred\": \"JBII4\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#f1eef0;--card:#fff;--ink:#231e21;--muted:#62595e;--accent:#9c2f52;--line:#ddd3d8;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q:first-child{margin-top:0}.q>b{display:block;margin-bottom:6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\n.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}\n.grid figure{margin:0}.grid img{width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:6px;display:block}.grid figcaption{font-size:.72rem;color:var(--muted);text-align:center}\n.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem;font-variant-numeric:tabular-nums}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.pic{background:#e6e0e3;border-radius:12px;overflow:hidden}.pic img{width:100%;max-height:min(52vh,520px);object-fit:contain;display:block}\n.seg{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px}\n.seg label{display:block;cursor:pointer;position:relative}\n.seg input{position:absolute;opacity:0;pointer-events:none}\n.seg span{display:flex;align-items:center;justify-content:center;text-align:center;min-height:50px;padding:4px 2px;border:1px solid var(--line);border-radius:8px;font-size:.78rem;font-weight:600;line-height:1.2}\n.seg input:checked+span{background:var(--accent);border-color:var(--accent);color:#fff}\n.seg input:focus-visible+span{outline:2px solid var(--accent);outline-offset:2px}\n.timer{font-variant-numeric:tabular-nums;font-weight:600;color:var(--accent)}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:560px){.grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:4px}.seg{grid-template-columns:repeat(4,minmax(0,1fr))}.seg span{font-size:.74rem;min-height:44px}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Liu, Liao, Huang, Li, Wu, Yi, Wang &amp; Chen (2025), Horticulturae 11:898, Supplementary File S1, doi:10.3390/horticulturae11080898 (CC BY 4.0; DJI drone photographs of DaWei Mountain National Forest Park). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='rhodo2025:', SECS=(typeof window.SP_TEST_SECS==='number')?window.SP_TEST_SECS:60;\n  var app=document.getElementById('app'), Q={}, files={}, done={}, SPEC=null, TR=[], CH=[], ABOUT=['gender','age_group','education','park_familiarity','professional_background','sbe_familiarity'], tick=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function q(n){return Q[n]||{};}\n  function page(html,btn,cb){\n    if(tick){clearInterval(tick);tick=null;}\n    app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn||'Continue')+'</button></div><div class=\"err\"></div>';\n    document.getElementById('go').onclick=cb;app.onchange=hideErr;app.oninput=hideErr;\n  }\n  function saveAll(l,b,cb){Promise.all(l.map(function(a){return SPSite.answer(a[0],a[1]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}cb();});}\n  function next(){\n    window.scrollTo(0,0);\n    if(!done.intro)return intro();\n    if(!done.preview)return preview();\n    if(!done.about)return about();\n    for(var k=0;k<TR.length;k++)if(!done[TR[k].id])return rate(TR[k],k);\n    finish();\n  }\n  function intro(){\n    if(TR.some(function(t){return !files[t.file];})){app.innerHTML='<h1>Pictures missing</h1><p>Media folder plots must hold plot_01.jpg … plot_16.jpg.</p>';return;}\n    page('<h1>Informed consent</h1><div class=\"card\"><p style=\"color:var(--ink)\">Dear participants,</p><p>Thank you very much for participating in our survey, which is a questionnaire about landscape scoring and is only used for academic research. While answering, please focus on the questionnaire materials, carefully observe the content and experience your emotions, and make your judgments.</p><p>This participation is purely voluntary and you may stop at any time without any adverse consequences. No personal information such as your name is collected; the information is only used for academic research and is kept confidential.</p><label class=\"opt\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      var b=this;b.disabled=true;saveAll([['consent',true]],b,function(){done.intro=true;save('d',done);next();});\n    });\n  }\n  function preview(){\n    var g='<div class=\"grid\">'+TR.map(function(t,i){return '<figure><img alt=\"Sample plot '+(i+1)+'\" src=\"'+esc(files[t.file].url)+'\"><figcaption>'+(i+1)+'</figcaption></figure>';}).join('')+'</div>';\n    page('<h1>Scenic Beauty Estimation (SBE) survey</h1><div class=\"card\"><p style=\"color:var(--ink)\">DaWei Mountain National Forest Park (Liuyang City, Hunan Province, China) is known for its flowering <i>Rhododendron simsii</i> forests. You will rate sixteen aerial photographs of these landscapes on a 7-point scale: very like (3), like (2), slightly like (1), neutral (0), slightly dislike (−1), dislike (−2), very dislike (−3).</p><p>Please preview all 16 photographs first, then rate each one based on your own aesthetic impression. Each photograph will be shown for '+SECS+' seconds.</p>'+g+'</div>','I have previewed all photographs',function(){done.preview=true;save('d',done);next();});\n  }\n  function about(){\n    var h=ABOUT.map(function(n,i){var d=q(n);return '<div class=\"q\"><b>'+(i+1)+'. '+esc(d.title)+'</b>'+d.choices.map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+c.value+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('');\n    page('<h1>About you</h1><div class=\"card\">'+h+'</div>','Continue',function(){\n      var l=[];for(var i=0;i<ABOUT.length;i++){var x=app.querySelector('input[name=\"'+ABOUT[i]+'\"]:checked');if(!x)return err('Please answer: '+q(ABOUT[i]).title);l.push([ABOUT[i],Number(x.value)]);}\n      var b=this;b.disabled=true;saveAll(l,b,function(){done.about=true;save('d',done);next();});\n    });\n  }\n  function rate(t,k){\n    var f=files[t.file],left=SECS;\n    var opts=CH.map(function(c){return '<label><input type=\"radio\" name=\"score\" value=\"'+c.value+'\"><span>'+esc(c.text)+'</span></label>';}).join('');\n    page('<div class=\"top\"><span class=\"t\">Sample Plot '+(k+1)+' of '+TR.length+'</span><div class=\"bar\"><i style=\"width:'+(100*k/TR.length)+'%\"></i></div><span class=\"t\">Time left <span class=\"timer\" id=\"tm\">'+left+'</span> s</span></div><div class=\"card\"><div class=\"pic\"><img alt=\"Sample plot '+(k+1)+'\" src=\"'+esc(f.url)+'\"></div><div class=\"q\" style=\"margin-top:14px\"><b>'+(k+7)+'. SBE Rating for Sample Plot '+(k+1)+'</b><div class=\"seg\" role=\"radiogroup\" aria-label=\"SBE rating\">'+opts+'</div></div></div>',k===TR.length-1?'Finish':'Next photograph',function(){\n      var x=app.querySelector('input[name=score]:checked');if(!x)return err('Please rate this photograph.');\n      if(left>0)return err('Please keep looking at the photograph until the time is up.');\n      var b=this;b.disabled=true;\n      SPSite.answer('sbe_rating',{score:Number(x.value)},{key:t.id,shown:[f.name]}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}done[t.id]=true;save('d',done);next();});\n    });\n    var go=document.getElementById('go');go.disabled=true;\n    function upd(){var tm=document.getElementById('tm');if(tm)tm.textContent=left;if(left<=0){if(tick){clearInterval(tick);tick=null;}go.disabled=false;}}\n    if(SECS<=0)upd();else tick=setInterval(function(){left--;upd();},1000);\n  }\n  function finish(){\n    if(tick){clearInterval(tick);tick=null;}\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>The photographs were taken straight down from a drone 100 m above sixteen plots in four flowering areas of DaWei Mountain. In the original survey of 1549 participants, plots with large, connected red patches of rhododendron flowers were rated most beautiful, and plots with more bare, dark ground were rated least beautiful. The share of red flower patches was the strongest predictor of scenic beauty (r = 0.80).</p><p style=\"font-size:.82rem\">Liu, Y., Liao, J., Huang, Y., Li, Q., Wu, L., Yi, X., Wang, L., &amp; Chen, C. (2025). The Mechanism by Which Colour Patch Characteristics Influence the Visual Landscape Quality of Rhododendron simsii Landscape Recreational Forests. Horticulturae 11:898, doi:10.3390/horticulturae11080898.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')done.intro=false;else if(x==='sbe_rating')TR.forEach(function(t){done[t.id]=false;});else done.about=false;});save('d',done);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={type:e.type,title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='sbe_rating'){TR=e.trials;CH=e.items[0].choices;}});});\n    (SPSite.getMedia('plots')||[]).forEach(function(f){files[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};done=load('d')||{};\n    done.intro=a.consent===true;\n    done.about=ABOUT.every(function(n){return a[n]!=null;});\n    if(done.about)done.preview=true;\n    TR.forEach(function(t){done[t.id]=false;});\n    ((a.sbe_rating&&a.sbe_rating.trials)||[]).forEach(function(t){if(t.key)done[t.key]=true;});\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
