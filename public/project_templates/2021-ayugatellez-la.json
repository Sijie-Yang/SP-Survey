   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>La Mancha Landscapes</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"La Mancha Rural Landscapes: Visual Preference\",\n  \"description\": \"Faithful replication of the photo questionnaire in Ayuga-Téllez, Ramírez-Montoro, Grande-Ortiz & Muñoz-Violero (2021), Sustainability 13:13799: rate 16 photographs of the rural landscape of Campo de Criptana on the plain of La Mancha (Spain) from 1 to 5.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"photos\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"intro\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part in this survey.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"name\": \"age\",\n      \"inputType\": \"number\",\n      \"title\": \"Age (years)\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Male\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Educational level\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"University educated\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Non-university educated\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"residence\",\n      \"title\": \"Do you live in the place shown in the photographs (Campo de Criptana)?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Yes, I live there\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"No, I live elsewhere\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"photos\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"photo_ratings\",\n      \"title\": \"How much do you like this landscape?\",\n      \"isRequired\": true,\n      \"description\": \"One trial per photo (key photo_01 … photo_16, numbered as in the paper's Table 1 / Supplementary S1), shown one at a time in random order. Value: 1 = I don't like it at all, 2 = I don't like it much, 3 = I quite like it, 4 = I like it, 5 = I like it a lot.\",\n      \"items\": [\n       {\n        \"id\": \"photo_01\"\n       },\n       {\n        \"id\": \"photo_02\"\n       },\n       {\n        \"id\": \"photo_03\"\n       },\n       {\n        \"id\": \"photo_04\"\n       },\n       {\n        \"id\": \"photo_05\"\n       },\n       {\n        \"id\": \"photo_06\"\n       },\n       {\n        \"id\": \"photo_07\"\n       },\n       {\n        \"id\": \"photo_08\"\n       },\n       {\n        \"id\": \"photo_09\"\n       },\n       {\n        \"id\": \"photo_10\"\n       },\n       {\n        \"id\": \"photo_11\"\n       },\n       {\n        \"id\": \"photo_12\"\n       },\n       {\n        \"id\": \"photo_13\"\n       },\n       {\n        \"id\": \"photo_14\"\n       },\n       {\n        \"id\": \"photo_15\"\n       },\n       {\n        \"id\": \"photo_16\"\n       }\n      ],\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"I don't like it at all\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"I don't like it much\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"I quite like it\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"I like it\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"I like it a lot\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#f4f1ea;--card:#fff;--ink:#22201b;--muted:#625c50;--accent:#8a5a1f;--accent-ink:#fff;--line:#ddd6c8;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q>b{display:block;margin-bottom:4px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\ninput[type=text]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:100%;max-width:200px;background:#fff;color:var(--ink)}\n.pic{background:#ddd;border-radius:12px;overflow:hidden;display:flex;align-items:center;justify-content:center;height:min(52vh,480px)}\n.pic img{max-width:100%;max-height:100%;object-fit:contain;display:block}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem;font-variant-numeric:tabular-nums}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.scale{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-top:12px}\n.scale button{appearance:none;border:1px solid var(--line);background:var(--card);border-radius:10px;padding:8px 4px;font:inherit;font-size:.85rem;line-height:1.25;cursor:pointer;color:var(--ink);min-height:64px}\n.scale button b{display:block;font-size:1.1rem}\n.scale button:hover{border-color:var(--accent)}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:560px){.pic{height:auto;max-height:50vh}.pic img{max-height:50vh}.scale{grid-template-columns:1fr}.scale button{min-height:0;text-align:left;padding:9px 12px}.scale button b{display:inline;margin-right:8px}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Ayuga-Téllez, Ramírez-Montoro, Grande-Ortiz &amp; Muñoz-Violero (2021), Sustainability 13:13799, doi:10.3390/su132413799, Supplementary Materials S1 (CC BY 4.0; photos 1 and 7 from a Spanish nature photography network, as credited in the paper). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='lamancha2021:', IDS=[];for(var i=1;i<=16;i++)IDS.push('photo_'+(i<10?'0':'')+i);\n  var app=document.getElementById('app'), Q={}, files={}, ans={}, done={}, order=[], SPEC=null, SCALE=[];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function q(n){return Q[n]||{};}\n  function saveAll(l,b,cb){Promise.all(l.map(function(a){return SPSite.answer(a[0],a[1]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}cb();});}\n  function page(html,btn,cb){\n    app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn||'Continue')+'</button></div><div class=\"err\"></div>';\n    document.getElementById('go').onclick=cb;app.onchange=hideErr;\n  }\n  function next(){\n    window.scrollTo(0,0);\n    if(!ans.intro)return intro();\n    if(!ans.about)return about();\n    for(var i=0;i<order.length;i++){if(!done[order[i]])return photo(i);}\n    finish();\n  }\n  function intro(){\n    if(IDS.some(function(k){return !files[k+'.jpg'];})){app.innerHTML='<h1>Pictures missing</h1><p>Media folder photos must hold photo_01.jpg … photo_16.jpg.</p>';return;}\n    page('<h1>Visual preference for the rural landscape of La Mancha</h1><p>This survey is about the rural landscape of Campo de Criptana, on the plain of La Mancha in Spain. You will see 16 photographs, one at a time, and say how much you like each landscape on a scale from 1 to 5. There are no right or wrong answers. It takes about 5 to 10 minutes and your answers are anonymous.</p>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var b=this;b.disabled=true;saveAll([['consent',true]],b,function(){ans.intro=true;save('a',ans);next();});\n    });\n  }\n  function about(){\n    var ns=['age','gender','education','residence'];\n    var h=ns.map(function(n){var d=q(n);if(d.type!=='radiogroup')return '<div class=\"q\"><b>'+esc(d.title)+'</b><input type=\"text\" inputmode=\"numeric\" name=\"'+n+'\"></div>';\n      return '<div class=\"q\"><b>'+esc(d.title)+'</b>'+(d.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('');\n    page('<h1>A few questions about you</h1><div class=\"card\">'+h+'</div>','Continue',function(){\n      var a=Number(app.querySelector('input[name=age]').value.trim());if(!a||a<16||a>110)return err('Please enter your age in years.');\n      var l=[['age',a]];for(var i=1;i<ns.length;i++){var x=app.querySelector('input[name=\"'+ns[i]+'\"]:checked');if(!x)return err('Please answer: '+q(ns[i]).title);l.push([ns[i],Number(x.value)]);}\n      var b=this;b.disabled=true;saveAll(l,b,function(){ans.about=true;save('a',ans);next();});\n    });\n  }\n  function photo(i){\n    var k=order[i], f=files[k+'.jpg'], n=0;order.forEach(function(x){if(done[x])n++;});\n    app.innerHTML='<div class=\"top\"><span class=\"t\">Photo '+(n+1)+' of 16</span><div class=\"bar\"><i style=\"width:'+(100*n/16)+'%\"></i></div></div>'+\n      '<div class=\"card\"><div class=\"pic\"><img alt=\"Rural landscape photograph\" src=\"'+esc(f.url)+'\"></div><div class=\"q\" style=\"margin-top:12px\"><b>'+esc(q('photo_ratings').title)+'</b></div>'+\n      '<div class=\"scale\">'+SCALE.map(function(c){return '<button type=\"button\" data-v=\"'+c.value+'\"><b>'+c.value+'</b>'+esc(c.text)+'</button>';}).join('')+'</div><div class=\"err\"></div></div>';\n    [].forEach.call(app.querySelectorAll('.scale button'),function(btn){btn.onclick=function(){\n      [].forEach.call(app.querySelectorAll('.scale button'),function(x){x.disabled=true;});\n      SPSite.answer('photo_ratings',Number(btn.dataset.v),{key:k,shown:[f.name]}).then(function(r){if(!ok(r)){[].forEach.call(app.querySelectorAll('.scale button'),function(x){x.disabled=false;});return err(r.error);}done[k]=true;next();});\n    };});\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>The 16 photographs combined four features of the La Mancha landscape: animals, vegetation, cultural heritage such as windmills and shrines, and a wide view. In the original study with 160 people, the partridge in front of the shrine of La Virgen de Criptana and the shrine among trees were liked most, and the grape-harvesting machine least; women, people over 40 and people without a university degree gave higher scores on average.</p><p style=\"font-size:.82rem\">Photographs and scale: Ayuga-Téllez, E., Ramírez-Montoro, J. J., Grande-Ortiz, M. Á., &amp; Muñoz-Violero, D. (2021). Differences in visual preference in rural landscapes on the plain of La Mancha in Spain. Sustainability 13:13799, doi:10.3390/su132413799.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')ans.intro=false;else if(x==='photo_ratings')done={};else ans.about=false;});save('a',ans);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={type:e.type,title:g.title||e.title,isRequired:e.isRequired,choices:(g.choices&&g.choices.length)?g.choices:e.choices};});});\n    SCALE=q('photo_ratings').choices||[];\n    (SPSite.getMedia('photos')||[]).forEach(function(f){files[f.name]=f;});\n    var o=load('order');if(!o||o.length!==16)o=shuffle(IDS);order=o;save('order',order);\n    var a=(ctx&&ctx.answers)||{};ans=load('a')||{};\n    ((a.photo_ratings&&a.photo_ratings.trials)||[]).forEach(function(t){if(t.key)done[t.key]=true;});\n    ans.intro=a.consent===true;ans.about=a.residence!=null;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
