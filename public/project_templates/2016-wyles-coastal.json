  "title": "Coastal Litter and the Benefits of the Seaside",
  "locale": "en",
  "spSite": {
   "id": "site-46e906c41b1426a0",
   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Coastal Litter Views</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Coastal Litter and the Benefits of the Seaside\",\n  \"description\": \"Participants imagine sitting on a rocky shore and rate four versions of the same view (clean, drift seaweed, fishing litter, public litter; random order) for attractiveness, willingness to stay in a hotel with that view, mood, arousal and restoration likelihood (1–10), then explain each rating and answer four connectedness-to-nature items. Rebuilt from Study 3 of Wyles et al. (2016), Environment and Behavior 48(9): 1095–1126, with the paper's own photographs (Figure 1, CC BY 3.0).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"shore\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"min\": 16,\n      \"max\": 99\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"scenes\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"attractive\",\n      \"title\": \"How attractive do you find this view?\",\n      \"description\": \"1–10, one answer per scene, keyed by condition (clean / seaweed / fishing_litter / public_litter).\",\n      \"rateMin\": 1,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Extremely\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"hotel\",\n      \"title\": \"How willing would you be to stay in a hotel with this view?\",\n      \"description\": \"1–10, one answer per scene, keyed by condition (clean / seaweed / fishing_litter / public_litter).\",\n      \"rateMin\": 1,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Extremely\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"mood\",\n      \"title\": \"How does this scene make you feel?\",\n      \"description\": \"1–10, one answer per scene, keyed by condition (clean / seaweed / fishing_litter / public_litter).\",\n      \"rateMin\": 1,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Very sad\",\n      \"maxRateDescription\": \"Very happy\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"arousal\",\n      \"title\": \"How does this scene make you feel?\",\n      \"description\": \"1–10, one answer per scene, keyed by condition (clean / seaweed / fishing_litter / public_litter).\",\n      \"rateMin\": 1,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Very calm\",\n      \"maxRateDescription\": \"Very excited\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"restoration\",\n      \"title\": \"To what level would you agree with the statement: \\\"I would be able to rest and recover my ability and focus in this environment\\\"?\",\n      \"description\": \"1–10, one answer per scene, keyed by condition (clean / seaweed / fishing_litter / public_litter).\",\n      \"rateMin\": 1,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Completely\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"why\",\n      \"title\": \"What is it about this scene that made you respond this way and why?\",\n      \"description\": \"Asked after all ratings, with each scene shown again; keyed by condition.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"nature\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"cns1\",\n      \"title\": \"I think of the natural world as a community to which I belong.\",\n      \"description\": \"Connectedness to Nature, 4-item short form (Mayer & Frantz 2004) as used in Study 3.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Completely disagree\",\n      \"maxRateDescription\": \"Completely agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"cns2\",\n      \"title\": \"I often feel part of the web of life.\",\n      \"description\": \"Connectedness to Nature, 4-item short form (Mayer & Frantz 2004) as used in Study 3.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Completely disagree\",\n      \"maxRateDescription\": \"Completely agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"cns3\",\n      \"title\": \"I feel that all inhabitants of Earth, human, and non-human, share a common \\\"life force\\\".\",\n      \"description\": \"Connectedness to Nature, 4-item short form (Mayer & Frantz 2004) as used in Study 3.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Completely disagree\",\n      \"maxRateDescription\": \"Completely agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"cns4\",\n      \"title\": \"Like a tree can be part of a forest, I feel embedded within the broader natural world.\",\n      \"description\": \"Connectedness to Nature, 4-item short form (Mayer & Frantz 2004) as used in Study 3.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Completely disagree\",\n      \"maxRateDescription\": \"Completely agree\",\n      \"isRequired\": true\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"litter-original\">{\"source\": \"Wyles et al. (2016) Environ Behav 48(9), Study 3 (n = 19), Figure 2B\", \"n\": 19, \"result\": \"Preference, mood and restoration likelihood differed between the four conditions (preference F(3,54)=25.73, partial eta2=.59; mood eta2=.69; restoration eta2=.52); arousal did not (p=.85). Clean and seaweed scenes were rated above the midpoint, littered scenes below, public litter lowest.\"}</script>\n<style>\n:root{--bg:#f1f5f8;--card:#fff;--ink:#1f2a22;--muted:#5f6d63;--accent:#1f6f9a;--line:#d9e3ea;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.1rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.view{background:#000;border-radius:12px;overflow:hidden;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center}\n.view img{width:100%;height:100%;object-fit:contain;display:block}\n.thumb{max-width:520px;margin:0 auto}\n.timer{height:4px;background:var(--line);border-radius:2px;overflow:hidden;margin-top:8px}.timer>i{display:block;height:100%;background:var(--accent);width:0}\n.big{font-size:2.4rem;font-weight:700;text-align:center;margin:18px 0;color:var(--ink)}\n.item{padding:12px 0;border-top:1px solid var(--line)}.item:first-child{border-top:0}\n.item .t{margin-bottom:8px}\n.scale{display:grid;gap:6px}\n.scale button{appearance:none;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:8px;padding:9px 0;font:inherit;font-weight:600;cursor:pointer}\n.scale button.on{background:var(--accent);border-color:var(--accent);color:#fff}\n.item.miss .t{color:var(--warn)}\n.anch{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin:4px 0 6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\ntextarea{width:100%;min-height:90px;font:inherit;padding:10px;border:1px solid var(--line);border-radius:10px}\n.mini{font-size:.85rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Wyles, Pahl, Thomas &amp; Thompson (2016), Environment and Behavior 48(9): 1095–1126, Figure 1, CC BY 3.0.</footer>\n<script>\n(function(){\n  var KEY='coastal-litter:state', CONDS=['clean','seaweed','fishing_litter','public_litter'];\n  var RATE=['attractive','hotel','mood','arousal','restoration'], CNS=['cns1','cns2','cns3','cns4'];\n  var app=document.getElementById('app'), Q={}, files=[], st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function id(n){return n.replace(/\\.[^.]+$/,'');}\n  function byId(i){for(var k=0;k<files.length;k++)if(id(files[k].name)===i)return files[k];return null;}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function radio(n){var q=Q[n];return '<div class=\"f\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function scale(k,max){var q=Q[k],b='';for(var v=1;v<=max;v++)b+='<button type=\"button\" data-v=\"'+v+'\" aria-label=\"'+v+'\">'+v+'</button>';\n    return '<div class=\"item\" data-k=\"'+k+'\"><div class=\"t\">'+esc(q.title)+'</div><div class=\"scale\" style=\"grid-template-columns:repeat('+max+',1fr)\">'+b+'</div><div class=\"anch\"><span>1 = '+esc(q.minRateDescription)+'</span><span>'+max+' = '+esc(q.maxRateDescription)+'</span></div></div>';}\n  function bind(vals){app.querySelectorAll('.item').forEach(function(it){it.querySelectorAll('button').forEach(function(b){b.onclick=function(){vals[it.dataset.k]=Number(b.dataset.v);it.classList.remove('miss');it.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b);});};});});}\n  function missing(keys,vals){var m=keys.filter(function(k){return vals[k]==null;});m.forEach(function(k){app.querySelector('.item[data-k=\"'+k+'\"]').classList.add('miss');});return m;}\n  function send(list,b,next){b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}next();});}\n  function intro(){\n    app.innerHTML='<h1>Views of the coast</h1><p>You will see four photographs of a seashore, one at a time, and answer five short questions about each. Afterwards you see them again and say in a few words why you answered as you did. About 10 minutes.</p>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div class=\"f\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"16\" max=\"99\"></div>'+radio('gender')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var age=Number(document.getElementById('age').value);if(!(age>=16&&age<=99))return err('Please enter your age.');\n      var g=app.querySelector('input[name=gender]:checked');if(!g)return err('Please answer: '+Q.gender.title);\n      send([SPSite.answer('consent',true),SPSite.answer('age',age),SPSite.answer('gender',g.value)],this,function(){st.step='brief';save();route();});\n    };\n  }\n  function brief(){\n    app.innerHTML='<h2>Imagine this</h2><div class=\"card\"><p style=\"color:var(--ink);font-size:1.1rem\">Imagine that it is a sunny day and you have decided to go for a leisurely walk. After a while you decide to sit down and take in the view. This is what you see …</p><button class=\"btn\" id=\"go\">Show the first view</button></div>';\n    document.getElementById('go').onclick=function(){st.step='rate';st.k=0;save();route();};\n  }\n  function rate(){\n    var c=st.order[st.k],f=byId(c),vals={};\n    app.innerHTML='<p>View '+(st.k+1)+' of 4</p><div class=\"view thumb\"><img alt=\"Seashore photograph\" src=\"'+esc(f.url)+'\"></div><div class=\"card\">'+RATE.map(function(k){return scale(k,10);}).join('')+\n      '<div style=\"margin-top:12px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    window.scrollTo(0,0);bind(vals);\n    document.getElementById('go').onclick=function(){\n      var m=missing(RATE,vals);if(m.length)return err('Please answer every question ('+m.length+' missing, marked).');\n      st.r[c]=vals;\n      send(RATE.map(function(k){return SPSite.answer(k,vals[k],{key:c,shown:[f.name]});}),this,function(){st.k++;if(st.k>=4){st.step='why';st.k=0;}save();route();});\n    };\n  }\n  function why(){\n    var c=st.order[st.k],f=byId(c),r=st.r[c]||{};\n    app.innerHTML='<p>View '+(st.k+1)+' of 4, shown again</p><div class=\"view thumb\"><img alt=\"Seashore photograph\" src=\"'+esc(f.url)+'\"></div><div class=\"card\"><p class=\"mini\">Your ratings: attractive '+r.attractive+'/10 · hotel '+r.hotel+'/10 · mood '+r.mood+'/10 (sad–happy) · arousal '+r.arousal+'/10 (calm–excited) · rest and recover '+r.restoration+'/10</p><b>'+esc(Q.why.title)+'</b><textarea id=\"tx\"></textarea><div style=\"margin-top:12px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    window.scrollTo(0,0);\n    document.getElementById('go').onclick=function(){\n      var t=document.getElementById('tx').value.trim();if(t.length<2)return err('Please write a few words.');\n      send([SPSite.answer('why',t,{key:c,shown:[f.name]})],this,function(){st.k++;if(st.k>=4)st.step='cns';save();route();});\n    };\n  }\n  function cns(){\n    var vals={};\n    app.innerHTML='<h2>About you and nature</h2><p>How much do you agree with each statement?</p><div class=\"card\">'+CNS.map(function(k){return scale(k,5);}).join('')+'<div style=\"margin-top:12px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    window.scrollTo(0,0);bind(vals);\n    document.getElementById('go').onclick=function(){\n      var m=missing(CNS,vals);if(m.length)return err('Please answer every statement.');\n      send(CNS.map(function(k){return SPSite.answer(k,vals[k]);}),this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';st.k=0;save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;if(s==='brief')return brief();if(s==='rate')return rate();if(s==='why')return why();if(s==='cns')return cns();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','why'].concat(RATE,CNS).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    files=(SPSite.getMedia('shore')||[]).filter(function(f){return /\\.(jpe?g|png|webp)$/i.test(f.name);});\n    var miss=CONDS.filter(function(c){return !byId(c);});\n    if(miss.length){app.innerHTML='<h1>Photos missing</h1><p>Upload '+miss.map(function(c){return c+'.jpg';}).join(', ')+' to the media folder \"shore\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!st||!st.order||!st.r)st={step:'intro',order:shuffle(CONDS),k:0,r:{}};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;st.r={};}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
