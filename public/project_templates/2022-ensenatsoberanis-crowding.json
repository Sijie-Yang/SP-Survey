   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Crowding at Tulum</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Crowding at Tulum: How Many Visitors Are Acceptable?\",\n  \"description\": \"Faithful replication of Enseñat-Soberanis & Blanco-Gregory (2022), Land 11:1651: visitors rate how acceptable the number of people is in six photographs of the Temple of the Frescoes at Tulum (0 to 105 visitors) on the −4 to +4 normative scale, after two questions on crowding problems and followed by visitor profile questions.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"crowding\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"intro\",\n    \"title\": \"Crowding at the archaeological site of Tulum\",\n    \"intro\": \"This questionnaire is about how you feel about the number of visitors at the archaeological site of Tulum, Mexico. It has three short parts: your view of crowding at the site, six photographs to rate, and a few questions about you. It takes about 5 minutes. Answers are anonymous and used for research only.\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"Consent\",\n      \"label\": \"I agree to take part in this survey.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"opinion\",\n    \"title\": \"Part 1: Crowding at Tulum\",\n    \"elements\": [\n     {\n      \"type\": \"checkbox\",\n      \"name\": \"crowding_problems\",\n      \"title\": \"Which problems, if any, does crowding cause for you when visiting Tulum? Select all that apply.\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Feeling overwhelmed due to a lack of space\"\n       },\n       {\n        \"value\": 2,\n        \"tex