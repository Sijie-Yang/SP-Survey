   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Visual Walkability of Commercial Streets (Fukuoka Tenjin)</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Visual Walkability of Commercial Streets (Fukuoka Tenjin)\",\n    \"description\": \"Look at 360° street panoramas of the Tenjin commercial district in Fukuoka and rate each on four walking needs (usefulness, safety, comfort, attractiveness) with 5-point semantic differential scales. Method replication of Huang et al. (2025, Buildings).\",\n    \"locale\": \"en\",\n    \"pages\": [\n      { \"name\": \"intro\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. My answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" }\n      ]},\n      { \"name\": \"ratings\", \"elements\": [\n        { \"type\": \"imageslidergroup\", \"name\": \"walkability_sd\",\n          \"title\": \"How does this street feel for walking?\",\n          \"description\": \"Rate the street on each pair of adjectives. Higher scores are closer to the adjective on the right.\",\n          \"imageCount\": 1, \"trialCount\": 20, \"isRequired\": true, \"choices\": [],\n          \"scaleMin\": 1, \"scaleMax\": 5, \"scaleStep\": 1,\n          \"dimensions\": [\n            { \"id\": \"usefulness\", \"label\": \"Usefulness\", \"left\": \"Useless (1)\", \"right\": \"Useful (5)\" },\n            { \"id\": \"safety\", \"label\": \"Safety\", \"left\": \"Unsafe (1)\", \"right\": \"Safe (5)\" },\n            { \"id\": \"comfort\", \"label\": \"Comfort\", \"left\": \"Uncomfortable (1)\", \"right\": \"Comfortable (5)\" },\n            { \"id\": \"attractiveness\", \"label\": \"Attractiveness\", \"left\": \"Unattractive (1)\", \"right\": \"Attractive (5)\" }\n          ],\n          \"imageSelectionMode\": \"huggingface_random\", \"randomImageSelection\": true, \"excludePreviouslyUsedImages\": true,\n          \"mediaFolders\": [\"tenjin\"] }\n      ]},\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"radiogroup\", \"name\": \"role\", \"title\": \"Which describes you best?\", \"choices\": [\n          { \"value\": \"undergraduate\", \"text\": \"Undergraduate student\" }, { \"value\": \"graduate\", \"text\": \"Graduate student\" },\n          { \"value\": \"working\", \"text\": \"Working\" }, { \"value\": \"other\", \"text\": \"Other\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"choices\": [\n          { \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"male\", \"text\": \"Male\" }, { \"value\": \"other\", \"text\": \"Other / prefer not to say\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"familiar\", \"title\": \"Have you been to Tenjin, Fukuoka?\", \"choices\": [\n          { \"value\": \"often\", \"text\": \"Yes, often\" }, { \"value\": \"once\", \"text\": \"Once or a few times\" }, { \"value\": \"never\", \"text\": \"Never\" } ] }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f5f5f2;--card:#fff;--ink:#1d2125;--muted:#5d646b;--accent:#2f5d50;--line:#dde1e3;--sel:#e3efe9}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1100px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.05rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.defs{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.defs div{background:var(--sel);border-radius:10px;padding:10px 12px;font-size:.93rem}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent)}.btn:disabled{opacity:.45;cursor:not-allowed}\n.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:8px 0 12px}.progress>i{display:block;height:100%;background:var(--accent)}\n.pano{overflow-x:auto;border-radius:12px;background:#000;-webkit-overflow-scrolling:touch}\n.pano img{display:block;width:100%;height:auto;min-width:720px}\n.hint{font-size:.82rem;color:var(--muted);margin:4px 0 0;display:none}\n.sd{margin-top:10px}.sd .r{display:grid;grid-template-columns:150px 1fr 150px;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--line)}\n.sd .l{text-align:right;font-size:.92rem}.sd .rt{font-size:.92rem}\n.opts{display:flex;justify-content:space-between;gap:6px}\n.opts label{flex:1;text-align:center;border:1px solid var(--line);border-radius:8px;padding:7px 0;cursor:pointer;font-weight:600}\n.opts input{position:absolute;opacity:0;pointer-events:none}\n.opts label:has(input:checked){background:var(--accent);color:#fff;border-color:var(--accent)}\n.opts label:has(input:focus-visible){outline:2px solid var(--accent);outline-offset:2px}\n.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:14px}.q>b{display:block;margin-bottom:4px}\n.err{color:#b3261e;margin-top:8px;min-height:1.2em}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n@media (max-width:700px){.defs{grid-template-columns:1fr}.sd .r{grid-template-columns:1fr 1fr;row-gap:6px}.sd .l{text-align:left;order:1}.sd .rt{text-align:right;order:2}.sd .opts{order:3;grid-column:1/3}.hint{display:block}.pano img{width:auto;height:260px;min-width:0}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Street images: Tenjin, Fukuoka, Google Street View panoramas 2022–2026 (© Google). Scales from Huang, Yu, Lyu, Sun, Dewancker &amp; Gao (2025), Buildings 15(1):113.</footer>\n<script>\n(function(){\n  var DEFS=[['Usefulness','Does the street give you reasons and an easy way to walk here: destinations, shops, clear paths, no barriers such as very wide roads or blocked land?'],\n    ['Safety','Does the street look free from crime and traffic danger: no graffiti, litter or abandoned buildings, open sightlines, cars and bicycles kept apart from people?'],\n    ['Comfort','Does the street make walking pleasant in practice: good sidewalks, street furniture, greenery, openness and accessible facilities?'],\n    ['Attractiveness','Is walking here enjoyable: an appealing, interesting and lively street, greenery, distinctive buildings, other people around?']];\n  var app=document.getElementById('app'),Q={},i=0,done={},vals={};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function defs(){return '<div class=\"defs\">'+DEFS.map(function(d){return '<div><b>'+d[0]+'</b><br>'+esc(d[1])+'</div>';}).join('')+'</div>';}\n  function mediaOf(k){var t=Q.sd.trials&&Q.sd.trials[k];return (t&&t.media)||Q.sd.media||[];}\n  function firstOpen(){for(var k=0;k<Q.sd.trialCount;k++){if(!done[k])return k;}return Q.sd.trialCount;}\n  function intro(){\n    app.innerHTML='<h1>How walkable do these streets look?</h1>'+\n      '<p>You will see '+Q.sd.trialCount+' street panoramas from the Tenjin commercial district in Fukuoka, Japan. Each one is a full 360° view from the middle of the street. Look at each panorama calmly (about 30–40 seconds) and rate it on four walking needs, from 1 to 5. It takes about 12 minutes.</p>'+\n      '<div class=\"card\"><h2>What the four words mean</h2><p>Please read these definitions first. You can open them again on every screen.</p>'+defs()+'</div>'+\n      '<div class=\"card\"><p>'+esc(Q.consent.title)+'</p><div class=\"row\"><button class=\"btn\" id=\"yes\">'+esc(Q.consent.labelTrue||'I agree')+'</button></div><div class=\"err\"></div></div>';\n    document.getElementById('yes').onclick=function(){SPSite.answer('consent',true).then(function(r){if(r&&r.ok===false)return err(r.error);i=firstOpen();trial();});};\n  }\n  function trial(){\n    if(i>=Q.sd.trialCount)return about();\n    var m=mediaOf(i)[0]||{},v=vals[i]||{},n=Q.sd.trialCount;\n    var html='<h1>Street '+(i+1)+' of '+n+'</h1><div class=\"progress\" aria-hidden=\"true\"><i style=\"width:'+(100*i/n)+'%\"></i></div>'+\n      '<div class=\"pano\"><img src=\"'+esc(m.url)+'\" alt=\"360° street panorama '+(i+1)+' in Tenjin, Fukuoka\"></div><p class=\"hint\">Swipe the picture sideways to look around.</p>'+\n      '<div class=\"card\"><h2>'+esc(Q.sd.title)+'</h2><p>'+esc(Q.sd.description)+'</p><div class=\"sd\">';\n    Q.sd.dimensions.forEach(function(d){\n      html+='<div class=\"r\"><div class=\"l\">'+esc(d.left)+'</div><div class=\"opts\" role=\"radiogroup\" aria-label=\"'+esc(d.label)+'\">';\n      for(var s=d.min;s<=d.max;s+=d.step||1){html+='<label><input type=\"radio\" name=\"'+d.id+'\" value=\"'+s+'\"'+(v[d.id]===s?' checked':'')+'>'+s+'</label>';}\n      html+='</div><div class=\"rt\">'+esc(d.right)+'</div></div>';\n    });\n    html+='</div><details style=\"margin-top:10px\"><summary style=\"cursor:pointer;color:var(--accent)\">Show the definitions</summary>'+defs()+'</details>'+\n      '<div class=\"row\">'+(i>0?'<button class=\"btn ghost\" id=\"back\">Back</button>':'')+'<button class=\"btn\" id=\"next\">'+(i+1<n?'Next street':'Continue')+'</button></div><div class=\"err\"></div></div>';\n    app.innerHTML=html;\n    app.querySelectorAll('.opts input').forEach(function(r){r.onchange=function(){v[r.name]=Number(r.value);vals[i]=v;err('');};});\n    var back=document.getElementById('back');if(back)back.onclick=function(){i-=1;trial();};\n    document.getElementById('next').onclick=function(){\n      var miss=Q.sd.dimensions.filter(function(d){return v[d.id]==null;});\n      if(miss.length)return err('Please rate: '+miss.map(function(d){return d.label;}).join(', '));\n      var k=i,btn=this;btn.disabled=true;\n      SPSite.answer('walkability_sd',v,{trial:k}).then(function(r){\n        if(r&&r.ok===false){btn.disabled=false;return err(r.error);}\n        done[k]=true;i=k+1;trial();});\n    };\n    window.scrollTo(0,0);\n  }\n  function radios(q){return '<div class=\"q\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q.name+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function about(){\n    app.innerHTML='<h1>About you</h1><p>Optional, used only to describe the sample.</p><div class=\"card\">'+radios(Q.role)+radios(Q.gender)+radios(Q.familiar)+\n      '<div class=\"row\"><button class=\"btn\" id=\"finish\">Finish</button></div><div class=\"err\"></div></div>';\n    ['role','gender','familiar'].forEach(function(n){app.querySelectorAll('input[name='+n+']').forEach(function(r){r.onchange=function(){SPSite.answer(n,r.value).then(function(x){if(x&&x.ok===false)err(x.error);});};});});\n    document.getElementById('finish').onclick=function(){var btn=this;btn.disabled=true;err('Submitting…');\n      SPSite.complete().then(function(r){if(r&&r.ok===false){btn.disabled=false;err(r.error||('Please answer: '+(r.missing||[]).join(', ')));var m=r.missing||[];if(m.indexOf('consent')>=0)intro();else if(m.indexOf('walkability_sd')>=0){i=firstOpen();trial();}}});};\n  }\n  SPSite.onReady(function(ctx){\n    Q={consent:SPSite.getQuestion('consent'),sd:SPSite.getQuestion('walkability_sd'),role:SPSite.getQuestion('role'),gender:SPSite.getQuestion('gender'),familiar:SPSite.getQuestion('familiar')};\n    var a=(ctx&&ctx.answers)||{},p=a.walkability_sd,list=p&&Array.isArray(p.trials)?p.trials:[];\n    list.forEach(function(t,k){if(t&&t.value&&typeof t.value==='object'){done[k]=true;vals[k]=t.value;}});\n    if(a.consent===true){i=firstOpen();trial();}else intro();\n  });\n})();\n</script>\n</body>\n</html>\n",
