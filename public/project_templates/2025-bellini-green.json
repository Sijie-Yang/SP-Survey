   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Green Rooms</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Greenery in Living Rooms and Bedrooms\",\n  \"description\": \"Participants are randomly assigned to one of two greenery styles (plants built into furniture, or climbing plants on structures). They then see six rendered rooms in random order: a living room and a bedroom, each without plants, with potted plants and with integrated greenery. For every room they rate four perceived-restorativeness items and seven adjectives on 1–7 scales. Rebuilt from Bellini, Miola, Sperduti, Caccaro, Pinton, Graffeo & Pazzaglia (2025), Frontiers in Psychology 16: 1631417, using the 12 renderings printed in Figures 1–2 of the paper (CC BY 4.0).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"rooms\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"nonbinary\",\n        \"text\": \"Non-binary\"\n       },\n       {\n        \"value\": \"na\",\n        \"text\": \"Prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 99\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"ins\",\n      \"title\": \"Which picture best describes your relationship with the natural world? (Inclusion of Nature in Self)\",\n      \"description\": \"7 pairs of circles labelled Self and Nature with increasing overlap; 1 = no overlap (not at all connected), 7 = almost complete overlap (completely connected).\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"group\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"group\",\n      \"title\": \"Assigned greenery style (set by the page)\",\n      \"description\": \"Between-subject condition drawn at random: noclimb = plants integrated into furniture modules; climb = climbing plants on supporting structures.\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"noclimb\",\n        \"text\": \"Non-climbing integrated greenery\"\n       },\n       {\n        \"value\": \"climb\",\n        \"text\": \"Climbing integrated greenery\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"rooms\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_away\",\n      \"title\": \"Being here helps me take a break from my everyday routine.\",\n      \"description\": \"PRS short form, Being away subscale; 1 = not at all, 7 = completely. Keyed by image id (group_room_greenery).\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Completely\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_fascination\",\n      \"title\": \"This place contains various elements that spontaneously capture my attention.\",\n      \"description\": \"PRS short form, Fascination (example item quoted in the paper) subscale; 1 = not at all, 7 = completely. Keyed by image id (group_room_greenery).\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Completely\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_coherence\",\n      \"title\": \"The things in this place fit together and are clearly organised.\",\n      \"description\": \"PRS short form, Coherence subscale; 1 = not at all, 7 = completely. Keyed by image id (group_room_greenery).\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Completely\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_compatibility\",\n      \"title\": \"This place suits what I like to do and who I am.\",\n      \"description\": \"PRS short form, Compatibility subscale; 1 = not at all, 7 = completely. Keyed by image id (group_room_greenery).\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Completely\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"adj_restful\",\n      \"title\": \"Restful\",\n      \"description\": \"Affective quality of the place (Russell model adjective); 1 = not at all suitable, 7 = completely suitable. Keyed by image id.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Not at all suitable\",\n      \"maxRateDescription\": \"Completely suitable\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"adj_beautiful\",\n      \"title\": \"Beautiful\",\n      \"description\": \"Affective quality of the place (Russell model adjective, aesthetic judgement); 1 = not at all suitable, 7 = completely suitable. Keyed by image id.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Not at all suitable\",\n      \"maxRateDescription\": \"Completely suitable\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"adj_inviting\",\n      \"title\": \"Inviting\",\n      \"description\": \"Affective quality of the place (Russell model adjective); 1 = not at all suitable, 7 = completely suitable. Keyed by image id.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Not at all suitable\",\n      \"maxRateDescription\": \"Completely suitable\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"adj_lively\",\n      \"title\": \"Lively\",\n      \"description\": \"Affective quality of the place (Russell model adjective); 1 = not at all suitable, 7 = completely suitable. Keyed by image id.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Not at all suitable\",\n      \"maxRateDescription\": \"Completely suitable\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"adj_chaotic\",\n      \"title\": \"Chaotic\",\n      \"description\": \"Affective quality of the place (Russell model adjective); 1 = not at all suitable, 7 = completely suitable. Keyed by image id.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Not at all suitable\",\n      \"maxRateDescription\": \"Completely suitable\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"adj_oppressive\",\n      \"title\": \"Oppressive\",\n      \"description\": \"Affective quality of the place (Russell model adjective); 1 = not at all suitable, 7 = completely suitable. Keyed by image id.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Not at all suitable\",\n      \"maxRateDescription\": \"Completely suitable\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"adj_monotonous\",\n      \"title\": \"Monotonous\",\n      \"description\": \"Affective quality of the place (Russell model adjective); 1 = not at all suitable, 7 = completely suitable. Keyed by image id.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Not at all suitable\",\n      \"maxRateDescription\": \"Completely suitable\",\n      \"isRequired\": true\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"rooms-original\">{\"source\": \"Bellini et al. (2025) Front Psychol 16:1631417, Table 2\", \"n\": 304, \"recruitment\": \"Prolific, Italy\", \"means\": {\"potted\": {\"restorativeness_total\": 18.14, \"fascination\": 4.24, \"beautiful\": 4.42, \"monotonous\": 4.04}, \"without\": {\"restorativeness_total\": 16.16, \"fascination\": 3.45, \"beautiful\": 3.89, \"monotonous\": 4.73}, \"integrated\": {\"restorativeness_total\": 18.17, \"fascination\": 4.42, \"beautiful\": 4.49, \"monotonous\": 3.93}}, \"result\": \"Rooms with greenery (potted or integrated) were rated more restorative, more beautiful, more inviting and lively, and less monotonous and oppressive than rooms without plants; potted and integrated greenery did not differ much.\"}</script>\n<style>\n:root{--bg:#f4f4f1;--card:#fff;--ink:#1f2a22;--muted:#5f6d63;--accent:#3d6b4f;--line:#dde4dc;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1080px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.1rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.two{display:grid;grid-template-columns:1.1fr 1fr;gap:16px;align-items:start}.two>.view{position:sticky;top:12px}\n@media(max-width:760px){.two{grid-template-columns:1fr}.two>.view{position:static}}\n.view img{width:100%;height:auto;display:block;border-radius:10px;border:1px solid var(--line)}\n.item{padding:10px 0;border-top:1px solid var(--line)}.item:first-of-type{border-top:0}\n.item .t{margin-bottom:6px}.item.miss .t{color:var(--warn)}\n.scale{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}\n.scale button{appearance:none;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:8px;padding:7px 0;font:inherit;font-weight:600;cursor:pointer}\n.scale button.on{background:var(--accent);border-color:var(--accent);color:#fff}\n.anch{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);margin-top:3px}\n.sec{font-weight:700;margin:14px 0 4px}.sec:first-child{margin-top:0}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.ins{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-top:8px}@media(max-width:560px){.ins{grid-template-columns:repeat(4,1fr)}}\n.ins button{appearance:none;border:1px solid var(--line);background:#fff;border-radius:10px;padding:6px;cursor:pointer;font:inherit;color:var(--ink)}\n.ins button.on{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent)}\n.ins svg{width:100%;height:auto;display:block}\n.credit{max-width:1080px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Room renderings: Bellini et al. (2025), Frontiers in Psychology 16:1631417, Figures 1–2 (CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='green-rooms:state', PRS=['prs_away','prs_fascination','prs_coherence','prs_compatibility'], ADJ=['adj_restful','adj_beautiful','adj_inviting','adj_lively','adj_chaotic','adj_oppressive','adj_monotonous'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function intro(){\n    app.innerHTML='<h1>Rooms at home</h1><p>You will first answer a few questions about yourself. Then you will see six pictures of living rooms and bedrooms. For each room, imagine being there and rate how it feels on 11 short items. It takes about 10 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function circles(k){var d=46-(k-1)*7.5;return '<svg viewBox=\"0 0 100 50\" aria-hidden=\"true\"><circle cx=\"'+(50-d/2)+'\" cy=\"25\" r=\"20\" fill=\"none\" stroke=\"#1f2a22\" stroke-width=\"1.6\"/><circle cx=\"'+(50+d/2)+'\" cy=\"25\" r=\"20\" fill=\"rgba(61,107,79,.22)\" stroke=\"#3d6b4f\" stroke-width=\"1.6\"/></svg>';}\n  function about(){\n    var ins=null;\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.gender.title)+'</b>'+(Q.gender.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"gender\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div><div class=\"f\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"99\"></div><div class=\"f\"><b>'+esc(Q.ins.title)+'</b><div class=\"mini\" style=\"color:var(--muted);font-size:.85rem\">Empty black circle = you (Self) · green circle = Nature</div><div class=\"ins\">'+[1,2,3,4,5,6,7].map(function(k){return '<button type=\"button\" data-v=\"'+k+'\" aria-label=\"Picture '+k+' of 7\">'+circles(k)+'<div class=\"mini\" style=\"font-size:.8rem\">'+k+'</div></button>';}).join('')+'</div></div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    app.querySelectorAll('.ins button').forEach(function(b){b.onclick=function(){ins=Number(b.dataset.v);app.querySelectorAll('.ins button').forEach(function(x){x.classList.toggle('on',x===b);});};});\n    document.getElementById('go').onclick=function(){\n      var g=app.querySelector('input[name=gender]:checked');if(!g)return err('Please answer: '+Q.gender.title);\n      var age=Number(document.getElementById('age').value);if(!(age>=18&&age<=99))return err('Please enter your age (18 or older).');\n      if(!ins)return err('Please choose the picture that best describes your relationship with nature.');\n      send([SPSite.answer('gender',g.value),SPSite.answer('age',age),SPSite.answer('ins',ins),SPSite.answer('group',st.group)],this,function(){st.step='rooms';st.k=0;save();route();});\n    };\n  }\n  function row(n,label){return '<div class=\"item\" data-k=\"'+n+'\"><div class=\"t\">'+esc(label)+'</div><div class=\"scale\">'+[1,2,3,4,5,6,7].map(function(v){return '<button type=\"button\" data-v=\"'+v+'\">'+v+'</button>';}).join('')+'</div></div>';}\n  function rooms(){\n    var id=st.order[st.k], f=files[id], vals={};\n    app.innerHTML='<p>Room '+(st.k+1)+' of '+st.order.length+'</p><div class=\"two\"><div class=\"view\"><img alt=\"Rendered room\" src=\"'+esc(f.url)+'\"></div><div class=\"card\" style=\"margin-top:0\"><div class=\"sec\">How much do you agree? <span class=\"mini\" style=\"font-weight:400;color:var(--muted)\">1 = not at all, 7 = completely</span></div>'+PRS.map(function(n){return row(n,Q[n].title);}).join('')+'<div class=\"sec\">How well does each word describe this place? <span class=\"mini\" style=\"font-weight:400;color:var(--muted)\">1 = not at all suitable, 7 = completely suitable</span></div>'+ADJ.map(function(n){return row(n,Q[n].title);}).join('')+'<div style=\"margin-top:12px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div></div>';\n    app.querySelectorAll('.item').forEach(function(it){it.querySelectorAll('.scale button').forEach(function(b){b.onclick=function(){vals[it.dataset.k]=Number(b.dataset.v);it.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b);});it.classList.remove('miss');if(!app.querySelector('.item.miss'))err('');};});});\n    document.getElementById('go').onclick=function(){\n      var all=PRS.concat(ADJ), m=all.filter(function(n){return vals[n]==null;});\n      if(m.length){m.forEach(function(n){app.querySelector('.item[data-k=\"'+n+'\"]').classList.add('miss');});return err('Please answer every item ('+m.length+' missing, marked in red).');}\n      send(all.map(function(n){return SPSite.answer(n,vals[n],{key:id,shown:[f.name]});}),this,function(){st.k++;if(st.k>=st.order.length)st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='rooms')return rooms();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','gender','age','ins','group'].concat(PRS,ADJ).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('rooms')||[]).forEach(function(f){var m=/^((?:no)?climb)_(living|bedroom)_(none|potted|integrated)\\.(jpe?g|png|webp)$/i.exec(f.name);if(m)files[(m[1]+'_'+m[2]+'_'+m[3]).toLowerCase()]=f;});\n    var groups=['noclimb','climb'].filter(function(g){return Object.keys(files).filter(function(k){return k.indexOf(g+'_')===0;}).length>0;});\n    if(!groups.length){app.innerHTML='<h1>Pictures missing</h1><p>Upload the room renderings to the media folder \"rooms\" as &lt;noclimb|climb&gt;_&lt;living|bedroom&gt;_&lt;none|potted|integrated&gt;.jpg.</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var valid=st&&st.group&&st.order&&st.order.every(function(x){return files[x];});\n    if(!valid){var g=groups[Math.floor(Math.random()*groups.length)];st={step:'intro',k:0,group:g,order:shuffle(Object.keys(files).filter(function(k){return k.indexOf(g+'_')===0;}))};}\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
