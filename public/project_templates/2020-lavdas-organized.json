   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Organized Complexity and Landscape Preference</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Organized Complexity and Landscape Preference\",\n    \"description\": \"Seven sets of Alpine scenes. In each set the same view has been edited in one way: fractal or plain graphics added, natural detail simplified, or buildings of different styles and complexity inserted. Choose the version you prefer and say why (most beautiful, most interesting, makes more sense, feels more familiar). Rebuilt from Lavdas & Schirpke (2020), PLOS ONE.\",\n    \"locale\": \"en\",\n    \"mediaFolders\": [\"scenes\"],\n    \"pages\": [\n      { \"name\": \"start\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" }\n      ]},\n      { \"name\": \"sets\", \"elements\": [\n        { \"type\": \"imagepicker\", \"name\": \"choice\", \"title\": \"Which image do you prefer?\", \"description\": \"One record per picture set: key = set1 … set7 (the paper's Figs 1–7); value = the chosen file (setN_a … setN_d, letters as in the paper); shown = all images of the set in the order they were laid out.\", \"imageCount\": 2, \"isRequired\": true },\n        { \"type\": \"custom\", \"name\": \"reasons\", \"title\": \"Recorded by the page, keyed by set id: what made the participant choose the image, any of beautiful ('Most beautiful'), interesting ('Most interesting'), sense ('Makes more sense'), familiar ('Feels more familiar').\", \"isRequired\": true }\n      ]},\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"male\", \"text\": \"Male\" }, { \"value\": \"other\", \"text\": \"Other / prefer not to say\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"age_group\", \"title\": \"Age\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"under_18\", \"text\": \"Under 18\" }, { \"value\": \"18_30\", \"text\": \"18–30\" }, { \"value\": \"31_39\", \"text\": \"31–39\" }, { \"value\": \"40_49\", \"text\": \"40–49\" }, { \"value\": \"50_59\", \"text\": \"50–59\" }, { \"value\": \"60_69\", \"text\": \"60–69\" }, { \"value\": \"70_plus\", \"text\": \"70 or older\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"place_of_living\", \"title\": \"Where do you live?\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"large_city\", \"text\": \"Large city (more than 200,000 residents)\" }, { \"value\": \"town\", \"text\": \"Town (20,000–200,000 residents)\" }, { \"value\": \"small_town\", \"text\": \"Small town (1,000–20,000 residents)\" }, { \"value\": \"village\", \"text\": \"Village (fewer than 1,000 residents)\" } ] },\n        { \"type\": \"text\", \"name\": \"country\", \"title\": \"Country of residence (optional)\" }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f3f4f0;--card:#fff;--ink:#1b2219;--muted:#5a6357;--accent:#3f5f2a;--accent-ink:#fff;--line:#d6dbd1;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:980px;margin:0 auto;padding:24px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.1rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:8px 0 14px}.progress>i{display:block;height:100%;background:var(--accent)}\n.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n@media (max-width:620px){.grid{grid-template-columns:1fr}}\n.pic{appearance:none;position:relative;padding:0;border:3px solid transparent;border-radius:12px;overflow:hidden;cursor:pointer;background:#ddd;display:block;width:100%;aspect-ratio:1.65}\n.pic img{width:100%;height:100%;object-fit:cover;display:block}\n.pic .tag{position:absolute;left:8px;top:8px;background:rgba(0,0,0,.6);color:#fff;border-radius:999px;padding:2px 10px;font-weight:700;font-size:.85rem}\n.pic.on{border-color:var(--accent);box-shadow:0 0 0 3px rgba(63,95,42,.25)}\n.pic.on .tag{background:var(--accent)}\n.reasons{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}\n@media (max-width:560px){.reasons{grid-template-columns:1fr}}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:10px 12px;border:1px solid var(--line);border-radius:10px;cursor:pointer;background:var(--card);margin-top:6px}\nlabel.opt input{width:18px;height:18px}\ninput[type=text]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:100%;max-width:320px}\n.q{margin-top:16px}.q>b{display:block;margin-bottom:4px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:980px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Images: Lavdas &amp; Schirpke (2020), PLOS ONE 15(6): e0235257, Figs 1–7, Creative Commons Attribution License (CC BY 4.0); base photos of Figs 1–3 from Schirpke et al. (2013), Sustainability, CC BY 3.0; images in Figs 4–7 by A. A. Lavdas; fractal graphics in 2c–2d by Lior P. Bar (CC BY); building in 6c photographed by Bruce Damonte (CC BY). Percentage labels of the paper's figures were cropped off.</footer>\n<script>\n(function(){\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  var SETS=[{id:'set1',n:2},{id:'set2',n:4},{id:'set3',n:2},{id:'set4',n:2},{id:'set5',n:3},{id:'set6',n:4},{id:'set7',n:4}];\n  var REASONS=[['beautiful','Most beautiful'],['interesting','Most interesting'],['sense','Makes more sense'],['familiar','Feels more familiar']];\n  var ABOUT=['gender','age_group','place_of_living'];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function shuffle(a){a=a.slice();for(var k=a.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1));var x=a[k];a[k]=a[j];a[j]=x;}return a;}\n  function save(){try{localStorage.setItem('lavdas2020:state',JSON.stringify(st));}catch(e){}}\n  function names(s){var r=[];for(var i=0;i<s.n;i++)r.push(s.id+'_'+'abcd'[i]+'.jpg');return r;}\n\n  function intro(){\n    var miss=[];SETS.forEach(function(s){names(s).forEach(function(n){if(!files[n])miss.push(n);});});\n    if(miss.length){app.innerHTML='<h1>Images missing</h1><p>Missing in folder “scenes”: '+esc(miss.join(', '))+'</p>';return;}\n    app.innerHTML='<h1>Which version of the landscape do you prefer?</h1><p>You will see 7 sets of pictures from the Alps (Tyrol). Within a set, the pictures show the same view, edited in one way. For each set, choose the picture you prefer and tell us what made you choose it. About 5 minutes.</p>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var b=this;b.disabled=true;\n      SPSite.answer('consent',true).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}next();});\n    };\n  }\n\n  function next(){\n    var id=SETS.map(function(s){return s.id;}).filter(function(x){return !st.reasons[x];})[0];\n    if(id)return trial(SETS.findIndex(function(s){return s.id===id;}));\n    about();\n  }\n\n  function trial(k){\n    var s=SETS[k], order=st.order[s.id], pick=null, n=Object.keys(st.reasons).length;\n    app.innerHTML='<p>Set '+(n+1)+' of '+SETS.length+'</p><div class=\"progress\"><i style=\"width:'+(100*n/SETS.length)+'%\"></i></div>'+\n      '<h2>'+esc(Q.choice.title||'Which image do you prefer?')+'</h2><p>Tap a picture to choose it.</p><div class=\"grid\">'+\n      order.map(function(f,i){return '<button class=\"pic\" data-f=\"'+esc(f)+'\"><img src=\"'+esc(files[f].url)+'\" alt=\"Picture '+(i+1)+'\"><span class=\"tag\">'+(i+1)+'</span></button>';}).join('')+'</div>'+\n      '<div class=\"card\"><b>What made you choose this image?</b><p style=\"margin:2px 0 0\">You can tick more than one.</p><div class=\"reasons\">'+\n      REASONS.map(function(r){return '<label class=\"opt\"><input type=\"checkbox\" value=\"'+r[0]+'\"> '+esc(r[1])+'</label>';}).join('')+\n      '</div><div style=\"margin-top:14px\"><button class=\"btn\" id=\"nx\">Next</button></div><div class=\"err\"></div></div>';\n    app.querySelectorAll('.pic').forEach(function(b){b.onclick=function(){pick=b.getAttribute('data-f');err('');app.querySelectorAll('.pic').forEach(function(x){x.classList.toggle('on',x===b);});};});\n    document.getElementById('nx').onclick=function(){\n      if(!pick)return err('Please choose the picture you prefer.');\n      var why=[].slice.call(app.querySelectorAll('.reasons input:checked')).map(function(i){return i.value;});\n      if(!why.length)return err('Please tick at least one reason.');\n      var b=this;b.disabled=true;\n      var nr=JSON.parse(JSON.stringify(st.reasons));nr[s.id]=why;\n      SPSite.answer('choice',pick,{key:s.id,shown:order}).then(function(r){\n        if(!ok(r)){b.disabled=false;return err(r.error);}\n        return SPSite.answer('reasons',nr).then(function(r2){if(!ok(r2)){b.disabled=false;return err(r2.error);}st.reasons=nr;save();window.scrollTo(0,0);next();});\n      });\n    };\n  }\n\n  function radios(n){return (Q[n].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');}\n  function about(){\n    app.innerHTML='<h1>About you</h1><div class=\"card\">'+ABOUT.map(function(n){return '<div class=\"q\"><b>'+esc(Q[n].title)+'</b>'+radios(n)+'</div>';}).join('')+\n      '<div class=\"q\"><b>'+esc(Q.country.title)+'</b><input type=\"text\" id=\"country\" maxlength=\"80\"></div>'+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"fin\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('fin').onclick=function(){\n      var vals={},miss=ABOUT.filter(function(n){var r=app.querySelector('input[name='+n+']:checked');if(r)vals[n]=r.value;return !r;});\n      if(miss.length)return err('Please answer: '+miss.map(function(n){return Q[n].title;}).join('; '));\n      var c=document.getElementById('country').value.trim();if(c)vals.country=c;\n      var b=this;b.disabled=true;\n      Promise.all(Object.keys(vals).map(function(n){return SPSite.answer(n,vals[n]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}done();});\n    };\n  }\n\n  function done(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"st\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){\n      if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){if(m.indexOf('consent')>=0)intro();else if(m.indexOf('choice')>=0||m.indexOf('reasons')>=0){st.reasons={};save();next();}else about();},1800);}\n      else{try{localStorage.removeItem('lavdas2020:state');}catch(e){}var s=document.getElementById('st');if(s)s.textContent='Your answers are saved.';}\n    });\n  }\n\n  SPSite.onReady(function(ctx){\n    ['consent','choice','reasons','country'].concat(ABOUT).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('scenes')||[]).forEach(function(f){files[f.name]=f;});\n    try{st=JSON.parse(localStorage.getItem('lavdas2020:state'));}catch(e){st=null;}\n    if(!st||typeof st.order!=='object'||!st.order)st={order:{}};\n    SETS.forEach(function(s){var o=st.order[s.id],want=names(s);if(!Array.isArray(o)||o.length!==want.length||o.some(function(x){return want.indexOf(x)<0;}))st.order[s.id]=shuffle(want);}); // picture positions randomised per set and participant\n    var a=(ctx&&ctx.answers)||{};\n    st.reasons=(a.reasons&&typeof a.reasons==='object')?a.reasons:{};\n    save();\n    if(a.consent===true)next();else intro();\n  });\n})();\n</script>\n</body>\n</html>\n",
