   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Alpine Landscape Liking</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Landscape in the Alps: Which landscape do you like?\",\n  \"description\": \"Faithful replication of the photo questionnaire of Schirpke, Timmermann, Tappeiner & Tasser (2016), Cultural ecosystem services of mountain regions: Modelling the aesthetic value, Ecological Indicators 69:78-90. Twenty-four panoramic photographs of Alpine landscapes in Tyrol and South Tyrol (pastures, timberline, forests, meadows, orchards, villages, rivers, scree) are shown four per page in the original fixed order; each is rated from 1 (I don't like it at all) to 10 (I like it very much). Personal questions follow: gender, tourist or not, city or village, settlement size, nationality and age group. Ratings are keyed by picture number (P01-P24).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"panoramas\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"pictures\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"liking\",\n      \"title\": \"How much do you like this landscape?\",\n      \"isRequired\": true,\n      \"rateValues\": [\n       {\n        \"value\": 1,\n        \"text\": \"I don't like it at all\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"6\"\n       },\n       {\n        \"value\": 7,\n        \"text\": \"7\"\n       },\n       {\n        \"value\": 8,\n        \"text\": \"8\"\n       },\n       {\n        \"value\": 9,\n        \"text\": \"9\"\n       },\n       {\n        \"value\": 10,\n        \"text\": \"I like it very much\"\n       }\n      ],\n      \"description\": \"Keyed by picture number (P01-P24), 1-10.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"tourist\",\n      \"title\": \"Are you a tourist?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"living_place\",\n      \"title\": \"Main place of living\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"city\",\n        \"text\": \"In a city\"\n       },\n       {\n        \"value\": \"village\",\n        \"text\": \"In a small village\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"settlement_size\",\n      \"title\": \"How many people live in your city/village?\",\n      \"isRequired\": false\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"nationality\",\n      \"title\": \"Nationality\",\n      \"isRequired\": false\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age_group\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"lt25\",\n        \"text\": \"Under 25\"\n       },\n       {\n        \"value\": \"25-60\",\n        \"text\": \"Between 25 and 60\"\n       },\n       {\n        \"value\": \"gt60\",\n        \"text\": \"Over 60\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"landscape-table\">{\"source\": \"Schirpke et al. (2016) Ecological Indicators 69:78-90, Table 2; mean liking 1-10, N=967\", \"pictures\": [{\"id\": \"P01\", \"mean\": 6.94, \"description\": \"Alpine pastures, lake\"}, {\"id\": \"P02\", \"mean\": 6.87, \"description\": \"Timberline zone\"}, {\"id\": \"P03\", \"mean\": 7.53, \"description\": \"Alpine pastures, single trees\"}, {\"id\": \"P04\", \"mean\": 7.15, \"description\": \"Meadows with hedges\"}, {\"id\": \"P05\", \"mean\": 4.59, \"description\": \"Orchard plantation\"}, {\"id\": \"P06\", \"mean\": 8.09, \"description\": \"Mixture of subalpine forest and grassland\"}, {\"id\": \"P07\", \"mean\": 4.29, \"description\": \"Village\"}, {\"id\": \"P08\", \"mean\": 7.03, \"description\": \"Alpine pastures\"}, {\"id\": \"P09\", \"mean\": 5.76, \"description\": \"Alluvial forest\"}, {\"id\": \"P10\", \"mean\": 7.5, \"description\": \"Alpine pastures\"}, {\"id\": \"P11\", \"mean\": 6.27, \"description\": \"Alpine hut, forest and forest road\"}, {\"id\": \"P12\", \"mean\": 7.66, \"description\": \"Alpine meadows, single trees\"}, {\"id\": \"P13\", \"mean\": 4.74, \"description\": \"Intensively used meadows, houses, street\"}, {\"id\": \"P14\", \"mean\": 8.26, \"description\": \"Steep meadows, rocks, trees, lake\"}, {\"id\": \"P15\", \"mean\": 6.43, \"description\": \"Intensively used meadows, single trees\"}, {\"id\": \"P16\", \"mean\": 6.84, \"description\": \"Scree slopes, rocks\"}, {\"id\": \"P17\", \"mean\": 6.62, \"description\": \"Forest, forest road\"}, {\"id\": \"P18\", \"mean\": 7.39, \"description\": \"Alpine pastures, meadows, trees\"}, {\"id\": \"P19\", \"mean\": 6.41, \"description\": \"River, gravel bars, rocks, forest\"}, {\"id\": \"P20\", \"mean\": 7.09, \"description\": \"Alpine grassland, dwarf shrubs, young trees\"}, {\"id\": \"P21\", \"mean\": 6.94, \"description\": \"Timberline zone, alpine pasture\"}, {\"id\": \"P22\", \"mean\": 4.47, \"description\": \"Street, forest, village, grassland\"}, {\"id\": \"P23\", \"mean\": 6.06, \"description\": \"Dense spruce forest\"}, {\"id\": \"P24\", \"mean\": 6.29, \"description\": \"Spruce forest, underground grassland\"}]}</script>\n<style>\n:root{--bg:#f3f2ee;--card:#fff;--ink:#1d1f1c;--muted:#5d6159;--accent:#3d6b4f;--line:#d9dad2;--warn:#b3261e;--sel:#e0ece4}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1100px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.grid{display:grid;grid-template-columns:1fr;gap:14px;margin-top:14px}\n.b{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px}\n.b img{width:100%;height:auto;display:block;border-radius:8px}\n.b .no{font-weight:700;margin:6px 0 4px}\n.o{display:grid;grid-template-columns:repeat(10,1fr);gap:3px}.anch{display:flex;justify-content:space-between;font-size:.75rem;color:var(--muted);margin-top:3px}\ninput.txt{font:inherit;width:100%;max-width:360px;padding:9px 11px;border:1px solid var(--line);border-radius:10px;margin-top:6px}\n.o label{display:flex;flex-direction:column;align-items:center;gap:2px;border:1px solid var(--line);border-radius:8px;padding:9px 1px;cursor:pointer;font-size:.68rem;line-height:1.15;text-align:center;color:var(--muted)}\n.o label b{font-size:.95rem;color:var(--ink)}\n.o label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.o input{display:none}\n.b.miss{outline:2px solid var(--warn);outline-offset:2px}\n.blk{margin-top:14px}.blk:first-child{margin-top:0}\n.blk.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.err{color:var(--warn);margin-top:8px;min-height:1.5em;line-height:1.5}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:700px){.b{padding:8px}.o{gap:2px}.o label b{font-size:.88rem}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs and questionnaire: Schirpke, Timmermann, Tappeiner &amp; Tasser (2016), Cultural ecosystem services of mountain regions: Modelling the aesthetic value, Ecological Indicators 69:78-90 (doi:10.1016/j.ecolind.2016.04.001), questionnaire in the supplementary material of the author manuscript (Europe PMC PMC4962904, CC BY-NC-ND). Used unmodified for research replication; removed on request of the authors.</footer>\n<script>\n(function(){\n  var KEY='schirpke2016alps:state', PER=4, IDS=[], BG=['gender','tourist','living_place','settlement_size','nationality','age_group'];\n  for(var i=1;i<=24;i++)IDS.push('P'+(i<10?'0':'')+i);\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='';}}\n  function hideErr(){var e=app.querySelector('.err');if(e&&!app.querySelector('.miss'))e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function intro(){\n    app.innerHTML='<h1>Landscape in the Alps: which landscape do you like?</h1><p>You will see 24 panoramic pictures of Alpine landscapes, four per page. Please rate how much you like each landscape on a scale from 1 (I don\\'t like it at all) to 10 (I like it very much). Please respond spontaneously and on your own, and evaluate all images. At the end there are a few short questions about you. It takes about 5–10 minutes and your answers are anonymous.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='pics';st.p=0;st.r={};save();route();});};\n  }\n  function pics(){\n    var q=Q.liking,sc=q.rateValues||[],p=st.p,ids=IDS.slice(p*PER,p*PER+PER),pages=Math.ceil(IDS.length/PER),r=st.r;\n    app.innerHTML='<h2>Pictures '+(p*PER+1)+'–'+(p*PER+ids.length)+' of '+IDS.length+'</h2><p>'+esc(q.title)+' 1 = I don\\'t like it at all, 10 = I like it very much.</p><div class=\"grid\">'+ids.map(function(id,i){\n      return '<div class=\"b\" data-k=\"'+id+'\"><div class=\"no\">Picture '+(p*PER+i+1)+'</div><img alt=\"Alpine landscape panorama\" src=\"'+esc(files[id].url)+'\"><div class=\"o\" style=\"margin-top:8px\">'+sc.map(function(s){return '<label><input type=\"radio\" name=\"r_'+id+'\" value=\"'+s.value+'\"'+(r[id]===s.value?' checked':'')+'><b>'+s.value+'</b></label>';}).join('')+'</div><div class=\"anch\"><span>'+esc(sc[0].text)+'</span><span>'+esc(sc[sc.length-1].text)+'</span></div></div>';}).join('')+\n      '</div><div class=\"card\"><button class=\"btn\" id=\"go\">Next</button><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var miss=[],L=[];\n      ids.forEach(function(id){var x=app.querySelector('input[name=\"r_'+id+'\"]:checked');if(x)r[id]=Number(x.value);else miss.push(app.querySelector('.b[data-k=\"'+id+'\"]'));});\n      save();\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please rate every picture on this page.');}\n      ids.forEach(function(id){L.push(SPSite.answer('liking',r[id],{key:id,shown:[files[id].name]}));});\n      send(L,this,function(){if(p<pages-1)st.p=p+1;else st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+BG.map(function(n){var q=Q[n];\n      if(q.type==='text')return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b><br><input class=\"txt\" id=\"f_'+n+'\" type=\"text\" maxlength=\"80\"></div>';\n      return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var L=[],miss=[];\n      BG.forEach(function(n){var q=Q[n];\n        if(q.type==='text'){var v=document.getElementById('f_'+n).value.trim();if(v)L.push(SPSite.answer(n,v));return;}\n        var x=app.querySelector('input[name=\"'+n+'\"]:checked');if(!x){miss.push(app.querySelector('.blk[data-n=\"'+n+'\"]'));return;}\n        L.push(SPSite.answer(n,x.value));});\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please answer the marked questions.');}\n      send(L,this,function(){st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var b=e.target.closest&&e.target.closest('.b,.blk');if(b){b.classList.remove('miss');hideErr();}\n    if(e.target.name&&/^r_/.test(e.target.name)&&st&&st.r){st.r[e.target.name.slice(2)]=Number(e.target.value);save();}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='pics')return pics();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','liking'].concat(BG).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('panoramas')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=IDS.filter(function(k){return !files[k];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"panoramas\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.step)||a.consent!==true)st={step:'intro'};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
