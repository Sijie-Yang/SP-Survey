   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Fitness Trail Landscapes</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Fitness Trail Landscapes: Layout Preference and Psychological Perception\",\n  \"description\": \"Two parts from a study of park fitness trails in Shenyang. Part 1: participants choose the trail environment combinations they prefer from five options (plant-plant, plant-water, terrain-water, plant-public service facilities, plant-terrain), each shown as a real photo plus a block-model diagram, as in the paper's Table 2. Part 2: after browsing all five trail photos, they rate each photo on the paper's three 7-point semantic-differential items (sense of security, pleasure and experience). Rebuilt from Zhu, Chen, Wang & Hu (2025), Frontiers in Psychology 16: 1595451, with the photos and diagrams printed in Table 2 (CC BY 4.0). Analysis: share of participants choosing each combination; mean of each sense per photo, compared with paired tests.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"trail\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part in this study.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"choose\",\n    \"elements\": [\n     {\n      \"type\": \"checkbox\",\n      \"name\": \"composition_choice\",\n      \"title\": \"Which kinds of fitness trail surroundings do you prefer?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"plant_plant\",\n        \"text\": \"Plant – plant\"\n       },\n       {\n        \"value\": \"plant_water\",\n        \"text\": \"Plant – water\"\n       },\n       {\n        \"value\": \"terrain_water\",\n        \"text\": \"Terrain – water\"\n       },\n       {\n        \"value\": \"plant_facilities\",\n        \"text\": \"Plant – public service facilities\"\n       },\n       {\n        \"value\": \"plant_terrain\",\n        \"text\": \"Plant – terrain\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"rate\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"security\",\n      \"title\": \"Sense of security\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Extremely weak\",\n      \"maxRateDescription\": \"Extremely strong\",\n      \"isRequired\": true,\n      \"description\": \"Keyed by trail photo: plant_plant, plant_water, terrain_water, plant_facilities, plant_terrain (the five environment combinations of the paper's Table 2). 7 = sense is extremely strong, 1 = extremely weak.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"pleasure\",\n      \"title\": \"Sense of pleasure\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Extremely weak\",\n      \"maxRateDescription\": \"Extremely strong\",\n      \"isRequired\": true,\n      \"description\": \"Keyed by trail photo: plant_plant, plant_water, terrain_water, plant_facilities, plant_terrain (the five environment combinations of the paper's Table 2). 7 = sense is extremely strong, 1 = extremely weak.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"experience\",\n      \"title\": \"Sense of experience\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Extremely weak\",\n      \"maxRateDescription\": \"Extremely strong\",\n      \"isRequired\": true,\n      \"description\": \"Keyed by trail photo: plant_plant, plant_water, terrain_water, plant_facilities, plant_terrain (the five environment combinations of the paper's Table 2). 7 = sense is extremely strong, 1 = extremely weak.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"trail_use\",\n      \"title\": \"How often do you walk, run or cycle on park fitness trails?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"weekly\",\n        \"text\": \"At least once a week\"\n       },\n       {\n        \"value\": \"monthly\",\n        \"text\": \"A few times a month\"\n       },\n       {\n        \"value\": \"rarely\",\n        \"text\": \"A few times a year or less\"\n       },\n       {\n        \"value\": \"never\",\n        \"text\": \"Never\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"What is your gender?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"woman\",\n        \"text\": \"Woman\"\n       },\n       {\n        \"value\": \"man\",\n        \"text\": \"Man\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"trail-original\">{\"source\": \"Zhu, Chen, Wang & Hu (2025) Frontiers in Psychology 16: 1595451\", \"composition_choice\": {\"n\": 87, \"participants\": \"trail users and nearby residents/workers, online (Questionnaire Star), October 2024\", \"selections\": {\"plant_plant\": 95, \"plant_water\": 77, \"terrain_water\": 35, \"plant_facilities\": 23, \"plant_terrain\": 10}, \"total_selections\": 240, \"note\": \"Shares as printed in Table 2 (39.58, 32.08, 14.58, 9.58, 4.17 %); the text names plant-water first.\"}, \"sd_rating\": {\"n\": 129, \"images\": 80, \"per_participant\": 10, \"note\": \"80 of the authors' own photos (40 plant-plant, 40 plant-water), not published; 15 typical images were browsed first. Ratings were related to segmented image indicators (green-looking rate, sky openness, enclosure) with regression and curve fits.\"}}</script>\n<style>\n:root{--bg:#f1f5f4;--card:#fff;--ink:#1c2523;--muted:#5a6865;--accent:#b2452f;--line:#d8e0de;--warn:#b3261e;--sel:#f8e9e5}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.combos{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px}\n.combo{display:block;border:2px solid var(--line);border-radius:12px;overflow:hidden;cursor:pointer;background:#fff}\n.combo:has(input:checked){border-color:var(--accent);background:var(--sel)}\n.combo img{width:100%;display:block}.combo img:first-child{aspect-ratio:4/3;object-fit:cover}\n.combo .lab{display:flex;gap:8px;align-items:center;padding:8px 10px;font-weight:600}\n.strip{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}.strip img{width:100%;border-radius:6px;display:block}\n.photo{width:100%;max-width:560px;border-radius:8px;display:block;margin:0 auto 12px}\n.sd{padding:8px 0;border-top:1px solid var(--line)}.sd:first-of-type{border-top:0}\n.sd b{display:block;font-weight:600;margin-bottom:4px}\n.row{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}\n.row label{display:flex;flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:8px;padding:5px 0;cursor:pointer;font-size:.82rem}\n.row label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.row input{margin:0 0 2px}\n.ends{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-top:2px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs and diagrams: Zhu, Chen, Wang &amp; Hu (2025), Frontiers in Psychology 16: 1595451, Table 2 (doi:10.3389/fpsyg.2025.1595451, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='fitness-trail:state';\n  var COMBOS=[['plant_plant','Plant – plant'],['plant_water','Plant – water'],['terrain_water','Terrain – water'],['plant_facilities','Plant – public service facilities'],['plant_terrain','Plant – terrain']];\n  var SD=[['security','Sense of security'],['pleasure','Sense of pleasure'],['experience','Sense of experience']];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function url(n){return files[n]?files[n].url:'';}\n  function intro(){\n    app.innerHTML='<h1>Fitness trail landscapes</h1><p>This short survey is about walking and running trails in city parks. First, choose which kinds of trail surroundings you prefer. Then look at five trail photos and say how safe, pleasant and engaging each one feels. It takes about 5 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='choose';save();route();});};\n  }\n  function choose(){\n    app.innerHTML='<div class=\"prog\">Part 1 of 2</div><div class=\"card\"><p style=\"color:var(--ink)\"><b>'+esc(Q.composition_choice.title)+'</b><br>Each option shows a real trail and a simple model of the same layout. You can choose more than one.</p><div class=\"combos\">'+st.combos.map(function(k){var c=COMBOS.filter(function(x){return x[0]===k;})[0];return '<label class=\"combo\"><img alt=\"'+esc(c[1])+' trail photo\" src=\"'+esc(url('photo_'+k))+'\"><img alt=\"'+esc(c[1])+' layout model\" src=\"'+esc(url('diagram_'+k))+'\"><span class=\"lab\"><input type=\"checkbox\" name=\"combo\" value=\"'+k+'\"> '+esc(c[1])+'</span></label>';}).join('')+'</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var v=[].map.call(app.querySelectorAll('input[name=combo]:checked'),function(x){return x.value;});if(!v.length)return err('Please choose at least one.');\n      var sh=st.combos.map(function(k){return files['photo_'+k].name;});\n      send([SPSite.answer('composition_choice',v,{shown:sh})],this,function(){st.step='browse';save();route();});\n    };\n  }\n  function browse(){\n    app.innerHTML='<div class=\"prog\">Part 2 of 2</div><div class=\"card\"><p style=\"color:var(--ink)\">Here are the five trail photos you will rate, so you know the range. Next, you will see them one at a time.</p><div class=\"strip\">'+st.order.map(function(k){return '<img alt=\"Trail photo\" src=\"'+esc(url('photo_'+k))+'\">';}).join('')+'</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start rating</button></div></div>';\n    document.getElementById('go').onclick=function(){st.step='rate';st.k=0;save();route();};\n  }\n  function sdRow(s){var h='<div class=\"sd\"><b>'+esc(s[1])+'</b><div class=\"row\">';for(var i=7;i>=1;i--)h+='<label><input type=\"radio\" name=\"q_'+s[0]+'\" value=\"'+i+'\">'+i+'</label>';\n    return h+'</div><div class=\"ends\"><span>Extremely strong</span><span>Extremely weak</span></div></div>';}\n  function rate(){\n    var k=st.order[st.k],id='photo_'+k;\n    app.innerHTML='<div class=\"prog\">Photo '+(st.k+1)+' of '+st.order.length+'</div><div class=\"card\"><img class=\"photo\" alt=\"Fitness trail photo\" src=\"'+esc(url(id))+'\"><p style=\"color:var(--ink)\">Imagine exercising on this trail. How strong are these feelings?</p>'+SD.map(sdRow).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var v=SD.map(function(s){return val('q_'+s[0]);});if(v.some(function(x){return x==null;}))return err('Please answer all three.');\n      var sh=[files[id].name];\n      send(SD.map(function(s,i){return SPSite.answer(s[0],Number(v[i]),{key:k,shown:sh});}),this,function(){st.k++;if(st.k>=st.order.length)st.step='about';save();route();});\n    };\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+radios('trail_use').replace('class=\"f\"','class=\"f\" style=\"margin-top:0\"')+'<div class=\"f\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"110\"></div>'+radios('gender')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var u=val('trail_use'),g=val('gender'),age=Number(document.getElementById('age').value);\n      if(!u)return err('Please answer every question.');if(!(age>=18&&age<=110))return err('Please enter your age.');if(!g)return err('Please answer every question.');\n      send([SPSite.answer('trail_use',u),SPSite.answer('age',age),SPSite.answer('gender',g)],this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='choose')return choose();if(s==='browse')return browse();if(s==='rate')return rate();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','composition_choice','security','pleasure','experience','trail_use','age','gender'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('trail')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name)){files[f.name.replace(/\\.[^.]+$/,'')]=f;}});\n    var keys=COMBOS.map(function(c){return c[0];});\n    if(!keys.every(function(k){return files['photo_'+k]&&files['diagram_'+k];})){app.innerHTML='<h1>Pictures missing</h1><p>Upload the trail photos and diagrams to the media folder \"trail\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!(st&&st.order&&st.order.length===5&&st.combos))st={step:'intro',combos:shuffle(keys),order:shuffle(keys),k:0};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
