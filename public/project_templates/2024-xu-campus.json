\"text\": \"I can do the things I like to do here.\"\n       },\n       {\n        \"value\": \"com2\",\n        \"text\": \"I can get a sense of belonging here.\"\n       },\n       {\n        \"value\": \"com3\",\n        \"text\": \"I can adapt to the environment here very quickly.\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1 Strongly disagree\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5 Strongly agree\"\n       }\n      ],\n      \"description\": \"1 = strongly disagree, 5 = strongly agree. Row ids: rem remoteness, ext extensibility, cha charming, com compatibility. Keyed by the chosen type.\"\n     },\n     {\n      \"type\": \"matrix\",\n      \"name\": \"prosocial\",\n      \"title\": \"Pro-social behaviour: how much do you agree?\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"rec1\",\n        \"text\": \"I prefer to confide in each other's emotions with friends in a natural setting.\"\n       },\n       {\n        \"value\": \"rec2\",\n        \"text\": \"I would be willing to co-operate with others in a natural environment to complete an activity.\"\n       },\n       {\n        \"value\": \"rec3\",\n        \"text\": \"I would be more willing to help people in need in a natural environment.\"\n       },\n       {\n        \"value\": \"lab1\",\n        \"text\": \"I would be willing to take an active part in the waste separation campaign organized by the school.\"\n       },\n       {\n        \"value\": \"lab2\",\n        \"text\": \"I am willing to complete public welfare practical labor (e.g., planting trees, spreading knowledge, etc.) in the natural environment.\"\n       },\n       {\n        \"value\": \"lab3\",\n        \"text\": \"I am more willing to join school clubs and organizations that carry out activities in the natural environment.\"\n       },\n       {\n        \"value\": \"mor1\",\n        \"text\": \"I will not litter in the natural environment.\"\n       },\n       {\n        \"value\": \"mor2\",\n        \"text\": \"I will consciously maintain the public facilities on campus.\"\n       },\n       {\n        \"value\": \"mor3\",\n        \"text\": \"I will consciously follow the school's environmental guidelines.\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1 Strongly disagree\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5 Strongly agree\"\n       }\n      ],\n      \"description\": \"1 = strongly disagree, 5 = strongly agree. Row ids: rec social reciprocity, lab public labor, mor social morality.\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"campus-original\">{\"source\": \"Xu et al. (2024) Frontiers in Psychology 15: 1341990\", \"n\": 264, \"types\": {\"green\": {\"name\": \"Green space\", \"description\": \"Over 75% green coverage, dominated by large lawns and tall trees.\"}, \"blue\": {\"name\": \"Blue space\", \"description\": \"The landscape is mainly open water, accompanied by some plantings and waterfront facilities, and is relatively quiet.\"}, \"gray\": {\"name\": \"Gray space\", \"description\": \"Predominantly hard-paved sidewalks with more resting seating and a small amount of plantings.\"}, \"movement\": {\"name\": \"Movement space\", \"description\": \"The sports facilities are varied and are mainly lawn with a few trees.\"}}, \"restorative_by_type\": {\"green\": {\"n\": 156, \"m\": 3.963}, \"blue\": {\"n\": 71, \"m\": 3.79}, \"gray\": {\"n\": 19, \"m\": 3.632}, \"movement\": {\"n\": 18, \"m\": 3.556}}}</script>\n<style>\n:root{--bg:#f0f3ee;--card:#fff;--ink:#1d231e;--muted:#5a6359;--accent:#2f6a3c;--line:#d6ddd4;--warn:#b3261e;--sel:#dcefe0}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.trio{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:8px}\n.trio img{width:100%;aspect-ratio:3/2;object-fit:cover;display:block;border-radius:6px;background:#ddd;cursor:zoom-in}\n.pic{position:sticky;top:0;z-index:2;background:var(--bg);padding:6px 0}\n.pic .trio img{aspect-ratio:auto;max-height:18vh;object-fit:cover}\n.pic .nm{font-size:.85rem;color:var(--muted)}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\nlabel.typ{display:block}\nlabel.typ .trio{grid-template-columns:repeat(3,1fr)}\nlabel.typ .trio img{cursor:pointer}\n.qt{font-weight:600;margin:0 0 4px;color:var(--ink)}\n.it{padding:9px 0;border-top:1px solid var(--line)}\n.it .l{font-size:.95rem;margin-bottom:4px}\n.it .o{display:grid;grid-template-columns:repeat(5,1fr);gap:3px}\n.it label{display:flex;flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:6px;padding:3px 0;cursor:pointer;font-size:.8rem;color:var(--muted)}\n.it label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.it .ends{display:flex;justify-content:space-between;font-size:.75rem;color:var(--muted);margin-top:2px}\n.it.miss .o{outline:2px solid var(--warn);outline-offset:2px;border-radius:6px}\n.sec{margin-top:18px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.zoom{position:fixed;inset:0;background:rgba(0,0,0,.9);display:flex;align-items:center;justify-content:center;z-index:9;cursor:zoom-out}\n.zoom img{max-width:100vw;max-height:100vh;object-fit:contain}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photos and items: Xu, Wang, Wang, Tian, Zhang, Chen &amp; Chen (2024), Frontiers in Psychology 15: 1341990, Tables 1 and 3 (doi:10.3389/fpsyg.2024.1341990, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='campus-landscapes:state';\n  var ORIG=JSON.parse(document.getElementById('campus-original').textContent), TYPES=['green','blue','gray','movement'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function fresh(){return {step:'intro',order:shuffle(TYPES)};}\n  function imgs(t){return [1,2,3].map(function(i){return files[t+'_'+i];});}\n  function trio(t,zoom){return '<div class=\"trio\">'+imgs(t).map(function(f,i){return '<img alt=\"'+esc(ORIG.types[t].name)+' photo '+(i+1)+'\" src=\"'+esc(f.url)+'\"'+(zoom?' data-zoom=\"1\"':'')+'>';}).join('')+'</div>';}\n  function radios(q){return (q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+esc(q.name)+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');}\n  function likert(q){return (q.rows||[]).map(function(r){var nm=q.name+'__'+r.value;return '<div class=\"it\" data-n=\"'+nm+'\"><div class=\"l\">'+esc(r.text)+'</div><div class=\"o\">'+[1,2,3,4,5].map(function(v){return '<label><input type=\"radio\" name=\"'+nm+'\" value=\"'+v+'\">'+v+'</label>';}).join('')+'</div><div class=\"ends\"><span>1 = strongly disagree</span><span>5 = strongly agree</span></div></div>';}).join('');}\n  function collect(q,out){var first=null;(q.rows||[]).forEach(function(r){var nm=q.name+'__'+r.value,x=val(nm),el=app.querySelector('.it[data-n=\"'+nm+'\"]');if(x==null){el.classList.add('miss');if(!first)first=el;}else out[r.value]=Number(x);});return first;}\n  function intro(){\n    app.innerHTML='<h1>Campus landscapes</h1><p>This short questionnaire is about four types of campus landscape. You will see three photos of each type, choose the type you prefer to visit, and answer some statements about it. It takes about 10 minutes.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label></div>'+\n     '<div class=\"card\"><b>'+esc(Q.gender.title)+'</b>'+radios(Q.gender)+'<div class=\"sec\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"16\" max=\"110\"></div>'+\n     '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var g=val('gender'),age=Number(document.getElementById('age').value);\n      if(!g)return err('Please choose your gender.');if(!(age>=16&&age<=110))return err('Please enter your age.');\n      send([SPSite.answer('consent',true),SPSite.answer('gender',g),SPSite.answer('age',age)],this,function(){st.step='photos';save();route();});};\n  }\n  function photos(){\n    app.innerHTML='<h2>Four types of campus landscape</h2><p>Please look at the photos of each type. Tap a photo to enlarge it.</p>'+\n     st.order.map(function(t){return '<div class=\"card\"><h2>'+esc(ORIG.types[t].name)+'</h2><p style=\"margin:0\">'+esc(ORIG.types[t].description)+'</p>'+trio(t,true)+'</div>';}).join('')+\n     '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div>';\n    document.getElementById('go').onclick=function(){st.step='choose';save();route();};\n  }\n  function choose(){\n    var all=[];st.order.forEach(function(t){imgs(t).forEach(function(f){all.push(f.name);});});\n    app.innerHTML='<div class=\"card\"><p class=\"qt\">'+esc(Q.preferred_type.title)+'</p>'+\n      st.order.map(function(t){return '<label class=\"opt typ\"><span style=\"display:flex;gap:10px;align-items:center\"><input type=\"radio\" name=\"preferred_type\" value=\"'+t+'\"> <b>'+esc(ORIG.types[t].name)+'</b></span>'+trio(t,false)+'</label>';}).join('')+'</div>'+\n      '<div class=\"card\"><p class=\"qt\">'+esc(Q.visit_frequency.title)+'</p>'+radios(Q.visit_frequency)+'<div class=\"sec\"><p class=\"qt\">'+esc(Q.visit_duration.title)+'</p>'+radios(Q.visit_duration)+'</div>'+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var t=val('preferred_type'),fq=val('visit_frequency'),du=val('visit_duration');\n      if(!t)return err('Please choose a landscape type.');if(!fq||!du)return err('Please answer how often and how long you visit.');\n      var sh=imgs(t).map(function(f){return f.name;});\n      send([SPSite.answer('type_order',st.order.join(',')),SPSite.answer('preferred_type',t,{shown:all}),SPSite.answer('visit_frequency',fq,{key:t,shown:sh}),SPSite.answer('visit_duration',du,{key:t,shown:sh})],this,function(){st.type=t;st.step='rate';save();route();});};\n  }\n  function rate(){\n    var t=st.type;\n    app.innerHTML='<div class=\"pic\"><div class=\"nm\">Your choice: '+esc(ORIG.types[t].name)+'</div>'+trio(t,true)+'</div>'+\n     '<div class=\"card\"><p class=\"qt\">'+esc(Q.perception.title)+'</p><p style=\"margin:0\">Think of the '+esc(ORIG.types[t].name.toLowerCase())+' shown above.</p>'+likert(Q.perception)+'</div>'+\n     '<div class=\"card\"><p class=\"qt\">'+esc(Q.restorative.title)+'</p>'+likert(Q.restorative)+'</div>'+\n     '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div>';\n    document.getElementById('go').onclick=function(){\n      var a={},b={},f1=collect(Q.perception,a),f2=collect(Q.restorative,b),first=f1||f2;\n      if(first){first.scrollIntoView({block:'center'});return err('Please answer every statement (the missing ones are marked).');}\n      var meta={key:t,shown:imgs(t).map(function(f){return f.name;})};\n      send([SPSite.answer('perception',a,meta),SPSite.answer('restorative',b,meta)],this,function(){st.step='prosocial';save();route();});};\n  }\n  function prosocial(){\n    app.innerHTML='<div class=\"card\"><p class=\"qt\">'+esc(Q.prosocial.title)+'</p><p style=\"margin:0\">These statements are about you.</p>'+likert(Q.prosocial)+\n     '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var a={},first=collect(Q.prosocial,a);\n      if(first){first.scrollIntoView({block:'center'});return err('Please answer every statement (the missing ones are marked).');}\n      send([SPSite.answer('prosocial',a)],this,function(){st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var r=e.target.closest&&e.target.closest('.it');if(r){r.classList.remove('miss');if(!app.querySelector('.it.miss'))err('');}});\n  app.addEventListener('click',function(e){var im=e.target;if(im.tagName==='IMG'&&im.dataset.zoom){var z=document.createElement('div');z.className='zoom';z.innerHTML='<img alt=\"\" src=\"'+esc(im.src)+'\">';z.onclick=function(){z.remove();};document.body.appendChild(z);}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='photos')return photos();if(s==='choose')return choose();if(s==='rate')return rate();if(s==='prosocial')return prosocial();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','gender','age','type_order','preferred_type','visit_frequency','visit_duration','perception','restorative','prosocial'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};Q[n].name=Q[n].name||n;});\n    (SPSite.getMedia('campus')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=[];TYPES.forEach(function(t){[1,2,3].forEach(function(i){if(!files[t+'_'+i])need.push(t+'_'+i);});});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"campus\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.order)||a.consent!==true)st=fresh();\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
