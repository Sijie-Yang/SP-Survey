 "config": {
  "pages": [
   {
    "name": "research_objective",
    "title": "Research Objective",
    "elements": [],
    "description": "The purpose of this survey is to investigate how urban greenery affects perceptions of streetscapes, including aesthetic appeal, environmental benefits, and personal preferences. We aim to understand the impact of greenery on urban street environments."
   },
   {
    "name": "introduction",
    "title": "Introduction",
    "elements": [],
    "description": "Welcome to the Urban Greenery Perception Survey. This study aims to explore the psychological and functional impacts of urban greenery on residents across various environments. Your insights will aid in enhancing urban design and planning."
   },
   {
    "name": "theoretical_context",
    "title": "Theoretical Context",
    "elements": [],
    "description": "Urban greenery plays a crucial role in enhancing the quality of life in cities. Concepts from urban ecology and environmental psychology suggest that greenery can improve mental health, increase biodiversity, and enhance urban aesthetics."
   },
   {
    "name": "demographics",
    "title": "Demographics",
    "elements": [
     {
      "max": 100,
      "min": 10,
      "name": "age",
      "step": 1,
      "type": "text",
      "title": "What is your age?",
      "inputType": "number",
      "isRequired": false
     },
     {
      "name": "gender",
      "type": "radiogroup",
      "title": "What is your gender?",
      "choices": [
       "Male",
       "Female",
       "Other",
       "Prefer not to say"
      ]
     },
     {
      "name": "education",
      "type": "dropdown",
      "title": "What is your highest level of education?",
      "choices": [
       "High school",
       "Bachelor's",
       "Master's",
       "PhD",
       "Other"
      ]
     },
     {
      "name": "transport",
      "type": "checkbox",
      "title": "What modes of transportation do you use? (select all that apply)",
      "choices": [
       "Walk",
       "Bike",
       "Bus",
       "Car",
       "Subway",
       "Other"
      ]
     },
     {
      "name": "urban_area",
      "type": "dropdown",
      "title": "Which type of urban area do you reside in?",
      "choices": [
       "City center",
       "Suburb",
       "Rural area",
       "Other"
      ]
     }
    ],
    "description": "To help us understand the diversity of our participants, please provide some information about yourself."
   },
   {
    "name": "sampling_strategy",
    "title": "Sampling Strategy",
    "elements": [],
    "description": "We plan to gather perspectives from a diverse range of urban environments. Participants will be recruited using online platforms and community outreach, stratified by urban area types to ensure a representative sample."
   },
   {
    "name": "greenery_psychological_impact",
    "title": "Psychological Impact of Urban Greenery",
    "elements": [
     {
      "name": "stress_reduction",
      "type": "rating",
      "title": "On a scale of 1-5, how does urban greenery in your area contribute to your stress reduction?",
      "rateMax": 5,
      "rateMin": 1,
      "maxRateDescription": "Significant impact",
      "minRateDescription": "No impact"
     },
     {
      "name": "mood_enhancement_frequency",
      "type": "radiogroup",
      "title": "How frequently do you feel that greenery in urban areas enhances your mood?",
      "choices": [
       "Daily",
       "Weekly",
       "Rarely",
       "Never"
      ]
     }
    ],
    "description": "Evaluate how urban greenery impacts your psychological well-being."
   },
   {
    "name": "greenery_perception",
    "title": "Perception of Urban Greenery",
    "elements": [
     {
      "name": "beauty_rating",
      "type": "imagerating",
      "title": "How visually pleasing do you find these streets due to greenery?",
      "choices": [],
      "rateMax": 5,
      "rateMin": 1,
      "imageCount": 3,
      "imageSelectionMode": "curated",
      "maxRateDescription": "Very pleasing",
      "minRateDescription": "Not pleasing",
      "randomImageSelection": true,
      "excludePreviouslyUsedImages": true
     },
     {
      "name": "greenery_preference",
      "type": "imagepicker",
      "title": "Which street do you prefer based on greenery?",
      "choices": [],
      "imageCount": 4,
      "multiSelect": false,
      "imageSelectionMode": "curated",
      "randomImageSelection": true,
      "excludePreviouslyUsedImages": true
     },
     {
      "name": "green_space_rank",
      "type": "imageranking",
      "title": "Rank these streets from most to least green:",
      "choices": [],
      "imageCount": 4,
      "imageSelectionMode": "curated",
      "randomImageSelection": true,
      "excludePreviouslyUsedImages": true
     }
    ],
    "description": "Evaluate these street environments based on the presence and impact of greenery."
   },
   {
    "name": "greenery_functional_benefits",
    "title": "Functional Benefits of Urban Greenery",
    "elements": [
     {
      "name": "greenery_criteria",
      "rows": [
       "Safety",
       "Beauty",
       "Walkability",
       "Satisfaction"
      ],
      "type": "imagematrix",
      "title": "Rate these streets based on these criteria:",
      "choices": [],
      "columns": [
       "1",
       "2",
       "3",
       "4",
       "5"
      ],
      "imageCount": 1,
      "imageLinks": [],
      "imageSelectionMode": "curated",
      "randomImageSelection": true,
      "excludePreviouslyUsedImages": true
     },
     {
      "name": "functional_effectiveness",
      "type": "rating",
      "title": "Rate the effectiveness of urban greenery in providing shading and noise reduction.",
      "rateMax": 5,
      "rateMin": 1,
      "maxRateDescription": "Very effective",
      "minRateDescription": "Not effective"
     }
    ],
    "description": "Evaluate how urban greenery provides functional benefits in these streets."
   },
   {
    "name": "greenery_awareness",
    "title": "Awareness of Urban Greenery Benefits",
    "elements": [
     {
      "name": "psychological_benefits_awareness",
      "type": "rating",
      "title": "On a scale of 1 to 5, how aware are you of the psychological benefits provided by urban greenery in your environment?",
      "rateMax": 5,
      "rateMin": 1,
      "maxRateDescription": "Very aware",
      "minRateDescription": "Not aware"
     },
     {
      "name": "types_of_greenery_awareness",
      "type": "checkbox",
      "title": "Which types of greenery are you aware of in your urban environment? (select all that apply)",
      "choices": [
       "Trees",
       "Shrubs",
       "Gardens",
       "Green walls",
       "Rooftop gardens",
       "None"
      ]
     },
     {
      "name": "personal_engagement",
      "type": "radiogroup",
      "title": "How often do you engage with green spaces in your area?",
      "choices": [
       "Daily",
       "Weekly",
       "Monthly",
       "Rarely",
       "Never"
      ]
     }
    ],
    "description": "Assess your awareness of the benefits provided by urban greenery."
   },
   {
    "name": "greenery_impact",
    "title": "Impact of Greenery",
    "elements": [
     {
      "name": "environmental_benefits",
      "type": "likert",
      "title": "To what extent do you agree that these streets improve air quality and temperature regulation due to greenery?",
      "choices": [
       "Strongly disagree",
       "Disagree",
       "Neutral",
       "Agree",
       "Strongly agree"
      ]
     }
    ],
    "description": "Assess how urban greenery impacts your perception of these streets."
   },
   {
    "name": "streetscape_design_elements",
    "title": "Streetscape Design Elements",
    "elements": [
     {
      "name": "tree_placement",
      "type": "imagerating",
      "title": "How effective is the tree placement in enhancing the street's aesthetic appeal?",
      "choices": [],
      "rateMax": 5,
      "rateMin": 1,
      "imageCount": 2,
      "imageSelectionMode": "curated",
      "maxRateDescription": "Very effective",
      "minRateDescription": "Not effective",
      "randomImageSelection": true,
      "excludePreviouslyUsedImages": true
     },
     {
      "name": "pedestrian_pathways",
      "type": "imagerating",
      "title": "How do pedestrian pathways integrate with greenery in these streets?",
      "choices": [],
      "rateMax": 5,
      "rateMin": 1,
      "imageCount": 2,
      "imageSelectionMode": "curated",
      "maxRateDescription": "Excellent integration",
      "minRateDescription": "Poor integration",
      "randomImageSelection": true,
      "excludePreviouslyUsedImages": true
     }
    ],
    "description": "Evaluate specific streetscape design elements and their impact on your perception."
   },
   {
    "name": "specific_greenery_assessment",
    "title": "Detailed Greenery Assessment",
    "elements": [
     {
      "name": "street_view_1",
      "type": "image",
      "choices": [],
      "imageUrl": "curated",
      "imageSelectionMode": "curated",
      "randomImageSelection": true,
      "excludePreviouslyUsedImages": true
     },
     {
      "name": "thermal_comfort",
      "type": "radiogroup",
      "title": "How comfortable is the thermal environment in this street?",
      "choices": [
       "Very cold",
       "Cold",
       "Neutral",
       "Hot",
       "Very hot"
      ]
     },
     {
      "name": "describe_street",
      "type": "comment",
      "title": "Describe what you see in this street and any emotional benefits you associate with it:"
     },
     {
      "name": "personal_experience",
      "type": "comment",
      "title": "Please describe a personal experience where urban greenery significantly impacted your well-being."
     },
     {
      "name": "suggestions",
      "type": "comment",
      "title": "What improvements would you suggest for the integration of greenery in urban areas?"
     }
    ],
    "description": "Provide detailed feedback on specific street environments."
   },
   {
    "name": "conclusion",
    "title": "Conclusion",
    "elements": [
     {
      "name": "feedback",
      "type": "comment",
      "title": "Any additional comments or feedback?"
     }
    ],
    "description": "Thank you for participating in our survey."
   }
