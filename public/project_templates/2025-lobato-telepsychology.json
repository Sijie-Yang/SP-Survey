   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Online Therapy Spaces</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Telepsychology Spaces: Background, Decoration, Colour and Therapist Choices\",\n  \"description\": \"Potential users of online psychological therapy make seven quick visual choices: preferred therapist sex; preferred colour (nine counselling-room colours); one of three video-call backgrounds rising in complexity and naturalness; dressed-up vs casual female and male therapist figures; and high vs low naturalness and high vs low complexity decoration. The time to each choice is recorded. Rebuilt from Lobato Rincón, Medina Sánchez & Tovar Bordón (2025), Vision 9(2): 43, with the paper's Figure 1–3 images and Table 1 colours (CC BY 4.0). Analysis as in the paper: choice shares by age group, gender, education and therapy experience (chi-square), response times by option (ANOVA, responses under 20 s), decision trees / logistic regression for each choice.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"tele\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I am 18 or older and agree to take part in this study.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"woman\",\n        \"text\": \"Woman\"\n       },\n       {\n        \"value\": \"man\",\n        \"text\": \"Man\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Highest level of studies\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"primary\",\n        \"text\": \"Primary\"\n       },\n       {\n        \"value\": \"secondary\",\n        \"text\": \"Secondary\"\n       },\n       {\n        \"value\": \"post_secondary\",\n        \"text\": \"Post-secondary\"\n       },\n       {\n        \"value\": \"university\",\n        \"text\": \"University\"\n       }\n      ],\n      \"description\": \"Categories from the paper's Table 2.\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"previous_therapy\",\n      \"title\": \"Have you ever received psychological therapy?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"therapy_interest\",\n      \"title\": \"How interested are you in receiving psychological therapy in the near future?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"none\",\n        \"text\": \"None\"\n       },\n       {\n        \"value\": \"low\",\n        \"text\": \"Low\"\n       },\n       {\n        \"value\": \"indifferent\",\n        \"text\": \"Indifferent\"\n       },\n       {\n        \"value\": \"some\",\n        \"text\": \"Some\"\n       },\n       {\n        \"value\": \"high\",\n        \"text\": \"High\"\n       }\n      ],\n      \"description\": \"Levels from the paper's Table 2; wording of the question mine.\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"device\",\n      \"title\": \"Which device are you using?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"phone\",\n        \"text\": \"Mobile phone\"\n       },\n       {\n        \"value\": \"tablet\",\n        \"text\": \"Tablet\"\n       },\n       {\n        \"value\": \"computer\",\n        \"text\": \"Computer\"\n       }\n      ],\n      \"description\": \"The paper reports that 88.7% answered on a mobile phone; wording mine.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"choices\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"therapist_sex\",\n      \"title\": \"Would you prefer a female or a male therapist?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"indifferent\",\n        \"text\": \"Indifferent\"\n       }\n      ],\n      \"description\": \"Paper's question 1 ('preference about the therapist's sex'); wording mine, options from the Results.\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"color\",\n      \"title\": \"Which colour would you prefer for the setting of an online therapy session?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"cerulean\",\n        \"text\": \"Cerulean (#0094de)\"\n       },\n       {\n        \"value\": \"medium_purple\",\n        \"text\": \"Medium purple (#ae47e0)\"\n       },\n       {\n        \"value\": \"boulder\",\n        \"text\": \"Boulder (#777777)\"\n       },\n       {\n        \"value\": \"lochmara\",\n        \"text\": \"Lochmara (#007cde)\"\n       },\n       {\n        \"value\": \"observatory\",\n        \"text\": \"Observatory (#028e74)\"\n       },\n       {\n        \"value\": \"japanese_laurel\",\n        \"text\": \"Japanese laurel (#028d00)\"\n       },\n       {\n        \"value\": \"olive\",\n        \"text\": \"Olive (#8a7500)\"\n       },\n       {\n        \"value\": \"tia_maria\",\n        \"text\": \"Tia maria (#d73c0c)\"\n       },\n       {\n        \"value\": \"cabaret\",\n        \"text\": \"Cabaret (#ce3e79)\"\n       }\n      ],\n      \"description\": \"Paper's question 2; the nine colours of its Table 1 are shown as swatches in random order; wording mine.\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"environment\",\n      \"title\": \"Which of the following environments would you prefer if you needed online therapy?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"room_low\",\n        \"text\": \"Low complexity and naturalness (plain office, Fig. 3a)\"\n       },\n       {\n        \"value\": \"room_medium\",\n        \"text\": \"Medium complexity and naturalness (Fig. 3b)\"\n       },\n       {\n        \"value\": \"room_high\",\n        \"text\": \"High complexity and naturalness (open terrace with nature view, Fig. 3c)\"\n       }\n      ],\n      \"description\": \"Images shown side by side in random order; shown lists the left-to-right order.\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"female_appearance\",\n      \"title\": \"What (female) therapist appearance do you prefer in case you should choose one in a mental health app?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"therapist_female_dressed\",\n        \"text\": \"Dressed-up (Fig. 1a left)\"\n       },\n       {\n        \"value\": \"therapist_female_casual\",\n        \"text\": \"Casual (Fig. 1a right)\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"male_appearance\",\n      \"title\": \"What (male) therapist appearance do you prefer in case you should choose one in a mental health app?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"therapist_male_dressed\",\n        \"text\": \"Dressed-up (Fig. 1b left)\"\n       },\n       {\n        \"value\": \"therapist_male_casual\",\n        \"text\": \"Casual (Fig. 1b right)\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"decoration_naturalness\",\n      \"title\": \"Between the two options, what type of decoration would you feel most comfortable with if you needed online psychological therapy?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"decor_natural_high\",\n        \"text\": \"High naturalness: green wall (Fig. 2a)\"\n       },\n       {\n        \"value\": \"decor_natural_low\",\n        \"text\": \"Low naturalness: potted plant (Fig. 2a)\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"decoration_complexity\",\n      \"title\": \"Between the two options, what type of decoration would you feel most comfortable with if you needed online psychological therapy?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"decor_complex_high\",\n        \"text\": \"High complexity: full bookshelf (Fig. 2b)\"\n       },\n       {\n        \"value\": \"decor_complex_low\",\n        \"text\": \"Low complexity: small shelf (Fig. 2b)\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"choice_time_ms\",\n      \"title\": \"Response time per choice (ms)\",\n      \"isRequired\": false,\n      \"description\": \"Recorded by the page, not asked. Keyed by the choice question name; time from the moment all options are loaded to the click. The paper analysed only responses under 20 s.\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"tele-original\">{\"source\": \"Lobato Rincón, Medina Sánchez & Tovar Bordón (2025) Vision 9(2): 43\", \"n\": 310, \"participants\": \"Spanish adults (mean age 39, 60% women) recruited mainly through an online psychological consultation service; online questionnaire in 2023, 88.7% on mobile phones\", \"result\": \"Most were indifferent to therapist sex; few preferred a male therapist. Younger participants chose the dressed-up therapist figures, those over 50 the casual male figure. The medium complexity/naturalness background was chosen most often (clearly so by those over 39) and fastest (about 1.5 s). The high-naturalness and high-complexity decorations were preferred over their low versions; the green wall was chosen more by people without university education. Cerulean was the most popular colour (38.7%), then observatory (19.7%); reddish tia maria and cabaret were least chosen.\"}</script>\n<style>\n:root{--bg:#f2f6f8;--card:#fff;--ink:#1d2428;--muted:#5a666d;--accent:#0b7fb8;--line:#d9e2e7;--warn:#b3261e;--sel:#e2f1f9}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.q{font-weight:600;font-size:1.05rem;margin-bottom:12px}\n.opts{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}\n.opts.people{grid-template-columns:repeat(2,minmax(0,220px));justify-content:center}\n.pick{appearance:none;border:2px solid var(--line);border-radius:12px;background:#fff;padding:0;cursor:pointer;overflow:hidden;font:inherit}\n.pick:hover{border-color:var(--accent)}\n.pick img{width:100%;display:block}\n.sw{height:90px}\n.txt{padding:14px;font-weight:600}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:520px){.opts{grid-template-columns:1fr}.opts.people{grid-template-columns:repeat(2,1fr)}.opts.sw9{grid-template-columns:repeat(3,1fr)}.sw{height:70px}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Images: Lobato Rincón, Medina Sánchez &amp; Tovar Bordón (2025), Vision 9(2): 43, Figures 1–3; colours from its Table 1 (doi:10.3390/vision9020043, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='tele-spaces:state';\n  var app=document.getElementById('app'), Q={}, files={}, st=null, t0=0;\n  var COLORS=[['cerulean','#0094de'],['medium_purple','#ae47e0'],['boulder','#777777'],['lochmara','#007cde'],['observatory','#028e74'],['japanese_laurel','#028d00'],['olive','#8a7500'],['tia_maria','#d73c0c'],['cabaret','#ce3e79']];\n  var ITEMS=[['therapist_sex','text',['female','male','indifferent']],['color','color',COLORS.map(function(c){return c[0];})],['environment','img',['room_low','room_medium','room_high']],['female_appearance','img',['therapist_female_dressed','therapist_female_casual'],'people'],['male_appearance','img',['therapist_male_dressed','therapist_male_casual'],'people'],['decoration_naturalness','img',['decor_natural_high','decor_natural_low']],['decoration_complexity','img',['decor_complex_high','decor_complex_low']]];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function label(q,v){var c=(Q[q].choices||[]).filter(function(x){return x.value===v;})[0];return c?c.text:v;}\n  function intro(){\n    app.innerHTML='<h1>Online therapy spaces</h1><p>Imagine you are going to have psychological therapy by video call. First a few questions about you, then seven quick choices about the therapist and the room you would see on screen. Choose what feels right without thinking too long; we also record how long each choice takes. It takes about 4 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"110\"></div>'+['gender','education','previous_therapy','therapy_interest','device'].map(radios).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var age=Number(document.getElementById('age').value),names=['gender','education','previous_therapy','therapy_interest','device'],v=names.map(val);\n      if(!(age>=18&&age<=110))return err('Please enter your age.');if(v.some(function(x){return !x;}))return err('Please answer every question.');\n      send([SPSite.answer('age',age)].concat(names.map(function(n,i){return SPSite.answer(n,v[i]);})),this,function(){st.step='choice';st.k=0;save();route();});\n    };\n  }\n  function choice(){\n    var it=ITEMS[st.k],q=it[0],opts=st.pos[q],h='';\n    if(it[1]==='text')h=opts.map(function(o){return '<button class=\"pick txt\" data-v=\"'+o+'\">'+esc(label(q,o))+'</button>';}).join('');\n    else if(it[1]==='color')h=opts.map(function(o){var c=COLORS.filter(function(x){return x[0]===o;})[0];return '<button class=\"pick sw\" data-v=\"'+o+'\" style=\"background:'+c[1]+'\" aria-label=\"'+esc(label(q,o))+'\"></button>';}).join('');\n    else h=opts.map(function(o){return '<button class=\"pick\" data-v=\"'+o+'\"><img alt=\"Option\" src=\"'+esc(files[o].url)+'\"></button>';}).join('');\n    app.innerHTML='<div class=\"prog\">Choice '+(st.k+1)+' of '+ITEMS.length+'</div><div class=\"card\"><div class=\"q\">'+esc(Q[q].title)+'</div><div class=\"opts '+(it[3]||'')+(it[1]==='color'?' sw9':'')+'\">'+h+'</div><div class=\"err\"></div></div>';\n    var imgs=app.querySelectorAll('img'),left=imgs.length;function start(){t0=performance.now();}\n    if(!left)start();else imgs.forEach(function(im){if(im.complete){if(--left===0)start();}else im.onload=im.onerror=function(){if(--left===0)start();};});\n    app.querySelectorAll('.pick').forEach(function(b){b.onclick=function(){\n      if(!t0)return;var rt=Math.round(performance.now()-t0),v=b.dataset.v,sh=it[1]==='img'?opts.map(function(o){return files[o].name;}):undefined;\n      app.querySelectorAll('.pick').forEach(function(x){x.disabled=true;});\n      var meta=sh?{shown:sh}:undefined;\n      send([SPSite.answer(q,v,meta),SPSite.answer('choice_time_ms',rt,{key:q})],null,function(){st.k++;t0=0;if(st.k>=ITEMS.length)st.step='done';save();route();});\n    };});\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='choice')return choice();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','education','previous_therapy','therapy_interest','device','choice_time_ms'].concat(ITEMS.map(function(i){return i[0];})).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('tele')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name)){files[f.name.replace(/\\.[^.]+$/,'')]=f;}});\n    var need=[].concat.apply([],ITEMS.filter(function(i){return i[1]==='img';}).map(function(i){return i[2];}));\n    if(need.some(function(n){return !files[n];})){app.innerHTML='<h1>Images missing</h1><p>Upload the study images to the media folder \"tele\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!(st&&st.pos)){var pos={};ITEMS.forEach(function(i){pos[i[0]]=i[1]==='text'?i[2]:shuffle(i[2]);});st={step:'intro',pos:pos,k:0};}\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
