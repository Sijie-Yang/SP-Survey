   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Indoor Greenery and Restoration</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Indoor Greenery and Restoration\",\n    \"description\": \"Photographs of plants in indoor public spaces (atriums, lobbies, malls, stations, libraries) are split into fixed groups of 20. Each participant is randomly given one group and sees its 20 photographs one at a time, in a fixed order, rating each for preference and relaxation (1–5). Before the photographs: background questions and the Nature Relatedness scale (NR-6). After them: affect (I-PANAS-SF), perceived restorativeness (PRS-11) and three intention items about spaces like these. Method replication of Ma et al. (2026), Land 15(5): 741.\",\n    \"locale\": \"en\",\n    \"mediaFolders\": [\"greenery\"],\n    \"pages\": [\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" },\n        { \"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"male\", \"text\": \"Male\" }, { \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"other\", \"text\": \"Other / prefer not to say\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"birth_cohort\", \"title\": \"When were you born?\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"before_1970\", \"text\": \"Before 1970\" }, { \"value\": \"1970s\", \"text\": \"1970s\" }, { \"value\": \"1980s\", \"text\": \"1980s\" }, { \"value\": \"1990s\", \"text\": \"1990s\" }, { \"value\": \"2000s\", \"text\": \"2000s or later\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"background\", \"title\": \"Professional background\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"landscape\", \"text\": \"Landscape architecture\" }, { \"value\": \"architecture_interior\", \"text\": \"Architecture or interior design\" }, { \"value\": \"planning\", \"text\": \"Urban planning\" }, { \"value\": \"other_design\", \"text\": \"Other design-related field\" }, { \"value\": \"not_related\", \"text\": \"Not related to design\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"plant_exposure\", \"title\": \"How often are you around indoor plants?\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"rarely\", \"text\": \"Rarely\" }, { \"value\": \"1_2_month\", \"text\": \"1–2 times per month\" }, { \"value\": \"1_2_week\", \"text\": \"1–2 times per week\" }, { \"value\": \"3_4_week\", \"text\": \"3–4 times per week\" }, { \"value\": \"daily\", \"text\": \"Almost every day\" } ] },\n        { \"type\": \"matrix\", \"name\": \"nr6\", \"title\": \"For each of the following, please rate the extent to which you agree with each statement. Please respond as you really feel, rather than how you think “most people” feel.\", \"description\": \"Nature Relatedness short form NR-6 (Nisbet & Zelenski 2013, Frontiers in Psychology 4: 813). Score = mean of the six items (1–5).\", \"isRequired\": true,\n          \"rows\": [\n            { \"value\": \"nr1\", \"text\": \"My ideal vacation spot would be a remote, wilderness area.\" },\n            { \"value\": \"nr2\", \"text\": \"I always think about how my actions affect the environment.\" },\n            { \"value\": \"nr3\", \"text\": \"My connection to nature and the environment is a part of my spirituality.\" },\n            { \"value\": \"nr4\", \"text\": \"I take notice of wildlife wherever I am.\" },\n            { \"value\": \"nr5\", \"text\": \"My relationship to nature is an important part of who I am.\" },\n            { \"value\": \"nr6\", \"text\": \"I feel very connected to all living things and the earth.\" } ],\n          \"columns\": [\n            { \"value\": \"1\", \"text\": \"Disagree strongly\" }, { \"value\": \"2\", \"text\": \"Disagree a little\" }, { \"value\": \"3\", \"text\": \"Neither agree or disagree\" }, { \"value\": \"4\", \"text\": \"Agree a little\" }, { \"value\": \"5\", \"text\": \"Agree strongly\" } ] }\n      ]},\n      { \"name\": \"photographs\", \"elements\": [\n        { \"type\": \"imageslidergroup\", \"name\": \"scene_ratings\", \"title\": \"This greenery scene\", \"description\": \"One record per photograph: key = file name (gGG_PP.jpg = group GG, position PP); shown = that file. Preference = how much the participant likes the greenery scene; relaxation = how relaxed the participant feels while viewing it. Both 1–5. Image-level analysis as in the paper: linear mixed model with random intercepts for participant and photograph.\", \"imageCount\": 1, \"scaleMin\": 1, \"scaleMax\": 5, \"isRequired\": true, \"dimensions\": [\n          { \"id\": \"preference\", \"label\": \"How much do you like this greenery scene?\", \"left\": \"1 Not at all\", \"right\": \"5 Very much\", \"min\": 1, \"max\": 5, \"step\": 1 },\n          { \"id\": \"relaxation\", \"label\": \"How relaxed do you feel while looking at this image?\", \"left\": \"1 Not at all relaxed\", \"right\": \"5 Very relaxed\", \"min\": 1, \"max\": 5, \"step\": 1 }\n        ] }\n      ]},\n      { \"name\": \"afterwards\", \"elements\": [\n        { \"type\": \"matrix\", \"name\": \"panas\", \"title\": \"Thinking about how you feel right now, after viewing the photographs, to what extent do you feel…\", \"description\": \"International PANAS Short Form (I-PANAS-SF, Thompson 2007). Positive affect = mean of alert, inspired, determined, attentive, active; negative affect = mean of upset, hostile, ashamed, nervous, afraid (1–5).\", \"isRequired\": true,\n          \"rows\": [\n            { \"value\": \"upset\", \"text\": \"Upset\" }, { \"value\": \"hostile\", \"text\": \"Hostile\" }, { \"value\": \"alert\", \"text\": \"Alert\" }, { \"value\": \"ashamed\", \"text\": \"Ashamed\" }, { \"value\": \"inspired\", \"text\": \"Inspired\" },\n            { \"value\": \"nervous\", \"text\": \"Nervous\" }, { \"value\": \"determined\", \"text\": \"Determined\" }, { \"value\": \"attentive\", \"text\": \"Attentive\" }, { \"value\": \"afraid\", \"text\": \"Afraid\" }, { \"value\": \"active\", \"text\": \"Active\" } ],\n          \"columns\": [\n            { \"value\": \"1\", \"text\": \"Not at all\" }, { \"value\": \"2\", \"text\": \"A little\" }, { \"value\": \"3\", \"text\": \"Moderately\" }, { \"value\": \"4\", \"text\": \"Quite a bit\" }, { \"value\": \"5\", \"text\": \"Extremely\" } ] },\n        { \"type\": \"matrix\", \"name\": \"prs\", \"title\": \"Think of the indoor spaces with plants you have just seen. How much does each statement apply to places like these?\", \"description\": \"Perceived Restorativeness Scale PRS-11 (Pasini et al. 2014), English wording as listed by Kim et al. (2022, IJERPH 19: 10231). Being away: ba1–ba3; fascination: fa1–fa3; coherence: co1–co3; extent (scope): sc1–sc2. Dimension score = mean of its items (1–5).\", \"isRequired\": true,\n          \"rows\": [\n            { \"value\": \"ba1\", \"text\": \"Places like these are a refuge from nuisances.\" },\n            { \"value\": \"ba2\", \"text\": \"To get away from things that usually demand my attention, I like to go to places like these.\" },\n            { \"value\": \"ba3\", \"text\": \"To stop thinking about the things that I must get done, I like to go to places like these.\" },\n            { \"value\": \"fa1\", \"text\": \"Places like these are fascinating.\" },\n            { \"value\": \"fa2\", \"text\": \"In places like these, my attention is drawn to many interesting things.\" },\n            { \"value\": \"fa3\", \"text\": \"In places like these, it is hard to be bored.\" },\n            { \"value\": \"co1\", \"text\": \"There is a clear order in the physical arrangement of places like these.\" },\n            { \"value\": \"co2\", \"text\": \"In places like these, it is easy to see how things are organized.\" },\n            { \"value\": \"co3\", \"text\": \"In places like these, everything seems to have its proper place.\" },\n            { \"value\": \"sc1\", \"text\": \"Places like these are large enough to allow exploration in many directions.\" },\n            { \"value\": \"sc2\", \"text\": \"In places like these, there are few boundaries to limit my possibility for moving about.\" } ],\n          \"columns\": [\n            { \"value\": \"1\", \"text\": \"Not at all\" }, { \"value\": \"2\", \"text\": \"A little\" }, { \"value\": \"3\", \"text\": \"Moderately\" }, { \"value\": \"4\", \"text\": \"Quite a lot\" }, { \"value\": \"5\", \"text\": \"Completely\" } ] },\n        { \"type\": \"matrix\", \"name\": \"intention\", \"title\": \"After seeing these photographs, how much do you agree?\", \"description\": \"Behavioural intention, three items (recommend, stay, use), 1–5; score = mean.\", \"isRequired\": true,\n          \"rows\": [\n            { \"value\": \"recommend\", \"text\": \"I would recommend indoor spaces with greenery like these to others.\" },\n            { \"value\": \"stay\", \"text\": \"I would like to stay longer in indoor spaces with greenery like these.\" },\n            { \"value\": \"use\", \"text\": \"I would choose to use indoor spaces with greenery like these when I can.\" } ],\n          \"columns\": [\n            { \"value\": \"1\", \"text\": \"Strongly disagree\" }, { \"value\": \"2\", \"text\": \"Disagree\" }, { \"value\": \"3\", \"text\": \"Neutral\" }, { \"value\": \"4\", \"text\": \"Agree\" }, { \"value\": \"5\", \"text\": \"Strongly agree\" } ] }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f1f4ef;--card:#fff;--ink:#1b211c;--muted:#58635a;--accent:#2f6b45;--accent-ink:#fff;--line:#d3dbd3;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:24px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:8px 0 14px}.progress>i{display:block;height:100%;background:var(--accent)}\n.view{background:#161a17;border-radius:12px;overflow:hidden;display:flex;align-items:center;justify-content:center;aspect-ratio:3/2;max-height:60vh;margin:0 auto}\n.view img{width:100%;height:100%;object-fit:contain;display:block}\n.item{margin-top:14px}.item b{display:block;font-weight:600;margin-bottom:6px}\n.scale{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}\n.scale button,.opts button{appearance:none;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:9px;padding:9px 2px;font:inherit;cursor:pointer;min-width:0}\n.scale button{font-weight:700}\n.scale button.on,.opts button.on{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}\n.ends{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-top:3px}\n.mx{margin-top:14px;padding-top:12px;border-top:1px solid var(--line)}.mx:first-child{border-top:0;padding-top:0;margin-top:0}.mx b{display:block;font-weight:600;margin-bottom:6px}\n.opts{display:grid;grid-template-columns:repeat(5,1fr);gap:5px}.opts button{font-size:.8rem;line-height:1.2;padding:7px 3px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:16px}.q:first-child{margin-top:0}.q>b{display:block;margin-bottom:4px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.src{font-size:.75rem;color:var(--muted);margin-top:6px;word-break:break-word}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Wikimedia Commons, author and licence shown under each photograph (CC0, CC BY or CC BY-SA). They are not the original study's images. NR-6: Nisbet &amp; Zelenski (2013), CC BY. PRS-11 English wording: Kim et al. (2022), IJERPH, CC BY.</footer>\n<script>\n(function(){\n  var CREDITS={\"g01_01.jpg\": \"Andre Carrotflower, Wikimedia Commons (CC BY-SA 4.0)\", \"g01_02.jpg\": \"Olybrius, Wikimedia Commons (CC0)\", \"g01_03.jpg\": \"Daniel Lu (User:dllu), Wikimedia Commons (CC BY-SA 4.0)\", \"g01_04.jpg\": \"CEllisHH, Wikimedia Commons (CC BY-SA 4.0)\", \"g01_05.jpg\": \"WiNG, Wikimedia Commons (CC BY 3.0)\", \"g01_06.jpg\": \"w_lemay, Wikimedia Commons (CC BY-SA 2.0)\", \"g01_07.jpg\": \"Alpha, Wikimedia Commons (CC BY-SA 2.0)\", \"g01_08.jpg\": \"Mnhomeoffice, Wikimedia Commons (CC BY-SA 4.0)\", \"g01_09.jpg\": \"Rodrigo.Argenton, Wikimedia Commons (CC BY-SA 4.0)\", \"g01_10.jpg\": \"Robert Skolmen Bobskol854, Wikimedia Commons (CC BY-SA 3.0)\", \"g01_11.jpg\": \"Julian Lupyan, Wikimedia Commons (CC0)\", \"g01_12.jpg\": \"vanhookc, Wikimedia Commons (CC BY-SA 2.0)\", \"g01_13.jpg\": \"Ravens freak0624, Wikimedia Commons (CC BY-SA 4.0)\", \"g01_14.jpg\": \"WiNG, Wikimedia Commons (CC BY 3.0)\", \"g01_15.jpg\": \"Matěj Baťha, Wikimedia Commons (CC BY-SA 3.0)\", \"g01_16.jpg\": \"Daniel Lu (User:dllu), Wikimedia Commons (CC BY-SA 4.0)\", \"g01_17.jpg\": \"Deerpeter, Wikimedia Commons (CC BY-SA 4.0)\", \"g01_18.jpg\": \"ACBahn, Wikimedia Commons (CC BY 3.0)\", \"g01_19.jpg\": \"Andrés Franchi Ugart…, Wikimedia Commons (CC BY-SA 3.0)\", \"g01_20.jpg\": \"SteveBDel, Wikimedia Commons (Public domain)\"}; // file name -> photo credit (author, licence, Commons file)\n  var app=document.getElementById('app'), Q={}, groups={}, st=null, done={}, ABOUT=['gender','birth_cohort','background','plant_exposure'];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem('ma2026green:state',JSON.stringify(st));}catch(e){}}\n  function radios(n){return (Q[n].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');}\n  function list(){return groups[st.group]||[];}\n  function matrixHtml(q){return (q.rows||[]).map(function(r){return '<div class=\"mx\"><b>'+esc(r.text)+'</b><div class=\"opts\">'+(q.columns||[]).map(function(c){return '<button data-r=\"'+esc(r.value)+'\" data-c=\"'+esc(c.value)+'\">'+esc(c.text)+'</button>';}).join('')+'</div></div>';}).join('');}\n  function bindMatrix(vals){app.querySelectorAll('.opts button').forEach(function(x){x.onclick=function(){vals[x.getAttribute('data-r')]=x.getAttribute('data-c');x.parentNode.querySelectorAll('button').forEach(function(y){y.classList.toggle('on',y===x);});err('');};});}\n  function intro(){\n    var gs=Object.keys(groups);\n    if(!gs.length){app.innerHTML='<h1>Photographs missing</h1><p>Upload the photographs to the media folder “greenery”, named gGG_PP.jpg (group GG, position PP).</p>';return;}\n    app.innerHTML='<h1>Plants in indoor spaces</h1><p>You will see 20 photographs of indoor public spaces with plants, one at a time. For each, say how much you like the scene and how relaxed you feel looking at it. Before and after the photographs there are a few short questions. About 10 minutes.</p>'+\n      '<div class=\"card\">'+ABOUT.map(function(n){return '<div class=\"q\"><b>'+esc(Q[n].title)+'</b>'+radios(n)+'</div>';}).join('')+'</div>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var vals={},miss=ABOUT.filter(function(n){var r=app.querySelector('input[name='+n+']:checked');if(r)vals[n]=r.value;return !r;});\n      if(miss.length)return err('Please answer: '+miss.map(function(n){return Q[n].title;}).join('; '));\n      var b=this;b.disabled=true;var calls=[SPSite.answer('consent',true)];ABOUT.forEach(function(n){calls.push(SPSite.answer(n,vals[n]));});\n      Promise.all(calls).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}st.stage='nr6';save();route();});\n    };\n  }\n  function matrixPage(name,heading,lead,after){\n    var q=Q[name], vals={};\n    app.innerHTML='<h1>'+esc(heading)+'</h1>'+(lead?'<p>'+esc(lead)+'</p>':'')+'<p style=\"color:var(--ink)\"><b>'+esc(q.title)+'</b></p><div class=\"card\">'+matrixHtml(q)+'</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"nx\">Next</button></div><div class=\"err\"></div>';\n    bindMatrix(vals);\n    document.getElementById('nx').onclick=function(){\n      var left=(q.rows||[]).filter(function(r){return vals[r.value]==null;}).length;\n      if(left)return err('Please answer every statement ('+left+' left).');\n      var bt=this;bt.disabled=true;\n      SPSite.answer(name,vals).then(function(r){if(!ok(r)){bt.disabled=false;return err(r.error);}window.scrollTo(0,0);after();});\n    };\n  }\n  function photo(){\n    var L=list(), i=0;while(i<L.length&&done[L[i].name])i++;\n    if(i>=L.length){st.stage='panas';save();return route();}\n    var f=L[i], vals={}, dims=Q.scene_ratings.dimensions||[];\n    var nf=L[i+1];if(nf){var pre=new Image();pre.src=nf.url;}\n    app.innerHTML='<p>Photograph '+(i+1)+' of '+L.length+'</p><div class=\"progress\"><i style=\"width:'+(100*i/L.length)+'%\"></i></div>'+\n      '<div class=\"view\"><img alt=\"Indoor space with plants\" src=\"'+esc(f.url)+'\"></div>'+(CREDITS[f.name]?'<div class=\"src\">Photo: '+esc(CREDITS[f.name])+'</div>':'')+\n      '<div class=\"card\">'+dims.map(function(d){var b='';for(var v=1;v<=5;v++)b+='<button data-d=\"'+esc(d.id)+'\" data-v=\"'+v+'\" aria-label=\"'+esc(d.label)+' '+v+'\">'+v+'</button>';return '<div class=\"item\"'+(d===dims[0]?' style=\"margin-top:0\"':'')+'><b>'+esc(d.label)+'</b><div class=\"scale\">'+b+'</div><div class=\"ends\"><span>'+esc(d.left)+'</span><span>'+esc(d.right)+'</span></div></div>';}).join('')+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"nx\">Next</button></div><div class=\"err\"></div></div>';\n    app.querySelectorAll('.scale button').forEach(function(x){x.onclick=function(){vals[x.getAttribute('data-d')]=Number(x.getAttribute('data-v'));x.parentNode.querySelectorAll('button').forEach(function(y){y.classList.toggle('on',y===x);});err('');};});\n    document.getElementById('nx').onclick=function(){\n      if(dims.some(function(d){return vals[d.id]==null;}))return err('Please answer both questions.');\n      var bt=this;bt.disabled=true;\n      SPSite.answer('scene_ratings',vals,{key:f.name,shown:[f.name]}).then(function(r){if(!ok(r)){bt.disabled=false;return err(r.error);}done[f.name]=true;window.scrollTo(0,0);photo();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){if(m.some(function(x){return ABOUT.indexOf(x)>=0||x==='consent';}))intro();else{st.stage=m.indexOf('nr6')>=0?'nr6':m.indexOf('scene_ratings')>=0?'photos':m.indexOf('panas')>=0?'panas':m.indexOf('prs')>=0?'prs':'intention';save();route();}},1800);}else{try{localStorage.removeItem('ma2026green:state');}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){\n    var s=st.stage;\n    if(s==='nr6')return matrixPage('nr6','You and nature','',function(){st.stage='photos';save();route();});\n    if(s==='photos')return photo();\n    if(s==='panas')return matrixPage('panas','How you feel now','',function(){st.stage='prs';save();route();});\n    if(s==='prs')return matrixPage('prs','The spaces you saw','',function(){st.stage='intention';save();route();});\n    if(s==='intention')return matrixPage('intention','Last questions','',function(){st.stage='end';save();finish();});\n    if(s==='end')return finish();\n    intro();\n  }\n  SPSite.onReady(function(ctx){\n    ['consent','nr6','scene_ratings','panas','prs','intention'].concat(ABOUT).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('greenery')||[]).forEach(function(f){var m=/^g(\\d+)_(\\d+)\\.(jpe?g|png|webp)$/i.exec(f.name);if(!m)return;var g=String(Number(m[1]));(groups[g]=groups[g]||[]).push({name:f.name,url:f.url,pos:Number(m[2])});});\n    Object.keys(groups).forEach(function(g){groups[g].sort(function(a,b){return a.pos-b.pos;});});\n    try{st=JSON.parse(localStorage.getItem('ma2026green:state'));}catch(e){st=null;}\n    var gs=Object.keys(groups), a=(ctx&&ctx.answers)||{}, tr=(a.scene_ratings&&Array.isArray(a.scene_ratings.trials))?a.scene_ratings.trials:[];\n    tr.forEach(function(x){if(x&&x.key!=null&&x.value!=null)done[String(x.key)]=true;});\n    var fromAns=null;Object.keys(done).forEach(function(k){var m=/^g(\\d+)_/.exec(k);if(m)fromAns=String(Number(m[1]));});\n    if(!st||typeof st!=='object')st={};\n    if(fromAns&&groups[fromAns])st.group=fromAns;\n    if(!st.group||!groups[st.group])st.group=gs.length?gs[Math.floor(Math.random()*gs.length)]:null; // one group per participant, chosen at random (as in the paper)\n    if(a.consent!==true)st.stage='intro';\n    else if(!st.stage||st.stage==='intro')st.stage=a.nr6?(Object.keys(done).length?'photos':'photos'):'nr6';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
