   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Balancing two lines in a frame (Puffer 1903)</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\"format\":\"sp-scheme-package\",\"spScheme\":\"2.0\",\"survey\":{\"title\":\"Balancing two lines in a frame (Puffer 1903)\",\"description\":\"Puffer's 1903 experiment on symmetry in composition: on a dark picture field, one white line is fixed at a given distance from the centre; slide a second line to the position that is most pleasing.\",\"locale\":\"en\",\"pages\":[\n{\"name\":\"intro\",\"elements\":[{\"type\":\"boolean\",\"name\":\"consent\",\"title\":\"I agree to take part. My answers are recorded anonymously for research.\",\"isRequired\":true}]},\n{\"name\":\"exp_ia\",\"elements\":[{\"type\":\"custom\",\"name\":\"exp_ia\",\"title\":\"Experiment I (a): fixed short line (80 × 10 mm), movable long line (160 × 10 mm)\",\"isRequired\":true,\"description\":\"Value: array of five settings, one per position of the fixed line F = 40, 80, 120, 160, 200 mm from the centre (in that order, as in the original). Each setting = {f: F in mm, side: side of the frame where F stood ('left'|'right'), v: position of the movable line in mm from the centre, positive = opposite side to F, negative = same side as F (Puffer's minus sign), or v: 'X' when the participant found no pleasing position (Puffer's X), start: where the movable line started}. Field 600 × 400 mm as in the original. Compare with Puffer's types of choice (pp. 501–503).\"}]},\n{\"name\":\"exp_ib\",\"elements\":[{\"type\":\"custom\",\"name\":\"exp_ib\",\"title\":\"Experiment I (b): fixed long line (160 × 10 mm), movable short line (80 × 10 mm)\",\"isRequired\":true,\"description\":\"Value: as for exp_ia, with the long line fixed and the short line movable.\"}]},\n{\"name\":\"about\",\"elements\":[\n{\"type\":\"radiogroup\",\"name\":\"gender\",\"title\":\"Your gender\",\"isRequired\":true,\"choices\":[{\"value\":\"female\",\"text\":\"Female\"},{\"value\":\"male\",\"text\":\"Male\"},{\"value\":\"other\",\"text\":\"Other / prefer not to say\"}]},\n{\"type\":\"radiogroup\",\"name\":\"age\",\"title\":\"Your age\",\"isRequired\":true,\"choices\":[{\"value\":1,\"text\":\"Under 18\"},{\"value\":2,\"text\":\"18–24\"},{\"value\":3,\"text\":\"25–39\"},{\"value\":4,\"text\":\"40–59\"},{\"value\":5,\"text\":\"60 or older\"}]},\n{\"type\":\"radiogroup\",\"name\":\"art_training\",\"title\":\"Have you had training in art, design or architecture?\",\"isRequired\":true,\"choices\":[{\"value\":\"yes\",\"text\":\"Yes\"},{\"value\":\"no\",\"text\":\"No\"}]}]}]}}\n</script>\n<style>\n:root{--bg:#f1efea;--card:#fff;--ink:#1d1e21;--muted:#5d6066;--accent:#3c5a4a;--accent-ink:#fff;--line:#d9d6cf;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:20px 16px 40px}h1{font-size:1.3rem;margin:0 0 8px}p{margin:0 0 10px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}.btn:disabled{opacity:.4;cursor:not-allowed}\n.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent)}\n.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;align-items:center}\n.frame{background:#8d8b87;padding:3.5%;border-radius:4px;max-width:720px;margin:0 auto}\n.field{position:relative;background:#050505;aspect-ratio:3/2;touch-action:none;user-select:none;-webkit-user-select:none;cursor:ew-resize;overflow:hidden}\n.bar{position:absolute;background:#f4f1ea;transform:translate(-50%,-50%);top:50%}\n.bar.v{box-shadow:0 0 0 1px rgba(255,255,255,.08)}\n.step{display:inline-block;padding:2px 10px;border-radius:999px;background:#e3ebe5;color:#2f4a3c;font-size:.85rem;font-weight:600;margin-bottom:8px}\n.prog{font-size:.9rem;color:var(--muted);margin-top:8px;text-align:center}\nlabel.o{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:14px}.q>b{display:block;margin-bottom:4px}.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Method: Puffer, E. D. (1903). Studies in symmetry. <i>Harvard Psychological Studies</i>, 1, 467–539 (Section III, Experiments in substitutional symmetry, B: Experiments on size). Public domain.</footer>\n<script>\n(function(){\n  var FW=600,FH=400,FPOS=[40,80,120,160,200];\n  var EXPS=[{q:'exp_ia',label:'Part 1 of 2',fixedH:80,varH:160,desc:'a short line is fixed; you move the long line'},{q:'exp_ib',label:'Part 2 of 2',fixedH:160,varH:80,desc:'a long line is fixed; you move the short line'}];\n  var app=document.getElementById('app'),A={},cur={};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function has(n){var v=A[n];return v!=null&&v!==''&&!(Array.isArray(v)&&!v.length);}\n  function next(){window.scrollTo(0,0);\n    if(A.consent!==true)return intro();\n    for(var i=0;i<EXPS.length;i++)if(!has(EXPS[i].q))return trial(i);\n    if(!has('gender')||!has('age')||!has('art_training'))return about();\n    finish();}\n  function intro(){\n    app.innerHTML='<h1>Where should the second line go?</h1><p>You will see a dark picture field in a grey frame with two white upright lines. One line stays where it is. You slide the other line left or right until the arrangement of the two lines looks <b>most pleasing</b> to you.</p><p>Do not think about whether the two lines \"balance\" like weights; just choose the position you like best for its own sake. Explore the whole field before you decide. If no position pleases you at all, you can say so. There are 10 arrangements; it takes about 5 minutes.</p><div class=\"card\"><p>'+esc(SPSite.getQuestion('consent').title)+'</p><div class=\"row\"><button class=\"btn\" id=\"yes\">I agree</button></div><div class=\"err\"></div></div>';\n    document.getElementById('yes').onclick=function(){var b=this;b.disabled=true;SPSite.answer('consent',true).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}A.consent=true;next();});};}\n  function trial(i){\n    var E=EXPS[i],res=cur[E.q]||(cur[E.q]=[]),k=res.length;\n    if(k>=FPOS.length)return save(i);\n    var f=FPOS[k],side=Math.random()<0.5?'left':'right',sgn=side==='left'?-1:1; /* field x in mm from centre, positive = right */\n    var fx=sgn*f,start=Math.round((Math.random()*(FW-40)-(FW-40)/2)),vx=start,moved=false;\n    app.innerHTML='<div class=\"card\"><span class=\"step\">'+E.label+' · arrangement '+(k+1)+' of 5</span><h1>Slide the movable line to the most pleasing position</h1><p>Here '+E.desc+'. Drag anywhere on the dark field (or use the arrow keys).</p><div class=\"frame\"><div class=\"field\" id=\"fld\" role=\"slider\" tabindex=\"0\" aria-label=\"Movable line position\"><div class=\"bar\" id=\"bf\"></div><div class=\"bar v\" id=\"bv\"></div></div></div><div class=\"prog\" id=\"pg\">Move the line to explore the field.</div><div class=\"row\"><button class=\"btn\" id=\"go\" disabled>This position pleases me most</button><button class=\"btn ghost\" id=\"no\">No position pleases me</button></div><div class=\"err\"></div></div>';\n    var fld=document.getElementById('fld'),bf=document.getElementById('bf'),bv=document.getElementById('bv'),go=document.getElementById('go'),pg=document.getElementById('pg');\n    var span=0;var lo=vx,hi=vx;\n    function place(el,x,h){el.style.left=((x+FW/2)/FW*100)+'%';el.style.width=(10/FW*100)+'%';el.style.height=(h/FH*100)+'%';}\n    function draw(){place(bf,fx,E.fixedH);place(bv,vx,E.varH);fld.setAttribute('aria-valuenow',Math.round(vx));\n      span=hi-lo;go.disabled=span<150;pg.textContent=span<150?'Move the line to explore the field.':'Stop where the arrangement pleases you most.';}\n    function setX(cx){var r=fld.getBoundingClientRect();vx=Math.max(-FW/2+8,Math.min(FW/2-8,(cx-r.left)/r.width*FW-FW/2));lo=Math.min(lo,vx);hi=Math.max(hi,vx);draw();}\n    var drag=false;\n    fld.addEventListener('pointerdown',function(e){drag=true;fld.setPointerCapture(e.pointerId);setX(e.clientX);});\n    fld.addEventListener('pointermove',function(e){if(drag)setX(e.clientX);});\n    fld.addEventListener('pointerup',function(){drag=false;});fld.addEventListener('pointercancel',function(){drag=false;});\n    fld.addEventListener('keydown',function(e){var d=e.key==='ArrowLeft'?-1:e.key==='ArrowRight'?1:0;if(!d)return;e.preventDefault();vx=Math.max(-FW/2+8,Math.min(FW/2-8,vx+d*(e.shiftKey?10:2)));lo=Math.min(lo,vx);hi=Math.max(hi,vx);draw();});\n    draw();\n    function rec(v){res.push({f:f,side:side,v:v,start:Math.round(-sgn*start)});trial(i);}\n    go.onclick=function(){rec(Math.round(-sgn*vx));};\n    document.getElementById('no').onclick=function(){rec('X');};}\n  function save(i){var E=EXPS[i];app.innerHTML='<div class=\"card\"><p>Saving…</p><div class=\"err\"></div></div>';\n    SPSite.answer(E.q,cur[E.q].slice(),{shown:FPOS.map(function(f,k){return 'F'+f+'@'+cur[E.q][k].side;})}).then(function(r){if(!ok(r)){cur[E.q]=[];app.innerHTML='<div class=\"card\"><p>Could not save this part.</p><div class=\"row\"><button class=\"btn\" id=\"re\">Try this part again</button></div><div class=\"err\"></div></div>';err(r.error);document.getElementById('re').onclick=function(){trial(i);};return;}A[E.q]=cur[E.q].slice();next();});}\n  function about(){var names=['gender','age','art_training'],h='<h1>About you</h1><div class=\"card\">';\n    names.forEach(function(n){var q=SPSite.getQuestion(n);h+='<div class=\"q\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"o\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';});\n    app.innerHTML=h+'<div class=\"row\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var v={};for(var k=0;k<names.length;k++){var x=app.querySelector('input[name=\"'+names[k]+'\"]:checked');if(!x)return err('Please answer: '+SPSite.getQuestion(names[k]).title);v[names[k]]=names[k]==='age'?Number(x.value):x.value;}\n      var b=this;b.disabled=true;Promise.all(names.map(function(n){return SPSite.answer(n,v[n]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}names.forEach(function(n){A[n]=v[n];});next();});};}\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>At the Harvard Psychological Laboratory, Ethel Puffer (1903) asked her subjects to do the same with strips of white card on a black field. A \"mechanical\" balance would put the larger line nearer the centre, like weights on a lever. People often did so, but just as often they chose other arrangements: mirror symmetry, both lines close to the centre, or even both lines on the same side. Puffer concluded that our pleasure in such arrangements comes from several competing tendencies, not from mechanical balance alone.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');return;}var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';});}\n  SPSite.onReady(function(ctx){A=(ctx&&ctx.answers)||{};next();});\n})();\n</script>\n</body>\n</html>\n",
