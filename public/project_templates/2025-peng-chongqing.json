   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Chongqing Pocket Parks</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Pocket Park Landscapes in Chongqing: Scenic Beauty Estimation\",\n  \"description\": \"Faithful replication of Peng & Afla (2025), Sustainability 17:2020: rate the scenic beauty of 18 photographs of six pocket parks in Dadukou District, Chongqing, on a seven-point scale (Scenic Beauty Estimation).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"parks\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"intro\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part voluntarily and know I can stop at any time.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"respondent\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"expertise\",\n      \"title\": \"Are you a landscape professional (landscape architecture, planning or a related field)?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Yes, landscape professional\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"No, non-professional\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"views\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"scenic_beauty\",\n      \"title\": \"How beautiful is the landscape in this photograph?\",\n      \"isRequired\": true,\n      \"description\": \"One trial per photograph (key sample_01 … sample_18; samples 1–3 Vegetable Commune, 4–6 Xingfuli Park, 7–9 Happy Yuli Garden, 10–12 Longqiao Pocket Park, 13–15 Huangjue Memory Park, 16–18 Steel Park, all in Dadukou District, Chongqing), shown one at a time in random order. Value: 1 = very low … 7 = very high scenic beauty. SBE: standardise each respondent's ratings (z = (R − respondent mean) / respondent SD), average per photograph, then per park.\",\n      \"min\": 1,\n      \"max\": 7,\n      \"trials\": [\n       {\n        \"id\": \"sample_01\",\n        \"sample\": 1,\n        \"park\": \"Vegetable Commune\"\n       },\n       {\n        \"id\": \"sample_02\",\n        \"sample\": 2,\n        \"park\": \"Vegetable Commune\"\n       },\n       {\n        \"id\": \"sample_03\",\n        \"sample\": 3,\n        \"park\": \"Vegetable Commune\"\n       },\n       {\n        \"id\": \"sample_04\",\n        \"sample\": 4,\n        \"park\": \"Xingfuli Park\"\n       },\n       {\n        \"id\": \"sample_05\",\n        \"sample\": 5,\n        \"park\": \"Xingfuli Park\"\n       },\n       {\n        \"id\": \"sample_06\",\n        \"sample\": 6,\n        \"park\": \"Xingfuli Park\"\n       },\n       {\n        \"id\": \"sample_07\",\n        \"sample\": 7,\n        \"park\": \"Happy Yuli Garden\"\n       },\n       {\n        \"id\": \"sample_08\",\n        \"sample\": 8,\n        \"park\": \"Happy Yuli Garden\"\n       },\n       {\n        \"id\": \"sample_09\",\n        \"sample\": 9,\n        \"park\": \"Happy Yuli Garden\"\n       },\n       {\n        \"id\": \"sample_10\",\n        \"sample\": 10,\n        \"park\": \"Longqiao Pocket Park\"\n       },\n       {\n        \"id\": \"sample_11\",\n        \"sample\": 11,\n        \"park\": \"Longqiao Pocket Park\"\n       },\n       {\n        \"id\": \"sample_12\",\n        \"sample\": 12,\n        \"park\": \"Longqiao Pocket Park\"\n       },\n       {\n        \"id\": \"sample_13\",\n        \"sample\": 13,\n        \"park\": \"Huangjue Memory Park\"\n       },\n       {\n        \"id\": \"sample_14\",\n        \"sample\": 14,\n        \"park\": \"Huangjue Memory Park\"\n       },\n       {\n        \"id\": \"sample_15\",\n        \"sample\": 15,\n        \"park\": \"Huangjue Memory Park\"\n       },\n       {\n        \"id\": \"sample_16\",\n        \"sample\": 16,\n        \"park\": \"Steel Park\"\n       },\n       {\n        \"id\": \"sample_17\",\n        \"sample\": 17,\n        \"park\": \"Steel Park\"\n       },\n       {\n        \"id\": \"sample_18\",\n        \"sample\": 18,\n        \"park\": \"Steel Park\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#eef3ec;--card:#fff;--ink:#231e18;--muted:#645a4d;--accent:#3d7a4a;--accent-ink:#fff;--line:#d3dce1;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}h2{font-size:1.1rem;margin:0 0 8px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q>b{display:block;margin-bottom:4px}.opt-note{font-weight:400;color:var(--muted);font-size:.85rem}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\ntextarea,input[type=text]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:100%;background:#fff;color:var(--ink)}\ntextarea{min-height:64px}input.num{max-width:160px}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem;font-variant-numeric:tabular-nums}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.photos{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n.photos figure{margin:0;position:relative;background:#e6e0d6;border-radius:10px;overflow:hidden;display:flex;align-items:center;justify-content:center}\n.photos figure:first-child{grid-column:1/-1}\n.photos figure.solo{grid-column:1/-1}\n.photos img{width:100%;max-height:min(46vh,440px);object-fit:contain;display:block}\n.photos figure:not(:first-child) img{max-height:min(32vh,300px)}\n.photos .lt{position:absolute;left:6px;top:6px;background:#fff;color:#000;font-weight:700;font-size:.85rem;padding:0 7px;border-radius:5px}\n.cap{font-size:.76rem;color:var(--muted);margin-top:6px}\n.seg{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}\n.pic{background:#e3e8eb;border-radius:12px;overflow:hidden}.pic img{width:100%;max-height:min(55vh,520px);object-fit:contain;display:block}\n\n.seg label{display:block;cursor:pointer}\n.seg input{position:absolute;opacity:0;pointer-events:none}\n.seg span{display:flex;align-items:center;justify-content:center;height:40px;border:1px solid var(--line);border-radius:8px;font-weight:600}\n.seg input:checked+span{background:var(--accent);border-color:var(--accent);color:#fff}\n.seg input:focus-visible+span{outline:2px solid var(--accent);outline-offset:2px}\n.anch{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);margin-top:2px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:560px){.photos{grid-template-columns:1fr}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Peng &amp; Afla (2025), Sustainability 17:2020, Supplementary Figure S1, doi:10.3390/su17052020 (CC BY 4.0). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='pocketcq2025:';\n  var app=document.getElementById('app'), Q={}, files={}, ans={}, done={}, SPEC=null, SITES=[], order=[];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function q(n){return Q[n]||{};}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function saveAll(l,b,cb){Promise.all(l.map(function(a){return SPSite.answer(a[0],a[1]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}cb();});}\n  function page(html,btn,cb){\n    app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn||'Continue')+'</button></div><div class=\"err\"></div>';\n    document.getElementById('go').onclick=cb;app.onchange=hideErr;\n  }\n  function next(){\n    window.scrollTo(0,0);\n    if(!ans.intro)return intro();\n    if(!ans.resp)return group('respondent','About you','Continue');\n    for(var i=0;i<order.length;i++){if(!done[order[i].id])return view(order[i]);}\n        finish();\n  }\n  function intro(){\n    var miss=SITES.some(function(s){return !files[s.id+'.jpg'];});\n    if(miss){app.innerHTML='<h1>Pictures missing</h1><p>Media folder parks must hold the 18 photographs sample_01.jpg … sample_18.jpg.</p>';return;}\n    page('<h1>Scenic beauty of pocket parks</h1><p>You will see 18 photographs taken in small neighbourhood (pocket) parks in Chongqing, China, one at a time in random order.</p><p>For each photograph, rate how beautiful the landscape is on a seven-point scale, where 1 means very low and 7 means very high scenic beauty. Go by your overall impression; there are no right or wrong answers and no time limit. All responses are anonymous and used only for research.</p>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      var b=this;b.disabled=true;saveAll([['consent',true]],b,function(){ans.intro=true;save('a',ans);next();});\n    });\n  }\n  function view(t){\n    var n=0;order.forEach(function(x){if(done[x.id])n++;});var f=files[t.id+'.jpg'];\n    var seg='<div class=\"seg\" role=\"radiogroup\" aria-label=\"Scenic beauty\">'+[1,2,3,4,5,6,7].map(function(v){return '<label><input type=\"radio\" name=\"score\" value=\"'+v+'\"><span>'+v+'</span></label>';}).join('')+'</div><div class=\"anch\"><span>1 = very low</span><span>7 = very high</span></div>';\n    page('<div class=\"top\"><span class=\"t\">Photograph '+(n+1)+' of '+order.length+'</span><div class=\"bar\"><i style=\"width:'+(100*n/order.length)+'%\"></i></div></div>'+\n      '<div class=\"card\"><div class=\"pic\"><img alt=\"Pocket park photograph\" src=\"'+esc(f.url)+'\"></div>'+\n      '<div class=\"q\"><b>'+esc(q('scenic_beauty').title)+'</b>'+seg+'</div></div>',n===order.length-1?'Finish':'Next photograph',function(){\n      var x=app.querySelector('input[name=score]:checked');if(!x)return err('Please choose a number from 1 to 7.');\n      var b=this;b.disabled=true;\n      SPSite.answer('scenic_beauty',Number(x.value),{key:t.id,shown:[f.name]}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}done[t.id]=true;next();});\n    });\n  }\n  var GROUPS={respondent:['expertise']};\n  function group(g,title,btn){\n    var ns=GROUPS[g];\n    var h=ns.map(function(n){var d=q(n);return '<div class=\"q\"><b>'+esc(d.title)+'</b>'+(d.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('');\n    page('<h1>'+esc(title)+'</h1><div class=\"card\">'+h+'</div>',btn,function(){\n      var l=[];for(var i=0;i<ns.length;i++){var x=app.querySelector('input[name=\"'+ns[i]+'\"]:checked');if(!x)return err('Please answer: '+q(ns[i]).title);l.push([ns[i],Number(x.value)]);}\n      var b=this;b.disabled=true;saveAll(l,b,function(){if(g==='respondent')ans.resp=true;else ans.about=true;save('a',ans);next();});\n    });\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>The photographs showed six pocket parks in Dadukou District, Chongqing, three views each. In the original study (97 valid questionnaires, 48 landscape professionals and 49 non-professionals), Happy Yuli Garden had the highest standardized scenic beauty, followed by Huangjue Memory Park and Steel Park; Longqiao Pocket Park was the only park below zero. Spatial layering, plant diversity, landscape harmony and colour richness explained most of the differences.</p><p style=\"font-size:.82rem\">Photographs: Peng, X., &amp; Afla, M. R. M. (2025). A Multi-Dimensional Assessment of Pocket Park Landscapes: Insights from Scenic Beauty Estimation and Analytic Hierarchy Process in Dadukou District, Chongqing. Sustainability 17:2020, doi:10.3390/su17052020.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')ans.intro=false;else if(x==='scenic_beauty')done={};else ans.resp=false;});save('a',ans);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={type:e.type,title:g.title||e.title,isRequired:e.isRequired,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='scenic_beauty')SITES=e.trials;});});\n    (SPSite.getMedia('parks')||[]).forEach(function(f){files[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};ans=load('a')||{};\n    var o=load('order');var ids=SITES.map(function(t){return t.id;});\n    if(!o||o.length!==ids.length||o.some(function(k){return ids.indexOf(k)<0;}))o=shuffle(ids);save('order',o);\n    order=o.map(function(k){return SITES[ids.indexOf(k)];});\n    ((a.scenic_beauty&&a.scenic_beauty.trials)||[]).forEach(function(t){if(t.key)done[t.key]=true;});\n    ans.intro=a.consent===true;ans.resp=a.expertise!=null;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
