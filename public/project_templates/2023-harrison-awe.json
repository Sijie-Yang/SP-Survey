   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Awe and Beauty in Nature Photos</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Awe and Beauty in Nature Photos\",\n    \"description\": \"14 colour photographs of natural scenes (waterfalls, mountains, clouds, rivers, sea) shown one at a time for 10 s each, in the same order for everyone, after one practice photograph. After each photograph participants answer seven items on a 1–7 scale: “Did you find this picture…” pleasing, beautiful, awe-inspiring, moving, profound, boring, and “How closely were you paying attention to the picture?”. Then a short nature-relatedness scale. Rebuilt from Harrison (2023), PeerJ 11: e14926.\",\n    \"locale\": \"en\",\n    \"mediaFolders\": [\"nature\"],\n    \"pages\": [\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" },\n        { \"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"male\", \"text\": \"Male\" }, { \"value\": \"other\", \"text\": \"Other / prefer not to say\" } ] },\n        { \"type\": \"number\", \"name\": \"age\", \"title\": \"Age (years)\", \"min\": 18, \"max\": 99, \"isRequired\": true }\n      ]},\n      { \"name\": \"photographs\", \"elements\": [\n        { \"type\": \"imageslidergroup\", \"name\": \"photo_ratings\", \"title\": \"Did you find this picture…\", \"description\": \"One record per photograph: key = photo number in the paper's order (1–14, the file names of the authors' OSF stimuli); shown = the photograph file. Values 1–7. Pleasing = aesthetic pleasure; beautiful = beauty; aesthetic emotion = mean of awe-inspiring, moving, profound and boring (reverse-scored, 8 − value); attention = how closely the participant paid attention. The practice photograph is not recorded.\", \"imageCount\": 1, \"scaleMin\": 1, \"scaleMax\": 7, \"isRequired\": true, \"dimensions\": [\n          { \"id\": \"pleasing\", \"label\": \"Pleasing\", \"left\": \"1 Not at all\", \"right\": \"7 Very much\", \"min\": 1, \"max\": 7, \"step\": 1 },\n          { \"id\": \"beautiful\", \"label\": \"Beautiful\", \"left\": \"1 Not at all\", \"right\": \"7 Very much\", \"min\": 1, \"max\": 7, \"step\": 1 },\n          { \"id\": \"awe_inspiring\", \"label\": \"Awe-inspiring\", \"left\": \"1 Not at all\", \"right\": \"7 Very much\", \"min\": 1, \"max\": 7, \"step\": 1 },\n          { \"id\": \"moving\", \"label\": \"Moving\", \"left\": \"1 Not at all\", \"right\": \"7 Very much\", \"min\": 1, \"max\": 7, \"step\": 1 },\n          { \"id\": \"profound\", \"label\": \"Profound\", \"left\": \"1 Not at all\", \"right\": \"7 Very much\", \"min\": 1, \"max\": 7, \"step\": 1 },\n          { \"id\": \"boring\", \"label\": \"Boring\", \"left\": \"1 Not at all\", \"right\": \"7 Very much\", \"min\": 1, \"max\": 7, \"step\": 1 },\n          { \"id\": \"attention\", \"label\": \"How closely were you paying attention to the picture?\", \"left\": \"1 Not at all\", \"right\": \"7 Very closely\", \"min\": 1, \"max\": 7, \"step\": 1 }\n        ] }\n      ]},\n      { \"name\": \"about_nature\", \"elements\": [\n        { \"type\": \"matrix\", \"name\": \"nr6\", \"title\": \"For each of the following, please rate the extent to which you agree with each statement. Please respond as you really feel, rather than how you think “most people” feel.\", \"description\": \"Nature Relatedness short form NR-6 (Nisbet & Zelenski 2013, Frontiers in Psychology 4: 813, Appendix A). Score = mean of the six items (1–5).\", \"isRequired\": true,\n          \"rows\": [\n            { \"value\": \"nr1\", \"text\": \"My ideal vacation spot would be a remote, wilderness area.\" },\n            { \"value\": \"nr2\", \"text\": \"I always think about how my actions affect the environment.\" },\n            { \"value\": \"nr3\", \"text\": \"My connection to nature and the environment is a part of my spirituality.\" },\n            { \"value\": \"nr4\", \"text\": \"I take notice of wildlife wherever I am.\" },\n            { \"value\": \"nr5\", \"text\": \"My relationship to nature is an important part of who I am.\" },\n            { \"value\": \"nr6\", \"text\": \"I feel very connected to all living things and the earth.\" } ],\n          \"columns\": [\n            { \"value\": \"1\", \"text\": \"Disagree strongly\" }, { \"value\": \"2\", \"text\": \"Disagree a little\" }, { \"value\": \"3\", \"text\": \"Neither agree or disagree\" }, { \"value\": \"4\", \"text\": \"Agree a little\" }, { \"value\": \"5\", \"text\": \"Agree strongly\" } ] }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f2f3ef;--card:#fff;--ink:#1c201d;--muted:#5a625c;--accent:#3d6b4f;--accent-ink:#fff;--line:#d5dad5;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:24px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:8px 0 14px}.progress>i{display:block;height:100%;background:var(--accent)}\n.view{background:#111;border-radius:12px;overflow:hidden;display:flex;align-items:center;justify-content:center;aspect-ratio:3/2;max-height:72vh;margin:0 auto}\n.view img{width:100%;height:100%;object-fit:contain;display:block}\n.timer{height:5px;background:var(--line);border-radius:3px;overflow:hidden;margin-top:10px}.timer>i{display:block;height:100%;background:var(--accent);transition:width .2s linear}\n.item{margin-top:14px}.item b{display:block;font-weight:600;margin-bottom:6px}\n.scale{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}\n.scale button{appearance:none;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:9px;padding:9px 0;font:inherit;font-weight:700;cursor:pointer;min-width:0}\n.scale button.on{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}\n.ends{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-top:3px}\n.mx{margin-top:14px;padding-top:12px;border-top:1px solid var(--line)}.mx:first-child{border-top:0;padding-top:0;margin-top:0}.mx b{display:block;font-weight:600;margin-bottom:6px}\n.mx .opts{display:grid;grid-template-columns:repeat(5,1fr);gap:5px}\n.mx .opts button{appearance:none;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:9px;padding:7px 3px;font:inherit;font-size:.8rem;line-height:1.2;cursor:pointer;min-width:0}\n.mx .opts button.on{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:16px}.q>b{display:block;margin-bottom:4px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:120px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: the 15 stimuli Harrison (2023, PeerJ 11: e14926) selected from Pexels (pexels.com, Pexels licence) and shared on OSF (doi.org/10.17605/OSF.IO/WPXCN). NR-6 items: Nisbet &amp; Zelenski (2013), Frontiers in Psychology, CC BY.</footer>\n<script>\n(function(){\n  var VIEW=window.__VIEWMS||10000, N=14;\n  var app=document.getElementById('app'), Q={}, files={}, done={}, practiced=false;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function fname(k){return k===0?'practice.jpg':'photo_'+(k<10?'0':'')+k+'.jpg';}\n  function dims(){return Q.photo_ratings.dimensions||[];}\n  function radios(n){return (Q[n].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');}\n  function intro(){\n    var miss=[];for(var k=0;k<=N;k++)if(!files[fname(k)])miss.push(fname(k));\n    if(miss.length){app.innerHTML='<h1>Photographs missing</h1><p>Missing in folder “nature”: '+esc(miss.join(', '))+'</p>';return;}\n    app.innerHTML='<h1>Photographs of nature</h1><p>You will see 14 photographs of natural scenes, one at a time. Each photograph stays on the screen for 10 seconds; just look at it. Then you answer seven short questions about it. A practice photograph comes first. At the end there are six statements about you and nature. About 10 minutes.</p>'+\n      '<div class=\"card\"><div class=\"q\" style=\"margin-top:0\"><b>'+esc(Q.gender.title)+'</b>'+radios('gender')+'</div><div class=\"q\"><b>'+esc(Q.age.title||'Age')+'</b><input type=\"number\" id=\"age\" min=\"18\" max=\"99\" inputmode=\"numeric\"></div></div>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var g=app.querySelector('input[name=gender]:checked');if(!g)return err('Please answer: '+Q.gender.title);\n      var av=document.getElementById('age').value, age=Number(av);if(!av||!(age>=18&&age<=99))return err('Please enter your age (18–99).');\n      var b=this;b.disabled=true;\n      Promise.all([SPSite.answer('consent',true),SPSite.answer('gender',g.value),SPSite.answer('age',age)]).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}next();});\n    };\n  }\n  function next(){\n    if(!practiced)return show(0);\n    for(var k=1;k<=N;k++)if(!done[k])return show(k);\n    nature();\n  }\n  function head(k){var n=Object.keys(done).length;return k===0?'<p><b>Practice photograph</b> (not recorded)</p><div class=\"progress\"><i style=\"width:0%\"></i></div>':'<p>Photograph '+k+' of '+N+'</p><div class=\"progress\"><i style=\"width:'+(100*n/N)+'%\"></i></div>';}\n  function show(k){\n    var f=files[fname(k)], t0=0, tm=null;\n    app.innerHTML=head(k)+'<div class=\"view\"><img alt=\"Photograph of a natural scene\" src=\"'+esc(f.url)+'\"></div><div class=\"timer\"><i id=\"tb\" style=\"width:100%\"></i></div>';\n    var img=app.querySelector('img'), tb=document.getElementById('tb');\n    var nf=files[fname(k+1)];if(nf){var pre=new Image();pre.src=nf.url;}\n    function start(){if(t0)return;t0=Date.now();tm=setInterval(function(){var e=Date.now()-t0;tb.style.width=Math.max(0,100*(1-e/VIEW))+'%';if(e>=VIEW){clearInterval(tm);ask(k,f);}},100);}\n    if(img.complete&&img.naturalWidth)start();else{img.onload=start;img.onerror=start;}\n  }\n  function ask(k,f){\n    var vals={};\n    var items=dims().map(function(d,j){var b='';for(var v=1;v<=7;v++)b+='<button data-d=\"'+esc(d.id)+'\" data-v=\"'+v+'\" aria-label=\"'+esc(d.label)+' '+v+'\">'+v+'</button>';\n      var lab=d.id==='attention'?esc(d.label):esc(d.label);\n      return (j===dims().length-1?'<div class=\"item\" style=\"margin-top:22px\">':'<div class=\"item\">')+'<b>'+lab+'</b><div class=\"scale\">'+b+'</div><div class=\"ends\"><span>Not at all</span><span>'+(d.id==='attention'?'Very closely':'Very much')+'</span></div></div>';}).join('');\n    app.innerHTML=head(k)+'<div class=\"card\" style=\"margin-top:0\"><p style=\"margin:0;color:var(--ink)\"><b>'+esc(Q.photo_ratings.title||'Did you find this picture…')+'</b></p>'+items+'</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"nx\">Next</button></div><div class=\"err\"></div>';\n    app.querySelectorAll('.scale button').forEach(function(x){x.onclick=function(){vals[x.getAttribute('data-d')]=Number(x.getAttribute('data-v'));x.parentNode.querySelectorAll('button').forEach(function(y){y.classList.toggle('on',y===x);});err('');};});\n    document.getElementById('nx').onclick=function(){\n      if(dims().some(function(d){return vals[d.id]==null;}))return err('Please answer all seven questions.');\n      var bt=this;bt.disabled=true;\n      if(k===0){practiced=true;try{localStorage.setItem('harrison2023:practiced','1');}catch(e){}window.scrollTo(0,0);return next();}\n      var val={};dims().forEach(function(d){val[d.id]=vals[d.id];});\n      SPSite.answer('photo_ratings',val,{key:String(k),shown:[f.name]}).then(function(r){if(!ok(r)){bt.disabled=false;return err(r.error);}done[k]=true;window.scrollTo(0,0);next();});\n    };\n  }\n  function nature(){\n    var q=Q.nr6, vals={};\n    var rows=(q.rows||[]).map(function(r){return '<div class=\"mx\"><b>'+esc(r.text)+'</b><div class=\"opts\">'+(q.columns||[]).map(function(c){return '<button data-r=\"'+esc(r.value)+'\" data-c=\"'+esc(c.value)+'\">'+esc(c.text)+'</button>';}).join('')+'</div></div>';}).join('');\n    app.innerHTML='<h1>You and nature</h1><p>'+esc(q.title)+'</p><div class=\"card\">'+rows+'</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"nx\">Finish</button></div><div class=\"err\"></div>';\n    app.querySelectorAll('.opts button').forEach(function(x){x.onclick=function(){vals[x.getAttribute('data-r')]=x.getAttribute('data-c');x.parentNode.querySelectorAll('button').forEach(function(y){y.classList.toggle('on',y===x);});err('');};});\n    document.getElementById('nx').onclick=function(){\n      if((q.rows||[]).some(function(r){return vals[r.value]==null;}))return err('Please answer all six statements.');\n      var bt=this;bt.disabled=true;\n      SPSite.answer('nr6',vals).then(function(r){if(!ok(r)){bt.disabled=false;return err(r.error);}finish();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){if(m.some(function(x){return x!=='photo_ratings'&&x!=='nr6';}))intro();else{done={};next();}},1800);}else{var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  SPSite.onReady(function(ctx){\n    ['consent','gender','age','photo_ratings','nr6'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('nature')||[]).forEach(function(f){files[f.name]=f;});\n    try{practiced=localStorage.getItem('harrison2023:practiced')==='1';}catch(e){}\n    var a=(ctx&&ctx.answers)||{}, p=a.photo_ratings;\n    (p&&Array.isArray(p.trials)?p.trials:[]).forEach(function(x){if(x&&x.key!=null&&x.value!=null){done[Number(x.key)]=true;practiced=true;}});\n    if(a.consent===true){if(a.nr6&&typeof a.nr6==='object'&&Object.keys(done).length>=N)finish();else next();}else intro();\n  });\n})();\n</script>\n</body>\n</html>\n"