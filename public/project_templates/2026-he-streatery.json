   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Streatery Interfaces and Restoration</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Streatery interfaces: publicness and restoration\",\n  \"description\": \"Faithful replication of the scenario-based between-subjects experiment of He, Zhu, Deng, Zhang, Chen, Zhang, Chen & Song (2026), Streatery Interface Design for Healthy and Inclusive Streets, Sustainability 18(13):6927. Each participant is randomly assigned ONE of four SketchUp renderings of the same street that differ only in the streatery (outdoor dining) interface: boundaryless open, fully enclosed, flexible permeable (low planters) or hybrid covered (planters plus umbrellas). After the basic-information questions of the original questionnaire, participants rate 4 perceived spatial publicness items (items 3 and 4 reverse-coded) and 11 restorative-experience items (fascination, being away, coherence, extent) on a 5-point agreement scale. Answers are keyed by interface; compare groups with Welch's ANOVA.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"streateries\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"By continuing with this questionnaire, I confirm that I have read the above information and agree to participate in this study voluntarily.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"basic\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age_group\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"18-35\",\n        \"text\": \"18–35 years old\"\n       },\n       {\n        \"value\": \"36-60\",\n        \"text\": \"36–60 years old\"\n       },\n       {\n        \"value\": \"60+\",\n        \"text\": \"60 years old and above\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"occupation\",\n      \"title\": \"Occupation\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"student\",\n        \"text\": \"Student\"\n       },\n       {\n        \"value\": \"corporate\",\n        \"text\": \"Corporate employee\"\n       },\n       {\n        \"value\": \"freelancer\",\n        \"text\": \"Freelancer\"\n       },\n       {\n        \"value\": \"public_sector\",\n        \"text\": \"Public sector employee\"\n       },\n       {\n        \"value\": \"retired\",\n        \"text\": \"Retired\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"income\",\n      \"title\": \"Monthly income\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"lt3000\",\n        \"text\": \"Below RMB 3,000\"\n       },\n       {\n        \"value\": \"3000-6000\",\n        \"text\": \"RMB 3,000–6,000\"\n       },\n       {\n        \"value\": \"6000-8000\",\n        \"text\": \"RMB 6,000–8,000\"\n       },\n       {\n        \"value\": \"8000-12000\",\n        \"text\": \"RMB 8,000–12,000\"\n       },\n       {\n        \"value\": \"ge12000\",\n        \"text\": \"RMB 12,000 and above\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"streatery_experience\",\n      \"title\": \"Have you ever had a resting or consumption experience in a streatery space?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"scenario\",\n    \"elements\": [\n     {\n      \"type\": \"matrix\",\n      \"name\": \"publicness\",\n      \"title\": \"Perceived spatial publicness\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"psp1\",\n        \"text\": \"The boundary treatment of this commercial streateries space makes me feel that it respects my right as an ordinary citizen to use this street.\"\n       },\n       {\n        \"value\": \"psp2\",\n        \"text\": \"Even if I do not intend to consume here, I can still enjoy the visual pleasure brought by this commercial streateries area.\"\n       },\n       {\n        \"value\": \"psp3_r\",\n        \"text\": \"Its boundary design conveys a sense of “private territory, no entry for outsiders.”\"\n       },\n       {\n        \"value\": \"psp4_r\",\n        \"text\": \"When walking beside this commercial streateries area, I feel a sense of commercial occupation of public space.\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"Strongly disagree\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Disagree\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Neutral\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Agree\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"Strongly agree\"\n       }\n      ],\n      \"description\": \"Keyed by interface (open, enclosed, flexible, hybrid). 1 = strongly disagree, 5 = strongly agree. psp3_r and psp4_r are reverse-coded before averaging.\"\n     },\n     {\n      \"type\": \"matrix\",\n      \"name\": \"restoration\",\n      \"title\": \"Restorative environmental experience\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"fas1\",\n        \"text\": \"This place is visually attractive.\"\n       },\n       {\n        \"value\": \"fas2\",\n        \"text\": \"I can notice many interesting things here.\"\n       },\n       {\n        \"value\": \"fas3\",\n        \"text\": \"I do not feel bored when passing by this place.\"\n       },\n       {\n        \"value\": \"ba1\",\n        \"text\": \"This kind of place allows me to get away from troubles.\"\n       },\n       {\n        \"value\": \"ba2\",\n        \"text\": \"I like to go to places like this to get away from things that usually require my directed attention.\"\n       },\n       {\n        \"value\": \"ba3\",\n        \"text\": \"I like to go to places like this to get away from the pressures of everyday life.\"\n       },\n       {\n        \"value\": \"coh1\",\n        \"text\": \"Everything in this street with streatery spaces appears well ordered.\"\n       },\n       {\n        \"value\": \"coh2\",\n        \"text\": \"It is easy to see how things are arranged and organized here.\"\n       },\n       {\n        \"value\": \"coh3\",\n        \"text\": \"Everything here seems to be in its proper place.\"\n       },\n       {\n        \"value\": \"ext1\",\n        \"text\": \"This space feels open and not cramped.\"\n       },\n       {\n        \"value\": \"ext2\",\n        \"text\": \"There are almost no boundaries here that restrict my freedom of movement.\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"Strongly disagree\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Disagree\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Neutral\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Agree\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"Strongly agree\"\n       }\n      ],\n      \"description\": \"Keyed by interface. Fascination (fas1-3), being away (ba1-3), coherence (coh1-3), extent (ext1-2); 1-5 agreement.\"\n     }\n    ]\n   }\n  ],\n  \"spAnalysisRecommendation\": \"Between-subjects: average the four publicness items (after reversing psp3_r and psp4_r) and the 11 restoration items per participant, then compare the four interface groups (the answer key) with Welch's ANOVA and Games-Howell post hoc tests; test publicness as a mediator of interface -> restoration (PROCESS model 4); compare participants with and without streatery experience with t-tests.\"\n }\n}\n</script>\n<script type=\"application/json\" id=\"results-table\">{\"source\": \"He et al. (2026) Sustainability 18:6927, Table 2: stimulus manipulation check (pre-test, N=29), mean ± SD on 5-point scales\", \"rows\": [[\"Perceived openness\", \"4.75 ± 0.71\", \"2.00 ± 1.27\", \"3.29 ± 1.38\", \"2.88 ± 0.64\"], [\"Perceived enclosure\", \"1.88 ± 0.84\", \"5.00 ± 0.00\", \"3.86 ± 0.90\", \"3.50 ± 0.76\"], [\"Perceived permeability\", \"4.63 ± 0.52\", \"2.50 ± 0.84\", \"4.43 ± 0.54\", \"3.50 ± 0.54\"], [\"Perceived overhead covering\", \"1.75 ± 1.17\", \"3.00 ± 1.27\", \"1.57 ± 0.98\", \"4.13 ± 1.64\"], [\"Perceived environmental integration\", \"1.88 ± 1.36\", \"1.83 ± 0.41\", \"4.43 ± 0.79\", \"4.50 ± 0.76\"]], \"columns\": [\"open\", \"enclosed\", \"flexible\", \"hybrid\"]}</script>\n<style>\n:root{--bg:#f3f2ee;--card:#fff;--ink:#1d1f1c;--muted:#5d6159;--accent:#3d6b4f;--line:#d9dad2;--warn:#b3261e;--sel:#e0ece4}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1100px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.anch{display:flex;justify-content:space-between;font-size:.75rem;color:var(--muted);margin-top:3px}\n.blk{margin-top:14px}.blk:first-child{margin-top:0}\n.blk.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.err{color:var(--warn);margin-top:8px;min-height:1.5em;line-height:1.5}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n.lay{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,6fr);gap:20px;align-items:start}\n.pic{position:sticky;top:10px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px}\n.pic img{width:100%;aspect-ratio:1/1;height:auto;display:block;border-radius:8px;max-height:calc(100vh - 80px);object-fit:contain}\n.it{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px 12px}\n.sec{margin:18px 0 6px;font-weight:700}\n.o5{display:grid;grid-template-columns:repeat(5,1fr);gap:3px;margin-top:8px}\n.o5 label{display:flex;justify-content:center;border:1px solid var(--line);border-radius:8px;padding:10px 0;cursor:pointer}\n.o5 label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.o5 input{display:none}\n@media (max-width:800px){.lay{grid-template-columns:1fr}.pic{position:sticky;top:0;z-index:2;padding:6px}.pic img{max-height:34vh}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Street renderings and questionnaire: He, Zhu, Deng, Zhang, Chen, Zhang, Chen &amp; Song (2026), Streatery Interface Design for Healthy and Inclusive Streets, Sustainability 18(13):6927 (doi:10.3390/su18136927, CC BY 4.0). Renderings cropped from Figure 2; items from Supplementary File S1. Removed on request of the authors.</footer>\n<script>\n(function(){\n  var KEY='he2026streatery:state', IFS=['open','enclosed','flexible','hybrid'], PSP=[[\"psp1\", \"The boundary treatment of this commercial streateries space makes me feel that it respects my right as an ordinary citizen to use this street.\"], [\"psp2\", \"Even if I do not intend to consume here, I can still enjoy the visual pleasure brought by this commercial streateries area.\"], [\"psp3_r\", \"Its boundary design conveys a sense of “private territory, no entry for outsiders.”\"], [\"psp4_r\", \"When walking beside this commercial streateries area, I feel a sense of commercial occupation of public space.\"]], REST=[[\"fas1\", \"This place is visually attractive.\"], [\"fas2\", \"I can notice many interesting things here.\"], [\"fas3\", \"I do not feel bored when passing by this place.\"], [\"ba1\", \"This kind of place allows me to get away from troubles.\"], [\"ba2\", \"I like to go to places like this to get away from things that usually require my directed attention.\"], [\"ba3\", \"I like to go to places like this to get away from the pressures of everyday life.\"], [\"coh1\", \"Everything in this street with streatery spaces appears well ordered.\"], [\"coh2\", \"It is easy to see how things are arranged and organized here.\"], [\"coh3\", \"Everything here seems to be in its proper place.\"], [\"ext1\", \"This space feels open and not cramped.\"], [\"ext2\", \"There are almost no boundaries here that restrict my freedom of movement.\"]],\n      BG=['gender','age_group','occupation','income','streatery_experience'],\n      SECS=[['fas','Fascination'],['ba','Being away'],['coh','Coherence'],['ext','Extent']];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='';}}\n  function hideErr(){var e=app.querySelector('.err');if(e&&!app.querySelector('.miss'))e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function markMiss(miss,msg){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});err(msg);}\n  function intro(){\n    app.innerHTML='<h1>Streateries and street experience</h1><p>We are conducting an academic survey on streatery interface design, perceived spatial publicness, and emotional restoration in urban street environments. A streatery is an outdoor extension of a café, restaurant or shop into the pedestrian space of a street.</p><p>This questionnaire is anonymous, and all data will be used for academic research purposes only. You will answer a few basic questions, then see one street scene and rate how you feel about it. Please answer based on the presented scenario and your actual feelings. There are no right or wrong answers; choose the option that best reflects your first impression. It takes about 3–8 minutes.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='basic';save();route();});};\n  }\n  function basic(){\n    app.innerHTML='<h2>Part I: Basic information</h2><p>Please select one option for each question based on your actual situation.</p><div class=\"card\">'+BG.map(function(n){var q=Q[n];\n      return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var L=[],miss=[];\n      BG.forEach(function(n){var x=app.querySelector('input[name=\"'+n+'\"]:checked');if(!x){miss.push(app.querySelector('.blk[data-n=\"'+n+'\"]'));return;}L.push(SPSite.answer(n,x.value));});\n      if(miss.length)return markMiss(miss,'Please answer the marked questions.');\n      send(L,this,function(){st.step='scene';if(!st.cond)st.cond=IFS[Math.floor(Math.random()*IFS.length)];save();route();});};\n  }\n  function item(r){return '<div class=\"blk it\" data-n=\"'+r[0]+'\"><b>'+esc(r[1])+'</b><div class=\"o5\">'+[1,2,3,4,5].map(function(v){return '<label><input type=\"radio\" name=\"'+r[0]+'\" value=\"'+v+'\"><b>'+v+'</b></label>';}).join('')+'</div><div class=\"anch\"><span>Strongly disagree</span><span>Strongly agree</span></div></div>';}\n  function scene(){\n    var k=st.cond;\n    app.innerHTML='<div class=\"lay\"><div class=\"pic\"><img alt=\"Street scene with an outdoor dining area beside the pavement\" src=\"'+esc(files[k].url)+'\"></div><div class=\"qs\">'+\n      '<h2>Part II: Perceived spatial publicness</h2><p>Please rate the following statements based on the presented commercial streateries scenario (1 = strongly disagree, 5 = strongly agree).</p>'+PSP.map(item).join('')+\n      '<h2 style=\"margin-top:22px\">Part III: Restorative environmental experience</h2>'+SECS.map(function(s){return '<div class=\"sec\">'+s[1]+'</div>'+REST.filter(function(r){return r[0].indexOf(s[0])===0;}).map(item).join('');}).join('')+\n      '<div class=\"card\"><button class=\"btn\" id=\"go\">Finish</button><div class=\"err\"></div></div></div></div>';\n    document.getElementById('go').onclick=function(){\n      var miss=[],a={},b={};\n      function get(list,obj){list.forEach(function(r){var x=app.querySelector('input[name=\"'+r[0]+'\"]:checked');if(x)obj[r[0]]=Number(x.value);else miss.push(app.querySelector('.blk[data-n=\"'+r[0]+'\"]'));});}\n      get(PSP,a);get(REST,b);\n      if(miss.length)return markMiss(miss,'Please answer every statement.');\n      var sh=[files[k].name];\n      send([SPSite.answer('publicness',a,{key:k,shown:sh}),SPSite.answer('restoration',b,{key:k,shown:sh})],this,function(){st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='This concludes the questionnaire. Thank you very much for your time and support; your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var b=e.target.closest&&e.target.closest('.blk');if(b){b.classList.remove('miss');hideErr();}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='basic')return basic();if(s==='scene')return scene();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','publicness','restoration'].concat(BG).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('streateries')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=IFS.filter(function(m){return !files[m];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"streateries\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.step)||a.consent!==true)st={step:'intro'};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
