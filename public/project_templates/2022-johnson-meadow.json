   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Attention and Views</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Meadow, Ocean or City: Attention Restoration\",\n  \"description\": \"Participants do a 4-minute sustained-attention task (SART: press for every digit except 3), look at one of three photographs (meadow, ocean or urban street, assigned at random) for 40 s, repeat the SART, and then rate sleepiness and how restorative the view felt. Rebuilt from Johnson et al. (2022), Frontiers in Psychology 13: 809629 (Study 2, online), with the paper's own images (CC BY 4.0).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"views\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 99\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"sex\",\n      \"title\": \"Sex\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"handedness\",\n      \"title\": \"Handedness\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"right\",\n        \"text\": \"Right\"\n       },\n       {\n        \"value\": \"left\",\n        \"text\": \"Left\"\n       },\n       {\n        \"value\": \"either\",\n        \"text\": \"Either\"\n       }\n      ]\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"kss\",\n      \"title\": \"How sleepy do you feel right now?\",\n      \"description\": \"Karolinska Sleepiness Scale, 1 = extremely alert, 9 = extremely sleepy. Keyed 'baseline' (before the tasks) / 'post' (after the second SART).\",\n      \"rateMin\": 1,\n      \"rateMax\": 9,\n      \"minRateDescription\": \"Extremely alert\",\n      \"maxRateDescription\": \"Extremely sleepy\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"task\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"view\",\n      \"title\": \"Photograph shown for 40 s between the two SARTs (assigned at random)\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"meadow\",\n        \"text\": \"Meadow\"\n       },\n       {\n        \"value\": \"ocean\",\n        \"text\": \"Ocean\"\n       },\n       {\n        \"value\": \"urban\",\n        \"text\": \"Urban (ground-level street)\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"sart_omissions\",\n      \"title\": \"SART omission errors\",\n      \"description\": \"Go trials (digits other than 3) without a key press, out of 200. Keyed 'baseline' / 'post' (the two 225-trial SARTs).\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"sart_commissions\",\n      \"title\": \"SART commission errors\",\n      \"description\": \"No-Go trials (digit 3) with a key press, out of 25. Keyed 'baseline' / 'post' (the two 225-trial SARTs).\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"sart_rt_mean\",\n      \"title\": \"SART mean reaction time (ms)\",\n      \"description\": \"Mean reaction time on correct Go trials. Keyed 'baseline' / 'post' (the two 225-trial SARTs).\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"sart_rt_sd\",\n      \"title\": \"SART reaction time SD (ms)\",\n      \"description\": \"Standard deviation of reaction time on correct Go trials. Keyed 'baseline' / 'post' (the two 225-trial SARTs).\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"sart_raw\",\n      \"title\": \"SART trial log\",\n      \"description\": \"One entry per trial: digit:pressed(0/1):rt-ms, comma separated, in presentation order. Keyed 'baseline' / 'post'.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"prs\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_away\",\n      \"title\": \"Looking at this place gave me a break from my everyday thoughts and demands.\",\n      \"description\": \"Perceived restorativeness of the photograph, Being Away (item written for this template; the paper used the 26-item PRS). 0 = not at all, 6 = completely.\",\n      \"rateMin\": 0,\n      \"rateMax\": 6,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Completely\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_fascination\",\n      \"title\": \"There was a lot in this place that held my attention without effort.\",\n      \"description\": \"Perceived restorativeness of the photograph, Fascination (item written for this template; the paper used the 26-item PRS). 0 = not at all, 6 = completely.\",\n      \"rateMin\": 0,\n      \"rateMax\": 6,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Completely\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_coherence\",\n      \"title\": \"The things in this place fit together into an ordered whole.\",\n      \"description\": \"Perceived restorativeness of the photograph, Coherence (item written for this template; the paper used the 26-item PRS). 0 = not at all, 6 = completely.\",\n      \"rateMin\": 0,\n      \"rateMax\": 6,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Completely\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_compatibility\",\n      \"title\": \"This is a place where I could do the things I like to do.\",\n      \"description\": \"Perceived restorativeness of the photograph, Compatibility (item written for this template; the paper used the 26-item PRS). 0 = not at all, 6 = completely.\",\n      \"rateMin\": 0,\n      \"rateMax\": 6,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Completely\",\n      \"isRequired\": true\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"views-original\">{\"source\": \"Johnson et al. (2022) Front Psychol 13:809629, Study 2 (Table 4)\", \"n\": 186, \"prs_mean\": {\"meadow\": 3.8, \"ocean\": 4.1, \"urban\": 2.8}, \"kss\": {\"baseline\": 4.8, \"post\": 5.3}, \"result\": \"Meadow and ocean views were rated more restorative than the urban view, and did not differ from each other; SART performance after the view did not differ between groups (no performance-based restoration).\"}</script>\n<style>\n:root{--bg:#f3f5f6;--card:#fff;--ink:#1e2429;--muted:#5d666e;--accent:#2f5f7d;--line:#dae1e6;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.1rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.item{padding:10px 0;border-top:1px solid var(--line)}.item:first-of-type{border-top:0}.item .t{margin-bottom:6px}.item.miss .t{color:var(--warn)}\n.scale{display:grid;gap:5px}.scale button{appearance:none;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:8px;padding:8px 0;font:inherit;font-weight:600;cursor:pointer}\n.scale button.on{background:var(--accent);border-color:var(--accent);color:#fff}\n.anch{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);margin-top:3px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.sart{position:fixed;inset:0;background:#000;color:#fff;display:flex;align-items:center;justify-content:center;user-select:none;-webkit-user-select:none;touch-action:manipulation;z-index:5}\n.sart .dg{font:700 96px/1 Arial,Helvetica,sans-serif}\n.sart .mask{width:96px;height:96px;border:5px solid #fff;border-radius:50%;position:relative}\n.sart .mask:before,.sart .mask:after{content:\"\";position:absolute;background:#fff;left:50%;top:50%;transform:translate(-50%,-50%) rotate(45deg)}\n.sart .mask:before{width:5px;height:100%}.sart .mask:after{width:100%;height:5px}\n.sart .hint{position:absolute;bottom:18px;left:0;right:0;text-align:center;color:#888;font-size:.85rem}\n.view{position:fixed;inset:0;background:#000;display:flex;align-items:center;justify-content:center;z-index:5}.view img{max-width:100%;max-height:100%;object-fit:contain}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\nkbd{border:1px solid var(--line);border-bottom-width:2px;border-radius:5px;padding:0 6px;background:#fff;font:inherit;font-size:.9em}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Johnson et al. (2022), Frontiers in Psychology 13:809629, Figures 1, 2 and 4 (CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='views-sart:state', T=window.__VIEWMS?{dig:20,mask:40,view:window.__VIEWMS}:{dig:250,mask:900,view:40000};\n  var PRS=['prs_away','prs_fascination','prs_coherence','prs_compatibility'], VIEWS=['meadow','ocean','urban'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function seq(cycles){var s=[];for(var c=0;c<cycles;c++){var cyc;do{cyc=shuffle([1,2,3,4,5,6,7,8,9]);}while(s.length&&s[s.length-1]===3&&cyc[0]===3);s=s.concat(cyc);}return s;}\n  function row(n,min,max){var b='';for(var v=min;v<=max;v++)b+='<button type=\"button\" data-v=\"'+v+'\">'+v+'</button>';return '<div class=\"item\" data-k=\"'+n+'\"><div class=\"t\">'+esc(Q[n].title)+'</div><div class=\"scale\" style=\"grid-template-columns:repeat('+(max-min+1)+',1fr)\">'+b+'</div><div class=\"anch\"><span>'+esc(Q[n].minRateDescription)+'</span><span>'+esc(Q[n].maxRateDescription)+'</span></div></div>';}\n  function bind(vals){app.querySelectorAll('.item').forEach(function(it){it.querySelectorAll('.scale button').forEach(function(b){b.onclick=function(){vals[it.dataset.k]=Number(b.dataset.v);it.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b);});it.classList.remove('miss');};});});}\n  function intro(){\n    app.innerHTML='<h1>Attention and views</h1><p>This study has a short attention game, a photograph to look at, the attention game again, and a few questions. Please use a computer with a keyboard if you can, in a quiet place, and do not take breaks during the games. It takes about 15 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function about(){\n    var vals={};\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"99\"></div>'+radios('sex')+radios('handedness')+'<div class=\"f\">'+row('kss',1,9)+'</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    bind(vals);\n    document.getElementById('go').onclick=function(){\n      var age=Number(document.getElementById('age').value);if(!(age>=18&&age<=99))return err('Please enter your age (18 or older).');\n      var s=app.querySelector('input[name=sex]:checked'),h=app.querySelector('input[name=handedness]:checked');if(!s||!h)return err('Please answer every question.');\n      if(vals.kss==null){app.querySelector('.item').classList.add('miss');return err('Please rate how sleepy you feel.');}\n      send([SPSite.answer('age',age),SPSite.answer('sex',s.value),SPSite.answer('handedness',h.value),SPSite.answer('kss',vals.kss,{key:'baseline'})],this,function(){st.step='practice';save();route();});\n    };\n  }\n  function brief(title,text,btn,next){app.innerHTML='<h2>'+title+'</h2><div class=\"card\"><p style=\"color:var(--ink)\">'+text+'</p><button class=\"btn\" id=\"go\">'+btn+'</button></div>';document.getElementById('go').onclick=next;}\n  var HOW='Digits from 1 to 9 will flash one at a time in the middle of a black screen. Press the <kbd>space bar</kbd> (or tap the screen) as quickly as you can for every digit <b>except 3</b>. When you see a <b>3</b>, do not press. Speed and accuracy are equally important.';\n  function runSart(digits,done){\n    var box=document.createElement('div');box.className='sart';box.innerHTML='<div id=\"s\"></div><div class=\"hint\">space bar / tap for every digit except 3</div>';document.body.appendChild(box);\n    var s=box.querySelector('#s'),i=-1,t0=0,cur=null,log=[];\n    function press(e){if(e.type==='keydown'){if(e.code!=='Space'&&e.key!==' ')return;e.preventDefault();if(e.repeat)return;}else e.preventDefault();if(cur&&!cur.p){cur.p=1;cur.rt=Math.round(performance.now()-t0);}}\n    document.addEventListener('keydown',press);box.addEventListener('pointerdown',press);\n    function next(){if(cur)log.push(cur);i++;if(i>=digits.length){document.removeEventListener('keydown',press);box.remove();return done(log);}\n      cur={d:digits[i],p:0,rt:0};s.className='dg';s.textContent=digits[i];t0=performance.now();\n      setTimeout(function(){s.className='mask';s.textContent='';setTimeout(next,T.mask);},T.dig);}\n    setTimeout(next,800);\n  }\n  function summary(log){var om=0,cm=0,rts=[];log.forEach(function(t){if(t.d===3){if(t.p)cm++;}else{if(!t.p)om++;else rts.push(t.rt);}});\n    var m=rts.length?rts.reduce(function(a,b){return a+b;},0)/rts.length:0,sd=rts.length>1?Math.sqrt(rts.reduce(function(a,b){return a+(b-m)*(b-m);},0)/(rts.length-1)):0;\n    return {om:om,cm:cm,m:Math.round(m),sd:Math.round(sd),raw:log.map(function(t){return t.d+':'+t.p+':'+t.rt;}).join(',')};}\n  function practice(){brief('Attention game: practice',HOW+' First a short practice (18 digits).','Start practice',function(){runSart(seq(2),function(log){var s=summary(log);st.step='baseline';st.prac=s.om+'/'+s.cm;save();\n    brief('Practice done','You missed '+s.om+' of 16 digits you should have pressed for, and pressed '+s.cm+' time(s) on a 3. Now the real game: 225 digits, about 4 minutes. Keep going without breaks.','Start',function(){route();});});});}\n  function sartBlock(key){\n    var go=function(){runSart(seq(25),function(log){var s=summary(log);app.innerHTML='<p>Saving…</p><div class=\"err\"></div>';\n      send([SPSite.answer('sart_omissions',s.om,{key:key}),SPSite.answer('sart_commissions',s.cm,{key:key}),SPSite.answer('sart_rt_mean',s.m,{key:key}),SPSite.answer('sart_rt_sd',s.sd,{key:key}),SPSite.answer('sart_raw',s.raw,{key:key})],null,function(){st.step=key==='baseline'?'view':'kss2';save();route();});});};\n    if(key==='baseline')brief('Attention game',HOW+' 225 digits, about 4 minutes.','Start',go);\n    else brief('Attention game again','Same game as before: press for every digit except 3. 225 digits, about 4 minutes.','Start',go);\n  }\n  function view(){\n    var f=files[st.view];\n    brief('A photograph','Next you will see a photograph for 40 seconds. Just look at it freely and do nothing else. The game starts again afterwards.','Show the photograph',function(){\n      var box=document.createElement('div');box.className='view';box.innerHTML='<img alt=\"Photograph\" src=\"'+esc(f.url)+'\">';document.body.appendChild(box);\n      setTimeout(function(){box.remove();app.innerHTML='<p>Saving…</p><div class=\"err\"></div>';send([SPSite.answer('view',st.view)],null,function(){st.step='post';save();route();});},T.view);\n    });\n  }\n  function kss2(){var vals={};app.innerHTML='<h2>Almost done</h2><div class=\"card\">'+row('kss',1,9)+'<div style=\"margin-top:14px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';bind(vals);\n    document.getElementById('go').onclick=function(){if(vals.kss==null)return err('Please rate how sleepy you feel.');send([SPSite.answer('kss',vals.kss,{key:'post'})],this,function(){st.step='prs';save();route();});};}\n  function prs(){\n    var vals={},f=files[st.view];\n    app.innerHTML='<h2>About the photograph you looked at</h2><div class=\"card\"><img alt=\"The photograph\" src=\"'+esc(f.url)+'\" style=\"width:100%;max-width:420px;display:block;border-radius:8px;margin-bottom:10px\"><p>How much does each statement apply to your experience of viewing it?</p>'+PRS.map(function(n){return row(n,0,6);}).join('')+'<div style=\"margin-top:14px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    bind(vals);\n    document.getElementById('go').onclick=function(){var m=PRS.filter(function(n){return vals[n]==null;});if(m.length){m.forEach(function(n){app.querySelector('.item[data-k=\"'+n+'\"]').classList.add('miss');});return err('Please answer every statement.');}\n      send(PRS.map(function(n){return SPSite.answer(n,vals[n],{key:st.view,shown:[f.name]});}),this,function(){st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='practice')return practice();if(s==='baseline')return sartBlock('baseline');if(s==='view')return view();if(s==='post')return sartBlock('post');if(s==='kss2')return kss2();if(s==='prs')return prs();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','sex','handedness','kss','view','sart_omissions','sart_commissions','sart_rt_mean','sart_rt_sd','sart_raw'].concat(PRS).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('views')||[]).forEach(function(f){var k=f.name.replace(/\\.[^.]+$/,'').toLowerCase();if(VIEWS.indexOf(k)>=0)files[k]=f;});\n    var have=VIEWS.filter(function(v){return files[v];});\n    if(!have.length){app.innerHTML='<h1>Photographs missing</h1><p>Upload meadow.jpg, ocean.jpg and urban.jpg to the media folder \"views\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!(st&&st.view&&files[st.view]))st={step:'intro',view:have[Math.floor(Math.random()*have.length)]};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true)st.step='intro';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
