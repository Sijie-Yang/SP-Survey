   "id": "site-b5602100a41f0648",
   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Rural Street Restoration</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Rural Community Streets: Restorative Potential of Nine Street Types\",\n  \"description\": \"Faithful replication of the silent-photo condition (S0) with the paper's own photographs: participants view nine street photographs from four rural communities in Pidu District, Chengdu, one for each street type (artificial / natural / artificial-natural enclosure; artificial / natural semi-enclosed; artificial-natural and natural-artificial semi-enclosure; artificial / natural open), each full screen for 30 s, imagining being in the scene. After each photo they rate the paper's six statements on a 0-4 agreement scale: four restorative components scale items (being away, extent, fascination, compatibility), tranquility and visual aesthetic quality. Rebuilt from Fu, Ren, Li & Zhang (2022), Frontiers in Public Health 10: 861072, with the nine photographs and the questionnaire wording from its Supplementary Material (CC BY 4.0). Analysis as in the paper: Cronbach's alpha; mean RCS score per street type (the four items averaged) with ANOVA across the nine types; Pearson correlations between VAQ and the RCS items. Differences from the original study: (1) only the silent-image condition S0 is included; the paper also played each photo with three recorded birdsong/traffic-noise mixes at 55 dB(A) (S1 70 % birdsong, S2 50 %, S3 30 %), whose audio files are not published; (2) no pulse or blood-pressure measurement; (3) online rather than one by one in a soundproof lab with a slideshow; (4) the paper does not report the presentation order; here the nine photos appear in random order; (5) photos are resized to 1600 x 1200 px; (6) the residence question and its options are our wording (the shared data file codes current residence but does not print the options).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"streets\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 16,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"sex\",\n      \"title\": \"Sex\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"residence\",\n      \"title\": \"Where do you currently live?\",\n      \"description\": \"Our wording.\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"urban\",\n        \"text\": \"In a city or town\"\n       },\n       {\n        \"value\": \"rural\",\n        \"text\": \"In a rural area or village\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"streets\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"being_away\",\n      \"title\": \"There allows me to temporarily forget the troubles of work and daily life.\",\n      \"rateMin\": 0,\n      \"rateMax\": 4,\n      \"minRateDescription\": \"Totally disagree\",\n      \"maxRateDescription\": \"Totally agree\",\n      \"isRequired\": true,\n      \"description\": \"Restorative components scale (RCS), being-away item B1. Keyed by street photo: v1 artificial enclosure, v2 natural enclosure, v3 artificial-natural enclosure, v4 artificial semi-enclosed, v5 natural semi-enclosed, v6 artificial-natural semi-enclosure, v7 natural-artificial semi-enclosure, v8 artificial open, v9 natural open (the paper's V1-V9, Figure 2). 0 = totally disagree ... 4 = totally agree.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"extent\",\n      \"title\": \"There are many beautiful associations here.\",\n      \"rateMin\": 0,\n      \"rateMax\": 4,\n      \"minRateDescription\": \"Totally disagree\",\n      \"maxRateDescription\": \"Totally agree\",\n      \"isRequired\": true,\n      \"description\": \"RCS extent item E1. Keyed by street photo: v1 artificial enclosure, v2 natural enclosure, v3 artificial-natural enclosure, v4 artificial semi-enclosed, v5 natural semi-enclosed, v6 artificial-natural semi-enclosure, v7 natural-artificial semi-enclosure, v8 artificial open, v9 natural open (the paper's V1-V9, Figure 2). 0 = totally disagree ... 4 = totally agree.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"fascination\",\n      \"title\": \"There's a lot here that appeals to me.\",\n      \"rateMin\": 0,\n      \"rateMax\": 4,\n      \"minRateDescription\": \"Totally disagree\",\n      \"maxRateDescription\": \"Totally agree\",\n      \"isRequired\": true,\n      \"description\": \"RCS fascination item F1. Keyed by street photo: v1 artificial enclosure, v2 natural enclosure, v3 artificial-natural enclosure, v4 artificial semi-enclosed, v5 natural semi-enclosed, v6 artificial-natural semi-enclosure, v7 natural-artificial semi-enclosure, v8 artificial open, v9 natural open (the paper's V1-V9, Figure 2). 0 = totally disagree ... 4 = totally agree.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"compatibility\",\n      \"title\": \"There gives me the opportunity to do what I love to do.\",\n      \"rateMin\": 0,\n      \"rateMax\": 4,\n      \"minRateDescription\": \"Totally disagree\",\n      \"maxRateDescription\": \"Totally agree\",\n      \"isRequired\": true,\n      \"description\": \"RCS compatibility item C1. Keyed by street photo: v1 artificial enclosure, v2 natural enclosure, v3 artificial-natural enclosure, v4 artificial semi-enclosed, v5 natural semi-enclosed, v6 artificial-natural semi-enclosure, v7 natural-artificial semi-enclosure, v8 artificial open, v9 natural open (the paper's V1-V9, Figure 2). 0 = totally disagree ... 4 = totally agree.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"tranquility\",\n      \"title\": \"The environment here makes me feel very quiet.\",\n      \"rateMin\": 0,\n      \"rateMax\": 4,\n      \"minRateDescription\": \"Totally disagree\",\n      \"maxRateDescription\": \"Totally agree\",\n      \"isRequired\": true,\n      \"description\": \"Tranquility rate (TR). Keyed by street photo: v1 artificial enclosure, v2 natural enclosure, v3 artificial-natural enclosure, v4 artificial semi-enclosed, v5 natural semi-enclosed, v6 artificial-natural semi-enclosure, v7 natural-artificial semi-enclosure, v8 artificial open, v9 natural open (the paper's V1-V9, Figure 2). 0 = totally disagree ... 4 = totally agree.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"vaq\",\n      \"title\": \"The environment here is beautiful and striking.\",\n      \"rateMin\": 0,\n      \"rateMax\": 4,\n      \"minRateDescription\": \"Totally disagree\",\n      \"maxRateDescription\": \"Totally agree\",\n      \"isRequired\": true,\n      \"description\": \"Visual aesthetic quality (VAQ). Keyed by street photo: v1 artificial enclosure, v2 natural enclosure, v3 artificial-natural enclosure, v4 artificial semi-enclosed, v5 natural semi-enclosed, v6 artificial-natural semi-enclosure, v7 natural-artificial semi-enclosure, v8 artificial open, v9 natural open (the paper's V1-V9, Figure 2). 0 = totally disagree ... 4 = totally agree.\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"rcs-original\">{\"source\": \"Fu, Ren, Li & Zhang (2022) Frontiers in Public Health 10: 861072\", \"n\": 57, \"participants\": \"57 college students aged 19-26 (28 men, 29 women, mean 22.6) under chronic stress; tested one by one in a soundproof lab, May 2021; 36 audio-visual videos of 30 s (9 streets x 4 sound conditions)\", \"s0_means_from_data_sheet\": {\"v1\": {\"being_away\": 2.32, \"extent\": 2.47, \"fascination\": 2.23, \"compatibility\": 2.16, \"tranquility\": 2.28, \"vaq_0_100\": 72.12}, \"v2\": {\"being_away\": 2.65, \"extent\": 2.25, \"fascination\": 2.09, \"compatibility\": 2.32, \"tranquility\": 2.79, \"vaq_0_100\": 73.26}, \"v3\": {\"being_away\": 3.12, \"extent\": 2.93, \"fascination\": 2.68, \"compatibility\": 2.79, \"tranquility\": 3.32, \"vaq_0_100\": 79.65}, \"v4\": {\"being_away\": 2.04, \"extent\": 2.05, \"fascination\": 2.02, \"compatibility\": 2.14, \"tranquility\": 1.79, \"vaq_0_100\": 68.28}, \"v5\": {\"being_away\": 2.81, \"extent\": 2.49, \"fascination\": 2.51, \"compatibility\": 2.39, \"tranquility\": 3.12, \"vaq_0_100\": 74.7}, \"v6\": {\"being_away\": 2.56, \"extent\": 2.16, \"fascination\": 2.12, \"compatibility\": 2.09, \"tranquility\": 2.86, \"vaq_0_100\": 82.96}, \"v7\": {\"being_away\": 2.11, \"extent\": 2.21, \"fascination\": 2.4, \"compatibility\": 2.16, \"tranquility\": 1.86, \"vaq_0_100\": 69.12}, \"v8\": {\"being_away\": 2.21, \"extent\": 2.07, \"fascination\": 2.05, \"compatibility\": 2.14, \"tranquility\": 2.16, \"vaq_0_100\": 69.75}, \"v9\": {\"being_away\": 2.61, \"extent\": 2.42, \"fascination\": 2.42, \"compatibility\": 2.26, \"tranquility\": 2.89, \"vaq_0_100\": 71.05}}, \"note\": \"Means computed by us from the paper's Data Sheet 1 (silent condition S0, n = 57). In that file VAQ is recorded on a 0-100 scale, whereas the questionnaire prints 0-4; the paper does not say how it was converted.\", \"result\": \"Street type and sound both affected visual aesthetic quality and restorative ratings. Artificial-natural enclosed (V3) and natural semi-enclosed (V5) streets were rated most restorative and most beautiful. Adding the 70 % birdsong mix (S1) raised aesthetic quality and restoration compared with silent photos, while mixes with 50 % or less birdsong did not help. Restoration ratings correlated positively with aesthetic quality.\"}</script>\n<style>\n:root{--bg:#f3f5ef;--card:#fff;--ink:#1e231b;--muted:#5e6757;--accent:#4a6b2a;--line:#dbe0d3;--warn:#b3261e;--sel:#eaf1df}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.view{position:fixed;inset:0;background:#000;display:flex;align-items:center;justify-content:center;z-index:5}\n.view img{max-width:100vw;max-height:100vh;width:auto;height:auto;display:block}\n.view .t{position:absolute;bottom:10px;left:0;right:0;text-align:center;color:#aaa;font-size:.85rem;text-shadow:0 0 4px #000}\n.thumb{width:100%;max-width:360px;border-radius:8px;display:block;margin:0 auto 10px}\n.it{margin-top:14px}\n.row{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;margin-top:6px}\n.row label{display:flex;flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:8px;padding:6px 0;cursor:pointer;font-size:.85rem}\n.row label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.row input{margin:0 0 2px}\n.ends{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);margin-top:2px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:760px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Fu, Ren, Li &amp; Zhang (2022), Frontiers in Public Health 10: 861072, Supplementary Images 1–9 (doi:10.3389/fpubh.2022.861072, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='rural-street-rcs:state', T=window.__VIEWMS?{view:window.__VIEWMS}:{view:30000};\n  var ITEMS=['being_away','extent','fascination','compatibility','tranquility','vaq'];\n  var app=document.getElementById('app'), Q={}, files={}, ids=[], st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function intro(){\n    app.innerHTML='<h1>Rural community streets</h1><p>You will see '+st.order.length+' photographs of streets in rural communities near Chengdu, China. Each photo fills the screen for 30 seconds; imagine that you are standing in the scene. After each photo, say how much you agree with six short statements about it. It takes about 10 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"16\" max=\"110\"></div>'+radios('sex')+radios('residence')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var age=Number(document.getElementById('age').value),g=val('sex'),r=val('residence');\n      if(!(age>=16&&age<=110))return err('Please enter your age.');if(!g||!r)return err('Please answer every question.');\n      send([SPSite.answer('age',age),SPSite.answer('sex',g),SPSite.answer('residence',r)],this,function(){st.step='trial';st.k=0;st.phase='view';save();route();});\n    };\n  }\n  function trial(){\n    if(st.phase==='q')return rate();\n    var id=st.order[st.k],v=document.createElement('div');v.className='view';\n    v.innerHTML='<img alt=\"Rural street photograph\" src=\"'+esc(files[id].url)+'\"><div class=\"t\">Photo '+(st.k+1)+' of '+st.order.length+' · imagine you are here</div>';\n    app.innerHTML='';app.appendChild(v);\n    setTimeout(function(){st.phase='q';save();route();},T.view);\n  }\n  function rate(){\n    var id=st.order[st.k],h='';\n    ITEMS.forEach(function(n){var r='<div class=\"row\">';for(var i=0;i<=4;i++)r+='<label><input type=\"radio\" name=\"q_'+n+'\" value=\"'+i+'\">'+i+'</label>';\n      h+='<div class=\"it\"><b>'+esc(Q[n].title)+'</b>'+r+'</div><div class=\"ends\"><span>Totally disagree</span><span>Totally agree</span></div></div>';});\n    app.innerHTML='<div class=\"prog\">Photo '+(st.k+1)+' of '+st.order.length+'</div><div class=\"card\"><img class=\"thumb\" alt=\"The photo you just saw\" src=\"'+esc(files[id].url)+'\"><p style=\"color:var(--ink)\">Imagine you are in this scene. How much do you agree with each statement? (0 = totally disagree, 4 = totally agree)</p>'+h+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">'+(st.k+1<st.order.length?'Next photo':'Finish')+'</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var vals={},miss=ITEMS.filter(function(n){vals[n]=val('q_'+n);return vals[n]==null;});\n      if(miss.length)return err('Please answer all six statements.');\n      var sh=[files[id].name];\n      send(ITEMS.map(function(n){return SPSite.answer(n,Number(vals[n]),{key:id,shown:sh});}),this,function(){st.k++;st.phase='view';if(st.k>=st.order.length)st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='trial')return trial();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','sex','residence'].concat(ITEMS).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('streets')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name)){var k=f.name.replace(/\\.[^.]+$/,'');files[k]=f;ids.push(k);}});\n    if(ids.length<2){app.innerHTML='<h1>Photos missing</h1><p>Upload the photographs to the media folder \"streets\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var valid=st&&st.order&&st.order.length===ids.length&&st.order.every(function(x){return files[x];});\n    if(!valid)st={step:'intro',order:shuffle(ids),k:0,phase:'view'};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    if(st.step==='trial'&&st.phase!=='q')st.phase='view';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
