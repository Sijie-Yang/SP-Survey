   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Alley Safety</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Hong Kong Alley Interventions and Perceived Safety\",\n  \"description\": \"Participants see 16 panoramic photo-simulations of one back-alley entrance in Yau Tsim Mong, Hong Kong, in random order: the alley as it is, cleaned, four vegetation designs (naturalistic or geometric green wall, with or without ground planting) and ten urban-function designs with greenery (art gallery, shop, cycle parking, gym, platform, café and pocket park, several in naturalistic and geometric styles). Each is rated for perceived safety on a 5-point scale. Rebuilt from Jiang, Mak, Zhong, Larsen & Webster (2018), Frontiers in Psychology 9: 2450, with the paper's Figure 4 images (CC BY 4.0). Analysis: mean safety per scene and per category (baseline, cleaning, vegetation, urban function); paired comparisons with the cleaned scene; geometric vs naturalistic pairs.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"alley\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I am 18 or older and agree to take part in this study.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"scenes\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"perceived_safety\",\n      \"title\": \"How safe would you feel in this place?\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Very unsafe\",\n      \"maxRateDescription\": \"Very safe\",\n      \"isRequired\": true,\n      \"description\": \"Keyed by scene: 00_baseline; 01_cleaning; vegetation 02–05 (naturalistic/geometric green wall, with ground planting); urban function with vegetation 06–15 (green art gallery, green shop, green cycling, green gym, naturalistic/geometric green platform, café, park). Above 3 = feels safe, below 3 = feels unsafe.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"residence\",\n      \"title\": \"Where do you live?\",\n      \"isRequired\": true,\n      \"description\": \"Added; most of the original sample were Hong Kong residents.\",\n      \"choices\": [\n       {\n        \"value\": \"hong_kong\",\n        \"text\": \"Hong Kong\"\n       },\n       {\n        \"value\": \"other_high_density_city\",\n        \"text\": \"Another high-density city\"\n       },\n       {\n        \"value\": \"elsewhere\",\n        \"text\": \"Elsewhere\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"alley-original\">{\"source\": \"Jiang, Mak, Zhong, Larsen & Webster (2018) Frontiers in Psychology 9: 2450\", \"n\": 218, \"participants\": \"Adults recruited by email and flyers in Hong Kong (57% female, mostly 21–30); each rated 30 of 80 scenes (5 alleys × 16) in random order\", \"result\": \"Every intervention felt safer than the existing alley (p < 0.0001). Category means: baseline 2.42, cleaning 2.90, vegetation 3.29, urban function with vegetation 3.75 (1–5). Cleaning helped only a little; urban-function designs (Routine Activity Theory) helped most; geometric planting was often rated safer than naturalistic planting.\"}</script>\n<style>\n:root{--bg:#f6f4ef;--card:#fff;--ink:#23211c;--muted:#655f53;--accent:#2f6b5e;--line:#e0dbd0;--warn:#b3261e;--sel:#e3f1ed}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.photo{width:100%;max-width:760px;border-radius:8px;display:block;margin:0 auto 6px}\n.cr{font-size:.72rem;color:var(--muted);text-align:center;margin-bottom:12px}\n.sd{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center;padding:7px 0;border-top:1px solid var(--line)}\n.sd:first-of-type{border-top:0}\n.sd .l{text-align:right;font-weight:600;font-size:.95rem}.sd .r{font-weight:600;font-size:.95rem}\n.row{display:flex;gap:4px}\n.row label{display:flex;align-items:center;justify-content:center;width:30px;height:30px;border:1px solid var(--line);border-radius:50%;cursor:pointer}\n.row label:has(input:checked){background:var(--accent);border-color:var(--accent)}\n.row input{appearance:none;margin:0;width:100%;height:100%;cursor:pointer}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:760px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:520px){.sd{grid-template-columns:1fr 1fr;gap:4px 8px}.sd .l{text-align:left;order:1}.sd .r{text-align:right;order:2}.row{order:3;grid-column:1/-1;justify-content:space-between;padding:0 4px}.row label{width:36px;height:36px}}\n.scale{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}.scale label{display:flex;flex-direction:column;align-items:center;gap:2px;border:1px solid var(--line);border-radius:10px;padding:8px 2px;cursor:pointer;font-size:.82rem;text-align:center}.scale label:has(input:checked){background:var(--sel);border-color:var(--accent)}.scale input{margin:0}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Images: Jiang, Mak, Zhong, Larsen &amp; Webster (2018), Frontiers in Psychology 9: 2450, Figure 4 (doi:10.3389/fpsyg.2018.02450, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='alley-safety:state';\n  var app=document.getElementById('app'), Q={}, files={}, ids=[], st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  var LAB=['Very unsafe','Unsafe','Neutral','Safe','Very safe'];\n  function intro(){\n    app.innerHTML='<h1>How safe does this alley feel?</h1><p>You will see '+st.order.length+' pictures of the entrance to a back alley in a busy district of Hong Kong. Some show the alley as it is and others show possible changes. For each picture, imagine standing on the pavement in front of the alley and say how safe you would feel there. It takes about 5 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='trial';st.k=0;save();route();});};\n  }\n  function trial(){\n    var id=st.order[st.k],h='<div class=\"scale\">';for(var i=1;i<=5;i++)h+='<label><input type=\"radio\" name=\"q_safe\" value=\"'+i+'\"><b>'+i+'</b><span>'+LAB[i-1]+'</span></label>';h+='</div>';\n    app.innerHTML='<div class=\"prog\">Picture '+(st.k+1)+' of '+st.order.length+'</div><div class=\"card\"><img class=\"photo wide\" alt=\"Alley entrance\" src=\"'+esc(files[id].url)+'\"><p style=\"color:var(--ink);margin-top:10px\"><b>'+esc(Q.perceived_safety.title)+'</b></p>'+h+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var v=val('q_safe');if(v==null)return err('Please choose one answer.');\n      send([SPSite.answer('perceived_safety',Number(v),{key:id,shown:[files[id].name]})],this,function(){st.k++;if(st.k>=st.order.length)st.step='about';save();route();});\n    };\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"110\"></div>'+radios('gender')+radios('residence')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var g=val('gender'),r=val('residence'),age=Number(document.getElementById('age').value);\n      if(!(age>=18&&age<=110))return err('Please enter your age.');if(!g||!r)return err('Please answer every question.');\n      send([SPSite.answer('age',age),SPSite.answer('gender',g),SPSite.answer('residence',r)],this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='trial')return trial();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','perceived_safety','age','gender','residence'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('alley')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name)){var k=f.name.replace(/\\.[^.]+$/,'');files[k]=f;ids.push(k);}});\n    if(ids.length<2){app.innerHTML='<h1>Pictures missing</h1><p>Upload the alley pictures to the media folder \"alley\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var valid=st&&st.order&&st.order.length===ids.length&&st.order.every(function(x){return files[x];});\n    if(!valid)st={step:'intro',order:shuffle(ids),k:0};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
