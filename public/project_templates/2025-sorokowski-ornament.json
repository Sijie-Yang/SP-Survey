   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Plain or Ornamented?</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Plain or Ornamented? Object Preference\",\n  \"description\": \"Faithful replication of Sorokowski, Luty, Jędryczka & Stefańczyk (2025), Evolutionary Psychology 23(4), with the authors' own stimuli. Participants see six pairs of everyday objects (three plates, then three T-shirts), one plain and one decorated with an ornament, and choose which they like better or that they like both equally.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"pairs\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"pairs\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I have read the information above and agree to take part.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"Yes\",\n      \"labelFalse\": \"No\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"respondent\",\n      \"title\": \"Who is answering this survey?\",\n      \"isRequired\": true,\n      \"description\": \"The original study tested parent–child dyads; each answered separately, parent first.\",\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"An adult (18 or older)\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"A child (under 18), with a parent nearby\"\n       }\n      ]\n     },\n     {\n      \"type\": \"custom\",\n      \"name\": \"pairs\",\n      \"title\": \"Which one do you like better?\",\n      \"isRequired\": true,\n      \"description\": \"One row per pair (key = pair1 … pair6; pairs 1–3 plates, 4–6 T-shirts). Plates come first, then shirts; the order of the three pairs within each block is random, and the left/right position of each object is fixed as in the paper's Figure 1 (ornament on the left in three pairs, on the right in three). value = { choice: 1 left | 2 both equally | 3 right, ornament_pref: 1 plain preferred | 2 no preference | 3 ornamented preferred, object: plate | shirt, motif: magnolia | leaves | abstract, ornament_side: left | right, position: 1–6 }.\"\n     },\n     {\n      \"type\": \"custom\",\n      \"name\": \"ornament_scores\",\n      \"title\": \"Ornament preference scores\",\n      \"description\": \"{ plates: 3–9, shirts: 3–9, total: 6–18 } = sums of ornament_pref, as in the paper (higher = stronger preference for ornamentation).\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 3,\n      \"max\": 100\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"sex\",\n      \"title\": \"What is your sex?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"country\",\n      \"title\": \"In which country do you live?\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"residence\",\n      \"title\": \"Where do you live?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"A large city\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"A small town\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"A village or rural area\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#f6f4ef;--card:#fff;--ink:#1f1d1a;--muted:#5f5a52;--accent:#7a4e2d;--accent-ink:#fff;--line:#ddd6cb;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:24px 16px 40px}\nh1{font-size:1.4rem;margin:0 0 10px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q>b{display:block;margin-bottom:4px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\ninput[type=number],input[type=text]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:100%;max-width:260px}\n.pair{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:8px}\n.pick{appearance:none;background:#fff;border:3px solid var(--line);border-radius:14px;padding:6px;cursor:pointer;display:block;width:100%}\n.pick img{width:100%;height:auto;display:block;border-radius:8px}\n.pick.on{border-color:var(--accent);box-shadow:0 0 0 3px rgba(122,78,45,.18)}\n.eq{appearance:none;width:100%;margin-top:12px;padding:12px;border:2px solid var(--line);border-radius:12px;background:#fff;font:inherit;font-weight:600;color:var(--ink);cursor:pointer}\n.eq.on{border-color:var(--accent);background:var(--accent);color:var(--accent-ink)}\n.t{color:var(--muted);font-size:.9rem;font-variant-numeric:tabular-nums}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:760px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Pictures: Sorokowski, Luty, Jędryczka &amp; Stefańczyk (2025), Evolutionary Psychology, Figure 1. Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='ornament2025:';\n  // Pairs as in the paper's Figure 1 (left, right); pairs 1-3 plates, 4-6 shirts.\n  var PAIRS=[\n    {id:'pair1',object:'plate',motif:'magnolia',L:'pair1_L_plate_plain.jpg',R:'pair1_R_plate_magnolia.jpg',orn:'right'},\n    {id:'pair2',object:'plate',motif:'leaves',L:'pair2_L_plate_leaves.jpg',R:'pair2_R_plate_plain.jpg',orn:'left'},\n    {id:'pair3',object:'plate',motif:'abstract',L:'pair3_L_plate_abstract.jpg',R:'pair3_R_plate_plain.jpg',orn:'left'},\n    {id:'pair4',object:'shirt',motif:'leaves',L:'pair4_L_shirt_plain.jpg',R:'pair4_R_shirt_leaves.jpg',orn:'right'},\n    {id:'pair5',object:'shirt',motif:'magnolia',L:'pair5_L_shirt_magnolia.jpg',R:'pair5_R_shirt_plain.jpg',orn:'left'},\n    {id:'pair6',object:'shirt',motif:'abstract',L:'pair6_L_shirt_plain.jpg',R:'pair6_R_shirt_abstract.jpg',orn:'right'}];\n  var app=document.getElementById('app'), Q={}, URL={}, ans={}, res={}, order=[];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function saveAll(l,b,cb){Promise.all(l.map(function(a){return a[2]?SPSite.answer(a[0],a[1],a[2]):SPSite.answer(a[0],a[1]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}cb();});}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function byId(id){for(var i=0;i<PAIRS.length;i++)if(PAIRS[i].id===id)return PAIRS[i];}\n  function next(){\n    window.scrollTo(0,0);\n    if(!ans.intro)return intro();\n    if(!ans.howto)return howto();\n    for(var i=0;i<order.length;i++){if(!res[order[i]])return trial(i);}\n    if(!ans.scores)return scores();\n    if(!ans.about)return about();\n    finish();\n  }\n  function page(title,html,btn,cb){\n    app.innerHTML='<div class=\"card\">'+(title?'<h1>'+esc(title)+'</h1>':'')+html+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">'+esc(btn||'Continue')+'</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=cb;\n  }\n  function radios(name){return (Q[name].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+name+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');}\n  function val(n){var x=app.querySelector('input[name='+n+']:checked');return x?Number(x.value):null;}\n  function intro(){\n    var miss=[];PAIRS.forEach(function(p){if(!URL[p.L])miss.push(p.L);if(!URL[p.R])miss.push(p.R);});\n    if(miss.length){app.innerHTML='<h1>Pictures missing</h1><p>The media folder \"pairs\" must hold the 12 study pictures; missing: '+esc(miss.join(', '))+'.</p>';return;}\n    page('Which one do you like better?','<p>In this short study you will see six pairs of everyday objects: plates and T-shirts. For each pair, please tell us which one you like better, or whether you like both equally. There are no right or wrong answers. It takes about 3 minutes.</p><p>Children can take part with a parent nearby. If a child is answering, the parent may read the questions out loud but should let the child choose.</p><p>Participation is voluntary and anonymous, and you can stop at any time.</p><label class=\"opt\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div class=\"q\"><b>'+esc(Q.respondent.title)+'</b>'+radios('respondent')+'</div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var r=val('respondent');if(!r)return err('Please say who is answering.');\n      var b=this;b.disabled=true;saveAll([['consent',true],['respondent',r]],b,function(){ans.intro=true;ans.respondent=r;next();});\n    });\n  }\n  function howto(){\n    page('','<p style=\"color:var(--ink)\">You will see six pairs of pictures, one pair at a time. Tap the one you like better. If you like both the same, tap <b>I like both equally</b>. Then press Next.</p>','Begin',function(){ans.howto=true;next();});\n  }\n  function trial(i){\n    var p=byId(order[i]), sel=null;\n    app.innerHTML='<div class=\"card\"><p class=\"t\">Pair '+(i+1)+' of '+order.length+'</p><h1>Which '+(p.object==='plate'?'plate':'T-shirt')+' do you like better?</h1>'+\n      '<div class=\"pair\"><button type=\"button\" class=\"pick\" data-c=\"1\" aria-label=\"Left picture\"><img alt=\"Left '+p.object+'\" src=\"'+esc(URL[p.L])+'\"></button><button type=\"button\" class=\"pick\" data-c=\"3\" aria-label=\"Right picture\"><img alt=\"Right '+p.object+'\" src=\"'+esc(URL[p.R])+'\"></button></div>'+\n      '<button type=\"button\" class=\"eq\" data-c=\"2\">I like both equally</button>'+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\" disabled>Next</button></div><div class=\"err\"></div></div>';\n    var go=document.getElementById('go');\n    app.querySelectorAll('[data-c]').forEach(function(x){x.onclick=function(){sel=Number(x.dataset.c);app.querySelectorAll('[data-c]').forEach(function(y){y.classList.toggle('on',y===x);});go.disabled=false;err('');};});\n    go.onclick=function(){\n      if(!sel)return err('Please choose one.');\n      var pref=sel===2?2:((sel===1)===(p.orn==='left')?3:1);\n      var v={choice:sel,ornament_pref:pref,object:p.object,motif:p.motif,ornament_side:p.orn,position:i+1};\n      var b=this;b.disabled=true;\n      saveAll([['pairs',v,{key:p.id,shown:[p.L,p.R]}]],b,function(){res[p.id]=v;save('res',res);next();});\n    };\n  }\n  function scores(){\n    var s={plates:0,shirts:0,total:0};PAIRS.forEach(function(p){var r=res[p.id];if(!r)return;s[p.object==='plate'?'plates':'shirts']+=r.ornament_pref;s.total+=r.ornament_pref;});\n    saveAll([['ornament_scores',s]],null,function(){ans.scores=true;next();});\n  }\n  function about(){\n    var child=ans.respondent===2;\n    page('About '+(child?'the child answering':'you'),'<div class=\"q\"><b>'+esc(child?'How old is the child?':Q.age.title)+'</b><input type=\"number\" id=\"age\" min=\"3\" max=\"100\" inputmode=\"numeric\"></div>'+\n      '<div class=\"q\"><b>'+esc(child?'What is the child\\'s sex?':Q.sex.title)+'</b>'+radios('sex')+'</div>'+\n      '<div class=\"q\"><b>'+esc(Q.country.title)+'</b><input type=\"text\" id=\"country\" autocomplete=\"country-name\"></div>'+\n      '<div class=\"q\"><b>'+esc(Q.residence.title)+'</b>'+radios('residence')+'</div>','Finish',function(){\n      var av=document.getElementById('age').value,age=Number(av);if(!av||!(age>=3&&age<=100))return err('Please enter an age between 3 and 100.');\n      var sx=val('sex');if(!sx)return err('Please answer: '+Q.sex.title);\n      var c=document.getElementById('country').value.trim();if(!c)return err('Please enter your country.');\n      var rs=val('residence');if(!rs)return err('Please answer: '+Q.residence.title);\n      var b=this;b.disabled=true;saveAll([['age',age],['sex',sx],['country',c],['residence',rs]],b,function(){ans.about=true;next();});\n    });\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>This study asks whether people everywhere prefer decorated objects to plain ones, and whether this changes with age and culture. In the original study, adults and children in Scotland, Pakistan and Papua mostly preferred the ornamented objects, and the preference was strongest in the less Western samples.</p><p style=\"font-size:.82rem\">Pictures and design: Sorokowski, Luty, Jędryczka &amp; Stefańczyk (2025), Evolutionary Psychology 23(4), doi:10.1177/14747049251388596. Used with credit and removed if the authors object.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){\n      if(x==='consent'||x==='respondent')ans.intro=false;else if(x==='pairs'){res={};save('res',res);ans.scores=false;}else if(x==='ornament_scores')ans.scores=false;else ans.about=false;});next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    ['consent','respondent','age','sex','country','residence'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('pairs')||[]).forEach(function(f){URL[f.name]=f.url;});\n    var a=(ctx&&ctx.answers)||{};\n    var o=load('order');if(!o||o.length!==6)o=shuffle(['pair1','pair2','pair3']).concat(shuffle(['pair4','pair5','pair6']));order=o;save('order',order);\n    var tr=(a.pairs&&a.pairs.trials)||[];\n    if(tr.length){tr.forEach(function(t){if(t.key)res[t.key]=t.value;});}else if(a.consent===true){res=load('res')||{};}\n    if(a.consent===true&&a.respondent!=null){ans.intro=true;ans.respondent=Number(a.respondent.trials?a.respondent.trials[0].value:a.respondent);if(tr.length)ans.howto=true;}\n    if(a.ornament_scores!=null)ans.scores=true;\n    if(a.age!=null&&a.residence!=null)ans.about=true;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
