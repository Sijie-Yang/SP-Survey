   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Pocket Park Planting</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Pocket Park Planting Enclosure: Coherence, Legibility and Refuge\",\n  \"description\": \"Participants see five vacant plots in Tehran, each in five photomontaged planting designs that vary visual and physical enclosure (Robinson's permeability of enclosure), and for each plot choose the design that is most coherent, most legible and offers the best refuge. Rebuilt from Naghibi, Faizi & Ekhlassi (2022), MethodsX 9: 101638, with the 25 montages printed in its Fig. 8 (CC BY 4.0). Analysis: share of participants choosing each scene per plot and criterion; chi-square tests by professional background, age and gender.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"pocket\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part in this study.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"plots\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"coherence\",\n      \"title\": \"Which scene looks most coherent?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"scene1\",\n        \"text\": \"Scene 1: visually enclosed, physically enclosed\"\n       },\n       {\n        \"value\": \"scene2\",\n        \"text\": \"Scene 2: partly visually enclosed, physically enclosed\"\n       },\n       {\n        \"value\": \"scene3\",\n        \"text\": \"Scene 3: visually open, physically open\"\n       },\n       {\n        \"value\": \"scene4\",\n        \"text\": \"Scene 4: partly visually enclosed, physically open\"\n       },\n       {\n        \"value\": \"scene5\",\n        \"text\": \"Scene 5: visually open, physically enclosed\"\n       }\n      ],\n      \"description\": \"Our wording; the paper names the criterion but does not print the question. Keyed by plot type (paper Fig. 8): type1 object focused (centre), type2 one side protected, type3 two sides protected, type4 two sides protected (between), type5 three sides protected. Value = the planting scene chosen (scene numbers as in the paper, whatever position it was shown in); shown = the five images in display order.\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"legibility\",\n      \"title\": \"Which scene looks most legible?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"scene1\",\n        \"text\": \"Scene 1: visually enclosed, physically enclosed\"\n       },\n       {\n        \"value\": \"scene2\",\n        \"text\": \"Scene 2: partly visually enclosed, physically enclosed\"\n       },\n       {\n        \"value\": \"scene3\",\n        \"text\": \"Scene 3: visually open, physically open\"\n       },\n       {\n        \"value\": \"scene4\",\n        \"text\": \"Scene 4: partly visually enclosed, physically open\"\n       },\n       {\n        \"value\": \"scene5\",\n        \"text\": \"Scene 5: visually open, physically enclosed\"\n       }\n      ],\n      \"description\": \"Our wording. Keyed by plot type (paper Fig. 8): type1 object focused (centre), type2 one side protected, type3 two sides protected, type4 two sides protected (between), type5 three sides protected. Value = the planting scene chosen (scene numbers as in the paper, whatever position it was shown in); shown = the five images in display order.\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"refuge\",\n      \"title\": \"Which scene offers the best refuge?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"scene1\",\n        \"text\": \"Scene 1: visually enclosed, physically enclosed\"\n       },\n       {\n        \"value\": \"scene2\",\n        \"text\": \"Scene 2: partly visually enclosed, physically enclosed\"\n       },\n       {\n        \"value\": \"scene3\",\n        \"text\": \"Scene 3: visually open, physically open\"\n       },\n       {\n        \"value\": \"scene4\",\n        \"text\": \"Scene 4: partly visually enclosed, physically open\"\n       },\n       {\n        \"value\": \"scene5\",\n        \"text\": \"Scene 5: visually open, physically enclosed\"\n       }\n      ],\n      \"description\": \"Our wording. Keyed by plot type (paper Fig. 8): type1 object focused (centre), type2 one side protected, type3 two sides protected, type4 two sides protected (between), type5 three sides protected. Value = the planting scene chosen (scene numbers as in the paper, whatever position it was shown in); shown = the five images in display order.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"What is your gender?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"woman\",\n        \"text\": \"Woman\"\n       },\n       {\n        \"value\": \"man\",\n        \"text\": \"Man\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"professional\",\n      \"title\": \"Do you study or work in architecture, landscape architecture or urban planning?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"park_use\",\n      \"title\": \"How often do you visit small neighbourhood parks?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"weekly\",\n        \"text\": \"At least once a week\"\n       },\n       {\n        \"value\": \"monthly\",\n        \"text\": \"A few times a month\"\n       },\n       {\n        \"value\": \"rarely\",\n        \"text\": \"Rarely or never\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"pocket-original\">{\"source\": \"Naghibi, Faizi & Ekhlassi (2022) MethodsX 9: 101638\", \"n\": 318, \"participants\": \"Tehran residents, online questionnaire, May-June 2020 (Table 1 reports 309 valid cases)\", \"mean_rank_table6\": {\"type1\": {\"coherence\": 947.98, \"legibility\": 956.82, \"refuge\": 813.58}, \"type2\": {\"coherence\": 771.52, \"legibility\": 805.63, \"refuge\": 784.08}, \"type3\": {\"coherence\": 789.14, \"legibility\": 730.08, \"refuge\": 831.66}, \"type4\": {\"coherence\": 725.43, \"legibility\": 761.32, \"refuge\": 747.83}, \"type5\": {\"coherence\": 743.44, \"legibility\": 723.65, \"refuge\": 800.34}}, \"result\": \"Coherence and legibility differed between plot types (type 1, object focused, highest); refuge did not differ overall. The three criteria were positively correlated in every plot; professional background was most strongly associated with the choices.\"}</script>\n<style>\n:root{--bg:#f4f4ef;--card:#fff;--ink:#22241d;--muted:#62665a;--accent:#4b6b2a;--line:#dddfd5;--warn:#b3261e;--sel:#ebf1e2}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px}\n.sc{position:relative;margin:0}.sc img{width:100%;display:block;border-radius:6px}\n.sc .n{position:absolute;top:6px;left:6px;width:28px;height:28px;border-radius:14px;background:rgba(0,0,0,.7);color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:.9rem}\n.q{margin-top:16px}.q b{display:block}.q small{display:block;color:var(--muted);margin-bottom:6px}\n.picks{display:flex;gap:6px;flex-wrap:wrap}\n.picks label{display:flex;align-items:center;justify-content:center;min-width:52px;padding:8px 10px;border:1px solid var(--line);border-radius:8px;cursor:pointer;font-weight:600}\n.picks label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.picks input{margin:0 6px 0 0}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Images: Naghibi, Faizi &amp; Ekhlassi (2022), MethodsX 9: 101638, Fig. 8 (doi:10.1016/j.mex.2022.101638, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='pocket-park:state';\n  var CRIT=[['coherence','Which scene looks most coherent?','The place hangs together: it looks organised and is easy to take in at a glance.'],['legibility','Which scene looks most legible?','It would be easy to understand the place and find your way around it.'],['refuge','Which scene offers the best refuge?','You could feel sheltered and protected there, able to see out without being exposed.']];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function intro(){\n    app.innerHTML='<h1>Planting small city parks</h1><p>Small empty plots in Tehran could become pocket parks. For each of five plots you will see five planting designs, from open to fully enclosed by trees and shrubs. For each plot, choose the design that best fits three descriptions. It takes about 8 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='site';st.k=0;save();route();});};\n  }\n  function site(){\n    var t=st.types[st.k],order=st.scenes[t],names=order.map(function(s){return 'type'+t+'_scene'+s;});\n    app.innerHTML='<div class=\"prog\">Plot '+(st.k+1)+' of '+st.types.length+'</div><div class=\"card\"><div class=\"grid\">'+names.map(function(n,i){return '<figure class=\"sc\"><img alt=\"Planting design '+(i+1)+'\" src=\"'+esc(files[n].url)+'\"><span class=\"n\">'+(i+1)+'</span></figure>';}).join('')+'</div>'+CRIT.map(function(c){return '<div class=\"q\"><b>'+esc(c[1])+'</b><small>'+esc(c[2])+'</small><div class=\"picks\">'+order.map(function(s,i){return '<label><input type=\"radio\" name=\"q_'+c[0]+'\" value=\"'+s+'\">'+(i+1)+'</label>';}).join('')+'</div></div>';}).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var v=CRIT.map(function(c){return val('q_'+c[0]);});if(v.some(function(x){return x==null;}))return err('Please answer all three questions.');\n      var sh=names.map(function(n){return files[n].name;});\n      send(CRIT.map(function(c,i){return SPSite.answer(c[0],'scene'+v[i],{key:'type'+t,shown:sh});}),this,function(){st.k++;if(st.k>=st.types.length)st.step='about';save();route();});\n    };\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"110\"></div>'+radios('gender')+radios('professional')+radios('park_use')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var age=Number(document.getElementById('age').value),g=val('gender'),p=val('professional'),u=val('park_use');\n      if(!(age>=18&&age<=110))return err('Please enter your age.');if(!g||!p||!u)return err('Please answer every question.');\n      send([SPSite.answer('age',age),SPSite.answer('gender',g),SPSite.answer('professional',p),SPSite.answer('park_use',u)],this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='site')return site();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','coherence','legibility','refuge','age','gender','professional','park_use'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('pocket')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name))files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var types=[1,2,3,4,5].filter(function(t){return [1,2,3,4,5].every(function(s){return files['type'+t+'_scene'+s];});});\n    if(types.length<1){app.innerHTML='<h1>Images missing</h1><p>Upload the 25 design images to the media folder \"pocket\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!(st&&st.types&&st.types.length===types.length&&st.scenes)){var sc={};types.forEach(function(t){sc[t]=shuffle([1,2,3,4,5]);});st={step:'intro',types:shuffle(types),scenes:sc,k:0};}\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
