   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Restorative Consultation Rooms</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Restorative Consultation Rooms\",\n    \"description\": \"Rate how restorative 12 rendered consultation rooms feel, from 1 to 7. The rooms come in three sets: the view out of the window, the materials, and the ceiling shape. Rebuilt from the screen-based condition of Tural & Tural (2025), IJERPH.\",\n    \"locale\": \"en\",\n    \"mediaFolders\": [\"rooms\"],\n    \"pages\": [\n      { \"name\": \"ratings\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" },\n        { \"type\": \"imagerating\", \"name\": \"restorativeness\", \"title\": \"Please rate the degree of restorativeness this setting offers you.\", \"imageCount\": 1,\n          \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Not restorative at all\", \"maxRateDescription\": \"Extremely restorative\", \"isRequired\": true }\n      ]},\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"choices\": [\n          { \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"male\", \"text\": \"Male\" }, { \"value\": \"other\", \"text\": \"Other / prefer not to say\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"age_group\", \"title\": \"Age group\", \"choices\": [\n          { \"value\": \"under_25\", \"text\": \"Under 25\" }, { \"value\": \"25_39\", \"text\": \"25–39\" }, { \"value\": \"40_59\", \"text\": \"40–59\" }, { \"value\": \"60_plus\", \"text\": \"60 or older\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"design_background\", \"title\": \"Do you study or work in interior design or architecture?\", \"choices\": [\n          { \"value\": \"yes\", \"text\": \"Yes\" }, { \"value\": \"no\", \"text\": \"No\" } ] }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f1f4f8;--card:#fff;--ink:#16202c;--muted:#526070;--accent:#2b5c9e;--accent-ink:#fff;--line:#cfe0e5}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:880px;margin:0 auto;padding:24px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:8px 0 14px}.progress>i{display:block;height:100%;background:var(--accent)}\n.stage{position:relative;width:100%;padding:10px 0;background:#e3e8ef;border-radius:12px;overflow:hidden;display:flex;align-items:center;justify-content:center}\n.stage img{max-width:100%;max-height:100%;object-fit:contain;display:block}\n.scale{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin-top:12px}\n.scale button{appearance:none;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:9px;padding:12px 0;font:inherit;font-weight:700;cursor:pointer}\n.scale button:hover:not(:disabled){border-color:var(--accent)}.scale button:disabled{opacity:.4;cursor:wait}\n\n.ends{display:flex;justify-content:space-between;font-size:.85rem;color:var(--muted);margin-top:4px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:120px}\n.q{margin-top:16px}.q>b{display:block;margin-bottom:4px}\n.err{color:#b3261e;margin-top:8px;min-height:1.2em}\n.credit{max-width:880px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Renderings: Tural &amp; Tural (2025), Int. J. Environ. Res. Public Health 22(1): 44, Figs 2–4, Creative Commons Attribution License (CC BY 4.0).</footer>\n<script>\n(function(){\n  var app=document.getElementById('app'), Q={}, files=[], answered={}, i=0, keyHandler=null;\n  var ABOUT=['gender','age_group','design_background'];\n  // Presentation order as in the paper's Table 1: sets in sequence, conditions in a fixed order within each set.\n  var ORDER=['view_desert','view_water','view_woods','view_lawn','material_brick','material_concrete','material_natural','material_resilient','ceiling_curve','ceiling_flat','ceiling_angled','ceiling_vault'];\n  var SETS={view:'Set 1 of 3 · the view out of the window',material:'Set 2 of 3 · materials',ceiling:'Set 3 of 3 · ceiling shape'};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function shuffle(a){a=a.slice();for(var k=a.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1));var x=a[k];a[k]=a[j];a[j]=x;}return a;}\n  function store(k,v){try{localStorage.setItem('rooms2025:'+k,JSON.stringify(v));}catch(e){}}\n  function load(k){try{return JSON.parse(localStorage.getItem('rooms2025:'+k));}catch(e){return null;}}\n  function setup(){\n    var all=SPSite.getMedia('rooms')||[], byName={}; all.forEach(function(f){byName[f.name]=f;});\n    var saved=null;\n    if(saved&&saved.length===all.length&&saved.every(function(n){return byName[n];}))files=saved.map(function(n){return byName[n];});\n    else{files=ORDER.map(function(n){return byName[n+'.jpg'];}).filter(Boolean);all.forEach(function(f){if(files.indexOf(f)<0)files.push(f);});} // fixed sequence, as in the paper; extra files are shown last\n  }\n  function intro(){\n    if(!files.length){app.innerHTML='<h1>No photos yet</h1><p>The researcher has not added images to the folder “rooms”.</p>';return;}\n    app.innerHTML='<h1>How restorative are these rooms?</h1><p>You will see '+files.length+' pictures of the same small consultation room, as in a mental-health clinic. Only one thing changes at a time: the view out of the window, the materials, or the shape of the ceiling. Imagine sitting in each room and rate the degree of restorativeness it offers you, from 1 to 7. About 5 minutes.</p>'+\n      '<div class=\"card\"><label class=\"opt\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var b=this;b.disabled=true;SPSite.answer('consent',true).then(function(r){if(r&&r.ok===false){b.disabled=false;return err(r.error);}i=0;trial();});\n    };\n  }\n  function trial(){\n    while(i<files.length&&answered[files[i].name]!=null)i++;\n    if(i>=files.length)return about();\n    var f=files[i], q=Q.restorativeness, btns='';\n    for(var v=1;v<=7;v++)btns+='<button data-v=\"'+v+'\">'+v+'</button>';\n    app.innerHTML='<p>'+(SETS[f.name.split('_')[0]]||'')+' · room '+(i+1)+' of '+files.length+'</p><div class=\"progress\"><i style=\"width:'+(100*i/files.length)+'%\"></i></div>'+\n      '<div class=\"stage\"><img src=\"'+esc(f.url)+'\" alt=\"Rendered consultation room\" style=\"width:100%;height:auto\"></div><h1 style=\"font-size:1.15rem;margin-top:12px\">'+esc(q.title)+'</h1>'+\n      '<div class=\"scale\">'+btns+'</div><div class=\"ends\"><span>1 · '+esc(q.minLabel)+'</span><span>7 · '+esc(q.maxLabel)+'</span></div><div class=\"err\"></div>';\n    function pick(v){\n      var bs=app.querySelectorAll('.scale button');if(!bs.length||bs[0].disabled)return;bs.forEach(function(b){b.disabled=true;});\n      SPSite.answer('restorativeness',v,{key:f.name.replace(/\\.[^.]+$/,''),shown:[f.name]}).then(function(r){if(r&&r.ok===false){err(r.error);bs.forEach(function(b){b.disabled=false;});return;}answered[f.name]=v;i++;trial();});\n    }\n    app.querySelectorAll('.scale button').forEach(function(b){b.onclick=function(){pick(Number(b.getAttribute('data-v')));};});\n    if(keyHandler)document.removeEventListener('keydown',keyHandler);\n    keyHandler=function(e){var v=Number(e.key);if(v>=1&&v<=7)pick(v);};document.addEventListener('keydown',keyHandler);\n  }\n  function radios(n){return (Q[n].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');}\n  function about(){\n    if(keyHandler){document.removeEventListener('keydown',keyHandler);keyHandler=null;}\n    app.innerHTML='<h1>About you</h1><p>Optional.</p><div class=\"card\">'+ABOUT.map(function(n){return '<div class=\"q\"><b>'+esc(Q[n].title)+'</b>'+(Q[n].choices&&Q[n].choices.length?radios(n):'<input type=\"text\" id=\"'+n+'\" maxlength=\"80\" style=\"width:100%;max-width:360px;font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px\">')+'</div>';}).join('')+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"fin\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('fin').onclick=function(){\n      var b=this;b.disabled=true;var calls=[];\n      ABOUT.forEach(function(n){var r=app.querySelector('input[name='+n+']:checked'),t=document.getElementById(n);var v=r?r.value:(t?t.value.trim():'');if(v)calls.push(SPSite.answer(n,v));});\n      Promise.all(calls).then(function(){\n        app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"st\">Submitting…</p><div class=\"err\"></div></div>';\n        SPSite.complete().then(function(r){if(r&&r.ok===false){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){if(m.indexOf('consent')>=0)intro();else{i=0;trial();}},1500);}else{var s=document.getElementById('st');if(s)s.textContent='Your ratings are saved.';}});\n      });\n    };\n  }\n  SPSite.onReady(function(ctx){\n    ['consent','restorativeness'].concat(ABOUT).forEach(function(n){Q[n]=SPSite.getQuestion(n);});\n    setup();\n    var a=(ctx&&ctx.answers)||{}, p=a.restorativeness;\n    (p&&Array.isArray(p.trials)?p.trials:[]).forEach(function(x){if(x&&x.key!=null&&x.value!=null)answered[x.key+'.jpg']=x.value;});\n    if(a.consent===true)trial();else intro();\n  });\n})();\n</script>\n</body>\n</html>\n",
