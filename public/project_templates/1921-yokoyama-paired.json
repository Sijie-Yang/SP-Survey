   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Paired comparisons of colours and forms (Yokoyama 1921)</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\"format\":\"sp-scheme-package\",\"spScheme\":\"2.0\",\"survey\":{\"title\":\"Paired comparisons of colours and forms (Yokoyama 1921)\",\"description\":\"Yokoyama's 1921 Clark University experiment, Part I: seven coloured squares and seven outline forms are compared two at a time; for each pair, choose the more pleasant one.\",\"locale\":\"en\",\"pages\":[\n{\"name\":\"intro\",\"elements\":[{\"type\":\"boolean\",\"name\":\"consent\",\"title\":\"I agree to take part. My answers are recorded anonymously for research.\",\"isRequired\":true}]},\n{\"name\":\"colours\",\"elements\":[{\"type\":\"custom\",\"name\":\"colour_pairs\",\"title\":\"Series S: which colour is more pleasant? (21 pairs, each in both left–right orders = 42 comparisons)\",\"isRequired\":true,\"description\":\"Value: array of 42 trials in presentation order, each {left, right, choice, rt}. left/right = colour codes as in the paper: R red, O orange, Y yellow, G green, C cyan (blue-green), B blue, P purple (red-violet). choice = 'left' | 'right' | 'equal' (could not decide / equal). rt = milliseconds from exposure to response. Analysis as in the paper: for each colour, the percent of its comparisons in which it was preferred gives the preferential order; check consistency between the two spatial orders.\"}]},\n{\"name\":\"forms\",\"elements\":[{\"type\":\"custom\",\"name\":\"form_pairs\",\"title\":\"Series N: which form is more pleasant? (21 pairs × 2 orders = 42 comparisons)\",\"isRequired\":true,\"description\":\"Value: as colour_pairs, with form codes as in the paper: a equilateral triangle, b circle, c annular sector, d regular pentagon, e regular hexagon, f upright rectangle (6 × 4.15), g horizontal ellipse.\"}]},\n{\"name\":\"about\",\"elements\":[\n{\"type\":\"radiogroup\",\"name\":\"gender\",\"title\":\"Your gender\",\"isRequired\":true,\"choices\":[{\"value\":\"female\",\"text\":\"Female\"},{\"value\":\"male\",\"text\":\"Male\"},{\"value\":\"other\",\"text\":\"Other / prefer not to say\"}]},\n{\"type\":\"radiogroup\",\"name\":\"age\",\"title\":\"Your age\",\"isRequired\":true,\"choices\":[{\"value\":1,\"text\":\"Under 18\"},{\"value\":2,\"text\":\"18–24\"},{\"value\":3,\"text\":\"25–39\"},{\"value\":4,\"text\":\"40–59\"},{\"value\":5,\"text\":\"60 or older\"}]},\n{\"type\":\"radiogroup\",\"name\":\"colour_vision\",\"title\":\"Do you have any difficulty seeing colours (colour blindness)?\",\"isRequired\":true,\"choices\":[{\"value\":\"no\",\"text\":\"No\"},{\"value\":\"yes\",\"text\":\"Yes\"},{\"value\":\"unsure\",\"text\":\"Not sure\"}]}]}]}}\n</script>\n<style>\n:root{--bg:#efeeec;--card:#fff;--ink:#1d1e21;--muted:#5d6066;--accent:#3e4a6b;--accent-ink:#fff;--line:#d9d6cf;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:20px 16px 40px}h1{font-size:1.3rem;margin:0 0 8px}p{margin:0 0 10px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}.btn:disabled{opacity:.4;cursor:not-allowed}\n.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent)}\n.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;align-items:center;justify-content:center}\n.screen{background:#7f7f7d;border-radius:10px;padding:5% 4%;display:flex;justify-content:center;gap:9%;position:relative}\n.win{width:34%;aspect-ratio:1;background:#a6a6a6;position:relative;overflow:hidden;box-shadow:inset 0 0 0 1px rgba(0,0,0,.15)}\n.win svg{position:absolute;inset:0;width:100%;height:100%}\n.shut{position:absolute;inset:0;background:#8a8a88;display:flex;align-items:center;justify-content:center;color:#3a3a3a;font-size:.9rem;font-weight:600}\n.step{display:inline-block;padding:2px 10px;border-radius:999px;background:#e3e6ef;color:#2e3753;font-size:.85rem;font-weight:600;margin-bottom:8px}\n.prog{font-size:.88rem;color:var(--muted);text-align:center;margin-top:8px}\n.choice .btn{min-width:120px}.choice [data-c=equal]{order:3}.choice::after{content:\"\";order:2;flex-basis:100%;height:0}\nlabel.o{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:14px}.q>b{display:block;margin-bottom:4px}.err{color:var(--warn);margin-top:8px;min-height:1.2em;text-align:center}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Method: Yokoyama, M. (1921). Affective tendency as conditioned by color and form. <i>American Journal of Psychology</i>, 32, 81–107 (Part I, Series S and N). Public domain (JSTOR Early Journal Content). Colours are screen approximations of the Milton-Bradley papers, matched to the brightness values reported in the paper.</footer>\n<script>\n(function(){\n  /* window = 10.5 cm square; drawing units in mm, viewBox 105 x 105 */\n  var COL={R:'#c20000',O:'#f77300',Y:'#fbf500',G:'#00d223',C:'#00bdad',B:'#114dff',P:'#e7009a'};\n  var CNAME={R:'red',O:'orange',Y:'yellow',G:'green',C:'cyan',B:'blue',P:'purple'};\n  function poly(n,side,cx,cy,rot){var R=side/(2*Math.sin(Math.PI/n)),p=[];for(var k=0;k<n;k++){var a=rot+k*2*Math.PI/n;p.push((cx+R*Math.cos(a)).toFixed(2)+','+(cy+R*Math.sin(a)).toFixed(2));}return p.join(' ');}\n  var ST='fill=\"none\" stroke=\"#111\" stroke-width=\"0.6\"';\n  var FORMS={\n    a:function(){var s=70,h=s*Math.sqrt(3)/2,y0=52.5+h/3;return '<polygon points=\"'+(52.5-s/2)+','+y0+' '+(52.5+s/2)+','+y0+' 52.5,'+(y0-h)+'\" '+ST+'/>';},\n    b:function(){return '<circle cx=\"52.5\" cy=\"52.5\" r=\"28\" '+ST+'/>';},\n    c:function(){var R=73,r=25,cy=52.5+(R+r*Math.cos(Math.PI/6))/2-4,x1=Math.sin(Math.PI/6);function pt(rad,s){return (52.5+s*rad*x1).toFixed(2)+','+(cy-rad*Math.cos(Math.PI/6)).toFixed(2);}\n      return '<path d=\"M'+pt(r,-1)+' L'+pt(R,-1)+' A'+R+','+R+' 0 0 1 '+pt(R,1)+' L'+pt(r,1)+' A'+r+','+r+' 0 0 0 '+pt(r,-1)+' Z\" '+ST+'/>';},\n    d:function(){return '<polygon points=\"'+poly(5,38,52.5,52.5,Math.PI/2)+'\" '+ST+'/>';},\n    e:function(){return '<polygon points=\"'+poly(6,32,52.5,52.5,Math.PI/2)+'\" '+ST+'/>';},\n    f:function(){return '<rect x=\"'+(52.5-20.75)+'\" y=\"22.5\" width=\"41.5\" height=\"60\" '+ST+'/>';},\n    g:function(){return '<ellipse cx=\"52.5\" cy=\"52.5\" rx=\"17.5\" ry=\"11.75\" '+ST+'/>';}};\n  var FNAME={a:'triangle',b:'circle',c:'sector',d:'pentagon',e:'hexagon',f:'rectangle',g:'ellipse'};\n  function svgColour(k){return '<svg viewBox=\"0 0 105 105\" aria-hidden=\"true\"><rect x=\"27.5\" y=\"27.5\" width=\"50\" height=\"50\" fill=\"'+COL[k]+'\"/></svg>';}\n  function svgForm(k){return '<svg viewBox=\"0 0 105 105\" aria-hidden=\"true\">'+FORMS[k]()+'</svg>';}\n  var SERIES=[{q:'colour_pairs',keys:['R','O','Y','G','C','B','P'],draw:svgColour,word:'colour',name:CNAME,label:'Part 1 of 2 · colours',instr:'Give yourself up entirely to the colour. Take the colour simply in its own right, without thinking about what it might be used for. Immediately after you see the two colours, choose the one you prefer as the <b>more pleasant</b>.'},\n              {q:'form_pairs',keys:['a','b','c','d','e','f','g'],draw:svgForm,word:'form',name:FNAME,label:'Part 2 of 2 · forms',instr:'Give yourself up entirely to the form. Take the form simply in its own right, without thinking about what it might represent. Immediately after you see the two forms, choose the one you prefer as the <b>more pleasant</b>.'}];\n  var app=document.getElementById('app'),A={},run={};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function has(n){var v=A[n];return v!=null&&v!==''&&!(Array.isArray(v)&&!v.length);}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function plan(keys){var t=[];for(var i=0;i<keys.length;i++)for(var j=i+1;j<keys.length;j++){t.push([keys[i],keys[j]]);t.push([keys[j],keys[i]]);}\n    for(var tries=0;tries<500;tries++){var s=shuffle(t),okk=true;for(var k=1;k<s.length;k++){var a=s[k-1],b=s[k];if(a[0]===b[0]||a[0]===b[1]||a[1]===b[0]||a[1]===b[1]){okk=false;break;}}if(okk)return s;}\n    return shuffle(t);} /* haphazard order, no stimulus in two successive comparisons (as in the paper) */\n  function next(){window.scrollTo(0,0);\n    if(A.consent!==true)return intro();\n    for(var i=0;i<SERIES.length;i++)if(!has(SERIES[i].q))return seriesIntro(i);\n    if(!has('gender')||!has('age')||!has('colour_vision'))return about();\n    finish();}\n  function intro(){\n    app.innerHTML='<h1>Which is more pleasant?</h1><p>You will see two things side by side in two windows of a grey screen, for about three seconds. Each time, choose the one that is <b>more pleasant</b> to you. First you compare seven colours, then seven simple forms. Each pair comes twice, once in each left–right position.</p><p>Answer quickly, from your immediate impression. If both are unpleasant, choose the less unpleasant one. If you really cannot decide, press \"Can\\'t decide\". There are 84 short comparisons; it takes about 6 minutes. You can use the ← and → keys.</p><div class=\"card\"><p>'+esc(SPSite.getQuestion('consent').title)+'</p><div class=\"row\"><button class=\"btn\" id=\"yes\">I agree</button></div><div class=\"err\"></div></div>';\n    document.getElementById('yes').onclick=function(){var b=this;b.disabled=true;SPSite.answer('consent',true).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}A.consent=true;next();});};}\n  function seriesIntro(i){var S=SERIES[i];\n    app.innerHTML='<div class=\"card\"><span class=\"step\">'+S.label+'</span><h1>Compare the '+S.word+'s</h1><p>'+S.instr+'</p><div class=\"row\"><button class=\"btn\" id=\"go\">Start</button></div></div>';\n    document.getElementById('go').onclick=function(){run[S.q]={plan:plan(S.keys),res:[]};trial(i);};}\n  var keyH=null;\n  function trial(i){var S=SERIES[i],R=run[S.q],k=R.res.length;\n    if(k>=R.plan.length)return save(i);\n    var p=R.plan[k],t0=0,done=false,timer=null;\n    app.innerHTML='<div class=\"card\"><span class=\"step\">'+S.label+' · '+(k+1)+' of '+R.plan.length+'</span><div class=\"screen\"><div class=\"win\" id=\"w0\"><div class=\"shut\">ready…</div></div><div class=\"win\" id=\"w1\"><div class=\"shut\">ready…</div></div></div><div class=\"row choice\"><button class=\"btn\" data-c=\"left\" disabled>← Left</button><button class=\"btn ghost\" data-c=\"equal\" disabled>Can\\'t decide</button><button class=\"btn\" data-c=\"right\" disabled>Right →</button></div><div class=\"prog\">Which '+S.word+' is more pleasant?</div><div class=\"err\"></div></div>';\n    var w0=document.getElementById('w0'),w1=document.getElementById('w1'),bs=app.querySelectorAll('.choice .btn');\n    function answer(c){if(done||!t0)return;done=true;clearTimeout(timer);var rt=Math.round(performance.now()-t0);R.res.push({left:p[0],right:p[1],choice:c,rt:rt});if(keyH){document.removeEventListener('keydown',keyH);keyH=null;}setTimeout(function(){trial(i);},350);}\n    bs.forEach(function(b){b.onclick=function(){answer(b.getAttribute('data-c'));};});\n    if(keyH)document.removeEventListener('keydown',keyH);\n    keyH=function(e){if(e.key==='ArrowLeft'){e.preventDefault();answer('left');}else if(e.key==='ArrowRight'){e.preventDefault();answer('right');}};document.addEventListener('keydown',keyH);\n    setTimeout(function(){ /* ready signal, then the shutter lifts for 3 s */\n      w0.innerHTML=S.draw(p[0]);w1.innerHTML=S.draw(p[1]);w0.setAttribute('aria-label',S.name[p[0]]);w1.setAttribute('aria-label',S.name[p[1]]);\n      t0=performance.now();bs.forEach(function(b){b.disabled=false;});\n      timer=setTimeout(function(){if(done)return;w0.innerHTML='<div class=\"shut\"></div>';w1.innerHTML='<div class=\"shut\"></div>';},3000);},900);}\n  function save(i){var S=SERIES[i],R=run[S.q];app.innerHTML='<div class=\"card\"><p>Saving…</p><div class=\"err\"></div></div>';\n    SPSite.answer(S.q,R.res.slice(),{shown:R.plan.map(function(p){return p[0]+'|'+p[1];})}).then(function(r){if(!ok(r)){app.innerHTML='<div class=\"card\"><p>Could not save this part.</p><div class=\"row\"><button class=\"btn\" id=\"re\">Try saving again</button></div><div class=\"err\"></div></div>';err(r.error);document.getElementById('re').onclick=function(){save(i);};return;}A[S.q]=R.res.slice();next();});}\n  function about(){var names=['gender','age','colour_vision'],h='<h1>About you</h1><div class=\"card\">';\n    names.forEach(function(n){var q=SPSite.getQuestion(n);h+='<div class=\"q\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"o\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';});\n    app.innerHTML=h+'<div class=\"row\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var v={};for(var k=0;k<names.length;k++){var x=app.querySelector('input[name=\"'+names[k]+'\"]:checked');if(!x)return err('Please answer: '+SPSite.getQuestion(names[k]).title);v[names[k]]=names[k]==='age'?Number(x.value):x.value;}\n      var b=this;b.disabled=true;Promise.all(names.map(function(n){return SPSite.answer(n,v[n]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}names.forEach(function(n){A[n]=v[n];});next();});};}\n  function top(q,names){var c={},n={};(A[q]||[]).forEach(function(t){[t.left,t.right].forEach(function(x){n[x]=(n[x]||0)+1;c[x]=c[x]||0;});if(t.choice==='left')c[t.left]++;else if(t.choice==='right')c[t.right]++;});\n    var ks=Object.keys(n).sort(function(a,b){return c[b]/n[b]-c[a]/n[a];});return ks.length?names[ks[0]]:'';}\n  function finish(){var tc=top('colour_pairs',CNAME),tf=top('form_pairs',FNAME);\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\">'+(tc&&tf?'<p>Your most often preferred colour was <b>'+esc(tc)+'</b> and your most often preferred form the <b>'+esc(tf)+'</b>.</p>':'')+'<p>In 1919–20 five trained observers at Clark University made these comparisons many times over five months. Each kept a fairly stable order of preference, and when colours and forms were combined, the pleasantness of a coloured form was roughly the sum of the pleasantness of its colour and of its form.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');return;}var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';});}\n  SPSite.onReady(function(ctx){A=(ctx&&ctx.answers)||{};next();});\n})();\n</script>\n</body>\n</html>\n",
