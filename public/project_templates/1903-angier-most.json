   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Most pleasing division of a line (Angier 1903)</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\"format\":\"sp-scheme-package\",\"spScheme\":\"2.0\",\"survey\":{\"title\":\"Most pleasing division of a line (Angier 1903)\",\"description\":\"Angier's 1903 experiment on unequal division: move a divider along a lit horizontal line on a dark screen and stop it where it divides the line most pleasingly, twice on each side of the centre.\",\"locale\":\"en\",\"pages\":[\n{\"name\":\"intro\",\"elements\":[{\"type\":\"boolean\",\"name\":\"consent\",\"title\":\"I agree to take part. My answers are recorded anonymously for research.\",\"isRequired\":true}]},\n{\"name\":\"round1\",\"elements\":[\n{\"type\":\"text\",\"name\":\"div1_left\",\"title\":\"Round 1 (divider brought in from the left end): most pleasing division in the left half\",\"isRequired\":true,\"inputType\":\"number\",\"min\":0,\"max\":80,\"description\":\"Value = position of the divider in millimetres of the original 160 mm line, measured from the LEFT end (0–80). Angier reports distances from the nearer end; golden section = 61.1 mm. The participant must first move the divider over the whole line, as in the original.\"},\n{\"type\":\"text\",\"name\":\"div1_right\",\"title\":\"Round 1: most pleasing division in the right half\",\"isRequired\":true,\"inputType\":\"number\",\"min\":80,\"max\":160,\"description\":\"Value = position in millimetres from the LEFT end (80–160); distance from the right end = 160 − value.\"}]},\n{\"name\":\"round2\",\"elements\":[\n{\"type\":\"text\",\"name\":\"div2_right\",\"title\":\"Round 2 (divider brought in from the right end): most pleasing division in the right half\",\"isRequired\":true,\"inputType\":\"number\",\"min\":80,\"max\":160,\"description\":\"Value = position in millimetres from the LEFT end (80–160).\"},\n{\"type\":\"text\",\"name\":\"div2_left\",\"title\":\"Round 2: most pleasing division in the left half\",\"isRequired\":true,\"inputType\":\"number\",\"min\":0,\"max\":80,\"description\":\"Value = position in millimetres from the LEFT end (0–80).\"}]},\n{\"name\":\"about\",\"elements\":[\n{\"type\":\"radiogroup\",\"name\":\"gender\",\"title\":\"Your gender\",\"isRequired\":true,\"choices\":[{\"value\":\"female\",\"text\":\"Female\"},{\"value\":\"male\",\"text\":\"Male\"},{\"value\":\"other\",\"text\":\"Other / prefer not to say\"}]},\n{\"type\":\"radiogroup\",\"name\":\"age\",\"title\":\"Your age\",\"isRequired\":true,\"choices\":[{\"value\":1,\"text\":\"Under 18\"},{\"value\":2,\"text\":\"18–24\"},{\"value\":3,\"text\":\"25–39\"},{\"value\":4,\"text\":\"40–59\"},{\"value\":5,\"text\":\"60 or older\"}]},\n{\"type\":\"radiogroup\",\"name\":\"art_training\",\"title\":\"Have you had training in art, design or architecture?\",\"isRequired\":true,\"choices\":[{\"value\":\"yes\",\"text\":\"Yes\"},{\"value\":\"no\",\"text\":\"No\"}]}]}]}}\n</script>\n<style>\n:root{--bg:#f2f0eb;--card:#fff;--ink:#1d1e21;--muted:#5d6066;--accent:#7a4b18;--accent-ink:#fff;--line:#d9d6cf;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:20px 16px 40px}h1{font-size:1.3rem;margin:0 0 8px}p{margin:0 0 10px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}.btn:disabled{opacity:.4;cursor:not-allowed}\n.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent)}\n.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;align-items:center}\n.screen{position:relative;background:#0b0b0c;border-radius:12px;height:220px;touch-action:none;user-select:none;-webkit-user-select:none;cursor:ew-resize;overflow:hidden}\n.ln{position:absolute;top:50%;height:4px;margin-top:-2px;background:#f6efd9;box-shadow:0 0 6px rgba(255,240,200,.35)}\n.dv{position:absolute;top:50%;width:4px;height:26px;margin:-13px 0 0 -2px;background:#0b0b0c;border-left:1px solid #222;border-right:1px solid #222}\n.hint{position:absolute;left:0;right:0;bottom:10px;text-align:center;color:#8d8a83;font-size:.85rem}\n.prog{font-size:.9rem;color:var(--muted);margin-top:8px}\n.step{display:inline-block;padding:2px 10px;border-radius:999px;background:#efe6da;color:#5a3a14;font-size:.85rem;font-weight:600;margin-bottom:8px}\nlabel.o{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:14px}.q>b{display:block;margin-bottom:4px}.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Method: Angier, R. P. (1903). The aesthetics of unequal division. <i>Harvard Psychological Studies</i>, 1, 541–561 (Psychological Review Monograph Supplements, 4). Public domain.</footer>\n<script>\n(function(){\n  var L=160; /* line length in mm, as in the original */\n  var STEPS=[\n    {q:'div1_left',side:'left',from:'left',round:1,first:true},\n    {q:'div1_right',side:'right',from:'left',round:1,first:false},\n    {q:'div2_right',side:'right',from:'right',round:2,first:true},\n    {q:'div2_left',side:'left',from:'right',round:2,first:false}];\n  var app=document.getElementById('app'),A={};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function has(n){return A[n]!=null&&A[n]!=='';}\n  function next(){window.scrollTo(0,0);\n    if(A.consent!==true)return intro();\n    for(var i=0;i<STEPS.length;i++)if(!has(STEPS[i].q))return trial(i);\n    if(!has('gender')||!has('age')||!has('art_training'))return about();\n    finish();}\n  function intro(){\n    app.innerHTML='<h1>Where would you divide this line?</h1><p>You will see a lit horizontal line on a dark screen, with a small divider that you can slide along it. Your task is to stop the divider at the place where it divides the line <b>unequally</b> in the way that pleases you most.</p><p>Each time, first slide the divider slowly along the <b>whole line</b>, past any place you like, so that you have seen it everywhere; then bring it back to the most pleasing place. You will do this four times: twice in the left half and twice in the right half. It takes about 3 minutes. There are no right or wrong answers.</p><div class=\"card\"><p>'+esc(SPSite.getQuestion('consent').title)+'</p><div class=\"row\"><button class=\"btn\" id=\"yes\">I agree</button></div><div class=\"err\"></div></div>';\n    document.getElementById('yes').onclick=function(){var b=this;b.disabled=true;SPSite.answer('consent',true).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}A.consent=true;next();});};}\n  function trial(i){\n    var S=STEPS[i],half=S.side==='left'?'left half':'right half';\n    var prev=A[STEPS[i-1]?STEPS[i-1].q:''];\n    var start=S.first?(S.from==='left'?-12:L+12):(prev!=null?prev:L/2); /* new round: divider starts off the line at one end; second setting continues from the first */\n    var pos=start,seenL=S.first?S.from==='left':true,seenR=S.first?S.from==='right':true;\n    app.innerHTML='<div class=\"card\"><span class=\"step\">Round '+S.round+' of 2 · '+(S.first?'first':'second')+' setting</span><h1>Divide the line most pleasingly in its <b>'+half+'</b></h1><p>'+(S.first?'The divider starts just off the '+S.from+' end. Drag it slowly across the whole line to the other end, then bring it back and stop it at the most pleasing place in the '+half+'.':'Now, without leaving the line, move the divider to the most pleasing place in the '+half+'.')+'</p><div class=\"screen\" id=\"scr\" role=\"slider\" tabindex=\"0\" aria-label=\"Divider position\" aria-valuemin=\"0\" aria-valuemax=\"160\"><div class=\"ln\" id=\"ln\"></div><div class=\"dv\" id=\"dv\"></div><div class=\"hint\">drag anywhere on the dark screen · arrow keys also work</div></div><div class=\"prog\" id=\"pg\"></div><div class=\"row\"><button class=\"btn\" id=\"go\" disabled>This is the most pleasing place</button></div><div class=\"err\"></div></div>';\n    var scr=document.getElementById('scr'),ln=document.getElementById('ln'),dv=document.getElementById('dv'),pg=document.getElementById('pg'),go=document.getElementById('go');\n    function geom(){var W=scr.clientWidth,len=Math.min(W*0.72,560);return {x0:(W-len)/2,len:len};}\n    function draw(){var g=geom();ln.style.left=g.x0+'px';ln.style.width=g.len+'px';dv.style.left=(g.x0+pos/L*g.len)+'px';scr.setAttribute('aria-valuenow',Math.round(pos));\n      var need=[];if(!seenL)need.push('the left end');if(!seenR)need.push('the right end');\n      var onSide=S.side==='left'?(pos>0&&pos<L/2):(pos>L/2&&pos<L);\n      pg.textContent=need.length?'Move the divider all the way to '+need.join(' and ')+' first.':(onSide?'Stop when it looks most pleasing, then press the button.':'Bring the divider into the '+half+' of the line.');\n      go.disabled=!!need.length||!onSide;}\n    function setFromX(cx){var g=geom(),r=scr.getBoundingClientRect();pos=Math.max(-12,Math.min(L+12,((cx-r.left)-g.x0)/g.len*L));\n      if(pos<=4)seenL=true;if(pos>=L-4)seenR=true;draw();}\n    var drag=false;\n    scr.addEventListener('pointerdown',function(e){drag=true;scr.setPointerCapture(e.pointerId);setFromX(e.clientX);});\n    scr.addEventListener('pointermove',function(e){if(drag)setFromX(e.clientX);});\n    scr.addEventListener('pointerup',function(){drag=false;});scr.addEventListener('pointercancel',function(){drag=false;});\n    scr.addEventListener('keydown',function(e){var d=e.key==='ArrowLeft'?-1:e.key==='ArrowRight'?1:0;if(!d)return;e.preventDefault();pos=Math.max(-12,Math.min(L+12,pos+d*(e.shiftKey?5:0.5)));if(pos<=4)seenL=true;if(pos>=L-4)seenR=true;draw();});\n    window.onresize=draw;draw();\n    go.onclick=function(){var v=Math.round(pos*2)/2;var b=this;b.disabled=true;\n      SPSite.answer(S.q,v,{shown:['line160mm','start@'+start,'screenLinePx@'+Math.round(geom().len)]}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}A[S.q]=v;window.onresize=null;next();});};}\n  function about(){var names=['gender','age','art_training'],h='<h1>About you</h1><div class=\"card\">';\n    names.forEach(function(n){var q=SPSite.getQuestion(n);h+='<div class=\"q\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"o\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';});\n    app.innerHTML=h+'<div class=\"row\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var v={};for(var k=0;k<names.length;k++){var x=app.querySelector('input[name=\"'+names[k]+'\"]:checked');if(!x)return err('Please answer: '+SPSite.getQuestion(names[k]).title);v[names[k]]=names[k]==='age'?Number(x.value):x.value;}\n      var b=this;b.disabled=true;Promise.all(names.map(function(n){return SPSite.answer(n,v[n]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}names.forEach(function(n){A[n]=v[n];});next();});};}\n  function finish(){\n    var l=[A.div1_left,A.div2_left].filter(function(x){return x!=null;}),r=[A.div1_right,A.div2_right].filter(function(x){return x!=null;});\n    var ml=l.length?(l.reduce(function(a,b){return a+b;},0)/l.length):null,mr=r.length?(L-r.reduce(function(a,b){return a+b;},0)/r.length):null;\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\">'+(ml!=null&&mr!=null?'<p>On a 160 mm line your divisions were on average <b>'+ml.toFixed(0)+' mm</b> from the left end and <b>'+mr.toFixed(0)+' mm</b> from the right end. The golden section would be 61 mm from an end.</p>':'')+'<p>At Harvard in 1902–03, nine people each made 72 such judgments. Their overall average (60 and 59 mm) fell close to the golden section, but Angier showed that almost nobody actually chose there: each person kept to their own zone, and the zones of preference covered about a third of the line, rarely nearer the ends than a quarter of the line.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(res){if(!ok(res)){err(res.error||'Some answers are missing.');return;}var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';});}\n  SPSite.onReady(function(ctx){A=(ctx&&ctx.answers)||{};next();});\n})();\n</script>\n</body>\n</html>\n",
