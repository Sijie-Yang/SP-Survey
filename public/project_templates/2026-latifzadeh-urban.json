   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Urban Green Space Affective Ratings</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Urban Green Space Affective Ratings\",\n    \"description\": \"30 photographs of urban spaces with more or less greenery, taken by the authors at three sites in Esch-sur-Alzette / Belval, Luxembourg, shown one at a time in random order. Each photograph is rated on four 7-point scales: emotional valence, safety, satisfaction and calmness. At the end participants pick their three favourite places from a grid of all 30 and say why. Rebuilt from Latifzadeh, Emami, Emami, Duraisamy and Leiva (2026), CHI '26, using the authors' open image set.\",\n    \"locale\": \"en\",\n    \"mediaFolders\": [\"scenes\"],\n    \"pages\": [\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" },\n        { \"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"male\", \"text\": \"Male\" }, { \"value\": \"other\", \"text\": \"Other / prefer not to say\" } ] },\n        { \"type\": \"number\", \"name\": \"age\", \"title\": \"Age (years)\", \"min\": 18, \"max\": 99, \"isRequired\": true }\n      ]},\n      { \"name\": \"places\", \"elements\": [\n        { \"type\": \"imageslidergroup\", \"name\": \"ratings\", \"title\": \"How does this place make you feel?\", \"description\": \"One record per photograph: key = the paper's image ID (1–30, as in stimulus_id of trials_info.csv on Zenodo); shown = the photograph file (scene_NN.jpg). Values 1–7, matching the columns Emotional Valence, Safety, Satisfaction and Calmness of the open dataset.\", \"imageCount\": 1, \"scaleMin\": 1, \"scaleMax\": 7, \"isRequired\": true, \"dimensions\": [\n          { \"id\": \"valence\", \"label\": \"Emotional valence: how do you feel when you look at this place?\", \"left\": \"Very negative\", \"right\": \"Very positive\", \"min\": 1, \"max\": 7, \"step\": 1 },\n          { \"id\": \"safety\", \"label\": \"Safety: how safe would you feel in this place?\", \"left\": \"Very unsafe\", \"right\": \"Very safe\", \"min\": 1, \"max\": 7, \"step\": 1 },\n          { \"id\": \"satisfaction\", \"label\": \"Satisfaction: how satisfied would you be with this place?\", \"left\": \"Very unsatisfied\", \"right\": \"Very satisfied\", \"min\": 1, \"max\": 7, \"step\": 1 },\n          { \"id\": \"calmness\", \"label\": \"Calmness: how calm does this place make you feel?\", \"left\": \"Very agitated\", \"right\": \"Very calm\", \"min\": 1, \"max\": 7, \"step\": 1 }\n        ] },\n        { \"type\": \"custom\", \"name\": \"top_three\", \"title\": \"Your three favourite places and why\", \"description\": \"Recorded by the page after all ratings: [{ rank: 1–3, image: paper image ID (1–30), file, reason: free text }], matching justifications_on_top_three_choices.txt of the open dataset.\", \"isRequired\": true }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f1f3ef;--card:#fff;--ink:#1b1f1c;--muted:#59615b;--accent:#2f6b4a;--accent-ink:#fff;--line:#d5dad5;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:24px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:8px 0 14px}.progress>i{display:block;height:100%;background:var(--accent)}\n.pic{background:#dfe3df;border-radius:12px;overflow:hidden;aspect-ratio:16/9}\n.pic img{width:100%;height:100%;object-fit:contain;display:block}\n.item{margin-top:14px}.item b{display:block;font-weight:600;margin-bottom:6px}\n.scale{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}\n.scale button{appearance:none;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:9px;padding:9px 0;font:inherit;font-weight:700;cursor:pointer;min-width:0}\n.scale button.on{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}\n.ends{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-top:3px}\n.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}\n@media(min-width:640px){.grid{grid-template-columns:repeat(5,1fr)}}\n.grid button{appearance:none;position:relative;border:3px solid transparent;border-radius:10px;padding:0;overflow:hidden;cursor:pointer;background:#dfe3df;aspect-ratio:16/9}\n.grid button img{width:100%;height:100%;object-fit:cover;display:block}\n.grid button.on{border-color:var(--accent)}\n.grid button span{position:absolute;top:4px;left:4px;background:var(--accent);color:#fff;border-radius:50%;width:24px;height:24px;font-weight:700;font-size:.85rem;display:none;align-items:center;justify-content:center}\n.grid button.on span{display:flex}\n.why{display:flex;gap:10px;align-items:flex-start;margin-top:12px}.why img{width:96px;border-radius:8px;aspect-ratio:16/9;object-fit:cover}\ntextarea{font:inherit;width:100%;min-height:64px;padding:8px 10px;border:1px solid var(--line);border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:16px}.q>b{display:block;margin-bottom:4px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:120px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Emami, Duraisamy, Latifzadeh, Emami &amp; Leiva, “Pixels, Plants, and People” dataset, Zenodo record 18348490, CC BY 4.0 (resized to 1600 px).</footer>\n<script>\n(function(){\n  var N=30, app=document.getElementById('app'), Q={}, files={}, order=[], done={}, i=0;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function fn(k){return 'scene_'+(k<10?'0':'')+k+'.jpg';}\n  function shuffle(a){a=a.slice();for(var k=a.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1));var x=a[k];a[k]=a[j];a[j]=x;}return a;}\n  function all(){var a=[];for(var k=1;k<=N;k++)a.push(k);return a;}\n  function setup(){\n    var saved=null;try{saved=JSON.parse(localStorage.getItem('ppp2026:order'));}catch(e){}\n    if(Array.isArray(saved)&&saved.length===N&&all().every(function(k){return saved.indexOf(k)>=0;}))order=saved;\n    else{order=shuffle(all());try{localStorage.setItem('ppp2026:order',JSON.stringify(order));}catch(e){}}\n  }\n  function radios(n){return (Q[n].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');}\n  function intro(){\n    var miss=all().filter(function(k){return !files[fn(k)];});\n    if(miss.length){app.innerHTML='<h1>Photographs missing</h1><p>Missing in folder “scenes”: '+esc(miss.map(fn).join(', '))+'</p>';return;}\n    app.innerHTML='<h1>How do these places make you feel?</h1><p>You will see 30 photographs of streets, squares and green spaces in a European town, one at a time. Look at each one for as long as you like and answer four short questions about it. At the end you choose your three favourite places and say why. About 15 minutes.</p>'+\n      '<div class=\"card\"><div class=\"q\" style=\"margin-top:0\"><b>'+esc(Q.gender.title)+'</b>'+radios('gender')+'</div><div class=\"q\"><b>'+esc(Q.age.title||'Age')+'</b><input type=\"number\" id=\"age\" min=\"18\" max=\"99\" inputmode=\"numeric\"></div></div>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var g=app.querySelector('input[name=gender]:checked');if(!g)return err('Please answer: '+Q.gender.title);\n      var av=document.getElementById('age').value, age=Number(av);if(!av||!(age>=18&&age<=99))return err('Please enter your age (18–99).');\n      var b=this;b.disabled=true;\n      Promise.all([SPSite.answer('consent',true),SPSite.answer('gender',g.value),SPSite.answer('age',age)]).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}i=0;trial();});\n    };\n  }\n  function trial(){\n    while(i<order.length&&done[order[i]])i++;\n    if(i>=order.length)return pick();\n    var k=order[i], f=files[fn(k)], n=Object.keys(done).length, vals={}, dims=Q.ratings.dimensions||[];\n    var items=dims.map(function(d){var b='';for(var v=1;v<=7;v++)b+='<button data-d=\"'+esc(d.id)+'\" data-v=\"'+v+'\" aria-label=\"'+esc(d.label)+' '+v+'\">'+v+'</button>';\n      return '<div class=\"item\"><b>'+esc(d.label)+'</b><div class=\"scale\">'+b+'</div><div class=\"ends\"><span>'+esc(d.left)+'</span><span>'+esc(d.right)+'</span></div></div>';}).join('');\n    app.innerHTML='<p>Photograph '+(n+1)+' of '+N+'</p><div class=\"progress\"><i style=\"width:'+(100*n/N)+'%\"></i></div>'+\n      '<div class=\"pic\"><img src=\"'+esc(f.url)+'\" alt=\"Photograph of an urban space\"></div><div class=\"card\">'+items+'</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"nx\">Next</button></div><div class=\"err\"></div>';\n    var nf=files[fn(order[i+1])];if(nf){var im=new Image();im.src=nf.url;}\n    app.querySelectorAll('.scale button').forEach(function(x){x.onclick=function(){vals[x.getAttribute('data-d')]=Number(x.getAttribute('data-v'));x.parentNode.querySelectorAll('button').forEach(function(y){y.classList.toggle('on',y===x);});err('');};});\n    document.getElementById('nx').onclick=function(){\n      if(dims.some(function(d){return vals[d.id]==null;}))return err('Please answer all four questions.');\n      var bt=this;bt.disabled=true;var v={};dims.forEach(function(d){v[d.id]=vals[d.id];});\n      SPSite.answer('ratings',v,{key:String(k),shown:[f.name]}).then(function(r){if(!ok(r)){bt.disabled=false;return err(r.error);}done[k]=true;i++;window.scrollTo(0,0);trial();});\n    };\n  }\n  function pick(){\n    var sel=[];\n    function draw(){\n      app.querySelectorAll('.grid button').forEach(function(b){var k=Number(b.dataset.k),r=sel.indexOf(k);b.classList.toggle('on',r>=0);b.querySelector('span').textContent=r>=0?r+1:'';});\n      var w=document.getElementById('why'), old={};w.querySelectorAll('textarea').forEach(function(t){old[t.dataset.k]=t.value;});\n      w.innerHTML=sel.map(function(k,r){return '<div class=\"why\"><img src=\"'+esc(files[fn(k)].url)+'\" alt=\"\"><div style=\"flex:1\"><b>'+(r+1)+(r===0?'st':r===1?'nd':'rd')+' choice: why?</b><textarea data-k=\"'+k+'\">'+esc(old[k]||'')+'</textarea></div></div>';}).join('');w.style.display=sel.length?'':'none';\n    }\n    app.innerHTML='<h1>Your three favourite places</h1><p>Here are all 30 places. Tap your favourite first, then your second and third. Tap again to remove. Then tell us briefly why you chose each one.</p>'+\n      '<div class=\"grid\">'+all().map(function(k){return '<button data-k=\"'+k+'\" aria-label=\"Place '+k+'\"><img src=\"'+esc(files[fn(k)].url)+'\" alt=\"\" loading=\"lazy\"><span></span></button>';}).join('')+'</div>'+\n      '<div class=\"card\" id=\"why\"></div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"fin\">Finish</button></div><div class=\"err\"></div>';\n    app.querySelectorAll('.grid button').forEach(function(b){b.onclick=function(){var k=Number(b.dataset.k),r=sel.indexOf(k);if(r>=0)sel.splice(r,1);else if(sel.length<3)sel.push(k);else return err('You have already chosen three. Tap one to remove it first.');err('');draw();};});\n    draw();\n    document.getElementById('fin').onclick=function(){\n      if(sel.length<3)return err('Please choose three places.');\n      var ts={};app.querySelectorAll('#why textarea').forEach(function(t){ts[t.dataset.k]=t.value.trim();});\n      if(sel.some(function(k){return !ts[k];}))return err('Please say briefly why you chose each place.');\n      var bt=this;bt.disabled=true;\n      var v=sel.map(function(k,r){return {rank:r+1,image:k,file:fn(k),reason:ts[k].slice(0,2000)};});\n      SPSite.answer('top_three',v,{shown:sel.map(fn)}).then(function(r){if(!ok(r)){bt.disabled=false;return err(r.error);}finish();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin2\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){if(m.some(function(x){return x!=='ratings'&&x!=='top_three';}))intro();else{done={};i=0;trial();}},1800);}else{var s=document.getElementById('fin2');if(s)s.textContent='Your answers are saved.';}});\n  }\n  SPSite.onReady(function(ctx){\n    ['consent','gender','age','ratings','top_three'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('scenes')||[]).forEach(function(f){files[f.name]=f;});\n    setup();\n    var a=(ctx&&ctx.answers)||{}, p=a.ratings;\n    (p&&Array.isArray(p.trials)?p.trials:[]).forEach(function(x){if(x&&x.key!=null&&x.value!=null)done[Number(x.key)]=true;});\n    if(a.consent===true){if(a.top_three&&Object.keys(done).length>=N)finish();else trial();}else intro();\n  });\n})();\n</script>\n</body>\n</html>\n",
