   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Which Cycling Environment Appears Safer?</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Which Cycling Environment Appears Safer?\",\n    \"description\": \"Pairs of Berlin street views: pick the one that looks safer for cycling, or say they look the same. Rebuilt from Costa et al. (2025).\",\n    \"locale\": \"en\",\n    \"pages\": [\n      { \"name\": \"intro\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. My answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" }\n      ]},\n      { \"name\": \"comparisons\", \"elements\": [\n        { \"type\": \"imagepicker\", \"name\": \"safer_cycling\", \"title\": \"Which environment looks safer for cycling?\",\n          \"description\": \"Imagine riding a bicycle here. If neither looks safer, choose “They look equally safe”.\",\n          \"imageCount\": 2, \"trialCount\": 20, \"allowTie\": true, \"tieLabel\": \"They look equally safe\",\n          \"imageFit\": \"cover\", \"isRequired\": true, \"choices\": [],\n          \"imageSelectionMode\": \"huggingface_random\", \"randomImageSelection\": true, \"excludePreviouslyUsedImages\": true,\n          \"mediaFolders\": [\"berlin\"] }\n      ]},\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"radiogroup\", \"name\": \"cycling_frequency\", \"title\": \"How often do you ride a bicycle?\",\n          \"choices\": [\n            { \"value\": \"daily\", \"text\": \"Daily or almost daily\" },\n            { \"value\": \"weekly\", \"text\": \"At least once a week\" },\n            { \"value\": \"monthly\", \"text\": \"At least once a month\" },\n            { \"value\": \"rarely\", \"text\": \"Less than once a month\" },\n            { \"value\": \"never\", \"text\": \"Never\" }\n          ] }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f6f7f5;--card:#fff;--ink:#1d2421;--muted:#5d6762;--accent:#1f7a4d;--accent-ink:#fff;--line:#dde3df}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:960px;margin:0 auto;padding:24px 16px 48px}\nh1{font-size:1.6rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px;margin-top:16px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent)}\n.btn:disabled{opacity:.45;cursor:not-allowed}\n.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:8px 0 16px}.progress>i{display:block;height:100%;background:var(--accent);transition:width .25s}\n.pair{display:grid;grid-template-columns:1fr 1fr;gap:12px}\n.pick{position:relative;border:3px solid transparent;border-radius:12px;padding:0;background:#000;cursor:pointer;overflow:hidden;aspect-ratio:4/3}\n.pick img{width:100%;height:100%;object-fit:cover;display:block}\n.pick:focus-visible,.pick:hover{border-color:var(--accent)}\n.pick span{position:absolute;left:8px;top:8px;background:rgba(0,0,0,.6);color:#fff;border-radius:6px;padding:2px 8px;font-size:.85rem}\n.tie{margin-top:12px;width:100%}\n.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:10px 12px;border:1px solid var(--line);border-radius:10px;margin-top:8px;cursor:pointer}\n.err{color:#b3261e;margin-top:8px}\n.credit{max-width:960px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n@media (max-width:560px){.pair{grid-template-columns:1fr}.pick{aspect-ratio:16/10}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Street images: Berlin, Google Street View, 2022–2023 (© Google).</footer>\n<script>\n(function(){\n  var app=document.getElementById('app'), q=null, consentQ=null, freqQ=null, i=0;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(msg){var e=app.querySelector('.err'); if(e) e.textContent=msg||'';}\n  function intro(){\n    app.innerHTML='<h1>Which street looks safer for cycling?</h1>'+\n      '<p>You will see '+q.trialCount+' pairs of street views from Berlin. For each pair, imagine riding a bicycle there and pick the one that looks <b>safer for cycling</b>. If neither looks safer, choose “'+esc(tieText())+'”.</p>'+\n      '<p>It takes about 5 minutes. There are no right or wrong answers; go with your first impression.</p>'+\n      '<div class=\"card\"><p>'+esc(consentQ.title)+'</p><div class=\"row\"><button class=\"btn\" id=\"yes\">'+esc(consentQ.labelTrue||'I agree')+'</button></div><div class=\"err\"></div></div>';\n    document.getElementById('yes').onclick=function(){\n      SPSite.answer('consent',true).then(function(r){ if(r&&r.ok===false) return err(r.error); i=firstOpen(); trial(); });\n    };\n  }\n  function tieText(){var t=(trialChoices(0)||[]).find(function(c){return c.tie;});return t?t.text:'They look equally safe';}\n  function trialChoices(k){var t=q.trials&&q.trials[k];return (t&&t.choices)||q.choices||[];}\n  function trialMedia(k){var t=q.trials&&q.trials[k];return (t&&t.media)||q.media||[];}\n  var done={};\n  function firstOpen(){for(var k=0;k<q.trialCount;k++){if(!done[k])return k;}return q.trialCount;}\n  function trial(){\n    if(i>=q.trialCount) return about();\n    var ch=trialChoices(i), imgs=ch.filter(function(c){return !c.tie;}), tie=ch.find(function(c){return c.tie;});\n    var media=trialMedia(i);\n    var html='<h1>'+esc(q.title)+'</h1><p>Pair '+(i+1)+' of '+q.trialCount+' · '+esc(q.description||'')+'</p>'+\n      '<div class=\"progress\" aria-hidden=\"true\"><i style=\"width:'+(100*i/q.trialCount)+'%\"></i></div><div class=\"pair\">';\n    imgs.forEach(function(c,k){\n      var src=c.imageUrl||(media[k]&&media[k].url)||'';\n      html+='<button class=\"pick\" data-v=\"'+esc(c.value)+'\" aria-label=\"Street '+(k===0?'A':'B')+' looks safer\"><img src=\"'+esc(src)+'\" alt=\"Street view '+(k===0?'A':'B')+'\"><span>'+(k===0?'A':'B')+'</span></button>';\n    });\n    html+='</div>'+(tie?'<button class=\"btn ghost tie\" data-v=\"'+esc(tie.value)+'\">'+esc(tie.text)+'</button>':'')+\n      (i>0?'<div class=\"row\"><button class=\"btn ghost\" id=\"back\">Back</button></div>':'')+'<div class=\"err\"></div>';\n    app.innerHTML=html;\n    app.querySelectorAll('[data-v]').forEach(function(b){\n      b.onclick=function(){\n        var k=i; app.querySelectorAll('[data-v]').forEach(function(x){x.disabled=true;});\n        SPSite.answer('safer_cycling',b.getAttribute('data-v'),{trial:k}).then(function(r){\n          if(r&&r.ok===false){err(r.error);app.querySelectorAll('[data-v]').forEach(function(x){x.disabled=false;});return;}\n          done[k]=true; i=k+1; trial();\n        });\n      };\n    });\n    var back=document.getElementById('back'); if(back) back.onclick=function(){i-=1;trial();};\n    window.scrollTo(0,0);\n  }\n  function about(){\n    var opts=(freqQ.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"freq\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');\n    app.innerHTML='<h1>One last question</h1><div class=\"card\"><p>'+esc(freqQ.title)+' (optional)</p>'+opts+\n      '<div class=\"row\"><button class=\"btn\" id=\"finish\">Finish</button></div><div class=\"err\"></div></div>';\n    app.querySelectorAll('input[name=freq]').forEach(function(r){r.onchange=function(){SPSite.answer('cycling_frequency',r.value).then(function(x){if(x&&x.ok===false)err(x.error);});};});\n    document.getElementById('finish').onclick=function(){\n      this.disabled=true; app.querySelector('.err').textContent='Submitting…';\n      SPSite.complete().then(function(r){\n        if(r&&r.ok===false){ err(r.error||('Please answer: '+(r.missing||[]).join(', '))); var m=(r.missing||[]); if(m.indexOf('consent')>=0) intro(); else if(m.indexOf('safer_cycling')>=0){i=firstOpen();trial();} }\n      });\n    };\n  }\n  SPSite.onReady(function(ctx){\n    q=SPSite.getQuestion('safer_cycling'); consentQ=SPSite.getQuestion('consent'); freqQ=SPSite.getQuestion('cycling_frequency');\n    var a=(ctx&&ctx.answers)||{};\n    var prev=a.safer_cycling;\n    var list=prev&&Array.isArray(prev.trials)?prev.trials:(Array.isArray(prev)?prev:[]);\n    list.forEach(function(t,k){var v=t&&typeof t==='object'?t.value:t; if(v!=null&&v!=='')done[k]=true;});\n    if(a.consent===true){ i=firstOpen(); trial(); } else intro();\n  });\n})();\n</script>\n</body>\n</html>\n",
