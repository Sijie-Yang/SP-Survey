   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Park Lighting in the Evening</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Park lighting in the evening\",\n  \"description\": \"Faithful replication of the online survey of Lis, Zienowicz & Błachnio (2024), Lighting Features Affecting the Well-Being of Able-Bodied People and People with Physical Disabilities in the Park in the Evening, Sustainability 16(20):8871. Twelve Lumion renderings of the same park path at night vary light distribution (even, uneven), lighting location (path, path + surroundings, surroundings) and space (open, corridor). In five parts participants rate all 12 scenes, one per slide in random order, on safety, preference, contact with the surroundings, mystery and legibility (1-5).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"nightscapes\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I have read the information above and agree to take part. I know I can withdraw at any stage.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"park_trauma\",\n      \"title\": \"Have you ever experienced anything negative or traumatic in a park?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       },\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       }\n      ],\n      \"description\": \"Yes ends the survey (as in the original study).\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"name\": \"age\",\n      \"title\": \"Age (years)\",\n      \"inputType\": \"number\",\n      \"min\": 18,\n      \"max\": 110,\n      \"isRequired\": false\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": false,\n      \"choices\": [\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / I do not want to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"wheelchair\",\n      \"title\": \"Do you use a wheelchair to move around?\",\n      \"isRequired\": false,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       }\n      ],\n      \"description\": \"Group variable (the original recruited wheelchair users and able-bodied people separately).\"\n     }\n    ]\n   },\n   {\n    \"name\": \"ratings\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"safety\",\n      \"title\": \"Assess how safe this place is.\",\n      \"isRequired\": false,\n      \"rateValues\": [\n       {\n        \"value\": 1,\n        \"text\": \"Very dangerous\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"Very safe\"\n       }\n      ],\n      \"description\": \"One rating per visualisation, keyed by image id (A-F = lighting: A even/path, B even/path+surroundings, C even/surroundings, D uneven/path, E uneven/path+surroundings, F uneven/surroundings; 1 = open space, 2 = corridor space). 1-5.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"preference\",\n      \"title\": \"Assess how much you like this place.\",\n      \"isRequired\": false,\n      \"rateValues\": [\n       {\n        \"value\": 1,\n        \"text\": \"I do not like it\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"I really like it\"\n       }\n      ],\n      \"description\": \"One rating per visualisation, keyed by image id (A-F = lighting: A even/path, B even/path+surroundings, C even/surroundings, D uneven/path, E uneven/path+surroundings, F uneven/surroundings; 1 = open space, 2 = corridor space). 1-5.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"contact\",\n      \"title\": \"Assess to what extent you have contact with the surrounding landscape (besides the route you are moving along).\",\n      \"isRequired\": false,\n      \"rateValues\": [\n       {\n        \"value\": 1,\n        \"text\": \"I do not have any contact\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"I have a lot of contact\"\n       }\n      ],\n      \"description\": \"One rating per visualisation, keyed by image id (A-F = lighting: A even/path, B even/path+surroundings, C even/surroundings, D uneven/path, E uneven/path+surroundings, F uneven/surroundings; 1 = open space, 2 = corridor space). 1-5.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"mystery\",\n      \"title\": \"Assess to what extent this place ‘promises’ to reveal more the further you go. Do you think it invites you to explore further?\",\n      \"isRequired\": false,\n      \"rateValues\": [\n       {\n        \"value\": 1,\n        \"text\": \"It is not inviting at all\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"It is very inviting\"\n       }\n      ],\n      \"description\": \"One rating per visualisation, keyed by image id (A-F = lighting: A even/path, B even/path+surroundings, C even/surroundings, D uneven/path, E uneven/path+surroundings, F uneven/surroundings; 1 = open space, 2 = corridor space). 1-5.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"legibility\",\n      \"title\": \"Assess how easy it would be for you to orient yourself in this space? How easy would it be to say where you are at a given moment or find the way back to a certain point in the landscape?\",\n      \"isRequired\": false,\n      \"rateValues\": [\n       {\n        \"value\": 1,\n        \"text\": \"Very difficult\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"Very easy\"\n       }\n      ],\n      \"description\": \"One rating per visualisation, keyed by image id (A-F = lighting: A even/path, B even/path+surroundings, C even/surroundings, D uneven/path, E uneven/path+surroundings, F uneven/surroundings; 1 = open space, 2 = corridor space). 1-5.\"\n     }\n    ]\n   }\n  ],\n  \"spAnalysisRecommendation\": \"Within-subjects 2 (distribution) x 3 (location) x 2 (space) design with group (wheelchair yes/no) as between factor: decode the answer key (letter -> distribution and location, digit -> space) and run a mixed ANOVA per variable (safety, preference, contact, mystery, legibility), with post hoc comparisons.\"\n }\n}\n</script>\n<style>\n:root{--bg:#f3f2ee;--card:#fff;--ink:#1d1f1c;--muted:#5d6159;--accent:#3d6b4f;--line:#d9dad2;--warn:#b3261e;--sel:#e0ece4}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1000px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn.sec{background:transparent;color:var(--accent);border:1px solid var(--accent)}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.blk{margin-top:14px}.blk:first-child{margin-top:0}\n.blk.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\ninput.txt{font:inherit;width:100%;max-width:200px;padding:9px 11px;border:1px solid var(--line);border-radius:10px;margin-top:6px}\n.err{color:var(--warn);margin-top:8px;min-height:1.5em;line-height:1.5}\n.credit{max-width:1000px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n.scene img{width:100%;max-height:62vh;aspect-ratio:16/9;object-fit:cover;display:block;border-radius:10px;background:#000}\n.prog{font-size:.9rem;color:var(--muted);margin:4px 0 8px}\n.q{font-weight:600;margin:12px 0 8px}\n.o5{display:grid;grid-template-columns:repeat(5,1fr);gap:4px}\n.o5 button{appearance:none;font:inherit;border:1px solid var(--line);background:#fff;border-radius:8px;padding:10px 2px;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:.72rem;line-height:1.15;color:var(--muted)}\n.o5 button b{font-size:1rem;color:var(--ink)}\n.o5 button.on{background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.nav{display:flex;gap:10px;margin-top:14px}\n@media (max-width:700px){.o5 button{font-size:.62rem;padding:9px 1px}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Park visualisations and questions: Lis, Zienowicz &amp; Błachnio (2024), Lighting Features Affecting the Well-Being of Able-Bodied People and People with Physical Disabilities in the Park in the Evening, Sustainability 16(20):8871 (doi:10.3390/su16208871, CC BY 4.0). Renderings cropped from Figure 3; question wording from Table 1. Removed on request of the authors.</footer>\n<script>\n(function(){\n  var KEY='lis2024parklight:state', IDS=['A1','A2','B1','B2','C1','C2','D1','D2','E1','E2','F1','F2'], VARS=[[\"safety\", \"Assess how safe this place is.\", \"Very dangerous\", \"Very safe\"], [\"preference\", \"Assess how much you like this place.\", \"I do not like it\", \"I really like it\"], [\"contact\", \"Assess to what extent you have contact with the surrounding landscape (besides the route you are moving along).\", \"I do not have any contact\", \"I have a lot of contact\"], [\"mystery\", \"Assess to what extent this place ‘promises’ to reveal more the further you go. Do you think it invites you to explore further?\", \"It is not inviting at all\", \"It is very inviting\"], [\"legibility\", \"Assess how easy it would be for you to orient yourself in this space? How easy would it be to say where you are at a given moment or find the way back to a certain point in the landscape?\", \"Very difficult\", \"Very easy\"]];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='';}}\n  function hideErr(){var e=app.querySelector('.err');if(e&&!app.querySelector('.miss'))e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function radios(n){var q=Q[n];return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function pick(n){var x=app.querySelector('input[name=\"'+n+'\"]:checked');return x?x.value:null;}\n  function intro(){\n    app.innerHTML='<h1>Parks in the evening</h1><p>This study looks at how lighting in a park at night affects how people feel. You will see 12 pictures of a park path in the evening, five times, and each time rate them on one question. It takes about 15 minutes. Please complete the survey on a computer with a screen of at least 15 inches, in a dark room. You can withdraw at any stage, and within each part you can go back to correct earlier answers.</p>'+\n     '<div class=\"card\">'+radios('park_trauma')+'<div class=\"blk\"><label class=\"opt\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label></div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var t=pick('park_trauma');if(!t){app.querySelector('.blk[data-n=\"park_trauma\"]').classList.add('miss');return err('Please answer the question.');}\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true),SPSite.answer('park_trauma',t)],this,function(){st.step=t==='yes'?'stop':'about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"blk\" data-n=\"age\"><b>'+esc(Q.age.title)+'</b><br><input class=\"txt\" id=\"f_age\" type=\"number\" inputmode=\"numeric\" min=\"18\" max=\"110\"></div>'+radios('gender')+radios('wheelchair')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var miss=[],raw=document.getElementById('f_age').value.trim(),age=Number(raw);\n      if(raw===''||isNaN(age)||age<18||age>110)miss.push(app.querySelector('.blk[data-n=\"age\"]'));\n      ['gender','wheelchair'].forEach(function(n){if(!pick(n))miss.push(app.querySelector('.blk[data-n=\"'+n+'\"]'));});\n      if(miss.length){miss.forEach(function(e){e.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please answer the marked questions.');}\n      send([SPSite.answer('age',age),SPSite.answer('gender',pick('gender')),SPSite.answer('wheelchair',pick('wheelchair'))],this,function(){st.step='rate';st.part=0;st.i=0;st.order=shuffle(IDS);st.r={};save();route();});};\n  }\n  function rate(){\n    var v=VARS[st.part], id=st.order[st.i], cur=(st.r[v[0]]||{})[id];\n    app.innerHTML='<div class=\"prog\">Part '+(st.part+1)+' of '+VARS.length+' · picture '+(st.i+1)+' of '+IDS.length+'</div><div class=\"scene\"><img alt=\"Park path at night\" src=\"'+esc(files[id].url)+'\"></div>'+\n      '<div class=\"q\">'+esc(v[1])+'</div><div class=\"o5\">'+[1,2,3,4,5].map(function(n){return '<button type=\"button\" data-v=\"'+n+'\" class=\"'+(cur===n?'on':'')+'\"><b>'+n+'</b>'+(n===1?esc(v[2]):n===5?esc(v[3]):'')+'</button>';}).join('')+'</div>'+\n      '<div class=\"nav\">'+(st.i>0?'<button class=\"btn sec\" id=\"back\">Back</button>':'')+'</div><div class=\"err\"></div>';\n    var busy=false;\n    app.querySelectorAll('.o5 button').forEach(function(b){b.onclick=function(){if(busy)return;busy=true;\n      app.querySelectorAll('.o5 button').forEach(function(x){x.classList.remove('on');});b.classList.add('on');\n      (st.r[v[0]]=st.r[v[0]]||{})[id]=Number(b.getAttribute('data-v'));save();\n      setTimeout(function(){next();},220);};});\n    var bk=document.getElementById('back');if(bk)bk.onclick=function(){if(st.i>0)st.i--;save();route();};\n  }\n  function next(){\n    var v=VARS[st.part];\n    if(st.i<IDS.length-1){st.i++;save();return route();}\n    var L=IDS.map(function(id){return SPSite.answer(v[0],st.r[v[0]][id],{key:id,shown:[files[id].name]});});\n    send(L,null,function(){if(st.part<VARS.length-1){st.part++;st.i=0;st.order=shuffle(IDS);}else st.step='done';save();route();});\n  }\n  function finish(msg){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st={step:'intro'};save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent=msg||'Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var b=e.target.closest&&e.target.closest('.blk');if(b){b.classList.remove('miss');hideErr();}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='rate')return rate();if(s==='done')return finish();if(s==='stop')return finish('Thank you for your interest. This study is only for people who have not had a negative or traumatic experience in a park, so there are no further questions for you.');intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','park_trauma','age','gender','wheelchair'].concat(VARS.map(function(v){return v[0];})).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('nightscapes')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=IDS.filter(function(m){return !files[m];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"nightscapes\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.step)||a.consent!==true)st={step:'intro'};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
