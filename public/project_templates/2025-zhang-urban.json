   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Plantscape Beauty</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Urban Green Space Plantscapes (SBE)\",\n  \"description\": \"Participants rate the scenic beauty of 40 photographs of planted landscapes in Zhengzhou's urban green spaces (8 each from park, protective, square, affiliated and regional green space) on a 1–7 scale; each photo is shown for 10 s. Rebuilt from Zhang et al. (2025), PLOS ONE 20(9): e0329119, with the 40 photographs printed in the paper's S1 File (CC BY 4.0).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"plots\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 99\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"background\",\n      \"title\": \"Do you study or work in gardening, horticulture or landscape architecture?\",\n      \"description\": \"The original study recruited only adults WITHOUT such a background; filter out 'yes' to match it.\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       },\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"photos\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"beauty\",\n      \"title\": \"How beautiful is this plant landscape?\",\n      \"description\": \"Scenic Beauty Estimation, 1–7: 1 = Extremely unattractive; 2 = Unsightly; 3 = Less aesthetically pleasing; 4 = Average; 5 = More beautiful; 6 = Beautiful; 7 = Extremely beautiful. Keyed by plot code (GY park, FH protective, GC square, FS affiliated, QY regional green space). Standardise per rater (z-score) and average per photo to get the SBE value.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Extremely unattractive\",\n      \"maxRateDescription\": \"Extremely beautiful\",\n      \"isRequired\": true\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"sbe-original\">{\"source\": \"Zhang et al. (2025) PLOS ONE 20(9): e0329119, Tables 12\\u201313\", \"n\": 30, \"top5\": [\"GY7\", \"GC1\", \"GY2\", \"FS1\", \"FS5\"], \"bottom5\": [\"GC4\", \"FH2\", \"GY8\", \"GC6\", \"QY6\"], \"type_mean_SBE\": {\"park\": 0.29, \"affiliated\": 0.19, \"protective\": 0.13, \"square\": -0.18, \"regional\": -0.43}, \"result\": \"Only 17 of 40 plots had SBE above zero; park green spaces scored highest and regional green spaces lowest. SBE agreed with the expert AHP scores (Spearman rs = 0.738).\"}</script>\n<style>\n:root{--bg:#f3f5f1;--card:#fff;--ink:#1f2a22;--muted:#5f6d63;--accent:#2f6b4a;--line:#d8e2d9;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.1rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.view{display:flex;justify-content:center}.view img{width:100%;max-width:480px;height:auto;max-height:52vh;object-fit:contain;display:block;border-radius:10px}\n.timer{height:4px;background:var(--line);border-radius:2px;overflow:hidden;margin:10px auto 0;max-width:480px}.timer>i{display:block;height:100%;background:var(--accent);width:0}\n.scale{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-top:14px}\n.scale button{appearance:none;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:8px;padding:8px 2px;font:inherit;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px}\n.scale button b{font-size:1.05rem}.scale button span{font-size:.72rem;line-height:1.2;color:var(--muted)}\n.scale button.on{background:var(--accent);border-color:var(--accent);color:#fff}.scale button.on span{color:#e6efe8}\n.note{font-size:.85rem;color:var(--muted);text-align:center;margin-top:8px;min-height:1.3em}\n.blank{height:30vh}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\nol.lab{margin:6px 0 0;padding-left:22px;color:var(--ink)}\n@media(max-width:560px){.scale{grid-template-columns:repeat(4,1fr)}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Zhang et al. (2025), PLOS ONE 20(9): e0329119, S1 File (CC BY 4.0), taken by the authors in Zhengzhou, 2023.</footer>\n<script>\n(function(){\n  var KEY='plantscape-sbe:state', LAB=[\"Extremely unattractive\", \"Unsightly\", \"Less aesthetically pleasing\", \"Average\", \"More beautiful\", \"Beautiful\", \"Extremely beautiful\"], VIEW=window.__VIEWMS||10000, GAP=window.__VIEWMS?50:1000;\n  var ORDER=['GY','FH','GC','FS','QY'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null, tm=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function intro(){\n    app.innerHTML='<h1>Plant landscapes</h1><p>You will see 40 photographs of planted areas in city green spaces. Each photo is shown for 10 seconds. Rate how beautiful the plant landscape is, based on your first impression; there is no need to think too much. The next photo appears once 10 seconds have passed and you have given a score.</p><div class=\"card\"><b>Scores</b><ol class=\"lab\">'+LAB.map(function(l){return '<li>'+esc(l)+'</li>';}).join('')+'</ol></div><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+radios('gender')+'<div class=\"f\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"99\"></div>'+radios('background')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var g=app.querySelector('input[name=gender]:checked');if(!g)return err('Please answer: '+Q.gender.title);\n      var age=Number(document.getElementById('age').value);if(!(age>=18&&age<=99))return err('Please enter your age (18 or older).');\n      var b=app.querySelector('input[name=background]:checked');if(!b)return err('Please answer the background question.');\n      send([SPSite.answer('gender',g.value),SPSite.answer('age',age),SPSite.answer('background',b.value)],this,function(){st.step='photos';st.k=0;save();route();});\n    };\n  }\n  function photo(){\n    var c=st.order[st.k], f=files[c], val=null, timeUp=false, sent=false;\n    clearTimeout(tm);\n    app.innerHTML='<p>Photo '+(st.k+1)+' of '+st.order.length+'</p><div class=\"view\"><img alt=\"Photograph of a planted landscape\" src=\"'+esc(f.url)+'\"></div><div class=\"timer\"><i id=\"bar\"></i></div><div class=\"scale\">'+LAB.map(function(l,i){return '<button type=\"button\" data-v=\"'+(i+1)+'\"><b>'+(i+1)+'</b><span>'+esc(l)+'</span></button>';}).join('')+'</div><div class=\"note\" id=\"note\"></div><div class=\"err\"></div>';\n    var bar=document.getElementById('bar'),t0=Date.now();\n    (function tick(){var p=Math.min(1,(Date.now()-t0)/VIEW);if(bar)bar.style.width=(p*100)+'%';if(p<1)tm=setTimeout(tick,100);else{timeUp=true;go();}})();\n    app.querySelectorAll('.scale button').forEach(function(b){b.onclick=function(){if(sent)return;val=Number(b.dataset.v);app.querySelectorAll('.scale button').forEach(function(x){x.classList.toggle('on',x===b);});go();};});\n    function go(){\n      var n=document.getElementById('note');\n      if(val==null){if(timeUp&&n)n.textContent='Please choose a score to continue.';return;}\n      if(!timeUp){if(n)n.textContent='Score saved; the next photo appears when the 10 seconds are over (you can still change it).';return;}\n      if(sent)return;sent=true;\n      SPSite.answer('beauty',val,{key:c,shown:[f.name]}).then(function(r){\n        if(!ok(r)){sent=false;return err(r.error);}\n        st.k++;if(st.k>=st.order.length)st.step='done';save();\n        if(st.step==='done')return route();\n        app.innerHTML='<div class=\"blank\"></div>';tm=setTimeout(route,GAP);\n      });\n    }\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='photos')return photo();if(s==='done')return finish();intro();}\n  function rank(c){var m=/^([A-Z]+)(\\d+)$/.exec(c);if(!m)return [99,c];var i=ORDER.indexOf(m[1]);return [i<0?50:i,Number(m[2])];}\n  SPSite.onReady(function(ctx){\n    ['consent','gender','age','background','beauty'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('plots')||[]).forEach(function(f){if(/\\.(jpe?g|png|webp)$/i.test(f.name))files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var codes=Object.keys(files).sort(function(a,b){var x=rank(a),y=rank(b);return x[0]-y[0]||(x[1]>y[1]?1:x[1]<y[1]?-1:0);});\n    if(!codes.length){app.innerHTML='<h1>Photos missing</h1><p>Upload the plantscape photographs to the media folder \"plots\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var valid=st&&st.order&&st.order.length===codes.length&&st.order.every(function(x){return files[x];});\n    if(!valid)st={step:'intro',k:0,order:codes};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
