   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Public Art and Restorative Streets</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Public Art and Restorative Streets\",\n    \"description\": \"Rate seven versions of one scene on Tanhualin commercial pedestrian street (Wuhan): the street as it is, and the street with a bench-and-shade public art piece in one of six designs (abstract or figurative; theme chime bells, phoenix or Yellow Crane Tower). Each scene is rated on the 11 items of the Perceived Restorativeness Scale (PRS-11), 0 to 10. Rebuilt from Liu & Zhou (2026), Buildings.\",\n    \"locale\": \"en\",\n    \"mediaFolders\": [\"scenes\"],\n    \"pages\": [\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" },\n        { \"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"male\", \"text\": \"Male\" }, { \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"other\", \"text\": \"Other / prefer not to say\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"age_group\", \"title\": \"Age\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"under_18\", \"text\": \"Under 18\" }, { \"value\": \"18_35\", \"text\": \"18–35\" }, { \"value\": \"36_60\", \"text\": \"36–60\" }, { \"value\": \"over_60\", \"text\": \"Over 60\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"education\", \"title\": \"Highest education\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"junior_high\", \"text\": \"Junior high school or below\" }, { \"value\": \"high_school\", \"text\": \"High school / vocational school\" }, { \"value\": \"bachelor\", \"text\": \"Undergraduate / associate degree\" }, { \"value\": \"master_plus\", \"text\": \"Master's degree or above\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"emotional_impact\", \"title\": \"Over the past month, how much have your emotions affected your work and life?\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"none\", \"text\": \"No impact at all\" }, { \"value\": \"slight\", \"text\": \"Slight impact\" }, { \"value\": \"some\", \"text\": \"Some impact\" }, { \"value\": \"significant\", \"text\": \"Significant impact\" }, { \"value\": \"extreme\", \"text\": \"Extreme impact\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"lived_in_wuhan\", \"title\": \"Have you lived in Wuhan for more than two years?\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"yes\", \"text\": \"Yes\" }, { \"value\": \"no\", \"text\": \"No\" } ] }\n      ]},\n      { \"name\": \"scenes\", \"elements\": [\n        { \"type\": \"imageslidergroup\", \"name\": \"prs\", \"title\": \"Perceived Restorativeness Scale (PRS-11)\", \"description\": \"One record per scene: key = scene id (no_public_art, abstract_artifact, abstract_flora_fauna, abstract_architecture, figurative_artifact, figurative_flora_fauna, figurative_architecture); value = the 11 item scores, 0 = not at all, 6 = rather much, 10 = completely. Being away: ba1–ba3; fascination: fa1–fa3; coherence: co1–co3; scope: sc1–sc2.\", \"imageCount\": 1, \"scaleMin\": 0, \"scaleMax\": 10, \"isRequired\": true, \"dimensions\": [\n          { \"id\": \"ba1\", \"label\": \"Places like this are a refuge from nuisances.\", \"left\": \"Not at all\", \"right\": \"Completely\" },\n          { \"id\": \"ba2\", \"label\": \"To get away from things that usually demand my attention, I like to go to places like this.\", \"left\": \"Not at all\", \"right\": \"Completely\" },\n          { \"id\": \"ba3\", \"label\": \"To stop thinking about the things that I must get done, I like to go to places like this.\", \"left\": \"Not at all\", \"right\": \"Completely\" },\n          { \"id\": \"fa1\", \"label\": \"Places like this are fascinating.\", \"left\": \"Not at all\", \"right\": \"Completely\" },\n          { \"id\": \"fa2\", \"label\": \"In places like this, my attention is drawn to many interesting things.\", \"left\": \"Not at all\", \"right\": \"Completely\" },\n          { \"id\": \"fa3\", \"label\": \"In places like this, it is hard to be bored.\", \"left\": \"Not at all\", \"right\": \"Completely\" },\n          { \"id\": \"co1\", \"label\": \"There is a clear order in the physical arrangement of places like this.\", \"left\": \"Not at all\", \"right\": \"Completely\" },\n          { \"id\": \"co2\", \"label\": \"In places like this, it is easy to see how things are organized.\", \"left\": \"Not at all\", \"right\": \"Completely\" },\n          { \"id\": \"co3\", \"label\": \"In places like this, everything seems to have its proper place.\", \"left\": \"Not at all\", \"right\": \"Completely\" },\n          { \"id\": \"sc1\", \"label\": \"Places like this are large enough to allow exploration in many directions.\", \"left\": \"Not at all\", \"right\": \"Completely\" },\n          { \"id\": \"sc2\", \"label\": \"In places like this, there are few boundaries to limit my possibility for moving about.\", \"left\": \"Not at all\", \"right\": \"Completely\" } ] },\n        { \"type\": \"custom\", \"name\": \"scene_seconds\", \"title\": \"Recorded by the page, keyed by scene id: seconds the participant spent on each scene before moving on (the page enforces at least 30 s, as in the paper).\" }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f6f3ee;--card:#fff;--ink:#22201c;--muted:#635d54;--accent:#8a4b2a;--accent-ink:#fff;--line:#ddd5ca;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:24px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.05rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:8px 0 14px}.progress>i{display:block;height:100%;background:var(--accent)}\n.layout{display:block}\n.pic{position:sticky;top:0;z-index:2;background:var(--bg);padding-bottom:8px}\n.stage{background:#2a2724;border-radius:12px;overflow:hidden;height:34vh}\n.stage img{width:100%;height:100%;object-fit:contain;display:block}\n@media (min-width:900px){main.wide{max-width:1280px}.layout{display:grid;grid-template-columns:1.25fr 1fr;gap:20px;align-items:start}.pic{top:16px}.stage{height:auto;aspect-ratio:1.49}.layout .card{margin-top:0}}\n.note{font-size:.92rem;margin-top:10px}\n.item{padding:12px 0;border-bottom:1px solid var(--line)}.item:last-child{border-bottom:0}\n.item b{display:block;font-weight:600;margin-bottom:6px}\n.scale{display:grid;grid-template-columns:repeat(11,1fr);gap:4px}\n.scale button{appearance:none;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:8px;padding:8px 0;font:inherit;font-size:.9rem;font-weight:700;cursor:pointer;min-width:0}\n.scale button.on{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}\n.ends{display:flex;justify-content:space-between;font-size:.76rem;color:var(--muted);margin-top:3px}\n@media (max-width:520px){.scale button{font-size:.8rem;padding:7px 0}}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:16px}.q>b{display:block;margin-bottom:4px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.timer{font-size:.9rem;color:var(--muted);margin-left:12px}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Scenes: Liu &amp; Zhou (2026), Buildings 16(3): 593, Figs 3 and 5 (Tanhualin Street, Wuhan; public art designs by the authors), Creative Commons Attribution License (CC BY 4.0). PRS-11 items (Pasini et al., 2014) in the English wording listed by Kim et al. (2022), IJERPH 19: 10231.</footer>\n<script>\n(function(){\n  var app=document.getElementById('app'), Q={}, files={}, st=null, timer=null;\n  var SCENES=['no_public_art','abstract_artifact','abstract_flora_fauna','abstract_architecture','figurative_artifact','figurative_flora_fauna','figurative_architecture'];\n  var ABOUT=['gender','age_group','education','emotional_impact','lived_in_wuhan'];\n  var MIN_S=30;\n  var IMAGINE='Imagine you are in a state of fatigue after a busy week and are strolling through these scenes during your leisure time.';\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function shuffle(a){a=a.slice();for(var k=a.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1));var x=a[k];a[k]=a[j];a[j]=x;}return a;}\n  function save(){try{localStorage.setItem('liu2026pa:state',JSON.stringify(st));}catch(e){}}\n  function stop(){if(timer){clearInterval(timer);timer=null;}}\n  function radios(n){return (Q[n].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');}\n\n  function intro(){\n    var miss=SCENES.filter(function(s){return !files[s+'.jpg'];});\n    if(miss.length){app.innerHTML='<h1>Images missing</h1><p>Missing in folder “scenes”: '+esc(miss.map(function(s){return s+'.jpg';}).join(', '))+'</p>';return;}\n    app.innerHTML='<h1>How restorative is this street?</h1><p>You will see 7 versions of the same scene on a commercial pedestrian street in Wuhan, China. For each one, answer 11 short statements on a scale from 0 (not at all) to 10 (completely). Each scene stays on screen for at least 30 seconds. About 10 minutes.</p>'+\n      '<div class=\"card\">'+ABOUT.map(function(n){return '<div class=\"q\"><b>'+esc(Q[n].title)+'</b>'+radios(n)+'</div>';}).join('')+'</div>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var vals={},miss=ABOUT.filter(function(n){var r=app.querySelector('input[name='+n+']:checked');if(r)vals[n]=r.value;return !r;});\n      if(miss.length)return err('Please answer: '+miss.map(function(n){return Q[n].title;}).join('; '));\n      var b=this;b.disabled=true;var calls=[SPSite.answer('consent',true)];ABOUT.forEach(function(n){calls.push(SPSite.answer(n,vals[n]));});\n      Promise.all(calls).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}brief();});\n    };\n  }\n\n  function brief(){\n    app.innerHTML='<h1>Before you start</h1><div class=\"card\"><p style=\"color:var(--ink);font-size:1.05rem\">'+esc(IMAGINE)+'</p><p>Then, for each scene, say how much each statement applies: 0 = not at all, 6 = rather much, 10 = completely.</p><button class=\"btn\" id=\"go\">Show the first scene</button></div>';\n    document.getElementById('go').onclick=next;\n  }\n\n  function next(){\n    stop();app.classList.remove('wide');\n    var s=st.order.filter(function(x){return !(st.seconds[x]!=null);})[0];\n    if(!s)return done();\n    scene(s);\n  }\n\n  function scene(s){\n    var dims=Q.prs.dimensions||[], vals={}, t0=Date.now(), n=Object.keys(st.seconds).length, f=files[s+'.jpg'];\n    app.innerHTML='<p>Scene '+(n+1)+' of '+SCENES.length+'</p><div class=\"progress\"><i style=\"width:'+(100*n/SCENES.length)+'%\"></i></div>'+\n      '<div class=\"layout\"><div class=\"pic\"><div class=\"stage\"><img src=\"'+esc(f.url)+'\" alt=\"Street scene\"></div></div>'+\n      '<div class=\"card\"><p class=\"note\" style=\"margin-top:0\">'+esc(IMAGINE)+'</p>'+dims.map(function(d){var b='';for(var v=0;v<=10;v++)b+='<button data-d=\"'+d.id+'\" data-v=\"'+v+'\">'+v+'</button>';return '<div class=\"item\"><b>'+esc(d.label)+'</b><div class=\"scale\">'+b+'</div><div class=\"ends\"><span>0 · not at all</span><span>6 · rather much</span><span>10 · completely</span></div></div>';}).join('')+\n      '<div style=\"margin-top:16px;display:flex;align-items:center\"><button class=\"btn\" id=\"nx\" disabled>Next scene</button><span class=\"timer\" id=\"tm\"></span></div><div class=\"err\"></div></div></div>';\n    app.classList.add('wide');\n    app.querySelectorAll('.scale button').forEach(function(b){b.onclick=function(){err('');var d=b.getAttribute('data-d');vals[d]=Number(b.getAttribute('data-v'));app.querySelectorAll('.scale button[data-d='+d+']').forEach(function(x){x.classList.toggle('on',x===b);});};});\n    var nx=document.getElementById('nx'), tm=document.getElementById('tm');\n    function tick(){var left=MIN_S-Math.floor((Date.now()-t0)/1000);if(left>0){nx.disabled=true;tm.textContent='Please take at least '+left+' more s with this scene.';}else{nx.disabled=false;tm.textContent='';stop();}}\n    stop();timer=setInterval(tick,500);tick();\n    nx.onclick=function(){\n      var miss=dims.filter(function(d){return vals[d.id]==null;});\n      if(miss.length)return err('Please answer all 11 statements ('+miss.length+' left).');\n      var b=this;b.disabled=true;var secs=Math.round((Date.now()-t0)/1000);\n      var ns=JSON.parse(JSON.stringify(st.seconds));ns[s]=secs;\n      SPSite.answer('prs',vals,{key:s,shown:[s+'.jpg']}).then(function(r){\n        if(!ok(r)){b.disabled=false;return err(r.error);}\n        return SPSite.answer('scene_seconds',ns).then(function(r2){if(!ok(r2)){b.disabled=false;return err(r2.error);}st.seconds=ns;save();window.scrollTo(0,0);next();});\n      });\n    };\n  }\n\n  function done(){\n    stop();\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"st\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){\n      if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){if(m.some(function(x){return x!=='prs'&&x!=='scene_seconds';}))intro();else{st.seconds={};save();next();}},1800);}\n      else{try{localStorage.removeItem('liu2026pa:state');}catch(e){}var e=document.getElementById('st');if(e)e.textContent='Your ratings are saved.';}\n    });\n  }\n\n  SPSite.onReady(function(ctx){\n    ['consent','prs','scene_seconds'].concat(ABOUT).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('scenes')||[]).forEach(function(f){files[f.name]=f;});\n    try{st=JSON.parse(localStorage.getItem('liu2026pa:state'));}catch(e){st=null;}\n    if(!st||!Array.isArray(st.order)||st.order.length!==SCENES.length||st.order.some(function(x){return SCENES.indexOf(x)<0;}))st={order:shuffle(SCENES)}; // scene order randomised per participant, as in the paper\n    var a=(ctx&&ctx.answers)||{};\n    st.seconds=(a.scene_seconds&&typeof a.scene_seconds==='object')?a.scene_seconds:{};\n    save();\n    if(a.consent===true){if(Object.keys(st.seconds).length)next();else brief();}else intro();\n  });\n})();\n</script>\n</body>\n</html>\n",
