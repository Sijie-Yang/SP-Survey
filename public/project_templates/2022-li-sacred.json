   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Buddhist Temple Landscapes</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Buddhist Temple Landscapes: Outsiders and Insiders\",\n  \"description\": \"Participants give age, gender, Buddhist identification and temple-visit frequency, then see 48 photographs of Han Chinese Buddhist temples in Suzhou in random order (12 squares, 12 architecture, 12 waterscapes, 12 plant scenes), each after a 2 s fixation cross for 10 s, and rate their landscape preference from -3 (not at all) to +3 (very much) with an optional reason. Rebuilt from Li, Ge & Wang (2022), Frontiers in Psychology 13: 743933, with the photographs printed in the paper's Figure 2 (CC BY 4.0). Analysis: mean preference by landscape type; compare insiders (Buddhist, regular temple visitors) with outsiders (not Buddhist, never visited).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"temples\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"buddhist\",\n      \"title\": \"Do you identify as a Buddhist?\",\n      \"description\": \"Our wording; the paper recorded religious views to separate insiders from outsiders.\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       },\n       {\n        \"value\": \"prefer_not\",\n        \"text\": \"Prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"temple_visits\",\n      \"title\": \"How often do you visit Buddhist temples?\",\n      \"description\": \"Our wording. Paper: insiders visit temples periodically; outsiders had never visited a sacred landscape.\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"never\",\n        \"text\": \"Never\"\n       },\n       {\n        \"value\": \"rarely\",\n        \"text\": \"Once or a few times in my life\"\n       },\n       {\n        \"value\": \"yearly\",\n        \"text\": \"A few times a year\"\n       },\n       {\n        \"value\": \"monthly\",\n        \"text\": \"About once a month or more\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"photos\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"preference\",\n      \"title\": \"How much do you like this landscape?\",\n      \"rateMin\": -3,\n      \"rateMax\": 3,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much\",\n      \"isRequired\": true,\n      \"description\": \"7-point preference, -3 to +3. Keyed by photo: square01-12, architecture01-12, water01-12, plant01-12 (rows of the paper's Figure 2, left to right, top row = 01-06).\"\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"reason\",\n      \"title\": \"Why? (optional)\",\n      \"description\": \"Free-text explanation of the preference. Keyed by photo: square01-12, architecture01-12, water01-12, plant01-12 (rows of the paper's Figure 2, left to right, top row = 01-06).\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"temples-original\">{\"source\": \"Li, Ge & Wang (2022) Frontiers in Psychology 13: 743933\", \"n\": 90, \"participants\": \"45 outsiders (not Buddhist, never visited a sacred landscape; university social platforms) and 45 insiders (middle-aged local Buddhist residents who visit temples periodically), Suzhou; eye tracking then preference rating\", \"result\": \"Both groups preferred architecture > waterscapes > plants > squares. Insiders rated all types higher (mean 1.72 vs 0.27 on -3..+3); outsiders rated squares slightly negative (-0.12) and insiders positive (1.38).\"}</script>\n<style>\n:root{--bg:#f6f3ec;--card:#fff;--ink:#24211b;--muted:#665f52;--accent:#9a5a12;--line:#e2dccf;--warn:#b3261e;--sel:#f7ecdc}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.view{position:fixed;inset:0;background:#fff;display:flex;align-items:center;justify-content:center;z-index:5}\n.view img{width:min(96vw,640px);height:auto;display:block}\n.cross{font-size:48px;color:#333;font-weight:300}\n.thumb{width:100%;max-width:420px;border-radius:8px;display:block;margin:0 auto 12px}\n.row{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}\n.row label{display:flex;flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:8px;padding:6px 0;cursor:pointer;font-size:.82rem}\n.row label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.row input{margin:0 0 2px}\n.ends{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-top:3px}\ntextarea{width:100%;font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;min-height:60px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:760px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Li, Ge &amp; Wang (2022), Frontiers in Psychology 13: 743933, Figure 2 (doi:10.3389/fpsyg.2022.743933, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='temple-landscapes:state', T=window.__VIEWMS?{fix:window.__VIEWMS,view:window.__VIEWMS}:{fix:2000,view:10000};\n  var app=document.getElementById('app'), Q={}, files={}, ids=[], st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function intro(){\n    app.innerHTML='<h1>Temple landscapes</h1><p>You will see '+st.order.length+' photographs taken in Buddhist temples in a Chinese city. Each starts with a small cross in the middle of the screen; look at the cross, then look at the photo freely for 10 seconds. After each photo, say how much you like the landscape and, if you wish, why. It takes about 20 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"110\"></div>'+radios('gender')+radios('buddhist')+radios('temple_visits')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var age=Number(document.getElementById('age').value),g=val('gender'),b=val('buddhist'),v=val('temple_visits');\n      if(!(age>=18&&age<=110))return err('Please enter your age.');if(!g||!b||!v)return err('Please answer every question.');\n      send([SPSite.answer('age',age),SPSite.answer('gender',g),SPSite.answer('buddhist',b),SPSite.answer('temple_visits',v)],this,function(){st.step='trial';st.k=0;st.phase='view';save();route();});\n    };\n  }\n  function trial(){\n    if(st.phase==='q')return rate();\n    var id=st.order[st.k],im=new Image();im.src=files[id].url;im.alt='Temple landscape photograph';\n    var v=document.createElement('div');v.className='view';v.innerHTML='<div class=\"cross\">+</div>';app.innerHTML='';app.appendChild(v);\n    setTimeout(function(){v.innerHTML='';v.appendChild(im);setTimeout(function(){st.phase='q';save();route();},T.view);},T.fix);\n  }\n  function rate(){\n    var id=st.order[st.k],h='<div class=\"row\">';for(var i=-3;i<=3;i++)h+='<label><input type=\"radio\" name=\"q_pref\" value=\"'+i+'\">'+(i>0?'+'+i:i)+'</label>';h+='</div><div class=\"ends\"><span>Not at all</span><span>Very much</span></div>';\n    app.innerHTML='<div class=\"prog\">Photo '+(st.k+1)+' of '+st.order.length+'</div><div class=\"card\"><img class=\"thumb\" alt=\"The photo you just saw\" src=\"'+esc(files[id].url)+'\"><b>'+esc(Q.preference.title)+'</b><div style=\"margin-top:8px\">'+h+'</div><div class=\"f\"><b>'+esc(Q.reason.title)+'</b><textarea id=\"why\" maxlength=\"400\"></textarea></div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next photo</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var p=val('q_pref');if(p==null)return err('Please choose how much you like this landscape.');\n      var w=document.getElementById('why').value.trim(),sh=[files[id].name],list=[SPSite.answer('preference',Number(p),{key:id,shown:sh})];\n      if(w)list.push(SPSite.answer('reason',w,{key:id,shown:sh}));\n      send(list,this,function(){st.k++;st.phase='view';if(st.k>=st.order.length)st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='trial')return trial();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','buddhist','temple_visits','preference','reason'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('temples')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name)){var k=f.name.replace(/\\.[^.]+$/,'');files[k]=f;ids.push(k);}});\n    if(ids.length<2){app.innerHTML='<h1>Photos missing</h1><p>Upload the photographs to the media folder \"temples\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var valid=st&&st.order&&st.order.length===ids.length&&st.order.every(function(x){return files[x];});\n    if(!valid)st={step:'intro',order:shuffle(ids),k:0,phase:'view'};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    if(st.step==='trial'&&st.phase!=='q')st.phase='view';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
