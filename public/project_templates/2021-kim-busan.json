   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Busan Street Trees</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Citizens' Preference and Perception of Street Trees\",\n  \"description\": \"Faithful replication of the street-tree survey of Kim, Lee, Lee & Choi (2021), Citizens' Preference and Perception of Street Trees of Main Boulevards in Busan, South Korea, Sustainability 13(6): 3141. Participants see street photographs of the 12 most common street tree species in Busan and (1) rate each on 15 five-point word pairs (6 visual properties, 9 affective properties), (2) pick their three most and three least preferred species and say why, (3) rate the similarity of every pair of species (66 pairs), then give gender, age, education, monthly income and years of residence. Property ratings are keyed by species; similarity by species pair.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"trees\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"properties\",\n    \"elements\": [\n     {\n      \"type\": \"matrix\",\n      \"name\": \"properties\",\n      \"title\": \"How do you see this street tree? Choose a point between each pair of words.\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"simple_complex\",\n        \"text\": \"Simple – Complex\"\n       },\n       {\n        \"value\": \"covered_exposed\",\n        \"text\": \"Covered – Exposed\"\n       },\n       {\n        \"value\": \"closed_open\",\n        \"text\": \"Closed – Open\"\n       },\n       {\n        \"value\": \"common_unique\",\n        \"text\": \"Common – Unique\"\n       },\n       {\n        \"value\": \"nuisance\",\n        \"text\": \"Low nuisance – High nuisance\"\n       },\n       {\n        \"value\": \"familiar\",\n        \"text\": \"Unfamiliar – Familiar\"\n       },\n       {\n        \"value\": \"pleasant\",\n        \"text\": \"Unpleasant – Pleasant\"\n       },\n       {\n        \"value\": \"exciting\",\n        \"text\": \"Boring – Exciting\"\n       },\n       {\n        \"value\": \"relaxing\",\n        \"text\": \"Distressing – Relaxing\"\n       },\n       {\n        \"value\": \"safe\",\n        \"text\": \"Fearful – Safe\"\n       },\n       {\n        \"value\": \"interesting\",\n        \"text\": \"Uninteresting – Interesting\"\n       },\n       {\n        \"value\": \"beautiful\",\n        \"text\": \"Ugly – Beautiful\"\n       },\n       {\n        \"value\": \"good\",\n        \"text\": \"Bad – Good\"\n       },\n       {\n        \"value\": \"likable\",\n        \"text\": \"Dislikable – Likable\"\n       },\n       {\n        \"value\": \"warm\",\n        \"text\": \"Cold – Warm\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       }\n      ],\n      \"description\": \"Keyed by species. 1 = left word, 5 = right word.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"preference\",\n    \"elements\": [\n     {\n      \"type\": \"ranking\",\n      \"name\": \"preferred\",\n      \"title\": \"Choose the three street trees you prefer most (1st, 2nd, 3rd).\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"cherry\",\n        \"text\": \"Yoshino cherry\"\n       },\n       {\n        \"value\": \"maidenhair\",\n        \"text\": \"Maidenhair\"\n       },\n       {\n        \"value\": \"zelkova\",\n        \"text\": \"Sawleaf zelkova\"\n       },\n       {\n        \"value\": \"bottonwood\",\n        \"text\": \"Bottonwood\"\n       },\n       {\n        \"value\": \"magnolia\",\n        \"text\": \"Silver magnolia\"\n       },\n       {\n        \"value\": \"scholar\",\n        \"text\": \"Chinese scholar\"\n       },\n       {\n        \"value\": \"fringe\",\n        \"text\": \"Retusa fringe\"\n       },\n       {\n        \"value\": \"pine\",\n        \"text\": \"Japanese black pine\"\n       },\n       {\n        \"value\": \"holly\",\n        \"text\": \"Round-leaf holly\"\n       },\n       {\n        \"value\": \"maple\",\n        \"text\": \"Trident maple\"\n       },\n       {\n        \"value\": \"chestnut\",\n        \"text\": \"Japanese horse chestnut\"\n       },\n       {\n        \"value\": \"hackberry\",\n        \"text\": \"Japanese hackberry\"\n       }\n      ]\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"reason_preferred\",\n      \"title\": \"Why did you choose your most preferred tree?\",\n      \"isRequired\": false\n     },\n     {\n      \"type\": \"ranking\",\n      \"name\": \"non_preferred\",\n      \"title\": \"Choose the three street trees you like least (1st = least preferred).\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"cherry\",\n        \"text\": \"Yoshino cherry\"\n       },\n       {\n        \"value\": \"maidenhair\",\n        \"text\": \"Maidenhair\"\n       },\n       {\n        \"value\": \"zelkova\",\n        \"text\": \"Sawleaf zelkova\"\n       },\n       {\n        \"value\": \"bottonwood\",\n        \"text\": \"Bottonwood\"\n       },\n       {\n        \"value\": \"magnolia\",\n        \"text\": \"Silver magnolia\"\n       },\n       {\n        \"value\": \"scholar\",\n        \"text\": \"Chinese scholar\"\n       },\n       {\n        \"value\": \"fringe\",\n        \"text\": \"Retusa fringe\"\n       },\n       {\n        \"value\": \"pine\",\n        \"text\": \"Japanese black pine\"\n       },\n       {\n        \"value\": \"holly\",\n        \"text\": \"Round-leaf holly\"\n       },\n       {\n        \"value\": \"maple\",\n        \"text\": \"Trident maple\"\n       },\n       {\n        \"value\": \"chestnut\",\n        \"text\": \"Japanese horse chestnut\"\n       },\n       {\n        \"value\": \"hackberry\",\n        \"text\": \"Japanese hackberry\"\n       }\n      ]\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"reason_non_preferred\",\n      \"title\": \"Why did you choose your least preferred tree?\",\n      \"isRequired\": false\n     }\n    ]\n   },\n   {\n    \"name\": \"similarity\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"similarity\",\n      \"title\": \"How similar do these two street trees look to you?\",\n      \"isRequired\": true,\n      \"rateValues\": [\n       {\n        \"value\": 1,\n        \"text\": \"Not similar at all\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"Very similar\"\n       }\n      ],\n      \"description\": \"Keyed by species pair (a__b, alphabetical).\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"age\",\n      \"title\": \"Age (years)\",\n      \"inputType\": \"number\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Education level\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"high_school\",\n        \"text\": \"High school or below\"\n       },\n       {\n        \"value\": \"junior_college\",\n        \"text\": \"Junior college\"\n       },\n       {\n        \"value\": \"university\",\n        \"text\": \"University\"\n       },\n       {\n        \"value\": \"graduate\",\n        \"text\": \"Graduate school\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"income\",\n      \"title\": \"Monthly income\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"lt2m\",\n        \"text\": \"Below ₩2,000,000\"\n       },\n       {\n        \"value\": \"2-3m\",\n        \"text\": \"₩2,000,000–3,000,000\"\n       },\n       {\n        \"value\": \"3-4m\",\n        \"text\": \"₩3,000,000–4,000,000\"\n       },\n       {\n        \"value\": \"4-5m\",\n        \"text\": \"₩4,000,000–5,000,000\"\n       },\n       {\n        \"value\": \"gt5m\",\n        \"text\": \"Above ₩5,000,000\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"residence_years\",\n      \"title\": \"How many years have you lived in this city?\",\n      \"inputType\": \"number\",\n      \"isRequired\": true\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"tree-results\">{\"source\":\"Kim et al. (2021) Sustainability 13:3141, Section 3.1; share of respondents naming the species first\",\"n\":128,\"most_preferred_first\":{\"cherry\":37.1,\"maple\":17.9,\"pine\":7.9,\"maidenhair\":7.1,\"zelkova\":7.1},\"least_preferred_first\":{\"maidenhair\":22.1,\"chestnut\":16.4,\"fringe\":15.7,\"pine\":12.1,\"bottonwood\":7.9}}</script>\n<style>\n:root{--bg:#f3f2ee;--card:#fff;--ink:#1d1f1c;--muted:#5d6159;--accent:#3d6b4f;--line:#d9dad2;--warn:#b3261e;--sel:#e0ece4}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1100px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:14px}\n.b{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px}\n.b img{width:100%;height:auto;display:block;border-radius:8px}\n.b .no{font-weight:700;margin:6px 0 4px}\n.o{display:grid;grid-template-columns:repeat(6,1fr);gap:3px}\n.tr{display:grid;grid-template-columns:7.5em 1fr 7.5em;align-items:center;gap:6px;padding:7px 0;border-top:1px solid var(--line)}\n.tr:first-of-type{border-top:0}.tr .l{text-align:right;font-size:.88rem}.tr .r{font-size:.88rem}\n.sc{display:grid;grid-template-columns:repeat(5,1fr);gap:3px}\n.sc label{display:flex;justify-content:center;align-items:center;border:1px solid var(--line);border-radius:8px;padding:8px 0;cursor:pointer;font-weight:600}\n.sc label:has(input:checked){background:var(--sel);border-color:var(--accent)}.sc input{display:none}\n.tr.miss{outline:2px solid var(--warn);outline-offset:2px;border-radius:6px}\n.one{max-width:620px}.one img{width:100%;border-radius:10px;display:block}\n.pair{display:grid;grid-template-columns:1fr 1fr;gap:10px}.pair img{width:100%;border-radius:8px;display:block}.pair .nm{font-weight:600;margin-top:4px;font-size:.92rem}\n.thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.thumbs img{width:100%;border-radius:6px;display:block}.thumbs div{font-size:.8rem;text-align:center}\nselect,textarea,input.txt{font:inherit;padding:9px 11px;border:1px solid var(--line);border-radius:10px;margin-top:6px;width:100%;max-width:380px;background:#fff}\ntextarea{max-width:100%;min-height:70px}\n.prog{height:6px;background:var(--line);border-radius:3px;margin:6px 0 12px}.prog i{display:block;height:100%;background:var(--accent);border-radius:3px}\n.sim{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;margin-top:12px}\n.sim button{font:inherit;border:1px solid var(--line);background:#fff;border-radius:10px;padding:10px 2px;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:.72rem;color:var(--muted)}\n.sim button b{font-size:1rem;color:var(--ink)}.sim button.on{background:var(--sel);border-color:var(--accent)}\n@media (max-width:700px){.tr{grid-template-columns:5.6em 1fr 5.6em}.tr .l,.tr .r{font-size:.78rem}.thumbs{grid-template-columns:repeat(3,1fr)}}\n.o label{display:flex;flex-direction:column;align-items:center;gap:2px;border:1px solid var(--line);border-radius:8px;padding:6px 1px;cursor:pointer;font-size:.68rem;line-height:1.15;text-align:center;color:var(--muted)}\n.o label b{font-size:.95rem;color:var(--ink)}\n.o label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.o input{display:none}\n.b.miss{outline:2px solid var(--warn);outline-offset:2px}\n.blk{margin-top:14px}.blk:first-child{margin-top:0}\n.blk.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.err{color:var(--warn);margin-top:8px;min-height:1.5em;line-height:1.5}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:700px){.grid{grid-template-columns:1fr}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs and design: Kim, Lee, Lee &amp; Choi (2021), Citizens' Preference and Perception of Street Trees of Main Boulevards in Busan, South Korea, Sustainability 13(6): 3141, Figure 2, street-context photographs (doi:10.3390/su13063141, CC BY 4.0). Removed on request of the authors.</footer>\n<script>\n(function(){\n  var KEY='kim2021busan:state', SP=[[\"cherry\", \"Yoshino cherry\"], [\"maidenhair\", \"Maidenhair\"], [\"zelkova\", \"Sawleaf zelkova\"], [\"bottonwood\", \"Bottonwood\"], [\"magnolia\", \"Silver magnolia\"], [\"scholar\", \"Chinese scholar\"], [\"fringe\", \"Retusa fringe\"], [\"pine\", \"Japanese black pine\"], [\"holly\", \"Round-leaf holly\"], [\"maple\", \"Trident maple\"], [\"chestnut\", \"Japanese horse chestnut\"], [\"hackberry\", \"Japanese hackberry\"]], ROWS=[[\"simple_complex\", \"Simple\", \"Complex\"], [\"covered_exposed\", \"Covered\", \"Exposed\"], [\"closed_open\", \"Closed\", \"Open\"], [\"common_unique\", \"Common\", \"Unique\"], [\"nuisance\", \"Low nuisance\", \"High nuisance\"], [\"familiar\", \"Unfamiliar\", \"Familiar\"], [\"pleasant\", \"Unpleasant\", \"Pleasant\"], [\"exciting\", \"Boring\", \"Exciting\"], [\"relaxing\", \"Distressing\", \"Relaxing\"], [\"safe\", \"Fearful\", \"Safe\"], [\"interesting\", \"Uninteresting\", \"Interesting\"], [\"beautiful\", \"Ugly\", \"Beautiful\"], [\"good\", \"Bad\", \"Good\"], [\"likable\", \"Dislikable\", \"Likable\"], [\"warm\", \"Cold\", \"Warm\"]], BG=['gender','age','education','income','residence_years'];\n  var IDS=SP.map(function(s){return s[0];}), NAME={}; SP.forEach(function(s){NAME[s[0]]=s[1];});\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='';}}\n  function hideErr(){var e=app.querySelector('.err');if(e&&!app.querySelector('.miss'))e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function pairs(){var P=[];for(var i=0;i<IDS.length;i++)for(var j=i+1;j<IDS.length;j++)P.push(Math.random()<.5?[IDS[i],IDS[j]]:[IDS[j],IDS[i]]);return shuffle(P);}\n  function pkey(a,b){return a<b?a+'__'+b:b+'__'+a;}\n  function intro(){\n    app.innerHTML='<h1>Street trees in your city</h1><p>This survey is about the trees planted along main streets. You will see street photographs of 12 street tree species. First you describe each tree with 15 pairs of words, then you choose the trees you like most and least, and finally you say how similar pairs of trees look to you. At the end there are a few questions about you. It takes about 20 minutes.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='props';st.p=0;st.order=shuffle(IDS);st.r={};save();route();});};\n  }\n  function props(){\n    var id=st.order[st.p], r=st.r[id]||{};\n    app.innerHTML='<h2>Tree '+(st.p+1)+' of '+IDS.length+': '+esc(NAME[id])+'</h2><div class=\"prog\"><i style=\"width:'+Math.round(st.p/IDS.length*100)+'%\"></i></div><p>'+esc(Q.properties.title)+'</p><div class=\"one\"><img alt=\"Street with '+esc(NAME[id])+' trees\" src=\"'+esc(files[id].url)+'\"></div><div class=\"card\">'+\n      ROWS.map(function(w){return '<div class=\"tr\" data-k=\"'+w[0]+'\"><span class=\"l\">'+esc(w[1])+'</span><span class=\"sc\">'+[1,2,3,4,5].map(function(v){return '<label><input type=\"radio\" name=\"p_'+w[0]+'\" value=\"'+v+'\"'+(r[w[0]]===v?' checked':'')+'>'+v+'</label>';}).join('')+'</span><span class=\"r\">'+esc(w[2])+'</span></div>';}).join('')+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var miss=[],v={};\n      ROWS.forEach(function(w){var x=app.querySelector('input[name=\"p_'+w[0]+'\"]:checked');if(x)v[w[0]]=Number(x.value);else miss.push(app.querySelector('.tr[data-k=\"'+w[0]+'\"]'));});\n      st.r[id]=v;save();\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please answer every word pair.');}\n      send([SPSite.answer('properties',v,{key:id,shown:[files[id].name]})],this,function(){if(st.p<IDS.length-1)st.p++;else{st.step='pref';}save();route();});};\n  }\n  function sel(n,label){return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+label+'</b><br><select id=\"'+n+'\"><option value=\"\">Choose a tree…</option>'+IDS.map(function(k){return '<option value=\"'+k+'\">'+esc(NAME[k])+'</option>';}).join('')+'</select></div>';}\n  function pref(){\n    app.innerHTML='<h2>Which street trees do you prefer?</h2><div class=\"card\"><div class=\"thumbs\">'+IDS.map(function(k){return '<div><img alt=\"\" src=\"'+esc(files[k].url)+'\">'+esc(NAME[k])+'</div>';}).join('')+'</div></div><div class=\"card\">'+\n      '<p style=\"color:var(--ink)\"><b>'+esc(Q.preferred.title)+'</b></p>'+sel('pre1','Most preferred')+sel('pre2','Second')+sel('pre3','Third')+\n      '<div class=\"blk\" data-n=\"rp\"><b>'+esc(Q.reason_preferred.title)+'</b><textarea id=\"rp\" maxlength=\"500\"></textarea></div>'+\n      '<p style=\"color:var(--ink);margin-top:22px\"><b>'+esc(Q.non_preferred.title)+'</b></p>'+sel('non1','Least preferred')+sel('non2','Second')+sel('non3','Third')+\n      '<div class=\"blk\" data-n=\"rn\"><b>'+esc(Q.reason_non_preferred.title)+'</b><textarea id=\"rn\" maxlength=\"500\"></textarea></div>'+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var miss=[],g=function(n){var v=document.getElementById(n).value;if(!v)miss.push(app.querySelector('.blk[data-n=\"'+n+'\"]'));return v;};\n      var P=[g('pre1'),g('pre2'),g('pre3')],N=[g('non1'),g('non2'),g('non3')];\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please choose three trees in each list.');}\n      var all=P.concat(N);if(new Set(all).size<6)return err('Each tree can appear only once across both lists.');\n      var L=[SPSite.answer('preferred',P),SPSite.answer('non_preferred',N)],a=document.getElementById('rp').value.trim(),b=document.getElementById('rn').value.trim();\n      if(a)L.push(SPSite.answer('reason_preferred',a));if(b)L.push(SPSite.answer('reason_non_preferred',b));\n      send(L,this,function(){st.step='simi';st.s=0;st.pairs=pairs();save();route();});};\n  }\n  function simi(){\n    var pr=st.pairs[st.s],a=pr[0],b=pr[1],sc=Q.similarity.rateValues||[];\n    app.innerHTML='<h2>Pair '+(st.s+1)+' of '+st.pairs.length+'</h2><div class=\"prog\"><i style=\"width:'+Math.round(st.s/st.pairs.length*100)+'%\"></i></div><p>'+esc(Q.similarity.title)+'</p><div class=\"pair\"><div><img alt=\"\" src=\"'+esc(files[a].url)+'\"><div class=\"nm\">'+esc(NAME[a])+'</div></div><div><img alt=\"\" src=\"'+esc(files[b].url)+'\"><div class=\"nm\">'+esc(NAME[b])+'</div></div></div>'+\n      '<div class=\"sim\">'+sc.map(function(s){return '<button type=\"button\" data-v=\"'+s.value+'\"><b>'+s.value+'</b>'+(Number(s.value)===1||Number(s.value)===5?esc(s.text):'&nbsp;')+'</button>';}).join('')+'</div><div class=\"err\"></div>';\n    var busy=false;\n    Array.prototype.forEach.call(app.querySelectorAll('.sim button'),function(bt){bt.onclick=function(){if(busy)return;busy=true;bt.classList.add('on');\n      SPSite.answer('similarity',Number(bt.getAttribute('data-v')),{key:pkey(a,b),shown:[files[a].name,files[b].name]}).then(function(r){if(!ok(r)){busy=false;bt.classList.remove('on');return err(r.error);}\n        setTimeout(function(){if(st.s<st.pairs.length-1)st.s++;else st.step='about';save();route();},180);});};});\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+BG.map(function(n){var q=Q[n];\n      if(q.type==='text')return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b><br><input class=\"txt\" id=\"f_'+n+'\" type=\"number\" min=\"0\" max=\"120\" inputmode=\"numeric\"></div>';\n      return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var L=[],miss=[];\n      BG.forEach(function(n){var q=Q[n];\n        if(q.type==='text'){var v=document.getElementById('f_'+n).value.trim();if(v===''||isNaN(Number(v))||Number(v)<0){miss.push(app.querySelector('.blk[data-n=\"'+n+'\"]'));return;}L.push(SPSite.answer(n,Number(v)));return;}\n        var x=app.querySelector('input[name=\"'+n+'\"]:checked');if(!x){miss.push(app.querySelector('.blk[data-n=\"'+n+'\"]'));return;}\n        L.push(SPSite.answer(n,x.value));});\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please answer the marked questions.');}\n      send(L,this,function(){st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var b=e.target.closest&&e.target.closest('.tr,.blk');if(b){b.classList.remove('miss');hideErr();}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='props')return props();if(s==='pref')return pref();if(s==='simi')return simi();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','properties','preferred','non_preferred','reason_preferred','reason_non_preferred','similarity'].concat(BG).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('trees')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=IDS.filter(function(k){return !files[k];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"trees\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.step)||a.consent!==true)st={step:'intro'};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
