   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Colour of Bike Lane Crossings</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Colour of Bike Lane Crossings\",\n    \"description\": \"Three real bike-lane intersections in Santiago, Chile (fully painted, line-delimited, partially painted in a chessboard pattern), each shown in five pavement colours (yellow, blue, green, white, red): 15 pictures in random order. For each picture participants rate three statements on a 5-point agreement scale: the colour is clearly distinguishable (saliency), the colour seems pleasant (liking), the colour seems appropriate for my safety (safety). Rebuilt from Vera-Villarroel et al. (2016), PLOS ONE.\",\n    \"locale\": \"en\",\n    \"mediaFolders\": [\"intersections\"],\n    \"pages\": [\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" },\n        { \"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"male\", \"text\": \"Male\" }, { \"value\": \"other\", \"text\": \"Other / prefer not to say\" } ] },\n        { \"type\": \"number\", \"name\": \"age\", \"title\": \"Age (years)\", \"min\": 18, \"max\": 99, \"isRequired\": true }\n      ]},\n      { \"name\": \"pictures\", \"elements\": [\n        { \"type\": \"imageslidergroup\", \"name\": \"bike_lane\", \"title\": \"The colour of this bike lane intersection…\", \"description\": \"One record per picture: key = design_colour (design: full = fully painted, line = line-delimited, chess = partially painted chessboard; colour: yellow, blue, green, white, red); shown = the picture file. Values 1–5: 1 = I strongly disagree, 5 = I strongly agree.\", \"imageCount\": 1, \"scaleMin\": 1, \"scaleMax\": 5, \"isRequired\": true, \"dimensions\": [\n          { \"id\": \"saliency\", \"label\": \"The colour of this bike lane intersection is clearly distinguishable.\", \"left\": \"I strongly disagree\", \"right\": \"I strongly agree\" },\n          { \"id\": \"liking\", \"label\": \"The colour of this bike lane intersection seems pleasant to me.\", \"left\": \"I strongly disagree\", \"right\": \"I strongly agree\" },\n          { \"id\": \"safety\", \"label\": \"The colour of this bike lane intersection seems appropriate for my safety.\", \"left\": \"I strongly disagree\", \"right\": \"I strongly agree\" } ] }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f3f3f1;--card:#fff;--ink:#1d1f22;--muted:#5b6068;--accent:#1f5f8b;--accent-ink:#fff;--line:#d6d9dd;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:24px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:8px 0 14px}.progress>i{display:block;height:100%;background:var(--accent)}\n.pic{background:#dfe2e5;border-radius:12px;overflow:hidden;display:flex;align-items:center;justify-content:center;aspect-ratio:16/10}\n.pic img{width:100%;height:100%;object-fit:contain;display:block}\n.item{margin-top:16px}.item b{display:block;font-weight:600;margin-bottom:6px}\n.scale{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}\n.scale button{appearance:none;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:10px;padding:8px 2px;font:inherit;cursor:pointer;line-height:1.2;min-width:0}\n.scale button span{display:block;font-weight:700}.scale button small{display:block;font-size:.72rem;color:var(--muted)}\n.scale button.on{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}.scale button.on small{color:#e3edf4}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:16px}.q>b{display:block;margin-bottom:4px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:120px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Pictures: Vera-Villarroel et al. (2016), PLOS ONE 11(8): e0160399, Figs 1–3 (photographs by the authors, colours digitally modified), Creative Commons Attribution License (CC BY 4.0). Faces were blacked out by the authors.</footer>\n<script>\n(function(){\n  var app=document.getElementById('app'), Q={}, files={}, order=[], done={}, i=0;\n  var DESIGNS=['full','line','chess'], COLOURS=['yellow','blue','green','white','red'];\n  var AGREE=['I strongly disagree','I disagree','Neither','I agree','I strongly agree'];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function shuffle(a){a=a.slice();for(var k=a.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1));var x=a[k];a[k]=a[j];a[j]=x;}return a;}\n  function keys(){var u=[];DESIGNS.forEach(function(d){COLOURS.forEach(function(c){u.push(d+'_'+c);});});return u;}\n  function dims(){return (Q.bike_lane.dimensions&&Q.bike_lane.dimensions.length)?Q.bike_lane.dimensions:[{id:'saliency',label:'The colour of this bike lane intersection is clearly distinguishable.'},{id:'liking',label:'The colour of this bike lane intersection seems pleasant to me.'},{id:'safety',label:'The colour of this bike lane intersection seems appropriate for my safety.'}];}\n  function setup(){\n    var all=keys(), saved=null;\n    try{saved=JSON.parse(localStorage.getItem('vera2016:order'));}catch(e){}\n    if(Array.isArray(saved)&&saved.length===all.length&&saved.every(function(u){return all.indexOf(u)>=0;}))order=saved;\n    else{order=shuffle(all);try{localStorage.setItem('vera2016:order',JSON.stringify(order));}catch(e){}} // all 15 pictures in random order, as in the paper\n  }\n  function radios(n){return (Q[n].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');}\n  function intro(){\n    var miss=keys().filter(function(k){return !files[k+'.jpg'];});\n    if(miss.length){app.innerHTML='<h1>Pictures missing</h1><p>Missing in folder “intersections”: '+esc(miss.map(function(k){return k+'.jpg';}).join(', '))+'</p>';return;}\n    app.innerHTML='<h1>What colour should a bike lane crossing be?</h1><p>You will see 15 pictures of bike lane crossings at street intersections in Santiago, Chile. The same three crossings appear in different pavement colours. For each picture, say how much you agree with three short statements about its colour. About 5 minutes.</p>'+\n      '<div class=\"card\"><div class=\"q\" style=\"margin-top:0\"><b>'+esc(Q.gender.title)+'</b>'+radios('gender')+'</div><div class=\"q\"><b>'+esc(Q.age.title||'Age')+'</b><input type=\"number\" id=\"age\" min=\"18\" max=\"99\" inputmode=\"numeric\"></div></div>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var g=app.querySelector('input[name=gender]:checked');if(!g)return err('Please answer: '+Q.gender.title);\n      var av=document.getElementById('age').value, age=Number(av);if(!av||!(age>=18&&age<=99))return err('Please enter your age (18–99).');\n      var b=this;b.disabled=true;\n      Promise.all([SPSite.answer('consent',true),SPSite.answer('gender',g.value),SPSite.answer('age',age)]).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}i=0;trial();});\n    };\n  }\n  function trial(){\n    while(i<order.length&&done[order[i]])i++;\n    if(i>=order.length)return finish();\n    var k=order[i], f=files[k+'.jpg'], n=Object.keys(done).length, vals={};\n    var items=dims().map(function(d){var b='';for(var v=1;v<=5;v++)b+='<button data-d=\"'+esc(d.id)+'\" data-v=\"'+v+'\"><span>'+v+'</span><small>'+esc(AGREE[v-1])+'</small></button>';\n      return '<div class=\"item\"><b>'+esc(d.label)+'</b><div class=\"scale\">'+b+'</div></div>';}).join('');\n    app.innerHTML='<p>Picture '+(n+1)+' of '+order.length+'</p><div class=\"progress\"><i style=\"width:'+(100*n/order.length)+'%\"></i></div>'+\n      '<div class=\"pic\"><img src=\"'+esc(f.url)+'\" alt=\"Bike lane crossing at a street intersection\"></div>'+\n      '<div class=\"card\">'+items+'</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"nx\">Next</button></div><div class=\"err\"></div>';\n    var nxt=order[i+1];if(nxt&&files[nxt+'.jpg']){var im=new Image();im.src=files[nxt+'.jpg'].url;}\n    app.querySelectorAll('.scale button').forEach(function(x){x.onclick=function(){vals[x.getAttribute('data-d')]=Number(x.getAttribute('data-v'));x.parentNode.querySelectorAll('button').forEach(function(y){y.classList.toggle('on',y===x);});err('');};});\n    document.getElementById('nx').onclick=function(){\n      if(dims().some(function(d){return vals[d.id]==null;}))return err('Please answer all three statements.');\n      var bt=this;bt.disabled=true;var val={};dims().forEach(function(d){val[d.id]=vals[d.id];});\n      SPSite.answer('bike_lane',val,{key:k,shown:[f.name]}).then(function(r){if(!ok(r)){bt.disabled=false;return err(r.error);}done[k]=true;i++;window.scrollTo(0,0);trial();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"st\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){if(m.some(function(x){return x!=='bike_lane';}))intro();else{done={};i=0;trial();}},1800);}else{var s=document.getElementById('st');if(s)s.textContent='Your ratings are saved.';}});\n  }\n  SPSite.onReady(function(ctx){\n    ['consent','gender','age','bike_lane'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('intersections')||[]).forEach(function(f){files[f.name]=f;});\n    setup();\n    var a=(ctx&&ctx.answers)||{}, p=a.bike_lane;\n    (p&&Array.isArray(p.trials)?p.trials:[]).forEach(function(x){if(x&&x.key!=null&&x.value!=null)done[x.key]=true;});\n    if(a.consent===true)trial();else intro();\n  });\n})();\n</script>\n</body>\n</html>\n",
