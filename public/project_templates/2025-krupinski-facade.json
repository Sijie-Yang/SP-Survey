   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Façade Floodlighting Variants</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Floodlighting a façade: which variant?\",\n  \"description\": \"Faithful replication (survey stage) of Krupiński, Rusnak, Żagan, Kuczyński, Koszewicz, Szmigiel & Geniusz (2025), Composition and Contrast: The Painterly Nature of Architectural Exterior Illumination, Arts 14(6):139. Three computer simulations of the floodlit façade of a neoclassical building complex differ only in where luminance contrast falls (A: distant central part brighter, B: closer wings brighter, C: even), at the same average luminance of 10 cd/m². Participants, in a dark room, see all variants together and choose which they like most and least, which is calmest, and which best conveys official character, makes the building look wider and creates the strongest depth.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"facades\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I am an adult, I agree to take part, and I am completing this survey in a dark room.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": false,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"age\",\n      \"title\": \"Age (years)\",\n      \"inputType\": \"number\",\n      \"min\": 18,\n      \"max\": 110,\n      \"isRequired\": false\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"profession\",\n      \"title\": \"Profession\",\n      \"isRequired\": false,\n      \"choices\": [\n       {\n        \"value\": \"design_professional\",\n        \"text\": \"Design professional (architecture, lighting design, engineering, art or related)\"\n       },\n       {\n        \"value\": \"non_professional\",\n        \"text\": \"Other / non-professional\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"vision\",\n      \"title\": \"Is your vision normal (or corrected to normal) right now?\",\n      \"isRequired\": false,\n      \"choices\": [\n       {\n        \"value\": \"normal\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"impaired\",\n        \"text\": \"No, my vision is impaired at the moment\"\n       }\n      ],\n      \"description\": \"The paper excluded respondents who reported impaired vision.\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"screen\",\n      \"title\": \"On what kind of screen are you viewing the images?\",\n      \"isRequired\": false,\n      \"choices\": [\n       {\n        \"value\": \"monitor\",\n        \"text\": \"Desktop monitor\"\n       },\n       {\n        \"value\": \"laptop\",\n        \"text\": \"Laptop\"\n       },\n       {\n        \"value\": \"tablet\",\n        \"text\": \"Tablet\"\n       },\n       {\n        \"value\": \"phone\",\n        \"text\": \"Phone\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"variants\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"like_most\",\n      \"title\": \"Which variant do you like the most?\",\n      \"isRequired\": false,\n      \"choices\": [\n       {\n        \"value\": \"A\",\n        \"text\": \"Variant A\"\n       },\n       {\n        \"value\": \"B\",\n        \"text\": \"Variant B\"\n       },\n       {\n        \"value\": \"C\",\n        \"text\": \"Variant C\"\n       },\n       {\n        \"value\": \"hard_to_say\",\n        \"text\": \"Hard to say\"\n       },\n       {\n        \"value\": \"none_other\",\n        \"text\": \"None / does not affect me / other\"\n       }\n      ],\n      \"description\": \"Variant A: distant elements lighter, closer darker; B: closer elements brighter; C: even luminance. Shown together (facades/A.jpg, B.jpg, C.jpg).\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"like_least\",\n      \"title\": \"Which variant do you like the least?\",\n      \"isRequired\": false,\n      \"choices\": [\n       {\n        \"value\": \"A\",\n        \"text\": \"Variant A\"\n       },\n       {\n        \"value\": \"B\",\n        \"text\": \"Variant B\"\n       },\n       {\n        \"value\": \"C\",\n        \"text\": \"Variant C\"\n       },\n       {\n        \"value\": \"hard_to_say\",\n        \"text\": \"Hard to say\"\n       },\n       {\n        \"value\": \"none_other\",\n        \"text\": \"None / does not affect me / other\"\n       }\n      ],\n      \"description\": \"Variant A: distant elements lighter, closer darker; B: closer elements brighter; C: even luminance. Shown together (facades/A.jpg, B.jpg, C.jpg).\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"calm\",\n      \"title\": \"Which variant gives you the strongest sense of calm?\",\n      \"isRequired\": false,\n      \"choices\": [\n       {\n        \"value\": \"all\",\n        \"text\": \"All\"\n       },\n       {\n        \"value\": \"A\",\n        \"text\": \"Variant A\"\n       },\n       {\n        \"value\": \"B\",\n        \"text\": \"Variant B\"\n       },\n       {\n        \"value\": \"C\",\n        \"text\": \"Variant C\"\n       },\n       {\n        \"value\": \"hard_to_say\",\n        \"text\": \"Hard to say\"\n       },\n       {\n        \"value\": \"none_other\",\n        \"text\": \"None / does not affect me / other\"\n       }\n      ],\n      \"description\": \"Variant A: distant elements lighter, closer darker; B: closer elements brighter; C: even luminance. Shown together (facades/A.jpg, B.jpg, C.jpg).\"\n     },\n     {\n      \"type\": \"checkbox\",\n      \"name\": \"official\",\n      \"title\": \"Which variant best conveys the building’s official character? (you can choose more than one)\",\n      \"isRequired\": false,\n      \"choices\": [\n       {\n        \"value\": \"A\",\n        \"text\": \"Variant A\"\n       },\n       {\n        \"value\": \"B\",\n        \"text\": \"Variant B\"\n       },\n       {\n        \"value\": \"C\",\n        \"text\": \"Variant C\"\n       },\n       {\n        \"value\": \"hard_to_say\",\n        \"text\": \"Hard to say\"\n       },\n       {\n        \"value\": \"none_other\",\n        \"text\": \"None / does not affect me / other\"\n       }\n      ],\n      \"description\": \"Variant A: distant elements lighter, closer darker; B: closer elements brighter; C: even luminance. Shown together (facades/A.jpg, B.jpg, C.jpg).\"\n     },\n     {\n      \"type\": \"checkbox\",\n      \"name\": \"wider\",\n      \"title\": \"Which variant makes the building appear wider? (you can choose more than one)\",\n      \"isRequired\": false,\n      \"choices\": [\n       {\n        \"value\": \"A\",\n        \"text\": \"Variant A\"\n       },\n       {\n        \"value\": \"B\",\n        \"text\": \"Variant B\"\n       },\n       {\n        \"value\": \"C\",\n        \"text\": \"Variant C\"\n       },\n       {\n        \"value\": \"hard_to_say\",\n        \"text\": \"Hard to say\"\n       },\n       {\n        \"value\": \"none_other\",\n        \"text\": \"None / does not affect me / other\"\n       }\n      ],\n      \"description\": \"Variant A: distant elements lighter, closer darker; B: closer elements brighter; C: even luminance. Shown together (facades/A.jpg, B.jpg, C.jpg).\"\n     },\n     {\n      \"type\": \"checkbox\",\n      \"name\": \"depth\",\n      \"title\": \"Which variant creates the strongest sense of spatial depth? (you can choose more than one)\",\n      \"isRequired\": false,\n      \"choices\": [\n       {\n        \"value\": \"A\",\n        \"text\": \"Variant A\"\n       },\n       {\n        \"value\": \"B\",\n        \"text\": \"Variant B\"\n       },\n       {\n        \"value\": \"C\",\n        \"text\": \"Variant C\"\n       },\n       {\n        \"value\": \"hard_to_say\",\n        \"text\": \"Hard to say\"\n       },\n       {\n        \"value\": \"none_other\",\n        \"text\": \"None / does not affect me / other\"\n       }\n      ],\n      \"description\": \"Variant A: distant elements lighter, closer darker; B: closer elements brighter; C: even luminance. Shown together (facades/A.jpg, B.jpg, C.jpg).\"\n     }\n    ]\n   }\n  ],\n  \"spAnalysisRecommendation\": \"Count answers per option for each question (multiple-choice questions count each ticked option), compare designers with non-professionals, and test differences between options with pairwise proportion z-tests with Bonferroni correction; exclude respondents with impaired vision.\"\n }\n}\n</script>\n<script type=\"application/json\" id=\"results-table\">{\"source\":\"Krupiński et al. (2025) Arts 14:139, Table 1: number of respondents (N = 349 after exclusions; the original also offered two filler variants D and E)\",\"columns\":[\"All\",\"A\",\"B\",\"C\",\"Hard to say\",\"None / does not affect me / other\"],\"rows\":[[\"Like the most\",\"\",\"235\",\"10\",\"36\",\"4\",\"63\"],[\"Like the least\",\"\",\"23\",\"219\",\"27\",\"40\",\"39\"],[\"Strongest sense of calm\",\"13\",\"18\",\"20\",\"250\",\"47\",\"\"],[\"Official character (multiple)\",\"\",\"163\",\"8\",\"78\",\"14\",\"110\"],[\"Appears wider (multiple)\",\"\",\"27\",\"112\",\"107\",\"32\",\"34\"],[\"Strongest spatial depth (multiple)\",\"\",\"35\",\"198\",\"8\",\"5\",\"102\"]]}</script>\n<style>\n:root{--bg:#1b1c1e;--card:#26282b;--ink:#ecebe6;--muted:#a9aaa3;--accent:#c9a45c;--line:#3a3c40;--warn:#ff8a80;--sel:#3d3727}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1100px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#1b1c1e}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.blk{margin-top:16px}.blk:first-child{margin-top:0}\n.blk.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\ninput.txt{font:inherit;width:100%;max-width:200px;padding:9px 11px;border:1px solid var(--line);border-radius:10px;margin-top:6px;background:#111;color:var(--ink)}\n.err{color:var(--warn);margin-top:8px;min-height:1.5em;line-height:1.5}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n.vars figure{margin:0 0 10px}.vars img{width:100%;display:block;border-radius:6px;aspect-ratio:1966/587;background:#000}\n.vars figcaption{font-weight:700;margin-bottom:4px}\n.sticky{background:var(--bg);padding:8px 0 4px}\n.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}.chips label.opt{margin-top:0}\n@media (min-width:900px){.lay{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:20px;align-items:start}.lay .sticky{position:sticky;top:10px;z-index:2}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Façade lighting simulations and questions: Krupiński, Rusnak, Żagan, Kuczyński, Koszewicz, Szmigiel &amp; Geniusz (2025), Composition and Contrast: The Painterly Nature of Architectural Exterior Illumination, Arts 14(6):139 (doi:10.3390/arts14060139, CC BY 4.0). Simulations cropped from Figure 2 (a, c, e); questions from Table 1. Removed on request of the authors.</footer>\n<script>\n(function(){\n  var KEY='krupinski2025facade:state', QN=[\"like_most\", \"like_least\", \"calm\", \"official\", \"wider\", \"depth\"], BG=['gender','age','profession','vision','screen'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='';}}\n  function hideErr(){var e=app.querySelector('.err');if(e&&!app.querySelector('.miss'))e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function markMiss(miss,msg){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});err(msg);}\n  function opts(n,multi){var q=Q[n];return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b><div class=\"'+(multi?'chips':'')+'\">'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"'+(multi?'checkbox':'radio')+'\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div></div>';}\n  function vals(n){return Array.prototype.map.call(app.querySelectorAll('input[name=\"'+n+'\"]:checked'),function(x){return x.value;});}\n  function intro(){\n    app.innerHTML='<h1>Lighting a building at night</h1><p>This survey is about the floodlighting of a historic building. You will see three computer simulations of the same façade lit in different ways and answer six short questions about them. It takes about 5 minutes.</p><p><b>Please take part only if you are an adult and can complete the survey in a dark room</b>, so that the screen is the only source of light. Turn your screen brightness up.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+BG.map(function(n){if(n==='age')return '<div class=\"blk\" data-n=\"age\"><b>'+esc(Q.age.title)+'</b><br><input class=\"txt\" id=\"f_age\" type=\"number\" inputmode=\"numeric\" min=\"18\" max=\"110\"></div>';return opts(n,false);}).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var L=[],miss=[];\n      BG.forEach(function(n){var el=app.querySelector('.blk[data-n=\"'+n+'\"]');\n        if(n==='age'){var raw=document.getElementById('f_age').value.trim(),v=Number(raw);if(raw===''||isNaN(v)||v<18||v>110){miss.push(el);return;}L.push(['age',v]);return;}\n        var x=vals(n);if(!x.length){miss.push(el);return;}L.push([n,x[0]]);});\n      if(miss.length)return markMiss(miss,'Please answer the marked questions.');\n      send(L.map(function(p){return SPSite.answer(p[0],p[1]);}),this,function(){st.step='vars';save();route();});};\n  }\n  function variants(){\n    var shown=['A','B','C'].map(function(k){return files[k].name;});\n    app.innerHTML='<div class=\"lay\"><div class=\"sticky vars\">'+['A','B','C'].map(function(k){return '<figure><figcaption>Variant '+k+'</figcaption><img alt=\"Floodlit façade, variant '+k+'\" src=\"'+esc(files[k].url)+'\"></figure>';}).join('')+'</div><div class=\"card\" style=\"margin-top:0\">'+\n      QN.map(function(n){return opts(n,Q[n].type==='checkbox');}).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div></div>';\n    document.getElementById('go').onclick=function(){var L=[],miss=[];\n      QN.forEach(function(n){var x=vals(n);if(!x.length){miss.push(app.querySelector('.blk[data-n=\"'+n+'\"]'));return;}\n        var multi=Q[n].type==='checkbox';\n        if(multi&&x.length>1&&x.some(function(v){return v==='hard_to_say'||v==='none_other';})){miss.push(app.querySelector('.blk[data-n=\"'+n+'\"]'));return;}\n        L.push([n,multi?x:x[0]]);});\n      if(miss.length)return markMiss(miss,'Please answer the marked questions. \"Hard to say\" and \"None\" cannot be combined with a variant.');\n      send(L.map(function(p){return SPSite.answer(p[0],p[1],{shown:shown});}),this,function(){st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st={step:'intro'};save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var b=e.target.closest&&e.target.closest('.blk');if(b){b.classList.remove('miss');hideErr();}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='vars')return variants();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent'].concat(BG,QN).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('facades')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=['A','B','C'].filter(function(m){return !files[m];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"facades\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.step)||a.consent!==true)st={step:'intro'};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
