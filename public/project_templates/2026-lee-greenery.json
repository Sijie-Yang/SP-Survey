   "id": "site-304e7eed6f94d99d",
   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Greenery in Urban Views</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Greenery in Urban Views\",\n  \"description\": \"Faithful replication with the original renderings, for 3 of the paper's 9 viewpoints: rendered views of three public sites in Daejeon, South Korea (DO1 Daejeon Observatory, HH2 Hoedeok Hyanggyo, NJ3 Namgan Jeongsa), each in the paper's three matched greenery conditions built in SketchUp and rendered in Lumion: Reduced, Modeled reference and Added vegetation (visible vegetation 8.0 / 16.5 / 23.7% for DO1, 21.6 / 43.2 / 67.9% for HH2, 20.1 / 38.1 / 58.0% for NJ3). Participants see the 9 scenes in individually randomized order, as in the paper, and after each scene answer, with the scene still shown, the paper's eight perceived-restorativeness statements (e.g. I feel restored after viewing here; Viewing here helps me reduce stress), its eight Perceived Sensory Dimension statements (social, space, nature, refuge, prospect, serene, culture, rich in species) on 5-point scales (1 = strongly disagree, 5 = strongly agree) and its two scene-preference items (How attractive did you find the scene?, 1 = not at all, 5 = extremely attractive; Do you want to visit here?, 1 = not at all, 5 = extremely want). Gender and age are asked at the end. Rebuilt from Lee, Hsu, Yang & Lee (2026), Visible Greenery and Visual Composition in Urban Views: A Matched-Scene Experiment on Restorativeness and Preference, Buildings 16(19): 3777, with the renderings cropped from its Figure 5 (the visible-vegetation labels trimmed off) and all items from its Tables 2-4 (CC BY 4.0). Image ids: viewpoint_condition, e.g. DO1_reduced, HH2_reference, NJ3_added. Analysis as in the paper: perceived-restorativeness score (mean of 8 items) and preference score (mean of 2 items) per scene, compared between Reduced and Modeled reference and between Added and Modeled reference with linear models containing participant and viewpoint fixed effects and standard errors clustered by participant and viewpoint, and each Perceived Sensory Dimension compared the same way; the paper (114 participants, 27 scenes) found Reduced scenes rated lower in restorativeness (b = -0.278) and preference (b = -0.289) than the Modeled reference, while Added scenes did not reliably improve either; Added scenes were rated higher on nature and rich in species but lower on prospect. Differences from the original study: (1) only the 3 viewpoints whose clean renderings are printed (Figure 5) are used, 9 of the 27 scenes; the other 18 are printed only with segmentation overlays (Figure A1); (2) the paper's web interface ran on personal computers only and recruited through university-affiliated online platforms; here any device can be used and anyone can take part; (3) the instruction text and the gender and age questions are ours; the paper reports age groups 20-29, 30-39 and 40-49; (4) the renderings are the figure copies (about 1600 px wide) with the top edge trimmed.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"scenes\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"scenes\",\n    \"elements\": [\n     {\n      \"type\": \"matrix\",\n      \"name\": \"restorativeness\",\n      \"title\": \"Perceived restorativeness\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"restored\",\n        \"text\": \"I feel restored after viewing here\"\n       },\n       {\n        \"value\": \"forget\",\n        \"text\": \"I forget everyday worries after viewing here\"\n       },\n       {\n        \"value\": \"break\",\n        \"text\": \"Viewing here gives me a break from my routine\"\n       },\n       {\n        \"value\": \"happy\",\n        \"text\": \"Viewing here makes me happy\"\n       },\n       {\n        \"value\": \"energized\",\n        \"text\": \"I feel energized after viewing here for a while\"\n       },\n       {\n        \"value\": \"relaxed\",\n        \"text\": \"I feel relaxed after viewing here\"\n       },\n       {\n        \"value\": \"calm\",\n        \"text\": \"Viewing here makes me feel calm\"\n       },\n       {\n        \"value\": \"stress\",\n        \"text\": \"Viewing here helps me reduce stress\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       }\n      ],\n      \"description\": \"1 = strongly disagree, 5 = strongly agree. Keyed by scene id.\"\n     },\n     {\n      \"type\": \"matrix\",\n      \"name\": \"sensory\",\n      \"title\": \"Perceived Sensory Dimensions\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"social\",\n        \"text\": \"Here is an environment suitable for social activities\"\n       },\n       {\n        \"value\": \"space\",\n        \"text\": \"This is a spacious and undisturbed environment\"\n       },\n       {\n        \"value\": \"nature\",\n        \"text\": \"Sensation of wildness and nature\"\n       },\n       {\n        \"value\": \"refuge\",\n        \"text\": \"Here is an enclosed and safe environment\"\n       },\n       {\n        \"value\": \"prospect\",\n        \"text\": \"Here is an open space with a wide view\"\n       },\n       {\n        \"value\": \"serene\",\n        \"text\": \"Here is a silent and peaceful environment\"\n       },\n       {\n        \"value\": \"culture\",\n        \"text\": \"There are many artificial elements decorating here\"\n       },\n       {\n        \"value\": \"rich\",\n        \"text\": \"Many animals and plants around here\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       }\n      ],\n      \"description\": \"1 = strongly disagree, 5 = strongly agree. Keyed by scene id.\"\n     },\n     {\n      \"type\": \"matrix\",\n      \"name\": \"preference\",\n      \"title\": \"Scene preference\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"attractive\",\n        \"text\": \"How attractive did you find the scene?\"\n       },\n       {\n        \"value\": \"visit\",\n        \"text\": \"Do you want to visit here?\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       }\n      ],\n      \"description\": \"attractive: 1 = not at all, 5 = extremely attractive; visit: 1 = not at all, 5 = extremely want. Keyed by scene id.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"man\",\n        \"text\": \"Man\"\n       },\n       {\n        \"value\": \"woman\",\n        \"text\": \"Woman\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 16,\n      \"max\": 110\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"matched-scene-original\">{\"source\": \"Lee, Hsu, Yang & Lee (2026) Buildings 16: 3777\", \"n\": 114, \"pref\": [[\"attractive\", \"How attractive did you find the scene?\", \"Not at all\", \"Extremely attractive\"], [\"visit\", \"Do you want to visit here?\", \"Not at all\", \"Extremely want\"]]}</script>\n<style>\n:root{--bg:#eef2ee;--card:#fff;--ink:#1b221c;--muted:#5a645c;--accent:#2f6b45;--line:#d6ded7;--warn:#b3261e;--sel:#ddeee2}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.08rem;margin:0 0 4px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.scene{position:sticky;top:0;z-index:3;background:var(--bg);padding-bottom:6px}\n.scene img{max-width:100%;max-height:42vh;width:auto;height:auto;display:block;margin:0 auto;border-radius:10px}\n@media (max-height:700px),(max-width:600px){.scene{position:static}}\n.it{padding:10px 0;border-top:1px solid var(--line)}\n.it .st{font-weight:600;margin-bottom:6px;font-size:.96rem}\n.it .o{display:grid;grid-template-columns:repeat(5,1fr);gap:4px}\n.it label{display:flex;justify-content:center;align-items:center;gap:6px;border:1px solid var(--line);border-radius:8px;padding:7px 0;cursor:pointer;font-size:.9rem}\n.it label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.it .an{display:flex;justify-content:space-between;font-size:.74rem;color:var(--muted);margin-top:3px}\n.it.miss .o{outline:2px solid var(--warn);outline-offset:2px;border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Renderings and items: Lee, Hsu, Yang &amp; Lee (2026), Buildings 16(19): 3777, Figure 5 and Tables 2–4 (doi:10.3390/buildings16193777, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='matched-scene-greenery:state', IDS=[];\n  ['DO1','HH2','NJ3'].forEach(function(v){['reduced','reference','added'].forEach(function(c){IDS.push(v+'_'+c);});});\n  var ANCH={attractive:['Not at all','Extremely attractive'],visit:['Not at all','Extremely want']};\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function fresh(){return {step:'intro',order:shuffle(IDS),k:0};}\n  function intro(){\n    app.innerHTML='<h1>Urban views</h1><p>You will see 9 rendered views of public places. Look at each view as if you were standing there, then answer the questions below it. Take as long as you like for each view. It takes about 10 minutes.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='scene';st.k=0;save();route();});};\n  }\n  function block(q,tag,anch){\n    return '<div class=\"card\"><h2>'+esc(q.title)+'</h2>'+(q.rows||[]).map(function(r){var nm=tag+'__'+r.value,a=anch?anch[r.value]:['Strongly disagree','Strongly agree'];\n      return '<div class=\"it\" data-n=\"'+nm+'\"><div class=\"st\">'+esc(r.text)+'</div><div class=\"o\">'+[1,2,3,4,5].map(function(v){return '<label><input type=\"radio\" name=\"'+nm+'\" value=\"'+v+'\">'+v+'</label>';}).join('')+'</div><div class=\"an\"><span>1 '+esc(a[0])+'</span><span>5 '+esc(a[1])+'</span></div></div>';}).join('')+'</div>';\n  }\n  function collect(q,tag,miss){var o={};(q.rows||[]).forEach(function(r){var nm=tag+'__'+r.value,x=app.querySelector('input[name=\"'+nm+'\"]:checked');if(x)o[r.value]=Number(x.value);else miss.push(app.querySelector('.it[data-n=\"'+nm+'\"]'));});return o;}\n  function scene(){\n    if(st.k>=st.order.length){st.step='about';save();return route();}\n    var id=st.order[st.k],f=files[id];\n    app.innerHTML='<div class=\"prog\">View '+(st.k+1)+' of '+st.order.length+'</div><div class=\"scene\"><img alt=\"Rendered urban view\" src=\"'+esc(f.url)+'\"></div>'+\n      block(Q.restorativeness,'prs')+block(Q.sensory,'psd')+block(Q.preference,'pref',ANCH)+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">'+(st.k<st.order.length-1?'Next view':'Continue')+'</button></div><div class=\"err\"></div>';\n    document.getElementById('go').onclick=function(){\n      var miss=[],a=collect(Q.restorativeness,'prs',miss),b=collect(Q.sensory,'psd',miss),c=collect(Q.preference,'pref',miss);\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please answer every statement.');}\n      var o={key:id,shown:[f.name]};\n      send([SPSite.answer('restorativeness',a,o),SPSite.answer('sensory',b,o),SPSite.answer('preference',c,o)],this,function(){st.k++;save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div><b>'+esc(Q.gender.title)+'</b>'+(Q.gender.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"gender\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div><div style=\"margin-top:16px\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"16\" max=\"110\"></div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var age=Number(document.getElementById('age').value),g=app.querySelector('input[name=gender]:checked');if(!g)return err('Please choose your gender.');if(!(age>=16&&age<=110))return err('Please enter your age.');\n      send([SPSite.answer('gender',g.value),SPSite.answer('age',age)],this,function(){st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var r=e.target.closest&&e.target.closest('.it');if(r){r.classList.remove('miss');if(!app.querySelector('.it.miss'))err('');}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='scene')return scene();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','restorativeness','sensory','preference','gender','age'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('scenes')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=IDS.filter(function(k){return !files[k];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"scenes\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.order)||a.consent!==true)st=fresh();\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
