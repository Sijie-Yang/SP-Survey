   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Livestock and Landscape Preference</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Livestock and Landscape Preference\",\n  \"description\": \"Faithful replication of the image-based questionnaire of Serrano-Montes, Martínez-Ibarra & Arias-García (2019), Landscape Online 71: five pairs of photographs of the Spanish dehesa (Cardeña, Córdoba), taken by the authors on one day in May 2016. Participants choose the landscape they find more beautiful in each pair. Pairs: A cattle vs. a similar scene without cattle; B horses vs. water; C cattle vs. a traditional farmhouse; D pigs vs. a similar scene without pigs; E cattle vs. denser, more diverse vegetation. Answers are keyed by pair (A-E); the value says whether the scene with animals or the other scene was chosen. Analysis as in the paper: the percentage choosing the scene with animals in each pair, overall and by group (residents of the dehesa village vs. city residents, men vs. women, livestock farmers). With 520 face-to-face respondents in Cardeña and Granada, the scene with animals was chosen by 76.7% in pair A, 32.3% in B, 43.5% in C, 71.9% in D and 61.9% in E. Differences from the original study: (1) the paper printed the pairs in colour on A3 paper and interviewed people face to face in Cardeña and Granada; here the pairs are shown on screen and anyone can take part; (2) the paper's questionnaire also had four pairs without animals as distractors, which are not printed in the paper and are left out; (3) the photographs are the copies printed in Figure 2 (about 420 px wide); (4) the paper only says gender, age, education level and job were asked; the wording and answer options are ours, and we add a yes/no question on whether the respondent is a livestock farmer because the paper analysed farmers separately; (5) the instruction wording is ours, following the paper's note that respondents judged the beauty of the landscape, not the photograph.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\"pairs\"],\n  \"pages\": [\n   {\"name\": \"start\", \"elements\": [\n    {\"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\"}\n   ]},\n   {\"name\": \"pairs\", \"elements\": [\n    {\"type\": \"radiogroup\", \"name\": \"choice\", \"title\": \"Which of these two landscapes do you prefer?\", \"isRequired\": true, \"choices\": [{\"value\":\"animals\",\"text\":\"Scene with animals\"},{\"value\":\"other\",\"text\":\"Other scene\"}], \"description\": \"Keyed by pair (A-E). The two photographs are shown side by side in the order of the paper's Figure 2; shown lists them left, right.\"}\n   ]},\n   {\"name\": \"about\", \"elements\": [\n    {\"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"isRequired\": true, \"choices\": [{\"value\":\"male\",\"text\":\"Man\"},{\"value\":\"female\",\"text\":\"Woman\"},{\"value\":\"other\",\"text\":\"Other / prefer not to say\"}]},\n    {\"type\": \"text\", \"name\": \"age\", \"inputType\": \"number\", \"title\": \"Age (years)\", \"isRequired\": true, \"min\": 16, \"max\": 100},\n    {\"type\": \"radiogroup\", \"name\": \"education\", \"title\": \"Highest completed education\", \"isRequired\": true, \"choices\": [{\"value\":\"none_primary\",\"text\":\"None or primary\"},{\"value\":\"secondary\",\"text\":\"Secondary\"},{\"value\":\"university\",\"text\":\"University\"}]},\n    {\"type\": \"text\", \"name\": \"job\", \"title\": \"What is your job or occupation?\", \"isRequired\": true},\n    {\"type\": \"boolean\", \"name\": \"livestock_farmer\", \"title\": \"Do you work as a livestock farmer?\", \"isRequired\": true, \"labelTrue\": \"Yes\", \"labelFalse\": \"No\"}\n   ]}\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"pairs-original\">{\"source\":\"Serrano-Montes, Martínez-Ibarra & Arias-García (2019) Landscape Online 71, Table 2 and Figure 2\",\"n\":520,\"animal_side\":{\"A\":\"L\",\"B\":\"R\",\"C\":\"L\",\"D\":\"R\",\"E\":\"L\"},\"pct_animals\":{\"A\":76.7,\"B\":32.3,\"C\":43.5,\"D\":71.9,\"E\":61.9}}</script>\n<style>\n:root{--bg:#f3f2ec;--card:#fff;--ink:#1d211c;--muted:#5c6258;--accent:#4d6b2f;--line:#d9dacf;--warn:#b3261e;--sel:#e4ecd8}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1000px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.pair{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}\n.pick{display:block;border:3px solid transparent;border-radius:12px;padding:4px;background:var(--card);cursor:pointer}\n.pick img{width:100%;height:auto;display:block;border-radius:8px}\n.pick span{display:block;text-align:center;font-weight:600;margin-top:4px;color:var(--muted)}\n.pick input{position:absolute;opacity:0;pointer-events:none}\n.pick:has(input:checked){border-color:var(--accent);background:var(--sel)}\n.pick:has(input:checked) span{color:var(--ink)}\n.pair.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:12px}\n.blk{margin-top:14px}.blk:first-child{margin-top:0}\n.blk.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\ninput.tx{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:10px;margin-top:6px;width:100%;max-width:22em}\n.err{color:var(--warn);margin-top:8px;min-height:1.5em;line-height:1.5}\n.credit{max-width:1000px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:560px){.pair{grid-template-columns:1fr}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs and design: Serrano-Montes, Martínez-Ibarra &amp; Arias-García (2019), How Does the Presence of Livestock Influence Landscape Preferences? An Image-Based Approach, Landscape Online 71: 1–18, Figure 2 (doi:10.3097/LO.201971, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='serrano2019:state', ORIG=JSON.parse(document.getElementById('pairs-original').textContent), PAIRS=['A','B','C','D','E'], BG=['gender','age','education','job','livestock_farmer'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='';}}\n  function hideErr(){var e=app.querySelector('.err');if(e&&!app.querySelector('.miss'))e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function intro(){\n    app.innerHTML='<h1>Which landscape do you prefer?</h1><p>You will see five pairs of photographs of the same kind of countryside. For each pair, choose the landscape you find more beautiful. Judge the beauty of the landscape itself, not the quality of the photograph (framing, brightness and so on). There are no right or wrong answers. It takes about 4 minutes.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='pair';st.k=0;st.c={};save();route();});};\n  }\n  function pairPage(){\n    var k=st.k,p=PAIRS[k],cur=st.c[p];\n    app.innerHTML='<h2>Pair '+(k+1)+' of '+PAIRS.length+'</h2><p>Which of these two landscapes do you prefer? Tap the one you find more beautiful.</p><div class=\"pair\">'+['L','R'].map(function(s,i){var f=files[p+'_'+s];\n      return '<label class=\"pick\"><input type=\"radio\" name=\"pk\" value=\"'+s+'\"'+(cur===s?' checked':'')+'><img alt=\"Landscape '+(i?'B':'A')+'\" src=\"'+esc(f.url)+'\"><span>Landscape '+(i?'B':'A')+'</span></label>';}).join('')+\n      '</div><div class=\"card\"><button class=\"btn\" id=\"go\">'+(k<PAIRS.length-1?'Next pair':'Continue')+'</button><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var x=app.querySelector('input[name=\"pk\"]:checked');\n      if(!x){app.querySelector('.pair').classList.add('miss');return err('Please choose one of the two landscapes.');}\n      st.c[p]=x.value;save();\n      var v=(x.value===ORIG.animal_side[p])?'animals':'other';\n      send([SPSite.answer('choice',v,{key:p,shown:[files[p+'_L'].name,files[p+'_R'].name]})],this,function(){if(k<PAIRS.length-1)st.k=k+1;else st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+BG.map(function(n){var q=Q[n];\n      if(q.type==='text')return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b><div><input class=\"tx\" id=\"in_'+n+'\"'+(q.inputType==='number'?' type=\"number\" inputmode=\"numeric\" style=\"width:9em\"':' type=\"text\"')+'></div></div>';\n      var ch=q.type==='boolean'?[{value:'true',text:q.labelTrue},{value:'false',text:q.labelFalse}]:(q.choices||[]);\n      return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b>'+ch.map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var L=[],miss=[];\n      BG.forEach(function(n){var q=Q[n],el=app.querySelector('.blk[data-n=\"'+n+'\"]');\n        if(q.type==='text'){var raw=((document.getElementById('in_'+n)||{}).value||'').trim();\n          if(q.inputType==='number'){var v=Number(raw);if(raw&&v>=q.min&&v<=q.max)L.push(SPSite.answer(n,v));else miss.push(el);}\n          else if(raw)L.push(SPSite.answer(n,raw));else miss.push(el);return;}\n        var x=app.querySelector('input[name=\"'+n+'\"]:checked');if(!x){miss.push(el);return;}\n        L.push(SPSite.answer(n,q.type==='boolean'?x.value==='true':x.value));});\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});return err('Please answer all five questions (age as a number from 16 to 100).');}\n      send(L,this,function(){st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var b=e.target.closest&&e.target.closest('.blk,.pair');if(b){b.classList.remove('miss');hideErr();}\n    if(e.target.name==='pk'&&st&&st.step==='pair'){st.c[PAIRS[st.k]]=e.target.value;save();}});\n  app.addEventListener('input',function(e){var b=e.target.closest&&e.target.closest('.blk');if(b){b.classList.remove('miss');hideErr();}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='pair')return pairPage();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){if(!SPSite.__nm){SPSite.__nm=1;var _gm=SPSite.getMedia;SPSite.getMedia=function(){var r=_gm.apply(SPSite,arguments),fx=function(m){if(!m||!m.name)return m;var c={},k;for(k in m)c[k]=m[k];c.name=String(m.name).replace(/__[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(\\.[A-Za-z0-9]+)$/i,'$1');return c;};if(Array.isArray(r))return r.map(fx);if(r&&typeof r==='object'){var o={},k;for(k in r)o[k]=(r[k]||[]).map(fx);return o;}return r;};}(SPSite.getQuestions()||[]).forEach(function(q){if(q.type==='number'){q.type='text';q.inputType='number';}if(q.isRequired==null)q.isRequired=!!q.required;});\n    ['consent','choice'].concat(BG).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('pairs')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=[];PAIRS.forEach(function(p){['L','R'].forEach(function(s){if(!files[p+'_'+s])need.push(p+'_'+s);});});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"pairs\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.step)||a.consent!==true)st={step:'intro'};\n    if(!st.c)st.c={};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
