      \"text\": \"No\"\n       },\n       {\n        \"value\": \"limited\",\n        \"text\": \"Limited\"\n       },\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"protect\",\n      \"title\": \"Do you actively participate in protecting nature?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"daily\",\n        \"text\": \"Daily\"\n       },\n       {\n        \"value\": \"often\",\n        \"text\": \"Often\"\n       },\n       {\n        \"value\": \"sometimes\",\n        \"text\": \"Sometimes\"\n       },\n       {\n        \"value\": \"rarely\",\n        \"text\": \"Rarely\"\n       },\n       {\n        \"value\": \"never\",\n        \"text\": \"Never\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"demographics\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"sex\",\n      \"title\": \"Sex\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other or prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"under_20\",\n        \"text\": \"Under 20\"\n       },\n       {\n        \"value\": \"20_29\",\n        \"text\": \"20-29\"\n       },\n       {\n        \"value\": \"30_39\",\n        \"text\": \"30-39\"\n       },\n       {\n        \"value\": \"40_49\",\n        \"text\": \"40-49\"\n       },\n       {\n        \"value\": \"50_59\",\n        \"text\": \"50-59\"\n       },\n       {\n        \"value\": \"60_plus\",\n        \"text\": \"60 or older\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Highest education\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"school\",\n        \"text\": \"School\"\n       },\n       {\n        \"value\": \"vocational\",\n        \"text\": \"Vocational training\"\n       },\n       {\n        \"value\": \"bachelor\",\n        \"text\": \"Bachelor's degree or equivalent\"\n       },\n       {\n        \"value\": \"master\",\n        \"text\": \"Master's degree or equivalent\"\n       },\n       {\n        \"value\": \"doctorate\",\n        \"text\": \"Doctorate\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"discipline\",\n      \"title\": \"Discipline or field of study or work\",\n      \"isRequired\": false\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"ml-original\">{\"source\": \"Unterweger, Schrode & Betz (2017) Urban Sci. 1(3): 24\", \"n\": 424, \"images\": [\"P1\", \"P2\", \"P3\", \"P4\", \"P5\", \"P6\", \"P7\"], \"types\": {\"P1\": \"meadow\", \"P2\": \"lawn\", \"P3\": \"meadow\", \"P4\": \"meadow\", \"P5\": \"lawn\", \"P6\": \"meadow\", \"P7\": \"meadow\"}, \"items\": [[\"attractive\", \"Attractive\"], [\"spruce\", \"Spruce (e.g., horticultural, proper and tidy maintenance)\"], [\"enriching\", \"Enriching (e.g., educational, functional, social benefits) for urban areas\"]], \"anchors\": [\"Not at all\", \"Very much\"]}</script>\n<style>\n:root{--bg:#f2f3ee;--card:#fff;--ink:#1d2419;--muted:#5a6355;--accent:#55702f;--line:#d7dccf;--warn:#b3261e;--sel:#e6eedb}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.08rem;margin:0 0 4px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.pic img{max-width:100%;max-height:48vh;width:auto;height:auto;display:block;margin:0 auto;border-radius:10px}\n.q{margin-top:18px}.q:first-child{margin-top:0}\n.q>b{display:block;margin-bottom:4px}\n.q.miss,.it.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:8px}\ntextarea,input[type=text]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:100%;margin-top:4px}\ntextarea{min-height:64px;resize:vertical}\n.it{padding:8px 0;border-top:1px solid var(--line)}.it:first-of-type{border-top:0}\n.it .st{font-size:.95rem;margin-bottom:5px}\n.it .o{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:5px}\n.it label{display:flex;justify-content:center;align-items:center;border:1px solid var(--line);border-radius:8px;padding:7px 4px;cursor:pointer;font-size:.9rem}\n.it label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.it label input{display:none}\n.an{display:flex;justify-content:space-between;font-size:.76rem;color:var(--muted);margin-top:3px}\n.yn{display:flex;gap:8px;flex-wrap:wrap}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;font-size:.95rem}\n.yn label.opt{margin-top:0;min-width:90px}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs and questions: Unterweger, Schrode &amp; Betz (2017), Urban Science 1(3): 24, Figure 1A and Section 2.1 (doi:10.3390/urbansci1030024, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='meadow-impressions:state';\n  var ORIG=JSON.parse(document.getElementById('ml-original').textContent), IDS=ORIG.images;\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  var ITEMS=ORIG.items;\n  var BEH=['nature_role','garden','relax','observe','insects','protect'], DEM=['sex','age','education','discipline'];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function fresh(){return {step:'intro',order:shuffle(IDS),k:0};}\n  function chs(q){return (q.choices||[]).map(function(c){return typeof c==='string'?{value:c,text:c}:c;});}\n  function field(n){var q=Q[n];\n    if(q.type==='text')return '<div class=\"q\" data-q=\"'+n+'\"><b>'+esc(q.title)+(q.isRequired?'':' <span style=\"color:var(--muted);font-weight:400\">(optional)</span>')+'</b><input type=\"text\" id=\"t_'+n+'\" maxlength=\"120\"></div>';\n    return '<div class=\"q\" data-q=\"'+n+'\"><b>'+esc(q.title)+'</b>'+chs(q).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function readFields(list,names){\n    for(var i=0;i<names.length;i++){var n=names[i],q=Q[n],v;\n      if(q.type==='text'){v=document.getElementById('t_'+n).value.trim();if(!v){if(q.isRequired){app.querySelector('[data-q='+n+']').classList.add('miss');err('Please answer: '+q.title);return false;}continue;}}\n      else{var x=app.querySelector('input[name='+n+']:checked');if(!x){var el=app.querySelector('[data-q='+n+']');el.classList.add('miss');el.scrollIntoView({block:'center'});err('Please answer: '+q.title);return false;}v=x.value;}\n      list.push(SPSite.answer(n,v));}\n    return true;}\n  function yn(n){return '<div class=\"yn\"><label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"yes\"> Yes</label><label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"no\"> No</label></div>';}\n  function intro(){\n    app.innerHTML='<h1>Meadows and lawns in the city</h1><p>You will see seven photographs of green spaces in a university city, one at a time, and answer a few short questions about each. Then there are some questions about you and nature. It takes about 10 minutes.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='photo';st.k=0;save();route();});};\n  }\n  function photo(){\n    var id=st.order[st.k],f=files[id],sh={key:id,shown:[f.name]};\n    app.innerHTML='<div class=\"prog\">Photograph '+(st.k+1)+' of '+st.order.length+'</div><div class=\"pic\"><img alt=\"Photograph of an urban green space\" src=\"'+esc(f.url)+'\"></div>'+\n     '<div class=\"card\">'+\n     '<div class=\"q\" data-q=\"impression\"><b>'+esc(Q.impression.title)+'</b><textarea id=\"imp\" maxlength=\"600\"></textarea></div>'+\n     '<div class=\"q\" data-q=\"assess\"><b>'+esc(Q.assess.title)+'</b>'+ITEMS.map(function(it){var nm='a__'+it[0];return '<div class=\"it\" data-n=\"'+nm+'\"><div class=\"st\">'+esc(it[1])+'</div><div class=\"o\">'+[1,2,3,4,5].map(function(v){return '<label><input type=\"radio\" name=\"'+nm+'\" value=\"'+v+'\">'+v+'</label>';}).join('')+'</div><div class=\"an\"><span>1 '+esc(ORIG.anchors[0])+'</span><span>5 '+esc(ORIG.anchors[1])+'</span></div></div>';}).join('')+'</div>'+\n     '<div class=\"q\" data-q=\"change\"><b>'+esc(Q.change.title)+'</b>'+yn('change')+'<input type=\"text\" id=\"chw\" maxlength=\"300\" placeholder=\"If yes, what would you change?\"></div>'+\n     '<div class=\"q\" data-q=\"more\"><b>'+esc(Q.more.title)+'</b>'+yn('more')+'<input type=\"text\" id=\"mow\" maxlength=\"300\" placeholder=\"Why, or why not?\"></div>'+\n     '</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">'+(st.k<st.order.length-1?'Next photograph':'Continue')+'</button></div><div class=\"err\"></div>';\n    document.getElementById('go').onclick=function(){\n      var imp=document.getElementById('imp').value.trim();\n      if(!imp){var e=app.querySelector('[data-q=impression]');e.classList.add('miss');e.scrollIntoView({block:'center'});return err('Please write your first impression.');}\n      var a={},miss=[];ITEMS.forEach(function(it){var nm='a__'+it[0],x=app.querySelector('input[name=\"'+nm+'\"]:checked');if(x)a[it[0]]=Number(x.value);else miss.push(app.querySelector('.it[data-n=\"'+nm+'\"]'));});\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please rate every line.');}\n      var c=app.querySelector('input[name=change]:checked'),m=app.querySelector('input[name=more]:checked');\n      if(!c){var e1=app.querySelector('[data-q=change]');e1.classList.add('miss');e1.scrollIntoView({block:'center'});return err('Please answer: '+Q.change.title);}\n      if(!m){var e2=app.querySelector('[data-q=more]');e2.classList.add('miss');e2.scrollIntoView({block:'center'});return err('Please answer: '+Q.more.title);}\n      var list=[SPSite.answer('impression',imp,sh),SPSite.answer('assess',a,sh),SPSite.answer('change',c.value,sh),SPSite.answer('more',m.value,sh)];\n      var cw=document.getElementById('chw').value.trim(),mw=document.getElementById('mow').value.trim();\n      if(cw)list.push(SPSite.answer('change_what',cw,sh));if(mw)list.push(SPSite.answer('more_why',mw,sh));\n      send(list,this,function(){st.k++;if(st.k>=st.order.length)st.step='behaviour';save();route();});};\n  }\n  function page(title,names,nextStep,label){\n    app.innerHTML='<h2>'+esc(title)+'</h2><div class=\"card\">'+names.map(field).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">'+label+'</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var list=[];if(!readFields(list,names))return;send(list,this,function(){st.step=nextStep;save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var r=e.target.closest&&(e.target.closest('.it')||e.target.closest('.q'));if(r){r.classList.remove('miss');if(r.classList.contains('it')){var p=r.closest('.q');}if(!app.querySelector('.miss'))err('');}});\n  app.addEventListener('input',function(e){var r=e.target.closest&&e.target.closest('.q');if(r){r.classList.remove('miss');if(!app.querySelector('.miss'))err('');}});\n  function route(){var s=st.step;window.scrollTo(0,0);\n    if(s==='photo')return photo();\n    if(s==='behaviour')return page('You and nature',BEH,'demo','Continue');\n    if(s==='demo')return page('About you',DEM,'done','Finish');\n    if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','impression','assess','change','change_what','more','more_why'].concat(BEH).concat(DEM).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{name:n};});\n    (SPSite.getMedia('photos')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=IDS.filter(function(k){return !files[k];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"photos\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.order&&st.order.length===IDS.length)||a.consent!==true)st=fresh();\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
