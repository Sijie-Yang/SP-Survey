   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Sanhe Ancient Town Spaces</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Historic Block Public Spaces: Semantic Differential (Sanhe Ancient Town)\",\n  \"description\": \"Faithful replication of the semantic differential survey in Ding et al. (2023), Sustainability 15:2790: rate 12 photographs of public spaces in Sanhe Ancient Town (Hefei, China) on 17 bipolar adjective pairs.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"spaces\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"intro\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"consent\",\n      \"isRequired\": true,\n      \"title\": \"Statement of Consent: I have been informed of the purpose of this study and I have read the informed statement. My tick below indicates that I am willing to participate in this study and will answer the following questions carefully.\",\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Agree\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Disagree\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Your gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Female\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age_group\",\n      \"title\": \"Your age is\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Under 18 years of age\"\n       },\n       {\n        \"value\"