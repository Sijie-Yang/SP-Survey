   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Urban Regeneration Streetscapes</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Urban Regeneration Streetscapes: Perception and Emotion\",\n  \"description\": \"Faithful replication with the original photographs: twelve street-level photos of the regenerated Yulin neighbourhood in Chengdu, three each dominated by vegetation (A1-A3), buildings (B1-B3), roads (C1-C3) or facilities such as benches, kiosks and signs (D1-D3). Participants first answer the paper's background questions (gender, age, education, occupation, origin, landscape-architecture major, visits to Yulin), then view all 12 photos in random order for 20 s each with a 5 s blank screen between them. They then rate every photo on the paper's 10 semantic-differential pairs (e.g. sparse - abundant vegetation, dangerous - safe, ugly - beautiful, dim - vibrant) on a 7-point scale from -3 to +3 (completely / very / quite / neutral), and finally rate the emotion each photo evokes on 9-point valence (very unpleasant - very pleasant) and arousal (very not excited - very excited) scales with the Self-Assessment Manikin figures. Scene order in the two questionnaires follows the paper's supplement. Rebuilt from Cheng, Wang, Xu, Ge & Ma (2026), Assessment of perceived environmental quality in urban regeneration: integrating neurophysiological and psychological perspectives, Frontiers in Psychology 17: 1874589; the photos, manikin pictures and all question wording come from its Supplementary Material (CC BY 4.0). Image ids follow the paper's Figure 2 (A1-D3). Analysis as in the paper: one-way ANOVA of each SD item, the SD total, valence and arousal across the four element groups with LSD post-hoc tests; the paper (27 participants) found significant group differences for all except Safety, with vegetation scenes most pleasant and facility scenes most distinctive, beautiful, vibrant and arousing. Differences from the original study: (1) online, without the eye tracker and EEG headset, so fixation and EEG measures are not recorded and there is no 6-minute recovery phase; (2) the supplement's typo 'Commerciallviable' is shown as 'Commercially viable'; (3) the manikin rows are mirrored so that they run from 1 on the left to 9 on the right like the number scale; (4) the photos are the supplement's copies (about 550 px wide), not the full-resolution camera images; (5) the name, gender and age fields repeated at the top of the SD sheet are not asked again.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"streets\",\n   \"sam\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"background\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       \"Male\",\n       \"Female\"\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"choices\": [\n       \"< 20\",\n       \"20–30\",\n       \"31–40\",\n       \"41–50\",\n       \"51–60\",\n       \"> 60\"\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Educational Attainment\",\n      \"isRequired\": true,\n      \"choices\": [\n       \"Below High School\",\n       \"High School\",\n       \"Vocational/Technical School\",\n       \"Undergraduate\",\n       \"Postgraduate or above\"\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"occupation\",\n      \"title\": \"Occupation\",\n      \"isRequired\": true,\n      \"choices\": [\n       \"Employee\",\n       \"Retired\",\n       \"Homemaker\",\n       \"Student\",\n       \"Unemployed\",\n       \"Other\"\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"origin\",\n      \"title\": \"Origin\",\n      \"isRequired\": true,\n      \"choices\": [\n       \"Chengdu Central Districts\",\n       \"Other Districts/Counties in Chengdu\",\n       \"Other regions in China\"\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"la_major\",\n      \"title\": \"Is your academic major Landscape Architecture?\",\n      \"isRequired\": true,\n      \"choices\": [\n       \"Yes\",\n       \"No\"\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"visits\",\n      \"title\": \"Frequency of visits to the Yulin District:\",\n      \"isRequired\": true,\n      \"choices\": [\n       \"Never visited\",\n       \"Once a week\",\n       \"Multiple times a week\",\n       \"Occasionally\"\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"sd\",\n    \"elements\": [\n     {\n      \"type\": \"matrix\",\n      \"name\": \"sd\",\n      \"title\": \"Landscape characteristics of this street scene\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"q1\",\n        \"text\": \"Sparse vegetation - Abundant vegetation\"\n       },\n       {\n        \"value\": \"q2\",\n        \"text\": \"Inadequate facilities - Well-equipped facilities\"\n       },\n       {\n        \"value\": \"q3\",\n        \"text\": \"Weak shade - Strong shade\"\n       },\n       {\n        \"value\": \"q4\",\n        \"text\": \"Limited commercial space - Commercially viable\"\n       },\n       {\n        \"value\": \"q5\",\n        \"text\": \"Dangerous - Safe\"\n       },\n       {\n        \"value\": \"q6\",\n        \"text\": \"Narrow - Spacious\"\n       },\n       {\n        \"value\": \"q7\",\n        \"text\": \"Unremarkable - Distinctive\"\n       },\n       {\n        \"value\": \"q8\",\n        \"text\": \"Ugly - Beautiful\"\n       },\n       {\n        \"value\": \"q9\",\n        \"text\": \"Cluttered - Clean\"\n       },\n       {\n        \"value\": \"q10\",\n        \"text\": \"Dim - Vibrant\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": -3,\n        \"text\": \"-3 Completely\"\n       },\n       {\n        \"value\": -2,\n        \"text\": \"-2 Very\"\n       },\n       {\n        \"value\": -1,\n        \"text\": \"-1 Quite\"\n       },\n       {\n        \"value\": 0,\n        \"text\": \"0 Neutral\"\n       },\n       {\n        \"value\": 1,\n        \"text\": \"1 Quite\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2 Very\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3 Completely\"\n       }\n      ],\n      \"description\": \"Supplement: Evaluation of Landscape Element Characteristics, 10 adjective pairs, -3 (left adjective) to 3 (right adjective). Keyed by image id A1-D3; group = first letter (A vegetation, B buildings, C roads, D facilities).\"\n     }\n    ]\n   },\n   {\n    \"name\": \"emotion\",\n    \"elements\": [\n     {\n      \"type\": \"matrix\",\n      \"name\": \"emotion\",\n      \"title\": \"Your feelings for this scene\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"valence\",\n        \"text\": \"Valence (1 = very unpleasant, 9 = very pleasant)\"\n       },\n       {\n        \"value\": \"arousal\",\n        \"text\": \"Arousal (1 = very not excited, 9 = very excited)\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"6\"\n       },\n       {\n        \"value\": 7,\n        \"text\": \"7\"\n       },\n       {\n        \"value\": 8,\n        \"text\": \"8\"\n       },\n       {\n        \"value\": 9,\n        \"text\": \"9\"\n       }\n      ],\n      \"description\": \"Supplement: Self-Reported Emotional Ratings, SAM 1-9. Keyed by image id.\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"yulin-original\">{\"source\": \"Cheng, Wang, Xu, Ge & Ma (2026) Frontiers in Psychology 17: 1874589\", \"n\": 27, \"participants\": \"27 healthy volunteers (14 male, 13 female, mean age 24.7) who had never lived in Yulin\", \"stimuli\": \"12 of 273 street photos (DJI Osmo Pocket 3 at 160 cm), 3 per dominant element after Mask2Former segmentation and expert screening\", \"sd_order\": [\"B1\", \"D1\", \"A1\", \"C1\", \"D2\", \"A2\", \"C2\", \"B2\", \"A3\", \"C3\", \"B3\", \"D3\"], \"emotion_order\": [\"C1\", \"C2\", \"C3\", \"B1\", \"B2\", \"B3\", \"D1\", \"D2\", \"D3\", \"A1\", \"A2\", \"A3\"], \"reliability\": {\"cronbach_alpha\": 0.818, \"kmo\": 0.804}, \"results\": {\"overall_perception_F\": 8.722, \"pleasure_F\": 9.419, \"arousal_F\": 9.994, \"note\": \"all p < .001; group differences significant for all SD items except Safety (Q5); visual salience Facilities > Vegetation > Buildings > Roads\"}}</script>\n<style>\n:root{--bg:#f1efe9;--card:#fff;--ink:#22201b;--muted:#625d52;--accent:#8a4b22;--line:#ddd7cb;--warn:#b3261e;--sel:#f4e6da}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.ins{color:var(--ink)}\n.view{position:fixed;inset:0;background:#111;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:5;gap:12px}\n.view img{width:min(100vw,1100px);height:auto;max-height:88vh;object-fit:contain;display:block}\n.view .t{color:#999;font-size:.85rem;min-height:1.2em}\n.pic{position:sticky;top:0;z-index:2;background:var(--bg);padding:6px 0}\n.pic img{width:100%;max-height:42vh;object-fit:contain;display:block;border-radius:8px;background:#ddd}\n.it{padding:9px 0;border-top:1px solid var(--line)}\n.it .o{display:grid;gap:3px}\n.it label{display:flex;flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:8px;padding:3px 0;cursor:pointer;font-size:.8rem;color:var(--muted)}\n.it label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.it input{margin:0 0 1px}\n.it .an{display:flex;justify-content:space-between;gap:8px;font-size:.9rem;color:var(--ink);margin-bottom:4px}\n.it .an span:last-child{text-align:right}\n.it .q{font-size:.95rem;margin-bottom:4px}\n.it.miss .o{outline:2px solid var(--warn);outline-offset:2px;border-radius:8px}\n.legend{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;font-size:.68rem;color:var(--muted);text-align:center;margin:4px 0}\n.sam{width:100%;max-width:520px;display:block;margin:6px 0 2px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}.f:first-child{margin-top:0}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photos and manikins: Cheng, Wang, Xu, Ge &amp; Ma (2026), Frontiers in Psychology 17: 1874589, Supplementary Material (doi:10.3389/fpsyg.2026.1874589, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='yulin-streets:state', T={view:window.__VIEWMS||20000,blank:window.__VIEWMS?20:5000};\n  var IDS=['A1','A2','A3','B1','B2','B3','C1','C2','C3','D1','D2','D3'];\n  var BG=['gender','age','education','occupation','origin','la_major','visits'];\n  var O=JSON.parse(document.getElementById('yulin-original').textContent);\n  var app=document.getElementById('app'), Q={}, files={}, sam={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function fresh(){return {step:'intro',view:shuffle(IDS),k:0,q:0};}\n  function cval(c){return c&&typeof c==='object'?c.value:c;}function ctext(c){return c&&typeof c==='object'?(c.text||c.value):c;}\n  function intro(){\n    app.innerHTML='<h1>Street scenes in Chengdu</h1><p>This study is about how people perceive renewed streets in an old neighbourhood of Chengdu. You will answer a few background questions, watch 12 street photos (20 seconds each, the page moves on by itself), and then rate each photo. It takes about 20 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='bg';save();route();});};\n  }\n  function bg(){\n    app.innerHTML='<div class=\"prog\">Background</div><div class=\"card\">'+BG.map(function(n){return '<div class=\"f\"><b>'+esc(Q[n].title)+'</b>'+(Q[n].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(cval(c))+'\"> '+esc(ctext(c))+'</label>';}).join('')+'</div>';}).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var miss=BG.filter(function(n){return val(n)==null;});if(miss.length)return err('Please answer every question.');\n      send(BG.map(function(n){return SPSite.answer(n,val(n));}),this,function(){st.step='ready';save();route();});};\n  }\n  function ready(){\n    app.innerHTML='<div class=\"prog\">Viewing</div><div class=\"card\"><p class=\"ins\">You will now see 12 street photos, one after another, each for 20 seconds with a short blank screen in between. Please look at each photo carefully as if you were standing in the street.</p><button class=\"btn\" id=\"go\">Begin</button></div>';\n    document.getElementById('go').onclick=function(){st.step='view';st.k=0;save();route();};\n  }\n  function view(){\n    if(st.k>=st.view.length){st.step='sd';st.q=0;save();return route();}\n    var id=st.view[st.k],v=document.createElement('div');v.className='view';app.innerHTML='';app.appendChild(v);\n    v.innerHTML='<img alt=\"Street scene\" src=\"'+esc(files[id].url)+'\"><div class=\"t\" id=\"tm\"></div>';\n    if(st.k+1<st.view.length){var p=new Image();p.src=files[st.view[st.k+1]].url;}\n    var end=Date.now()+T.view,tm=document.getElementById('tm');\n    (function tick(){var s=Math.ceil((end-Date.now())/1000);if(s<=0){v.innerHTML='<div class=\"t\"></div>';return setTimeout(function(){st.k++;save();route();},T.blank);}if(tm)tm.textContent=(st.k+1)+' / '+st.view.length;setTimeout(tick,250);})();\n  }\n  function rateScreen(kind){\n    var order=kind==='sd'?O.sd_order:O.emotion_order;\n    if(st.q>=order.length){st.q=0;st.step=kind==='sd'?'emo_intro':'done';save();return route();}\n    var id=order[st.q],f=files[id],q=Q[kind],cs=q.columns||[],grid='grid-template-columns:repeat('+cs.length+',1fr)',h='';\n    if(kind==='sd'){\n      h='<p class=\"ins\" style=\"margin:0 0 4px\">For each pair, choose the point that best describes this street scene.</p><div class=\"legend\">'+cs.map(function(c){return '<span>'+esc(String(c.text).replace(/^-?\\d+\\s*/,''))+'</span>';}).join('')+'</div>'+\n      (q.rows||[]).map(function(r){var p=String(r.text).split(' - '),nm='sd__'+r.value;return '<div class=\"it\" data-n=\"'+nm+'\"><div class=\"an\"><span>'+esc(p[0])+'</span><span>'+esc(p[1])+'</span></div><div class=\"o\" style=\"'+grid+'\">'+cs.map(function(c){return '<label><input type=\"radio\" name=\"'+nm+'\" value=\"'+c.value+'\">'+c.value+'</label>';}).join('')+'</div></div>';}).join('');\n    } else {\n      h=(q.rows||[]).map(function(r){var nm='emotion__'+r.value;return '<div class=\"it\" data-n=\"'+nm+'\"><div class=\"q\">'+esc(r.text)+'</div><img class=\"sam\" alt=\"\" src=\"'+esc(sam[r.value].url)+'\"><div class=\"o\" style=\"'+grid+'\">'+cs.map(function(c){return '<label><input type=\"radio\" name=\"'+nm+'\" value=\"'+c.value+'\">'+c.value+'</label>';}).join('')+'</div></div>';}).join('');\n    }\n    app.innerHTML='<div class=\"prog\">'+(kind==='sd'?'Part 1 · Landscape characteristics':'Part 2 · Your feelings')+' · Scene '+(st.q+1)+' of '+order.length+'</div><div class=\"pic\"><img alt=\"Street scene '+(st.q+1)+'\" src=\"'+esc(f.url)+'\"></div><div class=\"card\">'+h+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    if(st.q+1<order.length){var p=new Image();p.src=files[order[st.q+1]].url;}\n    document.getElementById('go').onclick=function(){\n      var out={},miss=0,first=null;\n      (q.rows||[]).forEach(function(r){var nm=kind+'__'+r.value,x=val(nm),el=app.querySelector('.it[data-n=\"'+nm+'\"]');if(x==null){miss++;el.classList.add('miss');if(!first)first=el;}else{el.classList.remove('miss');out[r.value]=Number(x);}});\n      if(miss){if(first)first.scrollIntoView({block:'center'});return err('Please answer every row ('+miss+' missing).');}\n      send([SPSite.answer(kind,out,{key:id,shown:[f.name]})],this,function(){st.q++;save();route();});\n    };\n  }\n  function emoIntro(){\n    app.innerHTML='<div class=\"prog\">Part 2 · Your feelings</div><div class=\"card\"><p class=\"ins\">Now rate the emotion each of the 12 scenes evokes in you, on two 9-point scales.</p><p class=\"ins\"><b>Valence (pleasure)</b> is whether viewing the scene feels pleasant or unpleasant. Higher scores (approaching 9) indicate a more pleasant state (e.g., happiness, joy, or interest); lower scores (approaching 1) a more unpleasant state (e.g., unhappiness, fear, or anger).</p><img class=\"sam\" alt=\"Valence manikins\" src=\"'+esc(sam.valence.url)+'\"><p class=\"ins\" style=\"margin-top:12px\"><b>Arousal (excited)</b> is whether the scene feels exciting/stimulating or listless/dull. Higher scores (approaching 9) indicate higher arousal (e.g., being visually struck, stimulated, excited, or tense); lower scores (approaching 1) lower arousal (e.g., feeling relaxed, calm, listless, or bored).</p><img class=\"sam\" alt=\"Arousal manikins\" src=\"'+esc(sam.arousal.url)+'\"><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div></div>';\n    document.getElementById('go').onclick=function(){st.step='emo';st.q=0;save();route();};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var r=e.target.closest&&e.target.closest('.it');if(r)r.classList.remove('miss');});\n  function route(){var s=st.step;window.scrollTo(0,0);\n    if(s==='bg')return bg();if(s==='ready')return ready();if(s==='view')return view();if(s==='sd')return rateScreen('sd');\n    if(s==='emo_intro')return emoIntro();if(s==='emo')return rateScreen('emotion');if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','sd','emotion'].concat(BG).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('streets')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    (SPSite.getMedia('sam')||[]).forEach(function(f){sam[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=IDS.filter(function(k){return !files[k];}).concat(['valence','arousal'].filter(function(k){return !sam[k];}));\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+need.join(', ')+' to the media folders \"streets\" (A1–D3 .jpg) and \"sam\" (valence, arousal .png).</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.view)||a.consent!==true)st=fresh();\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
