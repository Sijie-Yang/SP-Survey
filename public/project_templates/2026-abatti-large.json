   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>River Photo Questionnaire</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Large Wood in Rivers: Photo Questionnaire\",\n  \"description\": \"Participants rate ten photographs of Brazilian river corridors, five with large wood (trunks, branches) in the channel and five without, on four criteria (aesthetic, naturalness, hazard, need for improvement) with a three-star scale, and explain any moderate or high hazard or improvement rating. Questions about wood are asked only after the photos. Rebuilt from Abatti et al. (2026), Environmental Management 76: 183, with the photographs printed in its Fig. 1 and the criteria definitions from its Methods (CC BY 4.0). Analysis: per participant, mean score of LW and non-LW photos per criterion, compared with Wilcoxon signed-rank tests; Kruskal-Wallis tests across education, expertise and sector; Spearman correlations among criteria.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"rivers\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part in this study.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"background\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Level of education\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"secondary\",\n        \"text\": \"Completed secondary education\"\n       },\n       {\n        \"value\": \"undergrad_in_progress\",\n        \"text\": \"Undergraduate degree in progress\"\n       },\n       {\n        \"value\": \"undergrad\",\n        \"text\": \"Completed undergraduate degree\"\n       },\n       {\n        \"value\": \"master\",\n        \"text\": \"Master degree\"\n       },\n       {\n        \"value\": \"phd\",\n        \"text\": \"Doctor's degree (PhD)\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"expertise\",\n      \"title\": \"Area of expertise\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"environmental\",\n        \"text\": \"Environmental and natural resource sciences\"\n       },\n       {\n        \"value\": \"engineering\",\n        \"text\": \"Engineering and technology\"\n       },\n       {\n        \"value\": \"health\",\n        \"text\": \"Health and multidisciplinary sciences\"\n       },\n       {\n        \"value\": \"social\",\n        \"text\": \"Social sciences, humanities, and education\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"sector\",\n      \"title\": \"Current occupation\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"researcher\",\n        \"text\": \"Researcher\"\n       },\n       {\n        \"value\": \"public\",\n        \"text\": \"Public sector employee\"\n       },\n       {\n        \"value\": \"private\",\n        \"text\": \"Private sector employee\"\n       },\n       {\n        \"value\": \"student\",\n        \"text\": \"Student\"\n       },\n       {\n        \"value\": \"retired\",\n        \"text\": \"Retired\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"residence\",\n      \"title\": \"Where do you live (city and country)?\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"photos\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"aesthetic\",\n      \"title\": \"Aesthetic\",\n      \"rateMin\": 1,\n      \"rateMax\": 3,\n      \"minRateDescription\": \"Low\",\n      \"maxRateDescription\": \"High\",\n      \"isRequired\": true,\n      \"description\": \"Harmony of forms and/or colours; beauty. Keyed by photo river_a ... river_j (panels a-j of the paper's Fig. 1). With large wood (LW): b, c, h, i, j; without LW: a, d, e, f, g. 1 = low, 2 = moderate, 3 = high (three-star scale).\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"naturalness\",\n      \"title\": \"Naturalness\",\n      \"rateMin\": 1,\n      \"rateMax\": 3,\n      \"minRateDescription\": \"Low\",\n      \"maxRateDescription\": \"High\",\n      \"isRequired\": true,\n      \"description\": \"Quality or condition of what is natural. Keyed by photo river_a ... river_j (panels a-j of the paper's Fig. 1). With large wood (LW): b, c, h, i, j; without LW: a, d, e, f, g. 1 = low, 2 = moderate, 3 = high (three-star scale).\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"hazard\",\n      \"title\": \"Hazard\",\n      \"rateMin\": 1,\n      \"rateMax\": 3,\n      \"minRateDescription\": \"Low\",\n      \"maxRateDescription\": \"High\",\n      \"isRequired\": true,\n      \"description\": \"A situation posing a threat to the integrity or safety of people, animals or objects. Keyed by photo river_a ... river_j (panels a-j of the paper's Fig. 1). With large wood (LW): b, c, h, i, j; without LW: a, d, e, f, g. 1 = low, 2 = moderate, 3 = high (three-star scale).\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"improvement\",\n      \"title\": \"Need for improvement\",\n      \"rateMin\": 1,\n      \"rateMax\": 3,\n      \"minRateDescription\": \"Low\",\n      \"maxRateDescription\": \"High\",\n      \"isRequired\": true,\n      \"description\": \"The need for change toward a better state or condition. Keyed by photo river_a ... river_j (panels a-j of the paper's Fig. 1). With large wood (LW): b, c, h, i, j; without LW: a, d, e, f, g. 1 = low, 2 = moderate, 3 = high (three-star scale).\"\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"hazard_why\",\n      \"title\": \"Why does this place look hazardous? (You may also suggest what could be done.)\",\n      \"description\": \"Asked when hazard is rated 2 or 3. Keyed by photo river_a ... river_j (panels a-j of the paper's Fig. 1). With large wood (LW): b, c, h, i, j; without LW: a, d, e, f, g. 1 = low, 2 = moderate, 3 = high (three-star scale).\"\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"improvement_why\",\n      \"title\": \"Why does this place need improvement? (You may also suggest what could be changed.)\",\n      \"description\": \"Asked when need for improvement is rated 2 or 3. Keyed by photo river_a ... river_j (panels a-j of the paper's Fig. 1). With large wood (LW): b, c, h, i, j; without LW: a, d, e, f, g. 1 = low, 2 = moderate, 3 = high (three-star scale).\"\n     }\n    ]\n   },\n   {\n    \"name\": \"wood\",\n    \"elements\": [\n     {\n      \"type\": \"comment\",\n      \"name\": \"lw_opinion\",\n      \"title\": \"What do you think about the presence of wood elements (trees, trunks, and branches) inside river channels?\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"lw_effect\",\n      \"title\": \"Overall, do you think wood inside river channels is beneficial or detrimental?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"beneficial\",\n        \"text\": \"Beneficial\"\n       },\n       {\n        \"value\": \"detrimental\",\n        \"text\": \"Detrimental\"\n       },\n       {\n        \"value\": \"depends\",\n        \"text\": \"It depends\"\n       }\n      ]\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"lw_why\",\n      \"title\": \"Why?\",\n      \"isRequired\": true\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"river-original\">{\"source\": \"Abatti et al. (2026) Environmental Management 76: 183\", \"n\": 437, \"participants\": \"adults living in Brazil, online, 2024; convenience sample via academic, governmental and professional networks\", \"table3_means\": {\"aesthetic\": {\"with_lw\": 2.2, \"without_lw\": 2.47}, \"naturalness\": {\"with_lw\": 2.53, \"without_lw\": 2.41}, \"improvement\": {\"with_lw\": 1.76, \"without_lw\": 1.53}, \"hazard\": {\"with_lw\": 1.78, \"without_lw\": 1.71}}, \"result\": \"Scenes with wood were rated more natural but less aesthetic and more in need of improvement (all p < 0.001); 62.7% rated LW scenes as hazardous (2 or 3). Respondents from environmental sciences rated LW scenes more favourably.\"}</script>\n<style>\n:root{--bg:#eef3f4;--card:#fff;--ink:#1b2427;--muted:#58676b;--accent:#1f6177;--line:#d5dfe2;--warn:#b3261e;--star:#e0a200}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.photo{width:100%;max-width:520px;border-radius:8px;display:block;margin:0 auto 10px}\ndl.defs{margin:0}dl.defs dt{font-weight:600;margin-top:8px}dl.defs dd{margin:0;color:var(--muted)}\n.it{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 0;border-top:1px solid var(--line)}\n.it:first-of-type{border-top:0}\n.stars{display:flex;gap:2px}\n.stars label{cursor:pointer;font-size:30px;line-height:1;color:#c9d2d4}\n.stars label.on{color:var(--star)}\n.stars input{position:absolute;opacity:0;width:1px;height:1px}\n.lvl{font-size:.8rem;color:var(--muted);min-width:64px;text-align:right}\ntextarea{width:100%;font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;min-height:56px}\n.why{margin-top:8px}.why b{font-weight:500}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:760px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Abatti et al. (2026), Environmental Management 76: 183, Fig. 1 (doi:10.1007/s00267-026-02489-y, CC BY 4.0); panel letters cropped off.</footer>\n<script>\n(function(){\n  var KEY='river-photo:state', LV=['','Low','Moderate','High'];\n  var DIM=[['aesthetic','Aesthetic'],['naturalness','Naturalness'],['hazard','Hazard'],['improvement','Need for improvement']];\n  var app=document.getElementById('app'), Q={}, files={}, ids=[], st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function intro(){\n    app.innerHTML='<h1>River landscapes</h1><p>This survey asks how you perceive river environments in photographs. After a few questions about you, you will see '+ids.length+' photos of Brazilian rivers and rate each one with one to three stars (low, moderate, high) on four criteria:</p><div class=\"card\"><dl class=\"defs\"><dt>Aesthetic</dt><dd>harmony of forms and/or colours; beauty</dd><dt>Naturalness</dt><dd>quality or condition of what is natural</dd><dt>Hazard</dt><dd>a situation posing a threat to the integrity or safety of people, animals or objects</dd><dt>Need for improvement</dt><dd>the need for change toward a better state or condition</dd></dl></div><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+radios('education').replace('class=\"f\"','class=\"f\" style=\"margin-top:0\"')+radios('expertise')+radios('sector')+'<div class=\"f\"><b>'+esc(Q.residence.title)+'</b><br><input type=\"text\" id=\"res\" maxlength=\"80\" style=\"font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:100%\"></div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var e=val('education'),x=val('expertise'),s=val('sector'),r=document.getElementById('res').value.trim();\n      if(!e||!x||!s||!r)return err('Please answer every question.');\n      send([SPSite.answer('education',e),SPSite.answer('expertise',x),SPSite.answer('sector',s),SPSite.answer('residence',r)],this,function(){st.step='photo';st.k=0;save();route();});\n    };\n  }\n  function stars(n){var h='<div class=\"it\"><b>'+esc(n[1])+'</b><span style=\"display:flex;align-items:center;gap:8px\"><span class=\"stars\" data-n=\"'+n[0]+'\">';for(var i=1;i<=3;i++)h+='<label title=\"'+LV[i]+'\"><input type=\"radio\" name=\"q_'+n[0]+'\" value=\"'+i+'\" aria-label=\"'+n[1]+': '+LV[i]+'\">★</label>';return h+'</span><span class=\"lvl\" id=\"l_'+n[0]+'\"></span></span></div>';}\n  function photo(){\n    var id=st.order[st.k];\n    app.innerHTML='<div class=\"prog\">Photo '+(st.k+1)+' of '+st.order.length+'</div><div class=\"card\"><img class=\"photo\" alt=\"River photograph\" src=\"'+esc(files[id].url)+'\">'+DIM.map(stars).join('')+'<div id=\"whys\"></div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next photo</button></div><div class=\"err\"></div></div>';\n    function paint(){DIM.forEach(function(d){var v=Number(val('q_'+d[0])||0);app.querySelectorAll('.stars[data-n=\"'+d[0]+'\"] label').forEach(function(l,i){l.classList.toggle('on',i<v);});document.getElementById('l_'+d[0]).textContent=LV[v]||'';});\n      var w=document.getElementById('whys'),need=['hazard','improvement'].filter(function(n){return Number(val('q_'+n))>=2;});\n      ['hazard','improvement'].forEach(function(n){var el=document.getElementById('w_'+n);if(need.indexOf(n)>=0&&!el){var d=document.createElement('div');d.className='why';d.id='w_'+n;d.innerHTML='<b>'+esc(Q[n+'_why'].title)+'</b><textarea id=\"t_'+n+'\" maxlength=\"500\"></textarea>';w.appendChild(d);}if(need.indexOf(n)<0&&el)el.remove();});}\n    app.querySelectorAll('.stars input').forEach(function(x){x.onchange=paint;});\n    document.getElementById('go').onclick=function(){\n      var v=DIM.map(function(d){return val('q_'+d[0]);});if(v.some(function(x){return x==null;}))return err('Please rate all four criteria.');\n      var sh=[files[id].name],list=DIM.map(function(d,i){return SPSite.answer(d[0],Number(v[i]),{key:id,shown:sh});});\n      for(var n of ['hazard','improvement']){var t=document.getElementById('t_'+n);if(t){var s=t.value.trim();if(!s)return err('Please say briefly why you gave that rating.');list.push(SPSite.answer(n+'_why',s,{key:id,shown:sh}));}}\n      send(list,this,function(){st.k++;if(st.k>=st.order.length)st.step='final';save();route();});\n    };\n  }\n  function final(){\n    app.innerHTML='<h2>One last question</h2><div class=\"card\"><b>'+esc(Q.lw_opinion.title)+'</b><textarea id=\"op\" maxlength=\"800\" style=\"margin-top:6px\"></textarea>'+radios('lw_effect')+'<div class=\"f\"><b>'+esc(Q.lw_why.title)+'</b><textarea id=\"wy\" maxlength=\"800\" style=\"margin-top:6px\"></textarea></div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var o=document.getElementById('op').value.trim(),e=val('lw_effect'),w=document.getElementById('wy').value.trim();\n      if(!o||!e||!w)return err('Please answer every question.');\n      send([SPSite.answer('lw_opinion',o),SPSite.answer('lw_effect',e),SPSite.answer('lw_why',w)],this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='photo')return photo();if(s==='final')return final();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','education','expertise','sector','residence','aesthetic','naturalness','hazard','improvement','hazard_why','improvement_why','lw_opinion','lw_effect','lw_why'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('rivers')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name)){var k=f.name.replace(/\\.[^.]+$/,'');files[k]=f;ids.push(k);}});\n    if(ids.length<2){app.innerHTML='<h1>Photos missing</h1><p>Upload the river photos to the media folder \"rivers\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var valid=st&&st.order&&st.order.length===ids.length&&st.order.every(function(x){return files[x];});\n    if(!valid)st={step:'intro',order:shuffle(ids),k:0};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
