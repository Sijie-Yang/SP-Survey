   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Courthouse Architecture Appearance</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Courthouse Architecture Appearance\",\n  \"description\": \"Faithful replication with the original images: nine rendered front views of Chinese courthouse buildings (No. 1-9), modelled in SketchUp from photographs of real courthouses picked by five architecture experts as the most typical of three styles (modernist, post-modernist, neoclassical) and rendered in Lumion at an eye height of 167 cm against a cloudless sky; they differ in style, height-width ratio of the front façade, window-wall ratio and the size of the open ground in front. Participants see the nine images on one page, as in the paper's survey, and judge for each whether the building is appropriate to be a courthouse building, on the paper's scale (1 = inappropriate, 2 = not very appropriate, 3 = medium, 4 = appropriate, 5 = very appropriate); scores can be changed freely until they continue. Gender, age group (18-34, 35-59, 60 and above) and education level (primary education or below, secondary education, college education, graduate education) are asked first, as in the paper. Rebuilt from Pan, Yuan, Wang & Han (2022), Research on Visual Preference of Chinese Courthouse Architecture Appearance, Buildings 12(5): 557, with the images cropped from its Figure 1 (the caption panels with style and ratios trimmed off) and the scale and demographic groups from its Tables 4-6 (CC BY 4.0). Image ids: C1-C9 = No. 1-9; the style, window-wall ratio, height-width ratio and open-ground size of each are stored in the page's original-study block for analysis. Analysis as in the paper: mean score per image, differences by gender, age and education, and multiple linear regression of scores on style, height-width ratio, window-wall ratio and open ground; the paper (594 valid questionnaires from passers-by in Xuzhou, Nanjing and Zhengzhou) found a mean score of 3.45, the highest (4.27) for a neoclassical building with open ground in front and the lowest (2.65) for a post-modernist building, and concluded that a neoclassical courthouse with a large window-wall ratio, small height-width ratio and large open ground was most preferred, with differences between demographic groups. Differences from the original study: (1) online instead of in person in three Chinese cities, and anyone can take part; (2) the question wording, instruction text and the one-page layout in the paper's numbering order are ours; the paper says participants judged whether the buildings in the nine photos were appropriate to be courthouse buildings and could change their scores freely; (3) the paper's demographic groups are used but the question wording is ours, and a prefer-not-to-say gender option is added; (4) the images are the figure copies (about 730 px wide).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"courthouses\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age_group\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"18-34 years old\",\n        \"text\": \"18-34 years old\"\n       },\n       {\n        \"value\": \"35-59 years old\",\n        \"text\": \"35-59 years old\"\n       },\n       {\n        \"value\": \"60 and above\",\n        \"text\": \"60 and above\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Education level\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"Primary education or below\",\n        \"text\": \"Primary education or below\"\n       },\n       {\n        \"value\": \"Secondary education\",\n        \"text\": \"Secondary education\"\n       },\n       {\n        \"value\": \"College education\",\n        \"text\": \"College education\"\n       },\n       {\n        \"value\": \"Graduate education\",\n        \"text\": \"Graduate education\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"buildings\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"appropriateness\",\n      \"title\": \"Is the building in this image appropriate to be a courthouse building?\",\n      \"isRequired\": true,\n      \"rateValues\": [\n       {\n        \"value\": 1,\n        \"text\": \"Inappropriate\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Not very appropriate\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Medium\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Appropriate\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"Very appropriate\"\n       }\n      ],\n      \"description\": \"Keyed by image id (C1-C9).\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"courthouse-original\">{\"source\": \"Pan, Yuan, Wang & Han (2022) Buildings 12: 557\", \"n\": 594, \"buildings\": [{\"id\": \"C1\", \"style\": \"Modernist\", \"window_wall_ratio\": \"74.8\", \"height_width_ratio\": \"0.35\", \"open_ground\": \"large\"}, {\"id\": \"C2\", \"style\": \"Post-modernist\", \"window_wall_ratio\": \"65.4\", \"height_width_ratio\": \"0.72\", \"open_ground\": \"small\"}, {\"id\": \"C3\", \"style\": \"Modernist\", \"window_wall_ratio\": \"51.9\", \"height_width_ratio\": \"0.74\", \"open_ground\": \"large\"}, {\"id\": \"C4\", \"style\": \"Modernist\", \"window_wall_ratio\": \"49.7\", \"height_width_ratio\": \"0.39\", \"open_ground\": \"large\"}, {\"id\": \"C5\", \"style\": \"Post-modernist\", \"window_wall_ratio\": \"66.1\", \"height_width_ratio\": \"0.57\", \"open_ground\": \"zero\"}, {\"id\": \"C6\", \"style\": \"Neoclassical\", \"window_wall_ratio\": \"37.5\", \"height_width_ratio\": \"0.16\", \"open_ground\": \"large\"}, {\"id\": \"C7\", \"style\": \"Modernist\", \"window_wall_ratio\": \"77.3\", \"height_width_ratio\": \"0.16\", \"open_ground\": \"zero\"}, {\"id\": \"C8\", \"style\": \"Modernist\", \"window_wall_ratio\": \"51.8\", \"height_width_ratio\": \"0.37\", \"open_ground\": \"small\"}, {\"id\": \"C9\", \"style\": \"Neoclassical\", \"window_wall_ratio\": \"48.1\", \"height_width_ratio\": \"0.34\", \"open_ground\": \"large\"}]}</script>\n<style>\n:root{--bg:#f0f1f4;--card:#fff;--ink:#1c1f26;--muted:#5b616d;--accent:#3a4f7a;--line:#d7dbe3;--warn:#b3261e;--sel:#e1e7f3}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1100px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px;margin-top:14px}\n.b{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px}\n.b img{width:100%;height:auto;display:block;border-radius:8px}\n.b .no{font-weight:700;margin:6px 0 4px}\n.o{display:grid;grid-template-columns:repeat(5,1fr);gap:3px}\n.o label{display:flex;flex-direction:column;align-items:center;gap:2px;border:1px solid var(--line);border-radius:8px;padding:5px 1px;cursor:pointer;font-size:.68rem;line-height:1.15;text-align:center;color:var(--muted)}\n.o label b{font-size:.95rem;color:var(--ink)}\n.o label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.o input{display:none}\n.b.miss{outline:2px solid var(--warn);outline-offset:2px}\n.blk{margin-top:14px}.blk:first-child{margin-top:0}\n.blk.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Images and scale: Pan, Yuan, Wang &amp; Han (2022), Buildings 12(5): 557, Figure 1 and Table 5 (doi:10.3390/buildings12050557, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='courthouse-appearance:state', IDS=['C1','C2','C3','C4','C5','C6','C7','C8','C9'], BG=['gender','age_group','education'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function intro(){\n    app.innerHTML='<h1>Courthouse buildings</h1><p>You will see nine images of courthouse buildings. For each one, judge whether the building is appropriate to be a courthouse building. You can change your scores until you finish. First, a few questions about you. It takes about 3 minutes.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+BG.map(function(n){var q=Q[n];return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var L=[],miss=[];\n      BG.forEach(function(n){var x=app.querySelector('input[name=\"'+n+'\"]:checked');if(x)L.push(SPSite.answer(n,x.value));else miss.push(app.querySelector('.blk[data-n=\"'+n+'\"]'));});\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});return err('Please answer all three questions.');}\n      send(L,this,function(){st.step='rate';save();route();});};\n  }\n  function rate(){\n    var q=Q.appropriateness,sc=q.rateValues||[];\n    app.innerHTML='<h2>'+esc(q.title)+'</h2><p>Score each building from 1 (inappropriate) to 5 (very appropriate).</p><div class=\"grid\">'+IDS.map(function(id,i){\n      return '<div class=\"b\" data-id=\"'+id+'\"><img alt=\"Courthouse building '+(i+1)+'\" src=\"'+esc(files[id].url)+'\"><div class=\"no\">No. '+(i+1)+'</div><div class=\"o\">'+sc.map(function(s){return '<label><input type=\"radio\" name=\"r_'+id+'\" value=\"'+s.value+'\"'+(st.r&&st.r[id]==s.value?' checked':'')+'><b>'+s.value+'</b>'+esc(s.text)+'</label>';}).join('')+'</div></div>';}).join('')+\n      '</div><div class=\"card\"><button class=\"btn\" id=\"go\">Finish</button><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var miss=[],L=[];st.r=st.r||{};\n      IDS.forEach(function(id){var x=app.querySelector('input[name=\"r_'+id+'\"]:checked');if(x){st.r[id]=Number(x.value);}else miss.push(app.querySelector('.b[data-id=\"'+id+'\"]'));});\n      save();\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please score all nine buildings.');}\n      IDS.forEach(function(id){L.push(SPSite.answer('appropriateness',st.r[id],{key:id,shown:[files[id].name]}));});\n      send(L,this,function(){st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var r=e.target.closest&&e.target.closest('.b,.blk');if(r){r.classList.remove('miss');if(!app.querySelector('.miss'))err('');}\n    var m=e.target.name&&/^r_/.test(e.target.name);if(m){st.r=st.r||{};st.r[e.target.name.slice(2)]=Number(e.target.value);save();}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='rate')return rate();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','appropriateness'].concat(BG).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('courthouses')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=IDS.filter(function(k){return !files[k];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"courthouses\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.step)||a.consent!==true)st={step:'intro'};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
