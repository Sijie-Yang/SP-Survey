[\n       {\n        \"value\": 5,\n        \"text\": \"Strongly agree\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Agree\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Neutral\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Oppose\"\n       },\n       {\n        \"value\": 1,\n        \"text\": \"Strongly oppose\"\n       }\n      ],\n      \"description\": \"5 = strongly agree, 1 = strongly oppose. Keyed by scene id.\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"enter\",\n      \"title\": \"Will you choose to enter this shopping mall?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       }\n      ],\n      \"description\": \"Keyed by scene id.\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"mall-original\">{\"source\": \"Zhu, Liu & Chen (2024) Buildings 14: 2302\", \"n\": 149, \"intro\": \"Now, please imagine that you are walking in the busy commercial center of an unfamiliar city, and you are looking for a shopping mall. You see a shopping mall from the street, please evaluate your emotional state and aesthetic perception according to the color of the façade of this shopping mall, and decide whether to enter or not to enter this shopping mall.\", \"emotion\": [{\"key\": \"happy_unhappy\", \"left\": \"happy\", \"right\": \"unhappy\"}, {\"key\": \"satisfied_unsatisfied\", \"left\": \"satisfied\", \"right\": \"unsatisfied\"}, {\"key\": \"contented_melancholic\", \"left\": \"contented\", \"right\": \"melancholic\"}, {\"key\": \"stimulated_relaxed\", \"left\": \"stimulated\", \"right\": \"relaxed\"}, {\"key\": \"excited_calm\", \"left\": \"excited\", \"right\": \"calm\"}, {\"key\": \"awake_sleepy\", \"left\": \"awake\", \"right\": \"sleepy\"}], \"aesthetic\": [\"elegance\", \"sophistication\", \"comfort\", \"creativity\", \"handicraft\", \"innovativeness\"], \"agree\": [{\"value\": 5, \"text\": \"Strongly agree\"}, {\"value\": 4, \"text\": \"Agree\"}, {\"value\": 3, \"text\": \"Neutral\"}, {\"value\": 2, \"text\": \"Oppose\"}, {\"value\": 1, \"text\": \"Strongly oppose\"}], \"scenes\": [{\"id\": \"S01\", \"hue_tone\": \"Warm\", \"hue\": \"5R\", \"value\": \"High\", \"munsell\": \"5R8/10\"}, {\"id\": \"S02\", \"hue_tone\": \"Warm\", \"hue\": \"5R\", \"value\": \"Low\", \"munsell\": \"5R4/14\"}, {\"id\": \"S03\", \"hue_tone\": \"Warm\", \"hue\": \"5Y\", \"value\": \"High\", \"munsell\": \"5Y8/2\"}, {\"id\": \"S04\", \"hue_tone\": \"Warm\", \"hue\": \"5Y\", \"value\": \"Low\", \"munsell\": \"5Y5/4\"}, {\"id\": \"S05\", \"hue_tone\": \"Cool\", \"hue\": \"5B\", \"value\": \"High\", \"munsell\": \"5B8/8\"}, {\"id\": \"S06\", \"hue_tone\": \"Cool\", \"hue\": \"5B\", \"value\": \"Low\", \"munsell\": \"5B4/4\"}, {\"id\": \"S07\", \"hue_tone\": \"Cool\", \"hue\": \"5G\", \"value\": \"High\", \"munsell\": \"5G7/10\"}, {\"id\": \"S08\", \"hue_tone\": \"Cool\", \"hue\": \"5G\", \"value\": \"Low\", \"munsell\": \"5G4/6\"}, {\"id\": \"S09\", \"hue_tone\": \"Neutral\", \"hue\": \"N\", \"value\": \"High\", \"munsell\": \"N10\"}, {\"id\": \"S10\", \"hue_tone\": \"Neutral\", \"hue\": \"N\", \"value\": \"Low\", \"munsell\": \"N5\"}]}</script>\n<style>\n:root{--bg:#f0f1f4;--card:#fff;--ink:#1c1f26;--muted:#5b616d;--accent:#3a4f7a;--line:#d7dbe3;--warn:#b3261e;--sel:#e1e7f3}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1100px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;margin-top:14px}\n.b{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px}\n.b img{width:100%;height:auto;display:block;border-radius:8px}\n.b .no{font-weight:700;margin:6px 0 4px}\n.o{display:grid;grid-template-columns:repeat(3,1fr);gap:3px}\n.o label{display:flex;flex-direction:column;align-items:center;gap:2px;border:1px solid var(--line);border-radius:8px;padding:5px 1px;cursor:pointer;font-size:.68rem;line-height:1.15;text-align:center;color:var(--muted)}\n.o label b{font-size:.95rem;color:var(--ink)}\n.o label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.o input{display:none}\n.b.miss{outline:2px solid var(--warn);outline-offset:2px}\n.blk{margin-top:14px}.blk:first-child{margin-top:0}\n.blk.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n.vis{max-width:860px;margin:0 auto}.vis img{width:100%;height:auto;display:block;border-radius:8px;background:#7f7f7f}\n.st{margin-top:12px}.st p{margin:0 0 6px;color:var(--ink);font-weight:600}\n.adj{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:6px}\ninput.tx{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:10px;width:100%;min-width:0}\n.top{display:flex;justify-content:space-between;align-items:baseline;gap:10px}\n@media (max-width:520px){.adj{grid-template-columns:1fr}}\n.sd{display:grid;grid-template-columns:7.5em repeat(5,1fr) 7.5em;gap:4px;align-items:center;margin-top:6px}\n.sd span{font-size:.9rem}.sd span.r{text-align:left}.sd span.l{text-align:right}\n.sd label,.ag label{display:flex;justify-content:center;align-items:center;border:1px solid var(--line);border-radius:8px;min-height:36px;cursor:pointer}\n.sd label:has(input:checked),.ag label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.sd input,.ag input{display:none}.sd label::after{content:\"\";width:12px;height:12px;border:2px solid var(--muted);border-radius:3px}\n.sd label:has(input:checked)::after{background:var(--accent);border-color:var(--accent)}\n.ag{display:grid;grid-template-columns:8em repeat(5,1fr);gap:4px;align-items:center;margin-top:6px}\n.ag label{font-size:.72rem;text-align:center;line-height:1.1;padding:2px;color:var(--muted)}\n.row{border-radius:8px;padding:2px}.row.miss{outline:2px solid var(--warn);outline-offset:1px}\n.black{position:fixed;inset:0;background:#000;color:#666;display:flex;align-items:center;justify-content:center;font-size:.9rem;z-index:9}\n.vis{position:sticky;top:0;z-index:2;background:var(--bg);padding-bottom:6px}.vis img{max-height:42vh;object-fit:contain}\n@media (max-width:560px){.sd{grid-template-columns:5.6em repeat(5,1fr) 5.6em}.sd span{font-size:.78rem}.ag{grid-template-columns:repeat(5,minmax(0,1fr))}.ag span{grid-column:1/-1;font-weight:600;font-size:.9rem}.ag label{font-size:.66rem;overflow-wrap:anywhere}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Renderings and questionnaire: Zhu, Liu &amp; Chen (2024), Buildings 14(8): 2302, Figure 2 and Appendix A (doi:10.3390/buildings14082302, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='mall-color:state', O=JSON.parse(document.getElementById('mall-original').textContent), IDS=O.scenes.map(function(a){return a.id;}),\n      BG=['gender','age_group','marital_status','education','income','color_vision_deficiency'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function intro(){\n    app.innerHTML='<h1>Shopping mall facade colors</h1><p>You will see ten pictures of the same shopping mall with different facade colors. After each picture, you rate how you feel, how the mall\\'s colors make you feel, and whether you would go in. A black screen is shown for 10 seconds between pictures. First, a few questions about you. It takes about 15 minutes.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+BG.map(function(n){var q=Q[n];\n      return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var L=[],miss=[];\n      BG.forEach(function(n){var x=app.querySelector('input[name=\"'+n+'\"]:checked');if(x)L.push(SPSite.answer(n,x.value));else miss.push(app.querySelector('.blk[data-n=\"'+n+'\"]'));});\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please answer all questions.');}\n      send(L,this,function(){st.step='task';save();route();});};\n  }\n  function task(){\n    app.innerHTML='<h2>Before you start</h2><div class=\"card\"><p style=\"color:var(--ink)\">'+esc(O.intro)+'</p><button class=\"btn\" id=\"go\">Show the first mall</button></div>';\n    document.getElementById('go').onclick=function(){st.step='scene';st.i=0;save();route();};\n  }\n  function scene(){\n    var k=st.i,id=IDS[k];\n    app.innerHTML='<div class=\"vis\"><h2 style=\"margin:0 0 6px\">Shopping mall '+(k+1)+' of '+IDS.length+'</h2><img alt=\"Shopping mall, color version '+(k+1)+'\" src=\"'+esc(files[id].url)+'\"></div>'+\n      '<div class=\"card\"><div class=\"blk\" data-n=\"emotion\"><b>1. '+esc(Q.emotion.title)+'</b>'+O.emotion.map(function(e){return '<div class=\"row sd\" data-r=\"'+e.key+'\"><span class=\"l\">'+esc(e.left)+'</span>'+[1,2,3,4,5].map(function(v){return '<label title=\"'+v+'\"><input type=\"radio\" name=\"e_'+e.key+'\" value=\"'+v+'\"></label>';}).join('')+'<span class=\"r\">'+esc(e.right)+'</span></div>';}).join('')+'</div>'+\n      '<div class=\"blk\" data-n=\"aesthetic\" style=\"margin-top:18px\"><b>2. '+esc(Q.aesthetic.title)+'</b>'+O.aesthetic.map(function(a){return '<div class=\"row ag\" data-r=\"'+a+'\"><span>'+esc(a)+'</span>'+O.agree.map(function(c){return '<label><input type=\"radio\" name=\"a_'+a+'\" value=\"'+c.value+'\">'+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+'</div>'+\n      '<div class=\"blk\" data-n=\"enter\" style=\"margin-top:18px\"><b>3. '+esc(Q.enter.title)+'</b>'+(Q.enter.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"enter\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>'+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">'+(k<IDS.length-1?'Next':'Finish')+'</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var miss=[],em={},ae={},sh=[files[id].name];\n      O.emotion.forEach(function(e){var x=app.querySelector('input[name=\"e_'+e.key+'\"]:checked');if(x)em[e.key]=Number(x.value);else miss.push(app.querySelector('.row[data-r=\"'+e.key+'\"]'));});\n      O.aesthetic.forEach(function(a){var x=app.querySelector('input[name=\"a_'+a+'\"]:checked');if(x)ae[a]=Number(x.value);else miss.push(app.querySelector('.row[data-r=\"'+a+'\"]'));});\n      var en=app.querySelector('input[name=\"enter\"]:checked');if(!en)miss.push(app.querySelector('.blk[data-n=\"enter\"]'));\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please answer every row and the last question.');}\n      var o={key:id,shown:sh};\n      send([SPSite.answer('emotion',em,o),SPSite.answer('aesthetic',ae,o),SPSite.answer('enter',en.value,o)],this,function(){\n        if(k<IDS.length-1){st.i=k+1;save();blackout();}else{st.step='done';save();route();}});};\n  }\n  function blackout(){var d=document.createElement('div');d.className='black';d.textContent='Next picture in 10 seconds';document.body.appendChild(d);\n    var img=new Image();img.src=files[IDS[st.i]].url;\n    setTimeout(function(){d.remove();route();},10000);}\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function clr(e){var r=e.target.closest&&e.target.closest('.row,.blk[data-n=enter],.blk[data-n]:not([data-n=emotion]):not([data-n=aesthetic])');if(r){r.classList.remove('miss');if(!app.querySelector('.miss'))err('');}}\n  app.addEventListener('change',clr);\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='task')return task();if(s==='scene')return scene();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','emotion','aesthetic','enter'].concat(BG).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('malls')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=IDS.filter(function(k){return !files[k];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"malls\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.step)||a.consent!==true)st={step:'intro'};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
