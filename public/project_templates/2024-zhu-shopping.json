e\": \"High school or below\",\n        \"text\": \"High school or below\"\n       },\n       {\n        \"value\": \"Junior college\",\n        \"text\": \"Junior college\"\n       },\n       {\n        \"value\": \"Undergraduate\",\n        \"text\": \"Undergraduate\"\n       },\n       {\n        \"value\": \"Master's degree or above\",\n        \"text\": \"Master's degree or above\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"income\",\n      \"title\": \"Average monthly income (yuan, including bonuses, benefits and other forms of income)\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"5000 and below\",\n        \"text\": \"5000 and below\"\n       },\n       {\n        \"value\": \"5001-10,000\",\n        \"text\": \"5001-10,000\"\n       },\n       {\n        \"value\": \"10,001-20,000\",\n        \"text\": \"10,001-20,000\"\n       },\n       {\n        \"value\": \"20,001-30,000\",\n        \"text\": \"20,001-30,000\"\n       },\n       {\n        \"value\": \"Above 30,000\",\n        \"text\": \"Above 30,000\"\n       },\n       {\n        \"value\": \"Prefer not to say\",\n        \"text\": \"Prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"color_vision_deficiency\",\n      \"title\": \"Do you have any color vision deficiency (color blindness)?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       },\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"unsure\",\n        \"text\": \"Not sure\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"scenes\",\n    \"elements\": [\n     {\n      \"type\": \"matrix\",\n      \"name\": \"emotion\",\n      \"title\": \"When you look at the façade of this shopping mall, rate your current emotional state\",\n      \"isRequired\": true,\n    