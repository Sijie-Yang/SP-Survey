   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Do Children Prefer Nature? Picture Sorting</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Do Children Prefer Nature? Picture Sorting\",\n    \"description\": \"Children (4–11) and their parents sort sets of four nature and city pictures from the one they like least (frowny face) to the one they like most (smiley face). Rebuilt from Meidenbauer, Stenfors, Young, Layden, Schertz, Kardan, Decety & Berman (2019).\",\n    \"locale\": \"en\",\n    \"mediaFolders\": [\"set1\", \"set2\"],\n    \"pages\": [\n      { \"name\": \"setup\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"A parent or guardian agrees that the child and the parent take part. Answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"We agree\", \"labelFalse\": \"We do not agree\" },\n        { \"type\": \"radiogroup\", \"name\": \"role\", \"title\": \"Who is sorting the pictures? (filled in by the researcher)\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"child\", \"text\": \"Child\" }, { \"value\": \"parent\", \"text\": \"Parent or guardian\" } ] },\n        { \"type\": \"text\", \"inputType\": \"number\", \"name\": \"age\", \"title\": \"Age (years)\", \"min\": 3, \"max\": 99, \"isRequired\": true },\n        { \"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"choices\": [\n          { \"value\": \"girl_woman\", \"text\": \"Girl / woman\" }, { \"value\": \"boy_man\", \"text\": \"Boy / man\" }, { \"value\": \"other\", \"text\": \"Other / prefer not to say\" } ] },\n        { \"type\": \"text\", \"name\": \"family_id\", \"title\": \"Family code, to pair a child with their parent (optional)\" },\n        { \"type\": \"radiogroup\", \"name\": \"picture_set\", \"title\": \"Picture set (set by the page at random)\", \"choices\": [\n          { \"value\": \"set1\", \"text\": \"Picture set 1\" }, { \"value\": \"set2\", \"text\": \"Picture set 2\" } ] }\n      ]},\n      { \"name\": \"sorting\", \"elements\": [\n        { \"type\": \"imageranking\", \"name\": \"sort_pictures\", \"title\": \"Put the pictures in order, from the one you like least (frowny face) to the one you like most (smiley face).\", \"imageCount\": 4, \"isRequired\": true }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#fbf8f2;--card:#fff;--ink:#22201b;--muted:#625d52;--accent:#2f7d5b;--accent-ink:#fff;--line:#e4ddcf;--pick:#f3c64f}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1100px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:12px;padding:14px 22px;font:inherit;font-weight:700;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:14px}.q>b{display:block;margin-bottom:4px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\ninput[type=number],input[type=text]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:200px}\n.progress{height:8px;background:var(--line);border-radius:4px;overflow:hidden;margin:8px 0 14px}.progress>i{display:block;height:100%;background:var(--accent)}\n.board{display:flex;align-items:center;gap:10px}\n.face{font-size:2.6rem;line-height:1;flex:0 0 auto;user-select:none}\n.row{flex:1;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;touch-action:none}\n.pic{position:relative;border-radius:12px;overflow:hidden;border:4px solid transparent;cursor:grab;background:#ddd;aspect-ratio:4/3;user-select:none;-webkit-user-select:none}\n.pic img{width:100%;height:100%;object-fit:cover;display:block;pointer-events:none}\n.pic.sel{border-color:var(--pick)}\n.pic.drag{opacity:.85;cursor:grabbing;z-index:5;box-shadow:0 8px 24px rgba(0,0,0,.25)}\n.hint{font-size:.9rem;color:var(--muted);margin-top:8px}\n.err{color:#b3261e;margin-top:8px;min-height:1.2em}\n@media (max-width:700px){.row{grid-template-columns:repeat(2,1fr)}.face{font-size:2rem}}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Pictures: stimuli of Berman et al. (2014), PLOS ONE 9(12): e114572, S2 Data, Creative Commons Attribution License.</footer>\n<script>\n(function(){\n  // 10 trials of 4 pictures from a set of 10: every picture appears 4 times and\n  // every pair of pictures meets at least once, as in the paper's app.\n  var DESIGN=[[0,1,2,9],[0,1,3,4],[0,3,5,6],[0,6,7,8],[1,3,6,8],[1,4,5,7],[2,3,7,9],[2,4,5,8],[2,4,6,9],[5,7,8,9]];\n  var app=document.getElementById('app'), Q={}, set=null, files=[], trials=[], done={}, t=0;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function shuffle(a){a=a.slice();for(var k=a.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1));var x=a[k];a[k]=a[j];a[j]=x;}return a;}\n  function store(k,v){try{localStorage.setItem('kidsnature2019:'+k,JSON.stringify(v));}catch(e){}}\n  function load(k){try{return JSON.parse(localStorage.getItem('kidsnature2019:'+k));}catch(e){return null;}}\n  function setup(){\n    var sets=['set1','set2'].filter(function(s){return (SPSite.getMedia(s)||[]).length>=10;});\n    var saved=load('plan');\n    if(saved&&sets.indexOf(saved.set)>=0){\n      var by={};(SPSite.getMedia(saved.set)||[]).forEach(function(f){by[f.name]=f;});\n      if(saved.files.every(function(n){return by[n];})){set=saved.set;files=saved.files.map(function(n){return by[n];});trials=saved.trials;return;}\n    }\n    if(!sets.length)return;\n    set=sets[Math.floor(Math.random()*sets.length)];\n    files=shuffle(SPSite.getMedia(set)).slice(0,10);          // random picture-to-slot mapping\n    trials=shuffle(DESIGN).map(function(b){return shuffle(b);}); // random trial order and start positions\n    store('plan',{set:set,files:files.map(function(f){return f.name;}),trials:trials});\n  }\n  function setupPage(){\n    if(!files.length){app.innerHTML='<h1>No pictures yet</h1><p>The researcher has not added 10 pictures to the folder “set1” or “set2”.</p>';return;}\n    var radios=function(n){return (Q[n].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');};\n    app.innerHTML='<h1>Picture sorting</h1><p>For the researcher: fill this in, then hand the tablet to the participant. A child and their parent each do the task once; give both the same family code.</p>'+\n      '<div class=\"card\"><label class=\"opt\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label>'+\n      '<div class=\"q\"><b>'+esc(Q.role.title)+'</b>'+radios('role')+'</div>'+\n      '<div class=\"q\"><b>'+esc(Q.age.title)+'</b><input type=\"number\" id=\"age\" min=\"3\" max=\"99\" inputmode=\"numeric\"></div>'+\n      '<div class=\"q\"><b>'+esc(Q.gender.title)+'</b>'+radios('gender')+'</div>'+\n      '<div class=\"q\"><b>'+esc(Q.family_id.title)+'</b><input type=\"text\" id=\"fam\" maxlength=\"40\"></div>'+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var role=(app.querySelector('input[name=role]:checked')||{}).value, age=document.getElementById('age').value, g=(app.querySelector('input[name=gender]:checked')||{}).value, fam=document.getElementById('fam').value.trim();\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      if(!role)return err('Please choose who is sorting the pictures.');\n      if(age==='')return err('Please enter the age.');\n      var b=this;b.disabled=true;\n      var steps=[SPSite.answer('consent',true),SPSite.answer('role',role),SPSite.answer('age',Number(age)),SPSite.answer('picture_set',set)];\n      if(g)steps.push(SPSite.answer('gender',g)); if(fam)steps.push(SPSite.answer('family_id',fam));\n      Promise.all(steps).then(function(rs){var bad=rs.filter(function(r){return r&&r.ok===false;})[0];if(bad){b.disabled=false;return err(bad.error);}instructions(role);});\n    };\n  }\n  function instructions(role){\n    var child=role!=='parent';\n    app.innerHTML='<h1>'+(child?'Let’s sort some pictures!':'Sort the pictures')+'</h1><div class=\"card\"><p style=\"color:var(--ink)\">You are about to see sets of four pictures. Put them in order based on how much you like them. On one end there is a frowny face 🙁 and on the other a smiley face 🙂. Move the pictures so that the one you like the <b>least</b> is next to the frowny face and the one you like the <b>most</b> is next to the smiley face. Then press the green button to go to the next set.</p>'+\n      '<p>Drag a picture to move it, or tap two pictures to swap them.</p><button class=\"btn\" id=\"go\">Start</button></div>';\n    document.getElementById('go').onclick=function(){t=0;next();};\n  }\n  function next(){\n    while(t<trials.length&&done[t])t++;\n    if(t>=trials.length)return finish();\n    var order=trials[t].map(function(k){return files[k];}); // left (frowny) to right (smiley)\n    var shown=order.map(function(f){return f.name;});       // as first shown: image_0..image_3\n    app.innerHTML='<p>Set '+(t+1)+' of '+trials.length+'</p><div class=\"progress\"><i style=\"width:'+(100*t/trials.length)+'%\"></i></div>'+\n      '<div class=\"board\"><span class=\"face\" aria-label=\"least liked\">🙁</span><div class=\"row\" id=\"row\"></div><span class=\"face\" aria-label=\"most liked\">🙂</span></div>'+\n      '<div class=\"hint\">Least liked ← → Most liked</div><div style=\"margin-top:18px\"><button class=\"btn\" id=\"nx\">Done ✓</button></div><div class=\"err\"></div>';\n    var row=document.getElementById('row'), cur=order.slice(), sel=-1;\n    function draw(){row.innerHTML=cur.map(function(f,i){return '<div class=\"pic'+(i===sel?' sel':'')+'\" data-i=\"'+i+'\"><img src=\"'+esc(f.url)+'\" alt=\"Picture\" draggable=\"false\"></div>';}).join('');}\n    draw();\n    var drag=null;\n    row.addEventListener('pointerdown',function(e){var el=e.target.closest('.pic');if(!el)return;drag={i:+el.getAttribute('data-i'),x:e.clientX,y:e.clientY,el:el,moved:false};el.setPointerCapture(e.pointerId);});\n    row.addEventListener('pointermove',function(e){if(!drag)return;var dx=e.clientX-drag.x,dy=e.clientY-drag.y;if(!drag.moved&&Math.hypot(dx,dy)<8)return;drag.moved=true;drag.el.classList.add('drag');drag.el.style.transform='translate('+dx+'px,'+dy+'px)';});\n    row.addEventListener('pointerup',function(e){\n      if(!drag)return;var d=drag;drag=null;\n      if(!d.moved){ // tap: select, then tap another to swap\n        if(sel<0){sel=d.i;}else if(sel===d.i){sel=-1;}else{var x=cur[sel];cur[sel]=cur[d.i];cur[d.i]=x;sel=-1;}\n        draw();return;\n      }\n      d.el.style.visibility='hidden';var under=document.elementFromPoint(e.clientX,e.clientY);d.el.style.visibility='';\n      var tgt=under&&under.closest?under.closest('.pic'):null;\n      if(tgt&&row.contains(tgt)){var j=+tgt.getAttribute('data-i');var f=cur.splice(d.i,1)[0];cur.splice(j,0,f);}\n      sel=-1;draw();\n    });\n    row.addEventListener('pointercancel',function(){drag=null;draw();});\n    document.getElementById('nx').onclick=function(){\n      var b=this;b.disabled=true;\n      // ranking value: best first, as image_<position in which it was first shown>\n      var best=cur.slice().reverse().map(function(f){return 'image_'+shown.indexOf(f.name);});\n      SPSite.answer('sort_pictures',best,{key:'set'+(t+1),shown:shown}).then(function(r){\n        if(r&&r.ok===false){b.disabled=false;return err(r.error);}\n        done[t]=true;t++;next();\n      });\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>All done — thank you!</h1><div class=\"card\"><p>Saving…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(r&&r.ok===false){err(r.error||'Some answers are missing.');var m=r.missing||[];if(m.indexOf('consent')>=0||m.indexOf('role')>=0||m.indexOf('age')>=0)setupPage();else{done={};t=0;next();}}});\n  }\n  SPSite.onReady(function(ctx){\n    ['consent','role','age','gender','family_id','picture_set','sort_pictures'].forEach(function(n){Q[n]=SPSite.getQuestion(n);});\n    setup();\n    var a=(ctx&&ctx.answers)||{};\n    var p=a.sort_pictures; var keys={};(p&&Array.isArray(p.trials)?p.trials:[]).forEach(function(x){if(x&&x.key!=null&&x.value!=null)keys[x.key]=1;});\n    trials.forEach(function(_,i){if(keys['set'+(i+1)])done[i]=true;});\n    if(a.consent===true&&a.role&&a.age!=null)instructions(a.role);else setupPage();\n  });\n})();\n</script>\n</body>\n</html>\n",
