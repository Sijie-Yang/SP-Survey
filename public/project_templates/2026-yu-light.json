ame\": \"education\",\n      \"title\": \"Education\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Junior high school or below\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"High school / technical secondary school\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"College degree or above\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"pairs\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"pair_choice\",\n      \"title\": \"Which living room do you prefer?\",\n      \"isRequired\": false,\n      \"description\": \"All 15 pairs of the six living-room renderings (2 colour temperatures × 3 wood gloss levels), random order and random left/right. Each trial: fixation cross 2 s, pair shown 15 s, then choose the image that better matches your visual experience and spatial comfort preference; 3 s blank between trials. Value: {chosen, left, right} (condition codes WL, WM, WH, CL, CM, CH). Analysis as in the paper: selection proportion per condition (times chosen / times shown), 2 × 3 repeated-measures ANOVA (CCT × gloss).\",\n      \"conditions\": [\n       {\n        \"id\": \"WL\",\n        \"label\": \"2700 K, low gloss\",\n        \"image\": \"wl_2700k_low_gloss.jpg\"\n       },\n       {\n        \"id\": \"WM\",\n        \"label\": \"2700 K, medium gloss\",\n        \"image\": \"wm_2700k_medium_gloss.jpg\"\n       },\n       {\n        \"id\": \"WH\",\n        \"label\": \"2700 K, high gloss\",\n        \"image\": \"wh_2700k_high_gloss.jpg\"\n       },\n       {\n        \"id\": \"CL\",\n        \"label\": \"4000 K, low gloss\",\n        \"image\": \"cl_4000k_low_gloss.jpg\"\n       },\n       {\n        \"id\": \"CM\",\n        \"label\": \"4000 K, medium gloss\",\n        \"image\": \"cm_4000k_medium_gloss.jpg\"\n       },\n       {\n        \"id\": \"CH\",\n        \"label\": \"4000 K, high gloss\",\n        \"image\": \"ch_4000k_high_gloss.jpg\"\n       }\n      ],\n      \"pairs\": [\n       [\n        \"WL\",\n        \"WM\"\n       ],\n       [\n        \"WL\",\n        \"WH\"\n       ],\n       [\n        \"WL\",\n        \"CL\"\n       ],\n       [\n        \"WL\",\n        \"CM\"\n       ],\n       [\n        \"WL\",\n        \"CH\"\n       ],\n       [\n        \"WM\",\n        \"WH\"\n       ],\n       [\n        \"WM\",\n        \"CL\"\n       ],\n       [\n        \"WM\",\n        \"CM\"\n       ],\n       [\n        \"WM\",\n        \"CH\"\n       ],\n       [\n        \"WH\",\n        \"CL\"\n       ],\n       [\n        \"WH\",\n        \"CM\"\n       ],\n       [\n        \"WH\",\n        \"CH\"\n       ],\n       [\n        \"CL\",\n        \"CM\"\n       ],\n       [\n        \"CL\",\n        \"CH\"\n       ],\n       [\n        \"CM\",\n        \"CH\"\n       ]\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"ratings\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"impression\",\n      \"title\": \"Psychological impression of each living room\",\n      \"isRequired\": false,\n      \"description\": \"After the pairs, each of the six renderings is rated in random order on six 7-point items (higher = stronger): naturalness, warmth, relaxation, interest, desire to use, overall comfort. Value: {naturalness, warmth, relaxation, interest, desire_to_use, overall_comfort}, key = condition code. Analysis as in the paper: 2 × 3 repeated-measures ANOVA per item.\",\n      \"items\": [\n       {\n        \"key\": \"naturalness\",\n        \"text\": \"Naturalness\",\n        \"question\": \"How natural does this space feel?\"\n       },\n       {\n        \"key\": \"warmth\",\n        \"text\": \"Warmth\",\n        \"question\": \"How warm does this space feel?\"\n       },\n       {\n        \"key\": \"relaxation\",\n        \"text\": \"Relaxation\",\n        \"question\": \"How relaxed do you feel in this space?\"\n       },\n       {\n        \"key\": \"interest\",\n        \"text\": \"Interest\",\n        \"question\": \"How interesting is this space?\"\n       },\n       {\n        \"key\": \"desire_to_use\",\n        \"text\": \"Desire to use\",\n        \"question\": \"How much would you like to stay in this space?\"\n       },\n       {\n        \"key\": \"overall_comfort\",\n        \"text\": \"Overall comfort\",\n        \"question\": \"How comfortable is this space overall?\"\n       }\n      ],\n      \"trials\": [\n       {\n        \"id\": \"WL\",\n        \"label\": \"2700 K, low gloss\",\n        \"image\": \"wl_2700k_low_gloss.jpg\"\n       },\n       {\n        \"id\": \"WM\",\n        \"label\": \"2700 K, medium gloss\",\n        \"image\": \"wm_2700k_medium_gloss.jpg\"\n       },\n       {\n        \"id\": \"WH\",\n        \"label\": \"2700 K, high gloss\",\n        \"image\": \"wh_2700k_high_gloss.jpg\"\n       },\n       {\n        \"id\": \"CL\",\n        \"label\": \"4000 K, low gloss\",\n        \"image\": \"cl_4000k_low_gloss.jpg\"\n       },\n       {\n        \"id\": \"CM\",\n        \"label\": \"4000 K, medium gloss\",\n        \"image\": \"cm_4000k_medium_gloss.jpg\"\n       },\n       {\n        \"id\": \"CH\",\n        \"label\": \"4000 K, high gloss\",\n        \"image\": \"ch_4000k_high_gloss.jpg\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"open\",\n    \"elements\": [\n     {\n      \"type\": \"comment\",\n      \"name\": \"preferred_elements\",\n      \"title\": \"Which elements of the space did you like most?\",\n      \"isRequired\": false\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#f1efec;--card:#fff;--ink:#1f2328;--muted:#5d646c;--accent:#8a5a2b;--accent-ink:#fff;--line:#dcd8d2;--warn:#b3261e;--miss:#fdecea}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1100px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.35rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.narrow{max-width:820px;margin:0 auto}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 22px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q>b{display:block;margin-bottom:4px}\n.q.miss{background:var(--miss);border-radius:10px;padding:6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}\n.t{color:var(--muted);font-size:.9rem}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.fix{height:min(60vh,520px);display:flex;align-items:center;justify-content:center;font-size:3rem;color:#333;background:#fff;border-radius:14px;border:1px solid var(--line)}\n.blank{height:min(60vh,520px);background:#fff;border-radius:14px;border:1px solid var(--line)}\n.pair{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n@media(max-width:640px){.pair{grid-template-columns:1fr}}\n.side img{width:100%;display:block;border-radius:10px;background:#ddd}\n.side .btn{width:100%;margin-top:8px}\n.cd{text-align:center;color:var(--muted);margin-top:12px;font-size:.95rem;min-height:1.5em}\n.pic img{width:100%;max-height:min(48vh,440px);object-fit:contain;display:block;border-radius:10px;background:#ddd}\n.it{padding:10px 6px;border-top:1px solid var(--line);border-radius:8px}\n.it .x{font-weight:500;margin-bottom:6px}\n.sc{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:2px}\n.sc label{display:flex;flex-direction:column;align-items:center;font-size:.9rem;color:var(--muted);cursor:pointer;padding:2px 0;min-width:0}\n.sc input{width:22px;height:22px;margin:0 0 2px}\n.ends{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-top:2px;gap:8px}\n.it.miss{background:var(--miss)}\ntextarea{width:100%;min-height:90px;font:inherit;padding:8px;border-radius:8px;border:1px solid var(--line)}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Renderings: Yu, Fan &amp; Zhu (2026), Buildings 16:2956, Figure 2, doi:10.3390/buildings16152956 (CC BY 4.0). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='yucct2026:', SP=window.__SPEED||1;\n  var app=document.getElementById('app'), Q={}, files={}, ans={}, CONDS=[], PAIRS=[], ITEMS=[], pdone={}, rdone={}, PORDER=null, RORDER=null, timers=[];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function q(n){return Q[n]||{};}\n  function later(f,ms){timers.push(setTimeout(f,ms/SP));}\n  function clear(){timers.forEach(clearTimeout);timers=[];}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function page(html,btn,cb){clear();app.innerHTML='<div class=\"narrow\">'+html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn)+'</button></div><div class=\"err\"></div></div>';document.getElementById('go').onclick=cb;app.onchange=hideErr;}\n  function send(list,b,fin){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}fin();});}\n  function cond(id){for(var i=0;i<CONDS.length;i++)if(CONDS[i].id===id)return CONDS[i];}\n  function pkey(p){return p[0]+'-'+p[1];}\n  function bar(i,n,w){return '<div class=\"top\"><span class=\"t\">'+w+' '+(i+1)+' of '+n+'</span><div class=\"bar\"><i style=\"width:'+(100*i/n)+'%\"></i></div></div>';}\n  function next(){\n    window.scrollTo(0,0);\n    if(!ans.intro)return intro();\n    if(!ans.about)return about();\n    if(!ans.seenPairs)return pairIntro();\n    for(var i=0;i<PORDER.length;i++)if(!pdone[pkey(PORDER[i])])return pair(PORDER[i],i);\n    if(!ans.seenRate)return rateIntro();\n    for(var j=0;j<RORDER.length;j++)if(!rdone[RORDER[j]])return rate(cond(RORDER[j]),j);\n    if(!ans.open)return openq();\n    finish();\n  }\n  function intro(){\n    var miss=CONDS.some(function(c){return !files[c.image];});\n    if(miss){app.innerHTML='<h1>Pictures missing</h1><p>Media folder rooms must hold the six living-room renderings (wl_2700k_low_gloss.jpg … ch_4000k_high_gloss.jpg).</p>';return;}\n    page('<h1>Light and wood in a living room</h1><p>This study looks at how the colour of the lighting and the shine of wooden surfaces affect how comfortable a home living room feels, especially for older adults.</p><p>You will first compare pictures of a living room two at a time (15 pairs), then rate each of the six pictures. It takes about 12 minutes. Please use a large screen if you can. Your answers are anonymous and used only for research.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      send([SPSite.answer('consent',true)],this,function(){ans.intro=true;save('a',ans);next();});});\n  }\n  var DEMO=['sex','age_group','education'];\n  function about(){\n    page('<h1>About you</h1><div class=\"card\">'+DEMO.map(function(n,k){var d=q(n);return '<div class=\"q\" data-n=\"'+n+'\"'+(k?'':' style=\"margin-top:0\"')+'><b>'+esc(d.title)+'</b>'+(d.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+'</div>','Continue',function(){\n      var v={},miss=[];DEMO.forEach(function(n){var x=app.querySelector('input[name=\"'+n+'\"]:checked');var r=app.querySelector('.q[data-n=\"'+n+'\"]');if(x){v[n]=Number(x.value);r.classList.remove('miss');}else{miss.push(r);r.classList.add('miss');}});\n      if(miss.length){err('Please answer every question (marked in red).');miss[0].scrollIntoView({block:'center'});return;}\n      send(DEMO.map(function(n){return SPSite.answer(n,v[n]);}),this,function(){ans.about=true;save('a',ans);next();});});\n  }\n  function pairIntro(){\n    page('<h1>Part 1: Compare pairs</h1><div class=\"card\"><p style=\"color:var(--ink)\">A cross appears in the centre first; please look at it. Then two pictures of the same living room are shown side by side for 15 seconds. Look at both freely. When the 15 seconds are over, choose the picture that better matches your visual experience and the space you would find more comfortable.</p><p>There are 15 pairs. A short blank screen separates them.</p></div>','Begin',function(){ans.seenPairs=true;save('a',ans);next();});\n  }\n  function pair(p,i){\n    clear();var head=bar(i,PORDER.length,'Pair');\n    app.innerHTML=head+'<div class=\"fix\" aria-label=\"Look at the cross\">+</div>';\n    later(function(){\n      var L=cond(p[0]),R=cond(p[1]),fl=files[L.image],fr=files[R.image];\n      app.innerHTML=head+'<div class=\"pair\"><div class=\"side\"><img alt=\"Living room, left picture\" src=\"'+esc(fl.url)+'\"><button class=\"btn pick\" data-c=\"'+L.id+'\" disabled>Choose this one</button></div><div class=\"side\"><img alt=\"Living room, right picture\" src=\"'+esc(fr.url)+'\"><button class=\"btn pick\" data-c=\"'+R.id+'\" disabled>Choose this one</button></div></div><div class=\"cd\" id=\"cd\">Please look at both pictures…</div><div class=\"err\"></div>';\n      var t0=Date.now(),cd=document.getElementById('cd');\n      (function tick(){var l=15000/SP-(Date.now()-t0);if(l<=0){cd.textContent='Which living room do you prefer?';[].forEach.call(app.querySelectorAll('.pick'),function(b){b.disabled=false;});return;}cd.textContent='Please look at both pictures… '+Math.ceil(l*SP/1000)+' s';later(tick,250);})();\n      [].forEach.call(app.querySelectorAll('.pick'),function(b){b.onclick=function(){\n        [].forEach.call(app.querySelectorAll('.pick'),function(x){x.disabled=true;});\n        var k=[L.id,R.id].sort(function(a,b){return idx(a)-idx(b);}).join('-');\n        send([SPSite.answer('pair_choice',{chosen:b.getAttribute('data-c'),left:L.id,right:R.id},{key:k,shown:[fl.name,fr.name]})],null,function(){\n          pdone[pkey(p)]=true;clear();app.innerHTML=head+'<div class=\"blank\"></div>';later(next,3000);});};});\n    },2000);\n  }\n  function idx(id){for(var i=0;i<CONDS.length;i++)if(CONDS[i].id===id)return i;return 99;}\n  function rateIntro(){\n    page('<h1>Part 2: Rate each living room</h1><div class=\"card\"><p style=\"color:var(--ink)\">You will now see each of the six living rooms again, one at a time. Rate your impression of each on six questions from 1 to 7. Higher numbers mean a stronger feeling.</p></div>','Begin',function(){ans.seenRate=true;save('a',ans);next();});\n  }\n  function rate(c,i){\n    var f=files[c.image];\n    var rows=ITEMS.map(function(it){return '<div class=\"it\" data-k=\"'+it.key+'\"><div class=\"x\">'+esc(it.question)+'</div><div class=\"sc\" role=\"radiogroup\" aria-label=\"'+esc(it.text)+'\">'+[1,2,3,4,5,6,7].map(function(v){return '<label><input type=\"radio\" name=\"'+it.key+'\" value=\"'+v+'\">'+v+'</label>';}).join('')+'</div><div class=\"ends\"><span>1 = very low</span><span>7 = very high</span></div></div>';}).join('');\n    page(bar(i,RORDER.length,'Living room')+'<div class=\"card\"><div class=\"pic\"><img alt=\"Rendering of a living room\" src=\"'+esc(f.url)+'\"></div>'+rows+'</div>','Next',function(){\n      var v={},miss=[];\n      ITEMS.forEach(function(it){var x=app.querySelector('input[name=\"'+it.key+'\"]:checked');var r=app.querySelector('.it[data-k=\"'+it.key+'\"]');if(x){v[it.key]=Number(x.value);r.classList.remove('miss');}else{miss.push(r);r.classList.add('miss');}});\n      if(miss.length){err(miss.length+' question'+(miss.length>1?'s are':' is')+' not answered yet (marked in red).');miss[0].scrollIntoView({block:'center'});return;}\n      send([SPSite.answer('impression',v,{key:c.id,shown:[f.name]})],this,function(){rdone[c.id]=true;next();});});\n    app.onchange=function(e){hideErr();var r=e.target.closest&&e.target.closest('.it');if(r)r.classList.remove('miss');};\n  }\n  function openq(){\n    page('<h1>One last question</h1><p>Optional.</p><div class=\"card\"><div class=\"q\" style=\"margin-top:0\"><b>'+esc(q('preferred_elements').title)+'</b><textarea id=\"pe\"></textarea></div></div>','Finish',function(){\n      var a=document.getElementById('pe').value.trim(),l=[];if(a)l.push(SPSite.answer('preferred_elements',a));\n      send(l,this,function(){ans.open=true;save('a',ans);next();});});\n  }\n  function finish(){\n    clear();\n    app.innerHTML='<div class=\"narrow\"><h1>Thank you!</h1><div class=\"card\"><p>In the original laboratory study, 30 adults aged 60 to 79 in Nanjing compared these six living rooms. Neutral white light (4000 K) was chosen more often than warm white light (2700 K) and scored higher on naturalness, interest, desire to use and overall comfort, while warm light scored higher on warmth and relaxation. The 4000 K low-gloss room was chosen most often (62%); the 2700 K high-gloss room least often (37%).</p><p style=\"font-size:.82rem\">Renderings and method: Yu, N., Fan, Y., &amp; Zhu, Y. (2026). Effects of Correlated Color Temperature and Wood Surface Gloss on Visual Comfort in Older Adults in Residential Interiors. Buildings 16:2956, doi:10.3390/buildings16152956.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')ans.intro=false;else if(x==='pair_choice')pdone={};else if(x==='impression')rdone={};else ans.about=false;});save('a',ans);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    var SPEC;try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='pair_choice'){CONDS=e.conditions;PAIRS=e.pairs;}if(e.name==='impression')ITEMS=e.items;});});\n    (SPSite.getMedia('rooms')||[]).forEach(function(f){files[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};ans=load('a')||{};\n    PORDER=load('p');if(!PORDER||PORDER.length!==PAIRS.length){PORDER=shuffle(PAIRS).map(function(p){return Math.random()<.5?[p[1],p[0]]:[p[0],p[1]];});save('p',PORDER);}\n    RORDER=load('r');if(!RORDER||RORDER.length!==CONDS.length){RORDER=shuffle(CONDS.map(function(c){return c.id;}));save('r',RORDER);}\n    var keyOf={};PORDER.forEach(function(p){keyOf[[p[0],p[1]].sort(function(x,y){return idx(x)-idx(y);}).join('-')]=pkey(p);});\n    ((a.pair_choice&&a.pair_choice.trials)||[]).forEach(function(t){if(t.key&&keyOf[t.key])pdone[keyOf[t.key]]=true;});\n    ((a.impression&&a.impression.trials)||[]).forEach(function(t){if(t.key)rdone[t.key]=true;});\n    ans.intro=a.consent===true;ans.about=a.sex!=null&&a.education!=null;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
