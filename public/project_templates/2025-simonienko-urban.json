   "id": "site-0deb54aa9c7aad6a",
   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Urban Flower Meadows</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Urban Flower Meadows: Emotional Reception\",\n  \"description\": \"Participants see eleven photographs in random order (nine urban flower meadows, a sunflower planting and a short-cut lawn) and rate each on seven positive-negative semantic differential pairs on a 10-point scale, then give place of origin, current place of residence, age and gender. Rebuilt from Simonienko et al. (2025), Scientific Reports 15: 31981, with the photographs printed in the paper's Figure 1 (CC BY 4.0). Analyses in the paper: PCA of the seven pairs into one emotion gradient, mixed model with respondent as random effect, and origin x residence (rural vs city) interaction.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"meadows\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"photos\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"joyful_sad\",\n      \"title\": \"Joyful - Sad\",\n      \"rateMin\": 1,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Joyful\",\n      \"maxRateDescription\": \"Sad\",\n      \"isRequired\": true,\n      \"description\": \"Semantic differential pair. Keyed by photo (meadow01-meadow09 = urban flower meadows, sunflowers10 = sunflower planting, lawn11 = short-cut lawn; numbers as in the paper's Figure 1). 1 = closest to the positive word, 10 = closest to the negative word.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"calm_disturbing\",\n      \"title\": \"Calm - Disturbing\",\n      \"rateMin\": 1,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Calm\",\n      \"maxRateDescription\": \"Disturbing\",\n      \"isRequired\": true,\n      \"description\": \"Semantic differential pair. Keyed by photo (meadow01-meadow09 = urban flower meadows, sunflowers10 = sunflower planting, lawn11 = short-cut lawn; numbers as in the paper's Figure 1). 1 = closest to the positive word, 10 = closest to the negative word.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"safe_dangerous\",\n      \"title\": \"Safe - Dangerous\",\n      \"rateMin\": 1,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Safe\",\n      \"maxRateDescription\": \"Dangerous\",\n      \"isRequired\": true,\n      \"description\": \"Semantic differential pair. Keyed by photo (meadow01-meadow09 = urban flower meadows, sunflowers10 = sunflower planting, lawn11 = short-cut lawn; numbers as in the paper's Figure 1). 1 = closest to the positive word, 10 = closest to the negative word.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"interesting_boring\",\n      \"title\": \"Interesting - Boring\",\n      \"rateMin\": 1,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Interesting\",\n      \"maxRateDescription\": \"Boring\",\n      \"isRequired\": true,\n      \"description\": \"Semantic differential pair. Keyed by photo (meadow01-meadow09 = urban flower meadows, sunflowers10 = sunflower planting, lawn11 = short-cut lawn; numbers as in the paper's Figure 1). 1 = closest to the positive word, 10 = closest to the negative word.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"refreshing_tiring\",\n      \"title\": \"Refreshing - Tiring\",\n      \"rateMin\": 1,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Refreshing\",\n      \"maxRateDescription\": \"Tiring\",\n      \"isRequired\": true,\n      \"description\": \"Semantic differential pair. Keyed by photo (meadow01-meadow09 = urban flower meadows, sunflowers10 = sunflower planting, lawn11 = short-cut lawn; numbers as in the paper's Figure 1). 1 = closest to the positive word, 10 = closest to the negative word.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"comfortable_uncomfortable\",\n      \"title\": \"Comfortable - Uncomfortable\",\n      \"rateMin\": 1,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Comfortable\",\n      \"maxRateDescription\": \"Uncomfortable\",\n      \"isRequired\": true,\n      \"description\": \"Semantic differential pair. Keyed by photo (meadow01-meadow09 = urban flower meadows, sunflowers10 = sunflower planting, lawn11 = short-cut lawn; numbers as in the paper's Figure 1). 1 = closest to the positive word, 10 = closest to the negative word.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"natural_artificial\",\n      \"title\": \"Natural - Artificial\",\n      \"rateMin\": 1,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Natural\",\n      \"maxRateDescription\": \"Artificial\",\n      \"isRequired\": true,\n      \"description\": \"Semantic differential pair. Keyed by photo (meadow01-meadow09 = urban flower meadows, sunflowers10 = sunflower planting, lawn11 = short-cut lawn; numbers as in the paper's Figure 1). 1 = closest to the positive word, 10 = closest to the negative word.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"origin\",\n      \"title\": \"Where do you come from (place of origin)?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"village_small_town\",\n        \"text\": \"Village or town of 1,000-5,000 inhabitants\"\n       },\n       {\n        \"value\": \"town_5k_50k\",\n        \"text\": \"City of 5,000-50,000 inhabitants\"\n       },\n       {\n        \"value\": \"city_50k_250k\",\n        \"text\": \"City of 50,000-250,000 inhabitants\"\n       },\n       {\n        \"value\": \"city_over_250k\",\n        \"text\": \"City of more than 250,000 inhabitants\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"residence\",\n      \"title\": \"Where do you live now?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"village_small_town\",\n        \"text\": \"Village or town of 1,000-5,000 inhabitants\"\n       },\n       {\n        \"value\": \"town_5k_50k\",\n        \"text\": \"City of 5,000-50,000 inhabitants\"\n       },\n       {\n        \"value\": \"city_50k_250k\",\n        \"text\": \"City of 50,000-250,000 inhabitants\"\n       },\n       {\n        \"value\": \"city_over_250k\",\n        \"text\": \"City of more than 250,000 inhabitants\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"meadows-original\">{\"source\": \"Simonienko, Jermakowicz, Szefer, Wrobel, Suprunowicz, Cwalina & Kostro-Ambroziak (2025) Scientific Reports 15: 31981\", \"n\": 189, \"participants\": \"internet respondents from different places in Poland\", \"site\": \"urban flower meadows in Bialystok, 2021\", \"result\": \"All meadows were received positively; the first PCA axis explained about 67% of the variation. More yellow flowers and more flower colours shifted ratings towards the positive words, a higher share of green and absence of alien species towards the negative ones (many colours also shifted calm towards disturbing). City dwellers perceived the meadows more positively than rural residents.\"}</script>\n<style>\n:root{--bg:#f5f5ef;--card:#fff;--ink:#22241d;--muted:#62665a;--accent:#5a6e1f;--line:#dcdfd3;--warn:#b3261e;--sel:#eef2dc}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.photo{width:100%;max-width:360px;border-radius:8px;display:block;margin:0 auto 12px}\n.sd{padding:10px 0;border-top:1px solid var(--line)}.sd:first-of-type{border-top:0}\n.ends{display:flex;justify-content:space-between;font-weight:600;font-size:.95rem;margin-bottom:4px}\n.row{display:grid;grid-template-columns:repeat(10,1fr);gap:3px}\n.row label{display:flex;flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:8px;padding:6px 0;cursor:pointer;font-size:.75rem;color:var(--muted)}\n.row label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.row input{margin:0 0 2px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:760px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Simonienko, Jermakowicz, Szefer, Wróbel, Suprunowicz, Cwalina &amp; Kostro-Ambroziak (2025), Scientific Reports 15: 31981, Figure 1 (doi:10.1038/s41598-025-16420-8, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='flower-meadows:state';\n  var app=document.getElementById('app'), Q={}, files={}, ids=[], st=null;\n  var SD=[['joyful_sad','Joyful','Sad'],['calm_disturbing','Calm','Disturbing'],['safe_dangerous','Safe','Dangerous'],['interesting_boring','Interesting','Boring'],['refreshing_tiring','Refreshing','Tiring'],['comfortable_uncomfortable','Comfortable','Uncomfortable'],['natural_artificial','Natural','Artificial']];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function sdRow(p){var h='<div class=\"sd\"><div class=\"ends\"><span>'+p[1]+'</span><span>'+p[2]+'</span></div><div class=\"row\">';for(var i=1;i<=10;i++)h+='<label><input type=\"radio\" name=\"q_'+p[0]+'\" value=\"'+i+'\">'+i+'</label>';return h+'</div></div>';}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function intro(){\n    app.innerHTML='<h1>Urban flower meadows</h1><p>You will see '+st.order.length+' photographs of green spaces in a city, one at a time. For each photo, mark where your feeling lies between two opposite words, from 1 (closest to the left word) to 10 (closest to the right word). It takes about 6 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='trial';st.k=0;save();route();});};\n  }\n  function trial(){\n    var id=st.order[st.k];\n    app.innerHTML='<div class=\"prog\">Photo '+(st.k+1)+' of '+st.order.length+'</div><div class=\"card\"><img class=\"photo\" alt=\"Green space photograph\" src=\"'+esc(files[id].url)+'\"><p style=\"color:var(--ink)\">How does this place make you feel?</p>'+SD.map(sdRow).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var vals=SD.map(function(p){return val('q_'+p[0]);});if(vals.some(function(x){return x==null;}))return err('Please answer all seven pairs.');\n      var sh=[files[id].name];\n      send(SD.map(function(p,i){return SPSite.answer(p[0],Number(vals[i]),{key:id,shown:sh});}),this,function(){st.k++;if(st.k>=st.order.length)st.step='about';save();route();});\n    };\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+radios('origin')+radios('residence')+'<div class=\"f\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"110\"></div>'+radios('gender')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var o=val('origin'),r=val('residence'),g=val('gender'),age=Number(document.getElementById('age').value);\n      if(!o||!r||!g)return err('Please answer every question.');if(!(age>=18&&age<=110))return err('Please enter your age.');\n      send([SPSite.answer('origin',o),SPSite.answer('residence',r),SPSite.answer('age',age),SPSite.answer('gender',g)],this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='trial')return trial();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','origin','residence','age','gender'].concat(SD.map(function(p){return p[0];})).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('meadows')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name)){var k=f.name.replace(/\\.[^.]+$/,'');files[k]=f;ids.push(k);}});\n    if(ids.length<2){app.innerHTML='<h1>Photos missing</h1><p>Upload the photographs to the media folder \"meadows\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var valid=st&&st.order&&st.order.length===ids.length&&st.order.every(function(x){return files[x];});\n    if(!valid)st={step:'intro',order:shuffle(ids),k:0};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
