   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Soil and Water Conservation Scenic Beauty</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Scenic Beauty of Soil and Water Conservation Works (SBE)\",\n  \"description\": \"Faithful replication of Peng & Han (2018), Water 10:407: 16 photographs of soil and water conservation structures in Taiwan (check dams, ground sills, revetments, detention ponds, grassed waterway), shown first as a 3-second quick look and then rated one at a time from 0 (extremely dislike) to 9 (extremely like) for scenic beauty plus five further questions (integration with nature, waterscape, visual richness, structure shape, perceived safety); analysed with the Scenic Beauty Estimation (SBE) method.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"structures\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"about\",\n    \"title\": \"Scenic beauty of soil and water conservation works\",\n    \"intro\": \"In this survey you will see 16 pictures of structures built in streams and on slopes to control erosion and sediment, such as check dams, ground sills, revetments, detention ponds and grassed waterways. Please judge each picture by your own preference and first impression; do not think too long and do not judge the photography. It takes about 10 minutes and your answers are anonymous. First, a few questions about you.\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"Consent\",\n      \"label\": \"I agree to take part in this survey and that my answers are used for research.\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Female\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Under 20\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"20–29\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"30–39\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"40–49\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"50 or older\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"occupation\",\n      \"title\": \"Occupation\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Student\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Engineering or construction\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Government or public sector\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Education or research\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"Business or services\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"Other\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"studied_lessons\",\n      \"title\": \"Have you taken courses related to soil and water conservation, civil or hydraulic engineering, or landscape design?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"No\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"understand_function\",\n      \"title\": \"How well do you understand what structures like these (check dams, ground sills, revetments) are for?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Not at all\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"A little\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Fairly well\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Very well\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"pictures\",\n    \"title\": \"Pictures\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"kind\": \"image_rating\",\n      \"name\": \"scenic_beauty\",\n      \"isRequired\": true,\n      \"title\": \"Rate this picture on each question from 0 to 9.\",\n      \"items\": [\n       {\n        \"name\": \"q1_aesthetics\",\n        \"text\": \"1. Picture aesthetics: how beautiful is the scenery in this picture?\",\n        \"low\": \"extremely dislike\",\n        \"high\": \"extremely like\"\n       },\n       {\n        \"name\": \"q2_integration\",\n        \"text\": \"2. How well does the structure blend in with the natural environment around it?\",\n        \"low\": \"not at all\",\n        \"high\": \"completely\"\n       },\n       {\n        \"name\": \"q3_waterscape\",\n        \"text\": \"3. How much do you like the water (the flowing waterscape) in this picture?\",\n        \"low\": \"extremely dislike\",\n        \"high\": \"extremely like\"\n       },\n       {\n        \"name\": \"q4_richness\",\n        \"text\": \"4. Visual richness: how rich are the colours and the surrounding landscape?\",\n        \"low\": \"very poor\",\n        \"high\": \"very rich\"\n       },\n       {\n        \"name\": \"q5_shape\",\n        \"text\": \"5. How much do you like the shape of the structure?\",\n        \"low\": \"extremely dislike\",\n        \"high\": \"extremely like\"\n       },\n       {\n        \"name\": \"q6_safety\",\n        \"text\": \"6. How safe does the structure feel to you (just your impression)?\",\n        \"low\": \"very unsafe\",\n        \"high\": \"very safe\"\n       }\n      ],\n      \"meta\": {\n       \"img01\": {\n        \"structure\": \"check dam\",\n        \"rank\": 9\n       },\n       \"img12\": {\n        \"structure\": \"check dam\",\n        \"rank\": 6\n       },\n       \"img13\": {\n        \"structure\": \"check dam\",\n        \"rank\": 16\n       },\n       \"img15\": {\n        \"structure\": \"check dam\",\n        \"rank\": 4\n       },\n       \"img16\": {\n        \"structure\": \"check dam\",\n        \"rank\": 12\n       },\n       \"img03\": {\n        \"structure\": \"ground sill\",\n        \"rank\": 5\n       },\n       \"img09\": {\n        \"structure\": \"ground sill\",\n        \"rank\": 13\n       },\n       \"img10\": {\n        \"structure\": \"ground sill\",\n        \"rank\": 7\n       },\n       \"img14\": {\n        \"structure\": \"ground sill\",\n        \"rank\": 2\n       },\n       \"img02\": {\n        \"structure\": \"revetment\",\n        \"rank\": 10\n       },\n       \"img08\": {\n        \"structure\": \"revetment\",\n        \"rank\": 15\n       },\n       \"img11\": {\n        \"structure\": \"revetment\",\n        \"rank\": 3\n       },\n       \"img04\": {\n        \"structure\": \"detention pond\",\n        \"rank\": 14\n       },\n       \"img06\": {\n        \"structure\": \"detention pond\",\n        \"rank\": 1\n       },\n       \"img07\": {\n        \"structure\": \"detention pond\",\n        \"rank\": 8\n       },\n       \"img05\": {\n        \"structure\": \"grassed waterway\",\n        \"rank\": 11\n       }\n      },\n      \"description\": \"16 pictures (paper Table 4), first shown 3 s each as a quick look, then each on its own page in random order with six 0–9 questions. One trial per picture (key = file name img01..img16), values q1_aesthetics (scenic beauty, 0 = extremely dislike, 9 = extremely like), q2_integration, q3_waterscape, q4_richness, q5_shape, q6_safety, picture, structure (check dam / ground sill / revetment / detention pond / grassed waterway), paper_rank (SBE rank in the paper, 1 = highest) and position. Analysis in the paper: Scenic Beauty Estimation (Daniel & Boster 1976, RMRATE): each rater's 0–9 scores converted to z-scores, mean z per picture, minus the mean of all 16 pictures (baseline SBE = 0), times 100; compare SBE by structure type and between groups (paired t-test, students vs online); same for questions 2–6.\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#eef2ec;--card:#fff;--ink:#1c231d;--muted:#56614f;--accent:#2f6b3a;--line:#d2dccd;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:20px}.q:first-child{margin-top:0}.q>b{display:block;margin-bottom:6px}.q.miss>b{color:var(--warn)}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\ninput[type=text],input[type=number],textarea{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:100%}\ninput[type=number]{max-width:160px}textarea{min-height:70px;resize:vertical}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.t{color:var(--muted);font-size:.9rem}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.stim{display:block;width:100%;max-width:560px;margin:0 auto;border-radius:8px}\n.it{padding:10px 0;border-top:1px solid var(--line)}.it:first-child{border-top:0}.it.miss>.lab{color:var(--warn)}\n.lab{margin-bottom:4px}\n.ends{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-top:3px;max-width:520px}\n.seg{display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:3px;max-width:520px}\n.seg label{display:block;cursor:pointer;position:relative}\n.seg input{position:absolute;opacity:0;pointer-events:none}\n.seg span{display:flex;align-items:center;justify-content:center;min-height:40px;border:1px solid var(--line);border-radius:8px;font-size:.9rem}\n.seg input:checked+span{background:var(--accent);border-color:var(--accent);color:#fff}\n.seg input:focus-visible+span{outline:2px solid var(--accent);outline-offset:2px}\n.kw{display:flex;flex-wrap:wrap;gap:6px}.kw label.opt{margin-top:0}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:760px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Pictures: the 16 photographs of soil and water conservation structures printed in Peng &amp; Han (2018), Water 10:407, Table 4, doi:10.3390/w10040407 (CC BY 4.0; Taiwan, photographed by the authors). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='sbe2018:';\n  var app=document.getElementById('app'),SPEC,Q={},files={},done={},ORDER=[],META={},IMG,ITEMS=[],PRE=[];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function shuffle(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function seven(name){var h='<div class=\"seg\" style=\"--n:10\" role=\"radiogroup\">';for(var v=0;v<=9;v++)h+='<label><input type=\"radio\" name=\"'+name+'\" value=\"'+v+'\"><span>'+v+'</span></label>';return h+'</div>';}\n  function scaleItem(name,it){return '<div class=\"it\" data-n=\"'+name+'\"><div class=\"lab\">'+esc(it.text)+'</div>'+seven(name)+'<div class=\"ends\"><span>0 = '+esc(it.low)+'</span><span>9 = '+esc(it.high)+'</span></div></div>';}\n  function total(){return PRE.length+1+ORDER.length;}\n  function top(i){return '<div class=\"top\"><span class=\"t\">Page '+(i+1)+' of '+total()+'</span><div class=\"bar\"><i style=\"width:'+(100*i/total())+'%\"></i></div></div>';}\n  function next(){window.scrollTo(0,0);\n    for(var k=0;k<PRE.length;k++)if(!done['p_'+PRE[k].name])return intro(k);\n    if(!done.preview)return preview();\n    for(var i=0;i<ORDER.length;i++)if(!done['i_'+ORDER[i]])return image(i);\n    finish();}\n  function field(e){\n    var h='<div class=\"q\" data-q=\"'+e.name+'\"><b>'+esc(Q[e.name].title)+'</b>';\n    if(e.type==='boolean')h+='<label class=\"opt\"><input type=\"checkbox\" name=\"'+e.name+'\" value=\"1\"> '+esc(e.label)+'</label>';\n    else if(e.type==='radiogroup')h+=Q[e.name].choices.map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+e.name+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');\n    else if(e.type==='text')h+='<input type=\"'+(e.inputType==='number'?'number':'text')+'\" name=\"'+e.name+'\"'+(e.inputType==='number'?' min=\"'+e.min+'\" max=\"'+e.max+'\" inputmode=\"numeric\"':' maxlength=\"80\"')+'>';\n    else if(e.kind==='scales')h+=e.items.map(function(it){return scaleItem(e.name+'__'+it.name,it);}).join('');\n    return h+'</div>';\n  }\n  function readField(e){\n    if(e.type==='boolean')return app.querySelector('input[name=\"'+e.name+'\"]').checked?true:undefined;\n    if(e.type==='radiogroup'){var x=app.querySelector('input[name=\"'+e.name+'\"]:checked');return x?Number(x.value):undefined;}\n    if(e.type==='text'){var t=app.querySelector('[name=\"'+e.name+'\"]').value.trim();if(e.inputType==='number'){var n=Number(t);return (t!==''&&n>=e.min&&n<=e.max&&Math.round(n)===n)?n:undefined;}return t||undefined;}\n    if(e.kind==='scales'){var v={},miss=0;e.items.forEach(function(it){var x=app.querySelector('input[name=\"'+e.name+'__'+it.name+'\"]:checked');if(x)v[it.name]=Number(x.value);else{miss++;app.querySelector('.it[data-n=\"'+e.name+'__'+it.name+'\"]').classList.add('miss');}});return miss?undefined:v;}\n  }\n  function intro(k){\n    var P=PRE[k],INTRO=P.elements;\n    app.innerHTML=top(k)+'<h1>'+esc(P.title)+'</h1><div class=\"card\">'+(P.intro?'<p style=\"color:var(--ink)\">'+esc(P.intro)+'</p>':'')+INTRO.map(field).join('')+'</div><div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div>';\n    app.onchange=function(ev){hideErr();var q=ev.target.closest('.q');if(q)q.classList.remove('miss');var it=ev.target.closest('.it');if(it)it.classList.remove('miss');};\n    document.getElementById('go').onclick=function(){\n      var l=[],bad=null;\n      INTRO.forEach(function(e){var v=readField(e);if(v===undefined){bad=bad||e;app.querySelector('.q[data-q=\"'+e.name+'\"]').classList.add('miss');}else l.push([e.name,v]);});\n      if(bad){err(bad.name==='consent'?'Please tick the box to agree before you start.':bad.inputType==='number'?'Please enter your age as a whole number from '+bad.min+' to '+bad.max+'.':bad.kind?'Please answer every row of: '+Q[bad.name].title:'Please answer: '+Q[bad.name].title);var m=app.querySelector('.q.miss');if(m)m.scrollIntoView({block:'center'});return;}\n      var b=this;b.disabled=true;\n      Promise.all(l.map(function(a){return SPSite.answer(a[0],a[1]);})).then(function(rs){var x=rs.filter(function(r){return !ok(r);})[0];if(x){b.disabled=false;return err(x.error);}done['p_'+P.name]=true;save('d',done);next();});\n    };\n  }\n  function preview(){\n    app.innerHTML=top(PRE.length)+'<h1>Quick look at all pictures</h1><div class=\"card\"><p style=\"color:var(--ink)\">First you will see all '+ORDER.length+' pictures, 3 seconds each, so you get a feel for the range. You do not need to answer anything yet.</p><div id=\"pv\"></div><p id=\"pvn\" style=\"text-align:center\"></p></div><div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">Start the quick look</button></div><div class=\"err\"></div>';\n    ORDER.forEach(function(f){var im=new Image();im.src=files[f].url;});\n    document.getElementById('go').onclick=function(){var b=this;b.disabled=true;var k=0,pv=document.getElementById('pv'),n=document.getElementById('pvn');\n      (function step(){if(k>=ORDER.length){done.preview=true;save('d',done);return next();}\n        pv.innerHTML='<img class=\"stim\" alt=\"Picture '+(k+1)+'\" src=\"'+esc(files[ORDER[k]].url)+'\">';n.textContent=(k+1)+' / '+ORDER.length;k++;setTimeout(step,window.SBE_FAST?20:3000);})();};\n  }\n  function image(i){\n    var f=ORDER[i];\n    app.innerHTML=top(PRE.length+1+i)+'<div class=\"card\"><img class=\"stim\" alt=\"Image '+(i+1)+' of '+ORDER.length+'\" src=\"'+esc(files[f].url)+'\"><p style=\"margin-top:12px;color:var(--ink)\">'+esc(Q.scenic_beauty.title)+'</p>'+ITEMS.map(function(it){return scaleItem('s__'+it.name,it);}).join('')+'</div>'+\n      '<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+(i===ORDER.length-1?'Finish':'Next')+'</button></div><div class=\"err\"></div>';\n    app.onchange=function(ev){hideErr();var it=ev.target.closest('.it');if(it)it.classList.remove('miss');var q=ev.target.closest('.q');if(q)q.classList.remove('miss');};\n    document.getElementById('go').onclick=function(){\n      var v={},miss=null;\n      ITEMS.forEach(function(it){var x=app.querySelector('input[name=\"s__'+it.name+'\"]:checked');if(x)v[it.name]=Number(x.value);else{miss=miss||it;app.querySelector('.it[data-n=\"s__'+it.name+'\"]').classList.add('miss');}});\n      if(miss){err('Please answer every question for this picture.');var m=app.querySelector('.miss');if(m)m.scrollIntoView({block:'center'});return;}\n      var m=META[f.replace(/\\.jpg$/,'')]||{};v.picture=f.replace(/\\.jpg$/,'');v.structure=m.structure;v.paper_rank=m.rank;v.position=i+1;\n      var b=this;b.disabled=true;\n      SPSite.answer('scenic_beauty',v,{key:f.replace(/\\.jpg$/,''),shown:[f]}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}done['i_'+f]=true;save('d',done);next();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\\\"card\\\"><p>In the original study in Taiwan (April 2015), 51 university students in a classroom and 105 online respondents rated these 16 pictures. Scenic beauty (SBE) was highest for an ecological detention pond, a ground sill with flowing water and an ecological revetment, and lowest for a large concrete check dam, a bare concrete revetment and a dry detention pond. Flowing water and vegetation covering the structure raised scenic beauty; students and online respondents agreed closely.</p><p style=\\\"font-size:.82rem\\\">Peng, S.-H., &amp; Han, K.-T. (2018). Assessment of Aesthetic Quality on Soil and Water Conservation Engineering Using the Scenic Beauty Estimation Method. Water 10:407, doi:10.3390/w10040407.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='scenic_beauty')ORDER.forEach(function(f){done['i_'+f]=false;});else PRE.forEach(function(p){if(p.elements.some(function(e){return e.name===x;}))done['p_'+p.name]=false;});});save('d',done);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='scenic_beauty'){IMG=e;ITEMS=e.items;META=e.meta||{};}});});\n    PRE=SPEC.pages.filter(function(p){return p.name!=='pictures';});\n    (SPSite.getMedia('structures')||[]).forEach(function(f){files[f.name]=f;});\n    if(Object.keys(files).length<16){app.innerHTML='<h1>Pictures missing</h1><p>Media folder structures must hold the 16 pictures.</p>';return;}\n    var a=(ctx&&ctx.answers)||{};done=load('d')||{};\n    ORDER=load('order');\n    if(!ORDER||ORDER.length!==Object.keys(files).length||ORDER.some(function(f){return !files[f];})){ORDER=shuffle(Object.keys(files));save('order',ORDER);}\n    PRE.forEach(function(p){done['p_'+p.name]=p.elements.every(function(e){return a[e.name]!=null;});});\n    ORDER.forEach(function(f){done['i_'+f]=false;});done.preview=!!(load('d')||{}).preview||!!(a.scenic_beauty&&a.scenic_beauty.trials&&a.scenic_beauty.trials.length);\n    ((a.scenic_beauty&&a.scenic_beauty.trials)||[]).forEach(function(t){if(t.key)done['i_'+t.key+'.jpg']=true;});\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
