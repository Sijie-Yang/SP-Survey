   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Bathroom Cladding and Well-Being</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"How do these bathrooms make you feel?\",\n  \"description\": \"Faithful replication of the online experiment of Nolé, Pagan, Montañana & Llinares (2026), Influence of Bathroom Cladding Materials on Users' Perceived Well-Being, Architecture 6(2):52. Five renderings of the same bathroom that differ only in cladding (ceramic, wood, vinyl, natural stone, microcement) are shown one per page with their material label. For each, participants rate six statements on a 7-point agreement scale coded -3 (strongly disagree) to +3 (strongly agree) — 'Overall, this bathroom Generates well-being / Generates stress / is functional / I like it / Is expensive or high-priced / I would choose it for my home' — and emotional valence on a 9-point Self-Assessment Manikin-style scale (1 = very unpleasant, 9 = very pleasant). Sociodemographic questions follow. Answers are keyed by material.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"bathrooms\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I have read the information above and agree to take part. Participation is voluntary and anonymous, and I can stop at any time.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"bathrooms\",\n    \"elements\": [\n     {\n      \"type\": \"matrix\",\n      \"name\": \"perception\",\n      \"title\": \"Overall, this bathroom:\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"wellbeing\",\n        \"text\": \"Generates well-being\"\n       },\n       {\n        \"value\": \"stress\",\n        \"text\": \"Generates stress\"\n       },\n       {\n        \"value\": \"functional\",\n        \"text\": \"Is functional\"\n       },\n       {\n        \"value\": \"like\",\n        \"text\": \"I like it\"\n       },\n       {\n        \"value\": \"expensive\",\n        \"text\": \"Is expensive or high-priced\"\n       },\n       {\n        \"value\": \"choose\",\n        \"text\": \"I would choose it for my home\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": -3,\n        \"text\": \"Strongly disagree\"\n       },\n       {\n        \"value\": -2,\n        \"text\": \"Disagree\"\n       },\n       {\n        \"value\": -1,\n        \"text\": \"Somewhat disagree\"\n       },\n       {\n        \"value\": 0,\n        \"text\": \"Neither agree nor disagree\"\n       },\n       {\n        \"value\": 1,\n        \"text\": \"Somewhat agree\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Agree\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Strongly agree\"\n       }\n      ],\n      \"description\": \"Keyed by material (ceramic, wood, vinyl, natural_stone, microcement); -3 = strongly disagree, +3 = strongly agree.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"valence\",\n      \"title\": \"How does this bathroom make you feel?\",\n      \"isRequired\": true,\n      \"rateValues\": [\n       {\n        \"value\": 1,\n        \"text\": \"Very unpleasant\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"6\"\n       },\n       {\n        \"value\": 7,\n        \"text\": \"7\"\n       },\n       {\n        \"value\": 8,\n        \"text\": \"8\"\n       },\n       {\n        \"value\": 9,\n        \"text\": \"Very pleasant\"\n       }\n      ],\n      \"description\": \"Emotional valence, keyed by material, 1-9.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"name\": \"age\",\n      \"title\": \"Age (years)\",\n      \"inputType\": \"number\",\n      \"min\": 18,\n      \"max\": 100,\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other\"\n       },\n       {\n        \"value\": \"no_answer\",\n        \"text\": \"Prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"country_of_birth\",\n      \"title\": \"Country of birth\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"residence\",\n      \"title\": \"Where do you live?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"urban\",\n        \"text\": \"Urban area\"\n       },\n       {\n        \"value\": \"rural\",\n        \"text\": \"Rural area\"\n       },\n       {\n        \"value\": \"coastal\",\n        \"text\": \"Coastal area\"\n       },\n       {\n        \"value\": \"inland\",\n        \"text\": \"Inland area\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"household_size\",\n      \"title\": \"How many people live in your household (including you)?\",\n      \"inputType\": \"number\",\n      \"min\": 1,\n      \"max\": 20,\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"dependents\",\n      \"title\": \"How many dependents do you have (children or other people in your care)?\",\n      \"inputType\": \"number\",\n      \"min\": 0,\n      \"max\": 20,\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"construction_sector\",\n      \"title\": \"Do you work in a profession related to the construction sector?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"bathroom_size\",\n      \"title\": \"Approximate size of your bathroom at home (m²)\",\n      \"inputType\": \"number\",\n      \"min\": 1,\n      \"max\": 100,\n      \"isRequired\": true\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"results-table\">{\"source\":\"Nolé et al. (2026) Architecture 6:52, Table 1: median (mean rank) of -3..+3 ratings and valence, N=58\",\"rows\":{\"functional\":{\"microcement\":\"2 (2.58)\",\"natural_stone\":\"2.5 (2.92)\",\"ceramic\":\"2 (3.14)\",\"wood\":\"3 (3.35)\",\"vinyl\":\"2 (3.01)\"},\"expensive\":{\"microcement\":\"0 (2.15)\",\"natural_stone\":\"1 (3.53)\",\"ceramic\":\"0 (3.08)\",\"wood\":\"1 (3.45)\",\"vinyl\":\"0 (2.79)\"},\"like\":{\"microcement\":\"0 (1.96)\",\"natural_stone\":\"2 (3.44)\",\"ceramic\":\"1 (2.93)\",\"wood\":\"2 (3.49)\",\"vinyl\":\"1.5 (3.18)\"},\"wellbeing\":{\"microcement\":\"0 (2.17)\",\"natural_stone\":\"1.5 (3.53)\",\"ceramic\":\"0.5 (2.81)\",\"wood\":\"1 (3.47)\",\"vinyl\":\"0.5 (3.02)\"},\"stress\":{\"microcement\":\"0 (3.88)\",\"natural_stone\":\"-2 (2.87)\",\"ceramic\":\"-2 (2.89)\",\"wood\":\"-3 (2.48)\",\"vinyl\":\"-2.5 (2.88)\"},\"valence\":{\"microcement\":\"5 (2.41)\",\"natural_stone\":\"7 (3.51)\",\"ceramic\":\"6 (2.6)\",\"wood\":\"6 (3.27)\",\"vinyl\":\"6 (3.22)\"}}}</script>\n<style>\n:root{--bg:#f3f2ee;--card:#fff;--ink:#1d1f1c;--muted:#5d6159;--accent:#3d6b4f;--line:#d9dad2;--warn:#b3261e;--sel:#e0ece4}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1100px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.grid{display:grid;grid-template-columns:1fr;gap:14px;margin-top:14px}\n.b{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px}\n.b img{width:100%;height:auto;display:block;border-radius:8px}\n.b .no{font-weight:700;margin:6px 0 4px}\n.o{display:grid;grid-template-columns:repeat(5,1fr);gap:3px}.anch{display:flex;justify-content:space-between;font-size:.75rem;color:var(--muted);margin-top:3px}\ninput.txt{font:inherit;width:100%;max-width:360px;padding:9px 11px;border:1px solid var(--line);border-radius:10px;margin-top:6px}\n.o label{display:flex;flex-direction:column;align-items:center;gap:2px;border:1px solid var(--line);border-radius:8px;padding:9px 1px;cursor:pointer;font-size:.68rem;line-height:1.15;text-align:center;color:var(--muted)}\n.o label b{font-size:.95rem;color:var(--ink)}\n.o label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.o input{display:none}\n.b.miss{outline:2px solid var(--warn);outline-offset:2px}\n.blk{margin-top:14px}.blk:first-child{margin-top:0}\n.blk.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.err{color:var(--warn);margin-top:8px;min-height:1.5em;line-height:1.5}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:700px){.b{padding:8px}.o{gap:2px}.o label b{font-size:.88rem}}\n\n.o label{font-size:.66rem;padding:8px 1px}\n\n.prog{font-size:.9rem;color:var(--muted);margin-top:6px}\n@media (max-width:700px){.grid{grid-template-columns:1fr}}\n.lay{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:20px;align-items:start}\n.pic{position:sticky;top:10px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px}\n.pic img{width:100%;height:auto;display:block;border-radius:8px;max-height:calc(100vh - 110px);object-fit:contain}\n.pic .no{font-weight:700;margin-bottom:6px}.pic .cap{margin-top:6px;font-weight:600}\n.qs h2{margin-top:2px}.it{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px 12px}\n.o7,.o9{display:grid;gap:3px;margin-top:8px}.o7{grid-template-columns:repeat(7,1fr)}.o9{grid-template-columns:repeat(9,1fr)}\n.o7 label,.o9 label{display:flex;justify-content:center;border:1px solid var(--line);border-radius:8px;padding:10px 0;cursor:pointer}\n.o7 label:has(input:checked),.o9 label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.o7 input,.o9 input{display:none}\n@media (max-width:800px){.lay{grid-template-columns:1fr}.pic{position:sticky;top:0;z-index:2;padding:6px}.pic img{max-height:34vh}.pic .no,.pic .cap{display:inline;font-size:.9rem;margin:0 8px 0 0}.o9 label,.o7 label{padding:10px 0;font-size:.85rem}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Bathroom renderings and questionnaire: Nolé, Pagan, Montañana &amp; Llinares (2026), Influence of Bathroom Cladding Materials on Users' Perceived Well-Being, Architecture 6(2):52 (doi:10.3390/architecture6020052, CC BY 4.0). Renderings cropped from Figure 2. Removed on request of the authors.</footer>\n<script>\n(function(){\n  var KEY='nole2026bath:state', MATS=[[\"ceramic\", \"Ceramic\"], [\"wood\", \"Wood\"], [\"vinyl\", \"Vinyl\"], [\"natural_stone\", \"Natural stone\"], [\"microcement\", \"Microcement\"]], ITEMS=[[\"wellbeing\", \"Generates well-being\"], [\"stress\", \"Generates stress\"], [\"functional\", \"Is functional\"], [\"like\", \"I like it\"], [\"expensive\", \"Is expensive or high-priced\"], [\"choose\", \"I would choose it for my home\"]], BG=['age','gender','country_of_birth','residence','household_size','dependents','construction_sector','bathroom_size'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='';}}\n  function hideErr(){var e=app.querySelector('.err');if(e&&!app.querySelector('.miss'))e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function intro(){\n    app.innerHTML='<h1>Bathrooms and well-being</h1><p>This study looks at how bathroom finishes affect how people feel. You will see five pictures of the same bathroom finished with different cladding materials, one per page. For each bathroom, say how much you agree with six short statements and how the bathroom makes you feel. At the end there are a few questions about you. It takes about 5 minutes. Your answers are anonymous and you can stop at any time.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='pics';st.order=shuffle(MATS.map(function(m){return m[0];}));st.p=0;save();route();});};\n  }\n  function label(k){for(var i=0;i<MATS.length;i++)if(MATS[i][0]===k)return MATS[i][1];return k;}\n  function pics(){\n    var k=st.order[st.p], cols=Q.perception.columns||[], rv=Q.valence.rateValues||[];\n    app.innerHTML='<div class=\"lay\"><div class=\"pic\"><div class=\"no\">Bathroom '+(st.p+1)+' of '+MATS.length+'</div><img alt=\"Rendering of a bathroom with '+esc(label(k))+' cladding\" src=\"'+esc(files[k].url)+'\"><div class=\"cap\">'+esc(label(k))+'</div></div><div class=\"qs\">'+\n      '<h2>'+esc(Q.perception.title)+'</h2>'+ITEMS.map(function(it){return '<div class=\"blk it\" data-n=\"'+it[0]+'\"><b>'+esc(it[1])+'</b><div class=\"o7\">'+cols.map(function(c){return '<label><input type=\"radio\" name=\"p_'+it[0]+'\" value=\"'+c.value+'\"><b>'+(Number(c.value)>0?'+':'')+c.value+'</b></label>';}).join('')+'</div><div class=\"anch\"><span>Strongly disagree</span><span>Strongly agree</span></div></div>';}).join('')+\n      '<div class=\"blk it\" data-n=\"__val\"><b>'+esc(Q.valence.title)+'</b><div class=\"o9\">'+rv.map(function(s){return '<label><input type=\"radio\" name=\"val\" value=\"'+s.value+'\"><b>'+s.value+'</b></label>';}).join('')+'</div><div class=\"anch\"><span>Very unpleasant</span><span>Very pleasant</span></div></div>'+\n      '<div class=\"card\"><button class=\"btn\" id=\"go\">Next</button><div class=\"err\"></div></div></div></div>';\n    document.getElementById('go').onclick=function(){\n      var miss=[],m={},v=null;\n      ITEMS.forEach(function(it){var x=app.querySelector('input[name=\"p_'+it[0]+'\"]:checked');if(x)m[it[0]]=Number(x.value);else miss.push(app.querySelector('.blk[data-n=\"'+it[0]+'\"]'));});\n      var x=app.querySelector('input[name=\"val\"]:checked');if(x)v=Number(x.value);else miss.push(app.querySelector('.blk[data-n=\"__val\"]'));\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please answer every statement and the feeling scale.');}\n      var sh=[files[k].name];\n      send([SPSite.answer('perception',m,{key:k,shown:sh}),SPSite.answer('valence',v,{key:k,shown:sh})],this,function(){if(st.p<MATS.length-1)st.p++;else st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+BG.map(function(n){var q=Q[n];\n      if(q.type==='text')return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b><br><input class=\"txt\" id=\"f_'+n+'\" '+(q.inputType==='number'?'type=\"number\" inputmode=\"decimal\" min=\"'+q.min+'\" max=\"'+q.max+'\"':'type=\"text\" maxlength=\"80\"')+'></div>';\n      return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var L=[],miss=[];\n      BG.forEach(function(n){var q=Q[n],el=app.querySelector('.blk[data-n=\"'+n+'\"]');\n        if(q.type==='text'){var raw=document.getElementById('f_'+n).value.trim();\n          if(q.inputType==='number'){var v=Number(raw);if(raw===''||isNaN(v)||v<q.min||v>q.max){miss.push(el);return;}L.push(SPSite.answer(n,v));}\n          else{if(!raw){miss.push(el);return;}L.push(SPSite.answer(n,raw));}return;}\n        var x=app.querySelector('input[name=\"'+n+'\"]:checked');if(!x){miss.push(el);return;}\n        L.push(SPSite.answer(n,x.value));});\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please answer the marked questions.');}\n      send(L,this,function(){st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var b=e.target.closest&&e.target.closest('.blk');if(b){b.classList.remove('miss');hideErr();}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='pics')return pics();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){if(!SPSite.__nm){SPSite.__nm=1;var _gm=SPSite.getMedia;SPSite.getMedia=function(){var r=_gm.apply(SPSite,arguments),fx=function(m){if(!m||!m.name)return m;var c={},k;for(k in m)c[k]=m[k];c.name=String(m.name).replace(/__[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(\\.[A-Za-z0-9]+)$/i,'$1');return c;};if(Array.isArray(r))return r.map(fx);if(r&&typeof r==='object'){var o={},k;for(k in r)o[k]=(r[k]||[]).map(fx);return o;}return r;};}(SPSite.getQuestions()||[]).forEach(function(q){if(q.type==='number'){q.type='text';q.inputType='number';}if(q.isRequired==null)q.isRequired=!!q.required;});\n    ['consent','perception','valence'].concat(BG).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('bathrooms')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=MATS.filter(function(m){return !files[m[0]];}).map(function(m){return m[0];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"bathrooms\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.step&&st.order)||a.consent!==true)st={step:'intro'};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
