   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Rural Greenway Planting</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Planting Along Rural Greenways: Restorativeness and Preference\",\n  \"description\": \"Faithful replication of Fumagalli et al. (2020), Sustainability 12:2120: watch one of four rendered cycling videos of a rural greenway in the Po Valley (no planting, trees, trees + shrubs, shrubs + perennials) and rate perceived restorativeness (PRS-11), preference, familiarity and 13 landscape attributes.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"videos\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"intro\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"I am 18 or older and agree to take part. My answers are confidential and I can stop at any time.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"video\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"restorativeness\",\n      \"title\": \"Perceived restorativeness of the greenway\",\n      \"isRequired\": true,\n      \"description\": \"Between-subjects: each participant is randomly assigned ONE of four rendered cycling videos (key = scenario_1 … scenario_4; 1 no planting, 2 trees both sides, 3 shrubs left + trees right, 4 shrubs left + perennials right). Value: object with PRS-11 items ba1–ba3 (being away), fa1–fa3 (fascination), co1–co3 (coherence), sc1–sc2 (scope), plus pref (preference) and fam (familiarity), each 0 = not at all, 6 = rather much, 10 = completely. PRS-11 score = mean of the 11 items; compare scenarios with ANOVA.\",\n      \"items\": [\n       {\n        \"name\": \"ba1\",\n        \"factor\": \"Being away\",\n        \"text\": \"Places like that are a refuge from nuisances.\"\n       },\n       {\n        \"name\": \"ba2\",\n        \"factor\": \"Being away\",\n        \"text\": \"To get away from things that usually demand my attention, I like to go to places like this.\"\n       },\n       {\n        \"name\": \"ba3\",\n        \"factor\": \"Being away\",\n        \"text\": \"To stop thinking about the things that I must get done, I like to go to places like this.\"\n       },\n       {\n        \"name\": \"fa1\",\n        \"factor\": \"Fascination\",\n        \"text\": \"Places like that are fascinating.\"\n       },\n       {\n        \"name\": \"fa2\",\n        \"factor\": \"Fascination\",\n        \"text\": \"In places like this, my attention is drawn to many interesting things.\"\n       },\n       {\n        \"name\": \"fa3\",\n        \"factor\": \"Fascination\",\n        \"text\": \"In places like this, it is hard to be bored.\"\n       },\n       {\n        \"name\": \"co1\",\n        \"factor\": \"Coherence\",\n        \"text\": \"There is a clear order in the physical arrangement of places like this.\"\n       },\n       {\n        \"name\": \"co2\",\n        \"factor\": \"Coherence\",\n        \"text\": \"In places like this, it is easy to see how things are organized.\"\n       },\n       {\n        \"name\": \"co3\",\n        \"factor\": \"Coherence\",\n        \"text\": \"In places like this, everything seems to have its proper place.\"\n       },\n       {\n        \"name\": \"sc1\",\n        \"factor\": \"Scope\",\n        \"text\": \"That place is large enough to allow exploration in many directions.\"\n       },\n       {\n        \"name\": \"sc2\",\n        \"factor\": \"Scope\",\n        \"text\": \"In places like this, there are few boundaries to limit my possibility for moving about.\"\n       },\n       {\n        \"name\": \"pref\",\n        \"factor\": \"Preference\",\n        \"text\": \"How much do you like this place?\"\n       },\n       {\n        \"name\": \"fam\",\n        \"factor\": \"Familiarity\",\n        \"text\": \"How familiar is a place like this to you?\"\n       }\n      ],\n      \"min\": 0,\n      \"max\": 10,\n      \"trials\": [\n       {\n        \"id\": \"scenario_1\",\n        \"file\": \"scenario_1.mp4\",\n        \"scenario\": 1,\n        \"planting\": \"No designed planting; open view to the rural landscape (control)\"\n       },\n       {\n        \"id\": \"scenario_2\",\n        \"file\": \"scenario_2.mp4\",\n        \"scenario\": 2,\n        \"planting\": \"A row of large columnar trees (Populus alba) on both sides, 9 m apart\"\n       },\n       {\n        \"id\": \"scenario_3\",\n        \"file\": \"scenario_3.mp4\",\n        \"scenario\": 3,\n        \"planting\": \"Mixed native shrubs on the left, a row of large trees on the right\"\n       },\n       {\n        \"id\": \"scenario_4\",\n        \"file\": \"scenario_4.mp4\",\n        \"scenario\": 4,\n        \"planting\": \"Mixed native shrubs on the left, mixed perennials (0.5 m) on the right\"\n       }\n      ]\n     },\n     {\n      \"type\": \"custom\",\n      \"name\": \"attributes\",\n      \"title\": \"Physical and aesthetic attributes of the greenway\",\n      \"isRequired\": true,\n      \"description\": \"Same trial key as restorativeness. Value: object with 13 attributes, each 0 = not at all … 5 = a lot. In the paper a PCA grouped them into legibility (openness, luminosity, cleanliness, maintenance, safety, tranquillity), sociality (leisure, meeting, novel) and variety (vegetation, diversity, harmony, representativeness).\",\n      \"items\": [\n       {\n        \"name\": \"vegetation\",\n        \"text\": \"Vegetation\"\n       },\n       {\n        \"name\": \"diversity\",\n        \"text\": \"Visual diversity / richness\"\n       },\n       {\n        \"name\": \"harmony\",\n        \"text\": \"Harmony / congruence\"\n       },\n       {\n        \"name\": \"openness\",\n        \"text\": \"Openness / spaciousness\"\n       },\n       {\n        \"name\": \"luminosity\",\n        \"text\": \"Luminosity\"\n       },\n       {\n        \"name\": \"representativeness\",\n        \"text\": \"Representativeness\"\n       },\n       {\n        \"name\": \"cleanliness\",\n        \"text\": \"Cleanliness\"\n       },\n       {\n        \"name\": \"maintenance\",\n        \"text\": \"Maintenance / upkeep\"\n       },\n       {\n        \"name\": \"leisure\",\n        \"text\": \"Place for leisure activities\"\n       },\n       {\n        \"name\": \"meeting\",\n        \"text\": \"Meeting place\"\n       },\n       {\n        \"name\": \"novel\",\n        \"text\": \"Novel place\"\n       },\n       {\n        \"name\": \"safety\",\n        \"text\": \"Safety\"\n       },\n       {\n        \"name\": \"tranquillity\",\n        \"text\": \"Tranquillity\"\n       }\n      ],\n      \"min\": 0,\n      \"max\": 5,\n      \"trials\": [\n       {\n        \"id\": \"scenario_1\",\n        \"file\": \"scenario_1.mp4\",\n        \"scenario\": 1,\n        \"planting\": \"No designed planting; open view to the rural landscape (control)\"\n       },\n       {\n        \"id\": \"scenario_2\",\n        \"file\": \"scenario_2.mp4\",\n        \"scenario\": 2,\n        \"planting\": \"A row of large columnar trees (Populus alba) on both sides, 9 m apart\"\n       },\n       {\n        \"id\": \"scenario_3\",\n        \"file\": \"scenario_3.mp4\",\n        \"scenario\": 3,\n        \"planting\": \"Mixed native shrubs on the left, a row of large trees on the right\"\n       },\n       {\n        \"id\": \"scenario_4\",\n        \"file\": \"scenario_4.mp4\",\n        \"scenario\": 4,\n        \"planting\": \"Mixed native shrubs on the left, mixed perennials (0.5 m) on the right\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"title\": \"About you\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Man\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Woman\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"18–29\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"30–39\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"40–49\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"50–59\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"60–69\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"70 or older\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Highest level of education\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Primary school\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Lower secondary school\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Upper secondary school\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"University degree\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"residence\",\n      \"title\": \"Where do you live?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"In a city\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"In a town or suburb\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"In the countryside\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"occupation\",\n      \"title\": \"Occupation\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Employed\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Self-employed\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Student\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Retired\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"Not working\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"Other\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"bike_frequency\",\n      \"title\": \"How often do you use a bicycle?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Every day\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Several times a week\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"About once a week\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Less than once a week\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"Never\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"bike_purpose\",\n      \"title\": \"What do you mainly use a bicycle for?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Leisure\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Commuting to work or school\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Sport / training\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Errands\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"I do not cycle\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#f0f2ea;--card:#fff;--ink:#20231b;--muted:#5d6352;--accent:#4a6e2a;--accent-ink:#fff;--line:#d7dccd;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.btn.sec{background:transparent;color:var(--accent);border:1px solid var(--accent);padding:8px 14px}\n.q{margin-top:18px}.q:first-child{margin-top:0}.q>b{display:block;margin-bottom:6px;font-weight:600}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\n.vid{background:#000;border-radius:12px;overflow:hidden}.vid video{width:100%;display:block;max-height:min(50vh,480px)}\n.vid.small video{max-height:min(28vh,260px)}\n.st{font-size:.85rem;color:var(--muted);margin-top:6px}\n.seg{display:grid;gap:3px}\n.seg label{display:block;cursor:pointer;position:relative}\n.seg input{position:absolute;opacity:0;pointer-events:none}\n.seg span{display:flex;align-items:center;justify-content:center;height:38px;border:1px solid var(--line);border-radius:7px;font-weight:600;font-size:.9rem}\n.seg input:checked+span{background:var(--accent);border-color:var(--accent);color:#fff}\n.seg input:focus-visible+span{outline:2px solid var(--accent);outline-offset:2px}\n.anch{display:flex;justify-content:space-between;font-size:.76rem;color:var(--muted);margin-top:2px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:480px){.seg span{font-size:.78rem;height:36px}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Videos: Fumagalli, Maccarini, Rovelli, Berto &amp; Senes (2020), Sustainability 12:2120, Videos S1–S4, doi:10.3390/su12052120 (CC BY 4.0; SketchUp and Thea Render animations). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='greenway2020:';\n  var app=document.getElementById('app'), Q={}, files={}, done={}, SPEC=null, TR=[], PRS=[], ATTR=[], pick=null, watched=false;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function q(n){return Q[n]||{};}\n  function byId(id){for(var i=0;i<TR.length;i++)if(TR[i].id===id)return TR[i];return null;}\n  function page(html,btn,cb){\n    app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn||'Continue')+'</button></div><div class=\"err\"></div>';\n    document.getElementById('go').onclick=cb;app.onchange=hideErr;\n  }\n  function video(small){var f=files[pick.file];return '<div class=\"vid'+(small?' small':'')+'\"><video id=\"m\" src=\"'+esc(f.url)+'\" playsinline preload=\"auto\"'+(small?' controls':'')+'></video></div>';}\n  function next(){\n    window.scrollTo(0,0);\n    if(!done.intro)return intro();\n    if(!done.watch)return watch();\n    if(!done.prs)return prs();\n    if(!done.attr)return attrs();\n    if(!done.about)return about();\n    finish();\n  }\n  function intro(){\n    var miss=TR.some(function(t){return !files[t.file];});\n    if(miss){app.innerHTML='<h1>Videos missing</h1><p>Media folder videos must hold scenario_1.mp4 … scenario_4.mp4.</p>';return;}\n    page('<h1>Cycling along a rural greenway</h1><p>You will watch a short video of a ride along a greenway (a cycle path through farmland) and then tell us how you experience this place. Imagine that you are the cyclist.</p><p>The video and the questions take about 10 minutes. Your answers are confidential and used only for research.</p>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      var b=this;b.disabled=true;SPSite.answer('consent',true).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}done.intro=true;save('d',done);next();});\n    });\n  }\n  function watch(){\n    watched=false;\n    page('<h1>Watch the ride</h1><div class=\"card\">'+video(false)+'<div style=\"margin-top:10px;display:flex;gap:10px;align-items:center\"><button class=\"btn sec\" id=\"play\">Play video</button><span class=\"st\" id=\"st\">Press play and watch the whole video.</span></div></div>','Continue to questions',function(){\n      if(!watched)return err('Please watch the video to the end first.');done.watch=true;save('d',done);next();\n    });\n    var m=document.getElementById('m'),st=document.getElementById('st'),go=document.getElementById('go');go.disabled=true;\n    function fin(t){watched=true;go.disabled=false;st.textContent=t;}\n    document.getElementById('play').onclick=function(){m.currentTime=0;var p=m.play();if(p&&p.catch)p.catch(function(){});st.textContent='Playing…';};\n    m.addEventListener('ended',function(){fin('Done. You can play it again or continue.');});\n    m.addEventListener('error',function(){fin('The video could not be played. Please continue.');});\n  }\n  function scale(name,min,max,label){var v=[];for(var i=min;i<=max;i++)v.push(i);return '<div class=\"seg\" role=\"radiogroup\" aria-label=\"'+esc(label)+'\" style=\"grid-template-columns:repeat('+v.length+',minmax(0,1fr))\">'+v.map(function(x){return '<label><input type=\"radio\" name=\"'+name+'\" value=\"'+x+'\"><span>'+x+'</span></label>';}).join('')+'</div>';}\n  function block(items,min,max,an,qn,intro,btn,cb){\n    var rows=items.map(function(it){return '<div class=\"q\"><b>'+esc(it.text)+'</b>'+scale(it.name,min,max,it.text)+an+'</div>';}).join('');\n    page('<div class=\"card\">'+video(true)+'<p class=\"st\">You can replay the video at any time.</p></div><div class=\"card\"><p style=\"color:var(--ink)\">'+esc(intro)+'</p>'+rows+'</div>',btn,function(){\n      var v={};for(var i=0;i<items.length;i++){var x=app.querySelector('input[name=\"'+items[i].name+'\"]:checked');if(!x)return err('Please answer: '+items[i].text);v[items[i].name]=Number(x.value);}\n      var b=this;b.disabled=true;var f=files[pick.file];\n      SPSite.answer(qn,v,{key:pick.id,shown:[f.name]}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}cb();});\n    });\n  }\n  function prs(){\n    block(PRS,0,10,'<div class=\"anch\"><span>0 = not at all</span><span>6 = rather much</span><span>10 = completely</span></div>','restorativeness','Thinking of the greenway in the video, how much does each statement apply? (0 = not at all, 6 = rather much, 10 = completely)','Continue',function(){done.prs=true;save('d',done);next();});\n  }\n  function attrs(){\n    block(ATTR,0,5,'<div class=\"anch\"><span>0 = not at all</span><span>5 = a lot</span></div>','attributes','How much does the greenway in the video have each of these qualities? (0 = not at all, 5 = a lot)','Continue',function(){done.attr=true;save('d',done);next();});\n  }\n  function about(){\n    var ns=['gender','age','education','residence','occupation','bike_frequency','bike_purpose'];\n    var h=ns.map(function(n){var d=q(n);return '<div class=\"q\"><b>'+esc(d.title)+'</b>'+(d.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('');\n    page('<h1>About you</h1><div class=\"card\">'+h+'</div>','Finish',function(){\n      var l=[];for(var i=0;i<ns.length;i++){var x=app.querySelector('input[name=\"'+ns[i]+'\"]:checked');if(!x)return err('Please answer: '+q(ns[i]).title);l.push([ns[i],Number(x.value)]);}\n      var b=this;b.disabled=true;\n      Promise.all(l.map(function(a){return SPSite.answer(a[0],a[1]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}done.about=true;save('d',done);next();});\n    });\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>You saw scenario '+pick.scenario+' of four: '+esc(pick.planting.charAt(0).toLowerCase()+pick.planting.slice(1))+'. In the original study (297 Italian participants, each shown one scenario), the scenario with shrubs on one side and a row of trees on the other was rated the most restorative (PRS-11 mean 6.27 of 10) and the most preferred (6.69), followed by trees on both sides (6.03; 6.55); the greenway without planting scored lowest (5.70; 5.80). Preference rose and fell with perceived restorativeness, driven mostly by being away and fascination.</p><p style=\"font-size:.82rem\">Fumagalli, N., Maccarini, M., Rovelli, R., Berto, R., &amp; Senes, G. (2020). An Exploratory Study of Users’ Preference for Different Planting Combinations along Rural Greenways. Sustainability 12:2120, doi:10.3390/su12052120.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')done.intro=false;else if(x==='restorativeness')done.prs=false;else if(x==='attributes')done.attr=false;else done.about=false;});save('d',done);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={type:e.type,title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='restorativeness'){TR=e.trials;PRS=e.items;}if(e.name==='attributes')ATTR=e.items;});});\n    (SPSite.getMedia('videos')||[]).forEach(function(f){files[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};done=load('d')||{};\n    var id=load('pick');\n    var rt=(a.restorativeness&&a.restorativeness.trials)||[],at=(a.attributes&&a.attributes.trials)||[];\n    if(rt.length&&byId(rt[0].key))id=rt[0].key;else if(at.length&&byId(at[0].key))id=at[0].key;\n    if(!byId(id))id=TR[Math.floor(Math.random()*TR.length)].id;\n    save('pick',id);pick=byId(id);\n    done.intro=a.consent===true;done.prs=rt.length>0;done.attr=at.length>0;\n    done.about=['gender','age','education','residence','occupation','bike_frequency','bike_purpose'].every(function(n){return a[n]!=null;});\n    if(done.prs||done.attr)done.watch=true;\n    if(!done.intro)done.watch=false;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
