   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Forest Recreation Spaces</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Forest Recreation Space Cognition\",\n  \"description\": \"Faithful replication of Zhang et al. (2022), Forests 13:136: view six photographs of forest recreation spaces in Liaoning forest parks (15 s each), then rate each space on ten 7-point spatial cognition indicators (landscape change, color, space, overall satisfaction).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"forest\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"intro\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part voluntarily and know I can stop at any time.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Female\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age (years)\",\n      \"isRequired\": true,\n      \"min\": 16,\n      \"max\": 99\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Current study level\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Undergraduate\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Postgraduate\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Not a student\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"major\",\n      \"title\": \"Field of study or work\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Landscape architecture\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Forestry\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Horticulture\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Economic management\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"Land and environment\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"Other\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"viewing\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"free_viewing\",\n      \"title\": \"Free viewing: each photograph is shown for 15 seconds, with a blank grey screen between photographs.\",\n      \"isRequired\": true,\n      \"description\": \"Viewing phase, no response. One trial per photograph in the order of the paper's Figure 2 (dynamic_water, static_water, lookout, broadleaf, coniferous, mixed); value = seconds shown (15). In the paper this phase was recorded with an eye tracker; here only the viewing is kept.\",\n      \"trials\": [\n       {\n        \"id\": \"dynamic_water\",\n        \"label\": \"Space of dynamic water\",\n        \"type\": \"waterscape\"\n       },\n       {\n        \"id\": \"static_water\",\n        \"label\": \"Space of static water\",\n        \"type\": \"waterscape\"\n       },\n       {\n        \"id\": \"lookout\",\n        \"label\": \"Space of lookout\",\n        \"type\": \"lookout\"\n       },\n       {\n        \"id\": \"broadleaf\",\n        \"label\": \"Space of broadleaf landscape\",\n        \"type\": \"in_forest\"\n       },\n       {\n        \"id\": \"coniferous\",\n        \"label\": \"Space of coniferous landscape\",\n        \"type\": \"in_forest\"\n       },\n       {\n        \"id\": \"mixed\",\n        \"label\": \"Space of mixed landscape\",\n        \"type\": \"in_forest\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"ratings\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"spatial_cognition\",\n      \"title\": \"Please rate this forest landscape space on each indicator.\",\n      \"isRequired\": true,\n      \"description\": \"One trial per photograph (same keys, same order). Value: {psd, lcc, ltd, wcr, wcb, wso, cdl, wsn, ssh, satisfaction}, each 1 = worst … 7 = best. Analysis as in the paper: mean per space and indicator; compare landscape and non-landscape majors (major = 1 vs others); regress satisfaction on the nine spatial perception indicators overall, per major group and per space.\",\n      \"items\": [\n       {\n        \"name\": \"psd\",\n        \"group\": \"Landscape change\",\n        \"text\": \"Whether the plant species are diverse\"\n       },\n       {\n        \"name\": \"lcc\",\n        \"group\": \"Landscape change\",\n        \"text\": \"Whether the landscape content is changing\"\n       },\n       {\n        \"name\": \"ltd\",\n        \"group\": \"Landscape change\",\n        \"text\": \"Whether the near-middle landscape is three-dimensional\"\n       },\n       {\n        \"name\": \"wcr\",\n        \"group\": \"Color\",\n        \"text\": \"Whether the color is rich\"\n       },\n       {\n        \"name\": \"wcb\",\n        \"group\": \"Color\",\n        \"text\": \"Whether the color is bright\"\n       },\n       {\n        \"name\": \"wso\",\n        \"group\": \"Space\",\n        \"text\": \"Whether the space is open\"\n       },\n       {\n        \"name\": \"cdl\",\n        \"group\": \"Space\",\n        \"text\": \"Can you see the distant landscape\"\n       },\n       {\n        \"name\": \"wsn\",\n        \"group\": \"Space\",\n        \"text\": \"Whether the space is neat\"\n       },\n       {\n        \"name\": \"ssh\",\n        \"group\": \"Space\",\n        \"text\": \"Whether the space has a sense of hierarchy\"\n       },\n       {\n        \"name\": \"satisfaction\",\n        \"group\": \"Overall\",\n        \"text\": \"Whether you are satisfied with it\"\n       }\n      ],\n      \"min\": 1,\n      \"max\": 7,\n      \"trials\": [\n       {\n        \"id\": \"dynamic_water\",\n        \"label\": \"Space of dynamic water\",\n        \"type\": \"waterscape\"\n       },\n       {\n        \"id\": \"static_water\",\n        \"label\": \"Space of static water\",\n        \"type\": \"waterscape\"\n       },\n       {\n        \"id\": \"lookout\",\n        \"label\": \"Space of lookout\",\n        \"type\": \"lookout\"\n       },\n       {\n        \"id\": \"broadleaf\",\n        \"label\": \"Space of broadleaf landscape\",\n        \"type\": \"in_forest\"\n       },\n       {\n        \"id\": \"coniferous\",\n        \"label\": \"Space of coniferous landscape\",\n        \"type\": \"in_forest\"\n       },\n       {\n        \"id\": \"mixed\",\n        \"label\": \"Space of mixed landscape\",\n        \"type\": \"in_forest\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#eef1ea;--card:#fff;--ink:#20231d;--muted:#5d6456;--accent:#4f6b3a;--accent-ink:#fff;--line:#d6dccf;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q>b{display:block;margin-bottom:4px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;max-width:160px;background:#fff;color:var(--ink)}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem;font-variant-numeric:tabular-nums}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.stage{background:#808080;border-radius:12px;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;overflow:hidden}\n.stage img{width:100%;height:100%;object-fit:contain;display:block}\n.cross{color:#fff;font-size:3rem;font-weight:300;line-height:1}\n.pic{background:#e3e7df;border-radius:12px;overflow:hidden}.pic img{width:100%;max-height:min(40vh,380px);object-fit:contain;display:block}\n.lk{display:grid;grid-template-columns:1fr repeat(7,40px);gap:3px;align-items:center;padding:7px 0;border-top:1px solid var(--line)}\n.lk.hd{border-top:0;padding:2px 0}.lk .h{font-size:.78rem;color:var(--muted);text-align:center}\n.lk label{display:flex;justify-content:center}.lk input{width:20px;height:20px}\n.lk span.it{font-size:.92rem}.lk span.it small{display:block;color:var(--muted);font-size:.74rem;text-transform:uppercase;letter-spacing:.03em}\n.anch{font-size:.8rem;color:var(--muted);margin-top:4px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:560px){.lk{grid-template-columns:1fr repeat(7,30px);gap:2px}.lk input{width:18px;height:18px}.lk span.it{font-size:.85rem}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Zhang, Gao, Zhou, Zhang, Zhang &amp; Meng (2022), Forests 13:136, Figure 2, doi:10.3390/f13020136 (CC BY 4.0; forest recreation spaces in Liaoning forest parks, China). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='forestrec2022:';\n  var app=document.getElementById('app'), Q={}, files={}, ans={}, rated={}, SPEC=null, TR=[], ITEMS=[], vorder=[], rorder=[], viewed=0, timer=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function q(n){return Q[n]||{};}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function page(html,btn,cb){app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn)+'</button></div><div class=\"err\"></div>';document.getElementById('go').onclick=cb;app.onchange=hideErr;}\n  function next(){\n    window.scrollTo(0,0);clearTimeout(timer);\n    if(!ans.intro)return intro();\n    if(!ans.about)return about();\n    if(viewed<vorder.length){if(viewed===0&&!ans.vstart)return viewIntro();return view();}\n    for(var i=0;i<rorder.length;i++){if(!rated[rorder[i]])return rate(rorder[i]);}\n    finish();\n  }\n  function intro(){\n    var miss=TR.some(function(t){return !files[t.id+'.jpg'];});\n    if(miss){app.innerHTML='<h1>Pictures missing</h1><p>Media folder forest must hold dynamic_water.jpg, static_water.jpg, lookout.jpg, broadleaf.jpg, coniferous.jpg and mixed.jpg.</p>';return;}\n    page('<h1>Forest recreation spaces</h1><p>This study has two parts. First you simply look at six photographs of places in forest parks, one after another. Each is shown for 15 seconds, with a short grey screen in between; you do not need to do anything. Then you see the photographs again and rate each place on ten short points.</p><p>It takes about 10 minutes. Please use a computer or tablet if you can, in a quiet place. Your answers are anonymous and used only for research.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      var b=this;b.disabled=true;SPSite.answer('consent',true).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}ans.intro=true;save('a',ans);next();});});\n  }\n  function about(){\n    var ns=['gender','age','education','major'];\n    var h=ns.map(function(n){var d=q(n);if(n==='age')return '<div class=\"q\"><b>'+esc(d.title)+'</b><input type=\"number\" inputmode=\"numeric\" name=\"age\" min=\"16\" max=\"99\"></div>';\n      return '<div class=\"q\"><b>'+esc(d.title)+'</b>'+(d.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('');\n    page('<h1>About you</h1><div class=\"card\">'+h+'</div>','Continue',function(){\n      var l=[];for(var i=0;i<ns.length;i++){var n=ns[i];if(n==='age'){var v=app.querySelector('input[name=age]').value.trim(),a=Number(v);if(!v||!(a>=16&&a<=99)||Math.round(a)!==a)return err('Please enter your age in years.');l.push(['age',a]);continue;}\n        var x=app.querySelector('input[name=\"'+n+'\"]:checked');if(!x)return err('Please answer: '+q(n).title);l.push([n,Number(x.value)]);}\n      var b=this;b.disabled=true;Promise.all(l.map(function(x){return SPSite.answer(x[0],x[1]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}ans.about=true;save('a',ans);next();});});\n  }\n  function viewIntro(){\n    page('<h1>Part 1: just look</h1><div class=\"card\"><p style=\"margin:0\">You will now see six photographs, each for 15 seconds, with a grey screen between them. Simply look at each place as if you were standing there. The next photograph appears by itself.</p></div>','Begin',function(){ans.vstart=true;save('a',ans);next();});\n  }\n  function view(){\n    var k=vorder[viewed], f=files[k+'.jpg'], gap=viewed>0?6000:0;\n    app.innerHTML='<div class=\"top\"><span class=\"t\">Part 1 · photograph '+(viewed+1)+' of '+vorder.length+'</span><div class=\"bar\"><i style=\"width:'+(100*viewed/vorder.length)+'%\"></i></div></div><div class=\"stage\" id=\"st\"></div>';\n    var im=new Image();im.src=f.url;\n    timer=setTimeout(function(){var st=document.getElementById('st');if(!st)return;st.innerHTML='<img alt=\"Forest landscape photograph\" src=\"'+esc(f.url)+'\">';\n      timer=setTimeout(function(){SPSite.answer('free_viewing',15,{key:k,shown:[f.name]});viewed++;save('viewed',viewed);next();},15000);},gap);\n  }\n  function rate(k){\n    var n=0;rorder.forEach(function(x){if(rated[x])n++;});var f=files[k+'.jpg'],S=[1,2,3,4,5,6,7];\n    var h='<div class=\"lk hd\"><span></span>'+S.map(function(v){return '<span class=\"h\">'+v+'</span>';}).join('')+'</div>'+\n      ITEMS.map(function(it){return '<div class=\"lk\" role=\"radiogroup\" aria-label=\"'+esc(it.text)+'\"><span class=\"it\"><small>'+esc(it.group)+'</small>'+esc(it.text)+'</span>'+S.map(function(v){return '<label><input type=\"radio\" name=\"'+it.name+'\" value=\"'+v+'\" aria-label=\"'+v+'\"></label>';}).join('')+'</div>';}).join('');\n    page('<div class=\"top\"><span class=\"t\">Part 2 · photograph '+(n+1)+' of '+rorder.length+'</span><div class=\"bar\"><i style=\"width:'+(100*n/rorder.length)+'%\"></i></div></div><div class=\"card\"><div class=\"pic\"><img alt=\"Forest landscape photograph\" src=\"'+esc(f.url)+'\"></div><div class=\"q\"><b>'+esc(q('spatial_cognition').title)+'</b><div class=\"anch\">1 = worst · 7 = best</div>'+h+'</div></div>',n===rorder.length-1?'Finish':'Next photograph',function(){\n      var v={};for(var i=0;i<ITEMS.length;i++){var x=app.querySelector('input[name=\"'+ITEMS[i].name+'\"]:checked');if(!x)return err('Please rate all ten points.');v[ITEMS[i].name]=Number(x.value);}\n      var b=this;b.disabled=true;SPSite.answer('spatial_cognition',v,{key:k,shown:[f.name]}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}rated[k]=true;next();});});\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>The six photographs showed typical forest recreation spaces in five forest parks of Liaoning, northern China: flowing and still water, a lookout, and broadleaf, coniferous and mixed forest. In the original study, 53 students looked at them on an eye tracker and then rated them. Places where the eyes moved more often were rated less satisfying, and landscape students and students of other subjects attended to different things.</p><p style=\"font-size:.82rem\">Photographs and method: Zhang, Z., Gao, Y., Zhou, S., Zhang, T., Zhang, W., &amp; Meng, H. (2022). Psychological Cognitive Factors Affecting Visual Behavior and Satisfaction Preference for Forest Recreation Space. Forests 13:136, doi:10.3390/f13020136.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')ans.intro=false;else if(x==='free_viewing'){viewed=0;ans.vstart=false;}else if(x==='spatial_cognition')rated={};else ans.about=false;});save('a',ans);save('viewed',viewed);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='spatial_cognition'){TR=e.trials;ITEMS=e.items;}});});\n    (SPSite.getMedia('forest')||[]).forEach(function(f){files[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};ans=load('a')||{};\n    var ids=TR.map(function(t){return t.id;});\n    function ord(n){var o=load(n);return ids.slice();}\n    vorder=ord('vorder');rorder=ord('rorder');\n    var vt=(a.free_viewing&&a.free_viewing.trials)||[];viewed=Math.max(load('viewed')||0,vt.length);if(viewed>vorder.length)viewed=vorder.length;\n    ((a.spatial_cognition&&a.spatial_cognition.trials)||[]).forEach(function(t){if(t.key)rated[t.key]=true;});\n    ans.intro=a.consent===true;ans.about=a.major!=null;if(viewed>0)ans.vstart=true;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
