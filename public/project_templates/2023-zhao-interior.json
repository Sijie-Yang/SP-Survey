   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Interior Materials</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Interior Materials and the Restorativeness of Home Environments\",\n  \"description\": \"Participants see pictures of ten interior materials (wall paint, textile, wood, plastic, glass, metal, tile, brick, stone, concrete) in random order and rate each on the study's 12 adjective pairs (1–7) chosen for the four restorative features: being away, extent, fascination and compatibility. Rebuilt from Zhao, Nagai, Gao, Shen & Fan (2023), IJERPH 20(14): 6364, with the paper's Figure 1 pictures (CC BY 4.0). Scoring as in the paper: mean of each feature's pairs; preference = fascination + compatibility; relaxation = being away + compatibility; restorative potential = sum of all four; Wilcoxon signed-rank tests for the 45 material pairs.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"materials\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I am 18 or older and agree to take part in this study.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"materials\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"ordinary_special\",\n      \"title\": \"Ordinary – Special\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Special\",\n      \"maxRateDescription\": \"Ordinary\",\n      \"isRequired\": true,\n      \"description\": \"Restorative feature: being away. Keyed by material: paint (interior wall paint), textile, wood, plastic, glass, metal, tile, brick, stone, concrete. 1 = Special, 7 = Ordinary. In the paper a LOWER being-away score means more being away.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"harmony_clash\",\n      \"title\": \"Harmony – Clash\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Clash\",\n      \"maxRateDescription\": \"Harmony\",\n      \"isRequired\": true,\n      \"description\": \"Restorative feature: being away. Keyed by material: paint (interior wall paint), textile, wood, plastic, glass, metal, tile, brick, stone, concrete. 1 = Clash, 7 = Harmony. In the paper a LOWER being-away score means more being away.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"textured_untextured\",\n      \"title\": \"Textured – Untextured\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Untextured\",\n      \"maxRateDescription\": \"Textured\",\n      \"isRequired\": true,\n      \"description\": \"Restorative feature: extent. Keyed by material: paint (interior wall paint), textile, wood, plastic, glass, metal, tile, brick, stone, concrete. 1 = Untextured, 7 = Textured.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"colorful_dull\",\n      \"title\": \"Colorful – Dull\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Dull\",\n      \"maxRateDescription\": \"Colorful\",\n      \"isRequired\": true,\n      \"description\": \"Restorative feature: extent. Keyed by material: paint (interior wall paint), textile, wood, plastic, glass, metal, tile, brick, stone, concrete. 1 = Dull, 7 = Colorful.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"finished_unfinished\",\n      \"title\": \"Finished – Unfinished\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Unfinished\",\n      \"maxRateDescription\": \"Finished\",\n      \"isRequired\": true,\n      \"description\": \"Restorative feature: extent. Keyed by material: paint (interior wall paint), textile, wood, plastic, glass, metal, tile, brick, stone, concrete. 1 = Unfinished, 7 = Finished.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"patterned_random\",\n      \"title\": \"Patterned – Random\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Random\",\n      \"maxRateDescription\": \"Patterned\",\n      \"isRequired\": true,\n      \"description\": \"Restorative feature: extent. Keyed by material: paint (interior wall paint), textile, wood, plastic, glass, metal, tile, brick, stone, concrete. 1 = Random, 7 = Patterned.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"luxury_cheap\",\n      \"title\": \"Luxury – Cheap\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Cheap\",\n      \"maxRateDescription\": \"Luxury\",\n      \"isRequired\": true,\n      \"description\": \"Restorative feature: fascination. Keyed by material: paint (interior wall paint), textile, wood, plastic, glass, metal, tile, brick, stone, concrete. 1 = Cheap, 7 = Luxury.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"pleasing_repelling\",\n      \"title\": \"Pleasing – Repelling\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Repelling\",\n      \"maxRateDescription\": \"Pleasing\",\n      \"isRequired\": true,\n      \"description\": \"Restorative feature: fascination. Keyed by material: paint (interior wall paint), textile, wood, plastic, glass, metal, tile, brick, stone, concrete. 1 = Repelling, 7 = Pleasing.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"attractive_unattractive\",\n      \"title\": \"Attractive – Unattractive\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Unattractive\",\n      \"maxRateDescription\": \"Attractive\",\n      \"isRequired\": true,\n      \"description\": \"Restorative feature: fascination. Keyed by material: paint (interior wall paint), textile, wood, plastic, glass, metal, tile, brick, stone, concrete. 1 = Unattractive, 7 = Attractive.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"durable_nondurable\",\n      \"title\": \"Durable – Nondurable\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Nondurable\",\n      \"maxRateDescription\": \"Durable\",\n      \"isRequired\": true,\n      \"description\": \"Restorative feature: compatibility. Keyed by material: paint (interior wall paint), textile, wood, plastic, glass, metal, tile, brick, stone, concrete. 1 = Nondurable, 7 = Durable.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"solid_flimsy\",\n      \"title\": \"Solid – Flimsy\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Flimsy\",\n      \"maxRateDescription\": \"Solid\",\n      \"isRequired\": true,\n      \"description\": \"Restorative feature: compatibility. Keyed by material: paint (interior wall paint), textile, wood, plastic, glass, metal, tile, brick, stone, concrete. 1 = Flimsy, 7 = Solid.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"changeable_unchangeable\",\n      \"title\": \"Changeable – Unchangeable\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Unchangeable\",\n      \"maxRateDescription\": \"Changeable\",\n      \"isRequired\": true,\n      \"description\": \"Restorative feature: compatibility. Keyed by material: paint (interior wall paint), textile, wood, plastic, glass, metal, tile, brick, stone, concrete. 1 = Unchangeable, 7 = Changeable.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"woman\",\n        \"text\": \"Woman\"\n       },\n       {\n        \"value\": \"man\",\n        \"text\": \"Man\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"design_background\",\n      \"title\": \"What is your background?\",\n      \"isRequired\": true,\n      \"description\": \"The original sample were environmental design students, interior design students and architects; wording mine.\",\n      \"choices\": [\n       {\n        \"value\": \"interior_design_student\",\n        \"text\": \"Interior or environmental design student\"\n       },\n       {\n        \"value\": \"architect_designer\",\n        \"text\": \"Architect or interior designer (working)\"\n       },\n       {\n        \"value\": \"other_design\",\n        \"text\": \"Other design or building field\"\n       },\n       {\n        \"value\": \"none\",\n        \"text\": \"None of these\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"materials-original\">{\"source\": \"Zhao, Nagai, Gao, Shen & Fan (2023) International Journal of Environmental Research and Public Health 20(14): 6364\", \"n\": 85, \"participants\": \"Environmental design students, interior design students and architects in China; online questionnaire on wjx.cn, about 30 min\", \"result\": \"Glass ranked best for restorative potential, significantly above tile, brick, stone, concrete and metal; metal ranked worst. Wood scored best on being away but lowest on fascination and compatibility, so it was not the most restorative material; plastic had the highest fascination and concrete the highest extent.\"}</script>\n<style>\n:root{--bg:#f6f4ef;--card:#fff;--ink:#23211c;--muted:#655f53;--accent:#5b4a8a;--line:#e0dbd0;--warn:#b3261e;--sel:#ece8f6}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.photo{width:100%;max-width:520px;border-radius:8px;display:block;margin:0 auto 6px}\n.cr{font-size:.72rem;color:var(--muted);text-align:center;margin-bottom:12px}\n.sd{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center;padding:7px 0;border-top:1px solid var(--line)}\n.sd:first-of-type{border-top:0}\n.sd .l{text-align:right;font-weight:600;font-size:.95rem}.sd .r{font-weight:600;font-size:.95rem}\n.row{display:flex;gap:4px}\n.row label{display:flex;align-items:center;justify-content:center;width:30px;height:30px;border:1px solid var(--line);border-radius:50%;cursor:pointer}\n.row label:has(input:checked){background:var(--accent);border-color:var(--accent)}\n.row input{appearance:none;margin:0;width:100%;height:100%;cursor:pointer}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:760px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:520px){.sd{grid-template-columns:1fr 1fr;gap:4px 8px}.sd .l{text-align:left;order:1}.sd .r{text-align:right;order:2}.row{order:3;grid-column:1/-1;justify-content:space-between;padding:0 4px}.row label{width:36px;height:36px}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Material pictures: Zhao, Nagai, Gao, Shen &amp; Fan (2023), International Journal of Environmental Research and Public Health 20(14): 6364, Figure 1 (doi:10.3390/ijerph20146364, CC BY 4.0; the paper credits the original pictures to Freepik).</footer>\n<script>\n(function(){\n  var KEY='interior-materials:state';\n  var app=document.getElementById('app'), Q={}, files={}, ids=[], st=null;\n  var NAMES={paint:'Interior wall paint',textile:'Textile',wood:'Wood',plastic:'Plastic',glass:'Glass',metal:'Metal',tile:'Tile',brick:'Brick',stone:'Stone',concrete:'Concrete'};\n  // [name, first word (= 7), second word (= 1)] in Table 1 order\n  var SD=[['ordinary_special','Ordinary','Special'],['harmony_clash','Harmony','Clash'],['textured_untextured','Textured','Untextured'],['colorful_dull','Colorful','Dull'],['finished_unfinished','Finished','Unfinished'],['patterned_random','Patterned','Random'],['luxury_cheap','Luxury','Cheap'],['pleasing_repelling','Pleasing','Repelling'],['attractive_unattractive','Attractive','Unattractive'],['durable_nondurable','Durable','Nondurable'],['solid_flimsy','Solid','Flimsy'],['changeable_unchangeable','Changeable','Unchangeable']];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  // left end = second word (value 1), right end = first word (value 7), as in the paper's coding\n  function sdRow(p){var L=p[2],R=p[1],h='<div class=\"sd\"><span class=\"l\">'+L+'</span><div class=\"row\">';\n    for(var v=1;v<=7;v++)h+='<label title=\"'+v+'\"><input type=\"radio\" name=\"q_'+p[0]+'\" value=\"'+v+'\" aria-label=\"'+L+' '+(8-v)+' / '+R+' '+v+'\"></label>';\n    return h+'</div><span class=\"r\">'+R+'</span></div>';}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function intro(){\n    app.innerHTML='<h1>Materials for the home</h1><p>You will see '+st.order.length+' common interior materials, one at a time. Think of each material used in a home. Look at the picture and, using what you know from your own experience (or can find online), mark where the material lies between two opposite words: the circle next to a word means \"very\", the middle circle means neither. There are 12 word pairs per material. It takes about 20–30 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='trial';st.k=0;save();route();});};\n  }\n  function trial(){\n    var id=st.order[st.k];\n    app.innerHTML='<div class=\"prog\">Material '+(st.k+1)+' of '+st.order.length+'</div><div class=\"card\"><img class=\"photo\" alt=\"'+esc(NAMES[id]||id)+'\" src=\"'+esc(files[id].url)+'\"><h2 style=\"text-align:center\">'+esc(NAMES[id]||id)+'</h2>'+SD.map(sdRow).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var vals=SD.map(function(p){return val('q_'+p[0]);});if(vals.some(function(x){return x==null;}))return err('Please answer all 12 word pairs.');\n      var sh=[files[id].name];\n      send(SD.map(function(p,i){return SPSite.answer(p[0],Number(vals[i]),{key:id,shown:sh});}),this,function(){st.k++;if(st.k>=st.order.length)st.step='about';save();route();});\n    };\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"110\"></div>'+radios('gender')+radios('design_background')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var g=val('gender'),f=val('design_background'),age=Number(document.getElementById('age').value);\n      if(!(age>=18&&age<=110))return err('Please enter your age.');if(!g||!f)return err('Please answer every question.');\n      send([SPSite.answer('age',age),SPSite.answer('gender',g),SPSite.answer('design_background',f)],this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='trial')return trial();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','design_background'].concat(SD.map(function(p){return p[0];})).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('materials')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name)){var k=f.name.replace(/\\.[^.]+$/,'');files[k]=f;ids.push(k);}});\n    if(ids.length<2){app.innerHTML='<h1>Pictures missing</h1><p>Upload the material pictures to the media folder \"materials\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var valid=st&&st.order&&st.order.length===ids.length&&st.order.every(function(x){return files[x];});\n    if(!valid)st={step:'intro',order:shuffle(ids),k:0};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
