  "spSite": {
   "id": "site-6546a2bf00d676ef",
   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Garden Depth Estimates</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Depth Perception in a Classical Chinese Garden: Magnitude Estimation\",\n  \"description\": \"Participants look out from the Lvyin Pavilion of the Liu Garden, Suzhou, in panoramic photographs and estimate the depth of the garden (distance from the viewer to its far end) by magnitude estimation: the middle-position panorama A2 is the standard with depth 100, each comparative panorama gets a number relative to it. Panoramas vary viewing position (left, middle, right; 1.5 m apart) and pictorial depth cues removed by image editing. Method replication of Task 1 in Zhu, Gu, Ohno & Kong (2022), Frontiers in Psychology 13: 963600, using the 18 panoramas printed in its Figure 1 (CC BY 4.0). Timing as in the paper: standard 45 s, comparative 45 s, 15 s eyes closed between rounds. Analysis: one-sample t-tests of A1 and A3 against 100; within each session, paired t-tests of the mean of group A vs the treated group.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"garden\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part in this study.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"estimate\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"depth_value\",\n      \"title\": \"How deep did this view of the garden look, compared with the reference view (100)?\",\n      \"isRequired\": true,\n      \"min\": 1,\n      \"max\": 1000,\n      \"description\": \"Keyed by comparative panorama <group><position>: position 1 left, 2 middle, 3 right in the Lvyin Pavilion. Groups (paper Table 1): A pavilion interior darkened (linear perspective of the space removed; A2 is the standard = 100); B peripheral frame made rectangular; C lotus leaves overlapping the water replaced with water (occlusion removed); D original panorama with all depth cues; E waterside buildings erased; F lotus texture blurred (texture gradient removed). Each participant gets one session: A1, A3 and the three panoramas of one of B-F, in random order. Value = magnitude estimate relative to the standard (100).\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"What is your gender?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"woman\",\n        \"text\": \"Woman\"\n       },\n       {\n        \"value\": \"man\",\n        \"text\": \"Man\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"screen\",\n      \"title\": \"What did you use to view the pictures?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"computer\",\n        \"text\": \"Computer or laptop\"\n       },\n       {\n        \"value\": \"tablet\",\n        \"text\": \"Tablet\"\n       },\n       {\n        \"value\": \"phone\",\n        \"text\": \"Phone\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"depth-original\">{\"source\": \"Zhu, Gu, Ohno & Kong (2022) Frontiers in Psychology 13: 963600\", \"n\": 71, \"n_analysed_task1\": 64, \"participants\": \"adults aged 19-39 (M 23.8), lab at ETH Zurich; panoramas projected on a three-wall CAVE; five sessions of 12-14 people\", \"task1_me_group_A\": {\"A1\": 92.86, \"A2\": 100, \"A3\": 103.84}, \"task1_sessions\": {\"B\": {\"A\": 97.89, \"B\": 99.78}, \"C\": {\"A\": 99.87, \"C\": 101.49}, \"D\": {\"A\": 102.5, \"D\": 116.39, \"p\": 0.017}, \"E\": {\"A\": 98.45, \"E\": 97.1}, \"F\": {\"A\": 96.03, \"F\": 96.08}}, \"result\": \"The left position looked significantly shallower than the middle (p = 0.004) and right (p = 0.007). Keeping the pavilion interior (group D, ambient information) made the garden look deeper than group A; removing the frame shape, lotus occlusion, waterside buildings or lotus texture made no significant difference. Task 2 (adjustment with 3D models) is not included: estimated distances were about twice the actual 60 m.\"}</script>\n<style>\n:root{--bg:#f3f4f0;--card:#fff;--ink:#202420;--muted:#5f665d;--accent:#2f6150;--line:#dadfd6;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.ex{width:100%;display:block;border-radius:6px;margin:6px 0 12px}\n.view{position:fixed;inset:0;background:rgb(5,6,6);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:5;color:#ddd}\n.view img{width:100vw;max-width:1600px;height:auto;display:block}\n.view .lab{position:absolute;top:14px;left:0;right:0;text-align:center;font-size:1rem;color:#eee}\n.view .t{position:absolute;bottom:14px;left:0;right:0;text-align:center;color:#999;font-size:.9rem}\n.rest{background:#333}\n.ans{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:8px}\ninput[type=number]{font:inherit;padding:10px 12px;border:1px solid var(--line);border-radius:8px;width:140px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Panoramas of the Liu Garden, Suzhou: Zhu, Gu, Ohno &amp; Kong (2022), Frontiers in Psychology 13: 963600, Figure 1 (doi:10.3389/fpsyg.2022.963600, CC BY 4.0); panel letters removed.</footer>\n<script>\n(function(){\n  var KEY='garden-depth:state', V=window.__VIEWMS||45000, REST=window.__VIEWMS||15000;\n  var SESS=['B','C','D','E','F'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function intro(){\n    app.innerHTML='<h1>How deep does the garden look?</h1><p>You will look out from a small pavilion over the pond of a classical Chinese garden. By <b>depth</b> we mean the distance from where you stand to the far end of the garden.</p><p>In each of '+st.trials.length+' rounds you first see a reference view for 45 seconds; its depth counts as <b>100</b>. Then you see another view for 45 seconds and give it a number: if it looks twice as deep, write 200; if half as deep, 50. Between rounds, close your eyes for 15 seconds. It takes about 12 minutes. A computer screen or a phone held sideways works best.</p><img class=\"ex\" alt=\"Reference view\" src=\"'+esc(files.A2.url)+'\"><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='trial';st.k=0;st.phase='std';save();route();});};\n  }\n  function screen(id,label,ms,then){\n    var v=document.createElement('div');v.className='view';v.innerHTML='<div class=\"lab\">'+esc(label)+'</div>';var im=new Image();im.src=files[id].url;im.alt='Garden panorama';v.appendChild(im);\n    var t=document.createElement('div');t.className='t';v.appendChild(t);app.innerHTML='';app.appendChild(v);\n    var t0=Date.now(),iv=setInterval(function(){var l=Math.ceil((ms-(Date.now()-t0))/1000);t.textContent=l>0?l+' s':'';},250);\n    setTimeout(function(){clearInterval(iv);then();},ms);\n  }\n  function trial(){\n    var id=st.trials[st.k];\n    if(st.phase==='std')return screen('A2','Round '+(st.k+1)+' of '+st.trials.length+': reference view, depth = 100',V,function(){st.phase='cmp';save();route();});\n    if(st.phase==='cmp')return screen(id,'Round '+(st.k+1)+': how deep is this view compared with the reference (100)?',V,function(){st.phase='ask';save();route();});\n    if(st.phase==='rest'){var v=document.createElement('div');v.className='view rest';v.innerHTML='<div style=\"font-size:1.2rem\">Please close your eyes</div><div class=\"t\" id=\"rt\"></div>';app.innerHTML='';app.appendChild(v);setTimeout(function(){st.phase='std';save();route();},REST);return;}\n    app.innerHTML='<div class=\"prog\">Round '+(st.k+1)+' of '+st.trials.length+'</div><div class=\"card\"><b>'+esc(Q.depth_value.title)+'</b><p style=\"margin-top:6px\">The reference view was 100. Twice as deep = 200, half as deep = 50.</p><div class=\"ans\"><input type=\"number\" id=\"dv\" min=\"1\" max=\"1000\" inputmode=\"decimal\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    var inp=document.getElementById('dv');inp.focus();\n    document.getElementById('go').onclick=function(){\n      var x=Number(inp.value);if(!(x>0&&x<=1000))return err('Please enter a number above 0 (100 = same depth as the reference).');\n      send([SPSite.answer('depth_value',x,{key:id,shown:[files.A2.name,files[id].name]})],this,function(){st.k++;if(st.k>=st.trials.length)st.step='about';else st.phase='rest';save();route();});\n    };\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"110\"></div>'+radios('gender')+radios('screen')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var age=Number(document.getElementById('age').value),g=val('gender'),s=val('screen');\n      if(!(age>=18&&age<=110))return err('Please enter your age.');if(!g||!s)return err('Please answer every question.');\n      send([SPSite.answer('age',age),SPSite.answer('gender',g),SPSite.answer('screen',s)],this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='trial')return trial();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','depth_value','age','gender','screen'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('garden')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name))files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=['A1','A2','A3'];SESS.forEach(function(g){need.push(g+'1',g+'2',g+'3');});\n    if(!need.every(function(n){return files[n];})){app.innerHTML='<h1>Pictures missing</h1><p>Upload the 18 panoramas (A1 … F3) to the media folder \"garden\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!(st&&st.trials&&st.trials.length===5)){var g=SESS[Math.floor(Math.random()*SESS.length)];st={step:'intro',session:g,trials:shuffle(['A1','A3',g+'1',g+'2',g+'3']),k:0,phase:'std'};}\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;st.phase='std';}\n    if(st.step==='trial'&&st.phase!=='ask')st.phase='std';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
