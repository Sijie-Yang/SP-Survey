   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Cyclists' Perceived Safety and Comfort (Suzhou)</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Cyclists' Perceived Safety and Comfort (Suzhou)\",\n    \"description\": \"Pairs of 360° street panoramas from Gusu District, Suzhou: pick the one that is safer for cycling, then the one that is more comfortable for cycling. Rebuilt from Xu, Luo, Delbosc, O'Hern & Chen (2026).\",\n    \"locale\": \"en\",\n    \"pages\": [\n      { \"name\": \"intro\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. My answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" }\n      ]},\n      { \"name\": \"safety_block\", \"elements\": [\n        { \"type\": \"imagepicker\", \"name\": \"safety\", \"title\": \"Which street is safer for cycling?\",\n          \"description\": \"Safety: traffic risks, the possibility of crashes or conflicts while cycling, and worries about personal security or crime.\",\n          \"imageCount\": 2, \"trialCount\": 15, \"imageFit\": \"contain\", \"isRequired\": true, \"choices\": [],\n          \"imageSelectionMode\": \"huggingface_random\", \"randomImageSelection\": true, \"excludePreviouslyUsedImages\": false,\n          \"mediaFolders\": [\"suzhou\"] }\n      ]},\n      { \"name\": \"comfort_block\", \"elements\": [\n        { \"type\": \"imagepicker\", \"name\": \"comfort\", \"title\": \"Which street is more comfortable for cycling?\",\n          \"description\": \"Comfort: the overall enjoyment and pleasantness of the cycling experience, including visually appealing elements that lift your mood.\",\n          \"imageCount\": 2, \"trialCount\": 15, \"imageFit\": \"contain\", \"isRequired\": true, \"choices\": [],\n          \"imageSelectionMode\": \"huggingface_random\", \"randomImageSelection\": true, \"excludePreviouslyUsedImages\": false,\n          \"mediaFolders\": [\"suzhou\"] }\n      ]},\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"choices\": [\n          { \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"male\", \"text\": \"Male\" }, { \"value\": \"other\", \"text\": \"Other / prefer not to say\" } ] },\n        { \"type\": \"text\", \"inputType\": \"number\", \"name\": \"age\", \"title\": \"Age (years)\", \"min\": 16, \"max\": 99 },\n        { \"type\": \"radiogroup\", \"name\": \"background\", \"title\": \"Which best describes you?\", \"choices\": [\n          { \"value\": \"student\", \"text\": \"Master's or PhD student\" },\n          { \"value\": \"professional\", \"text\": \"Professional in urban planning, landscape architecture or transport planning\" },\n          { \"value\": \"other\", \"text\": \"Other\" } ] },\n        { \"type\": \"boolean\", \"name\": \"cycled_last_week\", \"title\": \"Have you ridden a bicycle at least once in the past week?\", \"labelTrue\": \"Yes\", \"labelFalse\": \"No\" },\n        { \"type\": \"boolean\", \"name\": \"knows_suzhou\", \"title\": \"Are you familiar with living in Suzhou?\", \"labelTrue\": \"Yes\", \"labelFalse\": \"No\" }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f5f7f6;--card:#fff;--ink:#1b2320;--muted:#56625c;--accent:#0f6e5a;--accent-ink:#fff;--line:#dbe2de}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:980px;margin:0 auto;padding:24px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.1rem;margin:16px 0 6px}p,li{color:var(--muted)}p{margin:0 0 12px}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent)}\n.btn:disabled{opacity:.45;cursor:not-allowed}\n.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:8px 0 14px}.progress>i{display:block;height:100%;background:var(--accent);transition:width .25s}\n.def{background:#eaf4f0;border-radius:10px;padding:10px 12px;color:var(--ink);font-size:.95rem;margin-bottom:12px}\n.pair{display:flex;flex-direction:column;gap:10px;align-items:stretch}\n.vs{text-align:center;font-weight:700;color:#b3261e;margin:-2px 0}\n.pick{position:relative;border:3px solid transparent;border-radius:12px;padding:0;background:#0d1210;cursor:pointer;overflow:hidden;aspect-ratio:4/1;width:100%}\n.pick img{width:100%;height:100%;object-fit:contain;display:block}\n.pick:focus-visible,.pick:hover{border-color:var(--accent)}\n.pick span{position:absolute;left:8px;top:8px;background:rgba(0,0,0,.6);color:#fff;border-radius:6px;padding:2px 8px;font-size:.85rem}\n.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:120px}\n.q{margin-top:14px}.q>b{display:block;margin-bottom:4px}\n.err{color:#b3261e;margin-top:8px;min-height:1.2em}\n.credit{max-width:980px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n@media (max-width:560px){.pick{aspect-ratio:3/1}h1{font-size:1.3rem}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Street panoramas: figures of Xu, Luo, Delbosc, O'Hern &amp; Chen (2026), Transportation Research Part A 205, 104850, author version under CC BY 4.0 (Baidu Street View imagery as published).</footer>\n<script>\n(function(){\n  var app=document.getElementById('app');\n  var BLOCKS=[{name:'safety',label:'Safety'},{name:'comfort',label:'Comfort'}];\n  var Q={}, done={safety:{},comfort:{}}, b=0, i=0;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(msg){var e=app.querySelector('.err'); if(e) e.textContent=msg||'';}\n  function total(){return Q.safety.trialCount+Q.comfort.trialCount;}\n  function choicesOf(q,k){var t=q.trials&&q.trials[k];return (t&&t.choices)||q.choices||[];}\n  function mediaOf(q,k){var t=q.trials&&q.trials[k];return (t&&t.media)||q.media||[];}\n  function firstOpen(name){var q=Q[name];for(var k=0;k<q.trialCount;k++){if(!done[name][k])return k;}return q.trialCount;}\n  function resume(){\n    for(var x=0;x<BLOCKS.length;x++){var k=firstOpen(BLOCKS[x].name); if(k<Q[BLOCKS[x].name].trialCount){b=x;i=k;return blockIntro(true);}}\n    about();\n  }\n  function intro(){\n    app.innerHTML='<h1>Cycling in Suzhou: which street feels safer, which feels more comfortable?</h1>'+\n      '<p>You will see pairs of 360° street panoramas from Gusu District, Suzhou. Imagine yourself <b>cycling</b> in each scene, not walking or driving, and click the street that fits the question better.</p>'+\n      '<div class=\"card\"><h2>Cycle lanes you will see</h2><ul>'+\n      '<li><b>Mixed road</b>: no cycle facility; bicycles share the road with cars.</li>'+\n      '<li><b>Painted cycle lane</b>: a cycle lane marked with painted lines.</li>'+\n      '<li><b>Physically segregated cycle lane</b>: separated from cars by a fence or a green belt.</li></ul>'+\n      '<p>There are '+total()+' pairs: '+Q.safety.trialCount+' about safety, then '+Q.comfort.trialCount+' about comfort. It takes about 6 minutes. There are no right or wrong answers.</p></div>'+\n      '<div class=\"card\"><p>'+esc(Q.consent.title)+'</p><div class=\"row\"><button class=\"btn\" id=\"yes\">'+esc(Q.consent.labelTrue||'I agree')+'</button></div><div class=\"err\"></div></div>';\n    document.getElementById('yes').onclick=function(){\n      SPSite.answer('consent',true).then(function(r){ if(r&&r.ok===false) return err(r.error); resume(); });\n    };\n  }\n  function blockIntro(){\n    var q=Q[BLOCKS[b].name];\n    app.innerHTML='<h1>'+esc(BLOCKS[b].label)+'</h1><div class=\"def\">'+esc(q.description)+'</div>'+\n      '<p>'+esc(q.title)+' Click the street you choose. '+q.trialCount+' pairs.</p><div class=\"row\"><button class=\"btn\" id=\"go\">Start</button></div>';\n    document.getElementById('go').onclick=trial;\n  }\n  function done_before(){var n=0;for(var x=0;x<b;x++)n+=Q[BLOCKS[x].name].trialCount;return n+i;}\n  function trial(){\n    var name=BLOCKS[b].name, q=Q[name];\n    if(i>=q.trialCount){ if(b+1<BLOCKS.length){b+=1;i=firstOpen(BLOCKS[b].name);return blockIntro();} return about(); }\n    var ch=choicesOf(q,i), media=mediaOf(q,i);\n    var html='<h1>'+esc(q.title)+'</h1><p>'+esc(BLOCKS[b].label)+' · pair '+(i+1)+' of '+q.trialCount+'</p>'+\n      '<div class=\"progress\" aria-hidden=\"true\"><i style=\"width:'+(100*done_before()/total())+'%\"></i></div><div class=\"pair\">';\n    ch.forEach(function(c,k){\n      var src=c.imageUrl||(media[k]&&media[k].url)||'';\n      if(k===1) html+='<div class=\"vs\">VS</div>';\n      html+='<button class=\"pick\" data-v=\"'+esc(c.value)+'\" aria-label=\"Street '+(k===0?'A':'B')+'\"><img src=\"'+esc(src)+'\" alt=\"Street panorama '+(k===0?'A':'B')+'\"><span>'+(k===0?'A':'B')+'</span></button>';\n    });\n    html+='</div>'+(i>0?'<div class=\"row\"><button class=\"btn ghost\" id=\"back\">Back</button></div>':'')+'<div class=\"err\"></div>';\n    app.innerHTML=html;\n    app.querySelectorAll('[data-v]').forEach(function(btn){\n      btn.onclick=function(){\n        var k=i; app.querySelectorAll('[data-v]').forEach(function(x){x.disabled=true;});\n        SPSite.answer(name,btn.getAttribute('data-v'),{trial:k}).then(function(r){\n          if(r&&r.ok===false){err(r.error);app.querySelectorAll('[data-v]').forEach(function(x){x.disabled=false;});return;}\n          done[name][k]=true; i=k+1; trial();\n        });\n      };\n    });\n    var back=document.getElementById('back'); if(back) back.onclick=function(){i-=1;trial();};\n    window.scrollTo(0,0);\n  }\n  function radios(q){return '<div class=\"q\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q.name+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function yesno(q){return '<div class=\"q\"><b>'+esc(q.title)+'</b><label class=\"opt\"><input type=\"radio\" name=\"'+q.name+'\" value=\"1\"> '+esc(q.labelTrue||'Yes')+'</label><label class=\"opt\"><input type=\"radio\" name=\"'+q.name+'\" value=\"0\"> '+esc(q.labelFalse||'No')+'</label></div>';}\n  function about(){\n    app.innerHTML='<h1>About you</h1><p>Optional, used only to describe the sample.</p><div class=\"card\">'+\n      radios(Q.gender)+'<div class=\"q\"><b>'+esc(Q.age.title)+'</b><input type=\"number\" id=\"age\" min=\"16\" max=\"99\" inputmode=\"numeric\"></div>'+\n      radios(Q.background)+yesno(Q.cycled_last_week)+yesno(Q.knows_suzhou)+\n      '<div class=\"row\"><button class=\"btn\" id=\"finish\">Finish</button></div><div class=\"err\"></div></div>';\n    ['gender','background'].forEach(function(n){app.querySelectorAll('input[name='+n+']').forEach(function(r){r.onchange=function(){SPSite.answer(n,r.value).then(function(x){if(x&&x.ok===false)err(x.error);});};});});\n    ['cycled_last_week','knows_suzhou'].forEach(function(n){app.querySelectorAll('input[name='+n+']').forEach(function(r){r.onchange=function(){SPSite.answer(n,r.value==='1').then(function(x){if(x&&x.ok===false)err(x.error);});};});});\n    var age=document.getElementById('age');\n    age.onchange=function(){var v=age.value===''?null:Number(age.value);SPSite.answer('age',v).then(function(x){if(x&&x.ok===false)err(x.error);else err('');});};\n    document.getElementById('finish').onclick=function(){\n      var btn=this; btn.disabled=true; err('Submitting…');\n      SPSite.complete().then(function(r){\n        if(r&&r.ok===false){ btn.disabled=false; err(r.error||('Please answer: '+(r.missing||[]).join(', '))); var m=r.missing||[]; if(m.indexOf('consent')>=0) intro(); else if(m.indexOf('safety')>=0||m.indexOf('comfort')>=0) resume(); }\n      });\n    };\n  }\n  SPSite.onReady(function(ctx){\n    ['consent','safety','comfort','gender','age','background','cycled_last_week','knows_suzhou'].forEach(function(n){Q[n]=SPSite.getQuestion(n);});\n    var a=(ctx&&ctx.answers)||{};\n    BLOCKS.forEach(function(B){var p=a[B.name];var list=p&&Array.isArray(p.trials)?p.trials:(Array.isArray(p)?p:[]);list.forEach(function(t,k){var v=t&&typeof t==='object'?t.value:t;if(v!=null&&v!=='')done[B.name][k]=true;});});\n    if(a.consent===true) resume(); else intro();\n  });\n})();\n</script>\n</body>\n</html>\n",
