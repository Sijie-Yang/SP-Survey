   "id": "site-c7bad2cacd1cabaa",
   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Small Urban Parks</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Small Urban Parks: Perceived Restorativeness of Four Park Types\",\n  \"description\": \"Method replication with the paper's own photographs: participants view the 24 stimulus photographs of small urban parks in Fuzhou, six for each of four park types (pocket parks, linear riverside parks, community parks, small comprehensive parks). The four types come in random order; within each type the six photos appear in random order for 10 s each with a 5 s pause, as in the paper. After each type, participants rate it on the Perceived Restorativeness Scale (being away, fascination, coherence, compatibility). Rebuilt from Weng, Chen, Lin, Chi & Li (2025), Frontiers in Public Health 13: 1667502, with the stimuli printed in its Figure 2 (CC BY 4.0). Analysis as in the paper: mean of each PRS dimension per park type; repeated-measures comparison of park types with gender as a covariate (the paper used MANCOVA and Bonferroni post-hoc tests). Differences from the original study: (1) the paper does not print its PRS items or scale length; the English 16-item wording comes from Frontiers in Public Health 10:801453 (Table 5) and the 1-7 range is our choice; (2) no eye tracking, skin conductance or heart-rate variability; (3) no backward digit-span stress induction before viewing and no 5-min washout between park types; (4) photos are cropped from the published figure (about 420 x 230 px) rather than the 3200 x 1800 px originals; (5) the paper measured the scales before and after viewing; here PRS is asked once after each park type.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"parks\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 16,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"description\": \"The paper used gender as a covariate.\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"parks\",\n    \"elements\": [\n     {\n      \"type\": \"matrix\",\n      \"name\": \"prs\",\n      \"title\": \"Thinking of the six park photos you just saw, how much does each statement describe this kind of park? (1 = not at all, 7 = completely)\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"ba1\",\n        \"text\": \"It is an escape experience.\"\n       },\n       {\n        \"value\": \"ba2\",\n        \"text\": \"It gives me a good break from day-to-day routine.\"\n       },\n       {\n        \"value\": \"fa1\",\n        \"text\": \"The setting has fascinating qualities.\"\n       },\n       {\n        \"value\": \"fa2\",\n        \"text\": \"My attention is drawn to many interesting things.\"\n       },\n       {\n        \"value\": \"fa3\",\n        \"text\": \"I would like to get to know this place better.\"\n       },\n       {\n        \"value\": \"fa4\",\n        \"text\": \"There is much to explore and discover here.\"\n       },\n       {\n        \"value\": \"fa5\",\n        \"text\": \"I would like to spend more time looking at the surroundings.\"\n       },\n       {\n        \"value\": \"co1\",\n        \"text\": \"There is too much going on.\"\n       },\n       {\n        \"value\": \"co2\",\n        \"text\": \"It is a confusing place.\"\n       },\n       {\n        \"value\": \"co3\",\n        \"text\": \"There is a great deal of distraction.\"\n       },\n       {\n        \"value\": \"co4\",\n        \"text\": \"It is chaotic here.\"\n       },\n       {\n        \"value\": \"cp1\",\n        \"text\": \"I can do things I like here.\"\n       },\n       {\n        \"value\": \"cp2\",\n        \"text\": \"I have a sense that I belong here.\"\n       },\n       {\n        \"value\": \"cp3\",\n        \"text\": \"I have a sense of oneness with this setting.\"\n       },\n       {\n        \"value\": \"cp4\",\n        \"text\": \"Being here suits my personality.\"\n       },\n       {\n        \"value\": \"cp5\",\n        \"text\": \"I could find ways to enjoy myself in a place like this.\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"6\"\n       },\n       {\n        \"value\": 7,\n        \"text\": \"7\"\n       }\n      ],\n      \"description\": \"16-item Perceived Restorativeness Scale (Hartig et al.): being away ba1-ba2, fascination fa1-fa5, coherence co1-co4, compatibility cp1-cp5. The paper used the Chinese version validated by Wang et al. but does not print its items or the scale length; this English wording is the 16-item version listed in Frontiers in Public Health 10:801453 (Table 5), and the 1-7 range is our choice. Coherence items are negatively worded: reverse-code them (8 - response) before averaging. Keyed by park type: pocket, riverside (linear riverside / waterfront park), community, comprehensive (small comprehensive park); shown = the six photos of that type.\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"parks-original\">{\"source\": \"Weng, Chen, Lin, Chi & Li (2025) Frontiers in Public Health 13: 1667502\", \"n\": 55, \"participants\": \"55 Fuzhou residents; lab study with eye tracking, SCL and HRV after a backward digit-span stress task; 12 parks, 3 per type, 6 photos per type\", \"prs_means_table5\": {\"pocket\": {\"being_away\": 4.56, \"fascination\": 4.03, \"coherence\": 3.03, \"compatibility\": 3.81}, \"riverside\": {\"being_away\": 4.64, \"fascination\": 3.83, \"coherence\": 2.79, \"compatibility\": 3.59}, \"community\": {\"being_away\": 4.36, \"fascination\": 4.0, \"coherence\": 3.05, \"compatibility\": 3.95}, \"comprehensive\": {\"being_away\": 4.77, \"fascination\": 4.45, \"coherence\": 3.08, \"compatibility\": 4.35}}, \"result\": \"Park type and gender both affected restoration (MANCOVA p < 0.001). Small comprehensive parks scored highest on being away, fascination and compatibility and had the lowest skin conductance and LF/HF; linear riverside parks were best for physiological balance; pocket and community parks were weaker. Women reported higher restorativeness. Looking at vegetation was the strongest positive predictor of restoration.\"}</script>\n<style>\n:root{--bg:#eff4f0;--card:#fff;--ink:#1b241e;--muted:#58665c;--accent:#2f6f57;--line:#d6e0d9;--warn:#b3261e;--sel:#e1efe8}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.view{position:fixed;inset:0;background:#000;display:flex;align-items:center;justify-content:center;z-index:5}\n.view img{width:min(96vw,900px);height:auto;display:block}\n.view .t{position:absolute;bottom:10px;left:0;right:0;text-align:center;color:#999;font-size:.85rem}\n.strip{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;margin-bottom:10px}\n.strip img{width:100%;border-radius:5px;display:block}\n.it{margin-top:12px;padding-top:10px;border-top:1px solid var(--line)}\n.row{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;margin-top:6px}\n.row label{display:flex;flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:8px;padding:5px 0;cursor:pointer;font-size:.85rem}\n.row label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.row input{margin:0 0 2px}\n.ends{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);margin-top:2px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:760px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Weng, Chen, Lin, Chi &amp; Li (2025), Frontiers in Public Health 13: 1667502, Figure 2 (doi:10.3389/fpubh.2025.1667502, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='small-parks-prs:state', T=window.__VIEWMS?{view:window.__VIEWMS,gap:window.__VIEWMS}:{view:10000,gap:5000};\n  var TYPES=['pocket','riverside','community','comprehensive'];\n  var app=document.getElementById('app'), Q={}, files={}, groups={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function intro(){\n    app.innerHTML='<h1>Small urban parks</h1><p>You will see photographs of four kinds of small city parks in Fuzhou, China, six photos per kind. Each photo is shown for 10 seconds with a short dark pause in between; just look and imagine being there. After each set of six, you answer 16 short statements about that kind of park. It takes about 12 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"16\" max=\"110\"></div>'+radios('gender')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var age=Number(document.getElementById('age').value),g=val('gender');\n      if(!(age>=16&&age<=110))return err('Please enter your age.');if(!g)return err('Please choose an option.');\n      send([SPSite.answer('age',age),SPSite.answer('gender',g)],this,function(){st.step='block';st.b=0;st.k=0;st.phase='view';save();route();});\n    };\n  }\n  function block(){\n    if(st.phase==='q')return rate();\n    var t=st.blocks[st.b],list=st.order[t],v=document.createElement('div');v.className='view';app.innerHTML='';app.appendChild(v);\n    function show(){\n      if(st.k>=list.length){st.phase='q';save();return route();}\n      var id=list[st.k];v.innerHTML='<img alt=\"Park photograph\" src=\"'+esc(files[id].url)+'\"><div class=\"t\">Park set '+(st.b+1)+' of '+st.blocks.length+' · photo '+(st.k+1)+' of '+list.length+'</div>';\n      setTimeout(function(){v.innerHTML='';st.k++;save();setTimeout(show,T.gap);},T.view);\n    }\n    show();\n  }\n  function rate(){\n    var t=st.blocks[st.b],list=st.order[t],q=Q.prs,h='';\n    (q.rows||[]).forEach(function(r){var x='<div class=\"row\">';for(var i=1;i<=7;i++)x+='<label><input type=\"radio\" name=\"p_'+r.value+'\" value=\"'+i+'\">'+i+'</label>';\n      h+='<div class=\"it\"><b>'+esc(r.text)+'</b>'+x+'</div><div class=\"ends\"><span>Not at all</span><span>Completely</span></div></div>';});\n    app.innerHTML='<div class=\"prog\">Park set '+(st.b+1)+' of '+st.blocks.length+'</div><div class=\"card\"><div class=\"strip\">'+list.map(function(id){return '<img alt=\"Park photograph\" src=\"'+esc(files[id].url)+'\">';}).join('')+'</div><p style=\"color:var(--ink)\">'+esc(q.title)+'</p>'+h+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">'+(st.b+1<st.blocks.length?'Next park set':'Finish')+'</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var ans={},miss=(q.rows||[]).filter(function(r){var x=val('p_'+r.value);if(x!=null)ans[r.value]=Number(x);return x==null;});\n      if(miss.length)return err('Please answer all '+q.rows.length+' statements ('+miss.length+' left).');\n      send([SPSite.answer('prs',ans,{key:t,shown:list.map(function(id){return files[id].name;})})],this,function(){st.b++;st.k=0;st.phase='view';if(st.b>=st.blocks.length)st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='block')return block();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','prs'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('parks')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name)){var k=f.name.replace(/\\.[^.]+$/,''),t=k.split('_')[0];files[k]=f;(groups[t]=groups[t]||[]).push(k);}});\n    var types=TYPES.filter(function(t){return groups[t]&&groups[t].length;});\n    if(!types.length){app.innerHTML='<h1>Photos missing</h1><p>Upload the photographs to the media folder \"parks\" (names like pocket_1.jpg).</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var valid=st&&st.blocks&&st.blocks.length===types.length&&st.blocks.every(function(t){return st.order[t]&&st.order[t].every(function(x){return files[x];});});\n    if(!valid){var o={};types.forEach(function(t){o[t]=shuffle(groups[t]);});st={step:'intro',blocks:shuffle(types),order:o,b:0,k:0,phase:'view'};}\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.b=0;st.k=0;}\n    if(st.step==='block'&&st.phase!=='q'){st.phase='view';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
