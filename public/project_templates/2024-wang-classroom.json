   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Classroom Design</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Classroom Design for Concentration and Creativity\",\n  \"description\": \"Faithful replication with the original images: 19 rendered views of the same university classroom (48 seats). Sixteen combine four design elements in two levels each, space shape (curvilinear / rectilinear walls, ceiling lights and table corners), furniture arrangement (collaborative clusters / traditional front-facing rows), ceiling height (4 m / 2.7 m) and wall colour (deep blue 8.7B 4/5 / deep red 2.5R 4/8); three more show a rectilinear traditional low room with white walls (A17), with a full glass wall onto trees (A18) and a curvilinear collaborative high blue room without windows (A19). As in the paper, participants first see a grey screen for 15 s and then each classroom for 15 s with a 15 s grey screen between them (about 10 minutes, in random order). Afterwards they choose, from all 19 classrooms shown side by side, the one where they feel they could concentrate best and the one where they could be most creative, and answer age, gender and whether they study a housing or interior design-related field. Rebuilt from Wang, Cho & Hong (2024), Brain and Subjective Responses to Indoor Environments Related to Concentration and Creativity, Sensors 24(23): 7838, with the images taken from its Table 2 (CC BY 4.0). Image ids follow the paper's codes A1-A19 (see its Table 2: A1 = curvilinear, traditional, low, red; A4 = curvilinear, collaborative, high, blue; A17 white walls; A18 glass wall with nature view). Analysis as in the paper: frequency of each classroom chosen for concentration and for creativity, compared by design element; the paper (20 students and staff) found the white-walled traditional classroom A17 chosen most for concentration (45%, then A12 20%) and the nature-view classroom A18 most for creativity (45%, then A4 25%), with front-facing rows linked to concentration and curvilinear, collaborative rooms to creativity. Differences from the original study: (1) online, without the EEG recording (concentration index and relative theta), the 30 s eyes-closed rest and the on-screen guides; (2) the paper used two fixed presentation orders (sets A and B) that it does not print, so the order is random here; (3) the paper does not print the post-survey questions, so the wording of the two choice questions and of the age, gender and field-of-study questions is ours; (4) the images are the copies printed in Table 2 (about 420 px wide), not the full renders; (5) the paper's participants were 20 students and staff at one Korean university aged 18-29; anyone can take part here.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"classrooms\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"choose\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"concentration\",\n      \"title\": \"In which classroom do you feel you could concentrate best?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"A1\",\n        \"text\": \"A1\"\n       },\n       {\n        \"value\": \"A2\",\n        \"text\": \"A2\"\n       },\n       {\n        \"value\": \"A3\",\n        \"text\": \"A3\"\n       },\n       {\n        \"value\": \"A4\",\n        \"text\": \"A4\"\n       },\n       {\n        \"value\": \"A5\",\n        \"text\": \"A5\"\n       },\n       {\n        \"value\": \"A6\",\n        \"text\": \"A6\"\n       },\n       {\n        \"value\": \"A7\",\n        \"text\": \"A7\"\n       },\n       {\n        \"value\": \"A8\",\n        \"text\": \"A8\"\n       },\n       {\n        \"value\": \"A9\",\n        \"text\": \"A9\"\n       },\n       {\n        \"value\": \"A10\",\n        \"text\": \"A10\"\n       },\n       {\n        \"value\": \"A11\",\n        \"text\": \"A11\"\n       },\n       {\n        \"value\": \"A12\",\n        \"text\": \"A12\"\n       },\n       {\n        \"value\": \"A13\",\n        \"text\": \"A13\"\n       },\n       {\n        \"value\": \"A14\",\n        \"text\": \"A14\"\n       },\n       {\n        \"value\": \"A15\",\n        \"text\": \"A15\"\n       },\n       {\n        \"value\": \"A16\",\n        \"text\": \"A16\"\n       },\n       {\n        \"value\": \"A17\",\n        \"text\": \"A17\"\n       },\n       {\n        \"value\": \"A18\",\n        \"text\": \"A18\"\n       },\n       {\n        \"value\": \"A19\",\n        \"text\": \"A19\"\n       }\n      ],\n      \"description\": \"One of the 19 classrooms (image id A1-A19), all shown at once.\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"creativity\",\n      \"title\": \"In which classroom do you feel you could be most creative?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"A1\",\n        \"text\": \"A1\"\n       },\n       {\n        \"value\": \"A2\",\n        \"text\": \"A2\"\n       },\n       {\n        \"value\": \"A3\",\n        \"text\": \"A3\"\n       },\n       {\n        \"value\": \"A4\",\n        \"text\": \"A4\"\n       },\n       {\n        \"value\": \"A5\",\n        \"text\": \"A5\"\n       },\n       {\n        \"value\": \"A6\",\n        \"text\": \"A6\"\n       },\n       {\n        \"value\": \"A7\",\n        \"text\": \"A7\"\n       },\n       {\n        \"value\": \"A8\",\n        \"text\": \"A8\"\n       },\n       {\n        \"value\": \"A9\",\n        \"text\": \"A9\"\n       },\n       {\n        \"value\": \"A10\",\n        \"text\": \"A10\"\n       },\n       {\n        \"value\": \"A11\",\n        \"text\": \"A11\"\n       },\n       {\n        \"value\": \"A12\",\n        \"text\": \"A12\"\n       },\n       {\n        \"value\": \"A13\",\n        \"text\": \"A13\"\n       },\n       {\n        \"value\": \"A14\",\n        \"text\": \"A14\"\n       },\n       {\n        \"value\": \"A15\",\n        \"text\": \"A15\"\n       },\n       {\n        \"value\": \"A16\",\n        \"text\": \"A16\"\n       },\n       {\n        \"value\": \"A17\",\n        \"text\": \"A17\"\n       },\n       {\n        \"value\": \"A18\",\n        \"text\": \"A18\"\n       },\n       {\n        \"value\": \"A19\",\n        \"text\": \"A19\"\n       }\n      ],\n      \"description\": \"One of the 19 classrooms (image id A1-A19), all shown at once.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 16,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"design_major\",\n      \"title\": \"Do you study or work in a housing, interior or architectural design-related field?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"classroom-design-original\">{\"source\": \"Wang, Cho & Hong (2024) Sensors 24(23): 7838\", \"n\": 20, \"codes\": {\"A1\": \"S1/FA0/CH0/C0\", \"A2\": \"S1/FA1/CH0/C0\", \"A3\": \"S1/FA1/CH1/C0\", \"A4\": \"S1/FA1/CH1/C1\", \"A5\": \"S1/FA0/CH1/C1\", \"A6\": \"S1/FA1/CH0/C1\", \"A7\": \"S1/FA0/CH0/C1\", \"A8\": \"S1/FA0/CH1/C0\", \"A9\": \"S0/FA1/CH0/C0\", \"A10\": \"S0/FA1/CH1/C0\", \"A11\": \"S0/FA1/CH1/C1\", \"A12\": \"S0/FA0/CH1/C1\", \"A13\": \"S0/FA0/CH0/C1\", \"A14\": \"S0/FA1/CH0/C1\", \"A15\": \"S0/FA0/CH1/C0\", \"A16\": \"S0/FA0/CH0/C0\", \"A17\": \"S0/FA0/CH0/White\", \"A18\": \"S0/FA0/CH0/Window\", \"A19\": \"S1/FA1/CH1/C1 No-Window\"}, \"code_key\": \"S 1 curvilinear 0 rectilinear; FA 1 collaborative 0 traditional; CH 1 high 4 m 0 low 2.7 m; C 1 deep blue 0 deep red\", \"results\": {\"concentration\": {\"A17\": 0.45, \"A12\": 0.2, \"A7\": 0.1, \"A8\": 0.1, \"A5\": 0.05, \"A16\": 0.05, \"A19\": 0.05}, \"creativity\": {\"A18\": 0.45, \"A4\": 0.25, \"A11\": 0.1, \"A3\": 0.1, \"A1\": 0.05, \"A6\": 0.05}}}</script>\n<style>\n:root{--bg:#f1f2ef;--card:#fff;--ink:#1f2220;--muted:#5d625e;--accent:#2f6f62;--line:#d8dcd7;--warn:#b3261e;--sel:#dcefe9}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:980px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.view{position:fixed;inset:0;background:#808080;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:5;gap:12px}\n.view img{width:100vw;height:auto;max-height:86vh;object-fit:contain;display:block}\n.view .t{color:#eee;font-size:.85rem;min-height:1.2em}\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px;margin-top:8px}\n.grid label{display:block;border:2px solid transparent;border-radius:10px;padding:4px;cursor:pointer;background:#fafafa}\n.grid label:has(input:checked){border-color:var(--accent);background:var(--sel)}\n.grid img{width:100%;aspect-ratio:1.85;object-fit:cover;display:block;border-radius:6px}\n.grid span{display:flex;gap:6px;align-items:center;font-size:.85rem;color:var(--muted);padding:3px 2px 0}\n.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:10px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}.f:first-child{margin-top:0}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:980px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Images: Wang, Cho &amp; Hong (2024), Sensors 24(23): 7838, Table 2 (doi:10.3390/s24237838, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='classroom-design:state', T={view:window.__VIEWMS||15000,grey:window.__VIEWMS?20:15000};\n  var IDS=[];for(var i=1;i<=19;i++)IDS.push('A'+i);\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function fresh(){return {step:'intro',order:shuffle(IDS),grid:shuffle(IDS),k:0,phase:'grey'};}\n  function intro(){\n    app.innerHTML='<h1>Classrooms</h1><p>You will see '+IDS.length+' pictures of a university classroom that differ in shape, furniture layout, ceiling height and colour. Each picture stays on screen for 15 seconds, with a 15-second grey screen before it. Just look at each one and imagine sitting in that classroom; the page moves on by itself (about 10 minutes). Afterwards you will pick the classroom where you could concentrate best and the one where you could be most creative.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='view';st.phase='grey';save();route();});};\n  }\n  function timer(ms,label,done){var end=Date.now()+ms,tm=document.getElementById('tm');(function tick(){var s=Math.ceil((end-Date.now())/1000);if(s<=0)return done();if(tm)tm.textContent=label(s);setTimeout(tick,250);})();}\n  function view(){\n    if(st.k>=st.order.length){st.step='choose';save();return route();}\n    var id=st.order[st.k],v=document.createElement('div');v.className='view';app.innerHTML='';app.appendChild(v);\n    if(st.phase==='grey'){v.innerHTML='<div class=\"t\" id=\"tm\"></div>';var p=new Image();p.src=files[id].url;return timer(T.grey,function(){return '';},function(){st.phase='img';save();route();});}\n    v.innerHTML='<img alt=\"Classroom\" src=\"'+esc(files[id].url)+'\"><div class=\"t\" id=\"tm\"></div>';\n    timer(T.view,function(){return 'Classroom '+(st.k+1)+' of '+st.order.length;},function(){st.k++;st.phase='grey';save();route();});\n  }\n  function grid(name){return '<div class=\"grid\" id=\"g_'+name+'\">'+st.grid.map(function(id,i){return '<label><img alt=\"Classroom '+(i+1)+'\" src=\"'+esc(files[id].url)+'\"><span><input type=\"radio\" name=\"'+name+'\" value=\"'+id+'\"> Classroom '+(i+1)+'</span></label>';}).join('')+'</div>';}\n  function choose(){\n    app.innerHTML='<h2>Your choice</h2><p>These are the '+IDS.length+' classrooms you saw. Click a picture to choose it.</p><div class=\"card\"><b>1. '+esc(Q.concentration.title)+'</b>'+grid('concentration')+'</div><div class=\"card\"><b>2. '+esc(Q.creativity.title)+'</b>'+grid('creativity')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var a=val('concentration'),b=val('creativity'),first=null;\n      ['concentration','creativity'].forEach(function(n){var g=document.getElementById('g_'+n);g.classList.remove('miss');if(!val(n)){g.classList.add('miss');if(!first)first=g;}});\n      if(first){first.scrollIntoView({block:'start'});return err('Please choose one classroom for each question.');}\n      var shown=st.grid.map(function(id){return files[id].name;});\n      send([SPSite.answer('concentration',a,{shown:shown}),SPSite.answer('creativity',b,{shown:shown})],this,function(){st.step='about';save();route();});\n    };\n  }\n  function radios(q){return '<div class=\"f\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+esc(q.name)+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\" style=\"max-width:640px\"><div class=\"f\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"16\" max=\"110\"></div>'+radios(Q.gender)+radios(Q.design_major)+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var age=Number(document.getElementById('age').value),g=val('gender'),m=val('design_major');if(!(age>=16&&age<=110))return err('Please enter your age.');if(!g||!m)return err('Please answer every question.');\n      send([SPSite.answer('age',age),SPSite.answer('gender',g),SPSite.answer('design_major',m)],this,function(){st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var g=e.target.closest&&e.target.closest('.miss');if(g)g.classList.remove('miss');if(!app.querySelector('.miss'))err('');});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='view')return view();if(s==='choose')return choose();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','concentration','creativity','age','gender','design_major'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};Q[n].name=Q[n].name||n;});\n    (SPSite.getMedia('classrooms')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=IDS.filter(function(k){return !files[k];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"classrooms\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.order)||a.consent!==true)st=fresh();\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
