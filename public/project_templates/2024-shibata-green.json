   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Green Office Restorativeness</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Green Office Restorativeness (IRCS)\",\n  \"description\": \"Participants see five office photographs drawn at random from twelve, one at a time, imagine being in each room and rate the 11 items of the Indoor Restorative Characteristic Scale (Being Away, Fascination, Extent) on a 1-5 scale. Rebuilt from Shibata et al. (2024), Frontiers in Psychology 15: 1443540, with the items from the paper's Supplementary Data Sheet 1 and the office photographs printed in its Figures 1 and 3 (CC BY 4.0). Scoring: mean of each subscale (ex8 and ex9 reversed), overall restorativeness = mean of the three subscales.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"offices\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"offices\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"ba1\",\n      \"title\": \"This place allows me to escape from work and daily life.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much\",\n      \"isRequired\": true,\n      \"description\": \"Being Away. Keyed by office photo (office1-office8 = paper Figure 1, photo1-photo4 = paper Figure 3); 1 = not at all, 5 = very much.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"ba7\",\n      \"title\": \"This place helps me forget the hustle and bustle of everyday life.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much\",\n      \"isRequired\": true,\n      \"description\": \"Being Away. Keyed by office photo (office1-office8 = paper Figure 1, photo1-photo4 = paper Figure 3); 1 = not at all, 5 = very much.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"ba9\",\n      \"title\": \"This is a place where I can refresh my mood.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much\",\n      \"isRequired\": true,\n      \"description\": \"Being Away. Keyed by office photo (office1-office8 = paper Figure 1, photo1-photo4 = paper Figure 3); 1 = not at all, 5 = very much.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"ba10\",\n      \"title\": \"This is the place where I want to be when my mind is tired.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much\",\n      \"isRequired\": true,\n      \"description\": \"Being Away. Keyed by office photo (office1-office8 = paper Figure 1, photo1-photo4 = paper Figure 3); 1 = not at all, 5 = very much.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"fs2\",\n      \"title\": \"This place stimulates my curiosity.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much\",\n      \"isRequired\": true,\n      \"description\": \"Fascination. Keyed by office photo (office1-office8 = paper Figure 1, photo1-photo4 = paper Figure 3); 1 = not at all, 5 = very much.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"fs3\",\n      \"title\": \"This is a place where various discoveries can be made.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much\",\n      \"isRequired\": true,\n      \"description\": \"Fascination. Keyed by office photo (office1-office8 = paper Figure 1, photo1-photo4 = paper Figure 3); 1 = not at all, 5 = very much.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"fs4\",\n      \"title\": \"This is a place where several things catch my interest.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much\",\n      \"isRequired\": true,\n      \"description\": \"Fascination. Keyed by office photo (office1-office8 = paper Figure 1, photo1-photo4 = paper Figure 3); 1 = not at all, 5 = very much.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"fs8\",\n      \"title\": \"This seems like a place where many interesting things could happen.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much\",\n      \"isRequired\": true,\n      \"description\": \"Fascination. Keyed by office photo (office1-office8 = paper Figure 1, photo1-photo4 = paper Figure 3); 1 = not at all, 5 = very much.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"ex1\",\n      \"title\": \"This place feels spacious.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much\",\n      \"isRequired\": true,\n      \"description\": \"Extent. Keyed by office photo (office1-office8 = paper Figure 1, photo1-photo4 = paper Figure 3); 1 = not at all, 5 = very much.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"ex8\",\n      \"title\": \"This place feels cramped.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much\",\n      \"isRequired\": true,\n      \"description\": \"Extent (reverse-scored). Keyed by office photo (office1-office8 = paper Figure 1, photo1-photo4 = paper Figure 3); 1 = not at all, 5 = very much.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"ex9\",\n      \"title\": \"This place feels stifling.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much\",\n      \"isRequired\": true,\n      \"description\": \"Extent (reverse-scored). Keyed by office photo (office1-office8 = paper Figure 1, photo1-photo4 = paper Figure 3); 1 = not at all, 5 = very much.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"attention_check\",\n      \"title\": \"Please select 'Very much' (5) for this item.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much\",\n      \"isRequired\": true,\n      \"description\": \"Instructed attention check shown once, among the items of one random office; correct answer = 5.\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"office-original\">{\"source\": \"Shibata, Tokuhiro, Ikeuchi, Ito, Kaji & Muramatsu (2024) Frontiers in Psychology 15: 1443540\", \"study1\": {\"n_recruited\": 1241, \"participants\": \"Japanese adults aged 30-59, Yahoo Crowd Sourcing\", \"design\": \"one of 8 office photos (Figure 1) per participant, 30 candidate items + 5-item restorative experience scale\", \"means\": {\"overall\": 2.8, \"being_away\": 2.64, \"fascination\": 2.62, \"extent\": 3.15}}, \"study2\": {\"n_recruited\": 1500, \"design\": \"60 office photos in 12 groups of 5 graded by greenery; each participant rated one group on the 11 IRCS items, photo and item order randomised\", \"result\": \"More greenery (square root of green-pixel share) went with higher overall restorativeness, Being Away and Fascination; colour fractal dimension and brightness fractal dimension were also selected as predictors by lasso regression.\"}}</script>\n<style>\n:root{--bg:#f4f5f2;--card:#fff;--ink:#1e2420;--muted:#5d675f;--accent:#2e6b4a;--line:#d9dfda;--warn:#b3261e;--sel:#e6f1ea}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.photo{width:100%;max-width:520px;border-radius:8px;display:block;margin:0 auto 12px}\n.ins{color:var(--ink);font-weight:500}\n.item{padding:12px 0;border-top:1px solid var(--line)}.item:first-of-type{border-top:0}\n.item b{display:block;margin-bottom:6px;font-weight:500}\n.sc{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}\n.sc label{display:flex;flex-direction:column;align-items:center;gap:2px;border:1px solid var(--line);border-radius:10px;padding:8px 2px;cursor:pointer;font-size:.8rem;text-align:center;line-height:1.2}\n.sc label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.sc input{margin:0}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Office photographs: Shibata, Tokuhiro, Ikeuchi, Ito, Kaji &amp; Muramatsu (2024), Frontiers in Psychology 15: 1443540, Figures 1 and 3 (CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='green-office:state', N_PHOTOS=5;\n  var app=document.getElementById('app'), Q={}, files={}, ids=[], st=null;\n  var ITEMS=['ba1','ba7','ba9','ba10','fs2','fs3','fs4','fs8','ex1','ex8','ex9'];\n  var LAB=['Not at all','','','','Very much'];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function scale(name,title){return '<div class=\"item\"><b>'+esc(title)+'</b><div class=\"sc\">'+LAB.map(function(s,i){return '<label><input type=\"radio\" name=\"'+name+'\" value=\"'+(i+1)+'\">'+(i+1)+(s?'<span>'+s+'</span>':'')+'</label>';}).join('')+'</div></div>';}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?Number(x.value):null;}\n  function intro(){\n    app.innerHTML='<h1>Office spaces</h1><p>You will see photographs of '+st.order.length+' offices, one at a time. For each one, imagine you are in the room and rate how much you experience a set of impressions. It takes about 8 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"110\"></div><div class=\"f\"><b>'+esc(Q.gender.title)+'</b>'+Q.gender.choices.map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"gender\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var age=Number(document.getElementById('age').value);if(!(age>=18&&age<=110))return err('Please enter your age.');\n      var g=app.querySelector('input[name=gender]:checked');if(!g)return err('Please choose an option.');\n      send([SPSite.answer('age',age),SPSite.answer('gender',g.value)],this,function(){st.step='trial';st.k=0;save();route();});\n    };\n  }\n  function trial(){\n    var id=st.order[st.k], rows=st.items.slice();\n    if(st.k===st.checkAt)rows.splice(st.checkPos,0,'attention_check');\n    app.innerHTML='<div class=\"prog\">Office '+(st.k+1)+' of '+st.order.length+'</div><div class=\"card\"><img class=\"photo\" alt=\"Office photograph\" src=\"'+esc(files[id].url)+'\"><p class=\"ins\">Imagine you are in the room shown in this picture. To what extent do you experience the impressions listed below in this room?</p>'+rows.map(function(n){return scale('q_'+n,Q[n].title);}).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var vals=rows.map(function(n){return val('q_'+n);});if(vals.some(function(x){return x==null;}))return err('Please answer every item.');\n      var sh=[files[id].name];\n      send(rows.map(function(n,i){return n==='attention_check'?SPSite.answer(n,vals[i]):SPSite.answer(n,vals[i],{key:id,shown:sh});}),this,function(){st.k++;if(st.k>=st.order.length)st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='trial')return trial();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','attention_check'].concat(ITEMS).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('offices')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name)){var k=f.name.replace(/\\.[^.]+$/,'');files[k]=f;ids.push(k);}});\n    if(ids.length<2){app.innerHTML='<h1>Photos missing</h1><p>Upload office photographs to the media folder \"offices\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var valid=st&&st.order&&st.order.every(function(x){return files[x];});\n    if(!valid){var n=Math.min(N_PHOTOS,ids.length),order=shuffle(ids).slice(0,n);\n      st={step:'intro',order:order,items:shuffle(ITEMS),k:0,checkAt:Math.floor(Math.random()*n),checkPos:1+Math.floor(Math.random()*(ITEMS.length-1))};}\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
