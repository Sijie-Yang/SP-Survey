   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Soundscapes</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Birdsongs vs Traffic Noise\",\n  \"description\": \"Participants rate their mood and state paranoia, listen with headphones to one of four 6-minute soundscapes (birdsongs or traffic noise, each in a low- and a high-diversity version), rate mood and paranoia again, and finally rate how diverse, beautiful and pleasant the soundscape was. Rebuilt from Stobbe, Sundermann, Ascone & Kühn (2022), Scientific Reports 12: 16414, with the authors' four soundscapes (OSF 4y3vh).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"sounds\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part, I am using headphones, and I understand my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 99\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"state\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"anx_tense\",\n      \"title\": \"I feel tense.\",\n      \"description\": \"Right now. 1 = not at all, 4 = strongly applies. Anxiety item (written for this template; the paper used the STADI state anxiety scale). Keyed 'pre' / 'post'.\",\n      \"rateMin\": 1,\n      \"rateMax\": 4,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Strongly applies\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"anx_worried\",\n      \"title\": \"I am worried.\",\n      \"description\": \"Right now. 1 = not at all, 4 = strongly applies. Anxiety item (written for this template; the paper used the STADI state anxiety scale). Keyed 'pre' / 'post'.\",\n      \"rateMin\": 1,\n      \"rateMax\": 4,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Strongly applies\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"anx_nervous\",\n      \"title\": \"I feel nervous.\",\n      \"description\": \"Right now. 1 = not at all, 4 = strongly applies. Anxiety item (written for this template; the paper used the STADI state anxiety scale). Keyed 'pre' / 'post'.\",\n      \"rateMin\": 1,\n      \"rateMax\": 4,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Strongly applies\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"dep_sad\",\n      \"title\": \"I feel sad.\",\n      \"description\": \"Right now. 1 = not at all, 4 = strongly applies. Depression item (written for this template; the paper used the STADI state depression scale). Keyed 'pre' / 'post'.\",\n      \"rateMin\": 1,\n      \"rateMax\": 4,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Strongly applies\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"dep_down\",\n      \"title\": \"I feel down.\",\n      \"description\": \"Right now. 1 = not at all, 4 = strongly applies. Depression item (written for this template; the paper used the STADI state depression scale). Keyed 'pre' / 'post'.\",\n      \"rateMin\": 1,\n      \"rateMax\": 4,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Strongly applies\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"dep_cheerful\",\n      \"title\": \"I feel cheerful.\",\n      \"description\": \"Right now. 1 = not at all, 4 = strongly applies. Depression item, REVERSED when scoring (written for this template; the paper used the STADI state depression scale). Keyed 'pre' / 'post'.\",\n      \"rateMin\": 1,\n      \"rateMax\": 4,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Strongly applies\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"par_guard\",\n      \"title\": \"I need to be on my guard against others.\",\n      \"description\": \"Brief state Paranoia Checklist item quoted in the paper; agreement right now, 1–11. Keyed 'pre' / 'post'.\",\n      \"rateMin\": 1,\n      \"rateMax\": 11,\n      \"minRateDescription\": \"Do not agree at all\",\n      \"maxRateDescription\": \"Agree completely\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"par_critical\",\n      \"title\": \"Strangers and friends look at me critically.\",\n      \"description\": \"Brief state Paranoia Checklist item quoted in the paper; agreement right now, 1–11. Keyed 'pre' / 'post'.\",\n      \"rateMin\": 1,\n      \"rateMax\": 11,\n      \"minRateDescription\": \"Do not agree at all\",\n      \"maxRateDescription\": \"Agree completely\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"par_upset\",\n      \"title\": \"People try to upset me.\",\n      \"description\": \"Brief state Paranoia Checklist item quoted in the paper; agreement right now, 1–11. Keyed 'pre' / 'post'.\",\n      \"rateMin\": 1,\n      \"rateMax\": 11,\n      \"minRateDescription\": \"Do not agree at all\",\n      \"maxRateDescription\": \"Agree completely\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"listen\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"condition\",\n      \"title\": \"Soundscape heard (assigned at random by the page)\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"traffic_low\",\n        \"text\": \"Traffic noise, low diversity (8 car recordings)\"\n       },\n       {\n        \"value\": \"traffic_high\",\n        \"text\": \"Traffic noise, high diversity (siren, construction, trucks, train, motorcycle, airplane …)\"\n       },\n       {\n        \"value\": \"birdsong_low\",\n        \"text\": \"Birdsongs, low diversity (common chiffchaff and wood warbler)\"\n       },\n       {\n        \"value\": \"birdsong_high\",\n        \"text\": \"Birdsongs, high diversity (8 bird species)\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"listened_s\",\n      \"title\": \"Seconds of the soundscape actually played\",\n      \"description\": \"Recorded by the page; 364 = the whole file. Use it as the listening-compliance check.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"rate\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"sound_diverse\",\n      \"title\": \"How diverse or monotonous was the soundscape?\",\n      \"rateMin\": 0,\n      \"rateMax\": 100,\n      \"minRateDescription\": \"Very monotonous\",\n      \"maxRateDescription\": \"Very diverse\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"sound_beautiful\",\n      \"title\": \"How beautiful was the soundscape?\",\n      \"rateMin\": 0,\n      \"rateMax\": 100,\n      \"minRateDescription\": \"Not at all beautiful\",\n      \"maxRateDescription\": \"Very beautiful\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"sound_pleasant\",\n      \"title\": \"How pleasant was the soundscape?\",\n      \"rateMin\": 0,\n      \"rateMax\": 100,\n      \"minRateDescription\": \"Not at all pleasant\",\n      \"maxRateDescription\": \"Very pleasant\",\n      \"isRequired\": true\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"birdsong-original\">{\"source\": \"Stobbe et al. (2022) Sci Rep 12:16414\", \"n\": 295, \"groups\": {\"traffic_low\": 83, \"traffic_high\": 69, \"birdsong_low\": 63, \"birdsong_high\": 80}, \"result\": \"Traffic noise increased depression (small effect for low, medium for high diversity); high-diversity birdsong decreased depression; both birdsong soundscapes decreased anxiety and paranoia (medium effects); no effects on digit span or dual n-back.\"}</script>\n<style>\n:root{--bg:#f3f4f6;--card:#fff;--ink:#1f2430;--muted:#5d6472;--accent:#38607a;--line:#dbe0e7;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.1rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.item{padding:10px 0;border-top:1px solid var(--line)}.item:first-of-type{border-top:0}.item .t{margin-bottom:6px}.item.miss .t{color:var(--warn)}\n.scale{display:grid;gap:5px}.scale button{appearance:none;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:8px;padding:8px 0;font:inherit;font-weight:600;cursor:pointer}\n.scale button.on{background:var(--accent);border-color:var(--accent);color:#fff}\n.anch{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);margin-top:3px}\n.sec{font-weight:700;margin:4px 0 4px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.player{display:flex;flex-direction:column;align-items:center;gap:14px;padding:26px 10px}\n.play{width:88px;height:88px;border-radius:50%;border:0;background:var(--accent);color:#fff;font-size:2rem;cursor:pointer}\n.play:disabled{opacity:.4;cursor:default}\n.bar{width:100%;height:8px;background:var(--line);border-radius:4px;overflow:hidden}.bar>i{display:block;height:100%;width:0;background:var(--accent)}\n.time{font-variant-numeric:tabular-nums;color:var(--muted)}\n.sl{padding:10px 0;border-top:1px solid var(--line)}.sl:first-of-type{border-top:0}.sl .row{display:flex;gap:10px;align-items:center}.sl input{flex:1}\n.sl .v{width:3em;text-align:right;font-weight:600}.sl.unset .v{color:var(--muted)}.sl.unset input{opacity:.55}.sl.miss .t{color:var(--warn)}\n.credit{max-width:760px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Soundscapes: Stobbe, Sundermann, Ascone &amp; Kühn (2022), Scientific Reports 12:16414, OSF https://osf.io/4y3vh/ (built from xeno-canto and freesound recordings).</footer>\n<script>\n(function(){\n  var KEY='birdsong-traffic:state', MOOD=['anx_tense','anx_worried','anx_nervous','dep_sad','dep_down','dep_cheerful'], PAR=['par_guard','par_critical','par_upset'];\n  var CONDS=['traffic_low','traffic_high','birdsong_low','birdsong_high'], RATE=['sound_diverse','sound_beautiful','sound_pleasant'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null, audio=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function mmss(s){s=Math.max(0,Math.round(s));return Math.floor(s/60)+':'+('0'+s%60).slice(-2);}\n  function intro(){\n    app.innerHTML='<h1>Sounds and mood</h1><p>In this study you answer a few questions about how you feel, then listen to a 6-minute sound recording with headphones, and then answer the questions again. Please use headphones, sit somewhere quiet, and keep this tab open while the sound plays. It takes about 12 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"99\"></div><div class=\"f\"><b>'+esc(Q.gender.title)+'</b>'+(Q.gender.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"gender\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var age=Number(document.getElementById('age').value);if(!(age>=18&&age<=99))return err('Please enter your age (18 or older).');\n      var g=app.querySelector('input[name=gender]:checked');if(!g)return err('Please answer: '+Q.gender.title);\n      send([SPSite.answer('age',age),SPSite.answer('gender',g.value)],this,function(){st.step='pre';save();route();});\n    };\n  }\n  function row(n,max){var b='';for(var v=1;v<=max;v++)b+='<button type=\"button\" data-v=\"'+v+'\">'+v+'</button>';return '<div class=\"item\" data-k=\"'+n+'\"><div class=\"t\">'+esc(Q[n].title)+'</div><div class=\"scale\" style=\"grid-template-columns:repeat('+max+',1fr)\">'+b+'</div><div class=\"anch\"><span>'+esc(Q[n].minRateDescription)+'</span><span>'+esc(Q[n].maxRateDescription)+'</span></div></div>';}\n  function state(when){\n    var vals={};\n    app.innerHTML='<h2>'+(when==='pre'?'How do you feel right now?':'And how do you feel now, after listening?')+'</h2><div class=\"card\"><div class=\"sec\">Right now …</div>'+MOOD.map(function(n){return row(n,4);}).join('')+'</div><div class=\"card\"><div class=\"sec\">How much do you agree with these statements right now?</div>'+PAR.map(function(n){return row(n,11);}).join('')+'<div style=\"margin-top:12px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    app.querySelectorAll('.item').forEach(function(it){it.querySelectorAll('.scale button').forEach(function(b){b.onclick=function(){vals[it.dataset.k]=Number(b.dataset.v);it.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b);});it.classList.remove('miss');if(!app.querySelector('.item.miss'))err('');};});});\n    document.getElementById('go').onclick=function(){\n      var all=MOOD.concat(PAR),m=all.filter(function(n){return vals[n]==null;});\n      if(m.length){m.forEach(function(n){app.querySelector('.item[data-k=\"'+n+'\"]').classList.add('miss');});return err('Please answer every statement ('+m.length+' missing, marked in red).');}\n      send(all.map(function(n){return SPSite.answer(n,vals[n],{key:when});}),this,function(){st.step=(when==='pre'?'listen':'rate');save();route();});\n    };\n  }\n  function listen(){\n    var f=files[st.cond], played=0, last=null, done=false, TEST=window.__VIEWMS;\n    app.innerHTML='<h2>Listen</h2><p>Put on your headphones and set the volume to about 80% (a comfortable, clearly audible level). Press play and listen until the end. You cannot skip ahead; the Continue button unlocks when the recording has finished.</p><div class=\"card\"><div class=\"player\"><button class=\"play\" id=\"pl\" aria-label=\"Play\">▶</button><div class=\"bar\"><i id=\"bar\"></i></div><div class=\"time\" id=\"tm\">0:00 / 6:04</div></div><button class=\"btn\" id=\"go\" disabled>Continue</button><div class=\"err\"></div></div>';\n    var au=new Audio(f.url);audio=au;au.preload='auto';\n    var pl=document.getElementById('pl'),bar=document.getElementById('bar'),tm=document.getElementById('tm'),go=document.getElementById('go');\n    function upd(){var d=au.duration||364,t=au.currentTime||0;if(last!=null&&t>last&&t-last<2)played+=t-last;last=t;bar.style.width=Math.min(100,t/d*100)+'%';tm.textContent=mmss(t)+' / '+mmss(d);}\n    function fin(){if(done)return;done=true;played=Math.max(played,au.duration||0);pl.disabled=true;pl.textContent='✓';go.disabled=false;}\n    au.addEventListener('timeupdate',upd);au.addEventListener('ended',function(){upd();fin();});\n    au.addEventListener('seeking',function(){if(last!=null&&Math.abs(au.currentTime-last)>2)au.currentTime=last;});\n    pl.onclick=function(){if(au.paused){var p=au.play();if(p&&p.catch)p.catch(function(){err('The sound could not start. Check that your browser allows audio and try again.');});pl.textContent='❚❚';pl.setAttribute('aria-label','Pause');}else{au.pause();pl.textContent='▶';pl.setAttribute('aria-label','Play');}if(TEST)setTimeout(function(){played=364;fin();},TEST);};\n    go.onclick=function(){au.pause();send([SPSite.answer('condition',st.cond),SPSite.answer('listened_s',Math.round(played))],go,function(){st.step='post';save();route();});};\n  }\n  function rate(){\n    var vals={};\n    app.innerHTML='<h2>About the sound recording</h2><div class=\"card\">'+RATE.map(function(n){return '<div class=\"sl unset\" data-k=\"'+n+'\"><div class=\"t\">'+esc(Q[n].title)+'</div><div class=\"row\"><span class=\"anch\" style=\"margin:0\">'+esc(Q[n].minRateDescription)+'</span><input type=\"range\" min=\"0\" max=\"100\" value=\"50\" aria-label=\"'+esc(Q[n].title)+'\"><span class=\"anch\" style=\"margin:0\">'+esc(Q[n].maxRateDescription)+'</span><span class=\"v\">–</span></div></div>';}).join('')+'<div style=\"margin-top:12px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    app.querySelectorAll('.sl').forEach(function(s){var r=s.querySelector('input'),v=s.querySelector('.v');function set(){vals[s.dataset.k]=Number(r.value);v.textContent=r.value;s.classList.remove('unset','miss');}r.addEventListener('input',set);r.addEventListener('change',set);r.addEventListener('pointerdown',function(){setTimeout(set,0);});});\n    document.getElementById('go').onclick=function(){\n      var m=RATE.filter(function(n){return vals[n]==null;});\n      if(m.length){m.forEach(function(n){app.querySelector('.sl[data-k=\"'+n+'\"]').classList.add('miss');});return err('Please move every slider.');}\n      send(RATE.map(function(n){return SPSite.answer(n,vals[n]);}),this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(audio&&s!=='listen'){audio.pause();audio=null;}if(s==='about')return about();if(s==='pre')return state('pre');if(s==='listen')return listen();if(s==='post')return state('post');if(s==='rate')return rate();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','condition','listened_s'].concat(MOOD,PAR,RATE).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('sounds')||[]).forEach(function(f){var k=f.name.replace(/\\.[^.]+$/,'').toLowerCase();if(CONDS.indexOf(k)>=0)files[k]=f;});\n    var have=CONDS.filter(function(c){return files[c];});\n    if(!have.length){app.innerHTML='<h1>Sounds missing</h1><p>Upload the soundscapes to the media folder \"sounds\" as traffic_low.mp3, traffic_high.mp3, birdsong_low.mp3 and birdsong_high.mp3.</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!(st&&st.cond&&files[st.cond]))st={step:'intro',cond:have[Math.floor(Math.random()*have.length)]};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true)st.step='intro';\n    if(st.step==='listen'&&a.anx_tense==null)st.step='pre';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
