   "id": "site-d5f53a333e5ded65",
   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>City Birds Survey</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"City Birds: Seeing, Naming and Valuing Urban Birds\",\n  \"description\": \"Residents see photographs of nine common birds, say which they have seen and try to name each, then rate 14 statements on bird ecosystem services and disservices, a modified 14-item Nature Relatedness Scale, and five conservation questions. Rebuilt from Qian, Ma, Fu, Chen, Shen, Chen, Gui, Cai & Zhao (2026), Data in Brief 66: 112665 (Zhoushan, China), with the paper's Figure 1 bird photos (Wikimedia Commons, CC BY / CC BY-SA / public domain) and the item wording printed in its Tables 1-7. Analysis: frequencies per question, number of birds seen and correctly named, subscale means for services and disservices.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"birds\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part in this anonymous survey (if I am under 18, a parent or guardian has agreed too).\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Q1. Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age_group\",\n      \"title\": \"Q2. Age\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"under_18\",\n        \"text\": \"Under 18\"\n       },\n       {\n        \"value\": \"19_25\",\n        \"text\": \"19-25\"\n       },\n       {\n        \"value\": \"26_35\",\n        \"text\": \"26-35\"\n       },\n       {\n        \"value\": \"36_45\",\n        \"text\": \"36-45\"\n       },\n       {\n        \"value\": \"46_60\",\n        \"text\": \"46-60\"\n       },\n       {\n        \"value\": \"over_60\",\n        \"text\": \"Over 60\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Q3. Education\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"primary\",\n        \"text\": \"Primary school or below\"\n       },\n       {\n        \"value\": \"middle\",\n        \"text\": \"Middle school\"\n       },\n       {\n        \"value\": \"high\",\n        \"text\": \"High school / Technical school\"\n       },\n       {\n        \"value\": \"college\",\n        \"text\": \"College\"\n       },\n       {\n        \"value\": \"bachelor\",\n        \"text\": \"Bachelor's\"\n       },\n       {\n        \"value\": \"master\",\n        \"text\": \"Master's or above\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"occupation\",\n      \"title\": \"Q4. Occupation\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"fisher_farmer\",\n        \"text\": \"Fisher / Farmer\"\n       },\n       {\n        \"value\": \"migrant_worker\",\n        \"text\": \"Migrant worker\"\n       },\n       {\n        \"value\": \"government\",\n        \"text\": \"Government staff\"\n       },\n       {\n        \"value\": \"private_business\",\n        \"text\": \"Private business owner\"\n       },\n       {\n        \"value\": \"educator\",\n        \"text\": \"Educator\"\n       },\n       {\n        \"value\": \"student\",\n        \"text\": \"Student\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"income\",\n      \"title\": \"Q5. Annual household income\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"lt30k\",\n        \"text\": \"Less than 30,000 CNY\"\n       },\n       {\n        \"value\": \"30k_100k\",\n        \"text\": \"30,000-100,000 CNY\"\n       },\n       {\n        \"value\": \"100k_250k\",\n        \"text\": \"100,000-250,000 CNY\"\n       },\n       {\n        \"value\": \"250k_400k\",\n        \"text\": \"250,000-400,000 CNY\"\n       },\n       {\n        \"value\": \"gt400k\",\n        \"text\": \"More than 400,000 CNY\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"activities\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"act_gardening\",\n      \"title\": \"Q6a. Gardening (e.g., planting flowers)\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"never\",\n        \"text\": \"Never\"\n       },\n       {\n        \"value\": \"yearly_or_less\",\n        \"text\": \"Once a year or less\"\n       },\n       {\n        \"value\": \"several_year\",\n        \"text\": \"Several times a year\"\n       },\n       {\n        \"value\": \"monthly\",\n        \"text\": \"About 1-2 times a month\"\n       },\n       {\n        \"value\": \"weekly\",\n        \"text\": \"About 1-2 times a week\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"act_recreation\",\n      \"title\": \"Q6b. Nature-based recreation (e.g., birdwatching, hiking)\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"never\",\n        \"text\": \"Never\"\n       },\n       {\n        \"value\": \"yearly_or_less\",\n        \"text\": \"Once a year or less\"\n       },\n       {\n        \"value\": \"several_year\",\n        \"text\": \"Several times a year\"\n       },\n       {\n        \"value\": \"monthly\",\n        \"text\": \"About 1-2 times a month\"\n       },\n       {\n        \"value\": \"weekly\",\n        \"text\": \"About 1-2 times a week\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"act_films\",\n      \"title\": \"Q6c. Watching nature-related films or documentaries\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"never\",\n        \"text\": \"Never\"\n       },\n       {\n        \"value\": \"yearly_or_less\",\n        \"text\": \"Once a year or less\"\n       },\n       {\n        \"value\": \"several_year\",\n        \"text\": \"Several times a year\"\n       },\n       {\n        \"value\": \"monthly\",\n        \"text\": \"About 1-2 times a month\"\n       },\n       {\n        \"value\": \"weekly\",\n        \"text\": \"About 1-2 times a week\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"act_reading\",\n      \"title\": \"Q6d. Reading nature-related books, magazines, or websites\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"never\",\n        \"text\": \"Never\"\n       },\n       {\n        \"value\": \"yearly_or_less\",\n        \"text\": \"Once a year or less\"\n       },\n       {\n        \"value\": \"several_year\",\n        \"text\": \"Several times a year\"\n       },\n       {\n        \"value\": \"monthly\",\n        \"text\": \"About 1-2 times a month\"\n       },\n       {\n        \"value\": \"weekly\",\n        \"text\": \"About 1-2 times a week\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"birds\",\n    \"elements\": [\n     {\n      \"type\": \"checkbox\",\n      \"name\": \"bird_seen\",\n      \"title\": \"Q7. Which of these birds have you seen?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"a\",\n        \"text\": \"Bird a\"\n       },\n       {\n        \"value\": \"b\",\n        \"text\": \"Bird b\"\n       },\n       {\n        \"value\": \"c\",\n        \"text\": \"Bird c\"\n       },\n       {\n        \"value\": \"d\",\n        \"text\": \"Bird d\"\n       },\n       {\n        \"value\": \"e\",\n        \"text\": \"Bird e\"\n       },\n       {\n        \"value\": \"f\",\n        \"text\": \"Bird f\"\n       },\n       {\n        \"value\": \"g\",\n        \"text\": \"Bird g\"\n       },\n       {\n        \"value\": \"h\",\n        \"text\": \"Bird h\"\n       },\n       {\n        \"value\": \"i\",\n        \"text\": \"Bird i\"\n       },\n       {\n        \"value\": \"none\",\n        \"text\": \"None of the above\"\n       }\n      ],\n      \"description\": \"Pictures bird_a ... bird_i. bird_a Chinese Blackbird (Turdus mandarinus); bird_b Eurasian Tree Sparrow (Passer montanus); bird_c Little Egret (Egretta garzetta); bird_d Light-vented Bulbul (Pycnonotus sinensis); bird_e Spotted Dove (Streptopelia chinensis); bird_f Long-tailed Shrike (Lanius schach); bird_g Crested Myna (Acridotheres cristatellus); bird_h White Wagtail (Motacilla alba); bird_i Eurasian Hoopoe (Upupa epops)\"\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"bird_name\",\n      \"title\": \"Q8. What is this bird called?\",\n      \"isRequired\": true,\n      \"description\": \"Keyed by picture (bird_a ... bird_i); free text or '(don't know)'. Score as correct/incorrect against: bird_a Chinese Blackbird (Turdus mandarinus); bird_b Eurasian Tree Sparrow (Passer montanus); bird_c Little Egret (Egretta garzetta); bird_d Light-vented Bulbul (Pycnonotus sinensis); bird_e Spotted Dove (Streptopelia chinensis); bird_f Long-tailed Shrike (Lanius schach); bird_g Crested Myna (Acridotheres cristatellus); bird_h White Wagtail (Motacilla alba); bird_i Eurasian Hoopoe (Upupa epops). Count correctly named species per person (0-9).\"\n     }\n    ]\n   },\n   {\n    \"name\": \"perceptions\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"bird_statements\",\n      \"title\": \"Q9-Q10. How much do you agree with each statement about birds?\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true,\n      \"description\": \"Keyed by statement s01-s14 (wording in the page). s01-s09 avian ecosystem services (cultural s01-s06, regulating s07-s09); s10-s14 disservices. Average each subscale.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"nature_relatedness\",\n      \"title\": \"Q11. How much do you agree with each statement?\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true,\n      \"description\": \"Keyed by statement n01-n14 (modified 14-item Nature Relatedness Scale, wording in the page). The paper's refined 9-item score drops n01, n02, n06, n07 and n10; the paper does not say which remaining items it reverse-scored.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"conservation\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"know_biodiversity\",\n      \"title\": \"Q12. Do you know what “biodiversity” means?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"heard_not_know\",\n        \"text\": \"I've heard of it but don't know what it means.\"\n       },\n       {\n        \"value\": \"never_heard\",\n        \"text\": \"I've never heard of it.\"\n       },\n       {\n        \"value\": \"understand\",\n        \"text\": \"I understand its meaning.\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"development_conflict\",\n      \"title\": \"Q13. Do you think urban development conflicts with bird survival?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes.\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No.\"\n       },\n       {\n        \"value\": \"not_sure\",\n        \"text\": \"Not sure.\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"protect_birds\",\n      \"title\": \"Q14. Do you think birds should be protected?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes.\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No.\"\n       },\n       {\n        \"value\": \"doesnt_matter\",\n        \"text\": \"Doesn't matter to me.\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"protection_method\",\n      \"title\": \"Q15. Which method do you think is most effective for protecting the ecological environment?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"economic\",\n        \"text\": \"Economic incentives\"\n       },\n       {\n        \"value\": \"legal\",\n        \"text\": \"Legal regulation\"\n       },\n       {\n        \"value\": \"education\",\n        \"text\": \"Education\"\n       },\n       {\n        \"value\": \"individual\",\n        \"text\": \"Individual consciousness\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"take_action\",\n      \"title\": \"Q16. Do you personally take actions to protect local bird biodiversity?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"never\",\n        \"text\": \"Never.\"\n       },\n       {\n        \"value\": \"rarely\",\n        \"text\": \"Rarely.\"\n       },\n       {\n        \"value\": \"actively\",\n        \"text\": \"Yes, I actively protect birds.\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"birds-original\">{\"source\": \"Qian, Ma, Fu, Chen, Shen, Chen, Gui, Cai & Zhao (2026) Data in Brief 66: 112665\", \"n\": 1430, \"participants\": \"residents of Zhoushan, Zhejiang, China, face-to-face street intercept survey in Chinese, April-July 2024 (1,500 surveyed, 1,430 valid)\", \"result\": \"Seen most often: Eurasian Tree Sparrow 69.6%, Chinese Blackbird 59.2%, Little Egret 55.0%; least: Eurasian Hoopoe 22.6%. 58.7% named 4-6 species correctly, 10.2% named 7-9. Strongest agreement with 'pleasing to look at' (79.6% agree) and 'pleasant bird calls' (74.4%); few agreed birds are unpleasant to look at (10.1%). 27.1% understood 'biodiversity'; 75.6% said birds should be protected; 35.6% saw a conflict between urban development and bird survival.\"}</script>\n<style>\n:root{--bg:#eef3f6;--card:#fff;--ink:#16232b;--muted:#566670;--accent:#1f6a8a;--line:#d2dde3;--warn:#b3261e;--sel:#e1eef5}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.f{margin-top:18px}.f:first-child{margin-top:0}\n.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}\n@media(max-width:620px){.grid{grid-template-columns:repeat(2,1fr)}}\n.bird{border:2px solid var(--line);border-radius:12px;overflow:hidden;background:#fff;cursor:pointer;display:block}\n.bird img{width:100%;display:block;aspect-ratio:3/2;object-fit:cover}\n.bird .cap{padding:6px 10px;font-size:.92rem;display:flex;gap:8px;align-items:center}\n.bird:has(input:checked){border-color:var(--accent);background:var(--sel)}\n.namecard{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#fff}\n.namecard img{width:100%;display:block;aspect-ratio:3/2;object-fit:cover}\n.namecard .in{padding:8px}\n.namecard input[type=text]{width:100%;font:inherit;padding:7px 9px;border:1px solid var(--line);border-radius:8px}\n.namecard label{font-size:.85rem;color:var(--muted);display:flex;gap:6px;align-items:center;margin-top:4px}\n.lk{border-top:1px solid var(--line);padding:12px 0}\n.lk:first-of-type{border-top:0}\n.lk .st{font-weight:600;margin-bottom:6px}\n.lk .sc{display:grid;grid-template-columns:repeat(5,1fr);gap:4px}\n.lk .sc label{display:flex;flex-direction:column;align-items:center;text-align:center;border:1px solid var(--line);border-radius:8px;padding:6px 2px;font-size:.74rem;line-height:1.2;cursor:pointer;color:var(--muted)}\n.lk .sc label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.lk .sc input{margin:0 0 3px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.74rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Bird photographs (Figure 1 of Qian et al. 2026, Data in Brief 66: 112665, doi:10.1016/j.dib.2026.112665), all via Wikimedia Commons: (a) Andreas Trepte, CC BY-SA 2.5; (b) Laitche, public domain; (c) Charles J. Sharp, CC BY-SA 4.0; (d) Jason Thompson, CC BY 2.0; (e) Bernard Dupont, CC BY-SA 2.0; (f) Charles J. Sharp, CC BY-SA 4.0; (g) Nrg800, CC BY-SA 4.0; (h) Juan Emilio, CC BY-SA 2.0; (i) Giles Laurent, CC BY-SA 4.0. Cropped from the paper's figure.</footer>\n<script>\n(function(){\n  var KEY='city-birds:state';\n  var BIRDS=['a','b','c','d','e','f','g','h','i'];\n  var ES=[['s01','They are pleasing for me to look at.'],['s02','They produce pleasant-sounding bird calls that I enjoy.'],['s03','They provide me with inspiration for art, creativity, and photography.'],['s04','They provide me with opportunities for nature education.'],['s05','They contribute to my spiritual well-being.'],['s06','They make me feel like I live in a ‘Garden City’.'],['s07','They disperse seeds.'],['s08','They recycle nutrients.'],['s09','They feed on insect pests.'],['s10','They are noisy.'],['s11','They carry diseases.'],['s12','They are dirty.'],['s13','They are unpleasant to look at.'],['s14','They use or damage my personal property.']];\n  var NR=[['n01','Some species are just meant to die out or become extinct.'],['n02','Humans have the right to use natural resources any way we want.'],['n03','I always think about how my actions affect the environment.'],['n04','I am very aware of environmental issues.'],['n05','I take notice of wildlife wherever I am.'],['n06','I don’t often go out in nature.'],['n07','Nothing I do will change problems in other places on the planet.'],['n08','I am not separate from nature, but a part of nature.'],['n09','My feelings about nature do not affect how I live my life.'],['n10','Animals, birds and plants should have fewer rights than humans.'],['n11','The state of non-human species is an indicator of the future for humans.'],['n12','I think a lot about the suffering of animals.'],['n13','I feel very connected to all living things and the earth.'],['n14','We should strengthen scientific education on birds.']];\n  var LK=['Strongly disagree','Disagree','Neutral','Agree','Strongly agree'];\n  var ACT=['act_gardening','act_recreation','act_films','act_reading'];\n  var STEPS=['intro','about','activities','seen','names','services','nature','conservation','done'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function next(){st.step=STEPS[STEPS.indexOf(st.step)+1];save();route();}\n  function shell(title,sub,body,btn){var n=STEPS.indexOf(st.step);app.innerHTML='<div class=\"prog\">Part '+n+' of 7</div><h2>'+esc(title)+'</h2>'+(sub?'<p>'+esc(sub)+'</p>':'')+'<div class=\"card\">'+body+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">'+(btn||'Continue')+'</button></div><div class=\"err\"></div></div>';return document.getElementById('go');}\n  function img(id){return files['bird_'+id].url;}\n  function intro(){\n    app.innerHTML='<h1>Birds in your city</h1><p>This short survey asks about the birds you see around where you live, what you think of them, and how you relate to nature. You will see photographs of nine common birds. It takes about 5 to 10 minutes. Your answers are anonymous.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    var qs=['gender','age_group','education','occupation','income'];\n    shell('About you','',qs.map(radios).join('')).onclick=function(){\n      var v=qs.map(val);if(v.some(function(x){return !x;}))return err('Please answer every question.');\n      send(qs.map(function(q,i){return SPSite.answer(q,v[i]);}),this,next);};\n  }\n  function activities(){\n    shell('Nature-related activities','How often do you do each of these?',ACT.map(radios).join('')).onclick=function(){\n      var v=ACT.map(val);if(v.some(function(x){return !x;}))return err('Please answer every question.');\n      send(ACT.map(function(q,i){return SPSite.answer(q,v[i]);}),this,next);};\n  }\n  function seen(){\n    var b='<b>'+esc(Q.bird_seen.title)+'</b> <span style=\"color:var(--muted)\">Select all that apply.</span><div class=\"grid\" style=\"margin-top:10px\">'+st.birds.map(function(id){return '<label class=\"bird\"><img alt=\"Bird photograph\" src=\"'+esc(img(id))+'\"><span class=\"cap\"><input type=\"checkbox\" name=\"seen\" value=\"'+id+'\"> I have seen this bird</span></label>';}).join('')+'</div><label class=\"opt\" style=\"margin-top:12px\"><input type=\"checkbox\" id=\"none\"> None of the above</label>';\n    var go=shell('Birds you have seen','',b);\n    var none=document.getElementById('none');\n    none.onchange=function(){if(none.checked)app.querySelectorAll('input[name=seen]').forEach(function(x){x.checked=false;});};\n    app.querySelectorAll('input[name=seen]').forEach(function(x){x.onchange=function(){if(x.checked)none.checked=false;};});\n    go.onclick=function(){\n      var v=[].map.call(app.querySelectorAll('input[name=seen]:checked'),function(x){return x.value;}).sort();\n      if(!v.length&&!none.checked)return err('Please select the birds you have seen, or \"None of the above\".');\n      send([SPSite.answer('bird_seen',v.length?v:['none'])],this,next);};\n  }\n  function names(){\n    var b='<b>'+esc(Q.bird_name.title)+'</b> <span style=\"color:var(--muted)\">Any name is fine: a local name, the common name or the scientific name.</span><div class=\"grid\" style=\"margin-top:10px\">'+st.birds.map(function(id){return '<div class=\"namecard\"><img alt=\"Bird photograph\" src=\"'+esc(img(id))+'\"><div class=\"in\"><input type=\"text\" maxlength=\"80\" data-id=\"'+id+'\" placeholder=\"Name of this bird\"><label><input type=\"checkbox\" data-dk=\"'+id+'\"> I don’t know</label></div></div>';}).join('')+'</div>';\n    var go=shell('Name the birds','',b);\n    app.querySelectorAll('input[data-dk]').forEach(function(c){c.onchange=function(){var t=app.querySelector('input[data-id=\"'+c.dataset.dk+'\"]');t.disabled=c.checked;if(c.checked)t.value='';};});\n    go.onclick=function(){\n      var list=[],miss=false;\n      st.birds.forEach(function(id){var t=app.querySelector('input[data-id=\"'+id+'\"]').value.trim(),dk=app.querySelector('input[data-dk=\"'+id+'\"]').checked;\n        if(!t&&!dk)miss=true;list.push([id,dk?'(don’t know)':t]);});\n      if(miss)return err('Please write a name or tick \"I don’t know\" for every bird.');\n      send(list.map(function(x){return SPSite.answer('bird_name',x[1],{key:'bird_'+x[0],shown:[files['bird_'+x[0]].name]});}),this,next);};\n  }\n  function likert(q,items,order,title,sub){\n    var b='<b>'+esc(Q[q].title)+'</b>'+order.map(function(k){var it=items.filter(function(x){return x[0]===k;})[0];return '<div class=\"lk\"><div class=\"st\">'+esc(it[1])+'</div><div class=\"sc\">'+LK.map(function(l,i){return '<label><input type=\"radio\" name=\"'+k+'\" value=\"'+(i+1)+'\">'+esc(l)+'</label>';}).join('')+'</div></div>';}).join('');\n    shell(title,sub,b).onclick=function(){\n      var v=order.map(function(k){return val(k);});if(v.some(function(x){return !x;}))return err('Please answer every statement.');\n      send(order.map(function(k,i){return SPSite.answer(q,Number(v[i]),{key:k});}),this,next);};\n  }\n  function conservation(){\n    var qs=['know_biodiversity','development_conflict','protect_birds','protection_method','take_action'];\n    shell('Bird conservation','',qs.map(radios).join(''),'Finish').onclick=function(){\n      var v=qs.map(val);if(v.some(function(x){return !x;}))return err('Please answer every question.');\n      send(qs.map(function(q,i){return SPSite.answer(q,v[i]);}),this,next);};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);\n    if(s==='about')return about();if(s==='activities')return activities();if(s==='seen')return seen();if(s==='names')return names();\n    if(s==='services')return likert('bird_statements',ES,st.es,'What do you think of birds?','Think of the birds in your city.');\n    if(s==='nature')return likert('nature_relatedness',NR,st.nr,'You and nature','');\n    if(s==='conservation')return conservation();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','gender','age_group','education','occupation','income','act_gardening','act_recreation','act_films','act_reading','bird_seen','bird_name','bird_statements','nature_relatedness','know_biodiversity','development_conflict','protect_birds','protection_method','take_action'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('birds')||[]).forEach(function(f){var k=f.name.replace(/\\.[^.]+$/,'');files[k]=f;});\n    if(BIRDS.some(function(b){return !files['bird_'+b];})){app.innerHTML='<h1>Photos missing</h1><p>Upload bird_a.jpg to bird_i.jpg to the media folder \"birds\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!(st&&st.birds&&st.birds.length===9&&st.es&&st.nr))st={step:'intro',birds:BIRDS.slice(),es:ES.map(function(x){return x[0];}),nr:NR.map(function(x){return x[0];})};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true)st.step='intro';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
