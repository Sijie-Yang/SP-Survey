   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Hong Kong Streetscapes</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Restorative Tourist Streetscapes in Hong Kong\",\n  \"description\": \"Participants look at six tourist streetscapes around Victoria Harbour, Hong Kong, for 60 seconds each in random order. After each scene they rate four restoration dimensions (being away, fascination, coherence/extent, compatibility) and four affect states (stress, calm, tension, positive affect) on 1–7 scales and do a short 8-event sustained-attention task. Rebuilt from Wang, Zhao, Xu, Li & Cheng (2026), Frontiers in Public Health 14: 1981997, with the six scene photographs printed in the paper's Figure 6 (CC BY 4.0).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"scenes\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 99\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Sex\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"sleep\",\n      \"title\": \"How well did you sleep last night?\",\n      \"description\": \"Context variable; the paper recorded sleep, caffeine and exercise context.\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"poor\",\n        \"text\": \"Poorly\"\n       },\n       {\n        \"value\": \"ok\",\n        \"text\": \"Normally\"\n       },\n       {\n        \"value\": \"well\",\n        \"text\": \"Well\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"caffeine\",\n      \"title\": \"Have you had coffee, tea or another caffeinated drink in the last 3 hours?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"scenes\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"away\",\n      \"title\": \"Being in this place would let me get away from everyday demands.\",\n      \"description\": \"Being away (1 of 4 restoration items; wording written for this template, the paper names only the four dimensions). Keyed by scene id.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"fascination\",\n      \"title\": \"This place holds my attention; there is a lot to look at and discover.\",\n      \"description\": \"Fascination (1 of 4 restoration items; wording written for this template, the paper names only the four dimensions). Keyed by scene id.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"coherence\",\n      \"title\": \"This place feels coherent, like a whole world of its own.\",\n      \"description\": \"Coherence / extent (1 of 4 restoration items; wording written for this template, the paper names only the four dimensions). Keyed by scene id.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"compatibility\",\n      \"title\": \"This place fits what I would like to do there.\",\n      \"description\": \"Compatibility (1 of 4 restoration items; wording written for this template, the paper names only the four dimensions). Keyed by scene id.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"stress\",\n      \"title\": \"Right now, how stressed do you feel?\",\n      \"description\": \"Affect, 1–7. Keyed by scene id.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Extremely\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"calm\",\n      \"title\": \"Right now, how calm do you feel?\",\n      \"description\": \"Affect, 1–7. Keyed by scene id.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Extremely\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"tension\",\n      \"title\": \"Right now, how tense do you feel?\",\n      \"description\": \"Affect, 1–7. Keyed by scene id.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Extremely\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"positive\",\n      \"title\": \"Right now, how positive (e.g. cheerful, interested) do you feel?\",\n      \"description\": \"Affect, 1–7. Keyed by scene id.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Extremely\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"sart_correct\",\n      \"title\": \"SART block: correct events (0–8)\",\n      \"description\": \"Set by the page. 8-event Sustained Attention to Response Task after each scene: 7 go digits (press) and 1 no-go digit 3 (withhold). Keyed by scene id.\",\n      \"isRequired\": true,\n      \"min\": 0,\n      \"max\": 8\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"sart_rt\",\n      \"title\": \"SART block: mean reaction time of correct go responses (ms)\",\n      \"description\": \"Set by the page; 0 when there was no correct go response. Keyed by scene id.\",\n      \"isRequired\": true,\n      \"min\": 0,\n      \"max\": 5000\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"hk-original\">{\"source\": \"Wang et al. (2026) Front Public Health 14:1981997, Results\", \"n\": 46, \"exposures\": 108, \"prs_mean_1to7\": {\"A_oi_art_space\": 5.69, \"E_old_wan_chai_post_office\": 5.11, \"C_western_market\": 4.17}, \"note\": \"Perceived restorativeness differed across scenes (chi2(5)=103.67); SART accuracy did not differ.\"}</script>\n<style>\n:root{--bg:#f4f4f7;--card:#fff;--ink:#1f2a22;--muted:#5f6d63;--accent:#7a3b2e;--line:#d9e3ea;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.1rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.view{background:#000;border-radius:12px;overflow:hidden;aspect-ratio:3/2;display:flex;align-items:center;justify-content:center}\n.view img{width:100%;height:100%;object-fit:contain;display:block}\n.thumb{max-width:520px;margin:0 auto}\n.timer{height:4px;background:var(--line);border-radius:2px;overflow:hidden;margin-top:8px}.timer>i{display:block;height:100%;background:var(--accent);width:0}\n.big{font-size:2.4rem;font-weight:700;text-align:center;margin:18px 0;color:var(--ink)}\n.item{padding:12px 0;border-top:1px solid var(--line)}.item:first-child{border-top:0}\n.item .t{margin-bottom:8px}\n.scale{display:grid;gap:6px}\n.scale button{appearance:none;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:8px;padding:9px 0;font:inherit;font-weight:600;cursor:pointer}\n.scale button.on{background:var(--accent);border-color:var(--accent);color:#fff}\n.item.miss .t{color:var(--warn)}\n.anch{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin:4px 0 6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\ntextarea{width:100%;min-height:90px;font:inherit;padding:10px;border:1px solid var(--line);border-radius:10px}\n.mini{font-size:.85rem;color:var(--muted)}\n.view.full{aspect-ratio:auto;max-width:900px;margin:0 auto}.view.full img{height:auto;max-height:72vh}\n.sart{height:220px;display:flex;align-items:center;justify-content:center;font-size:5rem;font-weight:700;background:#fff;border:1px solid var(--line);border-radius:14px;user-select:none}\n.tap{width:100%;padding:22px;font-size:1.2rem;margin-top:12px}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Wang, Zhao, Xu, Li &amp; Cheng (2026), Frontiers in Public Health 14: 1981997, Figure 6, CC BY 4.0.</footer>\n<script>\n(function(){\n  var F=window.__VIEWMS, VIEW_MS=F||60000, DIGIT_MS=F?30:250, MASK_MS=F?60:900, KEY='hk-streetscapes:state';\n  var PRS=['away','fascination','coherence','compatibility'], AFF=['stress','calm','tension','positive'], CTX=['gender','sleep','caffeine'];\n  var app=document.getElementById('app'), Q={}, files=[], st=null, tm=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function id(n){return n.replace(/\\.[^.]+$/,'');}\n  function byId(i){for(var k=0;k<files.length;k++)if(id(files[k].name)===i)return files[k];return null;}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function radio(n){var q=Q[n];return '<div class=\"f\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function scale(k){var q=Q[k],b='';for(var v=1;v<=7;v++)b+='<button type=\"button\" data-v=\"'+v+'\" aria-label=\"'+v+'\">'+v+'</button>';\n    return '<div class=\"item\" data-k=\"'+k+'\"><div class=\"t\">'+esc(q.title)+'</div><div class=\"scale\" style=\"grid-template-columns:repeat(7,1fr)\">'+b+'</div><div class=\"anch\"><span>1 = '+esc(q.minRateDescription)+'</span><span>7 = '+esc(q.maxRateDescription)+'</span></div></div>';}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function intro(){\n    app.innerHTML='<h1>Streets on the way to a sight</h1><p>Imagine you are visiting Hong Kong and walking to a museum or landmark. You will see six street scenes, one at a time, each for one minute. After each scene you answer eight short questions and do a 10-second attention task. About 12 minutes. Please use a large screen and a keyboard or a touch screen.</p>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div class=\"f\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"99\"></div>'+CTX.map(radio).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var age=Number(document.getElementById('age').value);if(!(age>=18&&age<=99))return err('Please enter your age (18 or older).');\n      var v={};for(var i=0;i<CTX.length;i++){var g=app.querySelector('input[name='+CTX[i]+']:checked');if(!g)return err('Please answer: '+Q[CTX[i]].title);v[CTX[i]]=g.value;}\n      send([SPSite.answer('consent',true),SPSite.answer('age',age)].concat(CTX.map(function(n){return SPSite.answer(n,v[n]);})),this,function(){st.step='ready';st.k=0;save();route();});\n    };\n  }\n  function ready(){\n    app.innerHTML='<h2>Scene '+(st.k+1)+' of '+st.order.length+'</h2><div class=\"card\"><p>The scene stays on screen for one minute. Look at it freely, as if you were standing there.</p><button class=\"btn\" id=\"go\">Show the scene</button></div>';\n    document.getElementById('go').onclick=function(){st.step='view';save();route();};\n  }\n  function view(){\n    var f=byId(st.order[st.k]);\n    app.innerHTML='<p>Scene '+(st.k+1)+' of '+st.order.length+'</p><div class=\"view full\"><img alt=\"Hong Kong street scene\" src=\"'+esc(f.url)+'\"></div><div class=\"timer\"><i id=\"tb\"></i></div>';\n    var tb=document.getElementById('tb');tb.style.transition='width '+(VIEW_MS/1000)+'s linear';requestAnimationFrame(function(){requestAnimationFrame(function(){tb.style.width='100%';});});\n    tm=setTimeout(function(){st.step='rate';save();route();},VIEW_MS);\n  }\n  function rate(){\n    var c=st.order[st.k],f=byId(c),vals={},ALL=PRS.concat(AFF);\n    app.innerHTML='<h2>About the scene you just saw</h2><div class=\"card\"><p>How much do you agree?</p>'+PRS.map(scale).join('')+'</div><div class=\"card\"><p>How do you feel right now?</p>'+AFF.map(scale).join('')+\n      '<div style=\"margin-top:12px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    window.scrollTo(0,0);\n    app.querySelectorAll('.item').forEach(function(it){it.querySelectorAll('button').forEach(function(b){b.onclick=function(){vals[it.dataset.k]=Number(b.dataset.v);it.classList.remove('miss');it.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b);});};});});\n    document.getElementById('go').onclick=function(){\n      var m=ALL.filter(function(k){return vals[k]==null;});\n      if(m.length){m.forEach(function(k){app.querySelector('.item[data-k=\"'+k+'\"]').classList.add('miss');});return err('Please answer every question ('+m.length+' missing, marked).');}\n      send(ALL.map(function(k){return SPSite.answer(k,vals[k],{key:c,shown:[f.name]});}),this,function(){st.step='sart';save();route();});\n    };\n  }\n  function sartIntro(){\n    app.innerHTML='<h2>Attention task</h2><div class=\"card\"><p style=\"color:var(--ink)\">Digits will flash one after another. Press the <b>space bar</b> (or tap the big button) as quickly as you can for every digit <b>except 3</b>. When you see a <b>3</b>, do not press.</p><button class=\"btn\" id=\"go\">Start the task</button></div>';\n    document.getElementById('go').onclick=runSart;\n  }\n  function runSart(){\n    var c=st.order[st.k],f=byId(c),seq=[1,2,4,5,6,7,8,9].sort(function(){return Math.random()-0.5;}).slice(0,7),pos=1+Math.floor(Math.random()*7);seq.splice(pos,0,3);\n    var i=-1,t0=0,pressed=false,res=[];\n    app.innerHTML='<p>Press for every digit except 3.</p><div class=\"sart\" id=\"d\"></div><button class=\"btn tap\" id=\"tap\">Press</button>';\n    var d=document.getElementById('d');\n    function press(){if(i<0||pressed)return;pressed=true;res[i].rt=Date.now()-t0;}\n    function key(e){if(e.code==='Space'||e.key===' '){e.preventDefault();press();}}\n    document.addEventListener('keydown',key);document.getElementById('tap').onclick=press;\n    function next(){\n      if(i>=0){res[i].pressed=pressed;}\n      i++;if(i>=seq.length){document.removeEventListener('keydown',key);return done();}\n      pressed=false;res[i]={digit:seq[i]};t0=Date.now();d.textContent=seq[i];\n      tm=setTimeout(function(){d.textContent='⊗';tm=setTimeout(next,MASK_MS);},DIGIT_MS);\n    }\n    function done(){\n      var correct=0,rts=[];res.forEach(function(r){var good=r.digit===3?!r.pressed:r.pressed;if(good)correct++;if(r.digit!==3&&r.pressed)rts.push(r.rt);});\n      var rt=rts.length?Math.round(rts.reduce(function(a,b){return a+b;},0)/rts.length):0;\n      app.innerHTML='<div class=\"card\"><p>Saving…</p><div class=\"err\"></div></div>';\n      send([SPSite.answer('sart_correct',correct,{key:c,shown:[f.name]}),SPSite.answer('sart_rt',rt,{key:c,shown:[f.name]})],null,function(){st.k++;st.step=st.k>=st.order.length?'done':'ready';save();route();});\n    }\n    tm=setTimeout(next,F?20:800);\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';st.k=0;save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){clearTimeout(tm);var s=st.step;if(s==='ready')return ready();if(s==='view')return view();if(s==='rate')return rate();if(s==='sart')return sartIntro();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','sart_correct','sart_rt'].concat(CTX,PRS,AFF).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    files=(SPSite.getMedia('scenes')||[]).filter(function(f){return /\\.(jpe?g|png|webp)$/i.test(f.name);});\n    if(!files.length){app.innerHTML='<h1>Photos missing</h1><p>Upload the scene photographs to the media folder \"scenes\".</p>';return;}\n    var ids=files.map(function(f){return id(f.name);});\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!st||!st.order||st.order.some(function(i){return ids.indexOf(i)<0;}))st={step:'intro',order:shuffle(ids),k:0};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    if(st.step==='view')st.step='ready';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
