  "spSite": {
   "id": "site-b8f0c89e65a3552c",
   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Campus Place Restorativeness</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Perceived Restorativeness of Campus Places: Short PRS\",\n  \"description\": \"Each participant sees one of nine photographs of places on the Guajara campus of the University of La Laguna (Tenerife), pre-classified by expert judges as low, medium or high in restorativeness (three each), and answers the five-item short Perceived Restorativeness Scale (being away, fascination, coherence, compatibility, scope; 0-10) plus pleasure and preference, with the photo visible throughout. Rebuilt from Negrin, Hernandez-Fernaud, Hess & Hernandez (2017), Frontiers in Psychology 8: 1735, with its Figure 1-3 photographs and the short-scale items as printed in its Methods (CC BY 4.0). Scoring: mean of the five short-PRS items; compare the three restorativeness levels with one-way ANOVA.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"campus\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part in this study.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"rate\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_being_away\",\n      \"title\": \"This place lets me forget my everyday responsibilities, feel relaxed, and lose myself in my own thoughts.\",\n      \"rateMin\": 0,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Totally\",\n      \"isRequired\": true,\n      \"description\": \"Short PRS, being away. Keyed by photo: campus1-3 low, campus4-6 medium, campus7-9 high restorativeness level as pre-classified by expert judges (paper Figures 1, 2, 3, left to right). Each participant rates one randomly assigned photo. 0 = not at all, 10 = totally.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_fascination\",\n      \"title\": \"This is a fascinating place that keeps my curiosity alive and stops me from getting bored.\",\n      \"rateMin\": 0,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Totally\",\n      \"isRequired\": true,\n      \"description\": \"Short PRS, fascination. Keyed by photo: campus1-3 low, campus4-6 medium, campus7-9 high restorativeness level as pre-classified by expert judges (paper Figures 1, 2, 3, left to right). Each participant rates one randomly assigned photo. 0 = not at all, 10 = totally.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_coherence\",\n      \"title\": \"This is a place where activities and things are orderly and well organized.\",\n      \"rateMin\": 0,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Totally\",\n      \"isRequired\": true,\n      \"description\": \"Short PRS, coherence. Keyed by photo: campus1-3 low, campus4-6 medium, campus7-9 high restorativeness level as pre-classified by expert judges (paper Figures 1, 2, 3, left to right). Each participant rates one randomly assigned photo. 0 = not at all, 10 = totally.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_compatibility\",\n      \"title\": \"This place is another world, where I can move around at ease.\",\n      \"rateMin\": 0,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Totally\",\n      \"isRequired\": true,\n      \"description\": \"Short PRS, compatibility. Keyed by photo: campus1-3 low, campus4-6 medium, campus7-9 high restorativeness level as pre-classified by expert judges (paper Figures 1, 2, 3, left to right). Each participant rates one randomly assigned photo. 0 = not at all, 10 = totally.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_scope\",\n      \"title\": \"I feel comfortable here because it's easy to find your way around this place.\",\n      \"rateMin\": 0,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Totally\",\n      \"isRequired\": true,\n      \"description\": \"Short PRS, scope. Keyed by photo: campus1-3 low, campus4-6 medium, campus7-9 high restorativeness level as pre-classified by expert judges (paper Figures 1, 2, 3, left to right). Each participant rates one randomly assigned photo. 0 = not at all, 10 = totally.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"pleasure\",\n      \"title\": \"How attractive is this place to you?\",\n      \"rateMin\": 0,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Totally\",\n      \"isRequired\": true,\n      \"description\": \"Pleasure item; our wording (the paper describes it but does not print it). Keyed by photo: campus1-3 low, campus4-6 medium, campus7-9 high restorativeness level as pre-classified by expert judges (paper Figures 1, 2, 3, left to right). Each participant rates one randomly assigned photo. 0 = not at all, 10 = totally.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"preference\",\n      \"title\": \"How much would you prefer this place to other places?\",\n      \"rateMin\": 0,\n      \"rateMax\": 10,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Totally\",\n      \"isRequired\": true,\n      \"description\": \"Preference item; our wording (the paper describes it but does not print it). Keyed by photo: campus1-3 low, campus4-6 medium, campus7-9 high restorativeness level as pre-classified by expert judges (paper Figures 1, 2, 3, left to right). Each participant rates one randomly assigned photo. 0 = not at all, 10 = totally.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 16,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"What is your gender?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"woman\",\n        \"text\": \"Woman\"\n       },\n       {\n        \"value\": \"man\",\n        \"text\": \"Man\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"student\",\n      \"title\": \"Are you a university student?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"campus-original\">{\"source\": \"Negrin, Hernandez-Fernaud, Hess & Hernandez (2017) Frontiers in Psychology 8: 1735\", \"n\": 244, \"participants\": \"psychology undergraduates at the University of La Laguna (mean age 20.6); each photo projected to one class group for about 20 min, paper questionnaire in Spanish; also answered the 26-item PRS (counterbalanced)\", \"table1_means\": {\"low\": {\"short_prs\": 3.59, \"original_prs\": 3.9, \"pleasure\": 4.85, \"preference\": 1.38}, \"medium\": {\"short_prs\": 4.42, \"original_prs\": 4.5, \"pleasure\": 5.96, \"preference\": 2.87}, \"high\": {\"short_prs\": 5.4, \"original_prs\": 5.18, \"pleasure\": 7.05, \"preference\": 5.12}}, \"data\": \"https://doi.org/10.7910/DVN/YM2NT7\", \"result\": \"Both the short and the 26-item PRS rose from low to medium to high restorativeness places; the short version discriminated between the levels as well as the original.\"}</script>\n<style>\n:root{--bg:#f4f3ee;--card:#fff;--ink:#23231d;--muted:#64645a;--accent:#2b6a6a;--line:#deddd3;--warn:#b3261e;--sel:#e2f0ef}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1100px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.lay{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start}\n.pic{position:sticky;top:12px}.pic img{width:100%;border-radius:8px;display:block}\n@media (max-width:760px){.lay{grid-template-columns:1fr}.pic{top:0;z-index:2;background:var(--bg);padding-bottom:6px}}\n.it{padding:9px 0;border-top:1px solid var(--line)}.it:first-child{border-top:0}\n.it b{display:block;font-weight:500;margin-bottom:5px}\n.row{display:grid;grid-template-columns:repeat(11,1fr);gap:3px}\n.row label{display:flex;flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:7px;padding:4px 0;cursor:pointer;font-size:.8rem}\n.row label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.row input{margin:0 0 2px}\n.ends{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);margin-top:2px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Negrín, Hernández-Fernaud, Hess &amp; Hernández (2017), Frontiers in Psychology 8: 1735, Figures 1–3 (doi:10.3389/fpsyg.2017.01735, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='campus-prs:state';\n  var ITEMS=['prs_being_away','prs_fascination','prs_coherence','prs_compatibility','prs_scope','pleasure','preference'];\n  var app=document.getElementById('app'), Q={}, files={}, ids=[], st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function item(n){var h='<div class=\"it\"><b>'+esc(Q[n].title)+'</b><div class=\"row\">';for(var i=0;i<=10;i++)h+='<label><input type=\"radio\" name=\"q_'+n+'\" value=\"'+i+'\">'+i+'</label>';return h+'</div><div class=\"ends\"><span>Not at all</span><span>Totally</span></div></div>';}\n  function intro(){\n    app.innerHTML='<h1>A place on a university campus</h1><p>You will see one photograph of a place on a university campus. Keep looking at it while you answer seven short questions about how this place makes you feel, from 0 (not at all) to 10 (totally). It takes about 5 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='rate';save();route();});};\n  }\n  function rate(){\n    var id=st.photo;\n    app.innerHTML='<div class=\"lay\"><div class=\"pic\"><img alt=\"Campus place\" src=\"'+esc(files[id].url)+'\"></div><div class=\"card\" style=\"margin-top:0\"><p style=\"color:var(--ink)\">Answer with reference to the place in the photo.</p>'+ITEMS.map(item).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div></div>';\n    document.getElementById('go').onclick=function(){\n      var v=ITEMS.map(function(n){return val('q_'+n);});if(v.some(function(x){return x==null;}))return err('Please answer all seven questions.');\n      var sh=[files[id].name];\n      send(ITEMS.map(function(n,i){return SPSite.answer(n,Number(v[i]),{key:id,shown:sh});}),this,function(){st.step='about';save();route();});\n    };\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"16\" max=\"110\"></div>'+radios('gender')+radios('student')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var age=Number(document.getElementById('age').value),g=val('gender'),s=val('student');\n      if(!(age>=16&&age<=110))return err('Please enter your age.');if(!g||!s)return err('Please answer every question.');\n      send([SPSite.answer('age',age),SPSite.answer('gender',g),SPSite.answer('student',s)],this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='rate')return rate();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','student'].concat(ITEMS).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('campus')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name)){var k=f.name.replace(/\\.[^.]+$/,'');files[k]=f;ids.push(k);}});\n    if(!ids.length){app.innerHTML='<h1>Photos missing</h1><p>Upload the campus photos to the media folder \"campus\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!(st&&st.photo&&files[st.photo]))st={step:'intro',photo:ids[Math.floor(Math.random()*ids.length)]};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true)st.step='intro';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
