   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Urban Nature for Older Adults</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Urban Nature for Older Adults: Sensory Dimensions and Restoration\",\n  \"description\": \"Each participant is randomly assigned to one of four urban natural environments (open, partly-closed and closed green space, blue space), sees its two photographs, and rates the eight perceived sensory dimensions (1–5), preference (1–5, with a reason) and the 16-item Perceived Restorativeness Scale (1–5). Rebuilt from Qiu, Chen & Gao (2021), IJERPH 18(2): 509, with the paper's eight photographs from Baoji Botanical Garden (Figure 1b, CC BY 4.0). The original sample was adults aged 60 or over.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"env\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age_group\",\n      \"title\": \"Age\",\n      \"description\": \"The paper recruited adults aged 60 or over; younger groups are offered so the template can also compare age groups.\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"under_60\",\n        \"text\": \"Under 60\"\n       },\n       {\n        \"value\": \"60_69\",\n        \"text\": \"60–69\"\n       },\n       {\n        \"value\": \"70_79\",\n        \"text\": \"70–79\"\n       },\n       {\n        \"value\": \"80_plus\",\n        \"text\": \"80 or over\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"environment\",\n      \"title\": \"Assigned environment (set by the page)\",\n      \"description\": \"Random assignment to one of the paper's four environment types; the participant sees its two photographs (file names ogs_1/ogs_2, pcgs_…, cgs_…, bs_…).\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"ogs\",\n        \"text\": \"Open green space (OGS, <30% tree/shrub canopy)\"\n       },\n       {\n        \"value\": \"pcgs\",\n        \"text\": \"Partly-closed green space (PCGS, 30–70% canopy)\"\n       },\n       {\n        \"value\": \"cgs\",\n        \"text\": \"Closed green space (CGS, >70% canopy)\"\n       },\n       {\n        \"value\": \"bs\",\n        \"text\": \"Blue space (BS, open lake with some greenery)\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"ratings\",\n    \"elements\": [\n     {\n      \"type\": \"matrix\",\n      \"name\": \"psd\",\n      \"title\": \"How strongly do you perceive each quality in this environment?\",\n      \"description\": \"Eight perceived sensory dimensions (Grahn & Stigsdotter) with the descriptions from the paper's Table 1; 1 = none or very weak, 5 = very strong. Paper: mean > 3.5 = highly perceived.\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"serene\",\n        \"text\": \"Serene: The environment is silent and calm; no contact with many people; not disturbed by traffic noise.\"\n       },\n       {\n        \"value\": \"nature\",\n        \"text\": \"Nature: An environment with natural qualities; wild and untouched; free growing.\"\n       },\n       {\n        \"value\": \"rich_in_species\",\n        \"text\": \"Rich in species: Various species of plants; various species of animals, such as birds, insects, etc.\"\n       },\n       {\n        \"value\": \"space\",\n        \"text\": \"Space: A spacious and free environment; a lot of trees; not crossed by too many roads and paths.\"\n       },\n       {\n        \"value\": \"prospect\",\n        \"text\": \"Prospect: An environment with open views; vistas over the surroundings; plane and well-cut grassy surfaces.\"\n       },\n       {\n        \"value\": \"refuge\",\n        \"text\": \"Refuge: An environment with many bushes; one can sit and watch other people being active.\"\n       },\n       {\n        \"value\": \"social\",\n        \"text\": \"Social: An abundance of people and movements in the environment; possible to watch entertainment or exhibitions.\"\n       },\n       {\n        \"value\": \"culture\",\n        \"text\": \"Culture: Many cultural features, such as fountains, statues, etc.; decorated with ornamental plants or flowers.\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       }\n      ]\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"preference\",\n      \"title\": \"How much do you like this environment?\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Extremely dislike\",\n      \"maxRateDescription\": \"Extremely like\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"preference_reason\",\n      \"title\": \"Why do you like or dislike it?\",\n      \"isRequired\": false\n     },\n     {\n      \"type\": \"matrix\",\n      \"name\": \"prs\",\n      \"title\": \"How much do you agree with each statement about this environment?\",\n      \"description\": \"16-item Perceived Restorativeness Scale (Hartig et al.): being away ba1–ba2, fascination fa1–fa5, coherence co1–co4, compatibility cp1–cp5; 1 = not agree at all, 5 = agree very much. The paper does not print its items; this English wording is the 16-item version listed in Frontiers in Public Health 10:801453 (Table 5). Coherence items are negatively worded: reverse-code them (6 − response) before averaging. Component score = mean of its items; overall restoration = mean of all 16.\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"ba1\",\n        \"text\": \"It is an escape experience.\"\n       },\n       {\n        \"value\": \"ba2\",\n        \"text\": \"It gives me a good break from day-to-day routine.\"\n       },\n       {\n        \"value\": \"fa1\",\n        \"text\": \"The setting has fascinating qualities.\"\n       },\n       {\n        \"value\": \"fa2\",\n        \"text\": \"My attention is drawn to many interesting things.\"\n       },\n       {\n        \"value\": \"fa3\",\n        \"text\": \"I would like to get to know this place better.\"\n       },\n       {\n        \"value\": \"fa4\",\n        \"text\": \"There is much to explore and discover here.\"\n       },\n       {\n        \"value\": \"fa5\",\n        \"text\": \"I would like to spend more time looking at the surroundings.\"\n       },\n       {\n        \"value\": \"co1\",\n        \"text\": \"There is too much going on.\"\n       },\n       {\n        \"value\": \"co2\",\n        \"text\": \"It is a confusing place.\"\n       },\n       {\n        \"value\": \"co3\",\n        \"text\": \"There is a great deal of distraction.\"\n       },\n       {\n        \"value\": \"co4\",\n        \"text\": \"It is chaotic here.\"\n       },\n       {\n        \"value\": \"cp1\",\n        \"text\": \"I can do things I like here.\"\n       },\n       {\n        \"value\": \"cp2\",\n        \"text\": \"I have a sense that I belong here.\"\n       },\n       {\n        \"value\": \"cp3\",\n        \"text\": \"I have a sense of oneness with this setting.\"\n       },\n       {\n        \"value\": \"cp4\",\n        \"text\": \"Being here suits my personality.\"\n       },\n       {\n        \"value\": \"cp5\",\n        \"text\": \"I could find ways to enjoy myself in a place like this.\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"elderly-original\">{\"source\": \"Qiu, Chen & Gao (2021) IJERPH 18(2):509\", \"n\": 300, \"psd_means\": {\"serene\": {\"ogs\": 3.13, \"pcgs\": 3.82, \"cgs\": 3.82, \"bs\": 3.78}, \"refuge\": {\"ogs\": 1.75, \"pcgs\": 3.54, \"cgs\": 3.71, \"bs\": 3.53}, \"prospect\": {\"ogs\": 4.31, \"pcgs\": 2.73, \"cgs\": 1.74, \"bs\": 3.52}, \"rich_in_species\": {\"ogs\": 2.04, \"pcgs\": 2.85, \"cgs\": 3.37, \"bs\": 3.77}, \"culture\": {\"ogs\": 2.15, \"pcgs\": 2.55, \"cgs\": 3.53, \"bs\": 3.75}, \"nature\": {\"ogs\": 1.64, \"pcgs\": 2.55, \"cgs\": 4.03, \"bs\": 3.56}, \"space\": {\"ogs\": 2.85, \"pcgs\": 2.43, \"cgs\": 3.33, \"bs\": 2.51}, \"social\": {\"ogs\": 3.09, \"pcgs\": 2.19, \"cgs\": 2.23, \"bs\": 2.96}}, \"preference_mean_sd\": {\"bs\": [4.4, 0.66], \"pcgs\": [4.19, 0.57], \"ogs\": [3.96, 0.67], \"cgs\": [3.63, 0.69]}}</script>\n<style>\n:root{--bg:#f3f6f2;--card:#fff;--ink:#1f2a22;--muted:#5f6d63;--accent:#2f7d4f;--line:#dce5dd;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:920px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.pics{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n.pics img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:10px;display:block;background:#000}\n@media(max-width:560px){.pics{grid-template-columns:1fr}}\n.sticky{position:sticky;top:0;z-index:2;background:var(--bg);padding:8px 0}\n.sticky .pics{grid-template-columns:1fr 1fr}.sticky .pics img{aspect-ratio:16/8}\n.item{padding:12px 0;border-top:1px solid var(--line)}.item:first-child{border-top:0}\n.item .t{margin-bottom:8px}.item .t small{display:block;color:var(--muted)}\n.scale{display:grid;gap:6px;grid-template-columns:repeat(5,1fr)}\n.scale button{appearance:none;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:8px;padding:10px 0;font:inherit;font-weight:600;cursor:pointer}\n.scale button.on{background:var(--accent);border-color:var(--accent);color:#fff}\n.item.miss .t{color:var(--warn)}\n.anch{display:flex;justify-content:space-between;font-size:.82rem;color:var(--muted);margin:4px 0 2px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ntextarea{width:100%;min-height:80px;font:inherit;padding:10px;border:1px solid var(--line);border-radius:8px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:920px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Qiu, Chen &amp; Gao (2021), Int. J. Environ. Res. Public Health 18(2): 509, Figure 1b (Baoji Botanical Garden), CC BY 4.0.</footer>\n<script>\n(function(){\n  var KEY='elderly-nature:state', ENVS=['ogs','pcgs','cgs','bs'];\n  var app=document.getElementById('app'), Q={}, files=[], st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function pics(env){return files.filter(function(f){return f.name.indexOf(env+'_')===0;}).sort(function(a,b){return a.name<b.name?-1:1;});}\n  function picsHtml(){return '<div class=\"pics\">'+pics(st.env).map(function(f){return '<img alt=\"Photograph of the environment\" src=\"'+esc(f.url)+'\">';}).join('')+'</div>';}\n  function radio(n){var q=Q[n];return '<div class=\"f\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function scaleItem(k,label,sub,lo,hi){var b='';for(var v=1;v<=5;v++)b+='<button type=\"button\" data-v=\"'+v+'\" aria-label=\"'+v+'\">'+v+'</button>';\n    return '<div class=\"item\" data-k=\"'+esc(k)+'\"><div class=\"t\">'+esc(label)+(sub?'<small>'+esc(sub)+'</small>':'')+'</div><div class=\"scale\">'+b+'</div><div class=\"anch\"><span>1 = '+esc(lo)+'</span><span>5 = '+esc(hi)+'</span></div></div>';}\n  function bind(vals){app.querySelectorAll('.item').forEach(function(it){it.querySelectorAll('button').forEach(function(b){b.onclick=function(){vals[it.dataset.k]=Number(b.dataset.v);it.classList.remove('miss');it.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b);});};});});}\n  function need(keys,vals){var m=keys.filter(function(k){return vals[k]==null;});m.forEach(function(k){app.querySelector('.item[data-k=\"'+k+'\"]').classList.add('miss');});if(m.length)err('Please answer every statement ('+m.length+' missing, marked).');return !m.length;}\n  function shown(){return pics(st.env).map(function(f){return f.name;});}\n  function intro(){\n    app.innerHTML='<h1>Urban nature and how it makes you feel</h1><p>You will see two photographs of one place in a city park. Imagine you are there, then answer a few questions about how the place feels to you. About 8 minutes.</p>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label>'+radio('gender')+radio('age_group')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var g=function(n){var x=app.querySelector('input[name='+n+']:checked');return x?x.value:null;};\n      var v={gender:g('gender'),age_group:g('age_group')};for(var n in v)if(!v[n])return err('Please answer: '+Q[n].title);\n      var b=this;b.disabled=true;\n      Promise.all([SPSite.answer('consent',true),SPSite.answer('gender',v.gender),SPSite.answer('age_group',v.age_group),SPSite.answer('environment',st.env,{shown:shown()})]).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}st.step='look';save();route();});\n    };\n  }\n  function look(){\n    app.innerHTML='<h2>Look at this place</h2><p>Take your time. Imagine you are standing here: what do you see, hear and feel?</p>'+picsHtml()+'<div class=\"card\"><button class=\"btn\" id=\"go\">I am ready to answer</button></div>';\n    window.scrollTo(0,0);document.getElementById('go').onclick=function(){st.step='psd';save();route();};\n  }\n  function psd(){\n    var q=Q.psd,vals={},rows=q.rows||[];\n    app.innerHTML='<div class=\"sticky\">'+picsHtml()+'</div><h2>'+esc(q.title)+'</h2><div class=\"card\">'+rows.map(function(r){var p=String(r.text).split(': ');return scaleItem(r.value,p[0],p.slice(1).join(': '),'none or very weak','very strong');}).join('')+\n      '<div style=\"margin-top:12px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    window.scrollTo(0,0);bind(vals);\n    document.getElementById('go').onclick=function(){var keys=rows.map(function(r){return String(r.value);});if(!need(keys,vals))return;var b=this;b.disabled=true;\n      SPSite.answer('psd',vals,{shown:shown()}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}st.step='pref';save();route();});};\n  }\n  function pref(){\n    var q=Q.preference,vals={};\n    app.innerHTML='<div class=\"sticky\">'+picsHtml()+'</div><div class=\"card\">'+scaleItem('preference',q.title,'',q.minRateDescription,q.maxRateDescription)+'<div class=\"f\"><b>'+esc(Q.preference_reason.title)+'</b> <span style=\"color:var(--muted)\">(optional)</span><textarea id=\"why\"></textarea></div><div style=\"margin-top:12px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    window.scrollTo(0,0);bind(vals);\n    document.getElementById('go').onclick=function(){if(!need(['preference'],vals))return;var b=this;b.disabled=true;var why=document.getElementById('why').value.trim();\n      var jobs=[SPSite.answer('preference',vals.preference,{shown:shown()})];if(why)jobs.push(SPSite.answer('preference_reason',why));\n      Promise.all(jobs).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}st.step='prs';save();route();});};\n  }\n  function prs(){\n    var q=Q.prs,vals={},rows=q.rows||[];\n    app.innerHTML='<div class=\"sticky\">'+picsHtml()+'</div><h2>'+esc(q.title)+'</h2><div class=\"card\">'+rows.map(function(r){return scaleItem(r.value,r.text,'','not agree at all','agree very much');}).join('')+\n      '<div style=\"margin-top:12px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    window.scrollTo(0,0);bind(vals);\n    document.getElementById('go').onclick=function(){var keys=rows.map(function(r){return String(r.value);});if(!need(keys,vals))return;var b=this;b.disabled=true;\n      SPSite.answer('prs',vals,{shown:shown()}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){var m=r.missing||[];st.step=m.indexOf('psd')>=0?'psd':m.indexOf('preference')>=0?'pref':m.indexOf('prs')>=0?'prs':'intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;if(s==='look')return look();if(s==='psd')return psd();if(s==='pref')return pref();if(s==='prs')return prs();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','gender','age_group','environment','psd','preference','preference_reason','prs'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    files=(SPSite.getMedia('env')||[]).filter(function(f){return /\\.(jpe?g|png|webp)$/i.test(f.name);});\n    var avail=ENVS.filter(function(e){return pics(e).length;});\n    if(!avail.length){app.innerHTML='<h1>Photos missing</h1><p>Upload the photographs to the media folder \"env\" (names ogs_1.jpg, ogs_2.jpg, pcgs_…, cgs_…, bs_…).</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!st||avail.indexOf(st.env)<0)st={step:'intro',env:avail[Math.floor(Math.random()*avail.length)]};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true)st.step='intro';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
