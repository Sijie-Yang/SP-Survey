 the amount and speed of traffic in your neighborhood.\", \"isRequired\": true, \"choices\": [{\"value\": 1, \"text\": \"strongly dissatisfied\"}, {\"value\": 2, \"text\": \"somewhat dissatisfied\"}, {\"value\": 3, \"text\": \"neither satisfied nor dissatisfied\"}, {\"value\": 4, \"text\": \"somewhat satisfied\"}, {\"value\": 5, \"text\": \"strongly satisfied\"}]}, {\"type\": \"radiogroup\", \"name\": \"sat_m\", \"title\": \"How satisfied are you with the noise from traffic in your neighborhood.\", \"isRequired\": true, \"choices\": [{\"value\": 1, \"text\": \"strongly dissatisfied\"}, {\"value\": 2, \"text\": \"somewhat dissatisfied\"}, {\"value\": 3, \"text\": \"neither satisfied nor dissatisfied\"}, {\"value\": 4, \"text\": \"somewhat satisfied\"}, {\"value\": 5, \"text\": \"strongly satisfied\"}]}, {\"type\": \"radiogroup\", \"name\": \"sat_n\", \"title\": \"How satisfied are you with the number and quality of food stores in your neighborhood\", \"isRequired\": true, \"choices\": [{\"value\": 1, \"text\": \"strongly dissatisfied\"}, {\"value\": 2, \"text\": \"somewhat dissatisfied\"}, {\"value\": 3, \"text\": \"neither satisfied nor dissatisfied\"}, {\"value\": 4, \"text\": \"somewhat satisfied\"}, {\"value\": 5, \"text\": \"strongly satisfied\"}]}, {\"type\": \"radiogroup\", \"name\": \"sat_o\", \"title\": \"How satisfied are you with the number and quality of restaurants in your neighborhood.\", \"isRequired\": true, \"choices\": [{\"value\": 1, \"text\": \"strongly dissatisfied\"}, {\"value\": 2, \"text\": \"somewhat dissatisfied\"}, {\"value\": 3, \"text\": \"neither satisfied nor dissatisfied\"}, {\"value\": 4, \"text\": \"somewhat satisfied\"}, {\"value\": 5, \"text\": \"strongly satisfied\"}]}, {\"type\": \"radiogroup\", \"name\": \"sat_p\", \"title\": \"How satisfied are you with your neighborhood as a good place to raise children.\", \"isRequired\": true, \"choices\": [{\"value\": 1, \"text\": \"strongly dissatisfied\"}, {\"value\": 2, \"text\": \"somewhat dissatisfied\"}, {\"value\": 3, \"text\": \"neither satisfied nor dissatisfied\"}, {\"value\": 4, \"text\": \"somewhat satisfied\"}, {\"value\": 5, \"text\": \"strongly satisfied\"}]}, {\"type\": \"radiogroup\", \"name\": \"sat_q\", \"title\": \"How satisfied are you with your neighborhood as a good place to live.\", \"isRequired\": true, \"choices\": [{\"value\": 1, \"text\": \"strongly dissatisfied\"}, {\"value\": 2, \"text\": \"somewhat dissatisfied\"}, {\"value\": 3, \"text\": \"neither satisfied nor dissatisfied\"}, {\"value\": 4, \"text\": \"somewhat satisfied\"}, {\"value\": 5, \"text\": \"strongly satisfied\"}]}]}, {\"name\": \"you\", \"elements\": [{\"type\": \"text\", \"name\": \"age\", \"title\": \"Your age\", \"isRequired\": true, \"inputType\": \"number\", \"min\": 10, \"max\": 110}, {\"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Your gender\", \"isRequired\": true, \"choices\": [{\"value\": \"female\", \"text\": \"Female\"}, {\"value\": \"male\", \"text\": \"Male\"}, {\"value\": \"other\", \"text\": \"Other / prefer not to say\"}]}]}]}}\n</script>\n<style>\n:root{--bg:#f2f1ed;--card:#fff;--ink:#1d1e21;--muted:#5d6066;--accent:#7a4a2b;--accent-ink:#fff;--line:#d9d6cf;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:920px;margin:0 auto;padding:20px 16px 40px}h1{font-size:1.3rem;margin:0 0 8px}p{margin:0 0 10px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}.btn:disabled{opacity:.4;cursor:not-allowed}\n.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent)}.btn.sm{padding:7px 12px;font-size:.9rem}.btn.sel{background:var(--ink);color:#fff;border-color:var(--ink)}\n.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;align-items:center}\n.q{margin-top:16px}.q>b{display:block;margin-bottom:6px;font-weight:600}\ntextarea,input[type=text],input[type=number]{width:100%;font:inherit;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}\ntextarea{min-height:110px;resize:vertical}input[type=number]{width:140px}\nlabel.o{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.step{display:inline-block;padding:2px 10px;border-radius:999px;background:#dfeee8;color:#174a39;font-size:.85rem;font-weight:600;margin-bottom:8px}\n.sheet{position:relative;border:1px solid #bdb9b0;background:#fffdf8;border-radius:6px;overflow:hidden;touch-action:none}\n.sheet canvas{display:block;width:100%;height:auto;cursor:crosshair;user-select:none;-webkit-user-select:none}\n.sheet input{position:absolute;width:150px;padding:3px 6px;font-size:.85rem;border:1px solid var(--accent);border-radius:6px;z-index:2}\n.tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0}\n.clock{margin-left:auto;font-variant-numeric:tabular-nums;color:var(--muted);font-size:.9rem}\n.compass{display:grid;grid-template-columns:repeat(3,56px);gap:6px;margin-top:8px}\n.compass button{height:44px;border:1px solid var(--line);background:#fff;border-radius:8px;font-size:1.2rem;cursor:pointer}.compass button.sel{background:var(--accent);color:#fff;border-color:var(--accent)}\n.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:.85rem;color:var(--muted);margin-top:6px}.legend i{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:5px;vertical-align:-1px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:920px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n.it{padding:12px 0;border-bottom:1px solid var(--line)}.it .t{font-weight:600;margin-bottom:8px}.it.miss .t{color:var(--warn)}\n.opts{display:flex;flex-wrap:wrap;gap:6px}.opts button{flex:1 1 0;min-width:88px;border:1px solid var(--line);background:#fff;border-radius:8px;padding:9px 6px;font:inherit;font-size:.9rem;cursor:pointer;color:var(--ink)}\n.opts button.sel{background:var(--accent);color:#fff;border-color:var(--accent)}\n.bar{display:grid;grid-template-columns:minmax(120px,1.3fr) 2fr 64px;gap:10px;align-items:center;margin-top:8px;font-size:.92rem}.bar .tr{height:12px;background:#eceae4;border-radius:6px;overflow:hidden}.bar .tr i{display:block;height:100%}.bar .n{text-align:right;color:var(--muted);font-variant-numeric:tabular-nums}\n@media(max-width:700px){.opts button{min-width:30%}}\n.opts button{font-size:.8rem;line-height:1.2}.opts button b{font-size:1rem}\n@media(max-width:700px){.opts{flex-wrap:nowrap;gap:4px}.opts button{min-width:0;padding:8px 1px;font-size:.6rem;letter-spacing:-.01em}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Questionnaire: Neighborhood Satisfaction scale of the Neighborhood Quality of Life Study (NQLS). Lee, S., Conway, T. L., Frank, L. D., Saelens, B. E., Cain, K. L., &amp; Sallis, J. F. (2017). The relation of perceived and objective environment attributes to neighborhood satisfaction. <i>Environment and Behavior</i>, 49(2), 136–160. Wording from the NQLS survey on the authors' website (drjimsallis.com).</footer>\n<script>\n(function(){\n  var app=document.getElementById('app'),A={};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function has(n){var v=A[n];return v!=null&&v!=='';}\n  function Q(n){return SPSite.getQuestion(n);}\n  var ITEMS='abcdefghijklmnopq'.split('').map(function(c){return 'sat_'+c;});\n  function saveAll(items,b,then){b.disabled=true;\n    (function step(i){if(i>=items.length)return then();\n      SPSite.answer(items[i][0],items[i][1]).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}A[items[i][0]]=items[i][1];step(i+1);});})(0);}\n  function next(){window.scrollTo(0,0);\n    if(A.consent!==true)return intro();\n    for(var i=0;i<ITEMS.length;i++)if(!has(ITEMS[i]))return items();\n    if(!has('age')||!has('gender'))return form();\n    finish();}\n  function intro(){\n    app.innerHTML='<h1>How satisfied are you with your neighborhood?</h1><p>Seventeen short questions about the neighborhood you live in. It takes about 3 minutes.</p><div class=\"card\"><p>'+esc(Q('consent').title)+'</p><div class=\"row\"><button class=\"btn\" id=\"yes\">I agree</button></div><div class=\"err\"></div></div>';\n    document.getElementById('yes').onclick=function(){saveAll([['consent',true]],this,next);};}\n  function items(){\n    var V={},h='<div class=\"card\"><h1>Neighborhood Satisfaction</h1><p style=\"color:#1d1e21\">Below are things about your neighborhood with which you may or may not be satisfied. Using the 1-5 scale below, indicate your satisfaction with each item. Please be open and honest in your responding.</p><p><b>How satisfied are you with…</b></p>';\n    ITEMS.forEach(function(n){var q=Q(n);h+='<div class=\"it\" data-n=\"'+n+'\"><div class=\"t\">'+esc(q.title.replace(/^How satisfied are you with\\s*/,'… '))+'</div><div class=\"opts\">'+q.choices.map(function(c){return '<button type=\"button\" data-v=\"'+esc(c.value)+'\"><b>'+esc(c.value)+'</b><br>'+esc(c.text)+'</button>';}).join('')+'</div></div>';});\n    app.innerHTML=h+'<div class=\"row\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    app.querySelectorAll('.it').forEach(function(it){var n=it.getAttribute('data-n');it.querySelectorAll('button').forEach(function(b){b.onclick=function(){V[n]=Number(b.getAttribute('data-v'));it.classList.remove('miss');it.querySelectorAll('button').forEach(function(x){x.classList.toggle('sel',x===b);});err('');};});});\n    document.getElementById('go').onclick=function(){var miss=ITEMS.filter(function(n){return V[n]==null;});\n      if(miss.length){app.querySelectorAll('.it').forEach(function(it){it.classList.toggle('miss',V[it.getAttribute('data-n')]==null);});var f=app.querySelector('.it.miss');if(f)f.scrollIntoView({block:'center'});return err('Please answer every line. '+miss.length+(miss.length>1?' are':' is')+' still open.');}\n      saveAll(ITEMS.map(function(n){return [n,V[n]];}),this,next);};}\n  function form(){\n    var N=['age','gender'],h='<div class=\"card\"><span class=\"step\">About you</span>';\n    N.forEach(function(n){var q=Q(n);h+='<div class=\"q\"><b>'+esc(q.title)+'</b>';\n      if(q.type==='radiogroup')h+=q.choices.map(function(c){return '<label class=\"o\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');\n      else h+='<input id=\"f_'+n+'\" type=\"number\" min=\"10\" max=\"110\">';\n      h+='</div>';});\n    app.innerHTML=h+'<div class=\"row\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var x=document.getElementById('f_age').value.trim(),k=Number(x),c=app.querySelector('input[name=\"gender\"]:checked');\n      if(x===''||isNaN(k)||k<10||k>110)return err('Please enter your age in years.');\n      if(!c)return err('Please answer: Your gender');\n      saveAll([['age',k],['gender',c.value]],this,next);};}\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>These questions come from the Neighborhood Quality of Life Study, a study of about 2,200 adults living in 32 neighborhoods in two regions of the United States.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');return;}var e=document.getElementById('fin');if(e)e.textContent='Your answers have been saved. You can close this window now.';});}\n  SPSite.onReady(function(ctx){A=(ctx&&ctx.answers)||{};next();});\n})();\n</script>\n</body>\n</html>\n",
