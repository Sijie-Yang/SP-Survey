   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Neighborhood Satisfaction Survey (NQLS, 17 items)</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\"format\": \"sp-scheme-package\", \"spScheme\": \"2.0\", \"survey\": {\"title\": \"Neighborhood Satisfaction Survey (NQLS, 17 items)\", \"description\": \"The 17-item neighborhood satisfaction scale of the Neighborhood Quality of Life Study: satisfaction with access, social ties, walking and bicycling, schools, safety, traffic, shops and the neighborhood as a place to live.\", \"locale\": \"en\", \"pages\": [{\"name\": \"intro\", \"elements\": [{\"type\": \"boolean\", \"name\": \"consent\", \"title\": \"I agree to take part. My answers are recorded anonymously for research.\", \"isRequired\": true}]}, {\"name\": \"satisfaction\", \"elements\": [{\"type\": \"radiogroup\", \"name\": \"sat_a\", \"title\": \"How satisfied are you with the highway access from your home.\", \"isRequired\": true, \"choices\": [{\"value\": 1, \"text\": \"strongly dissatisfied\"}, {\"value\": 2, \"text\": \"somewhat dissatisfied\"}, {\"value\": 3, \"text\": \"neither satisfied nor dissatisfied\"}, {\"value\": 4, \"text\": \"somewhat satisfied\"}, {\"value\": 5, \"text\": \"strongly satisfied\"}]}, {\"type\": \"radiogroup\", \"name\": \"sat_b\", \"title\": \"How satisfied are you with the access to public transportation in your neighborhood.\", \"isRequired\": true, \"choices\": [{\"value\": 1, \"text\": \"strongly dissatisfied\"}, {\"value\": 2, \"text\": \"somewhat dissatisfied\"}, {\"value\": 3, \"text\": \"neither satisfied nor dissatisfied\"}, {\"value\": 4, \"text\": \"somewhat satisfied\"}, {\"value\": 5, \"text\": \"strongly satisfied\"}]}, {\"type\": \"radiogroup\", \"name\": \"sat_c\", \"title\": \"How satisfied are you with your commuting time to work/school.\", \"isRequired\": true, \"choices\": [{\"value\":