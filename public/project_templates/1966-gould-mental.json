   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Mental maps: rank the 48 states by where you would like to live (Gould 1966)</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\"format\": \"sp-scheme-package\", \"spScheme\": \"2.0\", \"survey\": {\"title\": \"Mental maps: rank the 48 states by where you would like to live (Gould 1966)\", \"description\": \"Peter Gould's mental map task: rank the 48 contiguous United States from the one you would most like to live in to the one you would least like to live in.\", \"locale\": \"en\", \"pages\": [{\"name\": \"intro\", \"elements\": [{\"type\": \"boolean\", \"name\": \"consent\", \"title\": \"I agree to take part. My answers are recorded anonymously for research.\", \"isRequired\": true}]}, {\"name\": \"you\", \"elements\": [{\"type\": \"text\", \"name\": \"home_state\", \"title\": \"In which state (or country) did you grow up?\", \"isRequired\": true, \"description\": \"Gould compared the views from four places (California, Minnesota, Pennsylvania, Alabama); group respondents by this answer or by where they live now.\"}, {\"type\": \"text\", \"name\": \"current_state\", \"title\": \"In which state (or country) do you live now?\", \"isRequired\": true}, {\"type\": \"text\", \"name\": \"age\", \"title\": \"Your age\", \"isRequired\": true, \"inputType\": \"number\", \"min\": 10, \"max\": 110}, {\"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Your gender\", \"isRequired\": true, \"choices\": [{\"value\": \"female\", \"text\": \"Female\"}, {\"value\": \"male\", \"text\": \"Male\"}, {\"value\": \"other___prefer_not_to_say\", \"text\": \"Other / prefer not to say\"}]}]}, {\"name\": \"ranking\", \"elements\": [{\"type\": \"custom\", \"name\": \"state_ranking\", \"title\": \"Imagine yourself married and settling down with a family, with complete freedom to choose where to live according to your own views of what is desirable, all other things being equal. Rank the 48 states in the order in which you would like to live in them.\", \"isRequired\": true, \"description\": \"Value: {order:[state codes, most preferred first], ranks:{code: rank 1–48}, adjustments (number of moves made in the list), seconds}. Analysis as in Gould: build the states × respondents matrix of ranks, correlate respondents (rank correlation), run a principal components analysis and map the state scores on the first component as a 'perception surface'; do this separately for each home group.\"}, {\"type\": \"text\", \"name\": \"most_preferred\", \"title\": \"State ranked first (filled in by the page)\", \"isRequired\": true}, {\"type\": \"text\", \"name\": \"least_preferred\", \"title\": \"State ranked last (filled in by the page)\", \"isRequired\": true}]}]}}\n</script>\n<style>\n:root{--bg:#f2f1ed;--card:#fff;--ink:#1d1e21;--muted:#5d6066;--accent:#2b5c8a;--accent-ink:#fff;--line:#d9d6cf;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:920px;margin:0 auto;padding:20px 16px 40px}h1{font-size:1.3rem;margin:0 0 8px}p{margin:0 0 10px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}.btn:disabled{opacity:.4;cursor:not-allowed}\n.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent)}.btn.sm{padding:7px 12px;font-size:.9rem}.btn.sel{background:var(--ink);color:#fff;border-color:var(--ink)}\n.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;align-items:center}\n.q{margin-top:16px}.q>b{display:block;margin-bottom:6px;font-weight:600}\ntextarea,input[type=text],input[type=number]{width:100%;font:inherit;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}\ntextarea{min-height:110px;resize:vertical}input[type=number]{width:140px}\nlabel.o{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.step{display:inline-block;padding:2px 10px;border-radius:999px;background:#e2ecf5;color:#1d4468;font-size:.85rem;font-weight:600;margin-bottom:8px}\n.sheet{position:relative;border:1px solid #bdb9b0;background:#fffdf8;border-radius:6px;overflow:hidden;touch-action:none}\n.sheet canvas{display:block;width:100%;height:auto;cursor:crosshair;user-select:none;-webkit-user-select:none}\n.sheet input{position:absolute;width:150px;padding:3px 6px;font-size:.85rem;border:1px solid var(--accent);border-radius:6px;z-index:2}\n.tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0}\n.clock{margin-left:auto;font-variant-numeric:tabular-nums;color:var(--muted);font-size:.9rem}\n.compass{display:grid;grid-template-columns:repeat(3,56px);gap:6px;margin-top:8px}\n.compass button{height:44px;border:1px solid var(--line);background:#fff;border-radius:8px;font-size:1.2rem;cursor:pointer}.compass button.sel{background:var(--accent);color:#fff;border-color:var(--accent)}\n.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:.85rem;color:var(--muted);margin-top:6px}.legend i{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:5px;vertical-align:-1px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:920px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n.grid{display:grid;grid-template-columns:repeat(11,1fr);gap:4px;max-width:640px;margin:10px auto}\n.tile{aspect-ratio:1;border:1px solid var(--line);background:#fff;border-radius:6px;font:inherit;font-size:.78rem;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0;line-height:1.05;color:var(--ink)}\n.tile i{font-style:normal;font-size:.7rem;opacity:.9}.tile:disabled{cursor:default}\n.pool{display:flex;flex-wrap:wrap;gap:6px}.chip{border:1px solid var(--line);background:#fff;border-radius:999px;padding:6px 12px;font:inherit;font-size:.9rem;cursor:pointer;color:var(--ink)}\n.rlist{margin:6px 0 0;padding-left:34px}.rlist li{padding:4px 0;border-bottom:1px solid var(--line)}.rlist li>span:first-child{display:inline-block;min-width:150px}\n.mv{float:right}.mv button{width:34px;height:30px;margin-left:4px;border:1px solid var(--line);background:#fff;border-radius:6px;cursor:pointer;color:var(--ink)}.mv button:disabled{opacity:.3}\n@media(max-width:700px){.grid{gap:2px}.tile{font-size:.66rem;border-radius:4px}.tile i{font-size:.6rem}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Method: Gould, P. R. (1966). <i>On Mental Maps</i>. Michigan Inter-University Community of Mathematical Geographers, Discussion Paper No. 9. The tile map only shows roughly where each state lies.</footer>\n<script>\n(function(){\n  var app=document.getElementById('app'),A={};\n  var ST=[['ME','Maine',11,0],['WI','Wisconsin',6,1],['VT','Vermont',10,1],['NH','New Hampshire',11,1],\n   ['WA','Washington',1,2],['ID','Idaho',2,2],['MT','Montana',3,2],['ND','North Dakota',4,2],['MN','Minnesota',5,2],['IL','Illinois',6,2],['MI','Michigan',7,2],['NY','New York',9,2],['MA','Massachusetts',10,2],\n   ['OR','Oregon',1,3],['NV','Nevada',2,3],['WY','Wyoming',3,3],['SD','South Dakota',4,3],['IA','Iowa',5,3],['IN','Indiana',6,3],['OH','Ohio',7,3],['PA','Pennsylvania',8,3],['NJ','New Jersey',9,3],['CT','Connecticut',10,3],['RI','Rhode Island',11,3],\n   ['CA','California',1,4],['UT','Utah',2,4],['CO','Colorado',3,4],['NE','Nebraska',4,4],['MO','Missouri',5,4],['KY','Kentucky',6,4],['WV','West Virginia',7,4],['VA','Virginia',8,4],['MD','Maryland',9,4],['DE','Delaware',10,4],\n   ['AZ','Arizona',2,5],['NM','New Mexico',3,5],['KS','Kansas',4,5],['AR','Arkansas',5,5],['TN','Tennessee',6,5],['NC','North Carolina',7,5],['SC','South Carolina',8,5],\n   ['OK','Oklahoma',4,6],['LA','Louisiana',5,6],['MS','Mississippi',6,6],['AL','Alabama',7,6],['GA','Georgia',8,6],\n   ['TX','Texas',4,7],['FL','Florida',9,7]];\n  var NAME={};ST.forEach(function(s){NAME[s[0]]=s[1];});\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function has(n){var v=A[n];return v!=null&&v!=='';}\n  function T(n){return SPSite.getQuestion(n).title;}\n  var YOU={step:'About you',names:['home_state','current_state','age','gender']};\n  function saveAll(items,b,then){b.disabled=true;\n    (function step(i){if(i>=items.length)return then();\n      SPSite.answer(items[i][0],items[i][1]).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}A[items[i][0]]=items[i][1];step(i+1);});})(0);}\n  function next(){window.scrollTo(0,0);\n    if(A.consent!==true)return intro();\n    for(var j=0;j<YOU.names.length;j++)if(!has(YOU.names[j]))return form(YOU);\n    if(!has('state_ranking')||!has('least_preferred'))return rank();\n    finish();}\n  function intro(){\n    app.innerHTML='<h1>Where would you most like to live?</h1><p>You will put the 48 contiguous states of the United States in order, from the one you would most like to live in to the one you would least like to live in. There are no right answers; only your own, quite personal preferences count. It takes about 10 minutes.</p><div class=\"card\"><p>'+esc(T('consent'))+'</p><div class=\"row\"><button class=\"btn\" id=\"yes\">I agree</button></div><div class=\"err\"></div></div>';\n    document.getElementById('yes').onclick=function(){saveAll([['consent',true]],this,next);};}\n  function form(P){\n    var h='<div class=\"card\"><span class=\"step\">'+esc(P.step)+'</span>';\n    P.names.forEach(function(n){var q=SPSite.getQuestion(n);h+='<div class=\"q\"><b>'+esc(T(n))+'</b>';\n      if(q.type==='radiogroup')h+=q.choices.map(function(c){return '<label class=\"o\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');\n      else h+='<input id=\"f_'+n+'\" type=\"'+(q.kind==='number'?'number':'text')+'\"'+(q.kind==='number'?' min=\"10\" max=\"110\"':'')+'>';\n      h+='</div>';});\n    app.innerHTML=h+'<div class=\"row\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var items=[];\n      for(var k=0;k<P.names.length;k++){var n=P.names[k],q=SPSite.getQuestion(n),x;\n        if(q.type==='radiogroup'){var c=app.querySelector('input[name=\"'+n+'\"]:checked');x=c?c.value:'';}\n        else{x=document.getElementById('f_'+n).value.trim();if(q.kind==='number'&&x!==''){x=Number(x);if(isNaN(x)||x<10||x>110)return err('Please enter your age in years.');}}\n        if(x==='')return err('Please answer: '+T(n).slice(0,80));\n        items.push([n,x]);}\n      saveAll(items,this,next);};}\n  function tiles(order,final){var pos={};order.forEach(function(c,i){pos[c]=i+1;});\n    return '<div class=\"grid\">'+ST.map(function(s){var r=pos[s[0]],st='grid-column:'+s[2]+';grid-row:'+(s[3]+1)+';';\n      if(r){var t=(r-1)/47;st+='background:hsl('+(final?Math.round(130-130*t):215)+','+(final?'55%':'60%')+','+(final?Math.round(38+14*Math.abs(t-.5)):Math.round(38+40*t))+'%);color:#fff;border-color:transparent;';}\n      return '<button type=\"button\" class=\"tile\" data-c=\"'+s[0]+'\" style=\"'+st+'\" title=\"'+esc(s[1])+'\"'+(final?' disabled':'')+'><b>'+s[0]+'</b>'+(r?'<i>'+r+'</i>':'')+'</button>';}).join('')+'</div>';}\n  function rank(){\n    var order=[],t0=Date.now(),moves=0;\n    app.innerHTML='<div class=\"card\"><span class=\"step\">Your ranking</span><h1>'+esc(T('state_ranking'))+'</h1><p>Tap the state you would <b>most</b> like to live in first, then your second choice, and so on until all 48 states are in your list. You can tap a state on the map or its name below. Use the arrows in your list to move a state up or down, or ✕ to take it out.</p><p>Where you find it hard to place a state, match it against the others one after another and ask yourself: \"If I had to choose, which would I prefer?\"</p><div id=\"map\"></div><div class=\"q\"><b>States not yet ranked <span id=\"left\" style=\"font-weight:400;color:#777\"></span></b><div id=\"pool\" class=\"pool\"></div></div><div class=\"q\"><b>Your list, most preferred first</b><ol id=\"list\" class=\"rlist\"></ol></div><div class=\"row\"><button class=\"btn\" id=\"go\">My ranking is finished</button></div><div class=\"err\"></div></div>';\n    var map=document.getElementById('map'),pool=document.getElementById('pool'),list=document.getElementById('list');\n    function paint(){map.innerHTML=tiles(order,false);\n      var rest=ST.filter(function(s){return order.indexOf(s[0])<0;}).sort(function(a,b){return a[1]<b[1]?-1:1;});\n      pool.innerHTML=rest.map(function(s){return '<button type=\"button\" class=\"chip\" data-c=\"'+s[0]+'\">'+esc(s[1])+'</button>';}).join('')||'<span style=\"color:#777\">All states are ranked.</span>';\n      document.getElementById('left').textContent='('+rest.length+' left)';\n      list.innerHTML=order.map(function(c,i){return '<li><span>'+esc(NAME[c])+'</span><span class=\"mv\"><button type=\"button\" data-a=\"up\" data-i=\"'+i+'\" aria-label=\"Move '+esc(NAME[c])+' up\"'+(i?'':' disabled')+'>▲</button><button type=\"button\" data-a=\"down\" data-i=\"'+i+'\" aria-label=\"Move '+esc(NAME[c])+' down\"'+(i<order.length-1?'':' disabled')+'>▼</button><button type=\"button\" data-a=\"del\" data-i=\"'+i+'\" aria-label=\"Remove '+esc(NAME[c])+'\">✕</button></span></li>';}).join('');}\n    function add(c){if(order.indexOf(c)>=0)return;order.push(c);err('');paint();}\n    map.addEventListener('click',function(e){var b=e.target.closest('.tile');if(b)add(b.getAttribute('data-c'));});\n    pool.addEventListener('click',function(e){var b=e.target.closest('.chip');if(b)add(b.getAttribute('data-c'));});\n    list.addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;var i=Number(b.getAttribute('data-i')),a=b.getAttribute('data-a'),c=order[i];moves++;\n      if(a==='del')order.splice(i,1);else{var j=a==='up'?i-1:i+1;if(j<0||j>=order.length)return;order[i]=order[j];order[j]=c;}paint();});\n    paint();\n    document.getElementById('go').onclick=function(){\n      if(order.length<ST.length)return err('Please rank all 48 states. '+(ST.length-order.length)+' are still left.');\n      var ranks={};order.forEach(function(c,i){ranks[c]=i+1;});\n      saveAll([['state_ranking',{order:order.slice(),ranks:ranks,adjustments:moves,seconds:Math.round((Date.now()-t0)/1000)}],['most_preferred',NAME[order[0]]],['least_preferred',NAME[order[order.length-1]]]],this,next);};}\n  function finish(){\n    var o=(A.state_ranking&&A.state_ranking.order)||[];\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>This is your own mental map: green states are the ones you would most like to live in, red the ones you would least like to live in.</p>'+tiles(o,true)+'<p style=\"margin-top:12px\">In 1966 the geographer Peter Gould asked students at four American universities for the same ranking. Combining the lists, he drew maps of \"residential desirability\". Students in California, Minnesota and Pennsylvania shared almost the same map, with a high ridge along the West Coast and the lowest values in the South, and a local peak around their own state; students in Alabama saw the country quite differently.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');return;}var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';});}\n  SPSite.onReady(function(ctx){A=(ctx&&ctx.answers)||{};next();});\n})();\n</script>\n</body>\n</html>\n",
