   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Subway Entrance Pavilions</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"How do you like these subway station entrances?\",\n  \"description\": \"Faithful replication of the online photo survey of Li, Han, Shen, Wang, Gu, Yang & Zhang (2023), A Demographic Characteristics-Based Study on the Visual Impact Assessment of the External Form of Entrance Pavilions to the Underground Stations of China's Subway, Applied Sciences 13(6):4030. Nine renderings (A-I) of real subway entrance pavilions in nine Chinese cities, modelled in SketchUp and rendered with V-Ray at 167 cm eye height under a clear sky, are shown together in random order; each is scored from 1 (strongly dislike) to 5 (strongly like) and can be revised before submitting. Gender, age group, education level and design experience follow. Scores are keyed by rendering letter (A-I).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"pavilions\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I am 18 or older and agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"renderings\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"score\",\n      \"title\": \"How do you like the external form of this subway entrance pavilion?\",\n      \"isRequired\": true,\n      \"rateValues\": [\n       {\n        \"value\": 1,\n        \"text\": \"Strongly dislike\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Mildly dislike\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Neutral\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Mildly like\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"Strongly like\"\n       }\n      ],\n      \"description\": \"Keyed by rendering letter (A-I), 1-5.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age_group\",\n      \"title\": \"Age (years)\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"18-34\",\n        \"text\": \"18–34\"\n       },\n       {\n        \"value\": \"35-59\",\n        \"text\": \"35–59\"\n       },\n       {\n        \"value\": \"60+\",\n        \"text\": \"60 or older\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Education level\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"higher\",\n        \"text\": \"I have received higher education\"\n       },\n       {\n        \"value\": \"no_higher\",\n        \"text\": \"I have not received higher education\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"design_experience\",\n      \"title\": \"Do you have design experience (e.g. study or work in architecture, landscape or design)?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"pavilion-table\">{\"source\": \"Li et al. (2023) Applied Sciences 13:4030, Figure 4 and Section 3.1; N=320 valid responses. Highest mean: H (4.15); lowest mean: G (2.07).\", \"renderings\": [{\"id\": \"A\", \"pavilion\": \"Entrance Pavilion 1, West Fuyuan Bridge Station, Changsha Metro Line 4\"}, {\"id\": \"B\", \"pavilion\": \"Entrance Pavilion A, Dananmen Station, Taiyuan Metro Line 2\"}, {\"id\": \"C\", \"pavilion\": \"Entrance Pavilion C2, Haihe Jiaoyuyuanqv Station, Tianjin Metro Line 6\"}, {\"id\": \"D\", \"pavilion\": \"Entrance Pavilion 3, Damuqiao Road Station, Shanghai Metro Line 12\"}, {\"id\": \"E\", \"pavilion\": \"Entrance Pavilion H1, South Railway Station, Chengdu Metro Line 18\"}, {\"id\": \"F\", \"pavilion\": \"Entrance Pavilion A2, Olympic Sports Center Station, Xi'an Metro Line 14\"}, {\"id\": \"G\", \"pavilion\": \"Entrance Pavilion C, Wangjing West Station, Beijing Metro Line 13\"}, {\"id\": \"H\", \"pavilion\": \"Entrance Pavilion 1, Zhongshan Park Station, Xiamen Metro Line 1\"}, {\"id\": \"I\", \"pavilion\": \"Entrance Pavilion 1, Chaoyang Square Station, Nanning Metro Line 1\"}]}</script>\n<style>\n:root{--bg:#f3f2ee;--card:#fff;--ink:#1d1f1c;--muted:#5d6159;--accent:#3d6b4f;--line:#d9dad2;--warn:#b3261e;--sel:#e0ece4}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1100px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.grid{display:grid;grid-template-columns:1fr;gap:14px;margin-top:14px}\n.b{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px}\n.b img{width:100%;height:auto;display:block;border-radius:8px}\n.b .no{font-weight:700;margin:6px 0 4px}\n.o{display:grid;grid-template-columns:repeat(5,1fr);gap:3px}.anch{display:flex;justify-content:space-between;font-size:.75rem;color:var(--muted);margin-top:3px}\ninput.txt{font:inherit;width:100%;max-width:360px;padding:9px 11px;border:1px solid var(--line);border-radius:10px;margin-top:6px}\n.o label{display:flex;flex-direction:column;align-items:center;gap:2px;border:1px solid var(--line);border-radius:8px;padding:9px 1px;cursor:pointer;font-size:.68rem;line-height:1.15;text-align:center;color:var(--muted)}\n.o label b{font-size:.95rem;color:var(--ink)}\n.o label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.o input{display:none}\n.b.miss{outline:2px solid var(--warn);outline-offset:2px}\n.blk{margin-top:14px}.blk:first-child{margin-top:0}\n.blk.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.err{color:var(--warn);margin-top:8px;min-height:1.5em;line-height:1.5}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:700px){.b{padding:8px}.o{gap:2px}.o label b{font-size:.88rem}}\n.grid{grid-template-columns:repeat(auto-fill,minmax(320px,1fr))}\n.o label{font-size:.66rem;padding:8px 1px}\n.b img{aspect-ratio:1074/570;object-fit:cover}\n.prog{font-size:.9rem;color:var(--muted);margin-top:6px}\n@media (max-width:700px){.grid{grid-template-columns:1fr}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Renderings and survey design: Li, Han, Shen, Wang, Gu, Yang &amp; Zhang (2023), A Demographic Characteristics-Based Study on the Visual Impact Assessment of the External Form of Entrance Pavilions to the Underground Stations of China's Subway, Applied Sciences 13(6):4030 (doi:10.3390/app13064030, CC BY 4.0). Renderings cropped from Figure 4 (captions and letters removed). Removed on request of the authors.</footer>\n<script>\n(function(){\n  var KEY='li2023pavilion:state', IDS=['A','B','C','D','E','F','G','H','I'], BG=['gender','age_group','education','design_experience'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='';}}\n  function hideErr(){var e=app.querySelector('.err');if(e&&!app.querySelector('.miss'))e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function intro(){\n    app.innerHTML='<h1>Subway station entrance pavilions</h1><p>The entrance pavilion is the part of a subway station you see above ground. You will see renderings of nine entrance pavilions from subway lines in Chinese cities. Please score how much you like the external form of each one, from 1 (strongly dislike) to 5 (strongly like). You can look back and change any score before you submit. A few short questions about you follow. It takes about 3–5 minutes and your answers are anonymous.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='pics';st.order=shuffle(IDS);st.r={};save();route();});};\n  }\n  function prog(){var n=IDS.filter(function(k){return st.r[k];}).length,e=document.getElementById('prog');if(e)e.textContent=n+' of '+IDS.length+' scored';}\n  function pics(){\n    var q=Q.score,sc=q.rateValues||[],ids=st.order,r=st.r;\n    app.innerHTML='<h2>Score the nine entrance pavilions</h2><p>'+esc(q.title)+' 1 = strongly dislike, 5 = strongly like.</p><div class=\"grid\">'+ids.map(function(id,i){\n      return '<div class=\"b\" data-k=\"'+id+'\"><div class=\"no\">Rendering '+(i+1)+'</div><img alt=\"Rendering of a subway station entrance pavilion\" src=\"'+esc(files[id].url)+'\"><div class=\"o\" style=\"margin-top:8px\">'+sc.map(function(s){return '<label><input type=\"radio\" name=\"r_'+id+'\" value=\"'+s.value+'\"'+(r[id]===Number(s.value)?' checked':'')+'><b>'+s.value+'</b>'+esc(s.text)+'</label>';}).join('')+'</div></div>';}).join('')+\n      '</div><div class=\"card\"><div id=\"prog\" class=\"prog\"></div><div style=\"margin-top:10px\"><button class=\"btn\" id=\"go\">Submit scores</button></div><div class=\"err\"></div></div>';\n    prog();\n    document.getElementById('go').onclick=function(){\n      var miss=[],L=[];\n      ids.forEach(function(id){var x=app.querySelector('input[name=\"r_'+id+'\"]:checked');if(x)r[id]=Number(x.value);else miss.push(app.querySelector('.b[data-k=\"'+id+'\"]'));});\n      save();\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please score every rendering.');}\n      ids.forEach(function(id,i){L.push(SPSite.answer('score',r[id],{key:id,shown:[files[id].name]}));});\n      send(L,this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+BG.map(function(n){var q=Q[n];\n      return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var L=[],miss=[];\n      BG.forEach(function(n){var x=app.querySelector('input[name=\"'+n+'\"]:checked');if(!x){miss.push(app.querySelector('.blk[data-n=\"'+n+'\"]'));return;}\n        L.push(SPSite.answer(n,x.value));});\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please answer the marked questions.');}\n      send(L,this,function(){st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var b=e.target.closest&&e.target.closest('.b,.blk');if(b){b.classList.remove('miss');hideErr();}\n    if(e.target.name&&/^r_/.test(e.target.name)&&st&&st.r){st.r[e.target.name.slice(2)]=Number(e.target.value);save();prog();}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='pics')return pics();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','score'].concat(BG).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('pavilions')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'').replace(/^pavilion_/,'')]=f;});\n    var need=IDS.filter(function(k){return !files[k];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload pavilion_'+esc(need.join(', pavilion_'))+' (.jpg) to the media folder \"pavilions\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.step&&st.order)||a.consent!==true)st={step:'intro'};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
