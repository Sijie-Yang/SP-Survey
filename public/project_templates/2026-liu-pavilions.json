   "id": "site-b808aecdc26e8d7d",
   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Garden Paintings Viewing</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Pavilions in Chinese Garden Paintings: Free Viewing and Impressions\",\n  \"description\": \"Participants freely view five pavilion scenes from the 1744 album Forty Views of the Yuanmingyuan (Jiajing mingqin, Shangxia tianguang, Changchun xianguan, Xinghua chunguan, Tantan dangdang) in random order, 25 s each with a 5 s grey screen in between, then answer the study's eight post-viewing questions (six 5-point agreement items on whole-to-detail viewing and on pavilions as focal points, the painting that made the deepest impression, and which elements become visual focal points). Rebuilt from Liu, Fu, Hou & Wang (2026), Journal of Eye Movement Research 19(6): 122, using public-domain images of the same paintings from Wikimedia Commons. Analysis: medians and agreement rates per item, choice shares for the two choice questions (the paper's eye-tracking measures need an eye tracker).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"paintings\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I am 18 or older and agree to take part in this study.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"impressions\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"viewed\",\n      \"title\": \"Viewing time per painting (ms)\",\n      \"isRequired\": false,\n      \"description\": \"Recorded by the page when each painting is shown (25 000 ms), keyed by painting: jjmq, sxtg, ccxg, xhcg, ttdd. Order is random per participant.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"q1_whole_to_detail\",\n      \"title\": \"When appreciating these paintings, I first take in the overall composition and then gradually focus on the finer details.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"q2_deepest_impression\",\n      \"title\": \"Of these five paintings, which type of scene made the deepest impression on you?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"jjmq\",\n        \"text\": \"A. Jiajing mingqin (Double Reflection and Sound of the Lute)\"\n       },\n       {\n        \"value\": \"sxtg\",\n        \"text\": \"B. Shangxia tianguang (Light of Heaven Above and Below)\"\n       },\n       {\n        \"value\": \"ccxg\",\n        \"text\": \"C. Changchun xianguan (Eternal Spring Immortals Hall)\"\n       },\n       {\n        \"value\": \"xhcg\",\n        \"text\": \"D. Xinghua chunguan (Apricot Blossom Spring Villa)\"\n       },\n       {\n        \"value\": \"ttdd\",\n        \"text\": \"E. Tantan dangdang (The Magnanimous World)\"\n       }\n      ]\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"q3_notice_buildings\",\n      \"title\": \"Compared to natural elements, I tend to notice the buildings in an image more readily.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"checkbox\",\n      \"name\": \"q4_focal_element\",\n      \"title\": \"For me, the elements most likely to become the visual focal point are:\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"buildings\",\n        \"text\": \"Buildings\"\n       },\n       {\n        \"value\": \"rocky_terrain\",\n        \"text\": \"Rocky terrain\"\n       },\n       {\n        \"value\": \"water\",\n        \"text\": \"Bodies of water\"\n       },\n       {\n        \"value\": \"trees_flowers\",\n        \"text\": \"Trees and flowers\"\n       },\n       {\n        \"value\": \"people_boats\",\n        \"text\": \"People and boats\"\n       }\n      ]\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"q5_pavilion_composition\",\n      \"title\": \"I believe that pavilions or similar small structures are very important in the overall composition of a landscape.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"q6_pavilion_gaze\",\n      \"title\": \"When a pavilion appears in a scene, my gaze is often drawn to it.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"q7_imagine_in_pavilion\",\n      \"title\": \"When viewing these paintings, I often find myself subconsciously imagining that I am standing inside the pavilion, gazing out at the surrounding scenery.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"q8_pavilion_spatial\",\n      \"title\": \"The location and orientation of the pavilion influence my understanding of the spatial relationships within the painting.\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"woman\",\n        \"text\": \"Woman\"\n       },\n       {\n        \"value\": \"man\",\n        \"text\": \"Man\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"painting_exposure\",\n      \"title\": \"How much have you seen Chinese ancient landscape paintings or garden images before?\",\n      \"isRequired\": true,\n      \"description\": \"The paper's five-category exposure item; the question wording is mine, the categories follow the paper.\",\n      \"choices\": [\n       {\n        \"value\": \"almost_none\",\n        \"text\": \"Almost never\"\n       },\n       {\n        \"value\": \"occasional\",\n        \"text\": \"Occasionally\"\n       },\n       {\n        \"value\": \"moderate\",\n        \"text\": \"Moderately often\"\n       },\n       {\n        \"value\": \"frequent\",\n        \"text\": \"Frequently\"\n       },\n       {\n        \"value\": \"very_frequent\",\n        \"text\": \"Very frequently, through study or work\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"ymy-original\">{\"source\": \"Liu, Fu, Hou & Wang (2026) Journal of Eye Movement Research 19(6): 122\", \"n\": 30, \"participants\": \"11 men and 19 women, 29 aged 18–35; students and other adults; lab with Tobii Pro Spectrum eye tracker, 55-inch 4K screen at 80 cm\", \"result\": \"Eye tracking: pavilions were usually not the first elements fixated and received less cumulative attention than vegetation, terrain or larger buildings; Jiajing mingqin drew the most pavilion attention. Questionnaire: Q1 median 4 (76.7% agree); deepest impression Xinghua chunguan 36.7%, Shangxia tianguang 33.3%, Tantan dangdang 0%; Q3 median 4 (83.3% agree); buildings chosen as focal element by 96.7%; Q5 median 4 (70% agree); Q6 median 4 (60%); Q7 median 2.5 (50% disagree); Q8 median 3 (36.7% agree, 40% neutral).\"}</script>\n<style>\n:root{--bg:#f5f3ee;--card:#fff;--ink:#1d241e;--muted:#5c685e;--accent:#7a3b2e;--line:#e1dcd2;--warn:#b3261e;--sel:#f3e6e2}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn.sec{background:#fff;color:var(--ink);border:1px solid var(--line)}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.view{position:fixed;inset:0;background:#808080;display:flex;align-items:center;justify-content:center;z-index:5}\n.view img{max-width:96vw;max-height:94vh;width:auto;height:auto;display:block}\n.view .t{position:absolute;bottom:6px;left:0;right:0;text-align:center;color:#ddd;font-size:.8rem}\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px}\n.tile{position:relative;border:2px solid var(--line);border-radius:10px;overflow:hidden;cursor:pointer;background:#fff;padding:0}\n.tile img{width:100%;display:block}\n.tile.on{border-color:var(--accent)}\n.tile .n{position:absolute;top:6px;left:6px;min-width:30px;height:30px;border-radius:15px;background:var(--accent);color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.row{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;margin-top:6px}.row label{display:flex;flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:8px;padding:5px 0;cursor:pointer;font-size:.85rem}.row label:has(input:checked){background:var(--sel);border-color:var(--accent)}.row input{margin:0 0 2px}.ends{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-top:2px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Paintings: <i>Forty Views of the Yuanmingyuan</i> (1744), court painters Shen Yuan and Tang Dai; image files from Wikimedia Commons (four CC BY-SA 3.0, one public domain). Study design and questions: Liu, Fu, Hou &amp; Wang (2026), Journal of Eye Movement Research 19(6): 122 (doi:10.3390/jemr19060122, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='ymy-pavilions:state', T=window.__VIEWMS?{view:window.__VIEWMS,grey:window.__VIEWMS}:{view:25000,grey:5000};\n  var LIK=['q1_whole_to_detail','q3_notice_buildings','q5_pavilion_composition','q6_pavilion_gaze','q7_imagine_in_pavilion','q8_pavilion_spatial'];\n  var app=document.getElementById('app'), Q={}, files={}, ids=[], st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q,extra){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(extra||'')+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function checks(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b><div style=\"font-size:.85rem;color:var(--muted)\">Choose one or more.</div>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"checkbox\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function likert(q){var h='<div class=\"f\"><b>'+esc(Q[q].title)+'</b><div class=\"row\">';for(var i=1;i<=5;i++)h+='<label><input type=\"radio\" name=\"'+q+'\" value=\"'+i+'\">'+i+'</label>';return h+'</div><div class=\"ends\"><span>Strongly disagree</span><span>Strongly agree</span></div></div>';}\n  function intro(){\n    app.innerHTML='<h1>Chinese garden paintings</h1><p>You will see '+st.view.length+' paintings of the Yuanmingyuan imperial garden in Beijing, made by court painters in 1744. Each painting stays on screen for 25 seconds, followed by a short grey screen; you do not need to press anything. Look at each one naturally, as you would look at a painting in everyday life. A larger screen in landscape orientation works best. Afterwards there are a few short questions. It takes about 5 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='ready';save();route();});};\n  }\n  function ready(){\n    app.innerHTML='<h2>Viewing the paintings</h2><div class=\"card\"><p style=\"color:var(--ink)\">The paintings will now play by themselves, 25 seconds each. Please keep looking at the screen.</p><button class=\"btn\" id=\"go\">Begin</button></div>';\n    document.getElementById('go').onclick=function(){st.step='watch';st.k=0;save();route();};\n  }\n  function watch(){\n    var v=document.createElement('div');v.className='view';app.innerHTML='';app.appendChild(v);\n    function show(){\n      if(st.k>=st.view.length){st.step='ask';save();return route();}\n      var id=st.view[st.k],im=new Image();im.src=files[id].url;im.alt='Garden painting';\n      v.innerHTML='';v.appendChild(im);var t=document.createElement('div');t.className='t';t.textContent=(st.k+1)+' / '+st.view.length;v.appendChild(t);\n      var sh=[files[id].name];SPSite.answer('viewed',T.view,{key:id,shown:sh});\n      setTimeout(function(){v.innerHTML='';st.k++;save();setTimeout(show,T.grey);},T.view);\n    }\n    show();\n  }\n  function ask(){\n    var q2='<div class=\"grid\" style=\"margin:8px 0\">'+Q.q2_deepest_impression.choices.map(function(c){return files[c.value]?'<figure style=\"margin:0\"><img alt=\"\" style=\"width:100%;border-radius:6px\" src=\"'+esc(files[c.value].url)+'\"><figcaption style=\"font-size:.8rem;color:var(--muted)\">'+esc(c.text)+'</figcaption></figure>':'';}).join('')+'</div>';\n    app.innerHTML='<h2>Your impressions</h2><div class=\"card\">'+likert('q1_whole_to_detail')+radios('q2_deepest_impression',q2)+likert('q3_notice_buildings')+checks('q4_focal_element')+likert('q5_pavilion_composition')+likert('q6_pavilion_gaze')+likert('q7_imagine_in_pavilion')+likert('q8_pavilion_spatial')+'</div><h2 style=\"margin-top:22px\">About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"110\"></div>'+radios('gender')+radios('painting_exposure')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var names=LIK.concat(['q2_deepest_impression','gender','painting_exposure']),v=names.map(val),age=Number(document.getElementById('age').value),q4=[].map.call(app.querySelectorAll('input[name=q4_focal_element]:checked'),function(x){return x.value;});\n      if(v.some(function(x){return !x;})||!q4.length)return err('Please answer every question.');if(!(age>=18&&age<=110))return err('Please enter your age.');\n      send(names.map(function(n,i){return SPSite.answer(n,LIK.indexOf(n)>=0?Number(v[i]):v[i]);}).concat([SPSite.answer('q4_focal_element',q4),SPSite.answer('age',age)]),this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='ready')return ready();if(s==='watch')return watch();if(s==='ask')return ask();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','viewed','q2_deepest_impression','q4_focal_element','age','gender','painting_exposure'].concat(LIK).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('paintings')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name)){var k=f.name.replace(/\\.[^.]+$/,'');files[k]=f;ids.push(k);}});\n    if(ids.length<2){app.innerHTML='<h1>Paintings missing</h1><p>Upload the paintings to the media folder \"paintings\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var valid=st&&st.view&&st.view.length===ids.length&&st.view.every(function(x){return files[x];});\n    if(!valid)st={step:'intro',view:shuffle(ids),k:0};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    if(st.step==='watch')st.step='ready';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
