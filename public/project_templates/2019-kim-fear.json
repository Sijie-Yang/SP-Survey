   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Campus Nightscapes</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Fear of Campus Nightscapes\",\n  \"description\": \"Faithful replication of Kim, Cheon & Kang (2019), Sustainability 11:233: rate perceived fear (1 = very safe … 7 = very fearful) for six night photographs of the Virginia Tech campus, either built or nature-dominant scenes, each with and without an adult figure.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"nightscapes\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"intro\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part voluntarily and know I can stop at any time.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Man\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Woman\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age_group\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Under 20\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"20–29\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"30–39\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"40–49\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"50 or older\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"role\",\n      \"title\": \"Which describes you best?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Student\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Faculty member\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Staff member\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Other\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"ratings\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"perceived_fear\",\n      \"title\": \"How fearful does this place at night make you feel?\",\n      \"isRequired\": false,\n      \"description\": \"Each participant is assigned at random to one image group, as in the paper: BNIG = the six built nightscapes (built1–3), NNIG = the six nature-dominant nightscapes (nature1–3). Each set has the same view without and with an adult figure (_noadult / _adult). One trial per image in random order; value 1 = very safe … 7 = very fearful. Analysis as in the paper: two-way ANOVA of fear by landscape type (built vs nature-dominant) × adult presence.\",\n      \"min\": 1,\n      \"max\": 7,\n      \"trials\": [\n       {\n        \"id\": \"built1_noadult\",\n        \"group\": \"BNIG\",\n        \"landscape\": \"built\",\n        \"set\": 1,\n        \"adult\": false\n       },\n       {\n        \"id\": \"built1_adult\",\n        \"group\": \"BNIG\",\n        \"landscape\": \"built\",\n        \"set\": 1,\n        \"adult\": true\n       },\n       {\n        \"id\": \"built2_noadult\",\n        \"group\": \"BNIG\",\n        \"landscape\": \"built\",\n        \"set\": 2,\n        \"adult\": false\n       },\n       {\n        \"id\": \"built2_adult\",\n        \"group\": \"BNIG\",\n        \"landscape\": \"built\",\n        \"set\": 2,\n        \"adult\": true\n       },\n       {\n        \"id\": \"built3_noadult\",\n        \"group\": \"BNIG\",\n        \"landscape\": \"built\",\n        \"set\": 3,\n        \"adult\": false\n       },\n       {\n        \"id\": \"built3_adult\",\n        \"group\": \"BNIG\",\n        \"landscape\": \"built\",\n        \"set\": 3,\n        \"adult\": true\n       },\n       {\n        \"id\": \"nature1_noadult\",\n        \"group\": \"NNIG\",\n        \"landscape\": \"nature-dominant\",\n        \"set\": 1,\n        \"adult\": false\n       },\n       {\n        \"id\": \"nature1_adult\",\n        \"group\": \"NNIG\",\n        \"landscape\": \"nature-dominant\",\n        \"set\": 1,\n        \"adult\": true\n       },\n       {\n        \"id\": \"nature2_noadult\",\n        \"group\": \"NNIG\",\n        \"landscape\": \"nature-dominant\",\n        \"set\": 2,\n        \"adult\": false\n       },\n       {\n        \"id\": \"nature2_adult\",\n        \"group\": \"NNIG\",\n        \"landscape\": \"nature-dominant\",\n        \"set\": 2,\n        \"adult\": true\n       },\n       {\n        \"id\": \"nature3_noadult\",\n        \"group\": \"NNIG\",\n        \"landscape\": \"nature-dominant\",\n        \"set\": 3,\n        \"adult\": false\n       },\n       {\n        \"id\": \"nature3_adult\",\n        \"group\": \"NNIG\",\n        \"landscape\": \"nature-dominant\",\n        \"set\": 3,\n        \"adult\": true\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#e9ebf0;--card:#fff;--ink:#20231d;--muted:#5d6456;--accent:#2f4a7a;--accent-ink:#fff;--line:#d6dccf;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q>b{display:block;margin-bottom:4px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;max-width:160px;background:#fff;color:var(--ink)}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem;font-variant-numeric:tabular-nums}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.pano{background:#1c2a22;border-radius:12px;height:min(50vh,300px);overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch}.pano img{height:100%;width:auto;display:block;max-width:none}.hint{font-size:.85rem;color:var(--muted);margin-top:6px}.big{font-size:1.4rem;font-variant-numeric:tabular-nums;font-weight:600}.stage{background:#808080;border-radius:12px;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;overflow:hidden}\n.stage img{width:100%;height:100%;object-fit:contain;display:block}\n.cross{color:#fff;font-size:3rem;font-weight:300;line-height:1}\n.pic{background:#e3e7df;border-radius:12px;overflow:hidden}.pic img{width:100%;max-height:min(40vh,380px);object-fit:contain;display:block}\n.lk{display:grid;grid-template-columns:1fr repeat(5,44px);gap:3px;align-items:center;padding:7px 0;border-top:1px solid var(--line)}\n.lk.hd{border-top:0;padding:2px 0}.lk .h{font-size:.78rem;color:var(--muted);text-align:center}\n.lk label{display:flex;justify-content:center}.lk input{width:20px;height:20px}\n.lk span.it{font-size:.92rem}.lk span.it small{display:block;color:var(--muted);font-size:.74rem;text-transform:uppercase;letter-spacing:.03em}\n.anch{font-size:.8rem;color:var(--muted);margin-top:4px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:560px){.lk{grid-template-columns:1fr repeat(5,34px);gap:2px}.lk input{width:18px;height:18px}.lk span.it{font-size:.85rem}}\n</style>\n<style>.scale{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-top:10px}.scale label{display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px 0;border:1px solid var(--line);border-radius:10px;cursor:pointer;background:var(--card);font-size:.9rem}.scale input{width:20px;height:20px}.ends{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-top:4px}.pic.night{background:#111}.pic.night img{max-height:min(55vh,460px)}</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Kim, Cheon &amp; Kang (2019), Sustainability 11:233, Appendix A, doi:10.3390/su11010233 (CC BY 4.0; nightscapes on the Virginia Tech campus, USA). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='nightfear2019:';\n  var app=document.getElementById('app'), Q={}, files={}, ans={}, TR=[], order=[], rated={};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function q(n){return Q[n]||{};}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function page(html,btn,cb){app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn)+'</button></div><div class=\"err\"></div>';document.getElementById('go').onclick=cb;app.onchange=hideErr;}\n  function send(list,b,done){b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}done();});}\n  function next(){\n    window.scrollTo(0,0);\n    if(!ans.intro)return intro();\n    if(!ans.about)return about();\n    for(var i=0;i<order.length;i++)if(!rated[order[i]])return rate(order[i],i);\n    finish();\n  }\n  function intro(){\n    var miss=TR.some(function(t){return !files[t.id+'.jpg'];});\n    if(miss){app.innerHTML='<h1>Pictures missing</h1><p>Media folder nightscapes must hold built1_noadult.jpg … nature3_adult.jpg (12 files).</p>';return;}\n    page('<h1>Places at night</h1><p>You will see six photographs of outdoor places on a university campus at night. For each one, imagine you are there at night and say how fearful the place makes you feel.</p><p>It takes about 3 minutes. Your answers are anonymous and used only for research.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      send([SPSite.answer('consent',true)],this,function(){ans.intro=true;save('a',ans);next();});});\n  }\n  function about(){\n    var ns=['gender','age_group','role'];\n    var h=ns.map(function(n){var d=q(n);return '<div class=\"q\"><b>'+esc(d.title)+'</b>'+(d.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('');\n    page('<h1>About you</h1><div class=\"card\">'+h+'</div>','Continue',function(){\n      var l=[];for(var i=0;i<ns.length;i++){var x=app.querySelector('input[name=\"'+ns[i]+'\"]:checked');if(!x)return err('Please answer: '+q(ns[i]).title);l.push([ns[i],Number(x.value)]);}\n      send(l.map(function(x){return SPSite.answer(x[0],x[1]);}),this,function(){ans.about=true;save('a',ans);next();});});\n  }\n  function rate(k,i){\n    var f=files[k+'.jpg'];\n    page('<div class=\"top\"><span class=\"t\">Photograph '+(i+1)+' of '+order.length+'</span><div class=\"bar\"><i style=\"width:'+(100*i/order.length)+'%\"></i></div></div><div class=\"card\"><div class=\"pic night\"><img alt=\"Night photograph of a campus place\" src=\"'+esc(f.url)+'\"></div><div class=\"q\"><b>'+esc(q('perceived_fear').title)+'</b><div class=\"scale\" role=\"radiogroup\">'+[1,2,3,4,5,6,7].map(function(v){return '<label><input type=\"radio\" name=\"fear\" value=\"'+v+'\">'+v+'</label>';}).join('')+'</div><div class=\"ends\"><span>1 = very safe</span><span>7 = very fearful</span></div></div></div>',i===order.length-1?'Finish':'Next photograph',function(){\n      var x=app.querySelector('input[name=fear]:checked');if(!x)return err('Please choose a number from 1 to 7.');\n      send([SPSite.answer('perceived_fear',Number(x.value),{key:k,shown:[f.name]})],this,function(){rated[k]=true;next();});});\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>Half of the participants see built scenes, the other half nature-dominant scenes, each place once with and once without a person in it. In the original study, 60 people rated these photographs while their brain activity was recorded with EEG. Built scenes with nobody in them felt most fearful. In the nature-dominant scenes it was the other way round: a stranger in the picture made the place feel more fearful.</p><p style=\"font-size:.82rem\">Photographs and method: Kim, M., Cheon, S., &amp; Kang, Y. (2019). Use of Electroencephalography (EEG) for the Analysis of Emotional Perception and Fear to Nightscapes. Sustainability 11:233, doi:10.3390/su11010233.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')ans.intro=false;else if(x==='perceived_fear')rated={};else ans.about=false;});save('a',ans);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    var SPEC;try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='perceived_fear')TR=e.trials;});});\n    (SPSite.getMedia('nightscapes')||[]).forEach(function(f){files[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};ans=load('a')||{};\n    var done=((a.perceived_fear&&a.perceived_fear.trials)||[]).map(function(t){return t.key;}).filter(Boolean);\n    var grp=load('grp');\n    if(done.length)grp=done[0].indexOf('built')===0?'built':'nature';\n    if(grp!=='built'&&grp!=='nature')grp=Math.random()<0.5?'built':'nature';save('grp',grp);\n    var ids=TR.map(function(t){return t.id;}).filter(function(k){return k.indexOf(grp)===0;});\n    order=load('order');if(!order||order.length!==ids.length||order.some(function(k){return ids.indexOf(k)<0;}))order=shuffle(ids);save('order',order);\n    done.forEach(function(k){rated[k]=true;});\n    ans.intro=a.consent===true;ans.about=a.role!=null;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
