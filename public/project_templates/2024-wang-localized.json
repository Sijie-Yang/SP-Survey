   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Localized Church Facades</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Localized Church Facades in China: Impression and Acceptance\",\n  \"description\": \"Method replication: the five photographs are openly licensed Wikimedia Commons photos of the same five churches; the images are not the paper's stimuli. Participants view five church facades in China that range from fully Western to fully local (Chinese) in style, in random order, each for 30 s followed by a 10 s rest. They then answer a short questionnaire: gender, age band, education and native place (south or north of the Qinling-Huaihe line), rank the five facades from most to least localized, and rate their impression of each facade and how acceptable they find it, each on a 7-point scale from -3 to +3. Rebuilt from Wang, Geng, Zhang, Jia & Fukuda (2024), Correlation research on visual behavior and cognition of impression against localized church facades in China, Heliyon 10: e28564. Localization degrees given by the paper: Ruins of St. Paul's, Macao 0%; Five Star Street Catholic Church, Xi'an 25%; Moxi (Mosey) Catholic Church, Sichuan 50%; Guiyang North Catholic Church 75%; Ancient City Catholic Church, Dali 100%. Image ids: spa, fsscc, mcc, gncc, accc (the paper's abbreviations). Analysis as in the paper: mean impression and acceptance per facade plotted against localization degree (the paper found impression rising with localization and a U-shaped acceptance curve), split by gender and education. Photos (Wikimedia Commons, resized to 1024 px): ahead4220 (CC BY-SA 2.0), TAOZIlovewiki (CC BY-SA 4.0), drnan tu (CC BY-SA 2.0), Emitchan (CC BY-SA 4.0), 蒋亦炯 (CC BY-SA 3.0). Differences from the original study: (1) different photographs of the same churches (the paper's figure versions carry colour overlays and cannot be used); (2) online, without the eye tracker, so first fixation duration, total fixation duration, fixation count and visit count are not recorded; (3) the question stems are our wording, built from the paper's Table 1 options and method text; (4) 'Other' options are added to age, education and native place because the paper's sample was 30 university students aged 18-26; (5) impression and acceptance are asked one facade per screen with its photo, in a new random order.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"churches\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"viewing\",\n    \"elements\": [\n     {\n      \"type\": \"html\",\n      \"name\": \"viewing_note\",\n      \"html\": \"Five facades, random order, 30 s view + 10 s rest each. Shown order is recorded in view_order.\"\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"view_order\",\n      \"title\": \"Order in which the facades were shown\",\n      \"description\": \"Comma-separated image ids, recorded automatically.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"18-20\",\n        \"text\": \"18-20\"\n       },\n       {\n        \"value\": \"21-23\",\n        \"text\": \"21-23\"\n       },\n       {\n        \"value\": \"24-26\",\n        \"text\": \"24-26\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Education\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"bachelor\",\n        \"text\": \"Bachelor's\"\n       },\n       {\n        \"value\": \"master\",\n        \"text\": \"Master's\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"native_place\",\n      \"title\": \"Native place\",\n      \"description\": \"North and south are divided by the Qinling Mountains-Huaihe River line.\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"south\",\n        \"text\": \"South\"\n       },\n       {\n        \"value\": \"north\",\n        \"text\": \"North\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Outside mainland China\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"rank\",\n    \"elements\": [\n     {\n      \"type\": \"ranking\",\n      \"name\": \"localization_rank\",\n      \"title\": \"Rank the five church facades from the most localized (most Chinese in style) to the least localized.\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"spa\",\n        \"text\": \"Ruins of St. Paul's, Macao\"\n       },\n       {\n        \"value\": \"fsscc\",\n        \"text\": \"Five Star Street Catholic Church, Xi'an\"\n       },\n       {\n        \"value\": \"mcc\",\n        \"text\": \"Moxi (Mosey) Catholic Church, Sichuan\"\n       },\n       {\n        \"value\": \"gncc\",\n        \"text\": \"Guiyang North Catholic Church\"\n       },\n       {\n        \"value\": \"accc\",\n        \"text\": \"Ancient City Catholic Church, Dali\"\n       }\n      ],\n      \"description\": \"Value = image ids from most to least localized.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"ratings\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"impression\",\n      \"title\": \"How impressive is this church facade to you?\",\n      \"rateMin\": -3,\n      \"rateMax\": 3,\n      \"isRequired\": true,\n      \"rateValues\": [\n       {\n        \"value\": -3,\n        \"text\": \"-3 Very unimpressive\"\n       },\n       {\n        \"value\": -2,\n        \"text\": \"-2 Unimpressive\"\n       },\n       {\n        \"value\": -1,\n        \"text\": \"-1 Slightly unimpressive\"\n       },\n       {\n        \"value\": 0,\n        \"text\": \"0 Neutral\"\n       },\n       {\n        \"value\": 1,\n        \"text\": \"+1 Slightly impressive\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"+2 Impressive\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"+3 Very impressive\"\n       }\n      ],\n      \"minRateDescription\": \"Very unimpressive\",\n      \"maxRateDescription\": \"Very impressive\",\n      \"description\": \"7-point, -3 to +3. Keyed by image id.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"acceptance\",\n      \"title\": \"How acceptable is this church facade to you?\",\n      \"rateMin\": -3,\n      \"rateMax\": 3,\n      \"isRequired\": true,\n      \"rateValues\": [\n       {\n        \"value\": -3,\n        \"text\": \"-3 Very unacceptable\"\n       },\n       {\n        \"value\": -2,\n        \"text\": \"-2 Unacceptable\"\n       },\n       {\n        \"value\": -1,\n        \"text\": \"-1 Slightly unacceptable\"\n       },\n       {\n        \"value\": 0,\n        \"text\": \"0 Neutral\"\n       },\n       {\n        \"value\": 1,\n        \"text\": \"+1 Slightly acceptable\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"+2 Acceptable\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"+3 Very acceptable\"\n       }\n      ],\n      \"minRateDescription\": \"Very unacceptable\",\n      \"maxRateDescription\": \"Very acceptable\",\n      \"description\": \"7-point, -3 to +3. Keyed by image id.\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"church-original\">{\"source\": \"Wang, Geng, Zhang, Jia & Fukuda (2024) Heliyon 10: e28564\", \"n\": 30, \"participants\": \"30 students (15 male, 15 female) aged 18-26, Qingdao University of Technology, lab with eye tracker, April 2022\", \"localization_degree\": {\"spa\": 0, \"fsscc\": 25, \"mcc\": 50, \"gncc\": 75, \"accc\": 100}, \"procedure\": \"5 images in random order, 30 s view + 10 s rest each, then questionnaire\", \"results\": {\"impression\": \"rose with localization degree: lowest at 0%, highest at 100%, largest step from 50% to 75%; males higher than females; undergraduates higher than graduates\", \"acceptance\": \"U-shaped with the turning point at 50%\", \"acceptance_by_gender\": {\"male_highest\": {\"degree\": 0, \"mean\": 1.4}, \"male_lowest\": {\"degree\": 75, \"mean\": -0.2}, \"female_highest\": {\"degree\": 100, \"mean\": 1.3}, \"female_lowest\": {\"degree\": 50, \"mean\": -0.6}}, \"correlations\": {\"impression_vs_first_fixation_duration\": 0.91, \"acceptance_vs_total_fixation_duration\": 0.928}}}</script>\n<style>\n:root{--bg:#f1efea;--card:#fff;--ink:#22201c;--muted:#615b52;--accent:#7a4b2a;--line:#ddd6cc;--warn:#b3261e;--sel:#f3e8de}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--line);padding:9px 14px;font-weight:500}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.view{position:fixed;inset:0;background:#808080;display:flex;align-items:center;justify-content:center;z-index:5}\n.view img{max-width:96vw;max-height:94vh;width:auto;height:auto;display:block}\n.view .rest{color:#eee;font-size:1.1rem}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.f{margin-top:18px}.f:first-child{margin-top:0}\n.hint{font-size:.85rem;color:var(--muted);margin:2px 0 4px}\n.pick{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px;margin-top:10px}\n.pick button{appearance:none;border:2px solid var(--line);background:#fff;border-radius:10px;padding:0;cursor:pointer;position:relative;font:inherit;text-align:left;overflow:hidden}\n.pick button img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}\n.pick button span{display:block;font-size:.78rem;padding:4px 6px;color:var(--ink)}\n.pick button.on{border-color:var(--accent);opacity:.55}\n.pick button b{position:absolute;top:6px;left:6px;background:var(--accent);color:#fff;border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;font-size:.95rem}\nol.ord{margin:10px 0 0;padding-left:22px;color:var(--ink)}\n.photo{width:100%;max-height:46vh;object-fit:contain;background:#ececec;border-radius:10px;display:block}\n.cols{display:grid;grid-template-columns:1fr 1fr;gap:16px}\n@media (max-width:600px){.cols{grid-template-columns:1fr}.photo{max-height:34vh}}\n.cols label.opt{padding:6px 10px;font-size:.92rem}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:760px;margin:0 auto;padding:0 16px 24px;font-size:.76rem;color:var(--muted)}\n.credit a{color:inherit}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photos from Wikimedia Commons, resized: <a href=\"https://commons.wikimedia.org/wiki/File:Ruins_of_Saint_Paul%27s_front_view_20120308a.jpg\" target=\"_blank\" rel=\"noopener\">ahead4220</a> (CC BY-SA 2.0), <a href=\"https://commons.wikimedia.org/wiki/File:%E4%BA%94%E6%98%9F%E8%A1%97%E5%A4%A9%E4%B8%BB%E6%95%99%E5%A0%82CNSN-029-033.jpg\" target=\"_blank\" rel=\"noopener\">TAOZIlovewiki</a> (CC BY-SA 4.0), <a href=\"https://commons.wikimedia.org/wiki/File:St_Anne%27s_Church,_Mosimien.jpg\" target=\"_blank\" rel=\"noopener\">drnan tu</a> (CC BY-SA 2.0), <a href=\"https://commons.wikimedia.org/wiki/File:%E8%B2%B4%E9%99%BD%E5%8C%97%E5%A4%A9%E4%B8%BB%E5%A0%826.jpg\" target=\"_blank\" rel=\"noopener\">Emitchan</a> (CC BY-SA 4.0), <a href=\"https://commons.wikimedia.org/wiki/File:%E4%BA%91%E5%8D%97%E5%A4%A7%E7%90%86%E5%8F%A4%E5%9F%8E%E5%A4%A9%E4%B8%BB%E6%95%99%E5%A0%821.JPG\" target=\"_blank\" rel=\"noopener\">蒋亦炯</a> (CC BY-SA 3.0). Study design: Wang et al. (2024), Heliyon 10: e28564.</footer>\n<script>\n(function(){\n  var KEY='church-facades:state', T={view:window.__VIEWMS||30000,rest:window.__VIEWMS||10000};\n  var IDS=['spa','fsscc','mcc','gncc','accc'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null, names={};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){var d=Q[q].description?'<div class=\"hint\">'+esc(Q[q].description)+'</div>':'';return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+d+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function scale(q){return '<div><b>'+esc(Q[q].title)+'</b>'+(Q[q].rateValues||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+c.value+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function intro(){\n    app.innerHTML='<h1>Church facades in China</h1><p>You will see photographs of five church facades in China, one at a time and in random order. Look at each photo freely for 30 seconds; a grey rest screen of 10 seconds follows each one. After all five, you will answer a short questionnaire about yourself and about the facades. It takes about 6 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='view';st.k=0;st.phase='view';save();route();});};\n  }\n  function view(){\n    if(st.k>=st.order.length){return send([SPSite.answer('view_order',st.order.join(','))],null,function(){st.step='about';save();route();});}\n    var id=st.order[st.k],v=document.createElement('div');v.className='view';app.innerHTML='';app.appendChild(v);\n    if(st.phase==='rest'){v.innerHTML='<div class=\"rest\">Rest</div>';setTimeout(function(){st.k++;st.phase='view';save();route();},T.rest);return;}\n    v.innerHTML='<img alt=\"Church facade\" src=\"'+esc(files[id].url)+'\">';\n    if(st.k+1<st.order.length){var p=new Image();p.src=files[st.order[st.k+1]].url;}\n    setTimeout(function(){st.phase='rest';save();route();},T.view);\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+['gender','age','education','native_place'].map(radios).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var a={};for(var n of ['gender','age','education','native_place']){a[n]=val(n);if(!a[n])return err('Please answer every question.');}\n      send(Object.keys(a).map(function(n){return SPSite.answer(n,a[n]);}),this,function(){st.step='rank';st.rank=[];save();route();});\n    };\n  }\n  function rank(){\n    var r=st.rank||[];\n    app.innerHTML='<h2>Localization</h2><div class=\"card\"><b>'+esc(Q.localization_rank.title)+'</b><div class=\"hint\">Tap the facades in order: first the most localized, last the least localized.</div><div class=\"pick\">'+st.rorder.map(function(id){var i=r.indexOf(id);return '<button type=\"button\" data-id=\"'+id+'\" class=\"'+(i>=0?'on':'')+'\"><img alt=\"\" src=\"'+esc(files[id].url)+'\">'+(i>=0?'<b>'+(i+1)+'</b>':'')+'<span>'+esc(names[id])+'</span></button>';}).join('')+'</div>'+(r.length?'<ol class=\"ord\">'+r.map(function(id){return '<li>'+esc(names[id])+'</li>';}).join('')+'</ol>':'')+'<div style=\"margin-top:16px;display:flex;gap:10px;flex-wrap:wrap\"><button class=\"btn\" id=\"go\"'+(r.length<IDS.length?' disabled':'')+'>Next</button><button class=\"btn ghost\" id=\"clr\"'+(r.length?'':' style=\"visibility:hidden\"')+'>Start over</button></div><div class=\"err\"></div></div>';\n    app.querySelectorAll('.pick button').forEach(function(b){b.onclick=function(){var id=b.getAttribute('data-id');if(r.indexOf(id)<0){r.push(id);st.rank=r;save();rank();}};});\n    document.getElementById('clr').onclick=function(){st.rank=[];save();rank();};\n    document.getElementById('go').onclick=function(){if(r.length<IDS.length)return;send([SPSite.answer('localization_rank',r.slice())],this,function(){st.step='rate';st.j=0;save();route();});};\n  }\n  function rate(){\n    if(st.j>=st.qorder.length){st.step='done';save();return route();}\n    var id=st.qorder[st.j],f=files[id];\n    app.innerHTML='<div class=\"prog\">Facade '+(st.j+1)+' of '+st.qorder.length+'</div><div class=\"card\"><img class=\"photo\" alt=\"Church facade\" src=\"'+esc(f.url)+'\"><div class=\"cols\" style=\"margin-top:14px\">'+scale('impression')+scale('acceptance')+'</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var a=val('impression'),b=val('acceptance');if(a==null||b==null)return err('Please answer both questions.');\n      send([SPSite.answer('impression',Number(a),{key:id,shown:[f.name]}),SPSite.answer('acceptance',Number(b),{key:id,shown:[f.name]})],this,function(){st.j++;save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='view')return view();if(s==='about')return about();if(s==='rank')return rank();if(s==='rate')return rate();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','view_order','gender','age','education','native_place','localization_rank','impression','acceptance'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (Q.localization_rank.choices||[]).forEach(function(c){names[c.value]=c.text;});\n    (SPSite.getMedia('churches')||[]).forEach(function(f){var k=f.name.replace(/\\.[^.]+$/,'');if(IDS.indexOf(k)>=0)files[k]=f;});\n    var miss=IDS.filter(function(k){return !files[k];});\n    if(miss.length){app.innerHTML='<h1>Photos missing</h1><p>Upload '+miss.map(function(k){return k+'.jpg';}).join(', ')+' to the media folder \"churches\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!(st&&st.order))st={step:'intro',order:shuffle(IDS),rorder:shuffle(IDS),qorder:shuffle(IDS),k:0,phase:'view',rank:[],j:0};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true)st={step:'intro',order:shuffle(IDS),rorder:shuffle(IDS),qorder:shuffle(IDS),k:0,phase:'view',rank:[],j:0};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
