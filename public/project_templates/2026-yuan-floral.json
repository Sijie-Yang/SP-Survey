   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Floral Booth Colours</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Colour of Floral Arrangement Display Booths (Song Dynasty Style)\",\n  \"description\": \"Faithful replication of Yuan, Fan, Qin & Gong (2026), Buildings 16:181: view five virtual display booths of Song Dynasty-style floral arrangements that differ only in background and text colour, then rate each on traditional atmosphere, colour comfort, artwork clarity and text clarity.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"booths\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"intro\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part voluntarily and know I can stop at any time.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"viewing\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"viewing\",\n      \"title\": \"Viewing the five display booths\",\n      \"isRequired\": false,\n      \"description\": \"As in the paper: the five virtual booth images are shown in random order, each for 15 s, with a 5 s black screen between images; the participant views them as if visiting an exhibition. Value per trial: {shown_ms, order}. The paper recorded eye movements here (Tobii Pro Glasses 2); this template records only presentation order and time.\",\n      \"trials\": [\n       {\n        \"id\": \"sample1\",\n        \"label\": \"Sample 1: sky blue + medium green (natural environment)\",\n        \"image\": \"sample1.png\"\n       },\n       {\n        \"id\": \"sample2\",\n        \"label\": \"Sample 2: vermilion + blue (imperial palace)\",\n        \"image\": \"sample2.png\"\n       },\n       {\n        \"id\": \"sample3\",\n        \"label\": \"Sample 3: vermilion + green (imperial palace)\",\n        \"image\": \"sample3.png\"\n       },\n       {\n        \"id\": \"sample4\",\n        \"label\": \"Sample 4: earth red + white (scholar's studio)\",\n        \"image\": \"sample4.png\"\n       },\n       {\n        \"id\": \"sample5\",\n        \"label\": \"Sample 5: earth red + light yellow (scholar's studio)\",\n        \"image\": \"sample5.png\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"ratings\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"booth_rating\",\n      \"title\": \"Semantic differential rating of each booth\",\n      \"isRequired\": false,\n      \"description\": \"Post-test questionnaire (Table 2 of the paper): each of the five booths is shown again (random order) and rated on four indicators, 5-point scale, 5 = very traditional / very comfortable / very clear, 1 = very avant-garde / very uncomfortable / very blurred. Value: {traditional_atmosphere, color_comfort, artwork_clarity, text_clarity}. Analysis as in the paper: repeated-measures ANOVA across the five samples with post-hoc comparisons; professional vs non-professional comparison.\",\n      \"items\": [\n       {\n        \"key\": \"traditional_atmosphere\",\n        \"text\": \"Traditional cultural atmosphere: Song Dynasty traditional – contemporary avant-garde\",\n        \"labels\": [\n         \"Very traditional\",\n         \"Relatively traditional\",\n         \"Neutral\",\n         \"Relatively avant-garde\",\n         \"Very avant-garde\"\n        ]\n       },\n       {\n        \"key\": \"color_comfort\",\n        \"text\": \"Color matching comfort: comfortable color – uncomfortable color\",\n        \"labels\": [\n         \"Very comfortable\",\n         \"Relatively comfortable\",\n         \"Neutral\",\n         \"Relatively uncomfortable\",\n         \"Very uncomfortable\"\n        ]\n       },\n       {\n        \"key\": \"artwork_clarity\",\n        \"text\": \"Artwork form clarity: clear form – blurred form\",\n        \"labels\": [\n         \"Very clear\",\n         \"Relatively clear\",\n         \"Neutral\",\n         \"Relatively blurred\",\n         \"Very blurred\"\n        ]\n       },\n       {\n        \"key\": \"text_clarity\",\n        \"text\": \"Explanatory text clarity: clear text – blurred text\",\n        \"labels\": [\n         \"Very clear\",\n         \"Relatively clear\",\n         \"Neutral\",\n         \"Relatively blurred\",\n         \"Very blurred\"\n        ]\n       }\n      ],\n      \"trials\": [\n       {\n        \"id\": \"sample1\",\n        \"label\": \"Sample 1: sky blue + medium green (natural environment)\",\n        \"image\": \"sample1.png\"\n       },\n       {\n        \"id\": \"sample2\",\n        \"label\": \"Sample 2: vermilion + blue (imperial palace)\",\n        \"image\": \"sample2.png\"\n       },\n       {\n        \"id\": \"sample3\",\n        \"label\": \"Sample 3: vermilion + green (imperial palace)\",\n        \"image\": \"sample3.png\"\n       },\n       {\n        \"id\": \"sample4\",\n        \"label\": \"Sample 4: earth red + white (scholar's studio)\",\n        \"image\": \"sample4.png\"\n       },\n       {\n        \"id\": \"sample5\",\n        \"label\": \"Sample 5: earth red + light yellow (scholar's studio)\",\n        \"image\": \"sample5.png\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Female\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age (years)\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Education level\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Below undergraduate\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Undergraduate\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Master's\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Doctoral\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"professional_background\",\n      \"title\": \"Do you have a background in color cognition or floral arrangement?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"No\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#f1eee8;--card:#fff;--ink:#26221d;--muted:#665f55;--accent:#8a3b2c;--accent-ink:#fff;--line:#ddd6cb;--warn:#b3261e;--miss:#fdecea}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q>b{display:block;margin-bottom:4px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\ninput.num{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:10px;width:120px}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.pic{border-radius:12px;overflow:hidden;background:#ddd}.pic img{width:100%;max-height:min(60vh,560px);object-fit:contain;display:block}\n.stage{position:fixed;inset:0;background:#000;display:flex;align-items:center;justify-content:center;z-index:10}\n.stage img{max-width:100vw;max-height:100vh;object-fit:contain}\n.it{padding:10px 6px;border-top:1px solid var(--line);border-radius:8px}.it.miss{background:var(--miss)}\n.x{font-weight:500;margin-bottom:6px}\n.sc{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px}\n.sc label{min-width:0;overflow-wrap:anywhere;hyphens:auto;display:flex;flex-direction:column;align-items:center;text-align:center;font-size:.72rem;line-height:1.2;color:var(--muted);cursor:pointer}\n.sc input{width:20px;height:20px;margin:0 0 3px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Booth images: Yuan, Fan, Qin &amp; Gong (2026), Buildings 16:181, Figure 3b, doi:10.3390/buildings16010181 (CC BY 4.0; floral works photographed at the 2019 Beijing International Horticultural Exhibition, China Floral Art Exhibition). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='floralbooth2026:';\n  var app=document.getElementById('app'), Q={}, files={}, ans={}, TR=[], ITEMS=[], seenV={}, rated={}, ov=null, orr=null;\n  var SP=function(){return window.__SPEED||1;};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function q(n){return Q[n]||{};}\n  function tr(id){return TR.filter(function(t){return t.id===id;})[0];}\n  function page(html,btn,cb){app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn)+'</button></div><div class=\"err\"></div>';document.getElementById('go').onclick=cb;app.onchange=function(e){hideErr();var r=e.target.closest&&e.target.closest('.it');if(r)r.classList.remove('miss');};}\n  function send(list,b,fin){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}fin();});}\n  function shuffle(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function next(){\n    window.scrollTo(0,0);\n    if(!ans.intro)return intro();\n    if(ov.some(function(id){return !seenV[id];}))return viewIntro();\n    for(var i=0;i<orr.length;i++)if(!rated[orr[i]])return rate(tr(orr[i]),i);\n    if(!ans.about)return about();\n    finish();\n  }\n  function intro(){\n    var miss=TR.some(function(t){return !files[t.image];});\n    if(miss){app.innerHTML='<h1>Pictures missing</h1><p>Media folder booths must hold the five booth images (sample1.png … sample5.png).</p>';return;}\n    page('<h1>Colours of a floral arrangement exhibition</h1><p>You will see five versions of an exhibition booth showing two Song Dynasty-style floral arrangements with a short classical text. Only the colours differ. Each picture is shown for 15 seconds on a full black screen, then you rate each booth.</p><p>It takes about 5 minutes. Your answers are anonymous and used only for research.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      send([SPSite.answer('consent',true)],this,function(){ans.intro=true;save('a',ans);next();});});\n  }\n  function viewIntro(){\n    page('<h1>Viewing</h1><p>Look at each picture carefully, as if you were visiting an exhibition. The five pictures change by themselves: 15 seconds each, with 5 seconds of black screen in between. Please don\\'t leave the page.</p>','Show the pictures',function(){runView();});\n  }\n  function runView(){\n    var todo=ov.filter(function(id){return !seenV[id];}),st=document.createElement('div');st.className='stage';document.body.appendChild(st);\n    var k=0;\n    function black(cb){st.innerHTML='';setTimeout(cb,5000/SP());}\n    function show(){\n      if(k>=todo.length){st.remove();return next();}\n      var t=tr(todo[k]),f=files[t.image],t0=Date.now(),idx=ov.indexOf(t.id);\n      st.innerHTML='<img alt=\"Floral arrangement display booth\" src=\"'+esc(f.url)+'\">';\n      setTimeout(function(){\n        SPSite.answer('viewing',{shown_ms:Date.now()-t0,order:idx+1},{key:t.id,shown:[f.name]}).then(function(){seenV[t.id]=true;k++;if(k<todo.length)black(show);else show();});\n      },15000/SP());\n    }\n    show();\n  }\n  function rate(t,i){\n    var f=files[t.image];\n    var rows=ITEMS.map(function(it){return '<div class=\"it\" data-k=\"'+it.key+'\"><div class=\"x\">'+esc(it.text)+'</div><div class=\"sc\" role=\"radiogroup\" aria-label=\"'+esc(it.text)+'\">'+it.labels.map(function(l,j){return '<label><input type=\"radio\" name=\"'+it.key+'\" value=\"'+(5-j)+'\">'+esc(l)+'</label>';}).join('')+'</div></div>';}).join('');\n    page('<div class=\"top\"><span class=\"t\">Booth '+(i+1)+' of '+orr.length+'</span><div class=\"bar\"><i style=\"width:'+(100*i/orr.length)+'%\"></i></div></div><div class=\"card\"><div class=\"pic\"><img alt=\"Floral arrangement display booth\" src=\"'+esc(f.url)+'\"></div>'+rows+'</div>',i===orr.length-1?'Continue':'Next booth',function(){\n      var v={},miss=[];\n      ITEMS.forEach(function(it){var x=app.querySelector('input[name=\"'+it.key+'\"]:checked');var r=app.querySelector('.it[data-k=\"'+it.key+'\"]');if(x)v[it.key]=Number(x.value);else{miss.push(r);r.classList.add('miss');}});\n      if(miss.length){err(miss.length+' item'+(miss.length>1?'s are':' is')+' not answered yet (marked in red).');miss[0].scrollIntoView({block:'center'});return;}\n      send([SPSite.answer('booth_rating',v,{key:t.id,shown:[f.name]})],this,function(){rated[t.id]=true;next();});});\n  }\n  function radios(name){var d=q(name);return '<div class=\"q\"><b>'+esc(d.title)+'</b>'+(d.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+name+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function about(){\n    page('<h1>About you</h1><div class=\"card\">'+radios('gender')+'<div class=\"q\"><b>'+esc(q('age').title)+'</b><input class=\"num\" type=\"number\" id=\"f_age\" min=\"10\" max=\"100\"></div>'+radios('education')+radios('professional_background')+'</div>','Finish',function(){\n      var g=app.querySelector('input[name=gender]:checked'),e=app.querySelector('input[name=education]:checked'),p=app.querySelector('input[name=professional_background]:checked'),a=Number(document.getElementById('f_age').value);\n      if(!g||!e||!p||!(a>=10&&a<=100))return err('Please answer all questions (age as a number).');\n      send([SPSite.answer('gender',Number(g.value)),SPSite.answer('age',a),SPSite.answer('education',Number(e.value)),SPSite.answer('professional_background',Number(p.value))],this,function(){ans.about=true;save('a',ans);next();});});\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>In the original study, 49 students and staff at Beijing Forestry University saw these booths. Sample 5 (earth red with light yellow, a scholar\\'s-studio scheme) felt the most traditional and the most comfortable; Sample 1 (sky blue with green) felt the least traditional. Colour also changed how long people looked at the floral works and the text.</p><p style=\"font-size:.82rem\">Images and method: Yuan, K., Fan, P., Qin, H., &amp; Gong, W. (2026). Evaluating Color Perception in Indoor Cultural Display Spaces of Traditional Chinese Floral Arrangements: A Combined Semantic Differential and Eye-Tracking Study. Buildings 16:181, doi:10.3390/buildings16010181.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')ans.intro=false;else if(x==='viewing')seenV={};else if(x==='booth_rating')rated={};else ans.about=false;});save('a',ans);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    var SPEC;try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='booth_rating'){TR=e.trials;ITEMS=e.items;}});});\n    (SPSite.getMedia('booths')||[]).forEach(function(f){files[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};ans=load('a')||{};\n    var ids=TR.map(function(t){return t.id;});\n    ov=load('ov');if(!ov||ov.length!==ids.length){ov=shuffle(ids.slice());save('ov',ov);}\n    orr=load('or');if(!orr||orr.length!==ids.length){orr=shuffle(ids.slice());save('or',orr);}\n    ((a.viewing&&a.viewing.trials)||[]).forEach(function(t){if(t.key)seenV[t.key]=true;});\n    ((a.booth_rating&&a.booth_rating.trials)||[]).forEach(function(t){if(t.key)rated[t.key]=true;});\n    ans.intro=a.consent===true;ans.about=a.gender!=null&&a.age!=null&&a.education!=null&&a.professional_background!=null;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
