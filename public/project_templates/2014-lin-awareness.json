   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Street Trees and Attention</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Awareness of Street Trees: Attention Restoration and Perceived Restorativeness\",\n  \"description\": \"Between-subjects experiment. Each participant is randomly assigned to one of four groups: No Trees (five Taipei streetscapes without greenery), Minimal Awareness (the same images with 30 ms flashes of the tree version between mirrored masks every 5 s), Moderate Awareness (streetscapes with simulated street trees), Heightened Awareness (the same tree images plus the instruction to observe the plants closely). Procedure: Digit Span Backward test, five images 20 s each, five-item Perceived Restorativeness Scale (0–6), Digit Span Backward again, then a free recall of the plant species seen. Rebuilt from Lin, Tsai, Sullivan, Chang & Chang (2014), Frontiers in Psychology 5: 906, with the paper's Figure 1 images (CC BY). Analysis: paired t-test of DSBT pre vs post per group; ANCOVA of the DSBT change by group with the pre-test as covariate; ANOVA of the PRS total and items by group.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"streets\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I am 18 or older and agree to take part in this study.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"group\",\n      \"title\": \"Experimental group (assigned at random by the page)\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"no_trees\",\n        \"text\": \"No Trees\"\n       },\n       {\n        \"value\": \"minimal\",\n        \"text\": \"Minimal Awareness (flashed trees)\"\n       },\n       {\n        \"value\": \"moderate\",\n        \"text\": \"Moderate Awareness (trees shown)\"\n       },\n       {\n        \"value\": \"heightened\",\n        \"text\": \"Heightened Awareness (trees shown + instruction)\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"attention\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"dsbt_pre\",\n      \"title\": \"Digit Span Backward score (before viewing)\",\n      \"isRequired\": true,\n      \"min\": 0,\n      \"max\": 10,\n      \"description\": \"Computed by the page: length of the last sequence repeated correctly before the first mistake (lengths 4–10, two trials each; 4 if the first trial is already wrong, the paper's stated minimum).\"\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"dsbt_post\",\n      \"title\": \"Digit Span Backward score (after viewing)\",\n      \"isRequired\": true,\n      \"min\": 0,\n      \"max\": 10,\n      \"description\": \"Computed by the page: length of the last sequence repeated correctly before the first mistake (lengths 4–10, two trials each; 4 if the first trial is already wrong, the paper's stated minimum).\"\n     }\n    ]\n   },\n   {\n    \"name\": \"restorativeness\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_being_away\",\n      \"title\": \"That is a place which is away from everyday demands and where I would be able to relax and think about what interests me.\",\n      \"rateMin\": 0,\n      \"rateMax\": 6,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true,\n      \"description\": \"PRS-5 (Berto 2005) item: being away. 3 = neither agree nor disagree. Sum of the five = PRS total.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_fascination\",\n      \"title\": \"That place is fascinating; it is large enough for me to discover and be curious about things.\",\n      \"rateMin\": 0,\n      \"rateMax\": 6,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true,\n      \"description\": \"PRS-5 (Berto 2005) item: fascination. 3 = neither agree nor disagree. Sum of the five = PRS total.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_coherence\",\n      \"title\": \"That is a place where the activities and the items are ordered and organized.\",\n      \"rateMin\": 0,\n      \"rateMax\": 6,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true,\n      \"description\": \"PRS-5 (Berto 2005) item: coherence. 3 = neither agree nor disagree. Sum of the five = PRS total.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_scope\",\n      \"title\": \"That is a place that is very large, with no restrictions to movements; it is a world of its own.\",\n      \"rateMin\": 0,\n      \"rateMax\": 6,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true,\n      \"description\": \"PRS-5 (Berto 2005) item: scope. 3 = neither agree nor disagree. Sum of the five = PRS total.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_compatibility\",\n      \"title\": \"In that place, it is easy to orient and move around so that I could do what I like.\",\n      \"rateMin\": 0,\n      \"rateMax\": 6,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true,\n      \"description\": \"PRS-5 (Berto 2005) item: compatibility. 3 = neither agree nor disagree. Sum of the five = PRS total.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"plants_seen\",\n      \"title\": \"Which kinds of plants did you see in the street pictures? List as many as you can.\",\n      \"isRequired\": true,\n      \"description\": \"Manipulation check (number of species named). Wording mine; the paper asked participants to identify the plant species they had seen.\"\n     },\n     {\n      \"type\": \"custom\",\n      \"name\": \"task_record\",\n      \"title\": \"Task record\",\n      \"isRequired\": true,\n      \"description\": \"group, street order, every Digit Span Backward trial [length, digits shown, typed answer, correct] before and after viewing, and the measured onset times (ms) of each flash frame for the Minimal Awareness group.\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"trees-original\">{\"source\": \"Lin, Tsai, Sullivan, Chang & Chang (2014) Frontiers in Psychology 5: 906\", \"n\": 138, \"participants\": \"Undergraduates at National Taiwan University (73 women), tested in classrooms right after a class; images projected with PowerPoint\", \"result\": \"DSBT pre to post: No Trees 7.12 to 6.53 (worse); Minimal 6.45 to 7.06; Moderate 6.28 to 6.83; Heightened 6.57 to 8.05 (all p < .05). Adjusted change was largest for Heightened Awareness (F(3,133) = 11.84, p < .001); Minimal and Moderate did not differ and both beat No Trees. PRS total: No Trees 13.59, Minimal 14.90, Moderate 15.31, Heightened 16.81 (F = 2.92, p < .05); coherence and being away differed most.\"}</script>\n<style>\n:root{--bg:#f2f5f2;--card:#fff;--ink:#1e251f;--muted:#5d6a5f;--accent:#2e6b45;--line:#d9e0da;--warn:#b3261e;--sel:#e3f1e8}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn.sec{background:#fff;color:var(--ink);border:1px solid var(--line)}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.full{position:fixed;inset:0;background:#000;display:flex;align-items:center;justify-content:center;z-index:5;flex-direction:column}\n.full img{max-width:96vw;max-height:92vh;width:auto;height:auto;display:block;position:absolute}\n.full img.hide{visibility:hidden}\n.digit{font-size:5rem;font-weight:700;color:#fff;font-variant-numeric:tabular-nums}\n.cross{font-size:3rem;color:#fff}\n.word{font-size:2rem;color:#fff;font-weight:600}\ninput.ans{font:inherit;font-size:1.6rem;letter-spacing:.2em;padding:10px 12px;border:1px solid var(--line);border-radius:10px;width:100%;max-width:340px;text-align:center}\n.row{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}\n.row label{display:flex;flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:8px;padding:6px 0;cursor:pointer;font-size:.85rem}\n.row label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.ends{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-top:3px}\n.it{padding:10px 0;border-top:1px solid var(--line)}.it:first-child{border-top:0}\n.it b{display:block;font-weight:500;margin-bottom:6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\ntextarea{width:100%;font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;min-height:70px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:760px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Street images: Lin, Tsai, Sullivan, Chang &amp; Chang (2014), Frontiers in Psychology 5: 906, Figure 1 (doi:10.3389/fpsyg.2014.00906, CC BY).</footer>\n<script>\n(function(){\n  var KEY='street-trees-awareness:state', MS=window.__VIEWMS||0;\n  var T={digit:MS||1000,cross:MS||1000,view:MS?MS*2:20000,every:MS||5000,flash:30};\n  var app=document.getElementById('app'), Q={}, files={}, ids=[], st=null;\n  var GROUPS=['no_trees','minimal','moderate','heightened'];\n  var PRS=['prs_being_away','prs_fascination','prs_coherence','prs_scope','prs_compatibility'];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function digits(n){var s=[],last=-1;for(var i=0;i<n;i++){var d;do{d=Math.floor(Math.random()*10);}while(d===last);s.push(d);last=d;}return s.join('');}\n\n  function intro(){\n    app.innerHTML='<h1>Streets and attention</h1><p>This study has three short parts: a number memory task, a few minutes looking at street pictures, and a few questions, then the number task once more. It takes about 15–20 minutes. Please do it in one sitting, on a computer or tablet, and do not write anything down.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true),SPSite.answer('group',st.group)],this,function(){st.step='dsbt_pre';save();route();});};\n  }\n\n  // ---- Digit Span Backward: lengths 4..10, two trials each (14); score = length of the last correct trial before the first mistake (paper's rule, 4–10)\n  function dsbt(which,next){\n    var lens=[4,4,5,5,6,6,7,7,8,8,9,9,10,10],k=0,log=[],practice=true;\n    function instr(){\n      app.innerHTML='<h2>Number task'+(which==='post'?' (again)':'')+'</h2><div class=\"card\"><p style=\"color:var(--ink)\">You will see some numbers appear on the screen, each number will appear for 1 s and then another number will appear. Read the numbers carefully. After the numbers have been presented, write them down in reverse order. The task will last for 14 trials. You can stop whenever you can\\'t remember the sequence.</p><p>Type the digits into the box (for example, if you saw 3 8 1 6, type 6183). '+(which==='pre'?'We start with one practice trial.':'')+'</p><button class=\"btn\" id=\"go\">'+(which==='pre'?'Practice trial':'Start')+'</button></div>';\n      practice=which==='pre';\n      document.getElementById('go').onclick=function(){run();};\n    }\n    function run(){\n      var n=practice?3:lens[k],seq=digits(n),i=0,v=document.createElement('div');v.className='full';app.innerHTML='';app.appendChild(v);\n      v.innerHTML='<div class=\"cross\">+</div>';\n      setTimeout(function step(){if(i<n){v.innerHTML='<div class=\"digit\">'+seq[i]+'</div>';i++;setTimeout(step,T.digit);}else{v.innerHTML='<div class=\"word\">answer</div>';setTimeout(function(){answer(seq);},MS?50:600);}},T.cross);\n    }\n    function answer(seq){\n      app.innerHTML='<div class=\"prog\">'+(practice?'Practice':'Trial '+(k+1)+' of 14')+'</div><div class=\"card\"><p style=\"color:var(--ink)\">Type the numbers in <b>reverse order</b>.</p><input class=\"ans\" id=\"ans\" inputmode=\"numeric\" autocomplete=\"off\" maxlength=\"12\"><div style=\"margin-top:16px;display:flex;gap:8px;flex-wrap:wrap\"><button class=\"btn\" id=\"go\">Submit</button>'+(practice?'':'<button class=\"btn sec\" id=\"stop\">I can\\'t remember</button>')+'</div><div class=\"err\"></div></div>';\n      var inp=document.getElementById('ans');inp.focus();\n      function submit(gaveUp){\n        var a=gaveUp?'':inp.value.replace(/\\D/g,''),want=seq.split('').reverse().join(''),correct=!gaveUp&&a===want;\n        if(practice){practice=false;app.innerHTML='<div class=\"card\"><p style=\"color:var(--ink)\">'+(correct?'Correct.':'The answer was '+want+'.')+' Now the real trials begin.</p><button class=\"btn\" id=\"go\">Start</button></div>';document.getElementById('go').onclick=run;return;}\n        log.push([lens[k],seq,a,correct?1:0]);\n        if(!correct||k===lens.length-1)return finish();\n        k++;run();\n      }\n      document.getElementById('go').onclick=function(){if(!inp.value.replace(/\\D/g,''))return err('Type the digits, or press \"I can\\'t remember\".');submit(false);};\n      inp.onkeydown=function(e){if(e.key==='Enter'){e.preventDefault();document.getElementById('go').click();}};\n      var s=document.getElementById('stop');if(s)s.onclick=function(){submit(true);};\n    }\n    function finish(){\n      var score=4;for(var i=0;i<log.length&&log[i][3];i++)score=log[i][0];\n      st.rec['dsbt_'+which]=log;save();\n      send([SPSite.answer('dsbt_'+which,score)],null,next);\n    }\n    instr();\n  }\n\n  // ---- viewing: 5 streets x 20 s; minimal group gets mask / trees / mask flashes (30 ms each) every 5 s\n  function view(){\n    var g=st.group,inst=g==='heightened'?'Please observe the plants closely.':'Please observe them closely.';\n    app.innerHTML='<div class=\"card\"><p style=\"color:var(--ink)\">Now a number of images of streetscapes will be shown. Please relax and imagine being in the settings. You will be asked to answer some questions about the environments after watching these images. '+inst+'</p><button class=\"btn\" id=\"go\">Show the images</button></div>';\n    document.getElementById('go').onclick=function(){\n      var v=document.createElement('div');v.className='full';app.innerHTML='';app.appendChild(v);\n      var k=0,flashLog=[];\n      function show(){\n        if(k>=st.streets.length){st.rec.flashes=flashLog;st.step='prs';save();return route();}\n        var s=st.streets[k],base=g==='no_trees'||g==='minimal'?s+'_notrees':s+'_trees';\n        v.innerHTML='';var a=new Image();a.src=files[base].url;a.alt='Streetscape';v.appendChild(a);\n        var mask,tree;\n        if(g==='minimal'){mask=new Image();mask.src=files[s+'_notrees'].url;mask.style.transform='scaleX(-1)';mask.className='hide';tree=new Image();tree.src=files[s+'_trees'].url;tree.className='hide';v.appendChild(mask);v.appendChild(tree);}\n        var t0=performance.now(),timers=[];\n        if(g==='minimal'){for(var t=T.every;t<T.view;t+=T.every)timers.push(setTimeout(flash,t));}\n        function flash(){ // mask -> trees -> mask, each ~30 ms (about two frames at 60 Hz)\n          var seq=[mask,tree,mask],i=0,marks=[];\n          function nextFrame(){\n            if(i>0)seq[i-1].className='hide';\n            if(i>=seq.length){flashLog.push([s,marks.map(function(x){return Math.round(x);})]);return;}\n            seq[i].className='';var s0=performance.now();marks.push(s0-t0);i++;\n            (function wait(){if(performance.now()-s0>=T.flash-4)nextFrame();else requestAnimationFrame(wait);})();\n          }\n          nextFrame();\n        }\n        setTimeout(function(){timers.forEach(clearTimeout);k++;show();},T.view);\n      }\n      show();\n    };\n  }\n\n  function prs(){\n    var h='';PRS.forEach(function(n){h+='<div class=\"it\"><b>'+esc(Q[n].title)+'</b><div class=\"row\">';for(var i=0;i<=6;i++)h+='<label><input type=\"radio\" name=\"q_'+n+'\" value=\"'+i+'\">'+i+'</label>';h+='</div><div class=\"ends\"><span>0 strongly disagree</span><span>3 neither</span><span>6 strongly agree</span></div></div>';});\n    app.innerHTML='<h2>About the streets you just saw</h2><div class=\"card\"><p style=\"color:var(--ink)\">Think of the streets in the pictures. How much do you agree with each statement?</p>'+h+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var vals=PRS.map(function(n){return val('q_'+n);});if(vals.some(function(x){return x==null;}))return err('Please answer all five statements.');\n      send(PRS.map(function(n,i){return SPSite.answer(n,Number(vals[i]));}),this,function(){st.step='dsbt_post';save();route();});\n    };\n  }\n  function about(){\n    app.innerHTML='<h2>Last questions</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"110\"></div>'+radios('gender')+'<div class=\"f\"><b>'+esc(Q.plants_seen.title)+'</b><textarea id=\"pl\" maxlength=\"400\"></textarea></div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var age=Number(document.getElementById('age').value),g=val('gender'),pl=document.getElementById('pl').value.trim();\n      if(!(age>=18&&age<=110))return err('Please enter your age.');if(!g)return err('Please choose an option.');\n      var rec={group:st.group,street_order:st.streets,dsbt_fields:['length','digits_shown','typed','correct'],dsbt_pre:st.rec.dsbt_pre||[],dsbt_post:st.rec.dsbt_post||[],flash_onsets_ms:st.rec.flashes||[]};\n      send([SPSite.answer('age',age),SPSite.answer('gender',g),SPSite.answer('plants_seen',pl||'(none)'),SPSite.answer('task_record',rec)],this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);\n    if(s==='dsbt_pre')return dsbt('pre',function(){st.step='view';save();route();});\n    if(s==='view')return view();if(s==='prs')return prs();\n    if(s==='dsbt_post')return dsbt('post',function(){st.step='about';save();route();});\n    if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','group','dsbt_pre','dsbt_post','age','gender','plants_seen'].concat(PRS).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('streets')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name)){var k=f.name.replace(/\\.[^.]+$/,'');files[k]=f;ids.push(k);}});\n    var streets=ids.filter(function(x){return /_notrees$/.test(x)&&files[x.replace(/_notrees$/,'_trees')];}).map(function(x){return x.replace(/_notrees$/,'');}).sort();\n    if(streets.length<1){app.innerHTML='<h1>Pictures missing</h1><p>Upload pairs of street pictures named &lt;name&gt;_notrees and &lt;name&gt;_trees to the media folder \"streets\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var valid=st&&st.streets&&st.streets.length===streets.length&&st.streets.every(function(x){return files[x+'_trees'];});\n    if(!valid)st={step:'intro',group:GROUPS[Math.floor(Math.random()*4)],streets:shuffle(streets),rec:{}};\n    if(window.__GROUP)st.group=window.__GROUP;\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true)st.step='intro';\n    if(st.step==='view'&&!st.rec.dsbt_pre)st.step='dsbt_pre';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
