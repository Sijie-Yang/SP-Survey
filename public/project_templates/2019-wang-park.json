   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Park Walkway Choices</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Park Walkway Features: Paired Photo Choices\",\n  \"description\": \"Participants see 28 pairs of park walkway photos from Nanjing; the two photos in each pair are identical except for one digitally added or removed landscape feature (ground cover plants, benches with backs and arms, colourful flowers, available seating, diverse mix of plants, visual access to water, canopy trees; four pairs per feature). They imagine walking in the park and choose the walkway they would prefer to use. Rebuilt from Wang & Rodiek (2019), IJERPH 16(20): 3808, with the 28 photo pairs printed in its Appendix Table A1 (CC BY 4.0). Scoring: per participant and feature, the percentage of the four pairs where the photo with the feature was chosen (0, 25, 50, 75 or 100%); one-sample t-test against 50%, paired t-tests between features.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"walkways\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part in this study.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"pairs\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"walkway_choice\",\n      \"title\": \"Which walkway would you prefer to use?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"hypothesized\",\n        \"text\": \"The photo with the feature\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"The photo without the feature\"\n       }\n      ],\n      \"description\": \"Keyed by pair id <feature><n> (n = 1-4, as in the paper's Appendix Table A1): groundcover (ground cover plants vs bare ground), bench (bench with back and arms vs without), flowers (colourful herbaceous flowers), seating (bench and paved pad present), diverse (diverse mix of plants, barrier-height shrubs added), view (visual access to water, screening shrubs removed), canopy (overhead canopy tree). Each pair is one photo digitally edited; value hypothesized = the photo with the feature was chosen, other = the photo without it.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"What is your gender?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"woman\",\n        \"text\": \"Woman\"\n       },\n       {\n        \"value\": \"man\",\n        \"text\": \"Man\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"walkway-original\">{\"source\": \"Wang & Rodiek (2019) International Journal of Environmental Research and Public Health 16(20): 3808\", \"n\": 283, \"participants\": \"local residents aged 60+ (mean 70.9) in six Nanjing urban parks, printed side-by-side photo booklets, spring 2018\", \"pct_choosing_feature_by_feature\": {\"groundcover\": 90.37, \"bench\": 89.66, \"flowers\": 88.25, \"seating\": 81.89, \"diverse\": 71.82, \"view\": 68.99, \"canopy\": 67.4}, \"pct_choosing_feature_by_pair\": {\"groundcover1\": 86.93, \"groundcover2\": 93.99, \"groundcover3\": 92.58, \"groundcover4\": 87.99, \"bench1\": 89.75, \"bench2\": 90.11, \"bench3\": 88.69, \"bench4\": 90.11, \"flowers1\": 91.17, \"flowers2\": 89.75, \"flowers3\": 83.04, \"flowers4\": 89.05, \"seating1\": 87.99, \"seating2\": 74.2, \"seating3\": 78.09, \"seating4\": 87.28, \"diverse1\": 53.36, \"diverse2\": 83.04, \"diverse3\": 65.02, \"diverse4\": 85.87, \"view1\": 68.2, \"view2\": 60.07, \"view3\": 92.23, \"view4\": 55.48, \"canopy1\": 65.02, \"canopy2\": 69.26, \"canopy3\": 66.78, \"canopy4\": 68.55}, \"result\": \"All seven features were preferred above chance (p < 0.001); not significant for pairs diverse1 and view4.\"}</script>\n<style>\n:root{--bg:#f3f5ef;--card:#fff;--ink:#1f241b;--muted:#5d6656;--accent:#3f6b2a;--line:#dbe0d4;--warn:#b3261e;--sel:#e6f0df}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:18px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.55rem;margin:0 0 8px}h2{font-size:1.2rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:14px 22px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.9rem;color:var(--muted);margin-bottom:8px}\n.pair{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n.pick{appearance:none;border:0;padding:0;background:#111;border-radius:8px;cursor:pointer;outline:4px solid transparent;outline-offset:2px;padding:10px}\n.pick img{width:100%;display:block}\n.pick:hover,.pick:focus-visible{outline-color:var(--accent)}\n.pick:disabled{cursor:default;opacity:.7}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:10px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n@media (max-width:560px){.pair{grid-template-columns:1fr}.pick{padding:6px}}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Wang &amp; Rodiek (2019), International Journal of Environmental Research and Public Health 16(20): 3808, Appendix Table A1 (doi:10.3390/ijerph16203808, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='park-walkways:state';\n  var FEATURES=['groundcover','bench','flowers','seating','diverse','view','canopy'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function intro(){\n    app.innerHTML='<h1>Park walkways</h1><p>You will see '+st.pairs.length+' pairs of photos of walkways in city parks in Nanjing. The two photos in each pair are the same except for one thing. Imagine you are going for a walk in the park, and tap the walkway you would prefer to use. It takes about 5 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='pair';st.k=0;save();route();});};\n  }\n  function pair(){\n    var p=st.pairs[st.k],L=p.left==='feature'?[p.id+'_feature',p.id+'_base']:[p.id+'_base',p.id+'_feature'];\n    app.innerHTML='<div class=\"prog\">Pair '+(st.k+1)+' of '+st.pairs.length+'</div><div class=\"card\"><p style=\"color:var(--ink)\"><b>'+esc(Q.walkway_choice.title)+'</b></p><div class=\"pair\">'+L.map(function(n,i){return '<button type=\"button\" class=\"pick\" data-n=\"'+n+'\" aria-label=\"'+(i?'Right':'Left')+' walkway\"><img alt=\"Park walkway\" src=\"'+esc(files[n].url)+'\"></button>';}).join('')+'</div><div class=\"err\"></div></div>';\n    var sh=L.map(function(n){return files[n].name;});\n    app.querySelectorAll('.pick').forEach(function(b){b.onclick=function(){\n      var n=b.dataset.n,v=/_feature$/.test(n)?'hypothesized':'other';\n      app.querySelectorAll('.pick').forEach(function(x){x.disabled=true;});\n      send([SPSite.answer('walkway_choice',v,{key:p.id,shown:sh})],null,function(){st.k++;if(st.k>=st.pairs.length)st.step='about';save();route();});\n    };});\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"110\"></div><div class=\"f\"><b>'+esc(Q.gender.title)+'</b>'+Q.gender.choices.map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"gender\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var age=Number(document.getElementById('age').value),g=val('gender');\n      if(!(age>=18&&age<=110))return err('Please enter your age.');if(!g)return err('Please choose an option.');\n      send([SPSite.answer('age',age),SPSite.answer('gender',g)],this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='pair')return pair();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','walkway_choice','age','gender'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('walkways')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name))files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var ids=[];FEATURES.forEach(function(f){for(var i=1;i<=4;i++){var id=f+i;if(files[id+'_base']&&files[id+'_feature'])ids.push(id);}});\n    if(ids.length<2){app.innerHTML='<h1>Photos missing</h1><p>Upload the photo pairs to the media folder \"walkways\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var valid=st&&st.pairs&&st.pairs.length===ids.length&&st.pairs.every(function(p){return ids.indexOf(p.id)>=0;});\n    if(!valid){var sides=shuffle(ids.map(function(_,i){return i%2===0?'feature':'base';}));st={step:'intro',pairs:shuffle(ids).map(function(id,i){return {id:id,left:sides[i]};}),k:0};}\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
