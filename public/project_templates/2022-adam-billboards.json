   "id": "site-66381d7056ebf046",
   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>How Pleasant Is This Shopping Street? (Kuala Lumpur)</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"How Pleasant Is This Shopping Street? (Kuala Lumpur)\",\n    \"description\": \"Rate street views of Jalan Tuanku Abdul Rahman, a busy shopping street in Kuala Lumpur with many outdoor advertisement billboards, from 1 (highly pleasant) to 5 (highly unpleasant). Method replication of Adam et al. (2022), ISPRS International Journal of Geo-Information.\",\n    \"locale\": \"en\",\n    \"mediaFolders\": [\"kualalumpur\"],\n    \"pages\": [\n      { \"name\": \"intro\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. My answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" }\n      ]},\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"isRequired\": true, \"choices\": [{ \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"male\", \"text\": \"Male\" }, { \"value\": \"other\", \"text\": \"Other / prefer not to say\" }] },\n        { \"type\": \"radiogroup\", \"name\": \"age_group\", \"title\": \"Age\", \"isRequired\": true, \"choices\": [{ \"value\": \"lt20\", \"text\": \"Under 20\" }, { \"value\": \"20-25\", \"text\": \"20–25\" }, { \"value\": \"26-34\", \"text\": \"26–34\" }, { \"value\": \"ge35\", \"text\": \"35 or older\" }] },\n        { \"type\": \"radiogroup\", \"name\": \"living_environment\", \"title\": \"Where did you grow up?\", \"isRequired\": true, \"choices\": [{ \"value\": \"urban\", \"text\": \"Urban area\" }, { \"value\": \"suburban_rural\", \"text\": \"Suburban or rural area\" }] },\n        { \"type\": \"radiogroup\", \"name\": \"education\", \"title\": \"Highest education completed\", \"isRequired\": true, \"choices\": [{ \"value\": \"school\", \"text\": \"Secondary school or pre-university\" }, { \"value\": \"diploma\", \"text\": \"Diploma\" }, { \"value\": \"bachelor\", \"text\": \"Bachelor's degree\" }, { \"value\": \"postgraduate\", \"text\": \"Postgraduate degree\" }] },\n        { \"type\": \"radiogroup\", \"name\": \"city_centre_visits\", \"title\": \"How often do you go to the city centre of Kuala Lumpur?\", \"isRequired\": true, \"choices\": [{ \"value\": \"weekly\", \"text\": \"Every week\" }, { \"value\": \"monthly\", \"text\": \"Every month\" }, { \"value\": \"few_per_year\", \"text\": \"A few times a year\" }, { \"value\": \"rarely\", \"text\": \"Rarely or never\" }] },\n        { \"type\": \"radiogroup\", \"name\": \"design_background\", \"title\": \"Do you study or work in architecture, landscape architecture, planning or design?\", \"isRequired\": true, \"choices\": [{ \"value\": \"yes\", \"text\": \"Yes\" }, { \"value\": \"no\", \"text\": \"No\" }] }\n      ]},\n      { \"name\": \"pictures\", \"elements\": [\n        { \"type\": \"custom\", \"name\": \"picture_order\", \"title\": \"The street views shown to this participant, in the order shown\", \"isRequired\": true },\n        { \"type\": \"rating\", \"name\": \"pleasantness\", \"title\": \"How do you find this street scene?\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 5, \"rateValues\": [{ \"value\": 1, \"text\": \"Highly pleasant\" }, { \"value\": 2, \"text\": \"Pleasant\" }, { \"value\": 3, \"text\": \"Moderately unpleasant\" }, { \"value\": 4, \"text\": \"Unpleasant\" }, { \"value\": 5, \"text\": \"Highly unpleasant\" }], \"minRateDescription\": \"Highly pleasant\", \"maxRateDescription\": \"Highly unpleasant\" }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f5f4f1;--card:#fff;--ink:#1f2023;--muted:#5d6166;--accent:#8a3b2e;--accent-ink:#fff;--line:#dedbd5;--sel:#f6e6e2}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.4rem;margin:0 0 8px}p{margin:0 0 10px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:14px}\n.pic{border-radius:12px;overflow:hidden;background:#222}\n.pic img{display:block;width:100%;aspect-ratio:3/2;object-fit:contain;max-height:62vh;margin:0 auto}\n.meta{display:flex;justify-content:space-between;font-size:.88rem;color:var(--muted);margin-top:8px}\n.bar{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin-top:6px}.bar>i{display:block;height:100%;background:var(--accent)}\n.scale{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:12px}\n.scale button{appearance:none;border:1px solid var(--line);background:var(--card);border-radius:10px;padding:10px 4px;font:inherit;cursor:pointer;color:var(--ink);display:flex;flex-direction:column;align-items:center;gap:2px}\n.scale button b{font-size:1.1rem}.scale button span{font-size:.8rem;line-height:1.2;color:var(--muted);text-align:center}\n.scale button.on{border-color:var(--accent);background:var(--sel);box-shadow:0 0 0 2px var(--accent) inset}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:14px}.q>b{display:block;margin-bottom:4px}\n.err{color:#b3261e;margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n@media (max-width:560px){h1{font-size:1.2rem}.scale{gap:4px}.scale button{padding:8px 2px}.scale button span{font-size:.68rem}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Street views: Jalan Tuanku Abdul Rahman, Kuala Lumpur, Google Street View (© Google). Task and scale from Adam, Al-Sharaa, Ab Ghafar, Mundher, Abu Bakar &amp; Alhasan, “The effects of colour content and cumulative area of outdoor advertisement billboards on the visual quality of urban streets”, ISPRS International Journal of Geo-Information 11(12), 630, doi:10.3390/ijgi11120630.</footer>\n<script>\n(function(){\n  var DEMO=['gender','age_group','living_environment','education','city_centre_visits','design_background'];\n  var app=document.getElementById('app'),plan=null,byName={},score={},ans={},idx=0,scaleQ=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function chk(r){if(r&&r.ok===false)throw new Error(r.error||'Not saved');return r;}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function firstOpen(){for(var i=0;i<plan.length;i++)if(score[plan[i]]==null)return i;return plan.length;}\n  function intro(){\n    var c=SPSite.getQuestion('consent');\n    app.innerHTML='<h1>How pleasant is this street?</h1><p>You will see '+plan.length+' photos of Jalan Tuanku Abdul Rahman, a busy shopping street in Kuala Lumpur. For each photo, say how pleasant or unpleasant you find the street scene, from 1 (highly pleasant) to 5 (highly unpleasant). First, six short questions about you. It takes about 8 minutes.</p>'+\n      '<div class=\"card\"><p>'+esc(c.title)+'</p><div class=\"row\"><button class=\"btn\" id=\"yes\">'+esc(c.labelTrue||'I agree')+'</button></div><div class=\"err\"></div></div>';\n    document.getElementById('yes').onclick=function(){SPSite.answer('consent',true).then(chk).then(about).catch(function(e){err(e.message);});};\n  }\n  function about(){\n    app.innerHTML='<h1>About you</h1><div class=\"card\">'+DEMO.map(function(n){var q=SPSite.getQuestion(n);\n      return '<div class=\"q\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"'+(ans[n]===c.value?' checked':'')+'> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+\n      '<div class=\"row\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    DEMO.forEach(function(n){app.querySelectorAll('input[name=\"'+n+'\"]').forEach(function(r){r.onchange=function(){err('');SPSite.answer(n,r.value).then(chk).then(function(){ans[n]=r.value;}).catch(function(e){err(e.message);});};});});\n    document.getElementById('go').onclick=function(){\n      if(DEMO.some(function(n){return !app.querySelector('input[name=\"'+n+'\"]:checked');}))return err('Please answer each question.');\n      idx=firstOpen();idx<plan.length?rate():finish();};\n    window.scrollTo(0,0);\n  }\n  function rate(){\n    var v=plan[idx],m=byName[v],vals=scaleQ.rateValues;\n    var h='<div class=\"pic\"><img src=\"'+esc(m.url)+'\" alt=\"Street photo '+(idx+1)+'\"></div><div class=\"meta\"><span>Photo '+(idx+1)+' of '+plan.length+'</span></div><div class=\"bar\"><i style=\"width:'+(100*idx/plan.length)+'%\"></i></div>'+\n      '<div class=\"card\"><b>'+esc(scaleQ.title)+'</b><div class=\"scale\">'+vals.map(function(x){return '<button type=\"button\" data-v=\"'+x.value+'\"'+(score[v]===Number(x.value)?' class=\"on\"':'')+'><b>'+x.value+'</b><span>'+esc(x.text)+'</span></button>';}).join('')+'</div>'+\n      '<div class=\"row\">'+(idx>0?'<button class=\"btn ghost\" id=\"back\">Previous photo</button>':'')+'<button class=\"btn\" id=\"go\">'+(idx+1<plan.length?'Next photo':'Finish')+'</button></div><div class=\"err\"></div></div>';\n    app.innerHTML=h;\n    app.querySelectorAll('.scale button').forEach(function(b){b.onclick=function(){var k=Number(b.getAttribute('data-v'));\n      app.querySelectorAll('.scale button').forEach(function(x){x.classList.toggle('on',x===b);});err('');\n      SPSite.answer('pleasantness',k,{key:v,shown:[v]}).then(chk).then(function(){score[v]=k;}).catch(function(e){err(e.message);});};});\n    var bk=document.getElementById('back');if(bk)bk.onclick=function(){idx--;rate();};\n    document.getElementById('go').onclick=function(){\n      if(!app.querySelector('.scale button.on'))return err('Please choose an answer.');\n      idx++;if(idx<plan.length)rate();else{var o=firstOpen();if(o<plan.length){idx=o;rate();}else finish();}};\n    window.scrollTo(0,0);\n  }\n  function finish(){\n    app.innerHTML='<h1>Submitting…</h1><div class=\"card\"><p>Thank you. Your answers are being saved.</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(r&&r.ok===false){var m=r.missing||[];\n      if(m.indexOf('consent')>=0)return intro();\n      if(DEMO.some(function(n){return m.indexOf(n)>=0;}))return about();\n      idx=firstOpen();if(idx>=plan.length)idx=0;rate();err(r.error||('Please answer: '+m.join(', ')));}\n      else app.innerHTML='<h1>Thank you</h1><div class=\"card\"><p>Your answers have been saved.</p></div>';});\n  }\n  SPSite.onReady(function(ctx){\n    scaleQ=SPSite.getQuestion('pleasantness');\n    if(!scaleQ.rateValues||!scaleQ.rateValues.length)scaleQ.rateValues=[1,2,3,4,5].map(function(v){return {value:v,text:''};});\n    var media=(SPSite.getMedia('kualalumpur')||[]).filter(function(m){return m.type!=='video';});\n    if(!media.length){app.innerHTML='<h1>No photos yet</h1><p>The researcher has not added street photos to the folder “kualalumpur”.</p>';return;}\n    media.forEach(function(m){byName[m.name]=m;});\n    var a=(ctx&&ctx.answers)||{};\n    var p=a.picture_order;\n    if(Array.isArray(p)&&p.length&&p.every(function(n){return byName[n];}))plan=p;\n    else{plan=shuffle(media.map(function(m){return m.name;}));SPSite.answer('picture_order',plan).catch(function(){});}\n    var t=a.pleasantness&&Array.isArray(a.pleasantness.trials)?a.pleasantness.trials:[];\n    t.forEach(function(x){if(x&&x.key&&x.value!=null)score[x.key]=Number(x.value);});\n    DEMO.forEach(function(n){if(a[n]!=null)ans[n]=String(a[n]);});\n    if(a.consent!==true)intro();\n    else if(DEMO.some(function(n){return ans[n]==null;}))about();\n    else{idx=firstOpen();idx<plan.length?rate():finish();}\n  });\n})();\n</script>\n</body>\n</html>\n",
