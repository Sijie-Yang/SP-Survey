   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Park Blue Space Survey</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Urban Park Blue Space: Preference and Restoration\",\n  \"description\": \"Faithful replication of Luo, Xie & Furuya (2021), Land 10:1233: rate ten photographs of blue spaces (creeks, channels, ponds) in Huanhuaxi Park, Chengdu, on the short Perceived Restorativeness Scale, beauty and naturalness (1–7).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"blue\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"intro\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part and know I can stop at any time.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"images\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"blue_space_ratings\",\n      \"title\": \"Imagine you are in this place. How much do you agree with each statement?\",\n      \"isRequired\": true,\n      \"description\": \"One trial per image (key image_01 … image_10, numbered as in the paper's Table 1), shown one at a time in random order. Value: { fascination, compatibility, being_away, scope, coherence, beautiful, natural }, each 1 = totally disagree … 7 = totally agree. Restorative potential = mean of the first five (short PRS); aesthetic preference = beautiful; perceived naturalness = natural.\",\n      \"items\": [\n       {\n        \"id\": \"fascination\",\n        \"text\": \"That place is fascinating.\"\n       },\n       {\n        \"id\": \"compatibility\",\n        \"text\": \"I can enjoy myself in this setting and do anything I like.\"\n       },\n       {\n        \"id\": \"being_away\",\n        \"text\": \"This is a place away from daily routine and stress.\"\n       },\n       {\n        \"id\": \"scope\",\n        \"text\": \"There are few hard boundaries here to limit me.\"\n       },\n       {\n        \"id\": \"coherence\",\n        \"text\": \"Everything here seems to have a proper place.\"\n       },\n       {\n        \"id\": \"beautiful\",\n        \"text\": \"The landscape is beautiful.\"\n       },\n       {\n        \"id\": \"natural\",\n        \"text\": \"This place is natural.\"\n       }\n      ],\n      \"trials\": [\n       {\n        \"id\": \"image_01\"\n       },\n       {\n        \"id\": \"image_02\"\n       },\n       {\n        \"id\": \"image_03\"\n       },\n       {\n        \"id\": \"image_04\"\n       },\n       {\n        \"id\": \"image_05\"\n       },\n       {\n        \"id\": \"image_06\"\n       },\n       {\n        \"id\": \"image_07\"\n       },\n       {\n        \"id\": \"image_08\"\n       },\n       {\n        \"id\": \"image_09\"\n       },\n       {\n        \"id\": \"image_10\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"name\": \"age\",\n      \"inputType\": \"number\",\n      \"title\": \"Age (years)\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Female\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Education\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Undergraduate\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Postgraduate\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"major\",\n      \"title\": \"Major\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Landscape architecture\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Other\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"childhood_environment\",\n      \"title\": \"Where did you live during your childhood?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Rural area\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Urban area\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#edf3f1;--card:#fff;--ink:#16231f;--muted:#53645e;--accent:#2a6b5c;--accent-ink:#fff;--line:#d2ddd9;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:16px}.q>b{display:block;margin-bottom:6px;font-weight:600}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\ninput[type=text]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:100%;max-width:200px;background:#fff;color:var(--ink)}\n.pic{background:#dfe6e3;border-radius:12px;overflow:hidden;display:flex;align-items:center;justify-content:center}\n.pic img{width:100%;max-height:min(50vh,460px);object-fit:contain;display:block}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem;font-variant-numeric:tabular-nums}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.seg{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}\n.seg label{display:block;cursor:pointer}\n.seg input{position:absolute;opacity:0;pointer-events:none}\n.seg span{display:flex;align-items:center;justify-content:center;height:38px;border:1px solid var(--line);border-radius:8px;font-weight:600;font-variant-numeric:tabular-nums}\n.seg input:checked+span{background:var(--accent);border-color:var(--accent);color:#fff}\n.seg input:focus-visible+span{outline:2px solid var(--accent);outline-offset:2px}\n.anch{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);margin-top:2px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Luo, Xie &amp; Furuya (2021), Land 10:1233, doi:10.3390/land10111233, Table 1 (CC BY 4.0). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='parkblue2021:', IDS=[];for(var i=1;i<=10;i++)IDS.push('image_'+(i<10?'0':'')+i);\n  var app=document.getElementById('app'), Q={}, files={}, ans={}, done={}, order=[], SPEC=null, ITEMS=[];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function q(n){return Q[n]||{};}\n  function saveAll(l,b,cb){Promise.all(l.map(function(a){return SPSite.answer(a[0],a[1]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}cb();});}\n  function page(html,btn,cb){\n    app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn||'Continue')+'</button></div><div class=\"err\"></div>';\n    document.getElementById('go').onclick=cb;app.onchange=hideErr;\n  }\n  function next(){\n    window.scrollTo(0,0);\n    if(!ans.intro)return intro();\n    for(var i=0;i<order.length;i++){if(!done[order[i]])return image(i);}\n    if(!ans.about)return about();\n    finish();\n  }\n  function intro(){\n    if(IDS.some(function(k){return !files[k+'.jpg'];})){app.innerHTML='<h1>Pictures missing</h1><p>Media folder blue must hold image_01.jpg … image_10.jpg.</p>';return;}\n    page('<h1>Water spaces in an urban park</h1><p>You will see ten photographs of creeks, channels and ponds in an urban park, one at a time. For each, imagine that you are in the scene and say how much you agree with seven statements, from 1 (totally disagree) to 7 (totally agree). Take your time with each picture; about a minute each is enough. You can change an answer before moving on. Your answers are anonymous.</p>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var b=this;b.disabled=true;saveAll([['consent',true]],b,function(){ans.intro=true;save('a',ans);next();});\n    });\n  }\n  function image(i){\n    var k=order[i], f=files[k+'.jpg'], n=0;order.forEach(function(x){if(done[x])n++;});\n    var rows=ITEMS.map(function(it){return '<div class=\"q\"><b>'+esc(it.text)+'</b><div class=\"seg\" role=\"radiogroup\" aria-label=\"'+esc(it.text)+'\">'+[1,2,3,4,5,6,7].map(function(v){return '<label><input type=\"radio\" name=\"'+it.id+'\" value=\"'+v+'\"><span>'+v+'</span></label>';}).join('')+'</div><div class=\"anch\"><span>Totally disagree</span><span>Totally agree</span></div></div>';}).join('');\n    page('<div class=\"top\"><span class=\"t\">Picture '+(n+1)+' of 10</span><div class=\"bar\"><i style=\"width:'+(n*10)+'%\"></i></div></div>'+\n      '<div class=\"card\"><div class=\"pic\"><img alt=\"Blue space in an urban park\" src=\"'+esc(f.url)+'\"></div><p style=\"margin-top:12px;color:var(--ink);font-weight:600\">'+esc(q('blue_space_ratings').title)+'</p>'+rows+'</div>',n===9?'Continue':'Next picture',function(){\n      var v={};for(var j=0;j<ITEMS.length;j++){var x=app.querySelector('input[name=\"'+ITEMS[j].id+'\"]:checked');if(!x)return err('Please answer every statement.');v[ITEMS[j].id]=Number(x.value);}\n      var b=this;b.disabled=true;\n      SPSite.answer('blue_space_ratings',v,{key:k,shown:[f.name]}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}done[k]=true;next();});\n    });\n  }\n  function about(){\n    var ns=['age','gender','education','major','childhood_environment'];\n    var h=ns.map(function(n){var d=q(n);if(d.type!=='radiogroup')return '<div class=\"q\"><b>'+esc(d.title)+'</b><input type=\"text\" inputmode=\"numeric\" name=\"'+n+'\"></div>';\n      return '<div class=\"q\"><b>'+esc(d.title)+'</b>'+(d.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('');\n    page('<h1>About you</h1><div class=\"card\">'+h+'</div>','Finish',function(){\n      var a=Number(app.querySelector('input[name=age]').value.trim());if(!a||a<10||a>110)return err('Please enter your age in years.');\n      var l=[['age',a]];for(var i=1;i<ns.length;i++){var x=app.querySelector('input[name=\"'+ns[i]+'\"]:checked');if(!x)return err('Please answer: '+q(ns[i]).title);l.push([ns[i],Number(x.value)]);}\n      var b=this;b.disabled=true;saveAll(l,b,function(){ans.about=true;save('a',ans);next();});\n    });\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>All ten photographs were taken in Huanhuaxi Park in Chengdu, China. In the original study with 93 students, the large pond surrounded by bamboo and traditional buildings was liked most and rated the most restorative, while the narrow channel beside a nature trail was liked least. Water that looked clean and natural, and rich planting, went with higher scores.</p><p style=\"font-size:.82rem\">Photographs and questions: Luo, S., Xie, J., &amp; Furuya, K. (2021). Assessing the preference and restorative potential of urban park blue space. Land 10:1233, doi:10.3390/land10111233.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')ans.intro=false;else if(x==='blue_space_ratings')done={};else ans.about=false;});save('a',ans);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={type:e.type,title:g.title||e.title,isRequired:e.isRequired,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='blue_space_ratings')ITEMS=e.items;});});\n    (SPSite.getMedia('blue')||[]).forEach(function(f){files[f.name]=f;});\n    var o=load('order');if(!o||o.length!==10)o=shuffle(IDS);order=o;save('order',order);\n    var a=(ctx&&ctx.answers)||{};ans=load('a')||{};\n    ((a.blue_space_ratings&&a.blue_space_ratings.trials)||[]).forEach(function(t){if(t.key)done[t.key]=true;});\n    ans.intro=a.consent===true;ans.about=a.childhood_environment!=null;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
