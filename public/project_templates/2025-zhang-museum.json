   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Museum Facades and Emotion</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Museum Facades and Emotional Experience (Beijing Olympic Park)\",\n  \"description\": \"Faithful replication of Zhang et al. (2025), Buildings 15:57: look at three photographs of museum facades in the Beijing Olympic Park Museum Group, then rate your emotions on the 12-item PAD scale (−4 to +4) and your emotional experience of 11 environmental characteristics (1–7).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"museums\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"intro\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part voluntarily and know I can stop at any time.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Female\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"major\",\n      \"title\": \"What is your major?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Environmental design related (urban planning, landscape architecture, architecture)\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Other (e.g. economics, chemistry, mathematics, forestry)\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"viewing\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"viewing\",\n      \"title\": \"Look carefully at each museum facade\",\n      \"isRequired\": false,\n      \"description\": \"Three processed photographs of museum facades in the Beijing Olympic Park Museum Group, shown one at a time in random order (as in the paper). The participant moves on only after carefully observing the exterior of each museum. Value per trial: {view_ms, order}. The paper recorded eye movements here (Tobii Pro Fusion); this template records viewing time only.\",\n      \"trials\": [\n       {\n        \"id\": \"sample1_party_history\",\n        \"label\": \"Sample 1: Museum of the Communist Party of China\",\n        \"image\": \"sample1_party_history.jpg\"\n       },\n       {\n        \"id\": \"sample2_traditional_culture\",\n        \"label\": \"Sample 2: Chinese Traditional Culture Museum\",\n        \"image\": \"sample2_traditional_culture.jpg\"\n       },\n       {\n        \"id\": \"sample3_science_technology\",\n        \"label\": \"Sample 3: China Science and Technology Museum\",\n        \"image\": \"sample3_science_technology.jpg\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"pad\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"pad\",\n      \"title\": \"PAD emotion scale (feelings from the three pictures)\",\n      \"isRequired\": false,\n      \"description\": \"Simplified Chinese PAD scale (Institute of Psychology, Chinese Academy of Sciences) as printed in Table 3 of the paper: 12 adjective pairs, 4 each for pleasure (P1–P4), arousal (A1–A4) and dominance (D1–D4), 9-point semantic differential scored −4 (left adjective) to +4 (right adjective). Answered once, for the feelings from the three pictures just seen. Value: {P1..P4, A1..A4, D1..D4}. Analysis as in the paper: mean P, A, D (average of the 4 items each); Euclidean distance to the 14 basic emotion PAD coordinates (Table 4); t-tests by gender and major.\",\n      \"items\": [\n       {\n        \"key\": \"P1\",\n        \"lo\": \"Angry\",\n        \"hi\": \"Interested\"\n       },\n       {\n        \"key\": \"P2\",\n        \"lo\": \"Pejorative\",\n        \"hi\": \"Friendly\"\n       },\n       {\n        \"key\": \"P3\",\n        \"lo\": \"Painful\",\n        \"hi\": \"Delighted\"\n       },\n       {\n        \"key\": \"P4\",\n        \"lo\": \"Infuriated\",\n        \"hi\": \"Excited\"\n       },\n       {\n        \"key\": \"A1\",\n        \"lo\": \"Sleepy\",\n        \"hi\": \"Sober\"\n       },\n       {\n        \"key\": \"A2\",\n        \"lo\": \"Calm\",\n        \"hi\": \"Excited\"\n       },\n       {\n        \"key\": \"A3\",\n        \"lo\": \"Relaxing\",\n        \"hi\": \"Interested\"\n       },\n       {\n        \"key\": \"A4\",\n        \"lo\": \"Restrained\",\n        \"hi\": \"Surprised\"\n       },\n       {\n        \"key\": \"D1\",\n        \"lo\": \"Controlled\",\n        \"hi\": \"Mastered\"\n       },\n       {\n        \"key\": \"D2\",\n        \"lo\": \"Compliant\",\n        \"hi\": \"Dominative\"\n       },\n       {\n        \"key\": \"D3\",\n        \"lo\": \"Humility\",\n        \"hi\": \"Proud\"\n       },\n       {\n        \"key\": \"D4\",\n        \"lo\": \"Affected\",\n        \"hi\": \"Influential\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"attachment\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"attachment\",\n      \"title\": \"Emotional attachment scale of specific environmental characteristics\",\n      \"isRequired\": false,\n      \"description\": \"Table 6 of the paper: 11 characteristics of the museums and their surroundings (material, color, natural elements, form and structure, privacy, diversity, sociability, territoriality, playability, uniqueness, changeability), each rated 1 (no emotional experience of this characteristic) to 7 (very strong emotional experience). Answered once. Value: {material, color, ...}. Analysis as in the paper: mean per characteristic (> 3.5 = obvious emotional experience) and correlations with the PAD values.\",\n      \"items\": [\n       {\n        \"key\": \"material\",\n        \"text\": \"Material\"\n       },\n       {\n        \"key\": \"color\",\n        \"text\": \"Color\"\n       },\n       {\n        \"key\": \"natural_elements\",\n        \"text\": \"Natural elements\"\n       },\n       {\n        \"key\": \"form_and_structure\",\n        \"text\": \"Form and structure\"\n       },\n       {\n        \"key\": \"privacy\",\n        \"text\": \"Privacy\"\n       },\n       {\n        \"key\": \"diversity\",\n        \"text\": \"Diversity\"\n       },\n       {\n        \"key\": \"sociability\",\n        \"text\": \"Sociability\"\n       },\n       {\n        \"key\": \"territoriality\",\n        \"text\": \"Territoriality\"\n       },\n       {\n        \"key\": \"playability\",\n        \"text\": \"Playability\"\n       },\n       {\n        \"key\": \"uniqueness\",\n        \"text\": \"Uniqueness\"\n       },\n       {\n        \"key\": \"changeability\",\n        \"text\": \"Changeability\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#eef0f3;--card:#fff;--ink:#1f2328;--muted:#5d6570;--accent:#2f5d8a;--accent-ink:#fff;--line:#d8dde3;--warn:#b3261e;--miss:#fdecea}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q>b{display:block;margin-bottom:4px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.pic{background:#e2e6ea;border-radius:12px;overflow:hidden}.pic img{width:100%;max-height:min(62vh,560px);object-fit:contain;display:block}\n.it{padding:10px 6px;border-top:1px solid var(--line);border-radius:8px}\n.it.miss{background:var(--miss)}\n.sd{display:grid;grid-template-columns:minmax(70px,1fr) auto minmax(70px,1fr);gap:8px;align-items:center}\n.sd .l{text-align:right;font-weight:500}.sd .r{font-weight:500}\n.sc{display:grid;gap:2px}\n.sc label{display:flex;flex-direction:column;align-items:center;font-size:.72rem;color:var(--muted);cursor:pointer}\n.sc input{width:18px;height:18px;margin:0 0 2px}\n.sc9{grid-template-columns:repeat(9,minmax(22px,1fr))}.sc7{grid-template-columns:repeat(7,1fr)}\n.x{font-weight:500;margin-bottom:6px}\n.ends{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);margin-top:2px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:520px){.sd{grid-template-columns:1fr 1fr}.sd .sc{grid-column:1/3;grid-row:2}.sd .l{text-align:left}.sd .r{text-align:right}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Zhang, Chai, Zhou, Sun, Zhang &amp; Chen (2025), Buildings 15:57, Figure 4, doi:10.3390/buildings15010057 (CC BY 4.0; facades processed by the authors in Adobe Photoshop 2019). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='museumpad2025:';\n  var app=document.getElementById('app'), Q={}, files={}, ans={}, TR=[], PAD=[], ATT=[], done={}, order=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function q(n){return Q[n]||{};}\n  function page(html,btn,cb){app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn)+'</button></div><div class=\"err\"></div>';document.getElementById('go').onclick=cb;app.onchange=function(e){hideErr();var r=e.target.closest&&e.target.closest('.it');if(r)r.classList.remove('miss');};}\n  function send(list,b,fin){b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}fin();});}\n  function shuffle(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function collect(items){var v={},miss=[];items.forEach(function(it){var x=app.querySelector('input[name=\"'+it.key+'\"]:checked');var r=app.querySelector('.it[data-k=\"'+it.key+'\"]');if(x){v[it.key]=Number(x.value);r.classList.remove('miss');}else{miss.push(r);r.classList.add('miss');}});\n    if(miss.length){err(miss.length+' item'+(miss.length>1?'s are':' is')+' not answered yet (marked in red).');miss[0].scrollIntoView({block:'center'});return null;}return v;}\n  function next(){\n    window.scrollTo(0,0);\n    if(!ans.intro)return intro();\n    if(!ans.about)return about();\n    for(var i=0;i<order.length;i++){var t=TR.filter(function(x){return x.id===order[i];})[0];if(t&&!done[t.id])return view(t,i);}\n    if(!ans.pad)return pad();\n    if(!ans.att)return att();\n    finish();\n  }\n  function intro(){\n    var miss=TR.some(function(t){return !files[t.image];});\n    if(miss){app.innerHTML='<h1>Pictures missing</h1><p>Media folder museums must hold the three facade photographs (sample1_party_history.jpg, sample2_traditional_culture.jpg, sample3_science_technology.jpg).</p>';return;}\n    page('<h1>Museum facades and emotions</h1><p>You will see photographs of three museums in the Beijing Olympic Park. Look at each one carefully and move on when you feel you have understood its exterior. Afterwards you will describe how the pictures made you feel.</p><p>It takes about 5 minutes. Your answers are anonymous and used only for research.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      send([SPSite.answer('consent',true)],this,function(){ans.intro=true;save('a',ans);next();});});\n  }\n  function radios(name,d){return '<div class=\"q\"><b>'+esc(d.title)+'</b>'+(d.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+name+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function about(){\n    page('<h1>About you</h1><div class=\"card\">'+radios('gender',q('gender'))+radios('major',q('major'))+'</div>','Continue',function(){\n      var g=app.querySelector('input[name=gender]:checked'),m=app.querySelector('input[name=major]:checked');if(!g||!m)return err('Please answer both questions.');\n      send([SPSite.answer('gender',Number(g.value)),SPSite.answer('major',Number(m.value))],this,function(){ans.about=true;save('a',ans);next();});});\n  }\n  function view(t,i){\n    var f=files[t.image],t0=Date.now();\n    page('<div class=\"top\"><span class=\"t\">Picture '+(i+1)+' of '+order.length+'</span><div class=\"bar\"><i style=\"width:'+(100*i/order.length)+'%\"></i></div></div><p style=\"color:var(--ink)\">Look carefully at the exterior of this museum. Continue when you feel you have observed and understood it.</p><div class=\"card\"><div class=\"pic\"><img alt=\"Museum facade, Beijing Olympic Park\" src=\"'+esc(f.url)+'\"></div></div>','Continue',function(){\n      send([SPSite.answer('viewing',{view_ms:Date.now()-t0,order:i+1},{key:t.id,shown:[f.name]})],this,function(){done[t.id]=true;next();});});\n  }\n  function pad(){\n    var rows=PAD.map(function(it){return '<div class=\"it\" data-k=\"'+it.key+'\"><div class=\"sd\"><span class=\"l\">'+esc(it.lo)+'</span><div class=\"sc sc9\" role=\"radiogroup\" aria-label=\"'+esc(it.lo+' – '+it.hi)+'\">'+[-4,-3,-2,-1,0,1,2,3,4].map(function(v){return '<label><input type=\"radio\" name=\"'+it.key+'\" value=\"'+v+'\">'+v+'</label>';}).join('')+'</div><span class=\"r\">'+esc(it.hi)+'</span></div></div>';}).join('');\n    page('<h1>How did the three pictures make you feel?</h1><p>For each pair, choose which feeling was stronger and how strong it was. 0 is the middle.</p><div class=\"card\">'+rows+'</div>','Continue',function(){\n      var v=collect(PAD);if(!v)return;\n      send([SPSite.answer('pad',v)],this,function(){ans.pad=true;save('a',ans);next();});});\n  }\n  function att(){\n    var rows=ATT.map(function(it){return '<div class=\"it\" data-k=\"'+it.key+'\"><div class=\"x\">'+esc(it.text)+'</div><div class=\"sc sc7\" role=\"radiogroup\" aria-label=\"'+esc(it.text)+'\">'+[1,2,3,4,5,6,7].map(function(v){return '<label><input type=\"radio\" name=\"'+it.key+'\" value=\"'+v+'\">'+v+'</label>';}).join('')+'</div><div class=\"ends\"><span>1 = no emotional experience</span><span>7 = very strong</span></div></div>';}).join('');\n    page('<h1>Your emotional experience of the museums</h1><p>How strong is your emotional experience of each characteristic of the three museums and their surroundings?</p><div class=\"card\">'+rows+'</div>','Finish',function(){\n      var v=collect(ATT);if(!v)return;\n      send([SPSite.answer('attachment',v)],this,function(){ans.att=true;save('a',ans);next();});});\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>In the original study, 229 university students in Beijing viewed these three facades while an eye tracker recorded their gaze. On average the pictures brought a positive feeling (pleasure about +1.7 on the −4 to +4 scale), with arousal near zero and slightly low dominance. Interactive elements of the facades drew the most attention and emotional response.</p><p style=\"font-size:.82rem\">Photographs and method: Zhang, R., Chai, D., Zhou, Z., Sun, R., Zhang, Z., &amp; Chen, C. (2025). Research on the Relationship Between Urban Visual Quality and Students’ Emotional Experience Driven by Multimodal Data: A Case Study of Beijing Olympic Park Museum Group. Buildings 15:57, doi:10.3390/buildings15010057.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')ans.intro=false;else if(x==='viewing')done={};else if(x==='pad')ans.pad=false;else if(x==='attachment')ans.att=false;else ans.about=false;});save('a',ans);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    var SPEC;try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='viewing')TR=e.trials;if(e.name==='pad')PAD=e.items;if(e.name==='attachment')ATT=e.items;});});\n    (SPSite.getMedia('museums')||[]).forEach(function(f){files[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};ans=load('a')||{};\n    order=load('o');if(!order||order.length!==TR.length)order=shuffle(TR.map(function(t){return t.id;}));save('o',order);\n    ((a.viewing&&a.viewing.trials)||[]).forEach(function(t){if(t.key)done[t.key]=true;});\n    ans.intro=a.consent===true;ans.about=a.gender!=null&&a.major!=null;ans.pad=a.pad!=null;ans.att=a.attachment!=null;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
