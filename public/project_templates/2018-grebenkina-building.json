   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Building Facade Aesthetic Ratings</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Building Facade Aesthetic Ratings\",\n    \"description\": \"50 greyscale photographs of building facades in Vienna and Berlin, from plain window grids to richly ornamented fronts, each showing two storeys. Participants rate every facade three times, in three blocks of random order: how pleasing, how interesting and how harmonious it is, by clicking on a 100-step scale. Rebuilt from Experiment 3 of Grebenkina, Brachmann, Bertamini, Kaduhm and Redies (2018), Frontiers in Neuroscience, with the authors' CC BY images from OSF cxyj4.\",\n    \"locale\": \"en\",\n    \"mediaFolders\": [\"facades\"],\n    \"pages\": [\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" },\n        { \"type\": \"radiogroup\", \"name\": \"sex\", \"title\": \"Sex\", \"isRequired\": true, \"choices\": [ { \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"male\", \"text\": \"Male\" }, { \"value\": \"other\", \"text\": \"Other / prefer not to say\" } ] },\n        { \"type\": \"number\", \"name\": \"age\", \"title\": \"Age (years)\", \"min\": 18, \"max\": 99, \"isRequired\": true },\n        { \"type\": \"radiogroup\", \"name\": \"art_training\", \"title\": \"Have you had formal training in the visual arts, architecture or design?\", \"isRequired\": true, \"choices\": [ { \"value\": \"yes\", \"text\": \"Yes\" }, { \"value\": \"no\", \"text\": \"No\" } ] }\n      ]},\n      { \"name\": \"ratings\", \"elements\": [\n        { \"type\": \"imageslidergroup\", \"name\": \"pleasing\", \"title\": \"Pleasing\", \"description\": \"Block 'pleasing': 50 facades in random order, one click on a 100-step scale (1 = not pleasing … 100 = pleasing). key = image number (001–050), as in the Filename column of Facades_ratings_variables.xlsx on OSF cxyj4 (there scaled 0–1: divide by 100 to compare).\", \"imageCount\": 1, \"scaleMin\": 1, \"scaleMax\": 100, \"isRequired\": true, \"dimensions\": [\n          { \"id\": \"pleasing\", \"label\": \"Pleasing\", \"left\": \"Not pleasing\", \"right\": \"Pleasing\", \"min\": 1, \"max\": 100, \"step\": 1 } ] },\n        { \"type\": \"imageslidergroup\", \"name\": \"interesting\", \"title\": \"Interesting\", \"description\": \"Block 'interesting': same 50 facades, new random order. key = image number.\", \"imageCount\": 1, \"scaleMin\": 1, \"scaleMax\": 100, \"isRequired\": true, \"dimensions\": [\n          { \"id\": \"interesting\", \"label\": \"Interesting\", \"left\": \"Not interesting\", \"right\": \"Interesting\", \"min\": 1, \"max\": 100, \"step\": 1 } ] },\n        { \"type\": \"imageslidergroup\", \"name\": \"harmonious\", \"title\": \"Harmonious\", \"description\": \"Block 'harmonious': same 50 facades, new random order. key = image number.\", \"imageCount\": 1, \"scaleMin\": 1, \"scaleMax\": 100, \"isRequired\": true, \"dimensions\": [\n          { \"id\": \"harmonious\", \"label\": \"Harmonious\", \"left\": \"Not harmonious\", \"right\": \"Harmonious\", \"min\": 1, \"max\": 100, \"step\": 1 } ] },\n        { \"type\": \"custom\", \"name\": \"block_order\", \"title\": \"Order of the three rating blocks\", \"description\": \"Recorded by the page: the three block names in the order this participant saw them (randomised).\", \"isRequired\": true }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f2f2f0;--card:#fff;--ink:#1c1c1c;--muted:#5b5b5b;--accent:#8a4b2a;--accent-ink:#fff;--line:#d8d6d2;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:24px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:8px 0 14px}.progress>i{display:block;height:100%;background:var(--accent)}\n.screen{background:#000;border-radius:12px;padding:16px 16px 20px;display:flex;flex-direction:column;align-items:center}\n.stim{width:min(100%,58vh,520px);aspect-ratio:1;display:flex;align-items:center;justify-content:center;color:#fff;font-size:2rem}\n.stim img{width:100%;height:100%;object-fit:contain;display:block}\n.term{color:#fff;font-weight:600;margin:14px 0 8px}\n.bar{position:relative;width:min(100%,520px);height:34px;border-radius:17px;background:linear-gradient(90deg,#3a3a3a,#9a9a9a);cursor:pointer;touch-action:manipulation}\n.bar:focus-visible{outline:3px solid #f0c27b;outline-offset:3px}\n.bar.wait{opacity:.35;cursor:default}\n.ends{display:flex;justify-content:space-between;width:min(100%,520px);color:#ddd;font-size:.85rem;margin-top:6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:16px}.q:first-child{margin-top:0}.q>b{display:block;margin-bottom:4px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:120px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Facade photographs: Christoph Redies, from Grebenkina, Brachmann, Bertamini, Kaduhm &amp; Redies (2018), OSF cxyj4, CC BY 4.0 (16-bit TIFF converted to 8-bit JPEG).</footer>\n<script>\n(function(){\n  var IDS=[];for(var n=1;n<=50;n++)IDS.push((n<10?'00':'0')+n);\n  var BLOCKS=['pleasing','interesting','harmonious'], FIX=window.__FIXMS!=null?window.__FIXMS:500;\n  var app=document.getElementById('app'), Q={}, files={}, plan=null, done={pleasing:{},interesting:{},harmonious:{}}, seen={};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function shuffle(a){a=a.slice();for(var k=a.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1));var x=a[k];a[k]=a[j];a[j]=x;}return a;}\n  function fn(id){return id+'.jpg';}\n  function setup(blocks){\n    var s=null;try{s=JSON.parse(localStorage.getItem('facade2018:plan'));}catch(e){}\n    var good=s&&Array.isArray(s.blocks)&&s.blocks.length===3&&s.order&&BLOCKS.every(function(b){return Array.isArray(s.order[b])&&s.order[b].length===50;});\n    plan=good?s:{blocks:shuffle(BLOCKS),order:{pleasing:shuffle(IDS),interesting:shuffle(IDS),harmonious:shuffle(IDS)}};\n    if(blocks)plan.blocks=blocks;\n    try{localStorage.setItem('facade2018:plan',JSON.stringify(plan));}catch(e){}\n  }\n  function radios(n){return (Q[n].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');}\n  function intro(){\n    var miss=IDS.filter(function(id){return !files[fn(id)];});\n    if(miss.length){app.innerHTML='<h1>Photographs missing</h1><p>Missing in folder “facades”: '+esc(miss.map(fn).join(', '))+'</p>';return;}\n    app.innerHTML='<h1>How do these building facades look to you?</h1><p>You will see 50 black-and-white photographs of building facades. You will rate all of them three times, each time on a different word: pleasing, interesting and harmonious. For each photograph, click once on the bar below it: the further right, the more the word applies. The next photograph follows straight away. There are no right or wrong answers. About 15 minutes.</p>'+\n      '<div class=\"card\"><div class=\"q\"><b>'+esc(Q.sex.title)+'</b>'+radios('sex')+'</div><div class=\"q\"><b>'+esc(Q.age.title)+'</b><input type=\"number\" id=\"age\" min=\"18\" max=\"99\" inputmode=\"numeric\"></div><div class=\"q\"><b>'+esc(Q.art_training.title)+'</b>'+radios('art_training')+'</div></div>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var s=app.querySelector('input[name=sex]:checked');if(!s)return err('Please answer: Sex.');\n      var av=document.getElementById('age').value, age=Number(av);if(!av||!(age>=18&&age<=99))return err('Please enter your age (18–99).');\n      var t=app.querySelector('input[name=art_training]:checked');if(!t)return err('Please answer: formal training.');\n      var b=this;b.disabled=true;\n      Promise.all([SPSite.answer('consent',true),SPSite.answer('sex',s.value),SPSite.answer('age',age),SPSite.answer('art_training',t.value),SPSite.answer('block_order',plan.blocks)]).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}next();});\n    };\n  }\n  function next(){\n    window.scrollTo(0,0);\n    for(var k=0;k<3;k++){\n      var bl=plan.blocks[k], left=plan.order[bl].filter(function(id){return !done[bl][id];});\n      if(left.length){\n        if(!seen[bl])return blockIntro(bl,k);\n        return trial(bl,k,left[0],50-left.length);\n      }\n    }\n    finish();\n  }\n  function blockIntro(bl,k){\n    var d=(Q[bl].dimensions||[])[0]||{};\n    app.innerHTML='<h1>Part '+(k+1)+' of 3: '+esc(d.label.toLowerCase())+'</h1><div class=\"card\"><p style=\"margin:0\">In this part, rate how <b>'+esc(d.label.toLowerCase())+'</b> each facade is. Click on the bar: left end = '+esc(d.left.toLowerCase())+', right end = '+esc(d.right.toLowerCase())+'. '+(k>0?'Take a break first if you like.':'')+'</p><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Begin</button></div></div>';\n    document.getElementById('go').onclick=function(){seen[bl]=true;next();};\n  }\n  function trial(bl,k,id,n){\n    var d=(Q[bl].dimensions||[])[0]||{}, ready=false, busy=false;\n    var nxt=plan.order[bl][plan.order[bl].indexOf(id)+1];if(nxt&&files[fn(nxt)]){var im=new Image();im.src=files[fn(nxt)].url;}\n    app.innerHTML='<p>Part '+(k+1)+' of 3 · photograph '+(n+1)+' of 50</p><div class=\"progress\"><i style=\"width:'+(100*(k*50+n)/150)+'%\"></i></div>'+\n      '<div class=\"screen\"><div class=\"stim\" id=\"stim\">+</div><div class=\"term\">'+esc(d.label)+'</div><div class=\"bar wait\" id=\"bar\" role=\"slider\" tabindex=\"0\" aria-label=\"'+esc(d.label)+'\" aria-valuemin=\"1\" aria-valuemax=\"100\"></div><div class=\"ends\"><span>'+esc(d.left)+'</span><span>'+esc(d.right)+'</span></div></div><div class=\"err\"></div>';\n    var bar=document.getElementById('bar');\n    setTimeout(function(){\n      var st=document.getElementById('stim');if(!st)return;\n      st.innerHTML='<img src=\"'+esc(files[fn(id)].url)+'\" alt=\"Photograph of a building facade\">';\n      ready=true;bar.classList.remove('wait');\n    },FIX);\n    function submit(v){\n      if(!ready||busy)return;busy=true;var val={};val[d.id]=Math.max(1,Math.min(100,v));\n      SPSite.answer(bl,val,{key:id,shown:[fn(id)]}).then(function(r){if(!ok(r)){busy=false;return err(r.error);}done[bl][id]=true;next();});\n    }\n    bar.addEventListener('click',function(e){var r=bar.getBoundingClientRect();submit(Math.ceil(((e.clientX-r.left)/r.width)*100)||1);});\n    var kv=50;bar.addEventListener('keydown',function(e){if(e.key==='ArrowRight'){kv=Math.min(100,kv+5);bar.setAttribute('aria-valuenow',kv);}else if(e.key==='ArrowLeft'){kv=Math.max(1,kv-5);bar.setAttribute('aria-valuenow',kv);}else if(e.key==='Enter')submit(kv);});\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){if(m.some(function(x){return BLOCKS.indexOf(x)<0;}))intro();else next();},1800);}else{var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  SPSite.onReady(function(ctx){\n    ['consent','sex','age','art_training','pleasing','interesting','harmonious','block_order'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('facades')||[]).forEach(function(f){files[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};\n    setup(Array.isArray(a.block_order)&&a.block_order.length===3?a.block_order:null);\n    BLOCKS.forEach(function(q){var p=a[q];(p&&Array.isArray(p.trials)?p.trials:[]).forEach(function(x){if(x&&x.key!=null&&x.value!=null){done[q][String(x.key)]=true;seen[q]=true;}});});\n    if(a.consent===true)next();else intro();\n  });\n})();\n</script>\n</body>\n</html>\n",
