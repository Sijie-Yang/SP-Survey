nge floor, brown main wall and furniture, green recessed wall and seating)\"\n       },\n       {\n        \"value\": \"S\",\n        \"text\": \"Store S (brown floor, green main wall and furniture, orange recessed wall and seating)\"\n       },\n       {\n        \"value\": \"T\",\n        \"text\": \"Store T (green floor, orange main wall and furniture, brown recessed wall and seating)\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"ll_ps_least\",\n      \"title\": \"In which store would you least prefer to stay?\",\n      \"description\": \"Low-luxury colour combination (brown, orange, green).\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"O\",\n        \"text\": \"Store O (orange floor, green main wall and furniture, brown recessed wall and seating)\"\n       },\n       {\n        \"value\": \"P\",\n        \"text\": \"Store P (brown floor, orange main wall and furniture, green recessed wall and seating)\"\n       },\n       {\n        \"value\": \"Q\",\n        \"text\": \"Store Q (green floor, brown main wall and furniture, orange recessed wall and seating)\"\n       },\n       {\n        \"value\": \"R\",\n        \"text\": \"Store R (orange floor, brown main wall and furniture, green recessed wall and seating)\"\n       },\n       {\n        \"value\": \"S\",\n        \"text\": \"Store S (brown floor, green main wall and furniture, orange recessed wall and seating)\"\n       },\n       {\n        \"value\": \"T\",\n        \"text\": \"Store T (green floor, orange main wall and furniture, brown recessed wall and seating)\"\n       }\n      ]\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"ll_ps_reason\",\n      \"title\": \"Why did you choose these two? (preference to stay)\",\n      \"description\": \"Low-luxury colour combination (brown, orange, green).\",\n      \"isRequired\": true\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"store-original\">{\"source\": \"Cho & Suh (2020) Front. Psychol. 11:296, Tables 2\\u20135\", \"n\": 26, \"colours\": {\"A\": \"brown floor, dark brown main wall and furniture, ivory recessed wall and seating\", \"B\": \"dark brown floor, ivory main wall and furniture, brown recessed wall and seating\", \"C\": \"ivory floor, brown main wall and furniture, dark brown recessed wall and seating\", \"D\": \"brown floor, ivory main wall and furniture, dark brown recessed wall and seating\", \"E\": \"dark brown floor, brown main wall and furniture, ivory recessed wall and seating\", \"F\": \"ivory floor, dark brown main wall and furniture, brown recessed wall and seating\", \"O\": \"orange floor, green main wall and furniture, brown recessed wall and seating\", \"P\": \"brown floor, orange main wall and furniture, green recessed wall and seating\", \"Q\": \"green floor, brown main wall and furniture, orange recessed wall and seating\", \"R\": \"orange floor, brown main wall and furniture, green recessed wall and seating\", \"S\": \"brown floor, green main wall and furniture, orange recessed wall and seating\", \"T\": \"green floor, orange main wall and furniture, brown recessed wall and seating\"}, \"votes\": {\"hl_pl_most\": {\"E\": 7}, \"hl_pl_least\": {\"C\": 8, \"D\": 8}, \"ll_pl_most\": {\"Q\": 6, \"P\": 5, \"R\": 5}, \"ll_pl_least\": {\"O\": 7, \"T\": 6}, \"hl_ps_most\": {\"A\": 7, \"B\": 6}, \"hl_ps_least_top\": \"F\", \"ll_ps_most\": {\"P\": 7, \"Q\": 6}, \"ll_ps_least\": {\"T\": 8}, \"ll_ps_least_second\": \"O\"}}</script>\n<style>\n:root{--bg:#f5f3ef;--card:#fff;--ink:#26211c;--muted:#6b6259;--accent:#7a4e2d;--line:#e3ddd4;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1000px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.1rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.one{background:#000;border-radius:12px;overflow:hidden}.one img{width:100%;display:block}\n.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}\n.tile{position:relative;border-radius:8px;overflow:hidden;background:#000}.tile img{width:100%;display:block}\n.tile b{position:absolute;left:6px;top:6px;background:rgba(255,255,255,.92);color:#000;border-radius:6px;padding:0 8px;font-size:.95rem}\n@media(max-width:600px){.grid{grid-template-columns:repeat(2,1fr)}}\n.timer{height:4px;background:var(--line);border-radius:2px;overflow:hidden;margin-top:8px}.timer>i{display:block;height:100%;background:var(--accent);width:0}\n.pick{margin-top:14px}.pick .row{display:grid;grid-template-columns:repeat(6,1fr);gap:6px;margin-top:6px}\n.pick button{appearance:none;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:8px;padding:9px 0;font:inherit;font-weight:700;cursor:pointer}\n.pick button.on{background:var(--accent);border-color:var(--accent);color:#fff}\n.pick.miss>b{color:var(--warn)}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\ntextarea{width:100%;min-height:70px;font:inherit;padding:10px;border:1px solid var(--line);border-radius:8px;margin-top:6px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:1000px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Renderings: Cho &amp; Suh (2020), Frontiers in Psychology 11: 296, Table 1, CC BY 4.0.</footer>\n<script>\n(function(){\n  var F=window.__VIEWMS, VIEW_MS=F||20000, KEY='store-colour:state';\n  var GROUPS=[{g:'hl',L:'ABCDEF',name:'first'},{g:'ll',L:'OPQRST',name:'second'}];\n  var app=document.getElementById('app'), Q={}, files={}, st=null, tm=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function G(){return GROUPS[st.gi];}\n  function file(x){return files[G().g+'_'+x];}\n  function letters(){return G().L.split('').filter(function(x){return file(x);});}\n  function shown(){return letters().map(function(x){return file(x).name;});}\n  function grid(){return '<div class=\"grid\">'+letters().map(function(x){return '<div class=\"tile\"><img alt=\"Store '+x+'\" src=\"'+esc(file(x).url)+'\"><b>'+x+'</b></div>';}).join('')+'</div>';}\n  function bar(){var tb=document.getElementById('tb');tb.style.transition='width '+(VIEW_MS/1000)+'s linear';requestAnimationFrame(function(){requestAnimationFrame(function(){tb.style.width='100%';});});}\n  function radio(n){var q=Q[n];return '<div class=\"f\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function intro(){\n    app.innerHTML='<h1>Colour in a store interior</h1><p>You will see two sets of six pictures of the same clothing store, each painted with one colour combination applied in six different ways. You will look at each picture for 20 seconds, then compare the six and tell us which looks most and least luxurious and where you would most and least like to stay. Please use a large screen. About 12 minutes.</p>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div class=\"f\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"16\" max=\"99\"></div>'+radio('gender')+radio('design_background')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var age=Number(document.getElementById('age').value);if(!(age>=16&&age<=99))return err('Please enter your age.');\n      var g=function(n){var x=app.querySelector('input[name='+n+']:checked');return x?x.value:null;};\n      var v={gender:g('gender'),design_background:g('design_background')};for(var n in v)if(!v[n])return err('Please answer: '+Q[n].title);\n      var b=this;b.disabled=true;\n      Promise.all([SPSite.answer('consent',true),SPSite.answer('age',age),SPSite.answer('gender',v.gender),SPSite.answer('design_background',v.design_background)]).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}st={step:'set',gi:0,phase:'ready',k:0};save();route();});\n    };\n  }\n  function ready(){\n    app.innerHTML='<h2>Set '+(st.gi+1)+' of 2</h2><div class=\"card\"><p>Six pictures of the store will appear one by one, 20 seconds each. Just look at each one. Afterwards you will see all six together.</p><button class=\"btn\" id=\"go\">Show the '+G().name+' set</button></div>';\n    document.getElementById('go').onclick=function(){st.phase='single';st.k=0;save();route();};\n  }\n  function single(){\n    var L=letters();if(st.k>=L.length){st.phase='fv';save();return route();}\n    var x=L[st.k];\n    app.innerHTML='<p>Set '+(st.gi+1)+' · store '+x+' ('+(st.k+1)+' of '+L.length+')</p><div class=\"one\"><img alt=\"Store '+x+'\" src=\"'+esc(file(x).url)+'\"></div><div class=\"timer\"><i id=\"tb\"></i></div>';\n    bar();tm=setTimeout(function(){st.k++;save();route();},VIEW_MS);\n  }\n  function fv(){\n    app.innerHTML='<h2>All six stores</h2><p>Look at the six stores freely.</p>'+grid()+'<div class=\"timer\"><i id=\"tb\"></i></div>';\n    bar();tm=setTimeout(function(){st.phase='pl';save();route();},VIEW_MS);\n  }\n  function task(kind){\n    var g=G().g, L=letters(), pre=g+'_'+kind;\n    var lead=kind==='pl'?'Look at the six stores and consider how luxurious each one looks.':'Look at the six stores and consider how much you would like to stay in each one.';\n    app.innerHTML='<h2>'+(kind==='pl'?'How luxurious?':'Where would you like to stay?')+'</h2><p>'+lead+'</p>'+grid()+'<div class=\"timer\"><i id=\"tb\"></i></div><div id=\"ask\"></div>';\n    bar();window.scrollTo(0,0);\n    tm=setTimeout(function(){\n      var vals={};\n      document.getElementById('ask').innerHTML='<div class=\"card\">'+['most','least'].map(function(w){var n=pre+'_'+w;return '<div class=\"pick\" data-n=\"'+n+'\"><b>'+esc(Q[n].title)+'</b><div class=\"row\">'+L.map(function(x){return '<button type=\"button\" data-v=\"'+x+'\">'+x+'</button>';}).join('')+'</div></div>';}).join('')+\n        '<div class=\"f\"><b>'+esc(Q[pre+'_reason'].title)+'</b><textarea id=\"why\"></textarea></div><div style=\"margin-top:12px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n      app.querySelectorAll('.pick').forEach(function(p){p.querySelectorAll('button').forEach(function(b){b.onclick=function(){vals[p.dataset.n]=b.dataset.v;p.classList.remove('miss');p.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b);});};});});\n      document.getElementById('go').onclick=function(){\n        var miss=['most','least'].map(function(w){return pre+'_'+w;}).filter(function(n){return !vals[n];});\n        miss.forEach(function(n){app.querySelector('.pick[data-n=\"'+n+'\"]').classList.add('miss');});\n        if(miss.length)return err('Please choose a store for each question.');\n        if(vals[pre+'_most']===vals[pre+'_least'])return err('Please choose two different stores.');\n        var why=document.getElementById('why').value.trim();if(why.length<3)return err('Please tell us briefly why.');\n        var b=this;b.disabled=true;var sh={shown:shown()};\n        Promise.all([SPSite.answer(pre+'_most',vals[pre+'_most'],sh),SPSite.answer(pre+'_least',vals[pre+'_least'],sh),SPSite.answer(pre+'_reason',why)]).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}\n          if(kind==='pl')st.phase='ps';else if(st.gi===0){st.gi=1;st.phase='ready';}else st.step='done';save();route();});\n      };\n    },VIEW_MS);\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){var m=r.missing||[];var gi=m.some(function(x){return x.indexOf('hl_')===0;})?0:m.some(function(x){return x.indexOf('ll_')===0;})?1:-1;st=gi<0?{step:'intro'}:{step:'set',gi:gi,phase:'ready',k:0};save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){clearTimeout(tm);if(st.step==='done')return finish();if(st.step==='set'){if(st.phase==='single')return single();if(st.phase==='fv')return fv();if(st.phase==='pl')return task('pl');if(st.phase==='ps')return task('ps');return ready();}intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','design_background'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    GROUPS.forEach(function(x){['pl','ps'].forEach(function(k){['most','least','reason'].forEach(function(w){var n=x.g+'_'+k+'_'+w;Q[n]=SPSite.getQuestion(n)||{};});});});\n    (SPSite.getMedia('store')||[]).forEach(function(f){if(/\\.(jpe?g|png|webp)$/i.test(f.name))files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    if(!Object.keys(files).length){app.innerHTML='<h1>Pictures missing</h1><p>Upload the renderings to the media folder \"store\" (hl_A.jpg … hl_F.jpg, ll_O.jpg … ll_T.jpg).</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!st||!st.step)st={step:'intro'};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true)st={step:'intro'};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
