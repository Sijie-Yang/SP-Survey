   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Retail Interior Colour</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Retail Interior Colour: Perceived Luxury and Preference to Stay\",\n  \"description\": \"Two sets of six renderings of the same store, each applying one three-colour combination to floor, main wall and furniture, and recessed wall and seating in six different ways. For each set the participant views every rendering for 20 s, views all six together, then picks the most and least luxurious store and the stores they would most and least prefer to stay in, with reasons. Rebuilt from Cho & Suh (2020), Frontiers in Psychology 11: 296, with the paper's 12 renderings (Table 1, CC BY 4.0).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"store\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"min\": 16,\n      \"max\": 99\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"design_background\",\n      \"title\": \"Do you study or work in interior design or architecture?\",\n      \"description\": \"The paper's participants were 26 interior design students.\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"interior_architecture\",\n        \"text\": \"Yes, interior design or architecture\"\n       },\n       {\n        \"value\": \"other_design\",\n        \"text\": \"Another design field\"\n       },\n       {\n        \"value\": \"none\",\n        \"text\": \"No\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"high_luxury_set\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"hl_pl_most\",\n      \"title\": \"Which store looks the most luxurious?\",\n      \"description\": \"High-luxury colour combination (dark brown, brown, ivory). File hl_<letter>.jpg.\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"A\",\n        \"text\": \"Store A (brown floor, dark brown main wall and furniture, ivory recessed wall and seating)\"\n       },\n       {\n        \"value\": \"B\",\n        \"text\": \"Store B (dark brown floor, ivory main wall and furniture, brown recessed wall and seating)\"\n       },\n       {\n        \"value\": \"C\",\n        \"text\": \"Store C (ivory floor, brown main wall and furniture, dark brown recessed wall and seating)\"\n       },\n       {\n        \"value\": \"D\",\n        \"text\": \"Store D (brown floor, ivory main wall and furniture, dark brown recessed wall and seating)\"\n       },\n       {\n        \"value\": \"E\",\n        \"text\": \"Store E (dark brown floor, brown main wall and furniture, ivory recessed wall and seating)\"\n       },\n       {\n        \"value\": \"F\",\n        \"text\": \"Store F (ivory floor, dark brown main wall and furniture, brown recessed wall and seating)\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"hl_pl_least\",\n      \"title\": \"Which store looks the least luxurious?\",\n      \"description\": \"High-luxury colour combination (dark brown, brown, ivory).\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"A\",\n        \"text\": \"Store A (brown floor, dark brown main wall and furniture, ivory recessed wall and seating)\"\n       },\n       {\n        \"value\": \"B\",\n        \"text\": \"Store B (dark brown floor, ivory main wall and furniture, brown recessed wall and seating)\"\n       },\n       {\n        \"value\": \"C\",\n        \"text\": \"Store C (ivory floor, brown main wall and furniture, dark brown recessed wall and seating)\"\n       },\n       {\n        \"value\": \"D\",\n        \"text\": \"Store D (brown floor, ivory main wall and furniture, dark brown recessed wall and seating)\"\n       },\n       {\n        \"value\": \"E\",\n        \"text\": \"Store E (dark brown floor, brown main wall and furniture, ivory recessed wall and seating)\"\n       },\n       {\n        \"value\": \"F\",\n        \"text\": \"Store F (ivory floor, dark brown main wall and furniture, brown recessed wall and seating)\"\n       }\n      ]\n     },\n     {\n      \"type\": \"comment\",\n      \"name\": \"hl_pl_reason\",\n      \"title\": \"Why did you choose these two? (perceived luxury)\",\n      \"description\": \"High-luxury colour combination (dark brown, brown, ivory).\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"hl_ps_most\",\n      \"title\": \"In which store would you most prefer to stay?\",\n      \"description\": \"High-luxury colour combination (dark brown, brown, ivory).\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"A\",\n        \"text\": \"Store A (brown floor, dark brown main wall and furniture, ivory recessed wall and seating)\"\n       },\n       {\n        \"valu