   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Street Lighting and Feeling Safe After Dark</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Street Lighting and Feeling Safe After Dark\",\n    \"description\": \"Walk a set route after dark and, at each numbered point, rate the street lighting (illumination, colour temperature, uniformity, glare), your feeling of safety and overall lighting quality. Rebuilt from Portnov, Saad, Trop, Kliger & Svechkina (2020).\",\n    \"locale\": \"en\",\n    \"pages\": [\n      { \"name\": \"before\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. My answers, with the route, point number and time of each report, are recorded anonymously for research. I will walk the route only where and when I feel comfortable doing so.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" },\n        { \"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"choices\": [\n          { \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"male\", \"text\": \"Male\" }, { \"value\": \"other\", \"text\": \"Other / prefer not to say\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"age_group\", \"title\": \"Age group\", \"choices\": [\n          { \"value\": \"18_40\", \"text\": \"18–40\" }, { \"value\": \"41_60\", \"text\": \"41–60\" }, { \"value\": \"61_plus\", \"text\": \"61 or older\" } ] },\n        { \"type\": \"text\", \"inputType\": \"number\", \"name\": \"education_years\", \"title\": \"Years of schooling\", \"min\": 0, \"max\": 30 },\n        { \"type\": \"text\", \"name\": \"country_of_birth\", \"title\": \"Country of birth\" },\n        { \"type\": \"text\", \"name\": \"route\", \"title\": \"Route code (given by the researcher)\", \"isRequired\": true }\n      ]},\n      { \"name\": \"points\", \"elements\": [\n        { \"type\": \"rating\", \"name\": \"illumination\", \"title\": \"Illumination: how is the amount of light here?\", \"rateMin\": 0, \"rateMax\": 3, \"rateLabels\": [\"Very weak\", \"Reasonable\", \"Good\", \"Too strong\"], \"isRequired\": true },\n        { \"type\": \"rating\", \"name\": \"color_temperature\", \"title\": \"Light colour: how warm or cold does the light look?\", \"rateMin\": 0, \"rateMax\": 3, \"rateLabels\": [\"Too cold\", \"A bit cold\", \"A bit hot\", \"Too hot\"], \"isRequired\": true },\n        { \"type\": \"rating\", \"name\": \"uniformity\", \"title\": \"Uniformity: how evenly is the street lit?\", \"rateMin\": 0, \"rateMax\": 3, \"rateLabels\": [\"Non-uniform\", \"Slightly non-uniform\", \"Quite uniform\", \"Very uniform\"], \"isRequired\": true },\n        { \"type\": \"rating\", \"name\": \"glare\", \"title\": \"Glare: how glaring are the lights?\", \"rateMin\": 0, \"rateMax\": 3, \"rateLabels\": [\"Not glaring\", \"Slightly glaring\", \"Quite glaring\", \"Very glaring\"], \"isRequired\": true },\n        { \"type\": \"rating\", \"name\": \"feeling_of_safety\", \"title\": \"How safe do you feel here?\", \"rateMin\": 0, \"rateMax\": 3, \"rateLabels\": [\"Feel very unsafe\", \"Feel a little unsafe\", \"Feel reasonably safe\", \"Feel very safe\"], \"isRequired\": true },\n        { \"type\": \"rating\", \"name\": \"lighting_quality\", \"title\": \"Overall, how comfortable is the lighting here?\", \"rateMin\": 0, \"rateMax\": 3, \"rateLabels\": [\"Uncomfortable\", \"Slightly uncomfortable\", \"Quite comfortable\", \"Very comfortable\"], \"isRequired\": true },\n        { \"type\": \"custom\", \"name\": \"report_log\", \"title\": \"One entry per point: { point, route, at (ISO time), hour (local) }\" }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#10141c;--card:#1a2030;--ink:#eef1f6;--muted:#a3adbf;--accent:#f2c14e;--accent-ink:#1a1405;--line:#2d3548;--on:#2f3b55}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:640px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.02rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:12px;padding:14px 20px;font:inherit;font-weight:700;cursor:pointer;background:var(--accent);color:var(--accent-ink);width:100%}\n.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line);width:auto;padding:10px 14px}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:16px}.q>b{display:block;margin-bottom:6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:10px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\ninput[type=number],input[type=text],select{font:inherit;padding:10px;border:1px solid var(--line);border-radius:8px;background:#0e131c;color:var(--ink);width:100%}\n.opts{display:grid;grid-template-columns:1fr 1fr;gap:6px}\n.opts button{appearance:none;border:1px solid var(--line);background:transparent;color:var(--ink);border-radius:10px;padding:10px 8px;font:inherit;font-size:.92rem;cursor:pointer;text-align:left}\n.opts button.on{border-color:var(--accent);background:var(--on)}\n.pts{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}\n.pts span{font-size:.8rem;padding:3px 8px;border-radius:999px;background:var(--on);color:var(--muted)}\n.err{color:#ff8a80;margin-top:8px;min-height:1.2em}\n.row{display:flex;gap:8px;align-items:center}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<script>\n(function(){\n  var MAX_POINT=40; // highest point number on a route\n  var RATINGS=['illumination','color_temperature','uniformity','glare','feeling_of_safety','lighting_quality'];\n  var app=document.getElementById('app'), Q={}, route='', log={}, reported={}, current=1;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function radios(n){return (Q[n].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');}\n  function before(){\n    app.innerHTML='<h1>Lighting walk</h1><p>Walk your route after dark. At each numbered point, stop, look around and answer six short questions about the lighting and how safe you feel. Each report saves the time automatically.</p>'+\n      '<div class=\"card\"><label class=\"opt\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label>'+\n      '<div class=\"q\"><b>'+esc(Q.gender.title)+'</b>'+radios('gender')+'</div>'+\n      '<div class=\"q\"><b>'+esc(Q.age_group.title)+'</b>'+radios('age_group')+'</div>'+\n      '<div class=\"q\"><b>'+esc(Q.education_years.title)+'</b><input type=\"number\" id=\"edu\" min=\"0\" max=\"30\" inputmode=\"numeric\"></div>'+\n      '<div class=\"q\"><b>'+esc(Q.country_of_birth.title)+'</b><input type=\"text\" id=\"cob\" maxlength=\"60\"></div>'+\n      '<div class=\"q\"><b>'+esc(Q.route.title)+'</b><input type=\"text\" id=\"route\" maxlength=\"40\" placeholder=\"e.g. A\"></div>'+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start the walk</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var r=document.getElementById('route').value.trim(); if(!r)return err('Please enter the route code.');\n      var b=this;b.disabled=true;\n      var g=(app.querySelector('input[name=gender]:checked')||{}).value, a=(app.querySelector('input[name=age_group]:checked')||{}).value,\n          edu=document.getElementById('edu').value, cob=document.getElementById('cob').value.trim();\n      var steps=[SPSite.answer('consent',true),SPSite.answer('route',r)];\n      if(g)steps.push(SPSite.answer('gender',g)); if(a)steps.push(SPSite.answer('age_group',a));\n      if(edu!=='')steps.push(SPSite.answer('education_years',Number(edu))); if(cob)steps.push(SPSite.answer('country_of_birth',cob));\n      Promise.all(steps).then(function(rs){var bad=rs.filter(function(x){return x&&x.ok===false;})[0];if(bad){b.disabled=false;return err(bad.error);}route=r;point();});\n    };\n  }\n  function point(){\n    while(reported[current]&&current<MAX_POINT)current++;\n    var opts='';for(var k=1;k<=MAX_POINT;k++)opts+='<option value=\"'+k+'\"'+(k===current?' selected':'')+(reported[k]?' disabled':'')+'>Point '+k+(reported[k]?' (done)':'')+'</option>';\n    var done=Object.keys(reported).map(Number).sort(function(a,b){return a-b;});\n    var html='<h1>Route '+esc(route)+'</h1><p>Stand at the point, look around for a moment, then answer. Each point can be reported once.</p>'+\n      '<div class=\"card\"><div class=\"row\"><select id=\"pt\" aria-label=\"Point number\">'+opts+'</select></div>'+\n      (done.length?'<div class=\"pts\">'+done.map(function(k){return '<span>✓ '+k+'</span>';}).join('')+'</div>':'');\n    var pick={};\n    RATINGS.forEach(function(n){var q=Q[n];\n      html+='<div class=\"q\"><h2>'+esc(q.title)+'</h2><div class=\"opts\">'+(q.rateValues||[]).map(function(v){return '<button data-n=\"'+n+'\" data-v=\"'+v.value+'\">'+esc(v.text)+'</button>';}).join('')+'</div></div>';\n    });\n    html+='<div style=\"margin-top:18px\"><button class=\"btn\" id=\"save\">Save this point</button></div><div class=\"err\"></div>'+\n      '<div style=\"margin-top:14px;text-align:right\"><button class=\"btn ghost\" id=\"end\">End the walk</button></div></div>';\n    app.innerHTML=html; window.scrollTo(0,0);\n    app.querySelectorAll('.opts button').forEach(function(b){b.onclick=function(){var n=b.getAttribute('data-n');pick[n]=Number(b.getAttribute('data-v'));\n      app.querySelectorAll('.opts button[data-n=\"'+n+'\"]').forEach(function(x){x.classList.toggle('on',x===b);});err('');};});\n    document.getElementById('save').onclick=function(){\n      var p=Number(document.getElementById('pt').value);\n      if(reported[p])return err('Point '+p+' is already reported.');\n      var miss=RATINGS.filter(function(n){return pick[n]==null;});\n      if(miss.length)return err('Please answer all six questions.');\n      var b=this;b.disabled=true;\n      var key=route+'#'+p, now=new Date();\n      log[key]={point:p,route:route,at:now.toISOString(),hour:now.getHours()+now.getMinutes()/60};\n      Promise.all(RATINGS.map(function(n){return SPSite.answer(n,pick[n],{key:key});}).concat([SPSite.answer('report_log',log)])).then(function(rs){\n        var bad=rs.filter(function(x){return x&&x.ok===false;})[0];if(bad){b.disabled=false;return err(bad.error);}\n        reported[p]=true;current=p+1;point();\n      });\n    };\n    document.getElementById('end').onclick=function(){\n      if(!Object.keys(reported).length)return err('Report at least one point before ending the walk.');\n      app.innerHTML='<h1>Thank you</h1><div class=\"card\"><p>You reported '+Object.keys(reported).length+' points. Submitting…</p><div class=\"err\"></div></div>';\n      SPSite.complete().then(function(r){if(r&&r.ok===false){err(r.error||'Some answers are missing.');if((r.missing||[]).some(function(m){return m==='consent'||m==='route';}))before();else setTimeout(point,1500);}});\n    };\n  }\n  SPSite.onReady(function(ctx){\n    ['consent','gender','age_group','education_years','country_of_birth','route','report_log'].concat(RATINGS).forEach(function(n){Q[n]=SPSite.getQuestion(n);});\n    var a=(ctx&&ctx.answers)||{};\n    if(a.report_log&&typeof a.report_log==='object'){log=a.report_log;Object.keys(log).forEach(function(k){if(log[k]&&log[k].point)reported[log[k].point]=true;});}\n    if(a.consent===true&&a.route){route=a.route;point();}else before();\n  });\n})();\n</script>\n</body>\n</html>\n",
