   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Park Enclosure Preference</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Vegetation Enclosure in Chinese Urban Parks: Aesthetic Preference\",\n  \"description\": \"Faithful replication of Liu & Schroth (2019), Sustainability 11:1809: rate 16 computer-generated Litchi Park (Shenzhen) scenes with four levels of vegetation-created enclosure for pleasantness (coherence), suitability for many functions (complexity) and legibility.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"scenes\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"intro\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"I have read and understood the purpose of this study and agree to take part. Participation is voluntary, I can withdraw at any time, and the questionnaire is anonymous.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"demographic\",\n    \"title\": \"Demographic\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Female\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Younger than 18\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"18–24\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"25–34\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"35–44\"\n   