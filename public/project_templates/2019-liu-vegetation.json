  \"value\": 1,\n        \"text\": \"Every day\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Once a week\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Once a month\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Once a quarter\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"Twice a year\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"Once a year\"\n       },\n       {\n        \"value\": 7,\n        \"text\": \"Never\"\n       }\n      ]\n     },\n     {\n      \"type\": \"checkbox\",\n      \"name\": \"time_of_day\",\n      \"title\": \"When will you go to urban parks? (multiple choice)\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"6:00–9:00\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"9:00–12:00\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"12:00–15:00\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"15:00–18:00\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"18:00–21:00\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"duration\",\n      \"title\": \"How long will you stay in urban parks?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Just passing by, will not stay in the park\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"About one hour\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Two to three hours\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"More than three hours\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"reason\",\n      \"title\": \"What are the primary reasons why you go to urban parks?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Staying alone\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Entertainment\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Meeting with friends\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Doing sports\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"Taking part in different kinds of activities and meeting new friends\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"Others\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"scenes\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"enclosure_preference\",\n      \"title\": \"Aesthetic preference for the scene\",\n      \"isRequired\": true,\n      \"description\": \"16 computer-generated scenes of Litchi Park, Shenzhen: 4 viewpoints (A–D) × 4 vegetation-created enclosure types (1 VPOO visually & physically open, 2 VPOC visually open / physically closed, 3 VPCO visually closed / physically open, 4 VPCC visually & physically closed), shown in the original order A-1 … D-4 (key = scene id). Value: {pleasantness (coherence), functions (complexity), legibility}, each 1 = most positive (very pleasant / very appropriate / very legible) … 5 = most negative. Analysis as in the paper: two-way ANOVA of each variable on visual × physical enclosure, paired t-tests between enclosure types within a viewpoint.\",\n      \"items\": [\n       {\n        \"name\": \"pleasantness\",\n        \"variable\": \"coherence\",\n        \"title\": \"How do you rate the degree of pleasantness of the scene shown in the picture?\",\n        \"labels\": [\n         \"very pleasant\",\n         \"pleasant\",\n         \"ok\",\n         \"unpleasant\",\n         \"very unpleasant\"\n        ]\n       },\n       {\n        \"name\": \"functions\",\n        \"variable\": \"complexity\",\n        \"title\": \"Do you think the scene showing in the picture is appropriate to bear a lot of functions?\",\n        \"labels\": [\n         \"very appropriate\",\n         \"appropriate\",\n         \"ok\",\n         \"inappropriate\",\n         \"very inappropriate\"\n        ]\n       },\n       {\n        \"name\": \"legibility\",\n        \"variable\": \"legibility\",\n        \"title\": \"How do you rate the degree of the legibility of the scene shown in the picture?\",\n        \"labels\": [\n         \"very legible\",\n         \"legible\",\n         \"ok\",\n         \"illegible\",\n         \"very illegible\"\n        ]\n       }\n      ],\n      \"min\": 1,\n      \"max\": 5,\n      \"trials\": [\n       {\n        \"id\": \"A1\",\n        \"file\": \"A1_vpoo.jpg\",\n        \"viewpoint\": \"A\",\n        \"enclosure\": \"vpoo\",\n        \"enclosureLabel\": \"Visually open, physically open\"\n       },\n       {\n        \"id\": \"A2\",\n        \"file\": \"A2_vpoc.jpg\",\n        \"viewpoint\": \"A\",\n        \"enclosure\": \"vpoc\",\n        \"enclosureLabel\": \"Visually open, physically closed\"\n       },\n       {\n        \"id\": \"A3\",\n        \"file\": \"A3_vpco.jpg\",\n        \"viewpoint\": \"A\",\n        \"enclosure\": \"vpco\",\n        \"enclosureLabel\": \"Visually closed, physically open\"\n       },\n       {\n        \"id\": \"A4\",\n        \"file\": \"A4_vpcc.jpg\",\n        \"viewpoint\": \"A\",\n        \"enclosure\": \"vpcc\",\n        \"enclosureLabel\": \"Visually closed, physically closed\"\n       },\n       {\n        \"id\": \"B1\",\n        \"file\": \"B1_vpoo.jpg\",\n        \"viewpoint\": \"B\",\n        \"enclosure\": \"vpoo\",\n        \"enclosureLabel\": \"Visually open, physically open\"\n       },\n       {\n        \"id\": \"B2\",\n        \"file\": \"B2_vpoc.jpg\",\n        \"viewpoint\": \"B\",\n        \"enclosure\": \"vpoc\",\n        \"enclosureLabel\": \"Visually open, physically closed\"\n       },\n       {\n        \"id\": \"B3\",\n        \"file\": \"B3_vpco.jpg\",\n        \"viewpoint\": \"B\",\n        \"enclosure\": \"vpco\",\n        \"enclosureLabel\": \"Visually closed, physically open\"\n       },\n       {\n        \"id\": \"B4\",\n        \"file\": \"B4_vpcc.jpg\",\n        \"viewpoint\": \"B\",\n        \"enclosure\": \"vpcc\",\n        \"enclosureLabel\": \"Visually closed, physically closed\"\n       },\n       {\n        \"id\": \"C1\",\n        \"file\": \"C1_vpoo.jpg\",\n        \"viewpoint\": \"C\",\n        \"enclosure\": \"vpoo\",\n        \"enclosureLabel\": \"Visually open, physically open\"\n       },\n       {\n        \"id\": \"C2\",\n        \"file\": \"C2_vpoc.jpg\",\n        \"viewpoint\": \"C\",\n        \"enclosure\": \"vpoc\",\n        \"enclosureLabel\": \"Visually open, physically closed\"\n       },\n       {\n        \"id\": \"C3\",\n        \"file\": \"C3_vpco.jpg\",\n        \"viewpoint\": \"C\",\n        \"enclosure\": \"vpco\",\n        \"enclosureLabel\": \"Visually closed, physically open\"\n       },\n       {\n        \"id\": \"C4\",\n        \"file\": \"C4_vpcc.jpg\",\n        \"viewpoint\": \"C\",\n        \"enclosure\": \"vpcc\",\n        \"enclosureLabel\": \"Visually closed, physically closed\"\n       },\n       {\n        \"id\": \"D1\",\n        \"file\": \"D1_vpoo.jpg\",\n        \"viewpoint\": \"D\",\n        \"enclosure\": \"vpoo\",\n        \"enclosureLabel\": \"Visually open, physically open\"\n       },\n       {\n        \"id\": \"D2\",\n        \"file\": \"D2_vpoc.jpg\",\n        \"viewpoint\": \"D\",\n        \"enclosure\": \"vpoc\",\n        \"enclosureLabel\": \"Visually open, physically closed\"\n       },\n       {\n        \"id\": \"D3\",\n        \"file\": \"D3_vpco.jpg\",\n        \"viewpoint\": \"D\",\n        \"enclosure\": \"vpco\",\n        \"enclosureLabel\": \"Visually closed, physically open\"\n       },\n       {\n        \"id\": \"D4\",\n        \"file\": \"D4_vpcc.jpg\",\n        \"viewpoint\": \"D\",\n        \"enclosure\": \"vpcc\",\n        \"enclosureLabel\": \"Visually closed, physically closed\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#edf2ee;--card:#fff;--ink:#1e2420;--muted:#5a645d;--accent:#2b6b50;--accent-ink:#fff;--line:#d2dbd5;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q:first-child{margin-top:0}.q>b{display:block;margin-bottom:6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem;font-variant-numeric:tabular-nums}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.pic{background:#e2e7e3;border-radius:12px;overflow:hidden}.pic img{width:100%;max-height:min(48vh,460px);object-fit:contain;display:block}\n.seg{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px}\n.seg label{display:block;cursor:pointer;position:relative}\n.seg input{position:absolute;opacity:0;pointer-events:none}\n.seg span{display:flex;align-items:center;justify-content:center;text-align:center;min-height:44px;padding:4px;border:1px solid var(--line);border-radius:8px;font-size:.85rem;font-weight:600;line-height:1.2}\n.seg input:checked+span{background:var(--accent);border-color:var(--accent);color:#fff}\n.seg input:focus-visible+span{outline:2px solid var(--accent);outline-offset:2px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:480px){.seg span{font-size:.68rem;hyphens:auto;overflow-wrap:anywhere}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Scenes: Liu &amp; Schroth (2019), Sustainability 11:1809, Figure 3, doi:10.3390/su11061809 (CC BY 4.0; Rhinoceros 3D + Xfrog plant models composited with park photographs). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='litchi2019:';\n  var app=document.getElementById('app'), Q={}, files={}, done={}, SPEC=null, TR=[], ITEMS=[], steps=[];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function q(n){return Q[n]||{};}\n  function page(html,btn,cb){\n    app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn||'Continue')+'</button></div><div class=\"err\"></div>';\n    document.getElementById('go').onclick=cb;app.onchange=hideErr;\n  }\n  function next(){\n    window.scrollTo(0,0);\n    if(!done.intro)return intro();\n    for(var i=0;i<steps.length;i++)if(!done[steps[i].id])return group(steps[i]);\n    for(var k=0;k<TR.length;k++)if(!done[TR[k].id])return scene(TR[k],k);\n    finish();\n  }\n  function intro(){\n    var miss=TR.some(function(t){return !files[t.file];});\n    if(miss){app.innerHTML='<h1>Pictures missing</h1><p>Media folder scenes must hold the 16 images A1_vpoo.jpg … D4_vpcc.jpg.</p>';return;}\n    page('<h1>Aesthetic preferences in urban parks</h1><p>This questionnaire explores how people perceive different degrees of enclosure created by vegetation in Chinese urban parks. It has three parts: basic demographic information, your use of urban parks, and aesthetic preferences, where you will look at pictures of four park scenes (A, B, C, D) and answer three questions about each picture.</p><p>It takes about 15 minutes. Please answer all questions with your first impressions.</p>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      var b=this;b.disabled=true;SPSite.answer('consent',true).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}done.intro=true;next();});\n    });\n  }\n  function group(s){\n    var h=s.names.map(function(n){var d=q(n),m=d.type==='checkbox';return '<div class=\"q\"><b>'+esc(d.title)+'</b>'+d.choices.map(function(c){return '<label class=\"opt\"><input type=\"'+(m?'checkbox':'radio')+'\" name=\"'+n+'\" value=\"'+c.value+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('');\n    page('<h1>'+esc(s.title)+'</h1><div class=\"card\">'+h+'</div>','Continue',function(){\n      var l=[];for(var i=0;i<s.names.length;i++){var n=s.names[i],xs=[].slice.call(app.querySelectorAll('input[name=\"'+n+'\"]:checked')).map(function(x){return Number(x.value);});if(!xs.length)return err('Please answer: '+q(n).title);l.push([n,q(n).type==='checkbox'?xs:xs[0]]);}\n      var b=this;b.disabled=true;\n      Promise.all(l.map(function(a){return SPSite.answer(a[0],a[1]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}done[s.id]=true;next();});\n    });\n  }\n  function scene(t,k){\n    var f=files[t.file],lab='Scene '+t.viewpoint+'-'+t.id.slice(1);\n    var rows=ITEMS.map(function(it){return '<div class=\"q\"><b>['+esc(lab)+'] '+esc(it.title)+'</b><div class=\"seg\" role=\"radiogroup\" aria-label=\"'+esc(it.name)+'\">'+it.labels.map(function(l,i){return '<label><input type=\"radio\" name=\"'+it.name+'\" value=\"'+(i+1)+'\"><span>'+esc(l)+'</span></label>';}).join('')+'</div></div>';}).join('');\n    page('<div class=\"top\"><span class=\"t\">Picture '+(k+1)+' of '+TR.length+'</span><div class=\"bar\"><i style=\"width:'+(100*k/TR.length)+'%\"></i></div></div><div class=\"card\"><div class=\"pic\"><img alt=\"'+esc(lab)+'\" src=\"'+esc(f.url)+'\"></div>'+rows+'</div>',k===TR.length-1?'Finish':'Next picture',function(){\n      var v={};for(var i=0;i<ITEMS.length;i++){var x=app.querySelector('input[name=\"'+ITEMS[i].name+'\"]:checked');if(!x)return err('Please answer all three questions.');v[ITEMS[i].name]=Number(x.value);}\n      var b=this;b.disabled=true;\n      SPSite.answer('enclosure_preference',v,{key:t.id,shown:[f.name]}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}done[t.id]=true;next();});\n    });\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>The 16 pictures showed four viewpoints in Litchi Park, Shenzhen, each simulated with four kinds of planting: visually and physically open; visually open but physically closed (knee-high shrubs); visually closed but physically open (tree canopies with walkable trunks); and visually and physically closed. In the original study (188 valid responses), enclosed scenes, visually or physically, were judged less legible than open ones; when the view was blocked, physically open scenes felt more pleasant than physically closed ones; and physical enclosure had by far the strongest effect on whether a scene seemed suitable for many functions.</p><p style=\"font-size:.82rem\">Liu, M., &amp; Schroth, O. (2019). Assessment of Aesthetic Preferences in Relation to Vegetation-Created Enclosure in Chinese Urban Parks: A Case Study of Shenzhen Litchi Park. Sustainability 11:1809, doi:10.3390/su11061809.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')done.intro=false;else if(x==='enclosure_preference')TR.forEach(function(t){done[t.id]=false;});else steps.forEach(function(s){if(s.names.indexOf(x)>=0)done[s.id]=false;});});next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){\n      p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={type:e.type,title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='enclosure_preference'){TR=e.trials;ITEMS=e.items;}});\n      if(p.name==='demographic'||p.name==='use')steps.push({id:p.name,title:p.title,names:p.elements.map(function(e){return e.name;})});\n    });\n    (SPSite.getMedia('scenes')||[]).forEach(function(f){files[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};\n    done.intro=a.consent===true;\n    steps.forEach(function(s){done[s.id]=s.names.every(function(n){return a[n]!=null;});});\n    ((a.enclosure_preference&&a.enclosure_preference.trials)||[]).forEach(function(t){if(t.key)done[t.key]=true;});\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
