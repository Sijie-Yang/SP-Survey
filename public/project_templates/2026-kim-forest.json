   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Forest in Two Seasons</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Forest Healing Landscape in Summer and Autumn\",\n  \"description\": \"Each participant views the same forest-and-pond landscape photographed in summer and in autumn (random order), 30 seconds each with a 3-minute rest between, and rates the 11-item Perceived Restorativeness Scale (PRS-11, 1–5) after each. Rebuilt from Kim (2026), IJERPH 23(4): 425, with the paper's two photographs (Figure 1, CC BY 4.0).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"season\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"Age\",\n      \"description\": \"The paper's participants were 40–70 years old.\",\n      \"isRequired\": true,\n      \"min\": 16,\n      \"max\": 99\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Sex\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"first_season\",\n      \"title\": \"Season shown first (set by the page)\",\n      \"description\": \"Counterbalanced random order, as in the paper.\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"summer\",\n        \"text\": \"Summer first\"\n       },\n       {\n        \"value\": \"autumn\",\n        \"text\": \"Autumn first\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"ratings\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_ba1\",\n      \"title\": \"Places like that are a refuge from nuisances.\",\n      \"description\": \"Being away (PRS-11, Pasini et al. 2014; wording as printed in IJERPH 20:6354). Keyed by season (summer / autumn).\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_ba2\",\n      \"title\": \"To get away from things that usually demand my attention I like to go to places like that.\",\n      \"description\": \"Being away (PRS-11, Pasini et al. 2014; wording as printed in IJERPH 20:6354). Keyed by season (summer / autumn).\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_ba3\",\n      \"title\": \"To stop thinking about the things that I must get done I like to go to places like that.\",\n      \"description\": \"Being away (PRS-11, Pasini et al. 2014; wording as printed in IJERPH 20:6354). Keyed by season (summer / autumn).\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_fa1\",\n      \"title\": \"Places like that are fascinating.\",\n      \"description\": \"Fascination (PRS-11, Pasini et al. 2014; wording as printed in IJERPH 20:6354). Keyed by season (summer / autumn).\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_fa2\",\n      \"title\": \"In places like that my attention is drawn to many interesting things.\",\n      \"description\": \"Fascination (PRS-11, Pasini et al. 2014; wording as printed in IJERPH 20:6354). Keyed by season (summer / autumn).\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_fa3\",\n      \"title\": \"In places like that it is hard to be bored.\",\n      \"description\": \"Fascination (PRS-11, Pasini et al. 2014; wording as printed in IJERPH 20:6354). Keyed by season (summer / autumn).\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_co1\",\n      \"title\": \"There is a clear order in the physical arrangement of places like that.\",\n      \"description\": \"Coherence (PRS-11, Pasini et al. 2014; wording as printed in IJERPH 20:6354). Keyed by season (summer / autumn).\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_co2\",\n      \"title\": \"In places like that it is easy to see how things are organised.\",\n      \"description\": \"Coherence (PRS-11, Pasini et al. 2014; wording as printed in IJERPH 20:6354). Keyed by season (summer / autumn).\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_co3\",\n      \"title\": \"In places like that everything seems to have its proper place.\",\n      \"description\": \"Coherence (PRS-11, Pasini et al. 2014; wording as printed in IJERPH 20:6354). Keyed by season (summer / autumn).\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_sc1\",\n      \"title\": \"That place is large enough to allow exploration in many directions.\",\n      \"description\": \"Scope (PRS-11, Pasini et al. 2014; wording as printed in IJERPH 20:6354). Keyed by season (summer / autumn).\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"prs_sc2\",\n      \"title\": \"In places like that there are few boundaries to limit my possibility for moving about.\",\n      \"description\": \"Scope (PRS-11, Pasini et al. 2014; wording as printed in IJERPH 20:6354). Keyed by season (summer / autumn).\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Strongly disagree\",\n      \"maxRateDescription\": \"Strongly agree\",\n      \"isRequired\": true\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"forest-original\">{\"source\": \"Kim (2026) IJERPH 23(4):425, Table 3 (estimated marginal means \\u00b1 SE, 1\\u20135)\", \"n\": 40, \"prs\": {\"summer\": {\"male\": [3.759, 0.142], \"female\": [4.195, 0.142]}, \"autumn\": {\"male\": [4.032, 0.181], \"female\": [4.277, 0.181]}}, \"note\": \"No significant season or sex effect on PRS; semantic-differential impressions (not included here) were higher in autumn and for women.\"}</script>\n<style>\n:root{--bg:#f3f6f2;--card:#fff;--ink:#1f2a22;--muted:#5f6d63;--accent:#2f7d4f;--line:#dce5dd;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.1rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.view{background:#000;border-radius:12px;overflow:hidden;aspect-ratio:3/2;display:flex;align-items:center;justify-content:center}\n.view img{width:100%;height:100%;object-fit:contain;display:block}\n.thumb{max-width:520px;margin:0 auto}\n.timer{height:4px;background:var(--line);border-radius:2px;overflow:hidden;margin-top:8px}.timer>i{display:block;height:100%;background:var(--accent);width:0}\n.big{font-size:2.4rem;font-weight:700;text-align:center;margin:18px 0;color:var(--ink)}\n.item{padding:12px 0;border-top:1px solid var(--line)}.item:first-child{border-top:0}\n.item .t{margin-bottom:8px}\n.scale{display:grid;gap:6px}\n.scale button{appearance:none;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:8px;padding:9px 0;font:inherit;font-weight:600;cursor:pointer}\n.scale button.on{background:var(--accent);border-color:var(--accent);color:#fff}\n.item.miss .t{color:var(--warn)}\n.anch{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin:4px 0 6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Kim (2026), Int. J. Environ. Res. Public Health 23(4): 425, Figure 1, CC BY 4.0.</footer>\n<script>\n(function(){\n  var F=window.__VIEWMS, VIEW_MS=F||30000, REST_MS=F||180000, KEY='forest-seasons:state';\n  var ITEMS=['prs_ba1','prs_ba2','prs_ba3','prs_fa1','prs_fa2','prs_fa3','prs_co1','prs_co2','prs_co3','prs_sc1','prs_sc2'];\n  var app=document.getElementById('app'), Q={}, files=[], st=null, tm=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function id(n){return n.replace(/\\.[^.]+$/,'');}\n  function byId(i){for(var k=0;k<files.length;k++)if(id(files[k].name)===i)return files[k];return null;}\n  function radio(n){var q=Q[n];return '<div class=\"f\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function intro(){\n    app.innerHTML='<h1>A forest landscape</h1><p>You will see two photographs, each for 30 seconds. Look at each one freely and imagine being there. After each photo you answer 11 short statements. Between the photos there is a 3-minute rest. Please use a large screen in a quiet place. About 10 minutes.</p>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div class=\"f\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"16\" max=\"99\"></div>'+radio('gender')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var age=Number(document.getElementById('age').value);if(!(age>=16&&age<=99))return err('Please enter your age.');\n      var g=app.querySelector('input[name=gender]:checked');if(!g)return err('Please answer: '+Q.gender.title);\n      var b=this;b.disabled=true;\n      Promise.all([SPSite.answer('consent',true),SPSite.answer('age',age),SPSite.answer('gender',g.value),SPSite.answer('first_season',st.order[0])]).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}st.step='ready';st.k=0;save();route();});\n    };\n  }\n  function ready(){\n    app.innerHTML='<h2>Photo '+(st.k+1)+' of 2</h2><div class=\"card\"><p>The photograph stays on screen for 30 seconds. Look at it freely.</p><button class=\"btn\" id=\"go\">Show the photo</button></div>';\n    document.getElementById('go').onclick=function(){st.step='view';save();route();};\n  }\n  function view(){\n    var f=byId(st.order[st.k]);\n    app.innerHTML='<p>Photo '+(st.k+1)+' of 2</p><div class=\"view\"><img alt=\"Forest landscape photograph\" src=\"'+esc(f.url)+'\"></div><div class=\"timer\"><i id=\"tb\"></i></div>';\n    var tb=document.getElementById('tb');tb.style.transition='width '+(VIEW_MS/1000)+'s linear';requestAnimationFrame(function(){requestAnimationFrame(function(){tb.style.width='100%';});});\n    tm=setTimeout(function(){st.step='rate';save();route();},VIEW_MS);\n  }\n  function rate(){\n    var f=byId(st.order[st.k]),vals={};\n    app.innerHTML='<h2>About the place you just saw</h2><p>How much do you agree with each statement?</p><div class=\"card\">'+\n      ITEMS.map(function(k){var q=Q[k],b='';for(var v=1;v<=5;v++)b+='<button type=\"button\" data-v=\"'+v+'\" aria-label=\"'+v+'\">'+v+'</button>';\n        return '<div class=\"item\" data-k=\"'+k+'\"><div class=\"t\">'+esc(q.title)+'</div><div class=\"scale\" style=\"grid-template-columns:repeat(5,1fr)\">'+b+'</div><div class=\"anch\"><span>1 = '+esc(q.minRateDescription)+'</span><span>5 = '+esc(q.maxRateDescription)+'</span></div></div>';}).join('')+\n      '<div style=\"margin-top:12px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    window.scrollTo(0,0);\n    app.querySelectorAll('.item').forEach(function(it){it.querySelectorAll('button').forEach(function(b){b.onclick=function(){vals[it.dataset.k]=Number(b.dataset.v);it.classList.remove('miss');it.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b);});};});});\n    document.getElementById('go').onclick=function(){\n      var miss=ITEMS.filter(function(k){return vals[k]==null;});\n      if(miss.length){miss.forEach(function(k){app.querySelector('.item[data-k=\"'+k+'\"]').classList.add('miss');});return err('Please answer every statement ('+miss.length+' missing, marked).');}\n      var b=this;b.disabled=true;var key=st.order[st.k];\n      Promise.all(ITEMS.map(function(k){return SPSite.answer(k,vals[k],{key:key,shown:[f.name]});})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}\n        st.k++;st.step=st.k>=st.order.length?'done':'rest';save();route();});\n    };\n  }\n  function rest(){\n    app.innerHTML='<h2>Rest</h2><div class=\"card\"><p>Please rest for three minutes before the second photo. Look away from the screen if you like.</p><div class=\"big\" id=\"cd\"></div><button class=\"btn\" id=\"go\" disabled>Continue</button></div>';\n    var go=document.getElementById('go'),end=Date.now()+REST_MS;go.onclick=function(){st.step='ready';save();route();};\n    function tick(){var s=Math.max(0,Math.ceil((end-Date.now())/1000));document.getElementById('cd').textContent=Math.floor(s/60)+':'+('0'+(s%60)).slice(-2);if(s<=0){clearInterval(tm);go.disabled=false;}}\n    tick();tm=setInterval(tick,F?10:250);\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';st.k=0;save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){clearInterval(tm);clearTimeout(tm);var s=st.step;if(s==='ready')return ready();if(s==='view')return view();if(s==='rate')return rate();if(s==='rest')return rest();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','first_season'].concat(ITEMS).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    files=(SPSite.getMedia('season')||[]).filter(function(f){return /\\.(jpe?g|png|webp)$/i.test(f.name);});\n    if(!byId('summer')||!byId('autumn')){app.innerHTML='<h1>Photos missing</h1><p>Upload summer.jpg and autumn.jpg to the media folder \"season\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!st||!st.order)st={step:'intro',order:Math.random()<0.5?['summer','autumn']:['autumn','summer'],k:0};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    if(st.step==='view')st.step='ready';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
