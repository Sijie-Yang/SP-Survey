   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Wooden Office Spaces</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Wooden Office Furniture: Colour, Coverage and Aesthetic Evaluation\",\n  \"description\": \"Faithful replication with the original videos and scene pictures: each participant is randomly assigned to one of six office spaces that differ only in their wooden furniture, 3 wood colours (light #ECCD97, medium #ECB36C, dark #95582C) x 2 wood coverages (low 12%, high 35%). They watch a 35 s walk-through video of that office, then spend 1 minute imagining themselves working and talking with others there while looking at four pictures of it from different angles, and then rate it: sensory evaluation ('What do you think of the office environment?', 10 adjectives: bright, spacious, organized, relaxing, natural, harmonious, vivid, comfortable, beautiful, attractive), satisfaction (2 items) and usage willingness (2 items), all on 7-point scales. Demographics follow. Rebuilt from Zhu, Wang & Zhao (2022), Wood in office spaces: The impact of different wooden furniture on aesthetic evaluation, Frontiers in Psychology 13: 986627, with its Supplementary Videos 1-6 (rendered in Lumion) and scene pictures (Supplementary Image 1 and Figures 7-11), CC BY 4.0. Media ids: <colour>_<coverage>.mp4 and <colour>_<coverage>_scenes.jpg; 'condition' records the assignment. Analysis as in the paper: 3 x 2 between-subjects ANOVA (or Kruskal-Wallis / Mann-Whitney) on the mean of each scale; the paper found light and medium wood rated above dark and low coverage above high, with medium-low best on sensory evaluation (5.70) and dark-high lowest on all three. Differences from the original study: (1) the paper's opening PANAS mood measure (Qiu et al. 2008 Chinese revision, 18 adjectives, used as a covariate) is left out because its items are not printed in the paper; (2) the scale anchor labels are ours (the paper says only '7-point scale'); English item wording from the paper, which ran in Chinese on questionnaire.com; (3) videos are re-encoded to 960 x 540 to fit the upload limit; (4) the paper's analysed ratings were per-scale means; the platform stores each item; demographic wording is ours, after the paper's participant description.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"offices\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"condition\",\n      \"title\": \"Assigned office (wood colour and coverage)\",\n      \"description\": \"Set at random by the page.\",\n      \"choices\": [\n       {\n        \"value\": \"light_low\",\n        \"text\": \"light / low\"\n       },\n       {\n        \"value\": \"light_high\",\n        \"text\": \"light / high\"\n       },\n       {\n        \"value\": \"medium_low\",\n        \"text\": \"medium / low\"\n       },\n       {\n        \"value\": \"medium_high\",\n        \"text\": \"medium / high\"\n       },\n       {\n        \"value\": \"dark_low\",\n        \"text\": \"dark / low\"\n       },\n       {\n        \"value\": \"dark_high\",\n        \"text\": \"dark / high\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"office\",\n    \"elements\": [\n     {\n      \"type\": \"matrix\",\n      \"name\": \"sensory\",\n      \"title\": \"What do you think of the office environment?\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"bright\",\n        \"text\": \"Bright\"\n       },\n       {\n        \"value\": \"spacious\",\n        \"text\": \"Spacious\"\n       },\n       {\n        \"value\": \"organized\",\n        \"text\": \"Organized\"\n       },\n       {\n        \"value\": \"relaxing\",\n        \"text\": \"Relaxing\"\n       },\n       {\n        \"value\": \"natural\",\n        \"text\": \"Natural\"\n       },\n       {\n        \"value\": \"harmonious\",\n        \"text\": \"Harmonious\"\n       },\n       {\n        \"value\": \"vivid\",\n        \"text\": \"Vivid\"\n       },\n       {\n        \"value\": \"comfortable\",\n        \"text\": \"Comfortable\"\n       },\n       {\n        \"value\": \"beautiful\",\n        \"text\": \"Beautiful\"\n       },\n       {\n        \"value\": \"attractive\",\n        \"text\": \"Attractive\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"6\"\n       },\n       {\n        \"value\": 7,\n        \"text\": \"7\"\n       }\n      ],\n      \"description\": \"Sensory evaluation, 10 adjectives from the paper, 1 = not at all, 7 = very much (anchors ours). Keyed by condition.\"\n     },\n     {\n      \"type\": \"matrix\",\n      \"name\": \"satisfaction\",\n      \"title\": \"Satisfaction\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"sat1\",\n        \"text\": \"How satisfied are you with your office environment?\"\n       },\n       {\n        \"value\": \"sat2\",\n        \"text\": \"If you worked here, to what extent does this wooden furniture meet your demands for an office environment?\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"6\"\n       },\n       {\n        \"value\": 7,\n        \"text\": \"7\"\n       }\n      ],\n      \"description\": \"Paper's two satisfaction items, 1-7. Keyed by condition.\"\n     },\n     {\n      \"type\": \"matrix\",\n      \"name\": \"willingness\",\n      \"title\": \"Usage willingness\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"will1\",\n        \"text\": \"How much do you like to work here?\"\n       },\n       {\n        \"value\": \"will2\",\n        \"text\": \"How willing are you to work here?\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"6\"\n       },\n       {\n        \"value\": 7,\n        \"text\": \"7\"\n       }\n      ],\n      \"description\": \"Paper's two usage-willingness items, 1-7. Keyed by condition.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 16,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Highest education\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"college_or_below\",\n        \"text\": \"College degree or below\"\n       },\n       {\n        \"value\": \"bachelor\",\n        \"text\": \"Bachelor's degree\"\n       },\n       {\n        \"value\": \"master\",\n        \"text\": \"Master's degree\"\n       },\n       {\n        \"value\": \"doctoral\",\n        \"text\": \"Doctoral degree\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"indoor_hours\",\n      \"title\": \"On a typical day, how many hours do you work or study indoors?\",\n      \"isRequired\": true,\n      \"min\": 0,\n      \"max\": 24\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"work_years\",\n      \"title\": \"How many years of work experience do you have?\",\n      \"isRequired\": true,\n      \"min\": 0,\n      \"max\": 70\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"wood-office-original\">{\"source\": \"Zhu, Wang & Zhao (2022) Frontiers in Psychology 13: 986627\", \"n\": 185, \"participants\": \"185 adults online in China, 18-57 (mean 28.37), 78 men / 107 women; indoors 7.77 h/day; paid 10 RMB\", \"per_condition\": {\"light_low\": {\"n\": 34, \"sensory\": {\"M\": 5.43, \"SD\": 0.8}, \"satisfaction\": {\"M\": 5.87, \"SD\": 1.07}, \"willingness\": {\"M\": 5.78, \"SD\": 1.19}}, \"light_high\": {\"n\": 31, \"sensory\": {\"M\": 5.24, \"SD\": 1.0}, \"satisfaction\": {\"M\": 5.31, \"SD\": 1.42}, \"willingness\": {\"M\": 5.16, \"SD\": 1.58}}, \"medium_low\": {\"n\": 32, \"sensory\": {\"M\": 5.7, \"SD\": 0.79}, \"satisfaction\": {\"M\": 5.83, \"SD\": 1.02}, \"willingness\": {\"M\": 5.69, \"SD\": 1.25}}, \"medium_high\": {\"n\": 31, \"sensory\": {\"M\": 4.97, \"SD\": 0.9}, \"satisfaction\": {\"M\": 5.11, \"SD\": 1.3}, \"willingness\": {\"M\": 5.02, \"SD\": 1.31}}, \"dark_low\": {\"n\": 28, \"sensory\": {\"M\": 5.04, \"SD\": 1.19}, \"satisfaction\": {\"M\": 5.21, \"SD\": 1.09}, \"willingness\": {\"M\": 4.83, \"SD\": 1.48}}, \"dark_high\": {\"n\": 29, \"sensory\": {\"M\": 4.38, \"SD\": 1.19}, \"satisfaction\": {\"M\": 4.55, \"SD\": 1.44}, \"willingness\": {\"M\": 4.34, \"SD\": 1.54}}}, \"alpha\": {\"sensory\": 0.93, \"satisfaction\": 0.88, \"willingness\": 0.87}, \"sensory_wood_color_F\": 6.95}</script>\n<style>\n:root{--bg:#f2efea;--card:#fff;--ink:#1b231d;--muted:#58635a;--accent:#8a5a2b;--line:#d5ded6;--warn:#b3261e;--sel:#f2e6d8}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.view{position:fixed;inset:0;background:#111;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:5;gap:12px}\n.view video{width:100vw;max-height:88vh;display:block;background:#000}\n.view img{width:100vw;height:auto;max-height:90vh;object-fit:contain;display:block}\n.view .t{color:#aaa;font-size:.85rem}\n.pano{position:sticky;top:0;z-index:2;background:var(--bg);padding:6px 0}\n.pano img{width:100%;display:block;border-radius:8px}\n.scn{width:100%;display:block;border-radius:10px;margin-top:10px}\n.pano{max-width:420px}\n.mx{margin-top:18px}\n.mx h3{font-size:1rem;margin:0 0 2px}\n.it{padding:8px 0;border-top:1px solid var(--line)}\n.it .q{font-size:.95rem;margin-bottom:4px}\n.it .o{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}\n.it label{display:flex;flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:8px;padding:3px 0;cursor:pointer;font-size:.8rem;color:var(--muted)}\n.it label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.it input{margin:0 0 1px}\n.it.miss .o{outline:2px solid var(--warn);outline-offset:2px;border-radius:8px}\n.legend{display:flex;justify-content:space-between;gap:4px;font-size:.72rem;color:var(--muted);text-align:center;margin-top:4px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}.f:first-child{margin-top:0}\ninput[type=number],input[type=text]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px}\ninput[type=number]{width:110px}input[type=text]{width:min(100%,320px)}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Videos and pictures: Zhu, Wang &amp; Zhao (2022), Frontiers in Psychology 13: 986627, Supplementary Videos 1–6, Image 1 and Figures 7–11 (doi:10.3389/fpsyg.2022.986627, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='wood-office:state', T={video:window.__VIEWMS||0,imag:window.__VIEWMS||60000};\n  var CONDS=['light_low','light_high','medium_low','medium_high','dark_low','dark_high'], SC=['sensory','satisfaction','willingness'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function num(id,q,min,max){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b><br><input type=\"number\" id=\"'+id+'\" min=\"'+min+'\" max=\"'+max+'\"></div>';}\n  function intro(){\n    app.innerHTML='<h1>Office spaces</h1><p>You will watch a 35-second video of an office (please turn your sound on). Then you will spend one minute imagining that you work in this office, looking at four pictures of it, and afterwards answer a few questions about it. It takes about 5 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start the video</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true),SPSite.answer('condition',st.cond)],this,function(){st.step='video';save();route();});};\n  }\n  function video(){\n    var f=files[st.cond],v=document.createElement('div');v.className='view';app.innerHTML='';app.appendChild(v);\n    v.innerHTML='<video playsinline preload=\"auto\" src=\"'+esc(f.url)+'\"></video><div class=\"t\" id=\"tm\">Video</div><button class=\"btn\" id=\"pl\" style=\"display:none\">Play the video</button>';\n    var vid=v.querySelector('video'),pl=document.getElementById('pl'),done=false;\n    function next(){if(done)return;done=true;try{vid.pause();}catch(e){}st.step='imagine';st.until=Date.now()+T.imag;save();route();}\n    vid.addEventListener('ended',next);\n    vid.addEventListener('error',function(){var tm=document.getElementById('tm');if(tm)tm.textContent='The video could not be played in this browser.';pl.textContent='Continue';pl.style.display='';pl.onclick=next;});\n    vid.addEventListener('timeupdate',function(){var tm=document.getElementById('tm');if(tm&&vid.duration)tm.textContent=Math.max(0,Math.ceil(vid.duration-vid.currentTime))+' s';});\n    var p=vid.play();if(p&&p.catch)p.catch(function(){pl.style.display='';});\n    pl.onclick=function(){pl.style.display='none';vid.play();};\n    if(T.video)setTimeout(next,T.video);\n  }\n  function imagine(){\n    var f=files[st.cond+'_scenes'];\n    app.innerHTML='<h2>Imagine working here</h2><div class=\"card\"><p style=\"color:var(--ink)\">Spend one minute imagining yourself working and talking with colleagues in the office you just saw. These pictures show it from different angles.</p><img class=\"scn\" alt=\"Four views of the office\" src=\"'+esc(f.url)+'\"><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\" disabled>Continue</button> <span class=\"t\" id=\"tm\" style=\"color:var(--muted);margin-left:8px\"></span></div><div class=\"err\"></div></div>';\n    var b=document.getElementById('go'),tm=document.getElementById('tm');\n    (function tick(){if(!document.body.contains(b))return;var s=Math.ceil(((st.until||0)-Date.now())/1000);if(s<=0){b.disabled=false;tm.textContent='';return;}tm.textContent=s+' s';setTimeout(tick,250);})();\n    b.onclick=function(){st.step='rate';save();route();};\n  }\n  function block(n){var q=Q[n];return '<div class=\"mx\"><h3>'+esc(q.title)+'</h3><div class=\"legend\"><span>1 = not at all</span><span>7 = very much</span></div>'+(q.rows||[]).map(function(r){var nm=n+'__'+r.value;return '<div class=\"it\" data-n=\"'+nm+'\"><div class=\"q\">'+esc(r.text)+'</div><div class=\"o\">'+(q.columns||[]).map(function(c){return '<label><input type=\"radio\" name=\"'+nm+'\" value=\"'+c.value+'\">'+c.value+'</label>';}).join('')+'</div></div>';}).join('')+'</div>';}\n  function rate(){\n    var f=files[st.cond+'_scenes'];\n    app.innerHTML='<div class=\"pano\"><img alt=\"The office\" src=\"'+esc(f.url)+'\"></div><div class=\"card\"><p style=\"color:var(--ink);margin:0\">Please rate the office you just saw.</p>'+SC.map(block).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var out={},miss=0,first=null;\n      SC.forEach(function(n){out[n]={};(Q[n].rows||[]).forEach(function(r){var nm=n+'__'+r.value,x=val(nm),el=app.querySelector('.it[data-n=\"'+nm+'\"]');if(x==null){miss++;el.classList.add('miss');if(!first)first=el;}else out[n][r.value]=Number(x);});});\n      if(miss){if(first)first.scrollIntoView({block:'center'});return err('Please answer every item ('+miss+' missing).');}\n      var shown=[files[st.cond].name,f.name];\n      send(SC.map(function(n){return SPSite.answer(n,out[n],{key:st.cond,shown:shown});}),this,function(){st.step='about';save();route();});\n    };\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+num('age','age',16,110)+radios('gender')+radios('education')+num('hrs','indoor_hours',0,24)+num('yrs','work_years',0,70)+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var g=val('gender'),ed=val('education'),age=Number(document.getElementById('age').value),h=document.getElementById('hrs').value,y=document.getElementById('yrs').value;\n      if(!(age>=16&&age<=110))return err('Please enter your age.');if(!g||!ed)return err('Please answer every question.');\n      if(h===''||+h<0||+h>24)return err('Please enter your indoor hours (0-24).');if(y===''||+y<0||+y>70)return err('Please enter your years of work experience.');\n      send([SPSite.answer('age',age),SPSite.answer('gender',g),SPSite.answer('education',ed),SPSite.answer('indoor_hours',Number(h)),SPSite.answer('work_years',Number(y))],this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var r=e.target.closest&&e.target.closest('.it');if(r)r.classList.remove('miss');});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='video')return video();if(s==='imagine')return imagine();if(s==='rate')return rate();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','condition','sensory','satisfaction','willingness','age','gender','education','indoor_hours','work_years'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('offices')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=[];CONDS.forEach(function(c){if(!files[c])need.push(c+'.mp4');if(!files[c+'_scenes'])need.push(c+'_scenes.jpg');});\n    if(need.length){app.innerHTML='<h1>Media missing</h1><p>Upload '+need.join(', ')+' to the media folder \"offices\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.cond)||a.consent!==true)st={step:'intro',cond:CONDS[Math.floor(Math.random()*CONDS.length)]};\n    if(st.step==='video'&&a.consent===true){}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
