   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Street Performance in Public Space</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Street Performance and Public Space Perception\",\n  \"description\": \"Faithful replication of Study 1 with the original images: participants first see all 12 public-space images of Hong Kong (transport facility, street, square, recreational space, found neighborhood space, park, memorial, market, playground, community open space, indoor marketplace, waterfront) without street performance, in random order. After a definition of street performance, each participant is randomly assigned one space type and sees its animated image, in which a guitar-playing busker and two passersby fade in and out, with the space type's definition and the paper's instruction to imagine using the place regularly. They then rate how much the street performance changes the place, from -3 (Much less) to +3 (Much more), on the paper's 13 items for visitability (4), restorativeness (5) and preference (4), mixed in random order with four instructed-response attention items. Gender and age follow. Rebuilt from Ho & Au (2021), Effect of Street Performance (Busking) on the Environmental Perception of Public Space, Frontiers in Psychology 12: 647863, with the 12 GIF images from its Supplementary Appendix A (CC BY 4.0; built on Ho & Au's 2020 public-space images) and the items from its Table 4. Media ids are the space types; 'space_type' records the assignment. Analysis as in the paper: composite change scores (visitability, restorativeness, preference), one-sample t-tests against 0 for all spaces and for each space type, keeping only participants who answer all four attention items correctly; the paper found busking raised all three (preference +0.78 overall), except at the memorial. Differences from the original study: (1) the paper did not print its question stem or its exact busking definition shown to participants; the stem is ours and the definition is the paper's own definition from its introduction; (2) the paper did not say which answers its four attention items asked for; ours ask for Much less, Slightly more, About the same and More; (3) the opening set of 12 images is shown as one page; (4) demographic questions are ours (the paper also asked location, education and class); Study 2 (on-site in Hong Kong) is not included.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"spaces\",\n   \"anchors\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"space_type\",\n      \"title\": \"Assigned public space type\",\n      \"description\": \"Set at random by the page.\",\n      \"choices\": [\n       {\n        \"value\": \"transport_facility\",\n        \"text\": \"Transport facility\"\n       },\n       {\n        \"value\": \"street\",\n        \"text\": \"Street\"\n       },\n       {\n        \"value\": \"square\",\n        \"text\": \"Square\"\n       },\n       {\n        \"value\": \"recreational_space\",\n        \"text\": \"Recreational space\"\n       },\n       {\n        \"value\": \"found_neighborhood_space\",\n        \"text\": \"Found neighborhood space\"\n       },\n       {\n        \"value\": \"park\",\n        \"text\": \"Park\"\n       },\n       {\n        \"value\": \"memorial\",\n        \"text\": \"Memorial\"\n       },\n       {\n        \"value\": \"market\",\n        \"text\": \"Market\"\n       },\n       {\n        \"value\": \"playground\",\n        \"text\": \"Playground\"\n       },\n       {\n        \"value\": \"community_open_space\",\n        \"text\": \"Community open space\"\n       },\n       {\n        \"value\": \"indoor_marketplace\",\n        \"text\": \"Indoor marketplace\"\n       },\n       {\n        \"value\": \"waterfront\",\n        \"text\": \"Waterfront\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"rating\",\n    \"elements\": [\n     {\n      \"type\": \"matrix\",\n      \"name\": \"change\",\n      \"title\": \"Compared with the same place without street performance, with the street performance present ...\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"v1\",\n        \"text\": \"I will stop at this place if I happen to be passing by.\"\n       },\n       {\n        \"value\": \"v2\",\n        \"text\": \"I will walk out of my way to visit and spend time in this place.\"\n       },\n       {\n        \"value\": \"v3\",\n        \"text\": \"I would regularly visit this place.\"\n       },\n       {\n        \"value\": \"v4\",\n        \"text\": \"This is a place where I would choose to meet a friend.\"\n       },\n       {\n        \"value\": \"r1\",\n        \"text\": \"In this place, I would be able to concentrate well.\"\n       },\n       {\n        \"value\": \"r2\",\n        \"text\": \"In this place, I would be able to focus on myself.\"\n       },\n       {\n        \"value\": \"r3\",\n        \"text\": \"In this place, I would be able to relax.\"\n       },\n       {\n        \"value\": \"r4\",\n        \"text\": \"In this place, I would be able to release all tension.\"\n       },\n       {\n        \"value\": \"r5\",\n        \"text\": \"In this place, my energy level would get renewed.\"\n       },\n       {\n        \"value\": \"p1\",\n        \"text\": \"I like this place a great deal.\"\n       },\n       {\n        \"value\": \"p2\",\n        \"text\": \"I like this place very much.\"\n       },\n       {\n        \"value\": \"p3\",\n        \"text\": \"I would enjoy this place a lot.\"\n       },\n       {\n        \"value\": \"p4\",\n        \"text\": \"I would really enjoy this place.\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": -3,\n        \"text\": \"Much less\"\n       },\n       {\n        \"value\": -2,\n        \"text\": \"Less\"\n       },\n       {\n        \"value\": -1,\n        \"text\": \"Slightly less\"\n       },\n       {\n        \"value\": 0,\n        \"text\": \"About the same\"\n       },\n       {\n        \"value\": 1,\n        \"text\": \"Slightly more\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"More\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Much more\"\n       }\n      ],\n      \"description\": \"Paper's Table 4: v = visitability, r = restorativeness, p = preference. -3 Much less, 0 About the same, +3 Much more. Keyed by space type.\"\n     },\n     {\n      \"type\": \"matrix\",\n      \"name\": \"attention\",\n      \"title\": \"Attention items\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"iri1\",\n        \"text\": \"For this statement, please select Much less.\"\n       },\n       {\n        \"value\": \"iri2\",\n        \"text\": \"For this statement, please select Slightly more.\"\n       },\n       {\n        \"value\": \"iri3\",\n        \"text\": \"For this statement, please select About the same.\"\n       },\n       {\n        \"value\": \"iri4\",\n        \"text\": \"For this statement, please select More.\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": -3,\n        \"text\": \"Much less\"\n       },\n       {\n        \"value\": -2,\n        \"text\": \"Less\"\n       },\n       {\n        \"value\": -1,\n        \"text\": \"Slightly less\"\n       },\n       {\n        \"value\": 0,\n        \"text\": \"About the same\"\n       },\n       {\n        \"value\": 1,\n        \"text\": \"Slightly more\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"More\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Much more\"\n       }\n      ],\n      \"description\": \"Instructed-response items (paper's wording); correct answers: iri1 -3, iri2 +1, iri3 0, iri4 +2. Shown mixed with the change items.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 16,\n      \"max\": 110\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"busking-original\">{\"source\": \"Ho & Au (2021) Frontiers in Psychology 12: 647863, Study 1\", \"n\": 748, \"recruited\": 852, \"participants\": \"MTurk, 357 women / 391 men, mean age 36.3; 75% North America; US$1.50\", \"definitions\": {\"transport_facility\": \"Public space for transport facilities such as transit stations or stops for subways or buses\", \"street\": \"Pedestrian and vehicular corridor where people move on foot\", \"square\": \"Multifunctional space available to all people\", \"recreational_space\": \"Specialized space designed or used for sports or exercises\", \"found_neighborhood_space\": \"Vacant or undeveloped space that is either ignored or not intended for a specific use\", \"park\": \"Green area intended for social activities\", \"memorial\": \"Space that memorializes people or important events\", \"market\": \"Outdoor or exterior space used for shopping\", \"playground\": \"Play area that includes play equipment (e.g., slides and swings)\", \"community_open_space\": \"Space designed, developed, or managed by local residents on vacant land\", \"indoor_marketplace\": \"Indoor shopping area\", \"waterfront\": \"Open space along waterways in cities\"}, \"busking_definition\": \"Street performance, or busking, refers to the act of performing or entertaining in a public space with the intention of seeking voluntary donations from passersby.\", \"imagine_prompt\": \"Imagine that you use this place or commute through it on a regular basis; that is, you encounter this place for your everyday activities, e.g., walking through this place to work or school, hanging out, meeting people, and shopping, etc.\", \"table5_mean_change\": {\"all\": {\"visitability\": 0.63, \"restorativeness\": 0.38, \"preference\": 0.78}, \"transport_facility\": {\"visitability\": 0.51, \"restorativeness\": 0.28, \"preference\": 0.78}, \"street\": {\"visitability\": 0.88, \"restorativeness\": 0.56, \"preference\": 1.06}, \"square\": {\"visitability\": 1.02, \"restorativeness\": 0.66, \"preference\": 1.09}, \"recreational_space\": {\"visitability\": 0.38, \"restorativeness\": 0.33, \"preference\": 0.52}, \"found_neighborhood_space\": {\"visitability\": 0.41, \"restorativeness\": 0.28, \"preference\": 0.48}, \"park\": {\"visitability\": 0.61, \"restorativeness\": 0.34, \"preference\": 0.73}, \"memorial\": {\"visitability\": -0.36, \"restorativeness\": -0.32, \"preference\": -0.3}, \"market\": {\"visitability\": 0.79, \"restorativeness\": 0.32, \"preference\": 0.91}, \"playground\": {\"visitability\": 0.7, \"restorativeness\": 0.45, \"preference\": 0.77}, \"community_open_space\": {\"visitability\": 0.97, \"restorativeness\": 0.57, \"preference\": 1.16}, \"indoor_marketplace\": {\"visitability\": 0.56, \"restorativeness\": 0.29, \"preference\": 0.9}, \"waterfront\": {\"visitability\": 1.09, \"restorativeness\": 0.67, \"preference\": 1.15}}, \"alpha\": {\"visitability\": 0.88, \"restorativeness\": 0.89, \"preference\": 0.93}}</script>\n<style>\n:root{--bg:#f0eff3;--card:#fff;--ink:#1f1e26;--muted:#5d5b68;--accent:#4b4a8c;--line:#dcdae4;--warn:#b3261e;--sel:#e6e5f4}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:800px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.set{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px}\n.set img{width:100%;display:block;border-radius:8px}\n.gif{width:100%;display:block;border-radius:10px}\n.pano{position:sticky;top:0;z-index:2;background:var(--bg);padding:6px 0;max-width:460px}\n.def{font-size:.92rem;color:var(--ink);background:var(--sel);border-radius:8px;padding:8px 12px;margin:10px 0}\n.it{padding:8px 0;border-top:1px solid var(--line)}\n.it .q{font-size:.95rem;margin-bottom:4px}\n.it .o{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}\n.it label{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;border:1px solid var(--line);border-radius:8px;padding:3px 1px;cursor:pointer;font-size:.68rem;line-height:1.15;color:var(--muted);text-align:center}\n.it label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.it input{margin:0 0 2px}\n.it.miss .o{outline:2px solid var(--warn);outline-offset:2px;border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}.f:first-child{margin-top:0}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:800px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Images: Ho &amp; Au (2021), Frontiers in Psychology 12: 647863, Supplementary Appendix A (doi:10.3389/fpsyg.2021.647863, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='busking-space:state';\n  var app=document.getElementById('app'), Q={}, files={}, anchors={}, st=null, O=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function spName(k){var c=(Q.space_type.choices||[]).filter(function(c){return c.value===k;})[0];return c?c.text:k;}\n  function intro(){\n    app.innerHTML='<h1>Public spaces</h1><p>This study is about how people experience public space. You will first see pictures of 12 kinds of public space, then one of them again, and answer some questions about it. There are no right or wrong answers. It takes about 5 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true),SPSite.answer('space_type',st.sp)],this,function(){st.step='set';save();route();});};\n  }\n  function set(){\n    app.innerHTML='<h2>Twelve public spaces</h2><p>Please look at these pictures of public spaces.</p><div class=\"card\"><div class=\"set\">'+st.anchorOrder.map(function(k){return '<img alt=\"Public space\" src=\"'+esc(anchors[k].url)+'\">';}).join('')+'</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div></div>';\n    document.getElementById('go').onclick=function(){st.step='def';save();route();};\n  }\n  function def(){\n    app.innerHTML='<h2>Street performance</h2><div class=\"card\"><p style=\"color:var(--ink)\">'+esc(O.busking_definition)+'</p><p>In the next picture, a street performer playing a guitar, with an open guitar case for donations, and two passersby will appear in one of the public spaces.</p><button class=\"btn\" id=\"go\">Continue</button></div>';\n    document.getElementById('go').onclick=function(){st.step='rate';save();route();};\n  }\n  function rate(){\n    var f=files[st.sp],rows=[];\n    (Q.change.rows||[]).forEach(function(r){rows.push(['change',r]);});(Q.attention.rows||[]).forEach(function(r){rows.push(['attention',r]);});\n    var byKey={};rows.forEach(function(x){byKey[x[0]+'__'+x[1].value]=x;});\n    var cols=Q.change.columns||[];\n    app.innerHTML='<div class=\"pano\"><img class=\"gif\" alt=\"Public space with street performance\" src=\"'+esc(f.url)+'\"></div><div class=\"card\"><div class=\"def\"><b>'+esc(spName(st.sp))+':</b> '+esc(O.definitions[st.sp]||'')+'</div><p style=\"color:var(--ink)\">'+esc(O.imagine_prompt)+'</p><p>Focus on the setting of the place rather than the quality of the image. There are no right or wrong answers.</p><p style=\"color:var(--ink);font-weight:600\">'+esc(Q.change.title)+'</p>'+st.itemOrder.map(function(nm){var r=byKey[nm][1];return '<div class=\"it\" data-n=\"'+nm+'\"><div class=\"q\">'+esc(r.text)+'</div><div class=\"o\">'+cols.map(function(c){return '<label><input type=\"radio\" name=\"'+nm+'\" value=\"'+c.value+'\">'+esc(c.text)+'</label>';}).join('')+'</div></div>';}).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var out={change:{},attention:{}},miss=0,first=null;\n      st.itemOrder.forEach(function(nm){var x=val(nm),el=app.querySelector('.it[data-n=\"'+nm+'\"]'),p=nm.split('__');if(x==null){miss++;el.classList.add('miss');first=first||el;}else out[p[0]][p[1]]=Number(x);});\n      if(miss){first.scrollIntoView({block:'center'});return err('Please answer every statement ('+miss+' missing).');}\n      send([SPSite.answer('change',out.change,{key:st.sp,shown:[f.name]}),SPSite.answer('attention',out.attention,{key:st.sp,shown:[f.name]})],this,function(){st.step='about';save();route();});\n    };\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+radios('gender')+'<div class=\"f\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"16\" max=\"110\"></div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var g=val('gender'),age=Number(document.getElementById('age').value);\n      if(!g)return err('Please choose an option.');if(!(age>=16&&age<=110))return err('Please enter your age.');\n      send([SPSite.answer('gender',g),SPSite.answer('age',age)],this,function(){st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var r=e.target.closest&&e.target.closest('.it');if(r)r.classList.remove('miss');});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='set')return set();if(s==='def')return def();if(s==='rate')return rate();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    try{O=JSON.parse(document.getElementById('busking-original').textContent);}catch(e){O={definitions:{}};}\n    ['consent','space_type','change','attention','gender','age'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('spaces')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    (SPSite.getMedia('anchors')||[]).forEach(function(f){anchors[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var ids=(Q.space_type.choices||[]).map(function(c){return c.value;}).filter(function(k){return files[k]&&anchors[k];});\n    if(ids.length<12){app.innerHTML='<h1>Images missing</h1><p>Upload the 12 animated images to \"spaces\" and the 12 still images to \"anchors\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.sp&&files[st.sp])||a.consent!==true){\n      var items=[];(Q.change.rows||[]).forEach(function(r){items.push('change__'+r.value);});(Q.attention.rows||[]).forEach(function(r){items.push('attention__'+r.value);});\n      st={step:'intro',sp:ids[Math.floor(Math.random()*ids.length)],anchorOrder:shuffle(ids),itemOrder:shuffle(items)};\n    }\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
