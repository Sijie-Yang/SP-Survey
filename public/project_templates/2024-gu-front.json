  "spSite": {
   "id": "site-8c211faeaa6c2016",
   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Front Garden Visual Impact</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Front Gardens of Multi-storey Residential Buildings\",\n  \"description\": \"Faithful replication of the public visual impact assessment of Gu, Han, Zhao, Zhang, Yang & Zhang (2024), PLOS ONE 19(1): e0296519. Nine rendered scenes (A-I) of the private front gardens of ground-floor flats in Chinese multi-storey housing, modelled in SketchUp 2021 and rendered in Lumion 11 by the authors after nine typical gardens that owners had shared on social media, varying garden size, plant type, vertical structure, number of plant colours, plant coverage and fence material (hedge, wooden or metal). Participants give gender, age group, education and income, then score each picture from 0 (strongly dislike) to 5 (strongly like), in random order. Ratings are keyed by picture letter.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\"gardens\"],\n  \"pages\": [\n   {\"name\": \"start\", \"elements\": [\n    {\"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\"}\n   ]},\n   {\"name\": \"about\", \"elements\": [\n    {\"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"isRequired\": true, \"choices\": [{\"value\":\"male\",\"text\":\"Male\"},{\"value\":\"female\",\"text\":\"Female\"}]},\n    {\"type\": \"radiogroup\", \"name\": \"age_group\", \"title\": \"Age\", \"isRequired\": true, \"choices\": [{\"value\":\"18-34\",\"text\":\"18–34\"},{\"value\":\"35-59\",\"text\":\"35–59\"},{\"value\":\"60+\",\"text\":\"60 or older\"}]},\n    {\"type\": \"radiogroup\", \"name\": \"education\", \"title\": \"Education\", \"isRequired\": true, \"choices\": [{\"value\":\"higher\",\"text\":\"With higher education\"},{\"value\":\"no_higher\",\"text\":\"Without higher education\"}]},\n    {\"type\": \"radiogroup\", \"name\": \"income\", \"title\": \"Disposable income per year\", \"isRequired\": true, \"choices\": [{\"value\":\"below\",\"text\":\"Below RMB 47,498 (about USD 7,362)\"},{\"value\":\"above\",\"text\":\"RMB 47,498 (about USD 7,362) or more\"}]},\n    {\"type\": \"boolean\", \"name\": \"owner\", \"title\": \"Do you own or manage a front garden of a ground-floor flat yourself?\", \"isRequired\": true, \"labelTrue\": \"Yes\", \"labelFalse\": \"No\"}\n   ]},\n   {\"name\": \"pictures\", \"elements\": [\n    {\"type\": \"rating\", \"name\": \"score\", \"title\": \"How much do you like this front garden?\", \"isRequired\": true, \"rateValues\": [{\"value\":0,\"text\":\"Strongly dislike\"},{\"value\":1,\"text\":\"1\"},{\"value\":2,\"text\":\"2\"},{\"value\":3,\"text\":\"3\"},{\"value\":4,\"text\":\"4\"},{\"value\":5,\"text\":\"Strongly like\"}], \"description\": \"Keyed by picture letter (A-I), 0-5.\"}\n   ]}\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"garden-features\">{\"source\":\"Gu et al. (2024) PLOS ONE e0296519, Fig 2; scores 0-5\",\"n\":256,\"highest\":{\"picture\":\"F\",\"mean\":3.95},\"lowest\":{\"picture\":\"A\",\"mean\":2.37},\"overall_mean\":3.35}</script>\n<style>\n:root{--bg:#f3f2ee;--card:#fff;--ink:#1d1f1c;--muted:#5d6159;--accent:#3d6b4f;--line:#d9dad2;--warn:#b3261e;--sel:#e0ece4}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1100px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:14px}\n.b{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px}\n.b img{width:100%;height:auto;display:block;border-radius:8px}\n.b .no{font-weight:700;margin:6px 0 4px}\n.o{display:grid;grid-template-columns:repeat(6,1fr);gap:3px}\n.o label{display:flex;flex-direction:column;align-items:center;gap:2px;border:1px solid var(--line);border-radius:8px;padding:6px 1px;cursor:pointer;font-size:.68rem;line-height:1.15;text-align:center;color:var(--muted)}\n.o label b{font-size:.95rem;color:var(--ink)}\n.o label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.o input{display:none}\n.b.miss{outline:2px solid var(--warn);outline-offset:2px}\n.blk{margin-top:14px}.blk:first-child{margin-top:0}\n.blk.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.err{color:var(--warn);margin-top:8px;min-height:1.5em;line-height:1.5}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:700px){.grid{grid-template-columns:1fr}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Pictures and design: Gu, Han, Zhao, Zhang, Yang &amp; Zhang (2024), Is there any difference between the owners and the public in their visual impact assessments? A case study of the front garden of multi-storey residential buildings, PLOS ONE 19(1): e0296519, Fig 2 (doi:10.1371/journal.pone.0296519, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='gu2024garden:state', IDS=['A','B','C','D','E','F','G','H','I'], BG=['gender','age_group','education','income','owner'], PER=2;\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='';}}\n  function hideErr(){var e=app.querySelector('.err');if(e&&!app.querySelector('.miss'))e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function intro(){\n    app.innerHTML='<h1>Front gardens of apartment buildings</h1><p>In many Chinese housing estates, ground-floor flats come with a small front garden that the owner looks after but that everyone passing by can see. You will see nine pictures of such front gardens, two at a time, and say how much you like each one, from 0 (strongly dislike) to 5 (strongly like). You can change a score before moving on. First, a few questions about you. It takes about 3 minutes.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+BG.map(function(n){var q=Q[n];\n      var ch=q.type==='boolean'?[{value:'true',text:q.labelTrue},{value:'false',text:q.labelFalse}]:(q.choices||[]);\n      return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b>'+ch.map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var L=[],miss=[];\n      BG.forEach(function(n){var q=Q[n],x=app.querySelector('input[name=\"'+n+'\"]:checked');if(!x){miss.push(app.querySelector('.blk[data-n=\"'+n+'\"]'));return;}\n        L.push(SPSite.answer(n,q.type==='boolean'?x.value==='true':x.value));});\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please answer all five questions.');}\n      send(L,this,function(){st.step='pics';st.p=0;st.order=shuffle(IDS);st.r={};save();route();});};\n  }\n  function pics(){\n    var q=Q.score,sc=q.rateValues||[],p=st.p,ids=st.order.slice(p*PER,p*PER+PER),pages=Math.ceil(IDS.length/PER),r=st.r;\n    app.innerHTML='<h2>'+(ids.length>1?'Pictures ':'Picture ')+(p*PER+1)+(ids.length>1?'–'+(p*PER+ids.length):'')+' of '+IDS.length+'</h2><p>'+esc(q.title)+' 0 = strongly dislike, 5 = strongly like.</p><div class=\"grid\">'+ids.map(function(id,i){\n      return '<div class=\"b\" data-k=\"'+id+'\"><img alt=\"Front garden picture\" src=\"'+esc(files[id].url)+'\"><div class=\"no\">Picture '+(p*PER+i+1)+'</div><div class=\"o\">'+sc.map(function(s){return '<label><input type=\"radio\" name=\"r_'+id+'\" value=\"'+s.value+'\"'+(r[id]===s.value?' checked':'')+'><b>'+s.value+'</b>'+(s.value===0||s.value===5?esc(s.text):'&nbsp;')+'</label>';}).join('')+'</div></div>';}).join('')+\n      '</div><div class=\"card\"><button class=\"btn\" id=\"go\">'+(p<pages-1?'Next':'Finish')+'</button><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var miss=[],L=[];\n      ids.forEach(function(id){var x=app.querySelector('input[name=\"r_'+id+'\"]:checked');if(x)r[id]=Number(x.value);else miss.push(app.querySelector('.b[data-k=\"'+id+'\"]'));});\n      save();\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please score every picture on this page.');}\n      ids.forEach(function(id){L.push(SPSite.answer('score',r[id],{key:id,shown:[files[id].name]}));});\n      send(L,this,function(){if(p<pages-1)st.p=p+1;else st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var b=e.target.closest&&e.target.closest('.b,.blk');if(b){b.classList.remove('miss');hideErr();}\n    if(e.target.name&&/^r_/.test(e.target.name)&&st&&st.r){st.r[e.target.name.slice(2)]=Number(e.target.value);save();}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='pics')return pics();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','score'].concat(BG).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('gardens')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=IDS.filter(function(k){return !files[k];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"gardens\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.step)||a.consent!==true)st={step:'intro'};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
