   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Forest landscape preference ranking (Shafer &amp; Mietz 1970)</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\"format\":\"sp-scheme-package\",\"spScheme\":\"2.0\",\"survey\":{\"title\":\"Forest landscape preference ranking (Shafer & Mietz 1970)\",\"description\":\"Rank two sets of seven black-and-white wildland landscape photographs from most to least preferred, as in Shafer & Mietz (1970, USDA Forest Service Research Paper NE-162).\",\"locale\":\"en\",\"mediaFolders\":[\"setA\",\"setB\"],\"pages\":[\n{\"name\":\"intro\",\"elements\":[{\"type\":\"boolean\",\"name\":\"consent\",\"title\":\"I agree to take part. My answers are recorded anonymously for research.\",\"isRequired\":true}]},\n{\"name\":\"set_a\",\"elements\":[{\"type\":\"custom\",\"name\":\"rank_set_a\",\"title\":\"Set A: rank the seven landscapes from the one you like most (1) to the one you like least (7)\",\"isRequired\":true,\"description\":\"Value: array of the seven file names of media folder setA in rank order (first = most preferred). File names carry the photo's position in the report's Figure 2 and its predicted and observed rank in the original study (setA_photoN_predP_obsO). Analysis as in the paper: sum the ranks per photo over respondents (lower = more preferred) and compare with the report's observed ranking (Kendall's coefficient of concordance).\"}]},\n{\"name\":\"set_b\",\"elements\":[{\"type\":\"custom\",\"name\":\"rank_set_b\",\"title\":\"Set B: rank the seven landscapes from the one you like most (1) to the one you like least (7)\",\"isRequired\":true,\"description\":\"Value: array of the seven file names of media folder setB in rank order (first = most preferred); see Figure 3 of the report. Same analysis as set A.\"}]},\n{\"name\":\"about\",\"elements\":[{\"type\":\"radiogroup\",\"name\":\"age\",\"title\":\"Your age\",\"isRequired\":true,\"choices\":[{\"value\":1,\"text\":\"12–17\"},{\"value\":2,\"text\":\"18–29\"},{\"value\":3,\"text\":\"30–44\"},{\"value\":4,\"text\":\"45–64\"},{\"value\":5,\"text\":\"65 or older\"}]},\n{\"type\":\"radiogroup\",\"name\":\"outdoor_recreation\",\"title\":\"How often do you visit forests, mountains or lakes for recreation?\",\"isRequired\":true,\"choices\":[{\"value\":1,\"text\":\"Weekly or more\"},{\"value\":2,\"text\":\"Monthly\"},{\"value\":3,\"text\":\"A few times a year\"},{\"value\":4,\"text\":\"Rarely or never\"}]}]}]}}\n</script>\n<style>\n:root{--bg:#f3f2ee;--card:#fff;--ink:#1e2122;--muted:#5d6366;--accent:#3d5a3a;--accent-ink:#fff;--line:#d9d6cf;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:980px;margin:0 auto;padding:20px 16px 40px}h1{font-size:1.3rem;margin:0 0 8px}p{margin:0 0 10px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent)}.btn:disabled{opacity:.4;cursor:not-allowed}\n.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}\n.pics{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}\n.pic{position:relative;border:3px solid transparent;border-radius:10px;overflow:hidden;cursor:pointer;background:#222;padding:0;font:inherit}\n.pic img{width:100%;aspect-ratio:4/3;object-fit:contain;display:block;background:#222}\n.pic .no{position:absolute;left:6px;top:6px;background:rgba(255,255,255,.9);color:#000;font-weight:700;font-size:.8rem;padding:0 7px;border-radius:5px}\n.pic .rk{position:absolute;right:6px;top:6px;background:var(--accent);color:#fff;font-weight:700;font-size:.95rem;min-width:30px;text-align:center;padding:1px 8px;border-radius:999px;display:none}\n.pic.on{border-color:var(--accent)}.pic.on .rk{display:block}.pic.on img{opacity:.55}\n.pic:focus-visible{outline:2px solid var(--accent);outline-offset:2px}\n.picked{margin-top:10px;font-size:.92rem;color:var(--muted)}\nlabel.o{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:14px}.q>b{display:block;margin-bottom:4px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:980px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:700px){.pics{grid-template-columns:repeat(2,1fr)}h1{font-size:1.15rem}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs and method: Shafer, E. L., Jr. &amp; Mietz, J. (1970). <i>It seems possible to quantify scenic beauty in photographs</i>. USDA Forest Service Research Paper NE-162. Northeastern Forest Experiment Station, Upper Darby, PA. Figures 2 and 3. Public domain (US government work).</footer>\n<script>\n(function(){\n  var app=document.getElementById('app'),A={},SETS=[{q:'rank_set_a',folder:'setA',label:'Set A'},{q:'rank_set_b',folder:'setB',label:'Set B'}],order={},rank={};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function has(n){var v=A[n];return v!=null&&v!==''&&!(Array.isArray(v)&&!v.length);}\n  function next(){\n    window.scrollTo(0,0);\n    if(A.consent!==true)return intro();\n    for(var i=0;i<SETS.length;i++)if(!has(SETS[i].q))return rankPage(i);\n    if(!has('age')||!has('outdoor_recreation'))return about();\n    finish();\n  }\n  function intro(){\n    app.innerHTML='<h1>Which forest landscapes do you like best?</h1><p>You will see two sets of seven black-and-white photographs of wildland landscapes. For each set, put the seven photographs in order, from the one you like most to the one you like least.</p><p>It takes about 4 minutes. There are no right or wrong answers.</p><div class=\"card\"><p>'+esc(SPSite.getQuestion('consent').title)+'</p><div class=\"row\"><button class=\"btn\" id=\"yes\">I agree</button></div><div class=\"err\"></div></div>';\n    document.getElementById('yes').onclick=function(){var b=this;b.disabled=true;SPSite.answer('consent',true).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}A.consent=true;next();});};\n  }\n  function rankPage(i){\n    var S=SETS[i],media=(SPSite.getMedia(S.folder)||[]);\n    if(media.length!==7){app.innerHTML='<h1>Pictures missing</h1><p>Media folder '+esc(S.folder)+' must hold the seven photographs.</p>';return;}\n    if(!order[S.q])order[S.q]=shuffle(media);\n    var r=rank[S.q]||(rank[S.q]=[]),list=order[S.q];\n    var h='<div class=\"card\"><h1>'+esc(S.label)+' ('+(i+1)+' of 2)</h1><p>Tap the photo you like <b>most</b> first, then the next one, and so on until all seven have a number (1 = like most, 7 = like least). Tap a numbered photo again to take it back.</p><div class=\"pics\">';\n    list.forEach(function(f,k){var p=r.indexOf(f.name);h+='<button type=\"button\" class=\"pic'+(p>=0?' on':'')+'\" data-f=\"'+esc(f.name)+'\" aria-pressed=\"'+(p>=0)+'\" aria-label=\"Photo '+String.fromCharCode(65+k)+(p>=0?', rank '+(p+1):'')+'\"><img src=\"'+esc(f.url)+'\" alt=\"Wildland landscape, photo '+String.fromCharCode(65+k)+'\"><span class=\"no\">'+String.fromCharCode(65+k)+'</span><span class=\"rk\">'+(p>=0?p+1:'')+'</span></button>';});\n    h+='</div><div class=\"picked\">'+(r.length?'Your order so far: '+r.map(function(n){var k=list.map(function(x){return x.name;}).indexOf(n);return String.fromCharCode(65+k);}).join(' › '):'No photo ranked yet.')+' ('+r.length+' of 7)</div><div class=\"row\"><button class=\"btn\" id=\"go\"'+(r.length<7?' disabled':'')+'>Continue</button>'+(r.length?'<button class=\"btn ghost\" id=\"clr\">Start this set again</button>':'')+'</div><div class=\"err\"></div></div>';\n    app.innerHTML=h;\n    app.querySelectorAll('.pic').forEach(function(b){b.onclick=function(){var n=b.getAttribute('data-f'),p=r.indexOf(n);if(p>=0)r.splice(p,1);else r.push(n);var y=window.scrollY;rankPage(i);window.scrollTo(0,y);};});\n    var c=document.getElementById('clr');if(c)c.onclick=function(){rank[S.q]=[];rankPage(i);};\n    document.getElementById('go').onclick=function(){if(r.length<7)return err('Please give all seven photos a number.');var b=this;b.disabled=true;\n      SPSite.answer(S.q,r.slice(),{shown:list.map(function(f){return f.name;})}).then(function(res){if(!ok(res)){b.disabled=false;return err(res.error);}A[S.q]=r.slice();next();});};\n  }\n  function about(){\n    var names=['age','outdoor_recreation'],h='<h1>About you</h1><div class=\"card\">';\n    names.forEach(function(n){var q=SPSite.getQuestion(n);h+='<div class=\"q\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"o\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"'+(A[n]==c.value?' checked':'')+'> '+esc(c.text)+'</label>';}).join('')+'</div>';});\n    app.innerHTML=h+'<div class=\"row\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var vals={};for(var k=0;k<names.length;k++){var x=app.querySelector('input[name=\"'+names[k]+'\"]:checked');if(!x)return err('Please answer: '+SPSite.getQuestion(names[k]).title);vals[names[k]]=Number(x.value);}\n      var b=this;b.disabled=true;Promise.all(names.map(function(n){return SPSite.answer(n,vals[n]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}names.forEach(function(n){A[n]=vals[n];});next();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>In the original study (August 1967), 50 day-users of two recreation areas near Salt Lake City, Utah, ranked these same photographs. In set A they liked best the scene combining a waterfall, a stream and a lake, then the multiple waterfalls; the lake and the swampy stream came last.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');return;}var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';});\n  }\n  SPSite.onReady(function(ctx){A=(ctx&&ctx.answers)||{};next();});\n})();\n</script>\n</body>\n</html>\n",
