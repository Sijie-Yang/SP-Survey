   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Mountain Stream Facilities</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Mountain Stream Facilities: Preference and Captions (CEM)\",\n  \"description\": \"Faithful replication of the online survey in Peng, Huang & Chen (2022), Water 14:3605: 22 photographs of check dams, ground sills, embankments and ecological channels from two stream renovation projects in Taiwan, each rated for scenic preference (1–5) and captioned with the caption evaluation method (element noticed, its feature, the feeling it gives).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"facilities\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"about\",\n    \"title\": \"Mountain stream facilities\",\n    \"intro\": \"You will see 22 pictures of two stream renovation projects in Taiwan: check dams, ground sills, embankments, ecological channels and similar works built to control erosion. For each picture, rate how much you like the scenery and write three short captions: what you notice, what about it, and how it makes you feel. It takes about 15 minutes and your answers are anonymous.\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"Consent\",\n      \"label\": \"I agree to take part in this survey and that my answers are used for research.\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"student_level\",\n      \"title\": \"Are you currently a student?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Undergraduate student\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Graduate student\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Not a student\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"pictures\",\n    \"title\": \"Pictures\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"kind\": \"image_rating\",\n      \"name\": \"stream_facilities\",\n      \"isRequired\": true,\n      \"title\": \"Rate this picture from 1 to 5.\",\n      \"items\": [\n       {\n        \"name\": \"preference\",\n        \"text\": \"How much do you like the scenery of this picture?\",\n        \"low\": \"very low\",\n        \"high\": \"very high\"\n       }\n      ],\n      \"meta\": {\n       \"toubiankeng_01\": {\n        \"site\": \"Toubiankeng Stream\",\n        \"pref\": 3.15\n       },\n       \"toubiankeng_02\": {\n        \"site\": \"Toubiankeng Stream\",\n        \"pref\": 3.64\n       },\n       \"toubiankeng_03\": {\n        \"site\": \"Toubiankeng Stream\",\n        \"pref\": 4.01\n       },\n       \"toubiankeng_04\": {\n        \"site\": \"Toubiankeng Stream\",\n        \"pref\": 3.58\n       },\n       \"toubiankeng_05\": {\n        \"site\": \"Toubiankeng Stream\",\n        \"pref\": 4.14\n       },\n       \"toubiankeng_06\": {\n        \"site\": \"Toubiankeng Stream\",\n        \"pref\": 3.04\n       },\n       \"toubiankeng_07\": {\n        \"site\": \"Toubiankeng Stream\",\n        \"pref\": 3.9\n       },\n       \"toubiankeng_08\": {\n        \"site\": \"Toubiankeng Stream\",\n        \"pref\": 3.07\n       },\n       \"toubiankeng_09\": {\n        \"site\": \"Toubiankeng Stream\",\n        \"pref\": 3.76\n       },\n       \"toubiankeng_10\": {\n        \"site\": \"Toubiankeng Stream\",\n        \"pref\": 3.71\n       },\n       \"toubiankeng_11\": {\n        \"site\": \"Toubiankeng Stream\",\n        \"pref\": 4.1\n       },\n       \"sijiaolin_01\": {\n        \"site\": \"Sijiaolin Stream\",\n        \"pref\": 3.59\n       },\n       \"sijiaolin_02\": {\n        \"site\": \"Sijiaolin Stream\",\n        \"pref\": 3.08\n       },\n       \"sijiaolin_03\": {\n        \"site\": \"Sijiaolin Stream\",\n        \"pref\": 3.77\n       },\n       \"sijiaolin_04\": {\n        \"site\": \"Sijiaolin Stream\",\n        \"pref\": 3.93\n       },\n       \"sijiaolin_05\": {\n        \"site\": \"Sijiaolin Stream\",\n        \"pref\": 3.93\n       },\n       \"sijiaolin_06\": {\n        \"site\": \"Sijiaolin Stream\",\n        \"pref\": 3.87\n       },\n       \"sijiaolin_07\": {\n        \"site\": \"Sijiaolin Stream\",\n        \"pref\": 3.86\n       },\n       \"sijiaolin_08\": {\n        \"site\": \"Sijiaolin Stream\",\n        \"pref\": 4.1\n       },\n       \"sijiaolin_09\": {\n        \"site\": \"Sijiaolin Stream\",\n        \"pref\": 3.92\n       },\n       \"sijiaolin_10\": {\n        \"site\": \"Sijiaolin Stream\",\n        \"pref\": 3.38\n       },\n       \"sijiaolin_11\": {\n        \"site\": \"Sijiaolin Stream\",\n        \"pref\": 4.03\n       }\n      },\n      \"captions\": [\n       {\n        \"name\": \"element\",\n        \"text\": \"1. Element: what do you notice most in this picture?\",\n        \"placeholder\": \"e.g. check dam, embankment, stones, plants, water\"\n       },\n       {\n        \"name\": \"representation\",\n        \"text\": \"2. Feature: what about it caught your eye?\",\n        \"placeholder\": \"e.g. its form, colour, arrangement, material\"\n       },\n       {\n        \"name\": \"perception\",\n        \"text\": \"3. Feeling: how does it make you feel?\",\n        \"placeholder\": \"e.g. relaxing, comfortable, oppressive, uneasy\"\n       }\n      ],\n      \"captionTitle\": \"Then describe it in three short captions (a word or a few words each):\",\n      \"description\": \"22 pictures (paper Tables 1 and 2: 11 from the Upstream Renovation Project of Toubiankeng Stream, Zhongpu; 11 from the Renovation Project of Sijiaolin Stream), each on its own page in random order. One trial per picture (key = file name), values preference (1–5), element, representation, perception (free-text captions, caption evaluation method, CEM), picture, site, paper_preference (mean in the paper) and position. Analysis in the paper: mean preference per picture and per site; captions segmented into keywords (Jieba), coded in NVivo and summarised as the top three elements, representations and perceptions per picture and as word clouds.\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#eef2ec;--card:#fff;--ink:#1c231d;--muted:#56614f;--accent:#2f6b3a;--line:#d2dccd;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:20px}.q:first-child{margin-top:0}.q>b{display:block;margin-bottom:6px}.q.miss>b{color:var(--warn)}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\ninput[type=text],input[type=number],textarea{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:100%}\ninput[type=number]{max-width:160px}textarea{min-height:70px;resize:vertical}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.t{color:var(--muted);font-size:.9rem}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.stim{display:block;width:100%;max-width:560px;margin:0 auto;border-radius:8px}\n.it{padding:10px 0;border-top:1px solid var(--line)}.it:first-child{border-top:0}.it.miss>.lab{color:var(--warn)}\n.lab{margin-bottom:4px}\n.ends{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-top:3px;max-width:520px}\n.seg{display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:3px;max-width:520px}\n.seg label{display:block;cursor:pointer;position:relative}\n.seg input{position:absolute;opacity:0;pointer-events:none}\n.seg span{display:flex;align-items:center;justify-content:center;min-height:40px;border:1px solid var(--line);border-radius:8px;font-size:.9rem}\n.seg input:checked+span{background:var(--accent);border-color:var(--accent);color:#fff}\n.seg input:focus-visible+span{outline:2px solid var(--accent);outline-offset:2px}\n.kw{display:flex;flex-wrap:wrap;gap:6px}.kw label.opt{margin-top:0}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:760px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Pictures: the 22 photographs of mountain stream facilities printed in Peng, Huang &amp; Chen (2022), Water 14:3605, Tables 1 and 2, doi:10.3390/w14223605 (CC BY 4.0; Toubiankeng Stream and Sijiaolin Stream, Taiwan). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='cem2022:';\n  var app=document.getElementById('app'),SPEC,Q={},files={},done={},ORDER=[],META={},CAPS=[],CAPHEAD='',IMG,ITEMS=[],PRE=[];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function shuffle(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function seven(name){var h='<div class=\"seg\" style=\"--n:5\" role=\"radiogroup\">';for(var v=1;v<=5;v++)h+='<label><input type=\"radio\" name=\"'+name+'\" value=\"'+v+'\"><span>'+v+'</span></label>';return h+'</div>';}\n  function scaleItem(name,it){return '<div class=\"it\" data-n=\"'+name+'\"><div class=\"lab\">'+esc(it.text)+'</div>'+seven(name)+'<div class=\"ends\"><span>1 = '+esc(it.low)+'</span><span>5 = '+esc(it.high)+'</span></div></div>';}\n  function total(){return PRE.length+ORDER.length;}\n  function top(i){return '<div class=\"top\"><span class=\"t\">Page '+(i+1)+' of '+total()+'</span><div class=\"bar\"><i style=\"width:'+(100*i/total())+'%\"></i></div></div>';}\n  function next(){window.scrollTo(0,0);\n    for(var k=0;k<PRE.length;k++)if(!done['p_'+PRE[k].name])return intro(k);\n    for(var i=0;i<ORDER.length;i++)if(!done['i_'+ORDER[i]])return image(i);\n    finish();}\n  function field(e){\n    var h='<div class=\"q\" data-q=\"'+e.name+'\"><b>'+esc(Q[e.name].title)+'</b>';\n    if(e.type==='boolean')h+='<label class=\"opt\"><input type=\"checkbox\" name=\"'+e.name+'\" value=\"1\"> '+esc(e.label)+'</label>';\n    else if(e.type==='radiogroup')h+=Q[e.name].choices.map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+e.name+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');\n    else if(e.type==='text')h+='<input type=\"'+(e.inputType==='number'?'number':'text')+'\" name=\"'+e.name+'\"'+(e.inputType==='number'?' min=\"'+e.min+'\" max=\"'+e.max+'\" inputmode=\"numeric\"':' maxlength=\"80\"')+'>';\n    else if(e.kind==='scales')h+=e.items.map(function(it){return scaleItem(e.name+'__'+it.name,it);}).join('');\n    return h+'</div>';\n  }\n  function readField(e){\n    if(e.type==='boolean')return app.querySelector('input[name=\"'+e.name+'\"]').checked?true:undefined;\n    if(e.type==='radiogroup'){var x=app.querySelector('input[name=\"'+e.name+'\"]:checked');return x?Number(x.value):undefined;}\n    if(e.type==='text'){var t=app.querySelector('[name=\"'+e.name+'\"]').value.trim();if(e.inputType==='number'){var n=Number(t);return (t!==''&&n>=e.min&&n<=e.max&&Math.round(n)===n)?n:undefined;}return t||undefined;}\n    if(e.kind==='scales'){var v={},miss=0;e.items.forEach(function(it){var x=app.querySelector('input[name=\"'+e.name+'__'+it.name+'\"]:checked');if(x)v[it.name]=Number(x.value);else{miss++;app.querySelector('.it[data-n=\"'+e.name+'__'+it.name+'\"]').classList.add('miss');}});return miss?undefined:v;}\n  }\n  function intro(k){\n    var P=PRE[k],INTRO=P.elements;\n    app.innerHTML=top(k)+'<h1>'+esc(P.title)+'</h1><div class=\"card\">'+(P.intro?'<p style=\"color:var(--ink)\">'+esc(P.intro)+'</p>':'')+INTRO.map(field).join('')+'</div><div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div>';\n    app.onchange=function(ev){hideErr();var q=ev.target.closest('.q');if(q)q.classList.remove('miss');var it=ev.target.closest('.it');if(it)it.classList.remove('miss');};\n    document.getElementById('go').onclick=function(){\n      var l=[],bad=null;\n      INTRO.forEach(function(e){var v=readField(e);if(v===undefined){bad=bad||e;app.querySelector('.q[data-q=\"'+e.name+'\"]').classList.add('miss');}else l.push([e.name,v]);});\n      if(bad){err(bad.name==='consent'?'Please tick the box to agree before you start.':bad.inputType==='number'?'Please enter your age as a whole number from '+bad.min+' to '+bad.max+'.':bad.kind?'Please answer every row of: '+Q[bad.name].title:'Please answer: '+Q[bad.name].title);var m=app.querySelector('.q.miss');if(m)m.scrollIntoView({block:'center'});return;}\n      var b=this;b.disabled=true;\n      Promise.all(l.map(function(a){return SPSite.answer(a[0],a[1]);})).then(function(rs){var x=rs.filter(function(r){return !ok(r);})[0];if(x){b.disabled=false;return err(x.error);}done['p_'+P.name]=true;save('d',done);next();});\n    };\n  }\n  function preview(){\n    app.innerHTML=top(PRE.length)+'<h1>Quick look at all pictures</h1><div class=\"card\"><p style=\"color:var(--ink)\">First you will see all '+ORDER.length+' pictures, 3 seconds each, so you get a feel for the range. You do not need to answer anything yet.</p><div id=\"pv\"></div><p id=\"pvn\" style=\"text-align:center\"></p></div><div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">Start the quick look</button></div><div class=\"err\"></div>';\n    ORDER.forEach(function(f){var im=new Image();im.src=files[f].url;});\n    document.getElementById('go').onclick=function(){var b=this;b.disabled=true;var k=0,pv=document.getElementById('pv'),n=document.getElementById('pvn');\n      (function step(){if(k>=ORDER.length){done.preview=true;save('d',done);return next();}\n        pv.innerHTML='<img class=\"stim\" alt=\"Picture '+(k+1)+'\" src=\"'+esc(files[ORDER[k]].url)+'\">';n.textContent=(k+1)+' / '+ORDER.length;k++;setTimeout(step,window.SBE_FAST?20:3000);})();};\n  }\n  function image(i){\n    var f=ORDER[i];\n    app.innerHTML=top(PRE.length+i)+'<div class=\"card\"><img class=\"stim\" alt=\"Image '+(i+1)+' of '+ORDER.length+'\" src=\"'+esc(files[f].url)+'\"><p style=\"margin-top:12px;color:var(--ink)\">'+esc(Q.stream_facilities.title)+'</p>'+ITEMS.map(function(it){return scaleItem('s__'+it.name,it);}).join('')+'<p style=\"margin-top:14px;color:var(--ink)\">'+esc(CAPHEAD)+'</p>'+CAPS.map(function(c){return '<div class=\"q\" data-q=\"c__'+c.name+'\"><b>'+esc(c.text)+'</b><input type=\"text\" maxlength=\"120\" name=\"c__'+c.name+'\" placeholder=\"'+esc(c.placeholder)+'\"></div>';}).join('')+'</div>'+\n      '<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+(i===ORDER.length-1?'Finish':'Next')+'</button></div><div class=\"err\"></div>';\n    app.onchange=function(ev){hideErr();var it=ev.target.closest('.it');if(it)it.classList.remove('miss');var q=ev.target.closest('.q');if(q)q.classList.remove('miss');};\n    document.getElementById('go').onclick=function(){\n      var v={},miss=null;\n      ITEMS.forEach(function(it){var x=app.querySelector('input[name=\"s__'+it.name+'\"]:checked');if(x)v[it.name]=Number(x.value);else{miss=miss||it;app.querySelector('.it[data-n=\"s__'+it.name+'\"]').classList.add('miss');}});\n      CAPS.forEach(function(c){var t=app.querySelector('[name=\"c__'+c.name+'\"]').value.trim();if(t)v[c.name]=t;else{miss=miss||c;app.querySelector('.q[data-q=\"c__'+c.name+'\"]').classList.add('miss');}});\n      app.oninput=function(ev){var q=ev.target.closest('.q');if(q)q.classList.remove('miss');hideErr();};\n      if(miss){err('Please rate the picture and write all three short captions.');var m=app.querySelector('.miss');if(m)m.scrollIntoView({block:'center'});return;}\n      var m=META[f.replace(/\\.jpg$/,'')]||{};v.picture=f.replace(/\\.jpg$/,'');v.site=m.site;v.paper_preference=m.pref;v.position=i+1;\n      var b=this;b.disabled=true;\n      SPSite.answer('stream_facilities',v,{key:f.replace(/\\.jpg$/,''),shown:[f]}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}done['i_'+f]=true;save('d',done);next();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>In the original online survey in Taiwan (May 2020), 212 university students rated these 22 pictures of two award-winning stream renovation projects and described what they noticed. Most captions named ecology, embankments, check dams, ground sills and channels; form and arrangement were the features mentioned most, and most feelings were relaxing or pressure-relieving. Mean preference was 3.64 (Toubiankeng Stream) and 3.77 (Sijiaolin Stream) out of 5; views with flowing water and plants scored highest, and dense vegetation hiding the channel or bare concrete scored lowest.</p><p style=\"font-size:.82rem\">Peng, S.-H., Huang, C.-Y., &amp; Chen, S.-C. (2022). Visual Language Translation Analysis and Scenic Beauty Estimation of Mountain Stream Facilities. Water 14:3605, doi:10.3390/w14223605.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='stream_facilities')ORDER.forEach(function(f){done['i_'+f]=false;});else PRE.forEach(function(p){if(p.elements.some(function(e){return e.name===x;}))done['p_'+p.name]=false;});});save('d',done);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='stream_facilities'){IMG=e;ITEMS=e.items;META=e.meta||{};CAPS=e.captions||[];CAPHEAD=e.captionTitle||'';}});});\n    PRE=SPEC.pages.filter(function(p){return p.name!=='pictures';});\n    (SPSite.getMedia('facilities')||[]).forEach(function(f){files[f.name]=f;});\n    if(Object.keys(files).length<22){app.innerHTML='<h1>Pictures missing</h1><p>Media folder facilities must hold the 22 pictures.</p>';return;}\n    var a=(ctx&&ctx.answers)||{};done=load('d')||{};\n    ORDER=load('order');\n    if(!ORDER||ORDER.length!==Object.keys(files).length||ORDER.some(function(f){return !files[f];})){ORDER=shuffle(Object.keys(files));save('order',ORDER);}\n    PRE.forEach(function(p){done['p_'+p.name]=p.elements.every(function(e){return a[e.name]!=null;});});\n    ORDER.forEach(function(f){done['i_'+f]=false;});done.preview=!!(load('d')||{}).preview||!!(a.stream_facilities&&a.stream_facilities.trials&&a.stream_facilities.trials.length);\n    ((a.stream_facilities&&a.stream_facilities.trials)||[]).forEach(function(t){if(t.key)done['i_'+t.key+'.jpg']=true;});\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
