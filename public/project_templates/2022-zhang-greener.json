   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Greener Streets</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Greener Urban Streets and Tourists' Emotions\",\n  \"description\": \"Participants who have not visited Xi'an see 18 street photos in random order: nine control photos of culture and leisure walking streets, traffic lanes and commercial pedestrian streets in central Xi'an and the same nine views with digitally added greenery at three scales. Each photo stays at least 10 s and is rated on the study's eight 5-point word pairs (pleasure: repulsive–nice, tense–restful, uncomfortable–comfortable, unpleasant–pleasant; arousal: monotonous–exciting, inactive–active, boring–interesting, fearful–safe). Rebuilt from Zhang, Wang, Li, Chang & Lu (2022), IJERPH 19(24): 16918, with the paper's Figure 1 photos (CC BY 4.0). Analysis: pleasure and arousal means per photo; paired t-tests treatment vs control; mixed model with treatment dummy, image fixed effects and participant random intercept; split by scale and street type.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"streets\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I am 18 or older, have never been to Xi'an, and agree to take part in this study.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"streets\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"repulsive_nice\",\n      \"title\": \"Repulsive – Nice\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Repulsive\",\n      \"maxRateDescription\": \"Nice\",\n      \"isRequired\": true,\n      \"description\": \"Pleasure item. Keyed by photo: <street>_<scale>_<control|treatment>; street = culture (culture and leisure walking street), traffic (traffic lane), commercial (commercial pedestrian street); scale = small, medium, large vegetation change (green view index +5–9.9%, 10–14.9%, 15–20%). 1 = Repulsive, 5 = Nice.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"tense_restful\",\n      \"title\": \"Tense – Restful\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Tense\",\n      \"maxRateDescription\": \"Restful\",\n      \"isRequired\": true,\n      \"description\": \"Pleasure item. Keyed by photo: <street>_<scale>_<control|treatment>; street = culture (culture and leisure walking street), traffic (traffic lane), commercial (commercial pedestrian street); scale = small, medium, large vegetation change (green view index +5–9.9%, 10–14.9%, 15–20%). 1 = Tense, 5 = Restful.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"uncomfortable_comfortable\",\n      \"title\": \"Uncomfortable – Comfortable\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Uncomfortable\",\n      \"maxRateDescription\": \"Comfortable\",\n      \"isRequired\": true,\n      \"description\": \"Pleasure item. Keyed by photo: <street>_<scale>_<control|treatment>; street = culture (culture and leisure walking street), traffic (traffic lane), commercial (commercial pedestrian street); scale = small, medium, large vegetation change (green view index +5–9.9%, 10–14.9%, 15–20%). 1 = Uncomfortable, 5 = Comfortable.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"unpleasant_pleasant\",\n      \"title\": \"Unpleasant – Pleasant\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Unpleasant\",\n      \"maxRateDescription\": \"Pleasant\",\n      \"isRequired\": true,\n      \"description\": \"Pleasure item. Keyed by photo: <street>_<scale>_<control|treatment>; street = culture (culture and leisure walking street), traffic (traffic lane), commercial (commercial pedestrian street); scale = small, medium, large vegetation change (green view index +5–9.9%, 10–14.9%, 15–20%). 1 = Unpleasant, 5 = Pleasant.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"monotonous_exciting\",\n      \"title\": \"Monotonous – Exciting\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Monotonous\",\n      \"maxRateDescription\": \"Exciting\",\n      \"isRequired\": true,\n      \"description\": \"Arousal item. Keyed by photo: <street>_<scale>_<control|treatment>; street = culture (culture and leisure walking street), traffic (traffic lane), commercial (commercial pedestrian street); scale = small, medium, large vegetation change (green view index +5–9.9%, 10–14.9%, 15–20%). 1 = Monotonous, 5 = Exciting.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"inactive_active\",\n      \"title\": \"Inactive – Active\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Inactive\",\n      \"maxRateDescription\": \"Active\",\n      \"isRequired\": true,\n      \"description\": \"Arousal item. Keyed by photo: <street>_<scale>_<control|treatment>; street = culture (culture and leisure walking street), traffic (traffic lane), commercial (commercial pedestrian street); scale = small, medium, large vegetation change (green view index +5–9.9%, 10–14.9%, 15–20%). 1 = Inactive, 5 = Active.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"boring_interesting\",\n      \"title\": \"Boring – Interesting\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Boring\",\n      \"maxRateDescription\": \"Interesting\",\n      \"isRequired\": true,\n      \"description\": \"Arousal item. Keyed by photo: <street>_<scale>_<control|treatment>; street = culture (culture and leisure walking street), traffic (traffic lane), commercial (commercial pedestrian street); scale = small, medium, large vegetation change (green view index +5–9.9%, 10–14.9%, 15–20%). 1 = Boring, 5 = Interesting.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"fearful_safe\",\n      \"title\": \"Fearful – Safe\",\n      \"rateMin\": 1,\n      \"rateMax\": 5,\n      \"minRateDescription\": \"Fearful\",\n      \"maxRateDescription\": \"Safe\",\n      \"isRequired\": true,\n      \"description\": \"Arousal item. Keyed by photo: <street>_<scale>_<control|treatment>; street = culture (culture and leisure walking street), traffic (traffic lane), commercial (commercial pedestrian street); scale = small, medium, large vegetation change (green view index +5–9.9%, 10–14.9%, 15–20%). 1 = Fearful, 5 = Safe.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Highest level of education\",\n      \"isRequired\": true,\n      \"description\": \"Category wording mine; the paper reports bachelor's degree or higher vs lower.\",\n      \"choices\": [\n       {\n        \"value\": \"below_bachelor\",\n        \"text\": \"Below a bachelor's degree\"\n       },\n       {\n        \"value\": \"bachelor\",\n        \"text\": \"Bachelor's degree\"\n       },\n       {\n        \"value\": \"master_phd\",\n        \"text\": \"Master's degree or PhD\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"student\",\n      \"title\": \"Are you currently a student?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"streets-original\">{\"source\": \"Zhang, Wang, Li, Chang & Lu (2022) International Journal of Environmental Research and Public Health 19(24): 16918\", \"n\": 299, \"participants\": \"Chinese potential tourists who had never visited Xi'an, recruited on WeChat (53% male, 59% aged 18–25); online survey on wjx.cn, February–March 2020\", \"result\": \"Added street greenery raised both pleasure (+1.21 on the 1–5 scale) and arousal (+1.24) compared with the control photos. Larger greening raised pleasure most; medium and large raised arousal equally. The effect was smallest on traffic lanes; pleasure rose most on culture and leisure walking streets and arousal most on commercial pedestrian streets.\"}</script>\n<style>\n:root{--bg:#f6f4ef;--card:#fff;--ink:#23211c;--muted:#655f53;--accent:#3d7a3a;--line:#e0dbd0;--warn:#b3261e;--sel:#e6f2e4}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.photo{width:100%;max-width:520px;border-radius:8px;display:block;margin:0 auto 6px}\n.cr{font-size:.72rem;color:var(--muted);text-align:center;margin-bottom:12px}\n.sd{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center;padding:7px 0;border-top:1px solid var(--line)}\n.sd:first-of-type{border-top:0}\n.sd .l{text-align:right;font-weight:600;font-size:.95rem}.sd .r{font-weight:600;font-size:.95rem}\n.row{display:flex;gap:4px}\n.row label{display:flex;align-items:center;justify-content:center;width:30px;height:30px;border:1px solid var(--line);border-radius:50%;cursor:pointer}\n.row label:has(input:checked){background:var(--accent);border-color:var(--accent)}\n.row input{appearance:none;margin:0;width:100%;height:100%;cursor:pointer}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:760px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:520px){.sd{grid-template-columns:1fr 1fr;gap:4px 8px}.sd .l{text-align:left;order:1}.sd .r{text-align:right;order:2}.row{order:3;grid-column:1/-1;justify-content:space-between;padding:0 4px}.row label{width:36px;height:36px}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Zhang, Wang, Li, Chang &amp; Lu (2022), International Journal of Environmental Research and Public Health 19(24): 16918, Figure 1 (doi:10.3390/ijerph192416918, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='greener-streets:state', VIEW=(window.__VIEWMS||10000), tick=null;\n  var app=document.getElementById('app'), Q={}, files={}, ids=[], st=null;\n  // [name, value-1 word, value-5 word]\n  var SD=[['repulsive_nice','Repulsive','Nice'],['tense_restful','Tense','Restful'],['uncomfortable_comfortable','Uncomfortable','Comfortable'],['unpleasant_pleasant','Unpleasant','Pleasant'],['monotonous_exciting','Monotonous','Exciting'],['inactive_active','Inactive','Active'],['boring_interesting','Boring','Interesting'],['fearful_safe','Fearful','Safe']];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function sdRow(p){var L=p[1],R=p[2],h='<div class=\"sd\"><span class=\"l\">'+L+'</span><div class=\"row\">';\n    for(var v=1;v<=5;v++)h+='<label title=\"'+v+'\"><input type=\"radio\" name=\"q_'+p[0]+'\" value=\"'+v+'\" aria-label=\"'+L+' '+(6-v)+' / '+R+' '+v+'\"></label>';\n    return h+'</div><span class=\"r\">'+R+'</span></div>';}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function intro(){\n    app.innerHTML='<h1>Walking through city streets</h1><p>You will see '+st.order.length+' photos of streets in a Chinese city you have not visited. Imagine you are a tourist walking along the street in each photo. Look at the photo, then mark how the place makes you feel between two opposite words (the circle next to a word means \"very\", the middle circle means neither). Each photo stays at least 10 seconds. It takes about 10 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='trial';st.k=0;save();route();});};\n  }\n  function trial(){\n    var id=st.order[st.k];if(tick)clearInterval(tick);\n    app.innerHTML='<div class=\"prog\">Photo '+(st.k+1)+' of '+st.order.length+'</div><div class=\"card\"><img class=\"photo\" alt=\"Street photo\" src=\"'+esc(files[id].url)+'\"><p style=\"color:var(--ink);text-align:center;margin:8px 0 4px\">Imagine walking along this street. How does it make you feel?</p>'+SD.map(sdRow).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\" disabled>Continue</button><span id=\"tm\" style=\"font-size:.85rem;color:var(--muted);margin-left:10px\"></span></div><div class=\"err\"></div></div>';\n    var t0=Date.now(),go=document.getElementById('go'),tm=document.getElementById('tm');\n    function upd(){var left=Math.ceil((VIEW-(Date.now()-t0))/1000);if(left<=0){go.disabled=false;tm.textContent='';clearInterval(tick);}else tm.textContent='Please keep looking at the photo: '+left+' s';}\n    upd();tick=setInterval(upd,250);\n    go.onclick=function(){\n      var vals=SD.map(function(p){return val('q_'+p[0]);});if(vals.some(function(x){return x==null;}))return err('Please answer all 8 word pairs.');\n      var sh=[files[id].name];\n      send(SD.map(function(p,i){return SPSite.answer(p[0],Number(vals[i]),{key:id,shown:sh});}),this,function(){st.k++;if(st.k>=st.order.length)st.step='about';save();route();});\n    };\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"110\"></div>'+radios('gender')+radios('education')+radios('student')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var g=val('gender'),f=val('education'),u=val('student'),age=Number(document.getElementById('age').value);\n      if(!(age>=18&&age<=110))return err('Please enter your age.');if(!g||!f||!u)return err('Please answer every question.');\n      send([SPSite.answer('age',age),SPSite.answer('gender',g),SPSite.answer('education',f),SPSite.answer('student',u)],this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='trial')return trial();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','education','student'].concat(SD.map(function(p){return p[0];})).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('streets')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name)){var k=f.name.replace(/\\.[^.]+$/,'');files[k]=f;ids.push(k);}});\n    if(ids.length<2){app.innerHTML='<h1>Photos missing</h1><p>Upload the street photos to the media folder \"streets\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var valid=st&&st.order&&st.order.length===ids.length&&st.order.every(function(x){return files[x];});\n    if(!valid)st={step:'intro',order:shuffle(ids),k:0};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
