   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Schoolyard Trees</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Schoolyard Trees and Seasonal Foliage: Perceived Restoration\",\n  \"description\": \"Participants see twelve computer-rendered views of a planned schoolyard greening design in random order, each for at least 45 s, and rate each on Han's Short Version Revised Restoration Scale (SRRS: emotional, physiological, cognitive and behavioural items, 9-point scale). Scenes cross foliage (in-leaf green, in-leaf orange, leafless), two perspectives, and planting (deciduous only vs added evergreen conifers). Rebuilt from Paddle & Gilliland (2016), IJERPH 13(5): 497, with the paper's Figure 5 images and the item wording printed in its Figure 4 (CC BY 4.0). Scoring: reverse the two physiological items, average each subscale and the eight items; compare foliage conditions with paired tests and the leafless scenes with vs without evergreens.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"schoolyard\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part (and, if I am under 18, a parent or guardian has agreed too).\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"scenes\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"grouchy_good\",\n      \"title\": \"Grouchy - Good natured\",\n      \"rateMin\": 1,\n      \"rateMax\": 9,\n      \"minRateDescription\": \"Grouchy (very much)\",\n      \"maxRateDescription\": \"Good natured (very much)\",\n      \"isRequired\": true,\n      \"description\": \"SRRS emotional subscale. Keyed by scene: <foliage>_p<perspective>_<planting>, foliage = green (in-leaf green), orange (in-leaf autumn colours), leafless; perspective 1 or 2; planting = typical (deciduous only) or evergreen (3:1 deciduous to conifer). 9-point scale.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"anxious_relaxed\",\n      \"title\": \"Anxious - Relaxed\",\n      \"rateMin\": 1,\n      \"rateMax\": 9,\n      \"minRateDescription\": \"Anxious (very much)\",\n      \"maxRateDescription\": \"Relaxed (very much)\",\n      \"isRequired\": true,\n      \"description\": \"SRRS emotional subscale. Keyed by scene: <foliage>_p<perspective>_<planting>, foliage = green (in-leaf green), orange (in-leaf autumn colours), leafless; perspective 1 or 2; planting = typical (deciduous only) or evergreen (3:1 deciduous to conifer). 9-point scale.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"breathing_faster\",\n      \"title\": \"My breathing is becoming faster.\",\n      \"rateMin\": 1,\n      \"rateMax\": 9,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much so\",\n      \"isRequired\": true,\n      \"description\": \"SRRS physiological subscale (reverse-scored: 9 = least restorative). Keyed by scene: <foliage>_p<perspective>_<planting>, foliage = green (in-leaf green), orange (in-leaf autumn colours), leafless; perspective 1 or 2; planting = typical (deciduous only) or evergreen (3:1 deciduous to conifer). 9-point scale.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"hands_sweating\",\n      \"title\": \"My hands are sweating.\",\n      \"rateMin\": 1,\n      \"rateMax\": 9,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much so\",\n      \"isRequired\": true,\n      \"description\": \"SRRS physiological subscale (reverse-scored: 9 = least restorative). Keyed by scene: <foliage>_p<perspective>_<planting>, foliage = green (in-leaf green), orange (in-leaf autumn colours), leafless; perspective 1 or 2; planting = typical (deciduous only) or evergreen (3:1 deciduous to conifer). 9-point scale.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"interested\",\n      \"title\": \"I am interested in the presented scene.\",\n      \"rateMin\": 1,\n      \"rateMax\": 9,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much so\",\n      \"isRequired\": true,\n      \"description\": \"SRRS cognitive subscale. Keyed by scene: <foliage>_p<perspective>_<planting>, foliage = green (in-leaf green), orange (in-leaf autumn colours), leafless; perspective 1 or 2; planting = typical (deciduous only) or evergreen (3:1 deciduous to conifer). 9-point scale.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"attentive\",\n      \"title\": \"I feel attentive to the presented scene.\",\n      \"rateMin\": 1,\n      \"rateMax\": 9,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much so\",\n      \"isRequired\": true,\n      \"description\": \"SRRS cognitive subscale. Keyed by scene: <foliage>_p<perspective>_<planting>, foliage = green (in-leaf green), orange (in-leaf autumn colours), leafless; perspective 1 or 2; planting = typical (deciduous only) or evergreen (3:1 deciduous to conifer). 9-point scale.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"visit_more\",\n      \"title\": \"I would like to visit here more often.\",\n      \"rateMin\": 1,\n      \"rateMax\": 9,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much so\",\n      \"isRequired\": true,\n      \"description\": \"SRRS behavioural subscale. Keyed by scene: <foliage>_p<perspective>_<planting>, foliage = green (in-leaf green), orange (in-leaf autumn colours), leafless; perspective 1 or 2; planting = typical (deciduous only) or evergreen (3:1 deciduous to conifer). 9-point scale.\"\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"stay_longer\",\n      \"title\": \"I would like to stay here longer.\",\n      \"rateMin\": 1,\n      \"rateMax\": 9,\n      \"minRateDescription\": \"Not at all\",\n      \"maxRateDescription\": \"Very much so\",\n      \"isRequired\": true,\n      \"description\": \"SRRS behavioural subscale. Keyed by scene: <foliage>_p<perspective>_<planting>, foliage = green (in-leaf green), orange (in-leaf autumn colours), leafless; perspective 1 or 2; planting = typical (deciduous only) or evergreen (3:1 deciduous to conifer). 9-point scale.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 8,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Are you a…\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"girl_woman\",\n        \"text\": \"Girl / woman\"\n       },\n       {\n        \"value\": \"boy_man\",\n        \"text\": \"Boy / man\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"schoolyard-original\">{\"source\": \"Paddle & Gilliland (2016) International Journal of Environmental Research and Public Health 13(5): 497\", \"n\": 66, \"participants\": \"students (mean age 12.2) at an urban elementary school in London, Ontario; images projected in class, 45 s each, paper questionnaire\", \"result\": \"In-leaf orange and in-leaf green scenes were both rated more restorative than leafless scenes (mean differences 1.56 and 1.42 on the 9-point scale) and did not differ from each other; adding evergreen conifers raised ratings of the leafless scenes (+0.90) and the green scenes (+0.34) but not the orange ones. Most restorative: in-leaf orange, perspective 1; least: leafless, perspective 1.\"}</script>\n<style>\n:root{--bg:#f3f6f2;--card:#fff;--ink:#1f2620;--muted:#5e6a60;--accent:#c0661c;--line:#dbe1da;--warn:#b3261e;--sel:#fbeee2}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.1rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.photo{width:100%;max-width:620px;border-radius:8px;display:block;margin:0 auto 12px}\n.dim{margin-top:14px;font-style:italic;color:var(--ink)}\n.it{padding:8px 0}\n.it b{display:block;font-weight:500;margin-bottom:4px}\n.ends{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-top:2px}\n.row{display:grid;grid-template-columns:repeat(9,1fr);gap:4px}\n.row label{display:flex;flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:8px;padding:5px 0;cursor:pointer;font-size:.8rem}\n.row label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.row input{margin:0 0 2px}\n.timer{font-size:.85rem;color:var(--muted);margin-left:10px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:760px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Images: Paddle &amp; Gilliland (2016), International Journal of Environmental Research and Public Health 13(5): 497, Figure 5 (doi:10.3390/ijerph13050497, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='schoolyard-trees:state', VIEW=(window.__VIEWMS||45000);\n  var app=document.getElementById('app'), Q={}, files={}, ids=[], st=null, tick=null;\n  var BLOCKS=[['emotional',[['grouchy_good','Grouchy (very much)','Good natured (very much)']].concat([['anxious_relaxed','Anxious (very much)','Relaxed (very much)']])],\n    ['physiological',[['breathing_faster','My breathing is becoming faster.'],['hands_sweating','My hands are sweating.']]],\n    ['cognitive',[['interested','I am interested in the presented scene.'],['attentive','I feel attentive to the presented scene.']]],\n    ['behavioural',[['visit_more','I would like to visit here more often.'],['stay_longer','I would like to stay here longer.']]]];\n  var ITEMS=[];BLOCKS.forEach(function(b){b[1].forEach(function(i){ITEMS.push(i[0]);});});\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function item(it){var bip=it.length===3,L=bip?it[1]:'(not at all)',R=bip?it[2]:'(very much so)';\n    var h='<div class=\"it\">'+(bip?'':'<b>'+esc(it[1])+'</b>')+'<div class=\"row\">';for(var i=1;i<=9;i++)h+='<label><input type=\"radio\" name=\"q_'+it[0]+'\" value=\"'+i+'\">'+i+'</label>';\n    return h+'</div><div class=\"ends\"><span>'+esc(L)+'</span><span>'+esc(R)+'</span></div></div>';}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function intro(){\n    app.innerHTML='<h1>Schoolyard pictures</h1><p>You will see '+st.order.length+' pictures of a planned schoolyard with trees, one at a time. Look at each picture and imagine you are in that place. Then answer eight short questions about how you would feel, using numbers from 1 to 9. Each picture stays for at least 45 seconds. It takes about 15 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Please tick the box to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='trial';st.k=0;save();route();});};\n  }\n  function trial(){\n    var id=st.order[st.k];if(tick)clearInterval(tick);\n    app.innerHTML='<div class=\"prog\">Scene '+(st.k+1)+' of '+st.order.length+'</div><div class=\"card\"><img class=\"photo\" alt=\"Schoolyard picture\" src=\"'+esc(files[id].url)+'\">'+BLOCKS.map(function(b){return '<div class=\"dim\">Imagine you were in this scene. How would you describe your '+b[0]+' response?</div>'+b[1].map(item).join('');}).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\" disabled>Continue</button><span class=\"timer\" id=\"tm\"></span></div><div class=\"err\"></div></div>';\n    var t0=Date.now(),go=document.getElementById('go'),tm=document.getElementById('tm');\n    function upd(){var left=Math.ceil((VIEW-(Date.now()-t0))/1000);if(left<=0){go.disabled=false;tm.textContent='';clearInterval(tick);}else tm.textContent='Please keep looking at the picture: '+left+' s';}\n    upd();tick=setInterval(upd,250);\n    go.onclick=function(){\n      var vals=ITEMS.map(function(n){return val('q_'+n);});if(vals.some(function(x){return x==null;}))return err('Please answer all eight questions.');\n      var sh=[files[id].name];\n      send(ITEMS.map(function(n,i){return SPSite.answer(n,Number(vals[i]),{key:id,shown:sh});}),this,function(){st.k++;if(st.k>=st.order.length)st.step='about';save();route();});\n    };\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"8\" max=\"110\"></div><div class=\"f\"><b>'+esc(Q.gender.title)+'</b>'+Q.gender.choices.map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"gender\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var age=Number(document.getElementById('age').value),g=val('gender');\n      if(!(age>=8&&age<=110))return err('Please enter your age.');if(!g)return err('Please choose an option.');\n      send([SPSite.answer('age',age),SPSite.answer('gender',g)],this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='trial')return trial();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender'].concat(ITEMS).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('schoolyard')||[]).forEach(function(f){if(/\\.(png|jpe?g|webp)$/i.test(f.name)){var k=f.name.replace(/\\.[^.]+$/,'');files[k]=f;ids.push(k);}});\n    if(ids.length<2){app.innerHTML='<h1>Pictures missing</h1><p>Upload the pictures to the media folder \"schoolyard\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var valid=st&&st.order&&st.order.length===ids.length&&st.order.every(function(x){return files[x];});\n    if(!valid)st={step:'intro',order:shuffle(ids),k:0};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
