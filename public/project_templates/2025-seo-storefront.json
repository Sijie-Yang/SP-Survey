pg\"\n        ],\n        \"pairs\": [\n         {\n          \"key\": \"p1\",\n          \"a\": \"50% or less\",\n          \"b\": \"50–60% included\"\n         },\n         {\n          \"key\": \"p2\",\n          \"a\": \"50% or less\",\n          \"b\": \"60% or more\"\n         },\n         {\n          \"key\": \"p3\",\n          \"a\": \"50–60% included\",\n          \"b\": \"60% or more\"\n         }\n        ]\n       },\n       {\n        \"id\": \"colour_scheme\",\n        \"label\": \"Colour scheme\",\n        \"types\": [\n         \"2–6 colour schemes\",\n         \"7–8 colour schemes\",\n         \"9–12 colour schemes\"\n        ],\n        \"images\": [\n         \"type_colour_scheme.jpg\"\n        ],\n        \"pairs\": [\n         {\n          \"key\": \"p1\",\n          \"a\": \"2–6 colour schemes\",\n          \"b\": \"7–8 colour schemes\"\n         },\n         {\n          \"key\": \"p2\",\n          \"a\": \"2–6 colour schemes\",\n          \"b\": \"9–12 colour schemes\"\n         },\n         {\n          \"key\": \"p3\",\n          \"a\": \"7–8 colour schemes\",\n          \"b\": \"9–12 colour schemes\"\n         }\n        ]\n       },\n       {\n        \"id\": \"material_palette\",\n        \"label\": \"Material palette\",\n        \"types\": [\n         \"3 or fewer palette\",\n         \"4 palettes\",\n         \"5 or more palettes\"\n        ],\n        \"images\": [\n         \"type_material_palette.jpg\"\n        ],\n        \"pairs\": [\n         {\n          \"key\": \"p1\",\n          \"a\": \"3 or fewer palette\",\n          \"b\": \"4 palettes\"\n         },\n         {\n          \"key\": \"p2\",\n          \"a\": \"3 or fewer palette\",\n          \"b\": \"5 or more palettes\"\n         },\n         {\n          \"key\": \"p3\",\n          \"a\": \"4 palettes\",\n          \"b\": \"5 or more palettes\"\n         }\n        ]\n       }\n      ],\n      \"order\": \"fixed\"\n     }\n    ]\n   },\n   {\n    \"name\": \"sections\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"streetscape\",\n      \"title\": \"Please rate the scenery of this street section\",\n      \"isRequired\": false,\n      \"description\": \"Six photomontage section images of Gyeongridan-gil, Seoul (Left 1–3, Right 1–3; Table 7 of the paper), shown one at a time in the paper's order. Each is rated on 'Please check how much you prefer the scenery on that street?' (preference, 1–7) and 'Please check how complex you feel the street scene is?' (complexity, 1–7). One record per section, value {preference, complexity}, key = section id. Analysis as in the paper: mean preference and complexity per section, then the preference–complexity relation across sections (quadratic regression for an inverted U), optionally with repeated-measures ANOVA.\",\n      \"trials\": [\n       {\n        \"id\": \"left1\",\n        \"label\": \"Left 1\",\n        \"images\": [\n         \"section_left1.jpg\"\n        ]\n       },\n       {\n        \"id\": \"left2\",\n        \"label\": \"Left 2\",\n        \"images\": [\n         \"section_left2.jpg\"\n        ]\n       },\n       {\n        \"id\": \"left3\",\n        \"label\": \"Left 3\",\n        \"images\": [\n         \"section_left3.jpg\"\n        ]\n       },\n       {\n        \"id\": \"right1\",\n        \"label\": \"Right 1\",\n        \"images\": [\n         \"section_right1.jpg\"\n        ]\n       },\n       {\n        \"id\": \"right2\",\n        \"label\": \"Right 2\",\n        \"images\": [\n         \"section_right2.jpg\"\n        ]\n       },\n       {\n        \"id\": \"right3\",\n        \"label\": \"Right 3\",\n        \"images\": [\n         \"section_right3.jpg\"\n        ]\n       }\n      ],\n      \"order\": \"fixed\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#f1f2f4;--card:#fff;--ink:#1f2328;--muted:#5d646c;--accent:#2f5d8a;--accent-ink:#fff;--line:#d9dde2;--warn:#b3261e;--miss:#fdecea}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1000px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q>b{display:block;margin-bottom:4px}\n.q.miss{background:var(--miss);border-radius:10px;padding:6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.types img{display:block;width:100%;max-width:560px;margin:0 auto;border-radius:8px}\n.pano{overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:8px;background:#e5e7ea}\n.pano img{display:block;width:100%;min-width:0}\n.hint{font-size:.82rem;color:var(--muted);margin-top:4px;display:none}\n@media(max-width:700px){.pano img{width:auto;height:190px;max-width:none}.hint{display:block}}\n.it{padding:12px 6px;border-top:1px solid var(--line);border-radius:8px;margin-top:8px}\n.it .x{font-weight:500;margin-bottom:8px}\n.sc{display:grid;gap:4px}\n.sc label{display:flex;flex-direction:column;align-items:center;text-align:center;font-size:.82rem;color:var(--muted);cursor:pointer;padding:6px 2px;min-width:0;border:1px solid var(--line);border-radius:8px}\n.sc input{width:20px;height:20px;margin:0 0 4px}\n@media(max-width:600px){.sc.pw{grid-template-columns:1fr!important}.sc.pw label{flex-direction:row;gap:10px;text-align:left;padding:8px 10px}.sc.pw input{margin:0}}\n.ends{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);margin-top:4px}\n.it.miss{background:var(--miss)}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:1000px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Images: Seo, K. &amp; Park, J.-A. (2025), International Journal of Urban Sciences, Tables 3 and 7, doi:10.1080/12265934.2025.2529477 (authors' photographs of Gyeongridan-gil, Seoul, 2018). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='seo2025:';\n  var app=document.getElementById('app'), Q={}, files={}, ans={}, CO=[], SE=[], doneC={}, doneS={};\n  var PW=['much more visible','more visible','Equal','more visible','much more visible'];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function q(n){return Q[n]||{};}\n  function page(html,btn,cb){app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn)+'</button></div><div class=\"err\"></div>';document.getElementById('go').onclick=cb;app.onchange=function(e){hideErr();var r=e.target.closest&&e.target.closest('.it');if(r)r.classList.remove('miss');};}\n  function send(list,b,fin){b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}fin();});}\n  function progress(i,n,lab){return '<div class=\"top\"><span class=\"t\">'+esc(lab)+' '+(i+1)+' of '+n+'</span><div class=\"bar\"><i style=\"width:'+(100*i/n)+'%\"></i></div></div>';}\n  function collect(keys,fail){var v={},miss=[];keys.forEach(function(k){var x=app.querySelector('input[name=\"'+k+'\"]:checked'),r=app.querySelector('.it[data-k=\"'+k+'\"]');if(x){v[k]=Number(x.value);r.classList.remove('miss');}else{miss.push(r);r.classList.add('miss');}});if(miss.length){err(fail(miss.length));miss[0].scrollIntoView({block:'center'});return null;}return v;}\n  function next(){\n    window.scrollTo(0,0);\n    if(!ans.intro)return intro();\n    if(!ans.about)return about();\n    for(var i=0;i<CO.length;i++)if(!doneC[CO[i].id])return comp(CO[i],i);\n    for(var j=0;j<SE.length;j++)if(!doneS[SE[j].id])return section(SE[j],j);\n    finish();\n  }\n  function intro(){\n    var need=CO.concat(SE).map(function(g){return g.images[0];}).filter(function(n){return !files[n];});\n    if(need.length){app.innerHTML='<h1>Pictures missing</h1><p>Media folder storefronts must hold the 12 images of this study (missing: '+esc(need.join(', '))+').</p>';return;}\n    page('<h1>Storefronts and street scenery</h1><p>This survey is about the storefronts of Gyeongridan-gil, a commercial street in Seoul. First you compare versions of the same storefront and say which version is more visible. Then you rate six street sections for how much you like them and how complex they look.</p><p>It takes about 10 minutes. Your answers are anonymous and used only for research.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      send([SPSite.answer('consent',true)],this,function(){ans.intro=true;save('a',ans);next();});});\n  }\n  var DEMO=['gender','age','occupation'];\n  function about(){\n    page('<h1>About you</h1><div class=\"card\">'+DEMO.map(function(n,k){var d=q(n);return '<div class=\"q\" data-n=\"'+n+'\"'+(k?'':' style=\"margin-top:0\"')+'><b>'+esc(d.title)+'</b>'+(d.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+'</div>','Continue',function(){\n      var v={},miss=[];DEMO.forEach(function(n){var x=app.querySelector('input[name=\"'+n+'\"]:checked');var r=app.querySelector('.q[data-n=\"'+n+'\"]');if(x){v[n]=Number(x.value);r.classList.remove('miss');}else{miss.push(r);r.classList.add('miss');}});\n      if(miss.length){err('Please answer every question (marked in red).');miss[0].scrollIntoView({block:'center'});return;}\n      send(DEMO.map(function(n){return SPSite.answer(n,v[n]);}),this,function(){ans.about=true;save('a',ans);next();});});\n  }\n  function comp(g,i){\n    var f=files[g.images[0]];\n    var rows=g.pairs.map(function(p){return '<div class=\"it\" data-k=\"'+p.key+'\"><div class=\"x\">'+esc(p.a)+' <span style=\"color:var(--muted)\">vs</span> '+esc(p.b)+'</div><div class=\"sc pw\" style=\"grid-template-columns:repeat(5,minmax(0,1fr))\">'+PW.map(function(l,v){var who=v<2?p.a+' ':v>2?p.b+' ':'';return '<label><input type=\"radio\" name=\"'+p.key+'\" value=\"'+(v+1)+'\">'+esc(who+l)+'</label>';}).join('')+'</div></div>';}).join('');\n    page(progress(i,CO.length,'Storefront component')+'<div class=\"card\"><h1 style=\"margin-bottom:4px\">'+esc(g.label)+'</h1><p>'+esc(q('storefront_ahp').title)+'? The picture shows the same storefront in three types: '+g.types.map(esc).join(', ')+'.</p><div class=\"types\"><img alt=\"'+esc(g.label+': '+g.types.join(', '))+'\" src=\"'+esc(f.url)+'\"></div>'+rows+'</div>','Next',function(){\n      var v=collect(g.pairs.map(function(p){return p.key;}),function(n){return n+' comparison'+(n>1?'s are':' is')+' not answered yet (marked in red).';});if(!v)return;\n      send([SPSite.answer('storefront_ahp',v,{key:g.id,shown:[f.name]})],this,function(){doneC[g.id]=true;next();});});\n  }\n  function scale(key,text,lo,hi){var s='';for(var v=1;v<=7;v++)s+='<label><input type=\"radio\" name=\"'+key+'\" value=\"'+v+'\">'+v+'</label>';return '<div class=\"it\" data-k=\"'+key+'\"><div class=\"x\">'+esc(text)+'</div><div class=\"sc\" style=\"grid-template-columns:repeat(7,minmax(0,1fr))\">'+s+'</div><div class=\"ends\"><span>1 = '+esc(lo)+'</span><span>7 = '+esc(hi)+'</span></div></div>';}\n  function section(g,i){\n    var f=files[g.images[0]];\n    page(progress(i,SE.length,'Street section')+'<div class=\"card\"><h1 style=\"margin-bottom:8px\">Section '+esc(g.label)+'</h1><div class=\"pano\"><img alt=\"Street section '+esc(g.label)+'\" src=\"'+esc(f.url)+'\"></div><div class=\"hint\">Swipe the picture sideways to see the whole section.</div>'+scale('preference','Please check how much you prefer the scenery on that street?','not at all','very much')+scale('complexity','Please check how complex you feel the street scene is?','not complex at all','very complex')+'</div>','Next',function(){\n      var v=collect(['preference','complexity'],function(n){return 'Please answer both questions (marked in red).';});if(!v)return;\n      send([SPSite.answer('streetscape',v,{key:g.id,shown:[f.name]})],this,function(){doneS[g.id]=true;next();});});\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>In the original survey, 100 people rated these sections. Left 1 was preferred most (mean 4.06 of 7) and Left 2, the most complex section (4.80), was preferred least (3.70). Preference was highest at moderate complexity, an inverted U.</p><p style=\"font-size:.82rem\">Images and questions: Seo, K., &amp; Park, J.-A. (2025). Visual complexity and preference in commercialized residential streetscapes: a case study of ground floor storefronts in Gyeongridan-gil, Seoul. International Journal of Urban Sciences, doi:10.1080/12265934.2025.2529477.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')ans.intro=false;else if(x==='storefront_ahp')doneC={};else if(x==='streetscape')doneS={};else ans.about=false;});save('a',ans);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    var SPEC;try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='storefront_ahp')CO=e.trials;if(e.name==='streetscape')SE=e.trials;});});\n    (SPSite.getMedia('storefronts')||[]).forEach(function(f){files[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};ans=load('a')||{};\n    ((a.storefront_ahp&&a.storefront_ahp.trials)||[]).forEach(function(t){if(t.key)doneC[t.key]=true;});\n    ((a.streetscape&&a.streetscape.trials)||[]).forEach(function(t){if(t.key)doneS[t.key]=true;});\n    ans.intro=a.consent===true;ans.about=a.gender!=null&&a.occupation!=null;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
