   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Urban Rewilding Scenarios</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Urban Rewilding Scenarios: Choosing a Design Option\",\n  \"description\": \"Participants see two places in Sopot, Poland (a pedestrian bridge in a park and the central plaza), in random order. For each place they see three photomontage design options side by side (signature landscape / moderate rewilding / intensive rewilding) and choose the one they prefer. Rebuilt from Cirella, Kempa, Paczoski & Rosciszewski-Dodgson (2026), Scientific Reports 16: 2792, using the paper's Figure 1 unaltered (CC BY-NC-ND 4.0). Analysis: share of each option per place, chi-square test of option x place.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"rewilding\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part in this short survey. My answers are anonymous.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"scenarios\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"rewilding_choice\",\n      \"title\": \"Which design option do you prefer for this place?\",\n      \"isRequired\": true,\n      \"description\": \"Keyed by place: bridge (Scenario 1, pedestrian bridge between buildings in a park) or plaza (Scenario 2, Sopot's central plaza). Options in the order of the paper's figure.\",\n      \"choices\": [\n       {\n        \"value\": \"signature\",\n        \"text\": \"Signature landscape (minimal rewilding)\"\n       },\n       {\n        \"value\": \"moderate\",\n        \"text\": \"Moderate rewilding\"\n       },\n       {\n        \"value\": \"intensive\",\n        \"text\": \"Intensive rewilding\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"resident\",\n      \"title\": \"Do you live in Sopot?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 18,\n      \"max\": 110\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"What is your gender?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"woman\",\n        \"text\": \"Woman\"\n       },\n       {\n        \"value\": \"man\",\n        \"text\": \"Man\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"rewild-original\">{\"source\": \"Cirella, Kempa, Paczoski & Rosciszewski-Dodgson (2026) Scientific Reports 16: 2792\", \"n\": 1000, \"participants\": \"residents of Sopot, Poland, quota-based by age, gender and neighbourhood; face-to-face with poster boards, June-August 2024; scenario order alternated between respondents\", \"result\": \"Moderate rewilding was preferred in both places (bridge 58.7%, plaza 47.9%); intensive rewilding 27.0% at the bridge and 41.4% at the plaza; signature landscape 14.3% and 10.7%. Preferences differed between places (chi-square = 63.48, df = 2, p < 0.001, Cramer's V = 0.178).\"}</script>\n<style>\n:root{--bg:#f1f4ef;--card:#fff;--ink:#1e2a1f;--muted:#5b6a5c;--accent:#3d6b35;--line:#d6ded4;--warn:#b3261e;--sel:#e4efe0}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1040px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.opts{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}\n@media(max-width:700px){.opts{grid-template-columns:1fr}}\n.opt3{border:2px solid var(--line);border-radius:12px;overflow:hidden;cursor:pointer;background:#fff;display:flex;flex-direction:column}\n.opt3:has(input:checked){border-color:var(--accent);background:var(--sel)}\n.crop{position:relative;overflow:hidden;width:100%}\n.crop img{position:absolute;max-width:none;display:block}\n.cap{padding:8px 10px;font-size:.9rem}\n.cap b{display:block;font-size:1rem}\n.cap input{margin-right:6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:1040px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Visual scenarios: Cirella, Kempa, Paczoski &amp; Rościszewski-Dodgson (2026), Scientific Reports 16: 2792, Figure 1 (doi:10.1038/s41598-025-32655-x, CC BY-NC-ND 4.0). The figure is shown unaltered; each panel is a view of the same file.</footer>\n<script>\n(function(){\n  var KEY='urban-rewilding:state', FIG='sopot_rewilding_fig1';\n  /* panel boxes in the 1950 x 1097 figure: x0,y0,x1,y1 */\n  var COLS=[[13,1,645],[658,1,1291],[1303,1,1935]], ROWS={bridge:[49,541],plaza:[599,1038]}, W=1950, H=1097;\n  var SC={bridge:'A pedestrian bridge between buildings, in a park',plaza:'Sopot’s central plaza'};\n  var OPT=[['signature','Signature landscape (“minimal rewilding”)','Controlled, ornamental plantings and manicured green spaces, as in conventional maintenance.'],\n           ['moderate','Moderate rewilding','More diverse, pollinator-friendly planting and low habitats, while keeping visible design order and access.'],\n           ['intensive','Intensive rewilding','Dense, naturalistic vegetation with minimal human intervention, close to urban wilderness.']];\n  var app=document.getElementById('app'), Q={}, fig=null, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function crop(row,i){var c=COLS[i],r=ROWS[row],w=c[2]-c[0],h=r[1]-r[0];\n    return '<div class=\"crop\" style=\"padding-top:'+(h/w*100).toFixed(3)+'%\"><img alt=\"Design option '+(i+1)+'\" src=\"'+esc(fig.url)+'\" style=\"width:'+(W/w*100).toFixed(3)+'%;left:'+(-c[0]/w*100).toFixed(3)+'%;top:'+(-r[0]/h*100).toFixed(3)+'%\"></div>';}\n  function intro(){\n    app.innerHTML='<h1>Greener public spaces</h1><p>You will see two places in the city of Sopot, Poland: a pedestrian bridge in a park and the central plaza. For each place there are three design options, from conventional ornamental planting to dense, wild vegetation. Choose the option you prefer for each place. It takes about 3 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='scene';st.k=0;save();route();});};\n  }\n  function scene(){\n    var row=st.order[st.k];\n    app.innerHTML='<div class=\"prog\">Place '+(st.k+1)+' of '+st.order.length+'</div><h2>'+esc(SC[row])+'</h2><p style=\"color:var(--ink)\">'+esc(Q.rewilding_choice.title)+'</p><div class=\"opts\">'+OPT.map(function(o,i){return '<label class=\"opt3\">'+crop(row,i)+'<div class=\"cap\"><b><input type=\"radio\" name=\"pick\" value=\"'+o[0]+'\">'+esc(o[1])+'</b>'+esc(o[2])+'</div></label>';}).join('')+'</div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div>';\n    document.getElementById('go').onclick=function(){\n      var p=val('pick');if(!p)return err('Please choose one of the three options.');\n      send([SPSite.answer('rewilding_choice',p,{key:row,shown:[fig.name]})],this,function(){st.k++;if(st.k>=st.order.length)st.step='about';save();route();});\n    };\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+radios('resident').replace('class=\"f\"','class=\"f\" style=\"margin-top:0\"')+'<div class=\"f\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"110\"></div>'+radios('gender')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var r=val('resident'),age=Number(document.getElementById('age').value),g=val('gender');\n      if(!r)return err('Please answer every question.');if(!(age>=18&&age<=110))return err('Please enter your age.');if(!g)return err('Please answer every question.');\n      send([SPSite.answer('resident',r),SPSite.answer('age',age),SPSite.answer('gender',g)],this,function(){st.step='done';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='scene')return scene();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','rewilding_choice','resident','age','gender'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('rewilding')||[]).forEach(function(f){if(f.name.replace(/\\.[^.]+$/,'')===FIG)fig=f;});\n    if(!fig){app.innerHTML='<h1>Figure missing</h1><p>Upload '+FIG+'.jpg to the media folder \"rewilding\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!(st&&st.order&&st.order.length===2))st={step:'intro',order:Math.random()<0.5?['bridge','plaza']:['plaza','bridge'],k:0};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
