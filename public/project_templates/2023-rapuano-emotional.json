   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Emotional Reactions to Rooms</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Emotional Reactions to Rooms\",\n  \"description\": \"Faithful replication with the original renderings: five bedrooms of 9 m2 designed by architects at the University of Campania L. Vanvitelli, all with the same bed, table, chair, armchair, wardrobe and window onto building facades in the same layout and viewpoint, differing only in colours, materials, textures and furniture style: Basic (white and blue colours, plastic and metal furniture), Modern (white and cold colours, good-quality essential coverings), Comfort (shades of blue and green, velvet coverings), Vivacious (red, blue and green elements, soft-textured materials) and Nature (brown, orange and green colours, wood furniture and leather coverings). Participants give their gender and age, then see the five rooms one at a time in individually randomized order, as in the paper, with the paper's 6-item questionnaire below each picture (Appendix A: How much the IMAGE you just saw makes you feel: calm, nervous, tired, energetic, happy, sad), each on a 9-point scale from 1 = not at all to 9 = extremely. Rebuilt from Rapuano, Sarno, Ruotolo, Ruggiero, Iuliano, Masullo, Maffei, Cioffi & Iachini (2023), Emotional Reactions to Different Indoor Solutions: The Role of Age, Buildings 13(7): 1737, with the renderings cropped from its Figure 1B and the questionnaire from its Appendix A (CC BY 4.0). Image ids: a_basic, b_modern, c_comfort, d_vivacious, e_nature (panels a-e of Figure 1B); answers are in emotions, keyed by image id. Analysis as in the paper: participants grouped by age (younger adults 19-29, adults 30-45, middle-aged adults 46-65, elderly 66 and over) and 4 x 5 mixed ANOVAs on each adjective with age group between and room within subjects, plus age x adjective ANOVAs within each room; the paper (113 participants aged 19-86, online on PsyToolkit, about 10 minutes) found the Nature and Vivacious rooms evoked more happiness and energy and the Basic and Modern rooms more sadness and tiredness, the Basic room more nervousness than the Comfort, Vivacious and Nature rooms, and elderly participants reporting more happiness and energy overall and finding the Basic room less calming. Differences from the original study: (1) the paper recruited by word of mouth and ran on PsyToolkit; here anyone can take part; (2) the gender and age questions and the instruction text are ours; the paper reports gender and age in years; (3) the renderings are the figure copies (about 990 px wide for rooms a-c and 1475 px for rooms d and e, as printed).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"rooms\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"inputType\": \"number\",\n      \"name\": \"age\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"min\": 16,\n      \"max\": 110\n     }\n    ]\n   },\n   {\n    \"name\": \"rooms\",\n    \"elements\": [\n     {\n      \"type\": \"matrix\",\n      \"name\": \"emotions\",\n      \"title\": \"How much the IMAGE you just saw makes you feel:\",\n      \"isRequired\": true,\n      \"rows\": [\n       {\n        \"value\": \"calm\",\n        \"text\": \"CALM\"\n       },\n       {\n        \"value\": \"nervous\",\n        \"text\": \"NERVOUS\"\n       },\n       {\n        \"value\": \"tired\",\n        \"text\": \"TIRED\"\n       },\n       {\n        \"value\": \"energetic\",\n        \"text\": \"ENERGETIC\"\n       },\n       {\n        \"value\": \"happy\",\n        \"text\": \"HAPPY\"\n       },\n       {\n        \"value\": \"sad\",\n        \"text\": \"SAD\"\n       }\n      ],\n      \"columns\": [\n       {\n        \"value\": 1,\n        \"text\": \"1\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"6\"\n       },\n       {\n        \"value\": 7,\n        \"text\": \"7\"\n       },\n       {\n        \"value\": 8,\n        \"text\": \"8\"\n       },\n       {\n        \"value\": 9,\n        \"text\": \"9\"\n       }\n      ],\n      \"description\": \"1 = not at all, 9 = extremely. Keyed by image id.\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"room-original\">{\"source\": \"Rapuano et al. (2023) Buildings 13: 1737\", \"n\": 113, \"images\": [\"a_basic\", \"b_modern\", \"c_comfort\", \"d_vivacious\", \"e_nature\"], \"names\": {\"a_basic\": \"Basic room\", \"b_modern\": \"Modern room\", \"c_comfort\": \"Comfort room\", \"d_vivacious\": \"Vivacious room\", \"e_nature\": \"Nature room\"}, \"age_groups\": {\"younger adults\": [19, 29], \"adults\": [30, 45], \"middle-aged adults\": [46, 65], \"elderly\": [66, 89]}}</script>\n<style>\n:root{--bg:#eef0f3;--card:#fff;--ink:#1c1f24;--muted:#5a606a;--accent:#3d5a80;--line:#d6dbe2;--warn:#b3261e;--sel:#dde6f1}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.08rem;margin:0 0 4px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.prompt{font-size:.92rem;color:var(--muted);margin:6px 0 0;text-align:center}\n.scene{position:sticky;top:0;z-index:3;background:var(--bg);padding-bottom:6px}\n.scene img{max-width:100%;max-height:42vh;width:auto;height:auto;display:block;margin:0 auto;border-radius:10px}\n@media (max-height:700px),(max-width:600px){.scene{position:static}}\n.it{padding:10px 0;border-top:1px solid var(--line)}\n.it .st{font-weight:600;margin-bottom:6px;font-size:.96rem}\n.it .o{display:grid;grid-template-columns:repeat(9,minmax(0,1fr));gap:4px}\n.it label{display:flex;justify-content:center;align-items:center;text-align:center;gap:4px;border:1px solid var(--line);border-radius:8px;padding:7px 4px;cursor:pointer;font-size:.84rem;line-height:1.25}\n.it label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.it label input{display:none}.it .an{display:flex;justify-content:space-between;font-size:.74rem;color:var(--muted);margin-top:3px}@media (max-width:480px){.it .o{gap:3px}.it label{padding:9px 0;font-size:.86rem}}\n.it .an{display:flex;justify-content:space-between;font-size:.74rem;color:var(--muted);margin-top:3px}\n.it.miss .o,.q.miss{outline:2px solid var(--warn);outline-offset:2px;border-radius:8px}\n.q{margin-top:16px}.q:first-child{margin-top:0}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\ninput[type=text]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:100%;max-width:420px;margin-top:6px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Renderings and questionnaire: Rapuano, Sarno, Ruotolo, Ruggiero, Iuliano, Masullo, Maffei, Cioffi &amp; Iachini (2023), Buildings 13(7): 1737, Figure 1B and Appendix A (doi:10.3390/buildings13071737, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='indoor-rooms-emotion:state';\n  var ORIG=JSON.parse(document.getElementById('room-original').textContent), IDS=ORIG.images;\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function fresh(){return {step:'intro',order:shuffle(IDS),k:0};}\n  function intro(){\n    app.innerHTML='<h1>Rooms and feelings</h1><p>You will see pictures of five bedrooms, one at a time. Look at each picture and rate how much it makes you feel each of six feelings. It takes about 10 minutes.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"q\" data-q=\"gender\"><b>'+esc(Q.gender.title)+'</b>'+(Q.gender.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"gender\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div><div class=\"q\" data-q=\"age\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"16\" max=\"110\" style=\"font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px;margin-top:6px\"></div><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var age=Number(document.getElementById('age').value),g=app.querySelector('input[name=gender]:checked');if(!g)return err('Please choose your gender.');if(!(age>=16&&age<=110))return err('Please enter your age.');\n      send([SPSite.answer('gender',g.value),SPSite.answer('age',age)],this,function(){st.step='room';st.k=0;save();route();});};\n  }\n  function room(){\n    if(st.k>=st.order.length){st.step='done';save();return route();}\n    var id=st.order[st.k],f=files[id],q=Q.emotions;\n    app.innerHTML='<div class=\"prog\">Room '+(st.k+1)+' of '+st.order.length+'</div><div class=\"scene\"><img alt=\"Rendered bedroom\" src=\"'+esc(f.url)+'\"></div>'+\n      '<div class=\"card\"><h2>'+esc(q.title)+'</h2>'+(q.rows||[]).map(function(r){var nm='c__'+r.value;\n      return '<div class=\"it\" data-n=\"'+nm+'\"><div class=\"st\">'+esc(r.text)+'</div><div class=\"o\">'+[1,2,3,4,5,6,7,8,9].map(function(v){return '<label><input type=\"radio\" name=\"'+nm+'\" value=\"'+v+'\">'+v+'</label>';}).join('')+'</div><div class=\"an\"><span>1 Not at all</span><span>9 Extremely</span></div></div>';}).join('')+'</div>'+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">'+(st.k<st.order.length-1?'Next picture':'Finish')+'</button></div><div class=\"err\"></div>';\n    document.getElementById('go').onclick=function(){\n      var a={},miss=[];(q.rows||[]).forEach(function(r){var nm='c__'+r.value,x=app.querySelector('input[name=\"'+nm+'\"]:checked');if(x)a[r.value]=Number(x.value);else miss.push(app.querySelector('.it[data-n=\"'+nm+'\"]'));});\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please rate every feeling.');}\n      send([SPSite.answer('emotions',a,{key:id,shown:[f.name]})],this,function(){st.k++;save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var r=e.target.closest&&e.target.closest('.it');if(r){r.classList.remove('miss');if(!app.querySelector('.it.miss'))err('');}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='room')return room();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','gender','age','emotions'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{name:n};});\n    (SPSite.getMedia('rooms')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=IDS.filter(function(k){return !files[k];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"rooms\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.order)||a.consent!==true)st=fresh();\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
