   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Road Green Space Beauty</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Road Green Space Scenic Beauty (SBE) in Yangling\",\n  \"description\": \"Faithful replication of Si, Mu & Han (2024), Forests 15:2008: rate the scenic beauty of 13 photographed road green spaces in Yangling, China (SBE, 5 levels); landscape professionals also score eight landscape character indicators.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"plots\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"intro\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part voluntarily and know I can stop at any time.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"respondent_group\",\n      \"title\": \"Which describes you?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Member of the public\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Landscape professional (landscape architecture, horticulture, planning or design)\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"scenes\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"sbe_rating\",\n      \"title\": \"Scenic beauty of each road green space\",\n      \"isRequired\": false,\n      \"description\": \"Scenic Beauty Estimation (SBE): 13 photographs of road green space sample points in Yangling, China (G grass, S shrub, T tree; Z traffic separation zone, R roadside greenbelt, A avenue greenbelt), shown one at a time in random order. Everyone rates how much they like the scene on 5 levels: 1 very dislike, 2 not too much, 3 average, 4 more like, 5 like. Landscape professionals additionally score the paper's eight landscape character indicators (Table 1, 1–5 each). Value: {sbe} for the public, {sbe, floristics, configuration, canopy_density, growing_status, leaf, vertical_greening, spatial, harmony} for professionals. Analysis as in the paper: per participant z-standardise SBE scores, average per sample point = SBE value; standardised mean of the eight indicators = landscape character value; Scenic Beauty Index SBI = 0.5 × SBE + 0.5 × character value.\",\n      \"sbeChoices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Very dislike\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Not too much\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Average\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"More like\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"Like\"\n       }\n      ],\n      \"items\": [\n       {\n        \"key\": \"floristics\",\n        \"text\": \"Floristics (number of plant species)\",\n        \"levels\": [\n         \"1 species\",\n         \"2 species\",\n         \"3 species\",\n         \"4 species\",\n         \"More than 4 species\"\n        ]\n       },\n       {\n        \"key\": \"configuration\",\n        \"text\": \"Configuration structure (life forms)\",\n        \"levels\": [\n         \"Grass/Shrub\",\n         \"Shrub/Grass\",\n         \"Tree/Grass\",\n         \"Tree/Shrub\",\n         \"Tree/Shrub/Grass\"\n        ]\n       },\n       {\n        \"key\": \"canopy_density\",\n        \"text\": \"Canopy density (degree of ground coverage)\",\n        \"levels\": [\n         \"≤20%\",\n         \"20%–40%\",\n         \"40%–60%\",\n         \"60%–80%\",\n         \"≥80%\"\n        ]\n       },\n       {\n        \"key\": \"growing_status\",\n        \"text\": \"Growing status (health and growth)\",\n        \"levels\": [\n         \"Declining\",\n         \"Fair\",\n         \"Better\",\n         \"Healthy\",\n         \"Lush\"\n        ]\n       },\n       {\n        \"key\": \"leaf\",\n        \"text\": \"Leaf characteristic\",\n        \"levels\": [\n         \"Unattractive\",\n         \"Less attractive\",\n         \"Average\",\n         \"Rather attractive\",\n         \"Very attractive\"\n        ]\n       },\n       {\n        \"key\": \"vertical_greening\",\n        \"text\": \"Vertical greening effect\",\n        \"levels\": [\n         \"None\",\n         \"Single\",\n         \"Rather single\",\n         \"Rather diverse\",\n         \"Diverse\"\n        ]\n       },\n       {\n        \"key\": \"spatial\",\n        \"text\": \"Spatial characterization (openness, order)\",\n        \"levels\": [\n         \"Dispersed\",\n         \"Rather dispersed\",\n         \"Medium\",\n         \"Rather coordinated\",\n         \"Coordinated\"\n        ]\n       },\n       {\n        \"key\": \"harmony\",\n        \"text\": \"Environmental harmonization (fit with surroundings)\",\n        \"levels\": [\n         \"Dysfunctional\",\n         \"Rather dysfunctional\",\n         \"Moderate\",\n         \"Rather harmonious\",\n         \"Harmonious\"\n        ]\n       }\n      ],\n      \"trials\": [\n       {\n        \"id\": \"g_r\",\n        \"label\": \"Sample point G-R\",\n        \"image\": \"g_r.jpg\"\n       },\n       {\n        \"id\": \"s_z\",\n        \"label\": \"Sample point S-Z\",\n        \"image\": \"s_z.jpg\"\n       },\n       {\n        \"id\": \"s_r\",\n        \"label\": \"Sample point S-R\",\n        \"image\": \"s_r.jpg\"\n       },\n       {\n        \"id\": \"sg_a1\",\n        \"label\": \"Sample point SG-A1\",\n        \"image\": \"sg_a1.jpg\"\n       },\n       {\n        \"id\": \"sg_a2\",\n        \"label\": \"Sample point SG-A2\",\n        \"image\": \"sg_a2.jpg\"\n       },\n       {\n        \"id\": \"ts_z\",\n        \"label\": \"Sample point TS-Z\",\n        \"image\": \"ts_z.jpg\"\n       },\n       {\n        \"id\": \"ts_a\",\n        \"label\": \"Sample point TS-A\",\n        \"image\": \"ts_a.jpg\"\n       },\n       {\n        \"id\": \"tg_r\",\n        \"label\": \"Sample point TG-R\",\n        \"image\": \"tg_r.jpg\"\n       },\n       {\n        \"id\": \"tg_a\",\n        \"label\": \"Sample point TG-A\",\n        \"image\": \"tg_a.jpg\"\n       },\n       {\n        \"id\": \"tsg_a\",\n        \"label\": \"Sample point TSG-A\",\n        \"image\": \"tsg_a.jpg\"\n       },\n       {\n        \"id\": \"tsg_r1\",\n        \"label\": \"Sample point TSG-R1\",\n        \"image\": \"tsg_r1.jpg\"\n       },\n       {\n        \"id\": \"tsg_r2\",\n        \"label\": \"Sample point TSG-R2\",\n        \"image\": \"tsg_r2.jpg\"\n       },\n       {\n        \"id\": \"tsg_r3\",\n        \"label\": \"Sample point TSG-R3\",\n        \"image\": \"tsg_r3.jpg\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#edf0ea;--card:#fff;--ink:#1f251d;--muted:#5b6457;--accent:#3b6b2f;--accent-ink:#fff;--line:#d7ddd2;--warn:#b3261e;--miss:#fdecea}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q>b{display:block;margin-bottom:4px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.pic{background:#e1e5de;border-radius:12px;overflow:hidden}.pic img{width:100%;max-height:min(55vh,500px);object-fit:contain;display:block}\n.it{padding:10px 6px;border-top:1px solid var(--line);border-radius:8px}\n.it .x{font-weight:500;margin-bottom:6px}\n.sc{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px}\n.sc label{display:flex;flex-direction:column;align-items:center;text-align:center;font-size:.8rem;line-height:1.2;color:var(--muted);cursor:pointer;padding:2px 0;min-width:0;overflow-wrap:anywhere}\n.sc input{width:20px;height:20px;margin:0 0 3px}\n.sc label span{display:block}\n@media(max-width:600px){.sc.lv{grid-template-columns:1fr;gap:2px}.sc.lv label{flex-direction:row;gap:8px;text-align:left;font-size:.88rem;padding:4px 6px;border:1px solid var(--line);border-radius:8px}.sc.lv input{margin:0}}\n.it.miss{background:var(--miss)}\n.sub{margin:14px 0 2px;font-weight:600}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Si, Mu &amp; Han (2024), Forests 15:2008, Figure 5, doi:10.3390/f15112008 (CC BY 4.0; road green spaces in Yangling, Shaanxi, China). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='siroad2024:';\n  var app=document.getElementById('app'), Q={}, files={}, ans={}, TR=[], ITEMS=[], SBE=[], done={}, ORDER=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function q(n){return Q[n]||{};}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function page(html,btn,cb){app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn)+'</button></div><div class=\"err\"></div>';document.getElementById('go').onclick=cb;app.onchange=hideErr;}\n  function send(list,b,fin){b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}fin();});}\n  function byId(id){for(var i=0;i<TR.length;i++)if(TR[i].id===id)return TR[i];}\n  function pro(){return ans.group===2;}\n  function next(){\n    window.scrollTo(0,0);\n    if(!ans.intro)return intro();\n    if(!ans.group)return about();\n    for(var i=0;i<ORDER.length;i++)if(!done[ORDER[i]])return scene(byId(ORDER[i]),i);\n    finish();\n  }\n  function intro(){\n    var miss=TR.some(function(t){return !files[t.image];});\n    if(miss){app.innerHTML='<h1>Pictures missing</h1><p>Media folder plots must hold the 13 road green space photographs (g_r.jpg … tsg_r3.jpg).</p>';return;}\n    page('<h1>How beautiful are these roadside plantings?</h1><p>You will see 13 photographs of plantings along roads in Yangling, a city in Shaanxi, China. For each one, say how much you like it. Landscape professionals will also be asked to score a few features of the planting.</p><p>It takes about 5 minutes (about 15 for professionals). Your answers are anonymous and used only for research.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      send([SPSite.answer('consent',true)],this,function(){ans.intro=true;save('a',ans);next();});});\n  }\n  function about(){\n    var d=q('respondent_group');\n    page('<h1>About you</h1><div class=\"card\"><div class=\"q\" style=\"margin-top:0\"><b>'+esc(d.title)+'</b>'+(d.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"grp\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div></div>','Continue',function(){\n      var x=app.querySelector('input[name=grp]:checked');if(!x)return err('Please choose one answer.');\n      var g=Number(x.value);\n      send([SPSite.answer('respondent_group',g)],this,function(){ans.group=g;save('a',ans);next();});});\n  }\n  function row(key,text,levels,lv){return '<div class=\"it\" data-k=\"'+key+'\"><div class=\"x\">'+esc(text)+'</div><div class=\"sc'+(lv?' lv':'')+'\" role=\"radiogroup\" aria-label=\"'+esc(text)+'\">'+levels.map(function(l,v){return '<label><input type=\"radio\" name=\"'+key+'\" value=\"'+(v+1)+'\"><span>'+(v+1)+' · '+esc(l)+'</span></label>';}).join('')+'</div></div>';}\n  function scene(t,i){\n    var f=files[t.image];\n    var keys=['sbe'],rows=row('sbe','How much do you like this scene?',SBE.map(function(c){return c.text;}));\n    if(pro()){rows+='<p class=\"sub\">Landscape character (professionals)</p>'+ITEMS.map(function(it){return row(it.key,it.text,it.levels,1);}).join('');keys=keys.concat(ITEMS.map(function(it){return it.key;}));}\n    page('<div class=\"top\"><span class=\"t\">Scene '+(i+1)+' of '+TR.length+'</span><div class=\"bar\"><i style=\"width:'+(100*i/TR.length)+'%\"></i></div></div><div class=\"card\"><div class=\"pic\"><img alt=\"Road green space in Yangling\" src=\"'+esc(f.url)+'\"></div>'+rows+'</div>',i===TR.length-1?'Finish':'Next',function(){\n      var v={},miss=[];\n      keys.forEach(function(k){var x=app.querySelector('input[name=\"'+k+'\"]:checked');var r=app.querySelector('.it[data-k=\"'+k+'\"]');if(x){v[k]=Number(x.value);r.classList.remove('miss');}else{miss.push(r);r.classList.add('miss');}});\n      if(miss.length){err(miss.length+' question'+(miss.length>1?'s are':' is')+' not answered yet (marked in red).');miss[0].scrollIntoView({block:'center'});return;}\n      send([SPSite.answer('sbe_rating',v,{key:t.id,shown:[f.name]})],this,function(){done[t.id]=true;next();});});\n    app.onchange=function(e){hideErr();var r=e.target.closest&&e.target.closest('.it');if(r)r.classList.remove('miss');};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>In the original study, 201 members of the public rated these scenes and 40 professionals scored their landscape character. Scenes with many plant species, a full tree–shrub–grass structure, saturated leaf colours and orderly space were liked most; empty or messy scenes with few species were liked least. The avenue greenbelt with large scholartrees over shrubs (TS-A) had the highest Scenic Beauty Index and the single-layer grass sculpture (G-R) the lowest.</p><p style=\"font-size:.82rem\">Photographs and method: Si, M., Mu, Y., &amp; Han, Y. (2024). Road Landscape Design: Harmonious Relationship Between Ecology and Aesthetics. Forests 15:2008, doi:10.3390/f15112008.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')ans.intro=false;else if(x==='sbe_rating')done={};else ans.group=0;});save('a',ans);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    var SPEC;try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='sbe_rating'){TR=e.trials;ITEMS=e.items;SBE=e.sbeChoices;}});});\n    (SPSite.getMedia('plots')||[]).forEach(function(f){files[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};ans=load('a')||{};\n    ORDER=load('o');if(!ORDER||ORDER.length!==TR.length){ORDER=shuffle(TR.map(function(t){return t.id;}));save('o',ORDER);}\n    ((a.sbe_rating&&a.sbe_rating.trials)||[]).forEach(function(t){if(t.key)done[t.key]=true;});\n    ans.intro=a.consent===true;if(a.respondent_group!=null)ans.group=Number(a.respondent_group);\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
