   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Curved vs Angular Living Rooms</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Curved vs Angular Living Rooms\",\n    \"description\": \"Four photo-realistic living rooms in a 2 × 2 design: angular vs curved furniture and windows (contour) × modern vs classic style. Task 1 rates the door view of each room on six 0–100 scales (edginess, roundness, curiosity, novelty, order, complexity). Task 2 rates all 20 views (5 per room) on beauty, liking, restfulness and stress, one dimension per block. Rebuilt from Tawil, Ascone and Kühn (2022), Frontiers in Psychology, with the authors' renders from OSF mfpk2.\",\n    \"locale\": \"en\",\n    \"mediaFolders\": [\"rooms\"],\n    \"pages\": [\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" },\n        { \"type\": \"radiogroup\", \"name\": \"sex\", \"title\": \"Sex\", \"isRequired\": true, \"choices\": [ { \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"male\", \"text\": \"Male\" } ] },\n        { \"type\": \"number\", \"name\": \"age\", \"title\": \"Age (years)\", \"min\": 18, \"max\": 99, \"isRequired\": true },\n        { \"type\": \"radiogroup\", \"name\": \"design_profession\", \"title\": \"Do you work in architecture or interior design?\", \"isRequired\": true, \"choices\": [ { \"value\": \"yes\", \"text\": \"Yes\" }, { \"value\": \"no\", \"text\": \"No\" } ] }\n      ]},\n      { \"name\": \"general_appraisal\", \"elements\": [\n        { \"type\": \"imageslidergroup\", \"name\": \"gas\", \"title\": \"General appraisal of each room (door view)\", \"description\": \"Rating task 1 (GAS). One record per room: key = image id (r1a_15 angular modern, r1c_15 curved modern, r2a_15 angular classic, r2c_15 curved classic; columns of ac_dataset_manipulation_check.xlsx on OSF mfpk2). Rooms in random order; the six scales always in this order, one per screen. 0–100 visual analogue scale, numbers hidden.\", \"imageCount\": 1, \"scaleMin\": 0, \"scaleMax\": 100, \"isRequired\": true, \"dimensions\": [\n          { \"id\": \"edginess\", \"label\": \"How edgy do you perceive this room to be?\", \"left\": \"Not edgy at all\", \"right\": \"Very edgy\", \"min\": 0, \"max\": 100, \"step\": 1 },\n          { \"id\": \"roundness\", \"label\": \"How round do you perceive this room to be?\", \"left\": \"Not round at all\", \"right\": \"Very round\", \"min\": 0, \"max\": 100, \"step\": 1 },\n          { \"id\": \"curiosity\", \"label\": \"How much curiosity does this room arouse in you?\", \"left\": \"Arouses no curiosity at all\", \"right\": \"Arouses a lot of curiosity\", \"min\": 0, \"max\": 100, \"step\": 1 },\n          { \"id\": \"novelty\", \"label\": \"How novel does this room seem to you?\", \"left\": \"Not novel at all\", \"right\": \"Very novel\", \"min\": 0, \"max\": 100, \"step\": 1 },\n          { \"id\": \"order\", \"label\": \"How structured / ordered do you perceive this room to be?\", \"left\": \"Very unstructured / disordered\", \"right\": \"Very structured / ordered\", \"min\": 0, \"max\": 100, \"step\": 1 },\n          { \"id\": \"complexity\", \"label\": \"How complex does this room seem to you?\", \"left\": \"Not complex at all\", \"right\": \"Very complex\", \"min\": 0, \"max\": 100, \"step\": 1 }\n        ] }\n      ]},\n      { \"name\": \"aesthetic_stress\", \"elements\": [\n        { \"type\": \"imageslidergroup\", \"name\": \"beauty\", \"title\": \"Please rate the beauty of the room shown in this picture.\", \"description\": \"Rating task 2 (ASR), beauty block: 20 views in a fixed order. key = image id (r1 modern / r2 classic, a angular / c curved, _9 … _15 viewpoint), as in the columns of ac_dataset_ASR.xlsx.\", \"imageCount\": 1, \"scaleMin\": 0, \"scaleMax\": 100, \"isRequired\": true, \"dimensions\": [\n          { \"id\": \"beauty\", \"label\": \"Please rate the beauty of the room shown in this picture.\", \"left\": \"Not beautiful at all\", \"right\": \"Very beautiful\", \"min\": 0, \"max\": 100, \"step\": 1 } ] },\n        { \"type\": \"imageslidergroup\", \"name\": \"liking\", \"title\": \"How much do you like the room shown in this picture?\", \"description\": \"ASR liking block: 20 views in a fixed order. key = image id.\", \"imageCount\": 1, \"scaleMin\": 0, \"scaleMax\": 100, \"isRequired\": true, \"dimensions\": [\n          { \"id\": \"liking\", \"label\": \"How much do you like the room shown in this picture?\", \"left\": \"Not at all\", \"right\": \"Very much\", \"min\": 0, \"max\": 100, \"step\": 1 } ] },\n        { \"type\": \"imageslidergroup\", \"name\": \"rest\", \"title\": \"Please imagine being in the room shown in the picture. How restful does this room feel to you?\", \"description\": \"ASR rest block: 20 views in a fixed order. key = image id.\", \"imageCount\": 1, \"scaleMin\": 0, \"scaleMax\": 100, \"isRequired\": true, \"dimensions\": [\n          { \"id\": \"rest\", \"label\": \"Please imagine being in the room shown in the picture. How restful does this room feel to you?\", \"left\": \"Not restful at all\", \"right\": \"Very restful\", \"min\": 0, \"max\": 100, \"step\": 1 } ] },\n        { \"type\": \"imageslidergroup\", \"name\": \"stress\", \"title\": \"Please imagine being in the room shown in the picture. How would you describe your emotional reaction?\", \"description\": \"ASR stress block (column suffix _emotion in ac_dataset_ASR.xlsx): 20 views in a fixed order. key = image id. 0 = relaxed, 100 = stressed.\", \"imageCount\": 1, \"scaleMin\": 0, \"scaleMax\": 100, \"isRequired\": true, \"dimensions\": [\n          { \"id\": \"stress\", \"label\": \"Please imagine being in the room shown in the picture. How would you describe your emotional reaction?\", \"left\": \"Relaxed\", \"right\": \"Stressed\", \"min\": 0, \"max\": 100, \"step\": 1 } ] },\n        { \"type\": \"custom\", \"name\": \"block_order\", \"title\": \"Order of the four ASR blocks\", \"description\": \"Recorded by the page: array of the four block names in the order this participant saw them (randomised).\", \"isRequired\": true }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f2f1ee;--card:#fff;--ink:#1d1c1a;--muted:#5d5a55;--accent:#3d5a80;--accent-ink:#fff;--line:#d9d6d0;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:24px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:8px 0 14px}.progress>i{display:block;height:100%;background:var(--accent)}\n.pic{background:#e4e2de;border-radius:12px;overflow:hidden;aspect-ratio:5075/2160}\n.pic img{width:100%;height:100%;object-fit:contain;display:block}\n.qtext{font-weight:600;font-size:1.05rem;margin:0 0 14px;color:var(--ink)}\ninput[type=range]{width:100%;margin:8px 0 0;accent-color:var(--accent);height:28px}\ninput[type=range].untouched::-webkit-slider-thumb{opacity:0}\ninput[type=range].untouched::-moz-range-thumb{opacity:0}\n.ends{display:flex;justify-content:space-between;gap:16px;font-size:.85rem;color:var(--muted);margin-top:2px}\n.ends span:last-child{text-align:right}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:16px}.q:first-child{margin-top:0}.q>b{display:block;margin-bottom:4px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:120px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Room renders: Tawil, Ascone &amp; Kühn (2022), OSF project mfpk2 (“Stimulus material”), used with credit to the authors and removed on request; resized to 2000 px.</footer>\n<script>\n(function(){\n  var ROOMS=['r1a','r2a','r1c','r2c'], VIEWS=[9,10,12,13,15];\n  var ASR_ORDER=[];ROOMS.forEach(function(r){VIEWS.forEach(function(v){ASR_ORDER.push(r+'_'+v);});});\n  var GAS_IMGS=ROOMS.map(function(r){return r+'_15';}), BLOCKS=['beauty','liking','rest','stress'];\n  var app=document.getElementById('app'), Q={}, files={}, plan=null, done={gas:{},beauty:{},liking:{},rest:{},stress:{}}, saved=false;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function shuffle(a){a=a.slice();for(var k=a.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1));var x=a[k];a[k]=a[j];a[j]=x;}return a;}\n  function fn(id){return id+'.jpg';}\n  function setup(){\n    var s=null;try{s=JSON.parse(localStorage.getItem('contour2022:plan'));}catch(e){}\n    var good=s&&Array.isArray(s.gas)&&s.gas.length===4&&GAS_IMGS.every(function(x){return s.gas.indexOf(x)>=0;})&&Array.isArray(s.blocks)&&s.blocks.length===4&&BLOCKS.every(function(x){return s.blocks.indexOf(x)>=0;});\n    plan=good?s:{gas:shuffle(GAS_IMGS),blocks:shuffle(BLOCKS)};\n    try{localStorage.setItem('contour2022:plan',JSON.stringify(plan));}catch(e){}\n  }\n  function radios(n){return (Q[n].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');}\n  function intro(){\n    var miss=ASR_ORDER.filter(function(id){return !files[fn(id)];});\n    if(miss.length){app.innerHTML='<h1>Pictures missing</h1><p>Missing in folder “rooms”: '+esc(miss.map(fn).join(', '))+'</p>';return;}\n    app.innerHTML='<h1>How do these living rooms feel to you?</h1><p>You will see pictures of four living rooms. First you describe each room on six scales. Then you rate 20 pictures of the rooms, one question at a time, in four short rounds. Answer by placing the slider anywhere on the line. There are no right or wrong answers. About 15 minutes.</p>'+\n      '<div class=\"card\"><div class=\"q\"><b>'+esc(Q.sex.title)+'</b>'+radios('sex')+'</div><div class=\"q\"><b>'+esc(Q.age.title)+'</b><input type=\"number\" id=\"age\" min=\"18\" max=\"99\" inputmode=\"numeric\"></div><div class=\"q\"><b>'+esc(Q.design_profession.title)+'</b>'+radios('design_profession')+'</div></div>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var s=app.querySelector('input[name=sex]:checked');if(!s)return err('Please answer: Sex.');\n      var av=document.getElementById('age').value, age=Number(av);if(!av||!(age>=18&&age<=99))return err('Please enter your age (18–99).');\n      var d=app.querySelector('input[name=design_profession]:checked');if(!d)return err('Please answer: architecture or interior design.');\n      var b=this;b.disabled=true;\n      Promise.all([SPSite.answer('consent',true),SPSite.answer('sex',s.value),SPSite.answer('age',age),SPSite.answer('design_profession',d.value),SPSite.answer('block_order',plan.blocks)]).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}saved=true;next();});\n    };\n  }\n  // one visual analogue scale on one screen\n  function vas(opts,cb){\n    app.innerHTML='<p>'+esc(opts.header)+'</p><div class=\"progress\"><i style=\"width:'+opts.pct+'%\"></i></div>'+\n      '<div class=\"pic\"><img src=\"'+esc(files[fn(opts.img)].url)+'\" alt=\"Picture of a living room\"></div>'+\n      '<div class=\"card\"><p class=\"qtext\">'+esc(opts.label)+'</p><input type=\"range\" min=\"0\" max=\"100\" step=\"1\" value=\"50\" class=\"untouched\" id=\"vas\" aria-label=\"'+esc(opts.label)+'\"><div class=\"ends\"><span>'+esc(opts.left)+'</span><span>'+esc(opts.right)+'</span></div></div>'+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"nx\">Next</button></div><div class=\"err\"></div>';\n    var r=document.getElementById('vas'), touched=false;\n    function t(){touched=true;r.classList.remove('untouched');err('');}\n    r.addEventListener('input',t);r.addEventListener('pointerdown',t);r.addEventListener('keydown',t);\n    document.getElementById('nx').onclick=function(){if(!touched)return err('Please place the slider on the line.');this.disabled=true;cb(Number(r.value),this);};\n  }\n  function next(){\n    window.scrollTo(0,0);\n    var gi=plan.gas.filter(function(x){return !done.gas[x];});\n    if(gi.length)return gasRoom(gi[0],4-gi.length);\n    for(var b=0;b<plan.blocks.length;b++){\n      var bl=plan.blocks[b], left=ASR_ORDER.filter(function(x){return !done[bl][x];});\n      if(left.length)return asr(bl,b,left[0]);\n    }\n    finish();\n  }\n  function gasRoom(id,n){\n    var dims=Q.gas.dimensions||[], vals={}, k=0;\n    (function step(){\n      var d=dims[k];\n      vas({header:'Part 1 of 2 · Room '+(n+1)+' of 4 · question '+(k+1)+' of '+dims.length,pct:100*(n*dims.length+k)/(4*dims.length+80),img:id,label:d.label,left:d.left,right:d.right},function(v,bt){\n        vals[d.id]=v;k++;\n        if(k<dims.length){window.scrollTo(0,0);return step();}\n        SPSite.answer('gas',vals,{key:id,shown:[fn(id)]}).then(function(r){if(!ok(r)){bt.disabled=false;k--;return err(r.error);}done.gas[id]=true;next();});\n      });\n    })();\n  }\n  function asr(bl,b,id){\n    var d=(Q[bl].dimensions||[])[0]||{}, n=ASR_ORDER.indexOf(id);\n    vas({header:'Part 2 of 2 · Round '+(b+1)+' of 4 · picture '+(n+1)+' of 20',pct:100*(24+b*20+n)/(24+80),img:id,label:d.label,left:d.left,right:d.right},function(v,bt){\n      var val={};val[d.id]=v;\n      SPSite.answer(bl,val,{key:id,shown:[fn(id)]}).then(function(r){if(!ok(r)){bt.disabled=false;return err(r.error);}done[bl][id]=true;next();});\n    });\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){if(m.some(function(x){return ['gas','beauty','liking','rest','stress'].indexOf(x)<0;}))intro();else next();},1800);}else{var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  SPSite.onReady(function(ctx){\n    ['consent','sex','age','design_profession','gas','beauty','liking','rest','stress','block_order'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('rooms')||[]).forEach(function(f){files[f.name]=f;});\n    setup();\n    var a=(ctx&&ctx.answers)||{};\n    if(Array.isArray(a.block_order)&&a.block_order.length===4)plan.blocks=a.block_order;\n    ['gas','beauty','liking','rest','stress'].forEach(function(q){var p=a[q];(p&&Array.isArray(p.trials)?p.trials:[]).forEach(function(x){if(x&&x.key!=null&&x.value!=null)done[q][String(x.key)]=true;});});\n    if(a.consent===true)next();else intro();\n  });\n})();\n</script>\n</body>\n</html>\n",
