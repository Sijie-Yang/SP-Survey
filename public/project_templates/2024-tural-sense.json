   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Sense of Spaciousness in Interior Settings</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Sense of Spaciousness in Interior Settings\",\n  \"description\": \"Participants rate 16 rendered interiors of the same 15 ft × 15 ft consultation room for perceived spaciousness (1–7). Four sets of four rooms vary one design element each: view access (window size), view content (woods, water, desert, lawn), boundary materials, and ceiling geometry. Rebuilt from Tural & Tural (2024), Frontiers in Psychology 15: 1473520, with the authors' 16 renders taken from the paper's Figure 1 (CC BY 4.0).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"rooms\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"year_of_study\",\n      \"title\": \"Year of study\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"freshman\",\n        \"text\": \"First year (freshman)\"\n       },\n       {\n        \"value\": \"sophomore\",\n        \"text\": \"Second year (sophomore)\"\n       },\n       {\n        \"value\": \"junior\",\n        \"text\": \"Third year (junior)\"\n       },\n       {\n        \"value\": \"senior\",\n        \"text\": \"Fourth year (senior)\"\n       },\n       {\n        \"value\": \"graduate\",\n        \"text\": \"Graduate or above\"\n       },\n       {\n        \"value\": \"not_student\",\n        \"text\": \"Not a student\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"design_background\",\n      \"title\": \"Do you study or work in interior design, architecture or another design field?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"rooms\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"spaciousness\",\n      \"title\": \"Please rate the interior setting in terms of the degree of spaciousness.\",\n      \"description\": \"One record per room: key = room id (e.g. s1_window100, s2_water, s3_concrete, s4_vaulted; s1–s4 = the paper's Sets 1–4). Each render stays on screen at least 18 s, as in the paper's screen session. The page source (script id spacious-original) holds each room's set, condition and the paper's mean ratings (screen and VR, N = 35). Paper's analysis: repeated-measures ANOVA within each set of four rooms with pairwise comparisons.\",\n      \"rateMin\": 1,\n      \"rateMax\": 7,\n      \"minRateDescription\": \"Not at all spacious\",\n      \"maxRateDescription\": \"Very spacious\",\n      \"isRequired\": true\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"spacious-original\">{\"s1_window100\": {\"set\": \"View access\", \"condition\": \"Window 100% of wall\", \"paper_screen_mean\": 5.66, \"paper_vr_mean\": 5.91}, \"s1_window66\": {\"set\": \"View access\", \"condition\": \"Window 66% of wall\", \"paper_screen_mean\": 5.2, \"paper_vr_mean\": 5.66}, \"s1_window33\": {\"set\": \"View access\", \"condition\": \"Window 33% of wall\", \"paper_screen_mean\": 4.86, \"paper_vr_mean\": 4.97}, \"s1_window0\": {\"set\": \"View access\", \"condition\": \"Fully enclosed (0%)\", \"paper_screen_mean\": 4.86, \"paper_vr_mean\": 4.31}, \"s2_woods\": {\"set\": \"View content\", \"condition\": \"Woods\", \"paper_screen_mean\": 4.57, \"paper_vr_mean\": 4.63}, \"s2_water\": {\"set\": \"View content\", \"condition\": \"Water\", \"paper_screen_mean\": 4.94, \"paper_vr_mean\": 5.23}, \"s2_desert\": {\"set\": \"View content\", \"condition\": \"Desert\", \"paper_screen_mean\": 4.89, \"paper_vr_mean\": 5.0}, \"s2_lawn\": {\"set\": \"View content\", \"condition\": \"Lawn\", \"paper_screen_mean\": 4.6, \"paper_vr_mean\": 4.8}, \"s3_brick\": {\"set\": \"Materiality\", \"condition\": \"Brick, hardwood, steel decking\", \"paper_screen_mean\": 4.37, \"paper_vr_mean\": 4.74}, \"s3_concrete\": {\"set\": \"Materiality\", \"condition\": \"Concrete\", \"paper_screen_mean\": 3.46, \"paper_vr_mean\": 3.89}, \"s3_natural\": {\"set\": \"Materiality\", \"condition\": \"Natural / biophilic\", \"paper_screen_mean\": 4.46, \"paper_vr_mean\": 4.86}, \"s3_resilient\": {\"set\": \"Materiality\", \"condition\": \"Wallpaper and resilient floor\", \"paper_screen_mean\": 4.09, \"paper_vr_mean\": 4.37}, \"s4_angled\": {\"set\": \"Ceiling geometry\", \"condition\": \"Angled\", \"paper_screen_mean\": 4.86, \"paper_vr_mean\": 4.91}, \"s4_curved\": {\"set\": \"Ceiling geometry\", \"condition\": \"Curved\", \"paper_screen_mean\": 5.23, \"paper_vr_mean\": 5.03}, \"s4_flat\": {\"set\": \"Ceiling geometry\", \"condition\": \"Flat\", \"paper_screen_mean\": 4.83, \"paper_vr_mean\": 5.37}, \"s4_vaulted\": {\"set\": \"Ceiling geometry\", \"condition\": \"Vaulted\", \"paper_screen_mean\": 5.23, \"paper_vr_mean\": 5.37}}</script>\n<style>\n:root{--bg:#f6f4f0;--card:#fff;--ink:#23211e;--muted:#6d675e;--accent:#8a5a2b;--line:#e3ddd3;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:920px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.1rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.view{background:#000;border-radius:12px;overflow:hidden;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center}\n.view img{width:100%;height:100%;object-fit:contain;display:block}\n.timer{height:4px;background:var(--line);border-radius:2px;overflow:hidden;margin-top:8px}.timer>i{display:block;height:100%;background:var(--accent);width:0}\n.q{font-weight:600;margin:14px 0 8px;color:var(--ink)}\n.scale{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}\n.scale button{appearance:none;border:1px solid var(--line);background:#fff;border-radius:10px;padding:10px 0;font:inherit;font-weight:600;cursor:pointer;color:var(--ink)}\n.scale button.on{background:var(--accent);border-color:var(--accent);color:#fff}\n.anch{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-top:4px}\n.row{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:14px;flex-wrap:wrap}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:920px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Renders: Tural &amp; Tural (2024), Frontiers in Psychology 15:1473520, Figure 1, CC BY 4.0.</footer>\n<script>\n(function(){\n  var VIEW_MS=(window.__VIEWMS||18000), KEY='spacious2024:state';\n  var app=document.getElementById('app'), Q={}, files=[], st=null, tm=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function shuffle(a){a=a.slice();for(var k=a.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1));var x=a[k];a[k]=a[j];a[j]=x;}return a;}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function id(n){return n.replace(/\\.[^.]+$/,'');}\n  function byId(i){for(var k=0;k<files.length;k++)if(id(files[k].name)===i)return files[k];return null;}\n  function newState(){\n    var sets={};files.forEach(function(f){var s=(id(f.name).match(/^s(\\d)_/)||[])[1]||'9';(sets[s]=sets[s]||[]).push(id(f.name));});\n    var order=[];Object.keys(sets).sort().forEach(function(s){order=order.concat(shuffle(sets[s]));});\n    return {step:'intro',order:order,k:0};\n  }\n  function radio(n){var q=Q[n];return '<div class=\"f\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function intro(){\n    app.innerHTML='<h1>How spacious does the room feel?</h1><p>You will see 16 pictures of the same small consultation room with different windows, views, materials and ceilings. Each picture stays on screen for at least 18 seconds. Rate how spacious the room feels from 1 (not at all spacious) to 7 (very spacious). About 8 minutes; please use a large screen if you can.</p>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label>'+radio('gender')+radio('year_of_study')+radio('design_background')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var g=function(n){var x=app.querySelector('input[name='+n+']:checked');return x?x.value:null;};\n      var v={gender:g('gender'),year_of_study:g('year_of_study'),design_background:g('design_background')};\n      for(var n in v)if(!v[n])return err('Please answer: '+Q[n].title);\n      var b=this;b.disabled=true;\n      Promise.all([SPSite.answer('consent',true),SPSite.answer('gender',v.gender),SPSite.answer('year_of_study',v.year_of_study),SPSite.answer('design_background',v.design_background)]).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}st.step='rooms';save();route();});\n    };\n  }\n  function trial(){\n    if(st.k>=st.order.length){return finish();}\n    var f=byId(st.order[st.k]);if(!f){st.k++;save();return trial();}\n    var nf=byId(st.order[st.k+1]||'');if(nf){var pre=new Image();pre.src=nf.url;}\n    var q=Q.spaciousness, val=null, timeUp=false, btns='';\n    for(var v=q.rateMin||1;v<=(q.rateMax||7);v++)btns+='<button type=\"button\" data-v=\"'+v+'\" aria-label=\"'+v+'\">'+v+'</button>';\n    app.innerHTML='<p>Room '+(st.k+1)+' of '+st.order.length+'</p><div class=\"view\"><img alt=\"Rendered interior\" src=\"'+esc(f.url)+'\"></div><div class=\"timer\"><i id=\"tb\"></i></div>'+\n      '<div class=\"q\">'+esc(q.title)+'</div><div class=\"scale\">'+btns+'</div><div class=\"anch\"><span>1 = '+esc(q.minRateDescription)+'</span><span>7 = '+esc(q.maxRateDescription)+'</span></div>'+\n      '<div class=\"row\"><span id=\"hint\" style=\"color:var(--muted);font-size:.85rem\">Please look at the room for a moment.</span><button class=\"btn\" id=\"go\" disabled>Next</button></div><div class=\"err\"></div>';\n    var go=document.getElementById('go'), hint=document.getElementById('hint');\n    function upd(){go.disabled=!(val&&timeUp);hint.textContent=timeUp?(val?'':'Choose a rating.'):'Please look at the room for a moment.';}\n    app.querySelectorAll('.scale button').forEach(function(b){b.onclick=function(){val=Number(b.dataset.v);app.querySelectorAll('.scale button').forEach(function(x){x.classList.toggle('on',x===b);});upd();};});\n    var tb=document.getElementById('tb');tb.style.transition='width '+(VIEW_MS/1000)+'s linear';requestAnimationFrame(function(){requestAnimationFrame(function(){tb.style.width='100%';});});\n    clearTimeout(tm);tm=setTimeout(function(){timeUp=true;upd();},VIEW_MS);\n    go.onclick=function(){\n      if(!val||!timeUp)return;go.disabled=true;\n      SPSite.answer('spaciousness',val,{key:st.order[st.k],shown:[f.name]}).then(function(r){if(!ok(r)){go.disabled=false;return err(r.error);}st.k++;save();window.scrollTo(0,0);trial();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){var m=r.missing||[];if(m.indexOf('spaciousness')>=0&&m.length===1){st.step='rooms';st.k=0;}else st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){if(st.step==='rooms')return trial();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','gender','year_of_study','design_background','spaciousness'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    files=(SPSite.getMedia('rooms')||[]).filter(function(f){return /\\.(jpe?g|png|webp)$/i.test(f.name);});\n    if(!files.length){app.innerHTML='<h1>Pictures missing</h1><p>Upload the room renders to the media folder \"rooms\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!st||!st.order||st.order.length!==files.length||st.order.some(function(i){return !byId(i);}))st=newState();\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true)st.step='intro';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
