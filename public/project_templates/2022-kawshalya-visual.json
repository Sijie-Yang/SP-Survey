   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Visual Complexity, Safety and Preference of Streets</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Visual Complexity, Safety and Preference of Streets\",\n    \"description\": \"Rate 40 street views from central Colombo (Sri Lanka) on perceived safety, preference and perceived complexity, each from 1 to 7. Method rebuilt from Kawshalya, Weerasinghe & Chandrasekara (2022), PLOS ONE.\",\n    \"locale\": \"en\",\n    \"mediaFolders\": [\"colombo\"],\n    \"pages\": [\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" },\n        { \"type\": \"radiogroup\", \"name\": \"age_group\", \"title\": \"Age\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"under_18\", \"text\": \"Less than 18 years\" }, { \"value\": \"19_28\", \"text\": \"19–28 years\" }, { \"value\": \"29_38\", \"text\": \"29–38 years\" }, { \"value\": \"39_48\", \"text\": \"39–48 years\" }, { \"value\": \"over_48\", \"text\": \"More than 48 years\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"male\", \"text\": \"Male\" }, { \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"other\", \"text\": \"Other / prefer not to say\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"residence\", \"title\": \"Where do you live?\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"urban\", \"text\": \"In an urban area\" }, { \"value\": \"suburb\", \"text\": \"In a suburb\" }, { \"value\": \"rural\", \"text\": \"In a rural area\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"street_use\", \"title\": \"How often do you use urban streets?\", \"isRequired\": true, \"choices\": [\n          { \"value\": \"always\", \"text\": \"Always\" }, { \"value\": \"often\", \"text\": \"Often\" }, { \"value\": \"sometimes\", \"text\": \"Sometimes\" }, { \"value\": \"rarely\", \"text\": \"Rarely\" } ] },\n        { \"type\": \"radiogroup\", \"name\": \"design_background\", \"title\": \"Do you study or work in a design-related field (architecture, landscape architecture, urban planning, urban design)?\", \"choices\": [\n          { \"value\": \"yes\", \"text\": \"Yes\" }, { \"value\": \"no\", \"text\": \"No\" } ] }\n      ]},\n      { \"name\": \"ratings\", \"elements\": [\n        { \"type\": \"imagerating\", \"name\": \"perceived_safety\", \"title\": \"How safe would you feel here?\", \"imageCount\": 1, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Not safe at all\", \"maxRateDescription\": \"Very safe\", \"isRequired\": true },\n        { \"type\": \"imagerating\", \"name\": \"preference\", \"title\": \"How much do you like this street scene?\", \"imageCount\": 1, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Not at all\", \"maxRateDescription\": \"Very much\", \"isRequired\": true },\n        { \"type\": \"imagerating\", \"name\": \"perceived_complexity\", \"title\": \"How visually complex is this street scene?\", \"imageCount\": 1, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Very simple\", \"maxRateDescription\": \"Very complex\", \"isRequired\": true }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f4f3ef;--card:#fff;--ink:#1d1f22;--muted:#5b6068;--accent:#9a4b1f;--accent-ink:#fff;--line:#dcd8cf;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:24px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:8px 0 14px}.progress>i{display:block;height:100%;background:var(--accent)}\n.stage{background:#ddd;border-radius:12px;overflow:hidden;min-height:200px}.stage img{width:100%;height:auto;display:block}\n.row{margin-top:14px}.row b{display:block;margin-bottom:6px}\n.scale{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}\n.scale button{appearance:none;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:9px;padding:10px 0;font:inherit;font-weight:700;cursor:pointer}\n.scale button.on{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}\n.ends{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-top:3px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:16px}.q>b{display:block;margin-bottom:4px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Street images: Google Street View (© Google), 2022, taken near the locations mapped in Fig 1 of Kawshalya, Weerasinghe &amp; Chandrasekara (2022), PLOS ONE 17(8): e0272074.</footer>\n<script>\n(function(){\n  var app=document.getElementById('app'), Q={}, files=[], done={}, i=0;\n  var ABOUT=['age_group','gender','residence','street_use','design_background'], DIMS=['perceived_safety','preference','perceived_complexity'];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function shuffle(a){a=a.slice();for(var k=a.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1));var x=a[k];a[k]=a[j];a[j]=x;}return a;}\n  function key(f){return f.name.replace(/\\.[^.]+$/,'').replace(/^svi_/,'SVI_');}\n  function setup(){\n    var all=SPSite.getMedia('colombo')||[], by={};all.forEach(function(f){by[f.name]=f;});\n    var saved=null;try{saved=JSON.parse(localStorage.getItem('colombo2022:order'));}catch(e){}\n    if(saved&&saved.length===all.length&&saved.every(function(n){return by[n];}))files=saved.map(function(n){return by[n];});\n    else{files=shuffle(all);try{localStorage.setItem('colombo2022:order',JSON.stringify(files.map(function(f){return f.name;})));}catch(e){}}\n  }\n  function radios(n){return (Q[n].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');}\n  function intro(){\n    if(!files.length){app.innerHTML='<h1>No images yet</h1><p>Add street images to the folder “colombo”.</p>';return;}\n    app.innerHTML='<h1>How do these streets feel?</h1><p>You will see '+files.length+' street views from central Colombo. For each one, imagine you are standing at that spot and looking along the street, not specifically as a pedestrian or a driver. Rate how safe you would feel, how much you like the scene, and how visually complex it is, each from 1 to 7. About 15 minutes.</p>'+\n      '<div class=\"card\">'+ABOUT.map(function(n){return '<div class=\"q\"><b>'+esc(Q[n].title)+'</b>'+radios(n)+'</div>';}).join('')+'</div>'+\n      '<div class=\"card\"><label class=\"opt\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var vals={},miss=ABOUT.filter(function(n){var r=app.querySelector('input[name='+n+']:checked');if(r)vals[n]=r.value;return Q[n].required!==false&&n!=='design_background'&&!r;});\n      if(miss.length)return err('Please answer: '+miss.map(function(n){return Q[n].title;}).join('; '));\n      var b=this;b.disabled=true;var calls=[SPSite.answer('consent',true)];Object.keys(vals).forEach(function(n){calls.push(SPSite.answer(n,vals[n]));});\n      Promise.all(calls).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}i=0;trial();});\n    };\n  }\n  function trial(){\n    while(i<files.length&&done[files[i].name])i++;\n    if(i>=files.length)return finish();\n    var f=files[i], vals={};\n    app.innerHTML='<p>Street '+(i+1)+' of '+files.length+'</p><div class=\"progress\"><i style=\"width:'+(100*i/files.length)+'%\"></i></div><div class=\"stage\"><img src=\"'+esc(f.url)+'\" alt=\"Street view\"></div>'+\n      DIMS.map(function(d){var q=Q[d],b='';for(var v=1;v<=7;v++)b+='<button data-d=\"'+d+'\" data-v=\"'+v+'\">'+v+'</button>';return '<div class=\"row\"><b>'+esc(q.title)+'</b><div class=\"scale\">'+b+'</div><div class=\"ends\"><span>1 · '+esc(q.minLabel||q.minRateDescription)+'</span><span>7 · '+esc(q.maxLabel||q.maxRateDescription)+'</span></div></div>';}).join('')+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"nx\">Next</button></div><div class=\"err\"></div>';\n    app.querySelectorAll('.scale button').forEach(function(b){b.onclick=function(){err('');var d=b.getAttribute('data-d');vals[d]=Number(b.getAttribute('data-v'));app.querySelectorAll('.scale button[data-d='+d+']').forEach(function(x){x.classList.toggle('on',x===b);});};});\n    document.getElementById('nx').onclick=function(){\n      if(DIMS.some(function(d){return vals[d]==null;}))return err('Please give all three ratings.');\n      var b=this;b.disabled=true;\n      Promise.all(DIMS.map(function(d){return SPSite.answer(d,vals[d],{key:key(f),shown:[f.name]});})).then(function(rs){\n        var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}\n        done[f.name]=true;i++;window.scrollTo(0,0);trial();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"st\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){if(m.some(function(n){return DIMS.indexOf(n)<0;}))intro();else{done={};i=0;trial();}},1800);}else{var s=document.getElementById('st');if(s)s.textContent='Your ratings are saved.';}});\n  }\n  SPSite.onReady(function(ctx){\n    ['consent'].concat(ABOUT,DIMS).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    setup();\n    var a=(ctx&&ctx.answers)||{}, cnt={};\n    DIMS.forEach(function(d){var p=a[d];(p&&Array.isArray(p.trials)?p.trials:[]).forEach(function(x){if(x&&x.key!=null&&x.value!=null)cnt[x.key]=(cnt[x.key]||0)+1;});});\n    files.forEach(function(f){if(cnt[key(f)]===DIMS.length)done[f.name]=true;});\n    if(a.consent===true)trial();else intro();\n  });\n})();\n</script>\n</body>\n</html>\n",
