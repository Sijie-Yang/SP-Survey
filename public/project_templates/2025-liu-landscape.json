   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Landscape Aesthetic Quality</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Landscape Aesthetic Quality Questionnaire (Jiuzhaigou)\",\n  \"description\": \"Faithful replication of Liu et al. (2025), Forests 16:1804: the full Landscape Aesthetic Quality questionnaire from Jiuzhaigou: rank six series of tree images by preference, then rate ten autumn forest photographs from very ugly (1) to very beautiful (5).\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"sets\",\n   \"landscapes\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"intro\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part in this survey.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"What is your gender?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Male\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age_group\",\n      \"title\": \"What is your age?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Under 18\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"18-30\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"31-60\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Above 60\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"What is your level of education?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Secondary school and lower\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"College degree\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Master or PHD\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"occupation\",\n      \"title\": \"What is your occupation?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Experts\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Stakeholders\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Laymen\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"rankings\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"name\": \"image_ranking\",\n      \"isRequired\": true,\n      \"title\": \"Please rank the images below in descending order according to your preference.\",\n      \"description\": \"Six image series (questionnaire Q5-Q10) of tree images edited to vary one species attribute; participants are not told the species. Q5 has 4 images (A-D), the others 3 (A-C). Value: {order: labels from most to least preferred, ranks: {A: 1, ...}}. Trial key = question id. attribute_inferred = the sub-indicator of the paper's Table 1 that the series appears to vary (inferred from the images, not stated per question in the paper). Analysis: mean rank per image -> sub-indicator aesthetic value.\",\n      \"items\": [\n       {\n        \"name\": \"order\"\n       },\n       {\n        \"name\": \"ranks\"\n       }\n      ],\n      \"trials\": [\n       {\n        \"id\": \"q05\",\n        \"attribute_inferred\": \"crown shape\",\n        \"options\": [\n         {\n          \"label\": \"A\",\n          \"file\": \"set05_A.jpg\"\n         },\n         {\n          \"label\": \"B\",\n          \"file\": \"set05_B.jpg\"\n         },\n         {\n          \"label\": \"C\",\n          \"file\": \"set05_C.jpg\"\n         },\n         {\n          \"label\": \"D\",\n          \"file\": \"set05_D.jpg\"\n         }\n        ]\n       },\n       {\n        \"id\": \"q06\",\n        \"attribute_inferred\": \"leaf shape\",\n        \"options\": [\n         {\n          \"label\": \"A\",\n          \"file\": \"set06_A.jpg\"\n         },\n         {\n          \"label\": \"B\",\n          \"file\": \"set06_B.jpg\"\n         },\n         {\n          \"label\": \"C\",\n          \"file\": \"set06_C.jpg\"\n         }\n        ]\n       },\n       {\n        \"id\": \"q07\",\n        \"attribute_inferred\": \"trunk clarity\",\n        \"options\": [\n         {\n          \"label\": \"A\",\n          \"file\": \"set07_A.jpg\"\n         },\n         {\n          \"label\": \"B\",\n          \"file\": \"set07_B.jpg\"\n         },\n         {\n          \"label\": \"C\",\n          \"file\": \"set07_C.jpg\"\n         }\n        ]\n       },\n       {\n        \"id\": \"q08\",\n        \"attribute_inferred\": \"hue\",\n        \"options\": [\n         {\n          \"label\": \"A\",\n          \"file\": \"set08_A.jpg\"\n         },\n         {\n          \"label\": \"B\",\n          \"file\": \"set08_B.jpg\"\n         },\n         {\n          \"label\": \"C\",\n          \"file\": \"set08_C.jpg\"\n         }\n        ]\n       },\n       {\n        \"id\": \"q09\",\n        \"attribute_inferred\": \"saturation\",\n        \"options\": [\n         {\n          \"label\": \"A\",\n          \"file\": \"set09_A.jpg\"\n         },\n         {\n          \"label\": \"B\",\n          \"file\": \"set09_B.jpg\"\n         },\n         {\n          \"label\": \"C\",\n          \"file\": \"set09_C.jpg\"\n         }\n        ]\n       },\n       {\n        \"id\": \"q10\",\n        \"attribute_inferred\": \"brightness\",\n        \"options\": [\n         {\n          \"label\": \"A\",\n          \"file\": \"set10_A.jpg\"\n     