": \"q19\",\n        \"file\": \"q19.jpg\"\n       },\n       {\n        \"id\": \"q20\",\n        \"file\": \"q20.jpg\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#f1efe8;--card:#fff;--ink:#22231f;--muted:#5e5f57;--accent:#9a5a12;--line:#dcd8cc;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:780px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn.sec{background:transparent;color:var(--accent);border:1px solid var(--line);padding:8px 14px;font-size:.9rem}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q:first-child{margin-top:0}.q>b{display:block;margin-bottom:6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem;font-variant-numeric:tabular-nums}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.rank{display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:8px;margin-top:10px}\n.tile{position:relative;border:2px solid var(--line);border-radius:10px;overflow:hidden;cursor:pointer;background:#ddd;padding:0;font:inherit}\n.tile img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block}\n.tile.on{border-color:var(--accent)}\n.tile .n{position:absolute;top:6px;left:6px;min-width:30px;height:30px;border-radius:15px;background:var(--accent);color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;padding:0 6px}\n.tile:focus-visible{outline:3px solid var(--accent);outline-offset:2px}\n.status{margin-top:10px;font-size:.92rem;color:var(--ink)}\n.pic{background:#e4e1d8;border-radius:12px;overflow:hidden;display:flex;justify-content:center}.pic img{width:100%;max-width:760px;max-height:min(48vh,480px);object-fit:contain;display:block}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:780px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:520px){.rank{grid-template-columns:repeat(2,minmax(0,1fr))}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Images: Liu, Du, Zhang, Bachelot, Yang, Dong &amp; Wu (2025), Forests 16:1804, Supplementary questionnaire, doi:10.3390/f16121804 (CC BY 4.0; tree and forest images of Jiuzhaigou, eastern Tibetan Plateau). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='laq2025:';\n  var app=document.getElementById('app'), Q={}, sets={}, land={}, done={}, SPEC=null, RS=[], LT=[], LCH=[], ABOUT=['gender','age_group','education','occupation'];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function q(n){return Q[n]||{};}\n  function page(html,btn,cb){\n    app.innerHTML=html+'<div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+esc(btn||'Continue')+'</button></div><div class=\"err\"></div>';\n    document.getElementById('go').onclick=cb;app.onchange=hideErr;\n  }\n  function saveAll(l,b,cb){Promise.all(l.map(function(a){return SPSite.answer(a[0],a[1]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}cb();});}\n  function total(){return 4+RS.length+LT.length;}\n  function bar(n){return '<div class=\"top\"><span class=\"t\">Question '+n+' of '+total()+'</span><div class=\"bar\"><i style=\"width:'+(100*(n-1)/total())+'%\"></i></div></div>';}\n  function next(){\n    window.scrollTo(0,0);\n    if(!done.intro)return intro();\n    if(!done.about)return about();\n    var k;\n    for(k=0;k<RS.length;k++)if(!done[RS[k].id])return ranking(RS[k],k);\n    for(k=0;k<LT.length;k++)if(!done[LT[k].id])return rating(LT[k],k);\n    finish();\n  }\n  function intro(){\n    var miss=RS.some(function(t){return t.options.some(function(o){return !sets[o.file];});})||LT.some(function(t){return !land[t.file];});\n    if(miss){app.innerHTML='<h1>Images missing</h1><p>Media folders sets and landscapes must hold the questionnaire images (set05_A.jpg … set10_C.jpg, q11.jpg … q20.jpg).</p>';return;}\n    page('<h1>Landscape Aesthetic Quality Questionnaire</h1><div class=\"card\"><p style=\"color:var(--ink)\">Thank you for dedicating your valuable time to participate in this survey. This survey requires you to provide evaluations based on your personal subjective preferences. The evaluation process focuses primarily on photographic landscapes, and the viewing time for each photograph should be no less than 5 seconds and no more than 10 seconds.</p><label class=\"opt\"><input type=\"checkbox\" id=\"ok\"> '+esc(q('consent').title)+'</label></div>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Please confirm to continue.');\n      var b=this;b.disabled=true;saveAll([['consent',true]],b,function(){done.intro=true;save('d',done);next();});\n    });\n  }\n  function about(){\n    var h=ABOUT.map(function(n,i){var d=q(n);return '<div class=\"q\"><b>'+(i+1)+'. '+esc(d.title)+'</b>'+d.choices.map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+c.value+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('');\n    page(bar(1)+'<div class=\"card\">'+h+'</div>','Continue',function(){\n      var l=[];for(var i=0;i<ABOUT.length;i++){var x=app.querySelector('input[name=\"'+ABOUT[i]+'\"]:checked');if(!x)return err('Please answer: '+q(ABOUT[i]).title);l.push([ABOUT[i],Number(x.value)]);}\n      var b=this;b.disabled=true;saveAll(l,b,function(){done.about=true;save('d',done);next();});\n    });\n  }\n  function ranking(t,k){\n    var n=5+k,order=[],opts=t.options;\n    function draw(){\n      var g=app.querySelector('.rank');\n      g.innerHTML=opts.map(function(o){var p=order.indexOf(o.label);return '<button type=\"button\" class=\"tile'+(p>=0?' on':'')+'\" data-l=\"'+o.label+'\" aria-label=\"Image '+o.label+(p>=0?', ranked '+(p+1):'')+'\"><img alt=\"Image '+o.label+'\" src=\"'+esc(sets[o.file].url)+'\">'+(p>=0?'<span class=\"n\">'+(p+1)+'</span>':'')+'</button>';}).join('');\n      app.querySelector('.status').textContent=order.length?('Your order: '+order.join(' > ')+(order.length<opts.length?'  (tap the next image)':'')):'Tap the image you like most first, then the next, and so on. Tap a numbered image to undo it.';\n      Array.prototype.forEach.call(g.querySelectorAll('.tile'),function(el){el.onclick=function(){var L=el.getAttribute('data-l'),p=order.indexOf(L);if(p>=0)order.splice(p,1);else order.push(L);hideErr();draw();};});\n    }\n    page(bar(n)+'<div class=\"card\"><b>'+n+'. '+esc(q('image_ranking').title)+'</b><div class=\"rank\" style=\"--n:'+opts.length+'\"></div><div class=\"status\"></div><div style=\"margin-top:10px\"><button type=\"button\" class=\"btn sec\" id=\"reset\">Start over</button></div></div>','Continue',function(){\n      if(order.length<opts.length)return err('Please rank all '+opts.length+' images.');\n      var v={order:order.slice(),ranks:{}};order.forEach(function(L,i){v.ranks[L]=i+1;});\n      var b=this;b.disabled=true;\n      SPSite.answer('image_ranking',v,{key:t.id,shown:opts.map(function(o){return o.file;})}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}done[t.id]=true;save('d',done);next();});\n    });\n    document.getElementById('reset').onclick=function(){order=[];draw();};\n    draw();\n  }\n  function rating(t,k){\n    var n=5+RS.length+k,f=land[t.file];\n    page(bar(n)+'<div class=\"card\"><b>'+n+'. '+esc(q('landscape_rating').title)+'</b><div class=\"pic\" style=\"margin-top:10px\"><img alt=\"Forest landscape '+(k+1)+'\" src=\"'+esc(f.url)+'\"></div>'+LCH.map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"rating\" value=\"'+c.value+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>',k===LT.length-1?'Finish':'Continue',function(){\n      var x=app.querySelector('input[name=\"rating\"]:checked');if(!x)return err('Please choose an answer.');\n      var b=this;b.disabled=true;\n      SPSite.answer('landscape_rating',{rating:Number(x.value)},{key:t.id,shown:[f.name]}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}done[t.id]=true;save('d',done);next();});\n    });\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>Each image series varied one visible attribute of the eight dominant tree species of Jiuzhaigou on the eastern Tibetan Plateau, such as crown shape, leaf shape or leaf colour; as in the original study, you were not told which species they were. The landscape photos showed autumn forest stands. In the original study, 532 people answered online. The researchers turned the rankings into an aesthetic score for each species, which agreed closely with the stand-level ratings (R = 0.925), and then mapped landscape aesthetic quality across Jiuzhaigou. Their forest-dynamics model projects that high-quality areas will rise slightly by 2056 and then decline sharply by 2096.</p><p style=\"font-size:.82rem\">Liu, J., Du, J., Zhang, C., Bachelot, B., Yang, Y., Dong, T., &amp; Wu, Y. (2025). Landscape Aesthetics Quality in Subalpine Forests of Eastern Tibetan Plateau Will Greatly Decrease by the End of the Century? Forests 16:1804, doi:10.3390/f16121804.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){if(x==='consent')done.intro=false;else if(x==='image_ranking')RS.forEach(function(t){done[t.id]=false;});else if(x==='landscape_rating')LT.forEach(function(t){done[t.id]=false;});else done.about=false;});save('d',done);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    try{SPEC=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){SPEC={pages:[]};}\n    SPEC.pages.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};Q[e.name]={type:e.type,title:g.title||e.title,choices:(g.choices&&g.choices.length)?g.choices:e.choices};if(e.name==='image_ranking')RS=e.trials;if(e.name==='landscape_rating'){LT=e.trials;LCH=e.items[0].choices;}});});\n    (SPSite.getMedia('sets')||[]).forEach(function(f){sets[f.name]=f;});\n    (SPSite.getMedia('landscapes')||[]).forEach(function(f){land[f.name]=f;});\n    var a=(ctx&&ctx.answers)||{};done=load('d')||{};\n    done.intro=a.consent===true;\n    done.about=ABOUT.every(function(n){return a[n]!=null;});\n    RS.concat(LT).forEach(function(t){done[t.id]=false;});\n    ((a.image_ranking&&a.image_ranking.trials)||[]).forEach(function(t){if(t.key)done[t.key]=true;});\n    ((a.landscape_rating&&a.landscape_rating.trials)||[]).forEach(function(t){if(t.key)done[t.key]=true;});\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
