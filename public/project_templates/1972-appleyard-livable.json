{\"type\": \"comment\", \"name\": \"interest_open\", \"title\": \"Do you find your street and the life that goes on there interesting? Do you get bored by life on this street? Do you find it monotonous?\", \"isRequired\": true, \"description\": \"Key question for the criterion 'identity and interest'.\"}, {\"type\": \"radiogroup\", \"name\": \"interest_rating\", \"title\": \"How interesting or monotonous is life on your street?\", \"isRequired\": true, \"choices\": [{\"value\": 1, \"text\": \"Very interesting\"}, {\"value\": 2, \"text\": \"Fairly interesting\"}, {\"value\": 3, \"text\": \"Neither\"}, {\"value\": 4, \"text\": \"Fairly monotonous\"}, {\"value\": 5, \"text\": \"Very monotonous\"}], \"description\": \"Self-rating added for this self-completed version; in the original the interviewers rated each open answer on a 5-point scale. 1 = most favourable, 5 = most unfavourable, the direction used in the paper.\"}]}, {\"name\": \"map\", \"elements\": [{\"type\": \"custom\", \"name\": \"street_map\", \"title\": \"Please draw a map of your street.\", \"isRequired\": true, \"description\": \"Value: {w, h, seconds, strokes:[{t, p:[x,y,x,y,…]}], labels:[{t, x, y, s}]} in drawing order. In the original the maps of each street were combined into a composite showing how many residents drew each feature.\"}]}, {\"name\": \"closing\", \"elements\": [{\"type\": \"comment\", \"name\": \"improve\", \"title\": \"What would you suggest to improve your street?\", \"isRequired\": false, \"description\": \"The interview was introduced as a survey of what it is like to live on the street and what the resident would suggest for its improvement.\"}]}]}}\n</script>\n<style>\n:root{--bg:#f2f1ed;--card:#fff;--ink:#1d1e21;--muted:#5d6066;--accent:#1f5f4a;--accent-ink:#fff;--line:#d9d6cf;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:920px;margin:0 auto;padding:20px 16px 40px}h1{font-size:1.3rem;margin:0 0 8px}p{margin:0 0 10px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}.btn:disabled{opacity:.4;cursor:not-allowed}\n.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent)}.btn.sm{padding:7px 12px;font-size:.9rem}.btn.sel{background:var(--ink);color:#fff;border-color:var(--ink)}\n.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;align-items:center}\n.q{margin-top:16px}.q>b{display:block;margin-bottom:6px;font-weight:600}\ntextarea,input[type=text],input[type=number]{width:100%;font:inherit;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}\ntextarea{min-height:110px;resize:vertical}input[type=number]{width:140px}\nlabel.o{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.step{display:inline-block;padding:2px 10px;border-radius:999px;background:#dfeee8;color:#174a39;font-size:.85rem;font-weight:600;margin-bottom:8px}\n.sheet{position:relative;border:1px solid #bdb9b0;background:#fffdf8;border-radius:6px;overflow:hidden;touch-action:none}\n.sheet canvas{display:block;width:100%;height:auto;cursor:crosshair;user-select:none;-webkit-user-select:none}\n.sheet input{position:absolute;width:150px;padding:3px 6px;font-size:.85rem;border:1px solid var(--accent);border-radius:6px;z-index:2}\n.tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0}\n.clock{margin-left:auto;font-variant-numeric:tabular-nums;color:var(--muted);font-size:.9rem}\n.compass{display:grid;grid-template-columns:repeat(3,56px);gap:6px;margin-top:8px}\n.compass button{height:44px;border:1px solid var(--line);background:#fff;border-radius:8px;font-size:1.2rem;cursor:pointer}.compass button.sel{background:var(--accent);color:#fff;border-color:var(--accent)}\n.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:.85rem;color:var(--muted);margin-top:6px}.legend i{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:5px;vertical-align:-1px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:920px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Method: Appleyard, D., &amp; Lintell, M. (1972). The environmental quality of city streets: The residents' viewpoint. <i>Journal of the American Institute of Planners</i>, 38(2), 84–101. Question wording follows the version printed in <i>Highway Research Record</i> 356 (1971), 69–84. The street diagram is a generic block, not a picture of your street.</footer>\n<script>\n(function(){\n  var app=document.getElementById('app'),A={};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function has(n){var v=A[n];return v!=null&&v!=='';}\n  function T(n){return SPSite.getQuestion(n).title;}\n  var PAGES=[\n    {step:'About you',names:['street','years_on_street','tenure','age_group','children']},\n    {step:'Part 1 of 6 · traffic and nuisance',names:['traffic_open','traffic_rating','nuisance_open','nuisance_rating']},\n    {step:'Part 2 of 6 · neighbours and home',names:['gather_open','friendly_rating','territory_open','privacy_rating']},\n    {step:'Part 3 of 6 · your street block',diagram:true},\n    {step:'Part 4 of 6 · the character of your street',names:['features','different','interest_open','interest_rating']},\n    {step:'Part 5 of 6 · a map of your street',map:true},\n    {step:'Part 6 of 6 · improvements',names:['improve'],last:true}];\n  var OPT={improve:1},lastDone=false;\n  function req(n){return !OPT[n];}\n  function next(){window.scrollTo(0,0);\n    if(A.consent!==true)return intro();\n    for(var i=0;i<PAGES.length;i++){var P=PAGES[i];\n      if(P.diagram){if(!has('street_diagram')||!has('across_street_count'))return diagramPage(P);continue;}\n      if(P.map){if(!has('street_map'))return mapPage(P);continue;}\n      if(P.last){if(!lastDone&&!has('improve'))return form(P);continue;}\n      for(var k=0;k<P.names.length;k++)if(req(P.names[k])&&!has(P.names[k]))return form(P);}\n    finish();}\n  function intro(){\n    app.innerHTML='<h1>What is it like to live on your street?</h1><p>This is a survey of what it is like to live on your street, what you think of it, and what you would suggest to improve it. You will answer some questions in your own words, mark a few things on a simple diagram of your street block, and draw a quick map of your street from memory.</p><p>It takes about 15 minutes and works best on a computer or tablet.</p><div class=\"card\"><p>'+esc(T('consent'))+'</p><div class=\"row\"><button class=\"btn\" id=\"yes\">I agree</button></div><div class=\"err\"></div></div>';\n    document.getElementById('yes').onclick=function(){var b=this;b.disabled=true;SPSite.answer('consent',true).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}A.consent=true;next();});};}\n  function form(P){\n    var h='<div class=\"card\"><span class=\"step\">'+esc(P.step)+'</span>';\n    P.names.forEach(function(n){var q=SPSite.getQuestion(n);h+='<div class=\"q\"><b>'+esc(T(n))+(req(n)?'':' <span style=\"font-weight:400;color:#777\">(optional)</span>')+'</b>';\n      if(q.type==='radiogroup')h+=q.choices.map(function(c){return '<label class=\"o\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');\n      else if(q.type==='comment')h+='<textarea id=\"f_'+n+'\"></textarea>';\n      else h+='<input id=\"f_'+n+'\" type=\"'+(q.kind==='number'?'number':'text')+'\"'+(q.kind==='number'?' min=\"0\" max=\"100\"':'')+'>';\n      h+='</div>';});\n    app.innerHTML=h+'<div class=\"row\"><button class=\"btn\" id=\"go\">'+(P.last?'Finish':'Continue')+'</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var v={};\n      for(var k=0;k<P.names.length;k++){var n=P.names[k],q=SPSite.getQuestion(n),x;\n        if(q.type==='radiogroup'){var c=app.querySelector('input[name=\"'+n+'\"]:checked');x=c?c.value:'';if(x!==''&&typeof q.choices[0].value==='number')x=Number(x);}\n        else{x=document.getElementById('f_'+n).value.trim();if(q.kind==='number'&&x!==''){x=Number(x);if(isNaN(x)||x<0||x>100)return err('Please enter a number of years.');}}\n        if(req(n)&&x==='')return err('Please answer: '+T(n).slice(0,80)+(T(n).length>80?'…':''));\n        if(x!=='')v[n]=x;}\n      var b=this,ks=Object.keys(v);b.disabled=true;\n      Promise.all(ks.map(function(n){return SPSite.answer(n,v[n]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}ks.forEach(function(n){A[n]=v[n];});\n        if(P.last)lastDone=true;next();});};}\n  function pt(cv,W,H,e){var r=cv.getBoundingClientRect();return [Math.round((e.clientX-r.left)/r.width*W),Math.round((e.clientY-r.top)/r.height*H)];}\n  function diagramPage(P){\n    var V=window.innerWidth<700,W=1000,H=460,N=10,home=null,st={},dots=[],terr=[],acts=[],mode='home',cur=null,HX=50,HW=90,GAP=4;\n    var MODES=[['home','My home','#1f5f4a'],['friend','Friend or relative','#2c7be5'],['acq','Acquaintance','#e09b1a'],['gather','Where people gather','#c0392b'],['terr','My home territory','#7a3fb5']];\n    var HELP={home:'Tap the building that is closest to where your home is on the block.',friend:'Tap every building where a friend or relative of yours lives. Tap again to remove.',acq:'Tap every building where an acquaintance lives (someone you know to say hello to). Tap again to remove.',gather:'Tap the places on the street where people gather or stop to talk, if there are any.',terr:'Draw a line around the area you feel is your own territory or turf. It can be your home only, or include the sidewalk or the street.'};\n    app.innerHTML='<div class=\"card\"><span class=\"step\">'+esc(P.step)+'</span><h1>'+esc(T('street_diagram'))+'</h1><p>The diagram shows a street block seen from above: buildings on both sides (A and B), sidewalks, and the roadway in the middle. It is not exact; choose the nearest position. Go through the five buttons from left to right.</p><div class=\"tools\" id=\"modes\">'+MODES.map(function(m){return '<button class=\"btn sm ghost\" data-m=\"'+m[0]+'\">'+m[1]+'</button>';}).join('')+'<button class=\"btn sm ghost\" id=\"undo\">Undo</button></div><p id=\"help\" style=\"color:#1d1e21;font-weight:600;min-height:4.6em\"></p><div class=\"sheet\" id=\"sheet\"><canvas id=\"cv\" width=\"'+(V?H:W)+'\" height=\"'+(V?W:H)+'\"></canvas></div><div class=\"legend\">'+MODES.map(function(m){return '<span><i style=\"background:'+m[2]+'\"></i>'+m[1]+'</span>';}).join('')+'</div><div class=\"row\"><button class=\"btn\" id=\"go\">I have marked everything</button></div><div class=\"err\"></div></div>';\n    var cv=document.getElementById('cv'),cx=cv.getContext('2d');cv.style.cursor='pointer';\n    function rect(id){var top=id.charAt(0)==='A',i=Number(id.slice(1))-1;return [HX+i*HW+GAP/2,top?20:340,HW-GAP,100];}\n    function hit(p){var row=p[1]>=20&&p[1]<=120?'A':(p[1]>=340&&p[1]<=440?'B':null);if(!row||p[0]<HX||p[0]>=HX+N*HW)return null;return row+(Math.floor((p[0]-HX)/HW)+1);}\n    function FR(x,y,w,h){if(V)cx.fillRect(y,x,h,w);else cx.fillRect(x,y,w,h);}\n    function SR(x,y,w,h){if(V)cx.strokeRect(y,x,h,w);else cx.strokeRect(x,y,w,h);}\n    function MT(x,y){if(V)cx.moveTo(y,x);else cx.moveTo(x,y);}\n    function LT(x,y){if(V)cx.lineTo(y,x);else cx.lineTo(x,y);}\n    function TX(t,x,y){if(V)cx.fillText(t,y,x+5);else cx.fillText(t,x,y);}\n    function redraw(){cx.clearRect(0,0,V?H:W,V?W:H);cx.fillStyle='#e9e6df';FR(0,120,W,30);FR(0,310,W,30);cx.fillStyle='#c9c6bf';FR(0,150,W,160);FR(0,0,HX-10,H);FR(HX+N*HW+10,0,W,H);\n      cx.strokeStyle='#fff';cx.lineWidth=3;cx.setLineDash([24,18]);cx.beginPath();MT(HX,230);LT(HX+N*HW,230);cx.stroke();cx.setLineDash([]);\n      cx.font=(V?'20px':'13px')+' system-ui,sans-serif';cx.textAlign='center';cx.fillStyle='#6b6b6b';if(!V){TX('sidewalk',W/2,140);TX('sidewalk',W/2,330);}TX('roadway',W/2,V?205:222);\n      ['A','B'].forEach(function(r){for(var i=1;i<=N;i++){var id=r+i,b=rect(id),s=id===home?'home':st[id];\n        cx.fillStyle=s==='home'?'#1f5f4a':s==='friend'?'#2c7be5':s==='acq'?'#e09b1a':'#fff';cx.strokeStyle='#8d8a83';cx.lineWidth=1.5;FR(b[0],b[1],b[2],b[3]);SR(b[0],b[1],b[2],b[3]);\n        cx.fillStyle=s?'#fff':'#9a978f';cx.font=(s?'600 ':'')+(V?'22px':'14px')+' system-ui,sans-serif';TX(s==='home'?'HOME':s==='friend'?'friend':s==='acq'?'acq.':id,b[0]+b[2]/2,b[1]+b[3]/2+(V?0:5));}});\n      cx.strokeStyle='#7a3fb5';cx.lineWidth=V?6:4;cx.lineCap='round';cx.lineJoin='round';terr.forEach(function(s){cx.beginPath();MT(s[0],s[1]);for(var i=2;i<s.length;i+=2)LT(s[i],s[i+1]);cx.stroke();});\n      cx.fillStyle='#c0392b';dots.forEach(function(d){cx.beginPath();if(V)cx.arc(d[1],d[0],13,0,7);else cx.arc(d[0],d[1],9,0,7);cx.fill();});}\n    function PT(e){var q=pt(cv,V?H:W,V?W:H,e);return V?[q[1],q[0]]:q;}\n    function setMode(m){mode=m;document.querySelectorAll('#modes [data-m]').forEach(function(b){b.classList.toggle('sel',b.getAttribute('data-m')===m);});document.getElementById('help').textContent=HELP[m];document.getElementById('sheet').style.touchAction=m==='terr'?'none':'pan-y';}\n    document.querySelectorAll('#modes [data-m]').forEach(function(b){b.onclick=function(){setMode(b.getAttribute('data-m'));};});\n    document.getElementById('undo').onclick=function(){var a=acts.pop();if(!a)return;if(a.k==='home')home=a.prev;else if(a.k==='st'){if(a.prev)st[a.id]=a.prev;else delete st[a.id];}else if(a.k==='dot')dots.pop();else terr.pop();redraw();};\n    cv.addEventListener('pointerdown',function(e){e.preventDefault();var p=PT(e);err('');\n      if(mode==='terr'){cv.setPointerCapture(e.pointerId);cur=[p[0],p[1]];terr.push(cur);acts.push({k:'terr'});redraw();return;}\n      if(mode==='gather'){dots.push(p);acts.push({k:'dot'});redraw();return;}\n      var id=hit(p);if(!id)return;\n      if(mode==='home'){acts.push({k:'home',prev:home});home=id;delete st[id];redraw();setMode('friend');return;}\n      if(id===home)return err('That building is your own home.');\n      acts.push({k:'st',id:id,prev:st[id]});if(st[id]===mode)delete st[id];else st[id]=mode;redraw();});\n    cv.addEventListener('pointermove',function(e){if(!cur)return;var p=PT(e),n=cur.length,dx=p[0]-cur[n-2],dy=p[1]-cur[n-1];if(dx*dx+dy*dy<25)return;cur.push(p[0],p[1]);redraw();});\n    function up(){cur=null;}cv.addEventListener('pointerup',up);cv.addEventListener('pointercancel',up);\n    setMode('home');redraw();\n    document.getElementById('go').onclick=function(){\n      if(!home){setMode('home');return err('Please mark your own home first.');}\n      var fr=[],ac=[];Object.keys(st).sort().forEach(function(id){(st[id]==='friend'?fr:ac).push(id);});\n      var t2=terr.filter(function(s){return s.length>=6;});\n      var across=fr.concat(ac).filter(function(id){return id.charAt(0)!==home.charAt(0);}).length;\n      var val={w:W,h:H,shown:V?'upright':'flat',houses_per_side:N,home:home,friends:fr,acquaintances:ac,gathering:dots,territory:t2};\n      var b=this,items=[['street_diagram',val],['friends_count',fr.length],['acquaintances_count',ac.length],['across_street_count',across]];b.disabled=true;\n      Promise.all(items.map(function(x){return SPSite.answer(x[0],x[1]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}items.forEach(function(x){A[x[0]]=x[1];});next();});};}\n  function mapPage(P){\n    var narrow=window.innerWidth<700,W=narrow?640:1100,H=narrow?560:520,strokes=[],labels=[],mode='draw',t0=null,cur=null;\n    app.innerHTML='<div class=\"card\"><span class=\"step\">'+esc(P.step)+'</span><h1>'+esc(T('street_map'))+'</h1><p>Draw it from memory, with whatever you think belongs on it. A rough sketch is enough. Draw with your finger, pen or mouse; use <b>Add a name</b> and tap the sheet to write a word on the map.</p><div class=\"tools\"><button class=\"btn sm ghost sel\" id=\"mDraw\">Draw</button><button class=\"btn sm ghost\" id=\"mName\">Add a name</button><button class=\"btn sm ghost\" id=\"undo\">Undo</button></div><div class=\"sheet\" id=\"sheet\"><canvas id=\"cv\" width=\"'+W+'\" height=\"'+H+'\"></canvas></div><div class=\"row\"><button class=\"btn\" id=\"go\">My map is finished</button></div><div class=\"err\"></div></div>';\n    var cv=document.getElementById('cv'),cx=cv.getContext('2d'),sheet=document.getElementById('sheet');\n    function now(){if(t0==null)t0=Date.now();return Math.round((Date.now()-t0)/100)/10;}\n    function redraw(){cx.clearRect(0,0,W,H);cx.lineWidth=2.5;cx.lineCap='round';cx.lineJoin='round';cx.strokeStyle='#111';\n      strokes.forEach(function(s){cx.beginPath();cx.moveTo(s.p[0],s.p[1]);for(var i=2;i<s.p.length;i+=2)cx.lineTo(s.p[i],s.p[i+1]);if(s.p.length===2)cx.lineTo(s.p[0]+.1,s.p[1]+.1);cx.stroke();});\n      cx.font='600 18px system-ui,sans-serif';cx.fillStyle='#1f5f4a';labels.forEach(function(l){cx.fillText(l.s,l.x,l.y);});}\n    function setMode(m){mode=m;document.getElementById('mDraw').classList.toggle('sel',m==='draw');document.getElementById('mName').classList.toggle('sel',m==='name');}\n    document.getElementById('mDraw').onclick=function(){setMode('draw');};document.getElementById('mName').onclick=function(){setMode('name');};\n    document.getElementById('undo').onclick=function(){var ls=labels.length?labels[labels.length-1].t:-1,ss=strokes.length?strokes[strokes.length-1].t:-1;if(ls<0&&ss<0)return;if(ls>ss)labels.pop();else strokes.pop();redraw();};\n    cv.addEventListener('click',function(e){if(mode!=='name')return;var p=pt(cv,W,H,e),old=sheet.querySelector('input');if(old)old.blur();\n      var r=cv.getBoundingClientRect(),inp=document.createElement('input');inp.type='text';inp.maxLength=40;inp.placeholder='name, then Enter';\n      inp.style.left=Math.min(r.width-155,Math.max(0,e.clientX-r.left))+'px';inp.style.top=Math.min(r.height-30,Math.max(0,e.clientY-r.top-14))+'px';sheet.appendChild(inp);inp.focus();\n      var done=false;function commit(){if(done)return;done=true;var s=inp.value.trim();inp.remove();if(s){labels.push({t:now(),x:p[0],y:p[1],s:s});redraw();}}\n      inp.addEventListener('keydown',function(k){if(k.key==='Enter'){k.preventDefault();commit();}});inp.addEventListener('blur',commit);});\n    cv.addEventListener('pointerdown',function(e){if(mode==='name')return;e.preventDefault();var p=pt(cv,W,H,e);\n      cv.setPointerCapture(e.pointerId);cur={t:now(),p:[p[0],p[1]]};strokes.push(cur);redraw();});\n    cv.addEventListener('pointermove',function(e){if(!cur)return;var p=pt(cv,W,H,e),n=cur.p.length,dx=p[0]-cur.p[n-2],dy=p[1]-cur.p[n-1];if(dx*dx+dy*dy<16)return;cur.p.push(p[0],p[1]);redraw();});\n    function up(){cur=null;}cv.addEventListener('pointerup',up);cv.addEventListener('pointercancel',up);\n    document.getElementById('go').onclick=function(){var open=sheet.querySelector('input');if(open)open.blur();\n      var len=strokes.reduce(function(a,s){return a+s.p.length/2;},0);\n      if(strokes.length<2||len<20)return err('Please draw your street first. A rough sketch is enough.');\n      var b=this,val={w:W,h:H,seconds:now(),strokes:strokes,labels:labels};b.disabled=true;\n      SPSite.answer('street_map',val).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}A.street_map=val;next();});};}\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>Donald Appleyard and Mark Lintell asked these questions on three similar San Francisco streets that differed mainly in traffic: about 2,000, 8,000 and 16,000 vehicles a day. On the street with light traffic residents had three times as many friends and twice as many acquaintances on their block as on the street with heavy traffic, they treated the whole street as their territory, and they drew much richer maps of it. On the heavy street people withdrew into their homes.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');return;}var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';});}\n  SPSite.onReady(function(ctx){A=(ctx&&ctx.answers)||{};next();});\n})();\n</script>\n</body>\n</html>\n",
