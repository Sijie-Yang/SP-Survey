       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"visited\",\n      \"title\": \"Have you ever visited the Humble Administrator's Garden (Zhuozhengyuan) in Suzhou?\",\n      \"description\": \"The original study included only people who had never visited the garden; filter out 'yes' to match it.\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"no\",\n        \"text\": \"No\"\n       },\n       {\n        \"value\": \"yes\",\n        \"text\": \"Yes\"\n       },\n       {\n        \"value\": \"unsure\",\n        \"text\": \"Not sure\"\n       }\n      ]\n     }\n    ]\n   },\n   {\n    \"name\": \"videos\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"order\",\n      \"title\": \"Order of the two viewings (set at random by the page)\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"sound_first\",\n        \"text\": \"With sound first, then muted\"\n       },\n       {\n        \"value\": \"muted_first\",\n        \"text\": \"Muted first, then with sound\"\n       }\n      ]\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"sd_01_like\",\n      \"title\": \"Like — dislike\",\n      \"description\": \"Semantic differential pair 1 of 17, −2 = very like, 0 = neither, +2 = very dislike. Keyed 'with_sound' / 'muted'.\",\n      \"rateMin\": -2,\n      \"rateMax\": 2,\n      \"minRateDescription\": \"Very like\",\n      \"maxRateDescription\": \"Very dislike\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"sd_02_comfortable\",\n      \"title\": \"Comfortable — uncomfortable\",\n      \"description\": \"Semantic differential pair 2 of 17, −2 = very comfortable, 0 = neither, +2 = very uncomfortable. Keyed 'with_sound' / 'muted'.\",\n      \"rateMin\": -2,\n      \"rateMax\": 2,\n      \"minRateDescription\": \"Very comfortable\",\n      \"maxRateDescription\": \"Very uncomfortable\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"sd_03_familiar\",\n      \"title\": \"Familiar — unfamiliar\",\n      \"description\": \"Semantic differential pair 3 of 17, −2 = very familiar, 0 = neither, +2 = very unfamiliar. Keyed 'with_sound' / 'muted'.\",\n      \"rateMin\": -2,\n      \"rateMax\": 2,\n      \"minRateDescription\": \"Very familiar\",\n      \"maxRateDescription\": \"Very unfamiliar\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"sd_04_happy\",\n      \"title\": \"Happy — sad\",\n      \"description\": \"Semantic differential pair 4 of 17, −2 = very happy, 0 = neither, +2 = very sad. Keyed 'with_sound' / 'muted'.\",\n      \"rateMin\": -2,\n      \"rateMax\": 2,\n      \"minRateDescription\": \"Very happy\",\n      \"maxRateDescription\": \"Very sad\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"sd_05_relieved\",\n      \"title\": \"Relieved — unrelieved\",\n      \"description\": \"Semantic differential pair 5 of 17, −2 = very relieved, 0 = neither, +2 = very unrelieved. Keyed 'with_sound' / 'muted'.\",\n      \"rateMin\": -2,\n      \"rateMax\": 2,\n      \"minRateDescription\": \"Very relieved\",\n      \"maxRateDescription\": \"Very unrelieved\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"sd_06_calm\",\n      \"title\": \"Calm — agitated\",\n      \"description\": \"Semantic differential pair 6 of 17, −2 = very calm, 0 = neither, +2 = very agitated. Keyed 'with_sound' / 'muted'.\",\n      \"rateMin\": -2,\n      \"rateMax\": 2,\n      \"minRateDescription\": \"Very calm\",\n      \"maxRateDescription\": \"Very agitated\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"sd_07_natural\",\n      \"title\": \"Natural — artificial\",\n      \"description\": \"Semantic differential pair 7 of 17, −2 = ve