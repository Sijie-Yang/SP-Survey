   \"type\": \"rating\",\n      \"name\": \"sd_12_static\",\n      \"title\": \"Static — active\",\n      \"description\": \"Semantic differential pair 12 of 17, −2 = very static, 0 = neither, +2 = very active. Keyed 'with_sound' / 'muted'.\",\n      \"rateMin\": -2,\n      \"rateMax\": 2,\n      \"minRateDescription\": \"Very static\",\n      \"maxRateDescription\": \"Very active\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"sd_13_relax\",\n      \"title\": \"Relax — tense\",\n      \"description\": \"Semantic differential pair 13 of 17, −2 = very relax, 0 = neither, +2 = very tense. Keyed 'with_sound' / 'muted'.\",\n      \"rateMin\": -2,\n      \"rateMax\": 2,\n      \"minRateDescription\": \"Very relax\",\n      \"maxRateDescription\": \"Very tense\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"sd_14_classic\",\n      \"title\": \"Classic — modern\",\n      \"description\": \"Semantic differential pair 14 of 17, −2 = very classic, 0 = neither, +2 = very modern. Keyed 'with_sound' / 'muted'.\",\n      \"rateMin\": -2,\n      \"rateMax\": 2,\n      \"minRateDescription\": \"Very classic\",\n      \"maxRateDescription\": \"Very modern\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"sd_15_harmonious\",\n      \"title\": \"Harmonious — discordant\",\n      \"description\": \"Semantic differential pair 15 of 17, −2 = very harmonious, 0 = neither, +2 = very discordant. Keyed 'with_sound' / 'muted'.\",\n      \"rateMin\": -2,\n      \"rateMax\": 2,\n      \"minRateDescription\": \"Very harmonious\",\n      \"maxRateDescription\": \"Very discordant\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"sd_16_pleasant\",\n      \"title\": \"Pleasant — unenjoyable\",\n      \"description\": \"Semantic differential pair 16 of 17, −2 = very pleasant, 0 = neither, +2 = very unenjoyable. Keyed 'with_sound' / 'muted'.\",\n      \"rateMin\": -2,\n      \"rateMax\": 2,\n      \"minRateDescription\": \"Very pleasant\",\n      \"maxRateDescription\": \"Very unenjoyable\",\n      \"isRequired\": true\n     },\n     {\n      \"type\": \"rating\",\n      \"name\": \"sd_17_unique\",\n      \"title\": \"Unique — ordinary\",\n      \"description\": \"Semantic differential pair 17 of 17, −2 = very unique, 0 = neither, +2 = very ordinary. Keyed 'with_sound' / 'muted'.\",\n      \"rateMin\": -2,\n      \"rateMax\": 2,\n      \"minRateDescription\": \"Very unique\",\n      \"maxRateDescription\": \"Very ordinary\",\n      \"isRequired\": true\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"rain-original\">{\"source\": \"Sun & Dong (2022) Front Psychol 13:902630, Table 2\", \"n\": 24, \"sample\": \"students, Jiaxing University, never visited the garden\", \"result\": \"With sound, the scene was rated significantly more familiar (g = 0.65), calmer (0.57), more varied (0.60), brighter (0.46), warmer (0.67), less static (0.50) and more pleasant (0.76) than the same video muted; the banana leaves also drew more visual attention with sound.\"}</script>\n<style>\n:root{--bg:#f2f4f2;--card:#fff;--ink:#1e2622;--muted:#5d6862;--accent:#3c6656;--line:#d9e1dc;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:860px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.1rem;margin:0 0 8px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.vid{position:relative;background:#000;border-radius:12px;overflow:hidden}.vid video{width:100%;display:block}\n.vid .cover{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.55);color:#fff;flex-direction:column;gap:10px;text-align:center;padding:12px}\n.bar{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin-top:10px}.bar>i{display:block;height:100%;width:0;background:var(--accent)}\n.tag{display:inline-block;padding:2px 10px;border-radius:999px;background:#e5eee9;color:var(--accent);font-weight:600;font-size:.85rem;margin-bottom:8px}\n.sd{display:grid;grid-template-columns:7.5em 1fr 7.5em;gap:8px;align-items:center;padding:7px 0;border-top:1px solid var(--line)}.sd:first-of-type{border-top:0}\n.sd .l{text-align:right}.sd.miss .l,.sd.miss .r{color:var(--warn);font-weight:600}\n.sd .scale{display:grid;grid-template-columns:repeat(5,1fr);gap:4px}\n.sd .scale button{appearance:none;border:1px solid var(--line);background:#fff;border-radius:8px;padding:7px 0;font:inherit;font-size:.85rem;cursor:pointer;color:var(--ink)}\n.sd .scale button.on{background:var(--accent);border-color:var(--accent);color:#fff}\n.hdr{display:grid;grid-template-columns:7.5em 1fr 7.5em;gap:8px;font-size:.75rem;color:var(--muted)}.hdr .scale{display:grid;grid-template-columns:repeat(5,1fr);text-align:center}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:16px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:110px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media(max-width:560px){.sd,.hdr{grid-template-columns:5.2em 1fr 5.2em;font-size:.85rem}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Video: Sun &amp; Dong (2022), Frontiers in Psychology 13:902630, Supplementary Video 1 (CC BY 4.0); first 60 s, sound level raised for online playback.</footer>\n<script>\n(function(){\n  var KEY='tingyuxuan-rain:state', VIEW=window.__VIEWMS||0;\n  var app=document.getElementById('app'), Q={}, SD=[], vfile=null, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function intro(){\n    app.innerHTML='<h1>Rain in a Chinese garden</h1><p>You will watch the same one-minute video of a classical Chinese garden in the rain twice: once with sound and once without. After each viewing you describe how the scene felt using 17 pairs of opposite words. Please sit somewhere quiet; speakers or headphones are needed. It takes about 6 minutes.</p><div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');send([SPSite.answer('consent',true)],this,function(){st.step='about';save();route();});};\n  }\n  function radios(q){return '<div class=\"f\"><b>'+esc(Q[q].title)+'</b>'+(Q[q].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+q+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\"><div class=\"f\" style=\"margin-top:0\"><b>'+esc(Q.age.title)+'</b><br><input type=\"number\" id=\"age\" min=\"18\" max=\"99\"></div>'+radios('gender')+radios('visited')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var age=Number(document.getElementById('age').value);if(!(age>=18&&age<=99))return err('Please enter your age (18 or older).');\n      var g=app.querySelector('input[name=gender]:checked');if(!g)return err('Please answer: '+Q.gender.title);\n      var v=app.querySelector('input[name=visited]:checked');if(!v)return err('Please say whether you have visited the garden.');\n      send([SPSite.answer('age',age),SPSite.answer('gender',g.value),SPSite.answer('visited',v.value),SPSite.answer('order',st.order[0]==='with_sound'?'sound_first':'muted_first')],this,function(){st.step='watch';st.k=0;save();route();});\n    };\n  }\n  function watch(){\n    var cond=st.order[st.k], sound=cond==='with_sound';\n    app.innerHTML='<span class=\"tag\">Viewing '+(st.k+1)+' of 2 · '+(sound?'with sound':'without sound')+'</span><p>'+(sound?'Turn your sound on and set it so the rain sounds like real, light rain in a quiet room.':'This time the video plays without sound.')+' Press play and watch the whole minute.</p><div class=\"vid\"><video id=\"v\" playsinline preload=\"auto\" '+(sound?'':'muted')+' src=\"'+esc(vfile.url)+'\"></video><div class=\"cover\" id=\"cv\"><button class=\"btn\" id=\"pl\">▶ Play (1 minute)</button></div></div><div class=\"bar\"><i id=\"bar\"></i></div><div class=\"err\"></div>';\n    var v=document.getElementById('v'),bar=document.getElementById('bar'),cv=document.getElementById('cv'),done=false;\n    v.muted=!sound;\n    function fin(){if(done)return;done=true;v.pause();st.step='rate';save();route();}\n    v.addEventListener('timeupdate',function(){var d=Math.min(v.duration||60,60);bar.style.width=Math.min(100,v.currentTime/d*100)+'%';if(v.currentTime>=60)fin();});\n    v.addEventListener('ended',fin);\n    v.addEventListener('pause',function(){if(!done){cv.style.display='flex';document.getElementById('pl').textContent='▶ Continue playing';}});\n    document.getElementById('pl').onclick=function(){cv.style.display='none';var p=v.play();if(p&&p.catch)p.catch(function(){cv.style.display='flex';err('The video could not start. Please press play again.');});if(VIEW)setTimeout(fin,VIEW);};\n  }\n  function rate(){\n    var cond=st.order[st.k], vals={};\n    app.innerHTML='<span class=\"tag\">Viewing '+(st.k+1)+' of 2 · '+(cond==='with_sound'?'with sound':'without sound')+'</span><h2>How did the scene you just watched feel?</h2><p>For each pair, choose the box closer to the word that fits better; the middle box means neither.</p><div class=\"card\"><div class=\"hdr\"><span></span><div class=\"scale\"><span>very</span><span>a little</span><span>neither</span><span>a little</span><span>very</span></div><span></span></div>'+SD.map(function(n){return '<div class=\"sd\" data-k=\"'+n+'\"><span class=\"l\">'+esc(Q[n].title.split(' — ')[0])+'</span><div class=\"scale\">'+[-2,-1,0,1,2].map(function(x){return '<button type=\"button\" data-v=\"'+x+'\" aria-label=\"'+x+'\">'+(x>0?'+'+x:x)+'</button>';}).join('')+'</div><span class=\"r\">'+esc(Q[n].title.split(' — ')[1]||'')+'</span></div>';}).join('')+'<div style=\"margin-top:14px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    app.querySelectorAll('.sd').forEach(function(r){r.querySelectorAll('button').forEach(function(b){b.onclick=function(){vals[r.dataset.k]=Number(b.dataset.v);r.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b);});r.classList.remove('miss');};});});\n    document.getElementById('go').onclick=function(){\n      var m=SD.filter(function(n){return vals[n]==null;});\n      if(m.length){m.forEach(function(n){app.querySelector('.sd[data-k=\"'+n+'\"]').classList.add('miss');});return err('Please answer every pair ('+m.length+' missing, marked in red).');}\n      send(SD.map(function(n){return SPSite.answer(n,vals[n],{key:cond,shown:[vfile.name]});}),this,function(){st.k++;st.step=st.k>=2?'done':'watch';save();route();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='about')return about();if(s==='watch')return watch();if(s==='rate')return rate();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    var sc=JSON.parse(document.getElementById('sp-scheme').textContent).survey;\n    sc.pages.forEach(function(p){p.elements.forEach(function(e){if(/^sd_/.test(e.name))SD.push(e.name);});});\n    ['consent','age','gender','visited','order'].concat(SD).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('video')||[]).forEach(function(f){if(!vfile&&/\\.(mp4|webm|mov)$/i.test(f.name))vfile=f;});\n    if(!vfile){app.innerHTML='<h1>Video missing</h1><p>Upload the garden video to the media folder \"video\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    if(!(st&&st.order))st={step:'intro',k:0,order:Math.random()<0.5?['with_sound','muted']:['muted','with_sound']};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true){st.step='intro';st.k=0;}\n    if(st.step==='rate')st.step='watch';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
