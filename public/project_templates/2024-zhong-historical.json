   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Irrigation Canals</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Historical Irrigation Canals\",\n  \"description\": \"Faithful replication of the photo survey in Zhong, Zhang, Xia, Hao & Tan (2024), Buildings 14(7):1955, with the authors' 18 photographs of historical irrigation canals in the Li Canal-Gaoyou Irrigation District, China (a World Heritage Irrigation Structure). Participants rate each canal scene for beauty, sense of history and local distinctiveness, and tick which recreational activities would suit it.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"canals\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"canals\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I have read the information above and agree to take part.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"Yes\",\n      \"labelFalse\": \"No\"\n     },\n     {\n      \"type\": \"imageslidergroup\",\n      \"name\": \"ratings\",\n      \"title\": \"Aesthetic preference per photograph\",\n      \"isRequired\": true,\n      \"imageCount\": 1,\n      \"scaleMin\": 1,\n      \"scaleMax\": 5,\n      \"description\": \"One row per photograph (key = canal_01 … canal_18, the photo numbers of the paper's Figure 3, ordered from main to branch to tertiary canals). All 18 photos in random order after an overview of all of them; three 1–5 items per photo. Aesthetic preference = mean of beauty, historicity and locality.\",\n      \"dimensions\": [\n       {\n        \"id\": \"beauty\",\n        \"label\": \"Do you think this scene is beautiful or not?\",\n        \"left\": \"Very unbeautiful\",\n        \"right\": \"Very beautiful\",\n        \"min\": 1,\n        \"max\": 5,\n        \"step\": 1,\n        \"labels\": [\n         \"Very unbeautiful\",\n         \"Unbeautiful\",\n         \"Average\",\n         \"Beautiful\",\n         \"Very beautiful\"\n        ]\n       },\n       {\n        \"id\": \"historicity\",\n        \"label\": \"Do you think this scene evokes a sense of history and heritage?\",\n        \"left\": \"Not at all\",\n        \"right\": \"Strongly\",\n        \"min\": 1,\n        \"max\": 5,\n        \"step\": 1,\n        \"labels\": [\n         \"Not at all\",\n         \"Barely\",\n         \"Average\",\n         \"Somewhat\",\n         \"Strongly\"\n        ]\n       },\n       {\n        \"id\": \"locality\",\n        \"label\": \"Does this scene appear unique to you, reflecting distinct local characteristics?\",\n        \"left\": \"Not at all\",\n        \"right\": \"Strongly\",\n        \"min\": 1,\n        \"max\": 5,\n        \"step\": 1,\n        \"labels\": [\n         \"Not at all\",\n         \"Barely\",\n         \"Average\",\n         \"Somewhat\",\n         \"Strongly\"\n        ]\n       }\n      ]\n     },\n     {\n      \"type\": \"custom\",\n      \"name\": \"activities\",\n      \"title\": \"Suitable recreational activities per photograph\",\n      \"isRequired\": true,\n      \"description\": \"One row per photograph (same keys). Value { walking, jogging, biking, swimming, boating, fishing: 1 if ticked else 0, none: 1 if 'No suitable activities' }. Recreational preference in the paper = mean of the six 0/1 values. Analysis in the paper: descriptive means per photo, Spearman correlation and stepwise regression with landscape characteristics measured in each photo, one-way ANOVA by social background.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"What is your gender?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Male\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"age_group\",\n      \"title\": \"How old are you?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Under 20\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"20–29\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"30–39\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"40–49\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"50–59\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"60 or over\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"What is your highest level of education?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Junior high school and below\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"High school / technical secondary school\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Junior college\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Bachelor's degree\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"Master's degree or above\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"income\",\n      \"title\": \"What is your income?\",\n      \"isRequired\": true,\n      \"description\": \"Categories as reported in the paper (RMB); the paper does not state the period.\",\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Under 5,000 RMB\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"5,000–10,000 RMB\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"10,000–30,000 RMB\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Over 30,000 RMB\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"rural\",\n      \"title\": \"Have you ever lived in a rural area?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"No, I have always lived in the city\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Yes, but for less than 2 years\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Yes, for more than 2 years\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"awareness\",\n      \"title\": \"Before taking this survey, were you aware of historical irrigation structures or the World Heritage Irrigation Structures (WHIS)?\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": 1,\n        \"text\": \"Very aware\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"Somewhat aware\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"Heard of but not aware\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"Completely unheard of\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#eef2f1;--card:#fff;--ink:#1a1f1e;--muted:#58625f;--accent:#2b6a6a;--accent-ink:#fff;--line:#d2dbd9;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.4rem;margin:0 0 10px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:18px}.q>b{display:block;margin-bottom:4px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\n.acts{display:grid;grid-template-columns:repeat(3,1fr);gap:0 8px}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem;font-variant-numeric:tabular-nums}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.pic{border-radius:12px;overflow:hidden;background:#ccc}.pic img{display:block;width:100%;height:auto}\n.thumbs{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:10px 0}.thumbs img{width:100%;display:block;border-radius:6px}\n.qq{font-weight:600;margin:16px 0 6px}\n.sc{display:grid;grid-template-columns:repeat(5,1fr);gap:5px}\n.sc button{appearance:none;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:9px;padding:8px 2px;font:inherit;font-size:.8rem;line-height:1.2;cursor:pointer;min-height:54px}\n.sc button b{display:block;font-size:1rem}\n.sc button.on{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:520px){.acts{grid-template-columns:repeat(2,1fr)}.thumbs{grid-template-columns:repeat(2,1fr)}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Zhong, Zhang, Xia, Hao &amp; Tan (2024), Buildings 14(7):1955, doi:10.3390/buildings14071955 (CC BY 4.0). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var AGREE=['Not at all','Barely','Average','Somewhat','Strongly'], LAB={beauty:['Very unbeautiful','Unbeautiful','Average','Beautiful','Very beautiful'],historicity:AGREE,locality:AGREE};\n  var KEY='canals2024:', ACTS=['walking','jogging','biking','swimming','boating','fishing'];\n  var app=document.getElementById('app'), Q={}, M=[], DIMS=[], ans={}, done={}, order=[];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function saveAll(l,b,cb){Promise.all(l.map(function(a){return a[2]?SPSite.answer(a[0],a[1],a[2]):SPSite.answer(a[0],a[1]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}cb();});}\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function stem(n){return n.replace(/\\.[^.]+$/,'');}\n  function byName(n){for(var i=0;i<M.length;i++)if(M[i].name===n)return M[i];}\n  function page(title,html,btn,cb){\n    app.innerHTML='<div class=\"card\">'+(title?'<h1>'+esc(title)+'</h1>':'')+html+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">'+esc(btn||'Continue')+'</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=cb;\n  }\n  function radios(name){return (Q[name].choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+name+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('');}\n  function val(n){var x=app.querySelector('input[name='+n+']:checked');return x?Number(x.value):null;}\n  function next(){\n    window.scrollTo(0,0);\n    if(!ans.intro)return intro();\n    if(!ans.overview)return overview();\n    for(var i=0;i<order.length;i++){if(!done[stem(order[i])])return trial(i);}\n    if(!ans.about)return about();\n    finish();\n  }\n  function intro(){\n    if(!M.length){app.innerHTML='<h1>Pictures missing</h1><p>Media folder canals must hold the 18 photographs.</p>';return;}\n    page('Historical irrigation canals','<p>The Li Canal-Gaoyou Irrigation District in China was listed as a World Heritage Irrigation Structure in 2021. Its historical canals, from main canals to branch and small tertiary canals, still irrigate the surrounding farmland.</p><p>You will see '+M.length+' photographs of these canals. For each one, tell us how you see the scene and which recreational activities would suit it. It takes about 10 minutes. Participation is voluntary and anonymous.</p><label class=\"opt\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label>','Start',function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var b=this;b.disabled=true;saveAll([['consent',true]],b,function(){ans.intro=true;next();});\n    });\n  }\n  function overview(){\n    var th=M.slice().sort(function(a,b){return a.name<b.name?-1:1;}).map(function(f){return '<img alt=\"Canal photograph\" src=\"'+esc(f.url)+'\">';}).join('');\n    page('An overview of all the photographs','<p>Here are all '+M.length+' photographs together. Take a moment to look at them; next, they will be shown one at a time in random order.</p><div class=\"thumbs\">'+th+'</div>','Begin',function(){ans.overview=true;next();});\n  }\n  function trial(i){\n    var f=byName(order[i]), n=0, k=stem(f.name), sel={};order.forEach(function(x){if(done[stem(x)])n++;});\n    var qs=DIMS.map(function(d){var b='';for(var v=d.min;v<=d.max;v++)b+='<button type=\"button\" data-d=\"'+esc(d.id)+'\" data-v=\"'+v+'\"><b>'+v+'</b>'+esc(((d.labels&&d.labels.length)?d.labels:(LAB[d.id]||[]))[v-d.min]||'')+'</button>';\n      return '<div class=\"qq\">'+esc(d.label)+'</div><div class=\"sc\">'+b+'</div>';}).join('');\n    var acts=ACTS.map(function(a,j){return '<label class=\"opt\"><input type=\"checkbox\" name=\"act\" value=\"'+a+'\"> '+esc(a.charAt(0).toUpperCase()+a.slice(1))+'</label>';}).join('');\n    app.innerHTML='<div class=\"top\"><span class=\"t\">Photo '+(n+1)+' of '+order.length+'</span><div class=\"bar\"><i style=\"width:'+(100*n/order.length)+'%\"></i></div></div>'+\n      '<div class=\"pic\"><img alt=\"Photograph of an irrigation canal\" src=\"'+esc(f.url)+'\"></div>'+qs+\n      '<div class=\"qq\">Which of the following recreational activities do you think are suitable to be carried out or developed in this scene? (Multiple choices allowed)</div><div class=\"acts\">'+acts+'</div><label class=\"opt\"><input type=\"checkbox\" name=\"none\" value=\"1\"> No suitable activities</label>'+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div>';\n    app.querySelectorAll('.sc button').forEach(function(x){x.onclick=function(){var d=x.dataset.d;sel[d]=Number(x.dataset.v);\n      app.querySelectorAll('.sc button[data-d=\"'+d+'\"]').forEach(function(y){y.classList.toggle('on',y===x);});err('');};});\n    var none=app.querySelector('input[name=none]');\n    none.onchange=function(){err('');if(none.checked)app.querySelectorAll('input[name=act]').forEach(function(c){c.checked=false;});};\n    app.querySelectorAll('input[name=act]').forEach(function(c){c.onchange=function(){err('');if(c.checked)none.checked=false;};});\n    document.getElementById('go').onclick=function(){\n      for(var j=0;j<DIMS.length;j++)if(sel[DIMS[j].id]==null)return err('Please answer: '+DIMS[j].label);\n      var a={},any=false;ACTS.forEach(function(x){var c=app.querySelector('input[name=act][value='+x+']').checked;a[x]=c?1:0;if(c)any=true;});a.none=none.checked?1:0;\n      if(!any&&!a.none)return err('Please tick the suitable activities, or \"No suitable activities\".');\n      var r={};DIMS.forEach(function(d){r[d.id]=sel[d.id];});\n      var b=this;b.disabled=true;\n      saveAll([['ratings',r,{key:k,shown:[f.name]}],['activities',a,{key:k,shown:[f.name]}]],b,function(){done[k]=true;next();});\n    };\n  }\n  var ABOUT=['gender','age_group','education','income','rural','awareness'];\n  function about(){\n    page('About you',ABOUT.map(function(n){return '<div class=\"q\"><b>'+esc(Q[n].title)+'</b>'+radios(n)+'</div>';}).join(''),'Finish',function(){\n      var l=[];for(var i=0;i<ABOUT.length;i++){var v=val(ABOUT[i]);if(!v)return err('Please answer: '+Q[ABOUT[i]].title);l.push([ABOUT[i],v]);}\n      var b=this;b.disabled=true;saveAll(l,b,function(){ans.about=true;next();});\n    });\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>In the original survey of 465 respondents, canals with large water bodies, artificial banks and artificial vegetation were seen as more beautiful, and larger canals with more water and artificial banks as better suited to recreation. Age, education, income, rural living experience and prior knowledge of historical irrigation structures also shaped the ratings.</p><p style=\"font-size:.82rem\">Photographs and task: Zhong, Y., Zhang, M., Xia, Y., Hao, R., &amp; Tan, L. (2024). Public aesthetic and recreational preferences for historical irrigation canals in rural areas: A case study in Li Canal-Gaoyou Irrigation District. Buildings 14(7):1955, doi:10.3390/buildings14071955. Used with credit and removed if the authors object.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){m.forEach(function(x){\n      if(x==='consent')ans.intro=false;else if(x==='ratings'||x==='activities')done={};else ans.about=false;});next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    ['consent'].concat(ABOUT).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    DIMS=((SPSite.getQuestion('ratings')||{}).dimensions)||[];\n    M=(SPSite.getMedia('canals')||[]).slice();\n    var a=(ctx&&ctx.answers)||{};\n    var names=M.map(function(f){return f.name;});var o=load('order');\n    if(!o||o.length!==names.length||o.some(function(x){return names.indexOf(x)<0;}))o=shuffle(names);order=o;save('order',order);\n    var got={};((a.activities&&a.activities.trials)||[]).forEach(function(t){if(t.key)got[t.key]=true;});\n    ((a.ratings&&a.ratings.trials)||[]).forEach(function(t){if(t.key&&got[t.key])done[t.key]=true;});\n    if(a.consent===true){ans.intro=true;if(Object.keys(done).length)ans.overview=true;}\n    if(a.awareness!=null)ans.about=true;\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
