td.t b{color:var(--warn)}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.f{margin-top:14px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:860px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:560px){table.m td.t span{display:none}table.m th{font-size:.62rem}table.m input{width:16px;height:16px}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: Song, Zhou, Xiao, Zeng, Wu &amp; Song (2023), PLOS ONE, figshare doi:10.6084/m9.figshare.21700970 (CC BY 4.0).</footer>\n<script>\n(function(){\n  var ITEMS=['color_richness','visual_effect','cultural_connotation','vegetation_coverage','overall_coordination'];\n  var app=document.getElementById('app'), Q={}, files=[], st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function shuffle(a){a=a.slice();for(var k=a.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1));var x=a[k];a[k]=a[j];a[j]=x;}return a;}\n  function save(){try{localStorage.setItem('wall2023:state',JSON.stringify(st));}catch(e){}}\n  function byName(n){for(var i=0;i<files.length;i++)if(files[i].name===n)return files[i];return null;}\n  function pid(n){var m=/A0*(\\d+)/i.exec(n);return m?'A'+m[1]:n;}\n  function split(t){var i=t.indexOf(': ');return i<0?[t,'']:[t.slice(0,i),t.slice(i+2)];}\n  function intro(){\n    var radio=function(n){var q=Q[n];return '<div class=\"f\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';};\n    app.innerHTML='<h1>A painted retaining wall in a mountain village</h1>'+\n      '<div class=\"card\"><p style=\"color:var(--ink)\"><b>Background.</b> Heye Village lies in the valley of Jiuzhaigou, Sichuan, China, a Tibetan area. Earthquakes and landslides are common there, so a giant concrete retaining wall was built along the village road to hold the slope. To soften its appearance, the wall was painted with murals of natural scenery (mountains, forests, water) and of local Tibetan folk culture (dances, festivals, daily life), and parts of it were decorated with timber and stone and planted with vegetation.</p>'+\n      '<p>You will see '+st.list.length+' photographs of the wall, taken by a pedestrian walking towards it. For each photograph, rate five aspects from −3 (very poor) to +3 (very good). About 10 minutes.</p></div>'+\n      '<div class=\"card\">'+radio('gender').replace('class=\"f\"','class=\"f\" style=\"margin-top:0\"')+radio('education')+radio('professional')+'</div>'+\n      '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var v={};for(var n of ['gender','education','professional']){var x=app.querySelector('input[name='+n+']:checked');if(!x)return err('Please answer: '+Q[n].title);v[n]=x.value;}\n      var b=this;b.disabled=true;\n      Promise.all([SPSite.answer('consent',true),SPSite.answer('gender',v.gender),SPSite.answer('education',v.education),SPSite.answer('professional',v.professional)]).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}st.step='rate';save();route();});\n    };\n  }\n  function rate(){\n    if(st.i>=st.list.length)return finish();\n    var f=byName(st.list[st.i]);if(!f){st.i++;save();return rate();}\n    var nf=byName(st.list[st.i+1]||'');if(nf){var pre=new Image();pre.src=nf.url;}\n    var heads=[-3,-2,-1,0,1,2,3].map(function(v){return '<th>'+(v>0?'+'+v:v)+'</th>';}).join('');\n    var rows=ITEMS.map(function(n){var p=split(Q[n].title||n);var c='';for(var v=1;v<=7;v++)c+='<td><input type=\"radio\" name=\"'+n+'\" value=\"'+v+'\" aria-label=\"'+esc(p[0]+' '+(v-4))+'\"></td>';return '<tr data-r=\"'+n+'\"><td class=\"t\"><b>'+esc(p[0])+'</b><span>'+esc(p[1])+'</span></td>'+c+'</tr>';}).join('');\n    app.innerHTML='<p>Photograph '+(st.i+1)+' of '+st.list.length+'</p><div class=\"progress\"><i style=\"width:'+(100*st.i/st.list.length)+'%\"></i></div>'+\n      '<div class=\"view\"><img alt=\"Photograph of the painted retaining wall\" src=\"'+esc(f.url)+'\"></div>'+\n      '<div class=\"card\"><table class=\"m\"><tr><th></th>'+heads+'</tr>'+rows+'</table><p style=\"display:flex;justify-content:flex-end;gap:16px;font-size:.78rem;margin:6px 0 0\"><span>−3 very poor · 0 neutral · +3 very good</span></p><div style=\"margin-top:12px\"><button class=\"btn\" id=\"go\">Next</button></div><div class=\"err\"></div></div>';\n    app.querySelectorAll('table.m input').forEach(function(i){i.onchange=function(){var t=i.closest('tr');if(t)t.classList.remove('miss');if(!app.querySelector('tr.miss'))err('');};});\n    document.getElementById('go').onclick=function(){\n      var v={},miss=[];app.querySelectorAll('tr.miss').forEach(function(t){t.classList.remove('miss');});\n      ITEMS.forEach(function(n){var x=app.querySelector('input[name='+n+']:checked');if(!x)miss.push(n);else v[n]=Number(x.value);});\n      if(miss.length){miss.forEach(function(m){var t=app.querySelector('tr[data-r=\"'+m+'\"]');if(t)t.classList.add('miss');});return err('Please rate all five aspects.');}\n      var b=this;b.disabled=true;\n      Promise.all(ITEMS.map(function(n){return SPSite.answer(n,v[n],{key:pid(f.name),shown:[f.name]});})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}st.i++;save();window.scrollTo(0,0);rate();});\n    };\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){var m=r.missing||[];if(m.some(function(x){return ITEMS.indexOf(x)<0;}))st.step='intro';else{st.step='rate';st.i=0;}save();route();},1800);}\n      else{try{localStorage.removeItem('wall2023:state');}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your ratings are saved.';}});\n  }\n  function route(){if(st.step==='rate')return rate();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','gender','education','professional'].concat(ITEMS).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    files=(SPSite.getMedia('walls')||[]).filter(function(f){return /\\.(jpe?g|png|webp)$/i.test(f.name);});\n    if(files.length<1){app.innerHTML='<h1>Photographs missing</h1><p>Upload the photographs to the media folder “walls”.</p>';return;}\n    try{st=JSON.parse(localStorage.getItem('wall2023:state'));}catch(e){st=null;}\n    if(!st||!Array.isArray(st.list)||st.list.some(function(n){return !byName(n);}))st={step:'intro',list:shuffle(files).map(function(f){return f.name;}),i:0};\n    var a=(ctx&&ctx.answers)||{};if(a.consent!==true)st.step='intro';\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
