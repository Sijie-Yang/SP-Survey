lid var(--line)}\n.tr:first-of-type{border-top:0}.tr .l{text-align:right;font-size:.88rem}.tr .r{font-size:.88rem}\n.sc{display:grid;grid-template-columns:repeat(7,1fr);gap:2px}\n.anch{display:flex;justify-content:space-between;font-size:.75rem;color:var(--muted);margin-top:3px}\n.it{padding:9px 0;border-top:1px solid var(--line)}.it:first-of-type{border-top:0}.it p{margin:0 0 6px;color:var(--ink);font-size:.95rem}.it.miss{outline:2px solid var(--warn);outline-offset:2px;border-radius:6px}\n.stick{position:sticky;top:0;z-index:2;background:var(--bg);padding:8px 0}.stick img{width:100%;max-width:520px;max-height:30vh;object-fit:cover;border-radius:10px;display:block}\n.tr .t{display:block;font-size:.72rem;color:var(--muted);grid-column:1/-1;text-align:center}\n.sc label{display:flex;justify-content:center;align-items:center;border:1px solid var(--line);border-radius:8px;padding:8px 0;cursor:pointer;font-weight:600}\n.sc label:has(input:checked){background:var(--sel);border-color:var(--accent)}.sc input{display:none}\n.tr.miss{outline:2px solid var(--warn);outline-offset:2px;border-radius:6px}\n.one{max-width:620px}.one img{width:100%;border-radius:10px;display:block}\n.pair{display:grid;grid-template-columns:1fr 1fr;gap:10px}.pair img{width:100%;border-radius:8px;display:block}.pair .nm{font-weight:600;margin-top:4px;font-size:.92rem}\n.thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.thumbs img{width:100%;border-radius:6px;display:block}.thumbs div{font-size:.8rem;text-align:center}\nselect,textarea,input.txt{font:inherit;padding:9px 11px;border:1px solid var(--line);border-radius:10px;margin-top:6px;width:100%;max-width:380px;background:#fff}\ntextarea{max-width:100%;min-height:70px}\n.prog{height:6px;background:var(--line);border-radius:3px;margin:6px 0 12px}.prog i{display:block;height:100%;background:var(--accent);border-radius:3px}\n.sim{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;margin-top:12px}\n.sim button{font:inherit;border:1px solid var(--line);background:#fff;border-radius:10px;padding:10px 2px;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:.72rem;color:var(--muted)}\n.sim button b{font-size:1rem;color:var(--ink)}.sim button.on{background:var(--sel);border-color:var(--accent)}\n@media (max-width:700px){.tr{grid-template-columns:5.6em 1fr 5.6em}.tr .l,.tr .r{font-size:.78rem}.thumbs{grid-template-columns:repeat(3,1fr)}}\n.o label{display:flex;flex-direction:column;align-items:center;gap:2px;border:1px solid var(--line);border-radius:8px;padding:6px 1px;cursor:pointer;font-size:.68rem;line-height:1.15;text-align:center;color:var(--muted)}\n.o label b{font-size:.95rem;color:var(--ink)}\n.o label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.o input{display:none}\n.b.miss{outline:2px solid var(--warn);outline-offset:2px}\n.blk{margin-top:14px}.blk:first-child{margin-top:0}\n.blk.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.err{color:var(--warn);margin-top:8px;min-height:1.5em;line-height:1.5}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:700px){.grid{grid-template-columns:1fr}}\n@media (max-width:700px){.tr{grid-template-columns:1fr 1fr;row-gap:4px}.tr .t{order:1}.tr .sc{grid-column:1/-1;order:2}.tr .sc label{padding:10px 0}.tr .l{order:3;text-align:left}.tr .r{order:4;text-align:right;justify-self:end}.tr .l{justify-self:start}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs and design: Cao &amp; Huang (2023), Research on the Healing Effect Evaluation of Campus' Small-Scale Courtyard Based on the Method of Semantic Differential and the Perceived Restorative Scale, Sustainability 15(10): 8369, Figure 3 (doi:10.3390/su15108369, CC BY 4.0). Removed on request of the authors.</footer>\n<script>\n(function(){\n  var KEY='cao2023courtyard:state', SD=[[\"plant_coverage\", \"Plant coverage\", \"Barren\", \"Lush\"], [\"plant_colors_species\", \"Plant colors and species\", \"Poor\", \"Abundant\"], [\"landscape_coordination\", \"Landscape coordination\", \"Chaos\", \"Harmonious\"], [\"landscape_attraction\", \"Landscape attraction\", \"Unattractive\", \"Attractive\"], [\"elements_richness\", \"Elements richness\", \"Poor\", \"Abundant\"], [\"impression\", \"Impression\", \"Forgettable\", \"Memorable\"], [\"sense_of_harmony\", \"Sense of harmony\", \"Incompatible\", \"Harmonious\"], [\"sense_of_interaction\", \"Sense of interaction\", \"Isolated\", \"Familiar\"], [\"sense_of_oppression\", \"Sense of oppression\", \"Oppressive\", \"Relaxed\"], [\"interface_material\", \"Interface material richness\", \"Poor\", \"Abundant\"], [\"ground_pavement\", \"Ground pavement feeling\", \"Sudden\", \"Harmonious\"], [\"color_perception\", \"Color perception\", \"Same\", \"Rich\"], [\"color_temperature\", \"Color temperature\", \"Cold\", \"Warm\"], [\"lighting_effect\", \"Lighting effect\", \"Boring\", \"Beautiful\"], [\"light_level\", \"Light level\", \"Dim\", \"Bright\"], [\"resting_facilities\", \"Resting facilities comfort\", \"Uncomfortable\", \"Comfortable\"], [\"activity_space\", \"Activity space richness\", \"Lack\", \"Sufficient\"]], PRS=[[\"A1\", \"This can give me an experience that is out of the world.\"], [\"A2\", \"This place gives me a break from the routine of my daily life.\"], [\"A3\", \"This is a place where I can rest completely.\"], [\"A4\", \"The environment here can help me relax my tense mood.\"], [\"A5\", \"I feel free from work and daily life here.\"], [\"B1\", \"I think the surrounding scenery is harmonious.\"], [\"B2\", \"I am quite curious about the invisible landscape.\"], [\"B3\", \"The landscape here can make me extend many beautiful associations.\"], [\"B4\", \"The elements of the landscape here are matched.\"], [\"C1\", \"The environment here has attractive characteristics.\"], [\"C2\", \"The environment here can attract me to explore and discover more.\"], [\"C3\", \"The environment here is charming.\"], [\"C4\", \"I will want to spend more time in this environment.\"], [\"D1\", \"I can do what I like here.\"], [\"D2\", \"I can adapt to the environment here quickly.\"], [\"D3\", \"I feel that I have integrated with this environment.\"], [\"D4\", \"I can find a way to enjoy myself here.\"], [\"D5\", \"This place is very suitable for doing what I like.\"]], IDS=['courtyard_1','courtyard_2','courtyard_3'], LAB={courtyard_1:'Courtyard I',courtyard_2:'Courtyard II',courtyard_3:'Courtyard III'};\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='';}}\n  function hideErr(){var e=app.querySelector('.err');if(e&&!app.querySelector('.miss'))e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function pic(){var f=files[st.c];return '<div class=\"stick\"><img alt=\"Campus courtyard\" src=\"'+esc(f.url)+'\"></div>';}\n  function intro(){\n    app.innerHTML='<h1>Campus courtyards</h1><p>This survey is about the small courtyards between buildings on a university campus. You will see a photograph of one courtyard. Imagine you are standing there, then describe it with pairs of words and say how much you agree with some statements about it. It takes about 8 minutes.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='look';st.c=IDS[Math.floor(Math.random()*IDS.length)];save();route();});};\n  }\n  function look(){\n    app.innerHTML='<h2>Your courtyard</h2><p>Take a moment to look at this courtyard and imagine being there. The photograph stays at the top of the next pages.</p><div class=\"one\" style=\"max-width:820px\"><img alt=\"Campus courtyard\" src=\"'+esc(files[st.c].url)+'\"></div><div class=\"card\"><button class=\"btn\" id=\"go\">Continue</button><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){st.step='about';save();route();};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+\n      '<div class=\"blk\" data-n=\"age\"><b>'+esc(Q.age.title)+'</b><br><input class=\"txt\" id=\"f_age\" type=\"number\" min=\"10\" max=\"100\" inputmode=\"numeric\"></div>'+\n      '<div class=\"blk\" data-n=\"gender\"><b>'+esc(Q.gender.title)+'</b>'+(Q.gender.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"gender\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>'+\n      '<div class=\"blk\" data-n=\"subject\"><b>'+esc(Q.subject.title)+'</b> <span style=\"color:var(--muted)\">(optional)</span><br><input class=\"txt\" id=\"f_subject\" type=\"text\" maxlength=\"80\"></div>'+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var miss=[],L=[];\n      var a=document.getElementById('f_age').value.trim();if(a===''||isNaN(Number(a))||Number(a)<10||Number(a)>100)miss.push(app.querySelector('.blk[data-n=\"age\"]'));else L.push(SPSite.answer('age',Number(a)));\n      var g=app.querySelector('input[name=gender]:checked');if(!g)miss.push(app.querySelector('.blk[data-n=\"gender\"]'));else L.push(SPSite.answer('gender',g.value));\n      var s=document.getElementById('f_subject').value.trim();if(s)L.push(SPSite.answer('subject',s));\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please answer the marked questions.');}\n      send(L,this,function(){st.step='sd';save();route();});};\n  }\n  function scale(name,k,cur){return '<span class=\"sc\">'+[1,2,3,4,5,6,7].map(function(v){return '<label><input type=\"radio\" name=\"'+name+'_'+k+'\" value=\"'+v+'\"'+(cur===v?' checked':'')+'>'+v+'</label>';}).join('')+'</span>';}\n  function block(name,rows,render,msg,next){\n    var r=(st[name]=st[name]||{});\n    app.innerHTML=pic()+'<h2>'+(name==='sd'?'Describe this courtyard':'Your experience of this courtyard')+'</h2><p>'+esc(Q[name].title)+'</p><div class=\"card\">'+rows.map(function(w){return render(w,r[w[0]]);}).join('')+'<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">'+(next==='done'?'Finish':'Continue')+'</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var miss=[],v={};\n      rows.forEach(function(w){var x=app.querySelector('input[name=\"'+name+'_'+w[0]+'\"]:checked');if(x)v[w[0]]=Number(x.value);else miss.push(app.querySelector('[data-k=\"'+w[0]+'\"]'));});\n      st[name]=v;save();\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err(msg);}\n      send([SPSite.answer(name,v,{key:st.c,shown:[files[st.c].name]})],this,function(){st.step=next;save();route();});};\n  }\n  function sd(){block('sd',SD,function(w,cur){return '<div class=\"tr\" data-k=\"'+w[0]+'\"><span class=\"t\">'+esc(w[1])+'</span><span class=\"l\">'+esc(w[2])+'</span>'+scale('sd',w[0],cur)+'<span class=\"r\">'+esc(w[3])+'</span></div>';},'Please answer every word pair.','prs');}\n  function prs(){block('prs',PRS,function(w,cur){return '<div class=\"it\" data-k=\"'+w[0]+'\"><p>'+esc(w[1])+'</p>'+scale('prs',w[0],cur)+'<div class=\"anch\"><span>Strongly disagree</span><span>Strongly agree</span></div></div>';},'Please answer every statement.','done');}\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var b=e.target.closest&&e.target.closest('.tr,.it,.blk');if(b){b.classList.remove('miss');hideErr();}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='look')return look();if(s==='about')return about();if(s==='sd')return sd();if(s==='prs')return prs();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','subject','sd','prs'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('courtyards')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var need=IDS.filter(function(k){return !files[k];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.jpg) to the media folder \"courtyards\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.step)||a.consent!==true||IDS.indexOf(st.c)<0)st={step:'intro'};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
