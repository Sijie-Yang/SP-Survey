   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>How Does This Street Make You Feel? (Taipei)</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"How Does This Street Make You Feel? (Taipei)\",\n    \"description\": \"Watch one street-view walk through Taipei, imagine you are there, and rate 16 emotions (1–7). Method replication of Ho, Wei, Li & Chiang (2026), Environment and Planning B.\",\n    \"locale\": \"en\",\n    \"mediaFolders\": [\"taipei\"],\n    \"pages\": [\n      { \"name\": \"intro\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. My answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" }\n      ]},\n      { \"name\": \"walk\", \"elements\": [\n        { \"type\": \"custom\", \"name\": \"viewing\", \"title\": \"The street-view walk shown to this participant (video file, area type, seconds watched, whether it was watched to the end)\", \"isRequired\": true }\n      ]},\n      { \"name\": \"emotions\", \"elements\": [\n        { \"type\": \"rating\", \"name\": \"arousal\", \"title\": \"I feel aroused in this environment\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Strongly disagree\", \"maxRateDescription\": \"Strongly agree\" },\n        { \"type\": \"rating\", \"name\": \"astonishment\", \"title\": \"I feel astonished in this environment\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Strongly disagree\", \"maxRateDescription\": \"Strongly agree\" },\n        { \"type\": \"rating\", \"name\": \"happiness\", \"title\": \"I feel happy in this environment\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Strongly disagree\", \"maxRateDescription\": \"Strongly agree\" },\n        { \"type\": \"rating\", \"name\": \"delight\", \"title\": \"I feel delighted in this environment\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Strongly disagree\", \"maxRateDescription\": \"Strongly agree\" },\n        { \"type\": \"rating\", \"name\": \"satisfaction\", \"title\": \"I feel satisfied in this environment\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Strongly disagree\", \"maxRateDescription\": \"Strongly agree\" },\n        { \"type\": \"rating\", \"name\": \"contentment\", \"title\": \"I feel content in this environment\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Strongly disagree\", \"maxRateDescription\": \"Strongly agree\" },\n        { \"type\": \"rating\", \"name\": \"serenity\", \"title\": \"I feel serene in this environment\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Strongly disagree\", \"maxRateDescription\": \"Strongly agree\" },\n        { \"type\": \"rating\", \"name\": \"relaxation\", \"title\": \"I feel relaxed in this environment\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Strongly disagree\", \"maxRateDescription\": \"Strongly agree\" },\n        { \"type\": \"rating\", \"name\": \"frustration\", \"title\": \"I feel frustrated in this environment\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Strongly disagree\", \"maxRateDescription\": \"Strongly agree\" },\n        { \"type\": \"rating\", \"name\": \"fear\", \"title\": \"I feel afraid in this environment\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Strongly disagree\", \"maxRateDescription\": \"Strongly agree\" },\n        { \"type\": \"rating\", \"name\": \"alarm\", \"title\": \"I feel alarmed in this environment\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Strongly disagree\", \"maxRateDescription\": \"Strongly agree\" },\n        { \"type\": \"rating\", \"name\": \"anger\", \"title\": \"I feel angry in this environment\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Strongly disagree\", \"maxRateDescription\": \"Strongly agree\" },\n        { \"type\": \"rating\", \"name\": \"sadness\", \"title\": \"I feel sad in this environment\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Strongly disagree\", \"maxRateDescription\": \"Strongly agree\" },\n        { \"type\": \"rating\", \"name\": \"tiredness\", \"title\": \"I feel tired in this environment\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Strongly disagree\", \"maxRateDescription\": \"Strongly agree\" },\n        { \"type\": \"rating\", \"name\": \"boredom\", \"title\": \"I feel bored in this environment\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Strongly disagree\", \"maxRateDescription\": \"Strongly agree\" },\n        { \"type\": \"rating\", \"name\": \"depression\", \"title\": \"I feel depressed in this environment\", \"isRequired\": true, \"rateMin\": 1, \"rateMax\": 7, \"minRateDescription\": \"Strongly disagree\", \"maxRateDescription\": \"Strongly agree\" }\n      ]},\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"isRequired\": true, \"choices\": [{ \"value\": \"male\", \"text\": \"Male\" }, { \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"other\", \"text\": \"Other / prefer not to say\" }] },\n        { \"type\": \"radiogroup\", \"name\": \"age_group\", \"title\": \"Age\", \"isRequired\": true, \"choices\": [{ \"value\": \"le20\", \"text\": \"20 or younger\" }, { \"value\": \"21-30\", \"text\": \"21–30\" }, { \"value\": \"31-40\", \"text\": \"31–40\" }, { \"value\": \"ge41\", \"text\": \"41 or older\" }] },\n        { \"type\": \"radiogroup\", \"name\": \"education\", \"title\": \"Highest education\", \"isRequired\": true, \"choices\": [{ \"value\": \"high_school\", \"text\": \"High school or below\" }, { \"value\": \"college\", \"text\": \"College / university\" }, { \"value\": \"graduate\", \"text\": \"Graduate school\" }] },\n        { \"type\": \"radiogroup\", \"name\": \"residence\", \"title\": \"Where do you live?\", \"isRequired\": true, \"choices\": [{ \"value\": \"city\", \"text\": \"City\" }, { \"value\": \"suburbs\", \"text\": \"Suburbs\" }, { \"value\": \"rural\", \"text\": \"Rural area\" }] },\n        { \"type\": \"radiogroup\", \"name\": \"taipei_familiarity\", \"title\": \"How familiar are you with Taipei City?\", \"isRequired\": true, \"choices\": [{ \"value\": \"1\", \"text\": \"Quite unfamiliar\" }, { \"value\": \"2\", \"text\": \"Unfamiliar\" }, { \"value\": \"3\", \"text\": \"Average familiarity\" }, { \"value\": \"4\", \"text\": \"Familiar\" }, { \"value\": \"5\", \"text\": \"Quite familiar\" }] }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f4f5f3;--card:#fff;--ink:#1d2122;--muted:#5a6266;--accent:#28606b;--accent-ink:#fff;--line:#dadfdd;--sel:#e3f0f1}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:920px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}p{margin:0 0 10px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:14px}\n.vid{position:relative;background:#000;border-radius:12px;overflow:hidden}\n.vid video{display:block;width:100%;aspect-ratio:16/9;background:#000}\n.bar{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin-top:10px}.bar>i{display:block;height:100%;width:0;background:var(--accent)}\n.hint{font-size:.9rem;color:var(--muted)}\n.items{margin-top:6px}\n.item{padding:12px 0;border-top:1px solid var(--line)}\n.item:first-child{border-top:0}\n.item b{display:block;font-weight:600;margin-bottom:6px}\n.scale{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}\n.scale button{appearance:none;border:1px solid var(--line);background:var(--card);border-radius:9px;padding:9px 0;font:inherit;font-weight:600;cursor:pointer;color:var(--ink)}\n.scale button.on{border-color:var(--accent);background:var(--sel);box-shadow:0 0 0 2px var(--accent) inset}\n.ends{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);margin-top:3px}\n.item.miss b{color:#b3261e}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:14px}.q>b{display:block;margin-bottom:4px}\n.err{color:#b3261e;margin-top:8px;min-height:1.2em}\n.credit{max-width:920px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n@media (max-width:560px){h1{font-size:1.2rem}.scale{gap:4px}.scale button{padding:8px 0;font-size:.92rem}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Street views: Taipei, Google Street View (© Google), joined into walk-through videos. Task and emotion items from Ho, Wei, Li &amp; Chiang, “Revealing emotional responses to urban environmental elements through street view data and deep learning”, Environment and Planning B 53(3), doi:10.1177/23998083251348280.</footer>\n<script>\n(function(){\n  var EMO=['arousal','astonishment','happiness','delight','satisfaction','contentment','serenity','relaxation','frustration','fear','alarm','anger','sadness','tiredness','boredom','depression'];\n  var DEMO=['gender','age_group','education','residence','taipei_familiarity'];\n  var app=document.getElementById('app'),video=null,view=null,ans={};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function chk(r){if(r&&r.ok===false)throw new Error(r.error||'Not saved');return r;}\n  function areaOf(name){var m=/^([a-z]+)_\\d+/i.exec(name||'');return m?m[1].toLowerCase():'';}\n  function saveView(){return SPSite.answer('viewing',view).then(chk);}\n  function intro(){\n    var c=SPSite.getQuestion('consent');\n    app.innerHTML='<h1>How does this street make you feel?</h1><p>You will watch one short street-view walk through Taipei, Taiwan. Imagine that you are walking there yourself. Then you say how much you agree with 16 short statements about how you would feel, from 1 (strongly disagree) to 7 (strongly agree), and answer five questions about yourself. It takes about 5 minutes.</p>'+\n      '<div class=\"card\"><p>'+esc(c.title)+'</p><div class=\"row\"><button class=\"btn\" id=\"yes\">'+esc(c.labelTrue||'I agree')+'</button></div><div class=\"err\"></div></div>';\n    document.getElementById('yes').onclick=function(){SPSite.answer('consent',true).then(chk).then(walk).catch(function(e){err(e.message);});};\n  }\n  function walk(){\n    var watched=view.watched||0,ended=!!view.ended;\n    app.innerHTML='<h1>Walk along this street</h1><p>Watch the whole video, full screen if you can. Imagine you are walking along this street in Taipei.</p>'+\n      '<div class=\"vid\"><video id=\"v\" src=\"'+esc(video.url)+'\" playsinline controls preload=\"auto\"></video></div>'+\n      '<div class=\"bar\" aria-hidden=\"true\"><i id=\"pb\"></i></div>'+\n      '<div class=\"row\"><button class=\"btn ghost\" id=\"fs\">Full screen</button><span class=\"hint\" id=\"st\">Press play to start.</span></div>'+\n      '<div class=\"row\"><button class=\"btn\" id=\"next\"'+(ended?'':' disabled')+'>Continue</button></div><div class=\"err\"></div>';\n    var v=document.getElementById('v'),pb=document.getElementById('pb'),st=document.getElementById('st'),nx=document.getElementById('next'),last=0;\n    function mark(){var d=v.duration||0;if(!d)return;var t=v.currentTime;if(t>watched&&t-last<1.5)watched=t;last=t;pb.style.width=Math.min(100,100*watched/d)+'%';}\n    v.addEventListener('timeupdate',function(){mark();if(!ended)st.textContent='Keep watching to the end.';});\n    v.addEventListener('seeking',function(){if(v.currentTime>watched+1){v.currentTime=watched;}});\n    v.addEventListener('ended',function(){ended=true;watched=v.duration||watched;pb.style.width='100%';nx.disabled=false;st.textContent='Done. You can watch again or continue.';\n      if(document.fullscreenElement&&document.exitFullscreen)document.exitFullscreen().catch(function(){});\n      view.watched=Math.round(watched*10)/10;view.duration=Math.round((v.duration||0)*10)/10;view.ended=true;saveView().catch(function(e){err(e.message);});});\n    v.addEventListener('error',function(){st.textContent='The video could not be loaded. Please reload the page.';});\n    document.getElementById('fs').onclick=function(){var el=v;var f=el.requestFullscreen||el.webkitRequestFullscreen||el.webkitEnterFullscreen;if(f){try{var r=f.call(el);if(r&&r.catch)r.catch(function(){});}catch(e){}}v.play&&v.play().catch(function(){});};\n    nx.onclick=function(){if(!ended)return err('Please watch the video to the end first.');emotions();};\n    window.scrollTo(0,0);\n  }\n  function emotions(){\n    var h='<h1>How would you feel there?</h1><p>Imagine you are on the street you just saw. How much do you agree with each statement? 1 = strongly disagree, 7 = strongly agree.</p><div class=\"card\"><div class=\"items\">';\n    EMO.forEach(function(n){var q=SPSite.getQuestion(n);h+='<div class=\"item\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b><div class=\"scale\">';\n      for(var s=1;s<=7;s++)h+='<button type=\"button\" data-n=\"'+n+'\" data-v=\"'+s+'\"'+(ans[n]===s?' class=\"on\"':'')+' aria-label=\"'+s+'\">'+s+'</button>';\n      h+='</div><div class=\"ends\"><span>Strongly disagree</span><span>Strongly agree</span></div></div>';});\n    app.innerHTML=h+'</div><div class=\"row\"><button class=\"btn ghost\" id=\"back\">Watch again</button><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    app.querySelectorAll('.scale button').forEach(function(b){b.onclick=function(){var n=b.getAttribute('data-n'),s=Number(b.getAttribute('data-v'));\n      b.parentNode.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b);});b.closest('.item').classList.remove('miss');err('');\n      SPSite.answer(n,s,{key:video.name,shown:[video.name]}).then(chk).then(function(){ans[n]=s;}).catch(function(e){err(e.message);});};});\n    document.getElementById('back').onclick=walk;\n    document.getElementById('go').onclick=function(){\n      var miss=EMO.filter(function(n){return !app.querySelector('.item[data-n=\"'+n+'\"] button.on');});\n      app.querySelectorAll('.item').forEach(function(it){it.classList.toggle('miss',miss.indexOf(it.getAttribute('data-n'))>=0);});\n      if(miss.length)return err('Please answer every statement ('+miss.length+' left).');\n      about();};\n    window.scrollTo(0,0);\n  }\n  function about(){\n    app.innerHTML='<h1>About you</h1><div class=\"card\">'+DEMO.map(function(n){var q=SPSite.getQuestion(n);\n      return '<div class=\"q\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"'+(ans[n]===c.value?' checked':'')+'> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+\n      '<div class=\"row\"><button class=\"btn ghost\" id=\"back\">Back</button><button class=\"btn\" id=\"fin\">Submit</button></div><div class=\"err\"></div></div>';\n    DEMO.forEach(function(n){app.querySelectorAll('input[name=\"'+n+'\"]').forEach(function(r){r.onchange=function(){err('');SPSite.answer(n,r.value).then(chk).then(function(){ans[n]=r.value;}).catch(function(e){err(e.message);});};});});\n    document.getElementById('back').onclick=emotions;\n    document.getElementById('fin').onclick=function(){\n      if(DEMO.some(function(n){return !app.querySelector('input[name=\"'+n+'\"]:checked');}))return err('Please answer each question.');\n      var btn=this;btn.disabled=true;err('Submitting…');\n      SPSite.complete().then(function(r){if(r&&r.ok===false){btn.disabled=false;var m=r.missing||[];err(r.error||('Please answer: '+m.join(', ')));\n        if(m.indexOf('consent')>=0)intro();else if(m.indexOf('viewing')>=0)walk();else if(EMO.some(function(n){return m.indexOf(n)>=0;}))emotions();}});};\n    window.scrollTo(0,0);\n  }\n  SPSite.onReady(function(ctx){\n    var media=(SPSite.getMedia('taipei')||[]).filter(function(m){return /\\.(mp4|webm|mov)$/i.test(m.name||'')||m.type==='video';});\n    if(!media.length){app.innerHTML='<h1>No videos yet</h1><p>The researcher has not added street-view walk videos to the folder “taipei”.</p>';return;}\n    var a=(ctx&&ctx.answers)||{};\n    var prev=a.viewing&&a.viewing.video;\n    video=media.filter(function(m){return m.name===prev;})[0];\n    if(video){view=a.viewing;}\n    else{video=media[Math.floor(Math.random()*media.length)];view={video:video.name,area:areaOf(video.name),watched:0,ended:false};saveView().catch(function(){});}\n    EMO.forEach(function(n){var v=a[n],t=v&&Array.isArray(v.trials)?v.trials:[];t.forEach(function(x){if(x&&x.key===video.name&&x.value!=null)ans[n]=Number(x.value);});});\n    DEMO.forEach(function(n){if(a[n]!=null)ans[n]=String(a[n]);});\n    if(a.consent!==true)intro();\n    else if(!view.ended)walk();\n    else if(EMO.some(function(n){return ans[n]==null;}))emotions();\n    else about();\n  });\n})();\n</script>\n</body>\n</html>\n",
