   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Which rectangle pleases most? (Fechner 1876)</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\"format\":\"sp-scheme-package\",\"spScheme\":\"2.0\",\"survey\":{\"title\":\"Which rectangle pleases most? (Fechner 1876)\",\"description\":\"Fechner's 1876 golden-section experiment: ten rectangles of equal area, from a square (1:1) to 2:5, scattered at random angles; choose the most pleasing and the least pleasing one.\",\"locale\":\"en\",\"pages\":[\n{\"name\":\"intro\",\"elements\":[{\"type\":\"boolean\",\"name\":\"consent\",\"title\":\"I agree to take part. My answers are recorded anonymously for research.\",\"isRequired\":true}]},\n{\"name\":\"choose\",\"elements\":[\n{\"type\":\"radiogroup\",\"name\":\"most_pleasing\",\"title\":\"Which rectangle makes the most pleasing impression?\",\"isRequired\":true,\"description\":\"Value = side ratio of the chosen rectangle (short:long). 21:34 is the golden-section rectangle, 1:1 the square. The ten rectangles have equal area and are shown in random order and at random angles; the layout is stored with the answer (shown).\",\"choices\":[{\"value\":\"1:1\",\"text\":\"1:1 (square)\"},{\"value\":\"5:6\",\"text\":\"5:6\"},{\"value\":\"4:5\",\"text\":\"4:5\"},{\"value\":\"3:4\",\"text\":\"3:4\"},{\"value\":\"20:29\",\"text\":\"20:29\"},{\"value\":\"2:3\",\"text\":\"2:3\"},{\"value\":\"21:34\",\"text\":\"21:34 (golden section)\"},{\"value\":\"13:23\",\"text\":\"13:23\"},{\"value\":\"1:2\",\"text\":\"1:2\"},{\"value\":\"2:5\",\"text\":\"2:5\"}]},\n{\"type\":\"radiogroup\",\"name\":\"least_pleasing\",\"title\":\"Which rectangle makes the least pleasing impression?\",\"isRequired\":true,\"description\":\"Value = side ratio (short:long), as above.\",\"choices\":[{\"value\":\"1:1\",\"text\":\"1:1 (square)\"},{\"value\":\"5:6\",\"text\":\"5:6\"},{\"value\":\"4:5\",\"text\":\"4:5\"},{\"value\":\"3:4\",\"text\":\"3:4\"},{\"value\":\"20:29\",\"text\":\"20:29\"},{\"value\":\"2:3\",\"text\":\"2:3\"},{\"value\":\"21:34\",\"text\":\"21:34 (golden section)\"},{\"value\":\"13:23\",\"text\":\"13:23\"},{\"value\":\"1:2\",\"text\":\"1:2\"},{\"value\":\"2:5\",\"text\":\"2:5\"}]}]},\n{\"name\":\"about\",\"elements\":[\n{\"type\":\"radiogroup\",\"name\":\"gender\",\"title\":\"Your gender\",\"isRequired\":true,\"choices\":[{\"value\":\"female\",\"text\":\"Female\"},{\"value\":\"male\",\"text\":\"Male\"},{\"value\":\"other\",\"text\":\"Other / prefer not to say\"}]},\n{\"type\":\"radiogroup\",\"name\":\"age\",\"title\":\"Your age\",\"isRequired\":true,\"choices\":[{\"value\":1,\"text\":\"16–24\"},{\"value\":2,\"text\":\"25–39\"},{\"value\":3,\"text\":\"40–59\"},{\"value\":4,\"text\":\"60 or older\"}]},\n{\"type\":\"radiogroup\",\"name\":\"art_training\",\"title\":\"Have you had training in art, design or architecture?\",\"isRequired\":true,\"choices\":[{\"value\":\"yes\",\"text\":\"Yes\"},{\"value\":\"no\",\"text\":\"No\"}]}]}]}}\n</script>\n<style>\n:root{--bg:#f4f1ea;--card:#fff;--ink:#1f1d1a;--muted:#5f5a52;--accent:#8a5a1f;--accent-ink:#fff;--line:#ddd6c8;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:900px;margin:0 auto;padding:20px 16px 40px}h1{font-size:1.3rem;margin:0 0 8px}p{margin:0 0 10px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}.btn:disabled{opacity:.4;cursor:not-allowed}\n.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}\n.board{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;background:#141414;border-radius:12px;padding:10px}\n.cell{position:relative;aspect-ratio:1;border:2px solid transparent;border-radius:8px;background:transparent;cursor:pointer;padding:0;display:flex;align-items:center;justify-content:center}\n.cell:hover,.cell:focus-visible{border-color:#777}.cell.on{border-color:#f2b33d;background:rgba(242,179,61,.12)}.cell.off{opacity:.35;cursor:not-allowed}\n.cell svg{width:100%;height:100%}\n.cell .tag{position:absolute;left:4px;top:3px;color:#aaa;font-size:.72rem}\nlabel.o{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.q{margin-top:14px}.q>b{display:block;margin-bottom:4px}.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:900px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:560px){.board{grid-template-columns:repeat(3,1fr)}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Method: Fechner, G. T. (1876). <i>Vorschule der Aesthetik</i>, Part 1, Chapter XIV, pp. 193–196 (Leipzig: Breitkopf &amp; Härtel). Public domain. Rectangles redrawn from the ratios and equal area given there.</footer>\n<script>\n(function(){\n  var R=[[1,1],[5,6],[4,5],[3,4],[20,29],[2,3],[21,34],[13,23],[1,2],[2,5]];\n  var app=document.getElementById('app'),A={},layout=null,step=0,pick={};\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function has(n){return A[n]!=null&&A[n]!=='';}\n  function makeLayout(){var a=R.map(function(r){return {v:r[0]+':'+r[1],s:r[0],l:r[1],ang:Math.round(Math.random()*180)};});\n    for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}\n  function rectSvg(o){var area=0.16,ratio=o.s/o.l,w=Math.sqrt(area/ratio),h=w*ratio; /* equal area in a unit box, long side w */\n    return '<svg viewBox=\"-0.5 -0.5 1 1\" aria-hidden=\"true\"><rect x=\"'+(-w/2)+'\" y=\"'+(-h/2)+'\" width=\"'+w+'\" height=\"'+h+'\" fill=\"#fff\" transform=\"rotate('+o.ang+')\"/></svg>';}\n  function next(){window.scrollTo(0,0);\n    if(A.consent!==true)return intro();\n    if(!has('most_pleasing'))return board('most_pleasing','Which rectangle makes the <b>most pleasing</b> impression?');\n    if(!has('least_pleasing'))return board('least_pleasing','Which rectangle makes the <b>least pleasing</b> impression?');\n    if(!has('gender')||!has('age')||!has('art_training'))return about();\n    finish();}\n  function intro(){\n    app.innerHTML='<h1>Which rectangle pleases you most?</h1><p>You will see ten white rectangles of the same area on a black board, lying at different angles. Their sides have different proportions, from a square to a long strip.</p><p>Try not to think of any particular use (a door, a picture frame, a card). Simply choose the one whose shape gives the most pleasing impression, and then the least pleasing one. It takes about 2 minutes.</p><div class=\"card\"><p>'+esc(SPSite.getQuestion('consent').title)+'</p><div class=\"row\"><button class=\"btn\" id=\"yes\">I agree</button></div><div class=\"err\"></div></div>';\n    document.getElementById('yes').onclick=function(){var b=this;b.disabled=true;SPSite.answer('consent',true).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}A.consent=true;next();});};}\n  function board(name,label){\n    if(!layout)layout=makeLayout();\n    var other=name==='least_pleasing'?A.most_pleasing:null;\n    var h='<div class=\"card\"><h1>'+label+'</h1><p>Tap one rectangle'+(other?' (the one you chose as most pleasing is greyed out)':'')+', then press Continue.</p><div class=\"board\">';\n    layout.forEach(function(o,k){h+='<button type=\"button\" class=\"cell'+(pick[name]===o.v?' on':'')+(o.v===other?' off':'')+'\" data-v=\"'+o.v+'\" aria-label=\"Rectangle '+(k+1)+'\"'+(o.v===other?' disabled':'')+'><span class=\"tag\">'+(k+1)+'</span>'+rectSvg(o)+'</button>';});\n    h+='</div><div class=\"row\"><button class=\"btn\" id=\"go\"'+(pick[name]?'':' disabled')+'>Continue</button></div><div class=\"err\"></div></div>';\n    app.innerHTML=h;\n    app.querySelectorAll('.cell:not(.off)').forEach(function(b){b.onclick=function(){pick[name]=b.getAttribute('data-v');board(name,label);};});\n    document.getElementById('go').onclick=function(){if(!pick[name])return err('Please tap one rectangle.');var b=this;b.disabled=true;\n      SPSite.answer(name,pick[name],{shown:layout.map(function(o){return o.v+'@'+o.ang;})}).then(function(r){if(!ok(r)){b.disabled=false;return err(r.error);}A[name]=pick[name];next();});};}\n  function about(){var names=['gender','age','art_training'],h='<h1>About you</h1><div class=\"card\">';\n    names.forEach(function(n){var q=SPSite.getQuestion(n);h+='<div class=\"q\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"o\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';});\n    app.innerHTML=h+'<div class=\"row\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var v={};for(var k=0;k<names.length;k++){var x=app.querySelector('input[name=\"'+names[k]+'\"]:checked');if(!x)return err('Please answer: '+SPSite.getQuestion(names[k]).title);v[names[k]]=names[k]==='age'?Number(x.value):x.value;}\n      var b=this;b.disabled=true;Promise.all(names.map(function(n){return SPSite.answer(n,v[n]);})).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}names.forEach(function(n){A[n]=v[n];});next();});};}\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>Fechner showed the same ten rectangles, cut from white card and scattered on a black board, to 347 people over several years. The golden-section rectangle (21:34) was chosen as most pleasing most often (about 35% of choices), followed by 2:3 and 13:23; the long 2:5 strip and the square were rejected most often.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');return;}var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';});}\n  SPSite.onReady(function(ctx){A=(ctx&&ctx.answers)||{};next();});\n})();\n</script>\n</body>\n</html>\n",
