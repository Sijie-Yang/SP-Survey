imary school\"\n       },\n       {\n        \"value\": \"high_school\",\n        \"text\": \"High school\"\n       },\n       {\n        \"value\": \"university\",\n        \"text\": \"University\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other\"\n       }\n      ]\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"housing\",\n      \"title\": \"Housing\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"detached_owner\",\n        \"text\": \"I own a detached house\"\n       },\n       {\n        \"value\": \"apartment_owner\",\n        \"text\": \"I own an apartment in an apartment building\"\n       },\n       {\n        \"value\": \"apartment_tenant\",\n        \"text\": \"I rent an apartment in an apartment building\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"facade-original\">{\"source\": \"Karjalainen, Ilgın, Metsäranta & Norvasuo (2021) IJERPH 18(23): 12316\", \"n\": 243, \"names\": {\"1\": \"initial situation\", \"2\": \"style with minimal solution\", \"3\": \"modern look\", \"4\": \"inspiration from suburban architecture\", \"5\": \"implementation of the gable roof\", \"6\": \"wood in main parts\"}, \"grades\": {\"image1\": 5.44, \"proposals_mean\": 7.65, \"popularity\": [\"image5\", \"image2\", \"image3\", \"image4\", \"image6\"]}}</script>\n<style>\n:root{--bg:#f3f1ec;--card:#fff;--ink:#22201b;--muted:#635e54;--accent:#8a5a22;--line:#ddd7cc;--warn:#b3261e;--sel:#f3e6d3}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.prog{font-size:.88rem;color:var(--muted);margin-bottom:8px}\n.qt{font-weight:600;margin:0 0 6px;color:var(--ink)}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.q.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:8px}\n.st{padding:10px 0;border-top:1px solid var(--line)}\n.st .l{margin-bottom:6px}\n.st .o{display:grid;grid-template-columns:repeat(6,1fr);gap:3px}\n.st label{display:flex;flex-direction:column;align-items:center;text-align:center;border:1px solid var(--line);border-radius:6px;padding:4px 2px;cursor:pointer;font-size:.72rem;color:var(--muted);line-height:1.2}\n.st label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.st.miss .o{outline:2px solid var(--warn);outline-offset:2px;border-radius:6px}\n.pic img{width:100%;height:auto;max-height:58vh;object-fit:contain;display:block;border-radius:10px;background:#ddd}\n.grades{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-top:8px}\n.grades label{display:flex;flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:8px;padding:6px 0;cursor:pointer;font-weight:600}\n.grades label:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.ends{display:flex;justify-content:space-between;gap:16px;font-size:.78rem;color:var(--muted);margin-top:4px}\n.ends span:last-child{text-align:right}\ntextarea{width:100%;font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;min-height:64px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:520px){.st .o{grid-template-columns:repeat(3,1fr)}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Pictures and questions: Karjalainen, Ilgın, Metsäranta &amp; Norvasuo (2021), IJERPH 18(23): 12316, Figure 2 and Figures 3-5 (doi:10.3390/ijerph182312316, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='wooden-facade:state', IDS=['image1','image2','image3','image4','image5','image6'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function val(name){var x=app.querySelector('input[name=\"'+name+'\"]:checked');return x?x.value:null;}\n  function radios(q){return '<div class=\"q\" data-q=\"'+esc(q.name)+'\"><p class=\"qt\">'+esc(q.title)+'</p>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+esc(q.name)+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}\n  function need(names){var first=null;names.forEach(function(n){if(val(n)==null){var el=app.querySelector('[data-q=\"'+n+'\"]');el.classList.add('miss');if(!first)first=el;}});return first;}\n  function attitudes(){\n    var S=Q.statements;\n    app.innerHTML='<h1>Wooden facade renovation</h1><p>Many suburban apartment buildings from the 1970s are now due for renovation. One option is to renew the facade with wood and to build one or two additional wooden floors on top; the new apartments can help pay for the renovation. We would like to know what you think about this. Later you will see six pictures of one building. It takes about 8 minutes.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label></div>'+\n     '<div class=\"card\">'+radios(Q.facade_attitude)+'</div><div class=\"card\">'+radios(Q.floor_attitude)+'</div><div class=\"card\">'+radios(Q.attractiveness)+'</div>'+\n     '<div class=\"card\"><p class=\"qt\">'+esc(S.title)+'</p>'+(S.rows||[]).map(function(r){var nm='statements__'+r.value;return '<div class=\"st\" data-q=\"'+nm+'\"><div class=\"l\">'+esc(r.text)+'</div><div class=\"o\">'+(S.columns||[]).map(function(c){return '<label><input type=\"radio\" name=\"'+nm+'\" value=\"'+esc(c.value)+'\">'+esc(c.text)+'</label>';}).join('')+'</div></div>';}).join('')+\n     '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Continue</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var rows=(S.rows||[]).map(function(r){return 'statements__'+r.value;});\n      var first=need(['facade_attitude','floor_attitude','attractiveness'].concat(rows));\n      if(first){first.scrollIntoView({block:'center'});return err('Please answer every question (the missing ones are marked).');}\n      var sv={};(S.rows||[]).forEach(function(r){sv[r.value]=val('statements__'+r.value);});\n      send([SPSite.answer('consent',true),SPSite.answer('facade_attitude',val('facade_attitude')),SPSite.answer('floor_attitude',val('floor_attitude')),SPSite.answer('attractiveness',val('attractiveness')),SPSite.answer('statements',sv)],this,function(){st.step='pic';st.k=0;save();route();});};\n  }\n  function pic(){\n    if(st.k>=IDS.length){st.step='about';save();return route();}\n    var id=IDS[st.k],f=files[id],g=Q.grade;\n    app.innerHTML='<div class=\"prog\">Picture '+(st.k+1)+' of 6</div>'+(st.k===0?'<p>This is a typical suburban apartment building from the 1970s before renovation.</p>':st.k===1?'<p>The next five pictures show ideas for renovating the same building with a wooden facade and additional wooden floors.</p>':'')+\n     '<div class=\"pic\"><img alt=\"Apartment building, picture '+(st.k+1)+'\" src=\"'+esc(f.url)+'\"></div>'+\n     '<div class=\"card\"><div class=\"q\" data-q=\"grade\"><p class=\"qt\">'+esc(g.title)+'</p><div class=\"grades\">'+[4,5,6,7,8,9,10].map(function(v){return '<label><input type=\"radio\" name=\"grade\" value=\"'+v+'\">'+v+'</label>';}).join('')+'</div>'+\n     '<div class=\"ends\"><span>'+esc(g.minRateDescription)+'</span><span>'+esc(g.maxRateDescription)+'</span></div></div>'+\n     '<div style=\"margin-top:14px\"><p class=\"qt\">'+esc(Q.reason.title)+'</p><textarea id=\"why\"></textarea></div>'+\n     '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">'+(st.k<5?'Next picture':'Continue')+'</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var v=val('grade');if(v==null){app.querySelector('[data-q=\"grade\"]').classList.add('miss');return err('Please choose a grade.');}\n      var why=document.getElementById('why').value.trim(),meta={key:id,shown:[f.name]},L=[SPSite.answer('grade',Number(v),meta)];\n      if(why)L.push(SPSite.answer('reason',why,meta));\n      send(L,this,function(){st.k++;save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+radios(Q.gender)+'</div><div class=\"card\">'+radios(Q.age_group)+'</div><div class=\"card\">'+radios(Q.education)+'</div><div class=\"card\">'+radios(Q.housing)+\n     '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var N=['gender','age_group','education','housing'],first=need(N);\n      if(first){first.scrollIntoView({block:'center'});return err('Please answer every question.');}\n      send(N.map(function(n){return SPSite.answer(n,val(n));}),this,function(){st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st={step:'intro'};save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('change',function(e){var r=e.target.closest&&e.target.closest('.miss');if(r){r.classList.remove('miss');if(!app.querySelector('.miss'))err('');}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='pic')return pic();if(s==='about')return about();if(s==='done')return finish();attitudes();}\n  SPSite.onReady(function(ctx){\n    ['consent','facade_attitude','floor_attitude','attractiveness','statements','grade','reason','gender','age_group','education','housing'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};Q[n].name=Q[n].name||n;});\n    (SPSite.getMedia('facades')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var miss=IDS.filter(function(k){return !files[k];});\n    if(miss.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(miss.join(', '))+' (.jpg) to the media folder \"facades\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!st||a.consent!==true)st={step:'intro'};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
