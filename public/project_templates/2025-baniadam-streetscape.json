   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Streetscape Vegetation Choice with Restorative Reasons</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Streetscape Vegetation Choice with Restorative Reasons\",\n    \"description\": \"In each of 10 tasks, flip between two or three versions of the same street scene that differ in one design feature (fence height, fence material, greenery on the fence, or vegetation type), choose the one you prefer, and say why using four statements based on Attention Restoration Theory. Rebuilt from Baniadam, Requena-Ruiz, Normand, Siret & Mars (2025), PLOS ONE.\",\n    \"locale\": \"en\",\n    \"mediaFolders\": [\"fences\", \"vegetation\"],\n    \"pages\": [\n      { \"name\": \"start\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" },\n        { \"type\": \"number\", \"name\": \"age\", \"title\": \"Age (years)\", \"min\": 16, \"max\": 110 },\n        { \"type\": \"radiogroup\", \"name\": \"gender\", \"title\": \"Gender\", \"choices\": [\n          { \"value\": \"female\", \"text\": \"Female\" }, { \"value\": \"male\", \"text\": \"Male\" }, { \"value\": \"undisclosed\", \"text\": \"Prefer not to say\" } ] }\n      ]},\n      { \"name\": \"tasks\", \"elements\": [\n        { \"type\": \"imagepicker\", \"name\": \"choice\", \"title\": \"Choose the option you prefer\", \"description\": \"One record per task: key = task id (task09 … task16 fences, task17 / task24 vegetation, numbered as in the paper's Table 2); value = the chosen file; shown = all options of the task.\", \"imageCount\": 2, \"isRequired\": true },\n        { \"type\": \"custom\", \"name\": \"reasons\", \"title\": \"Recorded by the page, keyed by task id: the reasons ticked after each choice, any of fascination ('more interesting or fascinating'), coherence ('more orderly or more coherent'), being_away ('more effective to get away from daily routine'), compatibility ('more suited to my personality'), plus views (how many times the participant switched between options before confirming).\", \"isRequired\": true }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f2f5f1;--card:#fff;--ink:#18231c;--muted:#56645b;--accent:#2e6a45;--accent-ink:#fff;--line:#d3ddd5;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:24px 16px 40px}\nh1{font-size:1.45rem;margin:0 0 8px}h2{font-size:1.1rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn.ghost{background:var(--card);color:var(--accent);border:1px solid var(--accent)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:8px 0 14px}.progress>i{display:block;height:100%;background:var(--accent)}\n.stage{position:relative;background:#1e2620;border-radius:12px;overflow:hidden;min-height:220px;display:flex;align-items:center;justify-content:center}\n.stage img{width:100%;height:auto;display:block;max-height:62vh;object-fit:contain;margin:0 auto}\n.badge{position:absolute;left:12px;top:12px;background:rgba(0,0,0,.65);color:#fff;border-radius:999px;padding:4px 12px;font-weight:700;font-size:.9rem}\n.bar{display:flex;gap:8px;align-items:center;justify-content:space-between;margin-top:12px;flex-wrap:wrap}\n.dots{display:flex;gap:6px}.dots button{appearance:none;border:1px solid var(--line);background:var(--card);border-radius:9px;padding:8px 14px;font:inherit;font-weight:700;cursor:pointer;color:var(--ink)}\n.dots button.on{background:var(--ink);color:#fff;border-color:var(--ink)}\n.reasons{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}\n@media (max-width:560px){.reasons{grid-template-columns:1fr}}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:10px 12px;border:1px solid var(--line);border-radius:10px;cursor:pointer;background:var(--card)}\nlabel.opt input{width:18px;height:18px}\ninput[type=number]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:120px}\n.q{margin-top:16px}.q>b{display:block;margin-bottom:4px}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.thumb{width:100%;max-width:360px;border-radius:10px;display:block;margin:6px 0 4px}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Scenes: Baniadam, Requena-Ruiz, Normand, Siret &amp; Mars (2025), PLOS ONE 20(9): e0332493, Figs 2–3 (virtual environments of Nantes streets), Creative Commons Attribution License (CC BY 4.0).</footer>\n<script>\n(function(){\n  var app=document.getElementById('app'), Q={}, files={}, st=null, keyH=null;\n  var REASONS=[['fascination','…more interesting or fascinating.'],['coherence','…more orderly or more coherent.'],['being_away','…more effective to get away from daily routine.'],['compatibility','…more suited to my personality.']];\n  // Tasks 9–16 (fences) and 17 / 24 (vegetation type) of the paper's Table 2: the tasks whose options are all printed in the paper.\n  var TASKS=[\n    {id:'task09',folder:'fences',factor:'Fence height',opts:['high_metal','short_metal']},\n    {id:'task10',folder:'fences',factor:'Fence height',opts:['high_wood','short_wood']},\n    {id:'task11',folder:'fences',factor:'Fence material',opts:['high_metal','high_wood']},\n    {id:'task12',folder:'fences',factor:'Fence material',opts:['short_metal','short_wood']},\n    {id:'task13',folder:'fences',factor:'Greenery on the fence',opts:['high_metal','high_metal_green']},\n    {id:'task14',folder:'fences',factor:'Greenery on the fence',opts:['short_metal','short_metal_green']},\n    {id:'task15',folder:'fences',factor:'Greenery on the fence',opts:['high_wood','high_wood_green']},\n    {id:'task16',folder:'fences',factor:'Greenery on the fence',opts:['short_wood','short_wood_green']},\n    {id:'task17',folder:'vegetation',factor:'Vegetation type (regular arrangement, low diversity)',opts:['regular_low_trees','regular_low_bushes','regular_low_grass']},\n    {id:'task24',folder:'vegetation',factor:'Vegetation combination (random arrangement, high diversity)',opts:['random_high_trees_bushes','random_high_bushes_grass','random_high_trees_grass']}\n  ];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function shuffle(a){a=a.slice();for(var k=a.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1));var x=a[k];a[k]=a[j];a[j]=x;}return a;}\n  function save(){try{localStorage.setItem('vrveg2025:state',JSON.stringify(st));}catch(e){}}\n  function ok(r){return !(r&&r.ok===false);}\n  function offKeys(){if(keyH){document.removeEventListener('keydown',keyH);keyH=null;}}\n  function file(t,o){return o+'.jpg';}\n\n  function intro(){\n    var missing=[];TASKS.forEach(function(t){t.opts.forEach(function(o){if(!files[t.folder+'/'+file(t,o)])missing.push(t.folder+'/'+file(t,o));});});\n    if(missing.length){app.innerHTML='<h1>Images missing</h1><p>Missing: '+esc(missing.join(', '))+'</p>';return;}\n    app.innerHTML='<h1>Which street design do you prefer?</h1><p>You will see '+TASKS.length+' street scenes. In each, two or three versions differ in only one thing, such as the fence or the plants. Flip between the versions as often as you like, choose the one you prefer, and then tick why you chose it. About 5 minutes.</p><p><b>Imagine:</b> the place is part of the route you walk every day, and it is not where you live.</p>'+\n      '<div class=\"card\"><div class=\"q\"><b>'+esc(Q.age.title)+'</b><input type=\"number\" id=\"age\" min=\"16\" max=\"110\"></div><div class=\"q\"><b>'+esc(Q.gender.title)+'</b>'+\n      (Q.gender.choices||[]).map(function(c){return '<label class=\"opt\" style=\"margin-top:6px\"><input type=\"radio\" name=\"gender\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div></div>'+\n      '<div class=\"card\"><label class=\"opt\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      var age=document.getElementById('age').value.trim();if(age&&(Number(age)<16||Number(age)>110))return err('Please enter an age between 16 and 110, or leave it empty.');\n      var b=this;b.disabled=true;var calls=[SPSite.answer('consent',true)];if(age)calls.push(SPSite.answer('age',Number(age)));\n      var g=app.querySelector('input[name=gender]:checked');if(g)calls.push(SPSite.answer('gender',g.value));\n      Promise.all(calls).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){b.disabled=false;return err(bad.error);}st.consented=true;save();next();});\n    };\n  }\n\n  function next(){\n    offKeys();\n    var id=st.tasks.filter(function(x){return !st.reasons[x];})[0];\n    if(!id)return done();\n    choose(TASKS.findIndex(function(t){return t.id===id;}));\n  }\n\n  function choose(k){\n    var t=TASKS[k], order=st.order[t.id], cur=0, seen={0:true}, views=1, n=Object.keys(st.reasons).length;\n    function draw(){\n      var f=files[t.folder+'/'+file(t,order[cur])];\n      app.innerHTML='<p>Task '+(n+1)+' of '+TASKS.length+'</p><div class=\"progress\"><i style=\"width:'+(100*n/TASKS.length)+'%\"></i></div>'+\n        '<div class=\"stage\"><img src=\"'+esc(f.url)+'\" alt=\"Street scene, option '+(cur+1)+'\"><span class=\"badge\">Option '+(cur+1)+' of '+order.length+'</span></div>'+\n        '<div class=\"bar\"><div class=\"dots\">'+order.map(function(o,i){return '<button data-i=\"'+i+'\" class=\"'+(i===cur?'on':'')+'\">'+(i+1)+'</button>';}).join('')+'</div>'+\n        '<button class=\"btn ghost\" id=\"nx\">Next option →</button></div>'+\n        '<div class=\"card\"><p style=\"margin:0 0 10px\">Look at every option, then choose the one you prefer. Keys: ← → switch, Enter chooses.</p><button class=\"btn\" id=\"pick\">I prefer option '+(cur+1)+'</button><div class=\"err\"></div></div>';\n      app.querySelectorAll('.dots button').forEach(function(b){b.onclick=function(){go(Number(b.getAttribute('data-i')));};});\n      document.getElementById('nx').onclick=function(){go((cur+1)%order.length);};\n      document.getElementById('pick').onclick=pick;\n    }\n    order.forEach(function(o){var im=new Image();im.src=files[t.folder+'/'+file(t,o)].url;}); // preload so flipping is instant\n    function go(i){if(i===cur)return;cur=i;seen[i]=true;views++;draw();}\n    function pick(){\n      if(Object.keys(seen).length<order.length)return err('Please look at all '+order.length+' options first.');\n      offKeys();reasons(k,order[cur],views);\n    }\n    offKeys();keyH=function(e){if(e.key==='ArrowRight')go((cur+1)%order.length);else if(e.key==='ArrowLeft')go((cur+order.length-1)%order.length);else if(e.key==='Enter')pick();};document.addEventListener('keydown',keyH);\n    draw();\n  }\n\n  function reasons(k,chosen,views){\n    var t=TASKS[k], f=files[t.folder+'/'+file(t,chosen)];\n    app.innerHTML='<p>Task '+(Object.keys(st.reasons).length+1)+' of '+TASKS.length+'</p><div class=\"card\"><h2>I chose this option because it is…</h2><img class=\"thumb\" src=\"'+esc(f.url)+'\" alt=\"Your choice\"><p>You can tick more than one reason.</p><div class=\"reasons\">'+\n      REASONS.map(function(r){return '<label class=\"opt\"><input type=\"checkbox\" value=\"'+r[0]+'\"> '+esc(r[1])+'</label>';}).join('')+\n      '</div><div class=\"bar\"><button class=\"btn ghost\" id=\"back\">← Change my choice</button><button class=\"btn\" id=\"ok2\">Confirm</button></div><div class=\"err\"></div></div>';\n    document.getElementById('back').onclick=function(){choose(k);};\n    document.getElementById('ok2').onclick=function(){\n      var picked=[].slice.call(app.querySelectorAll('.reasons input:checked')).map(function(i){return i.value;});\n      if(!picked.length)return err('Please tick at least one reason.');\n      var b=this;b.disabled=true;\n      var next_reasons=JSON.parse(JSON.stringify(st.reasons));next_reasons[t.id]={reasons:picked,views:views};\n      SPSite.answer('choice',file(t,chosen),{key:t.id,shown:st.order[t.id].map(function(o){return file(t,o);})}).then(function(r){\n        if(!ok(r)){b.disabled=false;return err(r.error);}\n        return SPSite.answer('reasons',next_reasons).then(function(r2){if(!ok(r2)){b.disabled=false;return err(r2.error);}st.reasons=next_reasons;save();next();});\n      });\n    };\n  }\n\n  function done(){\n    offKeys();\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"st\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){\n      if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){if(m.indexOf('consent')>=0){st.consented=false;save();intro();}else{st.reasons={};save();next();}},1800);}\n      else{try{localStorage.removeItem('vrveg2025:state');}catch(e){}var s=document.getElementById('st');if(s)s.textContent='Your choices are saved.';}\n    });\n  }\n\n  SPSite.onReady(function(ctx){\n    ['consent','age','gender','choice','reasons'].forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    ['fences','vegetation'].forEach(function(d){(SPSite.getMedia(d)||[]).forEach(function(f){files[d+'/'+f.name]=f;});});\n    try{st=JSON.parse(localStorage.getItem('vrveg2025:state'));}catch(e){st=null;}\n    if(!st||!st.order||!st.reasons||!Array.isArray(st.tasks)||st.tasks.length!==TASKS.length){st={consented:false,reasons:{},order:{},tasks:shuffle(TASKS.map(function(t){return t.id;}))};}\n    TASKS.forEach(function(t){var o=st.order[t.id];if(!o||o.length!==t.opts.length||o.some(function(x){return t.opts.indexOf(x)<0;}))st.order[t.id]=shuffle(t.opts);}); // option order randomised per task and participant\n    var a=(ctx&&ctx.answers)||{};\n    st.reasons=(a.reasons&&typeof a.reasons==='object')?a.reasons:{}; // the platform's saved answers are the source of truth\n    st.consented=a.consent===true;\n    save();\n    if(st.consented)next();else intro();\n  });\n})();\n</script>\n</body>\n</html>\n",
