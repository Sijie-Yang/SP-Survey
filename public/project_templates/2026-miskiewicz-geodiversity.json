aper (natural sciences n = 210, humanities n = 98).\"\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<style>\n:root{--bg:#eef1ee;--card:#fff;--ink:#1d2320;--muted:#56605a;--accent:#2d6457;--line:#d0dad5;--warn:#b3261e}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:820px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.3rem;margin:0 0 10px}\np{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn.sec{background:transparent;color:var(--accent);border:1px solid var(--line);padding:8px 14px;font-size:.9rem}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.q{margin-top:22px}.q:first-child{margin-top:0}.q>b{display:block;margin-bottom:6px}\n.q.miss>b{color:var(--warn)}\n.hint{font-size:.85rem;color:var(--muted);margin:-2px 0 6px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}\ntextarea,input[type=text]{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;width:100%}\ntextarea{min-height:84px;resize:vertical}\n.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.t{color:var(--muted);font-size:.9rem}\n.bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;flex:1;margin-left:12px;max-width:260px}.bar>i{display:block;height:100%;background:var(--accent)}\n.it{padding:10px 0;border-top:1px solid var(--line)}.it:first-of-type{border-top:0}.it.miss>div:first-child{color:var(--warn)}\n.it>div:first-child{margin-bottom:6px}\n.seg{display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:3px;max-width:480px}\n.seg label{display:block;cursor:pointer;position:relative}\n.seg input{position:absolute;opacity:0;pointer-events:none}\n.seg span{display:flex;align-items:center;justify-content:center;text-align:center;min-height:40px;padding:2px 4px;border:1px solid var(--line);border-radius:8px;font-size:.85rem}\n.seg input:checked+span{background:var(--accent);border-color:var(--accent);color:#fff}\n.seg input:focus-visible+span{outline:2px solid var(--accent);outline-offset:2px}\n.imgs{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px}\n.imgs img,.tile img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:8px;display:block}\n.cap{font-size:.9rem;margin:6px 0}\n.rank{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-top:10px}\n.tile{position:relative;border:2px solid var(--line);border-radius:10px;overflow:hidden;cursor:pointer;background:#fff;padding:0;font:inherit;text-align:center}\n.tile img{border-radius:0}.tile small{display:block;padding:4px 3px;font-size:.76rem;line-height:1.25}\n.tile.on{border-color:var(--accent)}\n.tile .n{position:absolute;top:6px;left:6px;min-width:30px;height:30px;border-radius:15px;background:var(--accent);color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:820px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n@media (max-width:600px){.rank{grid-template-columns:repeat(2,minmax(0,1fr))}}\n.pair{display:grid;grid-template-columns:1fr 1fr;gap:10px;max-width:640px}\n.pick{display:block;cursor:pointer;border:2px solid var(--line);border-radius:10px;overflow:hidden;background:#fff;position:relative}\n.pick input{position:absolute;opacity:0;pointer-events:none}\n.pick img{display:block;width:100%;aspect-ratio:3/4;object-fit:cover}\n.pick span{display:block;text-align:center;padding:6px;font-weight:600}\n.pick:has(input:checked){border-color:var(--accent);box-shadow:0 0 0 2px var(--accent)}\n.pick:has(input:checked) span{background:var(--accent);color:#fff}\n.pick:has(input:focus-visible){outline:2px solid var(--accent);outline-offset:2px}\n.stim{display:block;max-width:100%;max-height:min(460px,60svh);border-radius:8px;margin:4px 0 10px}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Photographs: the 12 questionnaire photographs of the Gościbia Forest Nature Reserve (Polish Carpathians) in Supplement S1 of Miśkiewicz, Waśkowska &amp; Stadnik (2026), Sustainability 18:11403, doi:10.3390/su182111403 (CC BY 4.0). Used with credit for research; removed if the authors object.</footer>\n<script>\n(function(){\n  var KEY='gosc2026:';\n  var app=document.getElementById('app'), Q={}, files={}, done={}, A={}, PAGES=[];\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e){e.textContent=m||'';e.style.visibility='visible';}}\n  function hideErr(){var e=app.querySelector('.err');if(e)e.style.visibility='hidden';}\n  function ok(r){return !(r&&r.ok===false);}\n  function load(k){try{return JSON.parse(localStorage.getItem(KEY+k));}catch(e){return null;}}\n  function save(k,v){try{localStorage.setItem(KEY+k,JSON.stringify(v));}catch(e){}}\n  function vis(e){var c=e.visibleIf;if(!c)return true;var v=A[c.q];if(c.eq!=null)return v===c.eq;if(c.in)return c.in.indexOf(v)>=0;if(c.has)return Array.isArray(v)&&v.indexOf(c.has)>=0;return true;}\n  function pageVis(p){return p.elements.some(vis);}\n  function next(){window.scrollTo(0,0);for(var i=0;i<PAGES.length;i++){var p=PAGES[i];if(!done[p.name]&&pageVis(p))return render(p,i);}finish();}\n  function seg(name,cols){return '<div class=\"seg\" style=\"--n:'+cols.length+'\" role=\"radiogroup\">'+cols.map(function(c){return '<label><input type=\"radio\" name=\"'+esc(name)+'\" value=\"'+esc(c.value)+'\"><span>'+esc(c.text)+'</span></label>';}).join('')+'</div>';}\n  function el(e,i){\n    var h='<div class=\"q\" data-q=\"'+e.name+'\"><b>'+esc(e.title)+(e.isRequired?'':' <span class=\"t\">(optional)</span>')+'</b>'+(e.hint?'<div class=\"hint\">'+esc(e.hint)+'</div>':'')+(e.image?'<img class=\"stim\" alt=\"Photograph of the valley\" src=\"'+esc(files[e.image].url)+'\">':'');\n    if(e.kind==='image_choice')h+='<div class=\"pair\" role=\"radiogroup\">'+e.options.map(function(o,k){return '<label class=\"pick\"><input type=\"radio\" name=\"'+e.name+'\" value=\"'+(k+1)+'\"><img alt=\"'+esc(o.text)+'\" src=\"'+esc(files[o.file].url)+'\"><span>'+esc(o.text)+'</span></label>';}).join('')+'</div>';\n    if(e.type==='boolean')h+='<label class=\"opt\"><input type=\"checkbox\" name=\"'+e.name+'\" value=\"1\"> '+esc(e.label||'Yes')+'</label>';\n    else if(e.type==='radiogroup')h+=e.choices.map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+e.name+'\" value=\"'+c.value+'\"> '+esc(c.text)+'</label>';}).join('');\n    else if(e.type==='checkbox')h+=e.choices.map(function(c){return '<label class=\"opt\"><input type=\"checkbox\" name=\"'+e.name+'\" value=\"'+c.value+'\"> '+esc(c.text)+'</label>';}).join('');\n    else if(e.type==='comment')h+='<textarea name=\"'+e.name+'\" maxlength=\"2000\"></textarea>';\n    else if(e.type==='text')h+='<input type=\"text\" name=\"'+e.name+'\" maxlength=\"200\">';\n    else if(e.kind==='matrix')h+=e.items.map(function(it){return '<div class=\"it\" data-n=\"'+it.name+'\"><div>'+esc(it.text)+'</div>'+seg(e.name+'__'+it.name,e.scale)+'</div>';}).join('');\n    else if(e.kind==='image_rating')h+='<div class=\"imgs\">'+e.items.map(function(it){return '<div class=\"it\" data-n=\"'+it.name+'\" style=\"border:0;padding:0\"><img alt=\"'+esc(it.text)+'\" src=\"'+esc(files[it.file].url)+'\"><div class=\"cap\">'+esc(it.text)+'</div>'+seg(e.name+'__'+it.name,e.scale)+'</div>';}).join('')+'</div>';\n    else if(e.kind==='image_rank')h+='<div class=\"rank\"></div><p class=\"status\" style=\"margin-top:10px;color:var(--ink)\"></p><button type=\"button\" class=\"btn sec rreset\">Start over</button>';\n    return h+'</div>';\n  }\n  function render(p,i){\n    var els=p.elements.filter(vis),order={};\n    app.innerHTML='<div class=\"top\"><span class=\"t\">Page '+(i+1)+' of '+PAGES.length+'</span><div class=\"bar\"><i style=\"width:'+(100*i/PAGES.length)+'%\"></i></div></div>'+(p.title?'<h1>'+esc(p.title)+'</h1>':'')+'<div class=\"card\">'+(p.intro?'<p style=\"color:var(--ink)\">'+esc(p.intro)+'</p>':'')+els.map(el).join('')+'</div><div style=\"margin-top:18px\"><button class=\"btn\" id=\"go\">'+(i===PAGES.length-1?'Finish':'Next')+'</button></div><div class=\"err\"></div>';\n    app.onchange=function(ev){hideErr();var it=ev.target.closest('.it');if(it)it.classList.remove('miss');var qq=ev.target.closest('.q');if(qq)qq.classList.remove('miss');var e2=Q[qq&&qq.getAttribute('data-q')];if(e2&&e2.reflow){A[e2.name]=readOne(e2,true);var keep=collect();render(p,i);restore(keep);}};\n    els.forEach(function(e){if(e.kind==='image_rank'){order[e.name]=[];drawRank(e,order);}});\n    restore(load('draft_'+p.name));\n    document.getElementById('go').onclick=function(){\n      var l=[],bad=null;\n      for(var k=0;k<els.length;k++){var e=els[k],v=e.kind==='image_rank'?rankVal(e,order):readOne(e);\n        if(v===undefined){if(e.isRequired){bad=bad||e;var qq=app.querySelector('.q[data-q=\"'+e.name+'\"]');qq.classList.add('miss');}continue;}\n        l.push([e.name,v]);}\n      if(bad){err((bad.kind==='image_choice'?'Please choose Option 1 or Option 2.':bad.kind?'Please rate every element.':'Please answer: '+bad.title));var m=app.querySelector('.q.miss');if(m)m.scrollIntoView({block:'center'});return;}\n      var b=this;b.disabled=true;\n      Promise.all(l.map(function(a){A[a[0]]=a[1];return SPSite.answer(a[0],a[1]);})).then(function(rs){var x=rs.filter(function(r){return !ok(r);})[0];if(x){b.disabled=false;return err(x.error);}done[p.name]=true;save('d',done);next();});\n    };\n  }\n  function collect(){var o={};[].forEach.call(app.querySelectorAll('input,textarea'),function(x){if(x.type==='radio'||x.type==='checkbox'){if(x.checked)(o[x.name]=o[x.name]||[]).push(x.value);}else o[x.name]=x.value;});return o;}\n  function restore(o){if(!o)return;[].forEach.call(app.querySelectorAll('input,textarea'),function(x){var v=o[x.name];if(v==null)return;if(x.type==='radio'||x.type==='checkbox')x.checked=v.indexOf(x.value)>=0;else x.value=v;});}\n  function readOne(e,soft){\n    if(e.type==='boolean'){return app.querySelector('input[name=\"'+e.name+'\"]').checked?true:undefined;}\n    if(e.type==='radiogroup'||e.kind==='image_choice'){var x=app.querySelector('input[name=\"'+e.name+'\"]:checked');return x?Number(x.value):undefined;}\n    if(e.type==='checkbox'){var xs=[].map.call(app.querySelectorAll('input[name=\"'+e.name+'\"]:checked'),function(x){return Number(x.value);});return xs.length?xs:undefined;}\n    if(e.type==='comment'||e.type==='text'){var t=app.querySelector('[name=\"'+e.name+'\"]').value.trim();return t?t:undefined;}\n    if(e.kind==='matrix'||e.kind==='image_rating'){var v={},miss=0;e.items.forEach(function(it){var x=app.querySelector('input[name=\"'+e.name+'__'+it.name+'\"]:checked');if(x)v[it.name]=Number(x.value);else if(!it.optional){miss++;var d=app.querySelector('.q[data-q=\"'+e.name+'\"] .it[data-n=\"'+it.name+'\"]');if(d&&!soft)d.classList.add('miss');}});return miss?undefined:v;}\n  }\n  function rankVal(e,order){var o=order[e.name];if(o.length<e.items.length)return undefined;var v={};o.forEach(function(n,i){v[n]=i+1;});return v;}\n  function drawRank(e,order){\n    var box=app.querySelector('.q[data-q=\"'+e.name+'\"]'),g=box.querySelector('.rank'),o=order[e.name];\n    g.innerHTML=e.items.map(function(it){var p=o.indexOf(it.name);return '<button type=\"button\" class=\"tile'+(p>=0?' on':'')+'\" data-v=\"'+it.name+'\"><img alt=\"'+esc(it.text)+'\" src=\"'+esc(files[it.file].url)+'\">'+(p>=0?'<span class=\"n\">'+(p+1)+'</span>':'')+'<small>'+esc(it.text)+'</small></button>';}).join('');\n    box.querySelector('.status').textContent=o.length?('Your order: '+o.map(function(n){return e.items.filter(function(it){return it.name===n;})[0].text;}).join(' > ')):'Tap your most preferred lawn type first (1), then the next, down to the least preferred (5). Tap a numbered photo to undo it.';\n    [].forEach.call(g.querySelectorAll('.tile'),function(t){t.onclick=function(){var v=t.getAttribute('data-v'),p=o.indexOf(v);if(p>=0)o.splice(p,1);else o.push(v);hideErr();box.classList.remove('miss');drawRank(e,order);};});\n    box.querySelector('.rreset').onclick=function(){o.length=0;drawRank(e,order);};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p>In the original online survey (308 respondents in Poland), Option 2 in each pair showed the valley with higher geodiversity. Most people chose it in pairs 1, 2 and 4 (over 90% in pair 2), but in pair 3 most preferred Option 1, suggesting that people judge natural value also by beauty and the overall view. Naturalness of the surroundings, the atmosphere of the place and visual aesthetics were rated most interesting; among the landscape elements, waterfalls and streams scored highest and vegetation lowest. People with humanities interests responded more to aesthetic and emotional qualities.</p><p style=\"font-size:.82rem\">Miśkiewicz, K., Waśkowska, A., &amp; Stadnik, R. (2026). Perception of Geodiversity as a Factor Shaping the Value of Environmental Services and Sustainability: A Case Study of the Gościbia Forest Nature Reserve in the Carpathians (Poland). Sustainability 18:11403, doi:10.3390/su182111403.</p><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');var m=r.missing||[];setTimeout(function(){PAGES.forEach(function(p){if(p.elements.some(function(e){return m.indexOf(e.name)>=0;}))done[p.name]=false;});save('d',done);next();},1800);}\n      else{var s=document.getElementById('fin');if(s)s.textContent='Your answers have been saved. You can close this window now.';}});\n  }\n  SPSite.onReady(function(ctx){\n    var S;try{S=JSON.parse(document.getElementById('sp-scheme').textContent).survey;}catch(e){S={pages:[]};}\n    PAGES=S.pages;PAGES.forEach(function(p){p.elements.forEach(function(e){var g=SPSite.getQuestion(e.name)||{};if(g.title)e.title=g.title;Q[e.name]=e;});});\n    (SPSite.getMedia('valleys')||[]).forEach(function(f){files[f.name]=f;});\n    if(Object.keys(files).length<12){app.innerHTML='<h1>Photographs missing</h1><p>Media folder valleys must hold the 12 questionnaire photographs.</p>';return;}\n    A=(ctx&&ctx.answers)||{};done=load('d')||{};\n    PAGES.forEach(function(p){done[p.name]=p.elements.filter(function(e){return e.isRequired&&vis(e);}).every(function(e){return A[e.name]!=null;})&&p.elements.some(function(e){return A[e.name]!=null;});});\n    next();\n  });\n})();\n</script>\n</body>\n</html>\n",
