   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Valleys of the Gościbia Reserve</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Geodiversity and Natural Value: Valleys of the Gościbia Reserve\",\n  \"description\": \"Faithful replication of Miśkiewicz, Waśkowska & Stadnik (2026), Sustainability 18:11403: four pairs of photographs of stream valleys in the Gościbia Forest Nature Reserve (choose the one with greater natural value), then four valley photographs where respondents rate how interesting landscape elements are (1–5), and their main area of interest.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"valleys\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"intro\",\n    \"title\": \"Perception of nature\",\n    \"intro\": \"Dear Respondent, we kindly ask you to complete a short questionnaire concerning the perception of nature. Participation in the survey is anonymous, and completing it will take only a few minutes. Your responses will support further efforts aimed at nature conservation. The study uses photographs from the Las Gościbia Nature Reserve, a forest reserve located in the Carpathians.\",\n    \"elements\": [\n     {\n      \"type\": \"boolean\",\n      \"name\": \"consent\",\n      \"title\": \"Consent\",\n      \"label\": \"I agree to take part in this survey.\",\n      \"isRequired\": true\n     }\n    ]\n   },\n   {\n    \"name\": \"pairs\",\n    \"elements\": [\n     {\n      \"type\": \"custom\",\n      \"kind\": \"image_choice\",\n      \"name\": \"q1_natural_value\",\n      \"isRequired\": true,\n      \"title\": \"1. Which valley do you consider to have greater natural value?\",\n      \"options\": [\n       {\n        \"text\": \"Option 1\",\n        \"file\": \"q1_option1.jpg\"\n       },\n       {\n        \"text\": \"Option 2\",\n        \"file\": \"q1_option2.jpg\"\n       }\n      ],\n      \"description\": \"Value 1 = Option 1 (lower geodiversity in the expert assessment), 2 = Option 2 (higher geodiversity).\"\n     },\n     {\n      \"type\": \"custom\",\n      \"kind\": \"image_choice\",\n      \"name\": \"q2_natural_value\",\n      \"isRequired\": true,\n      \"title\": \"2. Which valley do you consider to have greater natural value?\",\n      \"options\": [\n       {\n        \"text\": \"Option 1\",\n        \"file\": \"q2_option1.jpg\"\n       },\n       {\n        \"text\": \"Option 2\",\n        \"file\": \"q2_option2.jpg\"\n       }\n      ],\n      \"description\": \"Value 1 = Option 1 (lower geodiversity in the expert assessment), 2 = Option 2 (higher geodiversity).\"\n     },\n     {\n      \"type\": \"custom\",\n      \"kind\": \"image_choice\",\n      \"name\": \"q3_natural_value\",\n      \"isRequired\": true,\n      \"title\": \"3. Which valley do you consider to have greater natural value?\",\n      \"options\": [\n       {\n        \"text\": \"Option 1\",\n        \"file\": \"q3_option1.jpg\"\n       },\n       {\n        \"text\": \"Option 2\",\n        \"file\": \"q3_option2.jpg\"\n       }\n      ],\n      \"description\": \"Value 1 = Option 1 (lower geodiversity in the expert assessment), 2 = Option 2 (higher geodiversity).\"\n     },\n     {\n      \"type\": \"custom\",\n      \"kind\": \"image_choice\",\n      \"name\": \"q4_natural_value\",\n      \"isRequired\": true,\n      \"title\": \"4. Which valley do you consider to have greater natural value?\",\n      \"options\": [\n       {\n        \"text\": \"Option 1\",\n        \"file\": \"q4_option1.jpg\"\n       },\n       {\n        \"text\": \"Option 2\",\n        \"file\": \"q4_option2.jpg\"\n       }\n      ],\n      \"description\": \"Value 1 = Option 1 (lower geodiversity in the expert assessment), 2 = Option 2 (higher geodiversity).\"\n     }\n    ]\n   },\n   {\n    \"name\": \"site5\",\