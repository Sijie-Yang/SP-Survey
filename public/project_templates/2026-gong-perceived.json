  "spSite": {
   "id": "site-ec94d1bffe9a856d",
   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Which Street Is More Comfortable to Walk? (Macau)</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n  \"format\": \"sp-scheme-package\",\n  \"spScheme\": \"2.0\",\n  \"survey\": {\n    \"title\": \"Which Street Is More Comfortable to Walk? (Macau)\",\n    \"description\": \"Pairs of panoramic street views from Macau: decide which one is more comfortable for walking overall, or choose Same level. A guideline lists the eight comfort dimensions to weigh together. Method replication of Gong et al. (2026, Buildings).\",\n    \"locale\": \"en\",\n    \"pages\": [\n      { \"name\": \"intro\", \"elements\": [\n        { \"type\": \"consent\", \"name\": \"consent\", \"title\": \"I agree to take part. My answers are recorded anonymously for research.\", \"isRequired\": true, \"labelTrue\": \"I agree\", \"labelFalse\": \"I do not agree\" }\n      ]},\n      { \"name\": \"comparisons\", \"elements\": [\n        { \"type\": \"imagepicker\", \"name\": \"more_comfortable\", \"title\": \"Which street appears more comfortable for walking?\",\n          \"description\": \"Judge the overall walking-environment comfort, weighing all eight dimensions together rather than any single feature. Choose Same level if both are equally comfortable.\",\n          \"imageCount\": 2, \"trialCount\": 20, \"allowTie\": true, \"tieLabel\": \"Same level\", \"imageFit\": \"contain\", \"isRequired\": true, \"choices\": [],\n          \"imageSelectionMode\": \"huggingface_random\", \"randomImageSelection\": true, \"excludePreviouslyUsedImages\": true, \"mediaFolders\": [\"streets\"] }\n      ]},\n      { \"name\": \"about_you\", \"elements\": [\n        { \"type\": \"radiogroup\", \"name\": \"macau_familiarity\", \"title\": \"How well do you know Macau?\", \"choices\": [\n          { \"value\": \"resident\", \"text\": \"I live or work there\" }, { \"value\": \"visited\", \"text\": \"I have visited\" }, { \"value\": \"never\", \"text\": \"I have never been there\" } ] }\n      ]}\n    ]\n  }\n}\n</script>\n<style>\n:root{--bg:#f6f5f2;--card:#fff;--ink:#1f2224;--muted:#5c6268;--accent:#8a4b1f;--accent-ink:#fff;--line:#dedbd6}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1180px;margin:0 auto;padding:20px 16px 40px}\nh1{font-size:1.4rem;margin:0 0 6px}p{margin:0 0 10px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:18px;margin-top:14px}\ntable{border-collapse:collapse;width:100%;font-size:.88rem}th,td{text-align:left;vertical-align:top;padding:6px 8px;border-top:1px solid var(--line)}th{color:var(--muted);font-weight:600}\n.btn{appearance:none;border:0;border-radius:10px;padding:12px 18px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink)}\n.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent)}\n.btn:disabled{opacity:.45;cursor:not-allowed}\n.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:6px 0 12px}.progress>i{display:block;height:100%;background:var(--accent)}\n.pair{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n.pair figure{margin:0}.pair img{width:100%;aspect-ratio:2048/664;object-fit:cover;display:block;border-radius:8px;background:#000}\n.pair figcaption{text-align:center;margin-top:4px;font-weight:600}\n.choices{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;margin-top:14px}\n.choices .btn{width:100%}\ndetails{margin-top:12px}summary{cursor:pointer;color:var(--accent)}\n.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\n.err{color:#b3261e;margin-top:8px;min-height:1.2em}\n.credit{max-width:1180px;margin:0 auto;padding:0 16px 24px;font-size:.8rem;color:var(--muted)}\n@media (max-width:820px){.pair{grid-template-columns:1fr}.choices{grid-template-columns:1fr}h1{font-size:1.2rem}table{font-size:.8rem}}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Street images: Macau, Google Street View panoramas captured December 2008 (© Google). Task and guideline from Gong et al. (2026), Buildings 16(6):1103, Table 1.</footer>\n<script>\n(function(){\n  var app=document.getElementById('app'),Q,i=0,done={};\n  var DIMS=[['Shade and solar relief','Relief from direct sunlight, reducing thermal discomfort.','Tree canopy, facade shading, shadow patterns on sidewalks.'],\n    ['Spatial generosity','Perception of spaciousness, reducing crowding and constraint.','Sidewalk width, absence of obstacles, pedestrian flow.'],\n    ['Greenery and visual amenity','Influence of nature and greenery on psychological restoration and aesthetic pleasure.','Continuity of vegetation, multi-layer planting, visible green spaces.'],\n    ['Spatial openness and visual field','Perceived openness of space, enhancing relaxation and reducing claustrophobia.','Sky visibility, long sightlines, openness of facades.'],\n    ['Noise and traffic disturbance','Impact of vehicle noise and traffic on comfort and stress.','Traffic volume, vehicle proximity, presence of barriers.'],\n    ['Cleanliness and maintenance','Cleanliness, orderliness, and maintenance of streets enhancing comfort.','Clean pavements, absence of litter, well-maintained surfaces.'],\n    ['Facility convenience','Availability of supportive infrastructure enhancing comfort.','Seating, shading devices, rest areas, public signage.'],\n    ['Walking continuity and smoothness','Uninterrupted, smooth pedestrian pathways promoting comfort.','Continuous sidewalks, absence of barriers, smooth pavement.']];\n  var GUIDE='<table><thead><tr><th>Dimension</th><th>Description</th><th>Observable cues</th></tr></thead><tbody>'+DIMS.map(function(d){return '<tr><td><b>'+d[0]+'</b></td><td>'+d[1]+'</td><td>'+d[2]+'</td></tr>';}).join('')+'</tbody></table>';\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function trial(k){var t=Q.trials&&Q.trials[k];var ch=(t&&t.choices)||Q.choices||[],md=(t&&t.media)||Q.media||[];\n    return {im:ch.filter(function(c){return !c.tie;}).map(function(c,j){return {value:c.value,url:c.imageUrl||(md[j]&&md[j].url)||''};}),tie:ch.filter(function(c){return c.tie;})[0]};}\n  function firstOpen(){for(var k=0;k<Q.trialCount;k++){if(!done[k])return k;}return Q.trialCount;}\n  function intro(){\n    var c=SPSite.getQuestion('consent');\n    app.innerHTML='<h1>Which street is more comfortable to walk?</h1>'+\n      '<p>You will see '+Q.trialCount+' pairs of 360° street panoramas from Macau. For each pair, decide which street appears more comfortable for walking, or choose “Same level” if both are equally comfortable. Judge the overall walking-environment comfort: weigh the eight dimensions below together, not any single feature. It takes about 5 minutes.</p>'+\n      '<div class=\"card\"><h2 style=\"font-size:1rem;margin:0 0 8px\">Rating guideline</h2>'+GUIDE+'</div>'+\n      '<div class=\"card\"><p>'+esc(c.title)+'</p><div class=\"row\"><button class=\"btn\" id=\"yes\">'+esc(c.labelTrue||'I agree')+'</button></div><div class=\"err\"></div></div>';\n    document.getElementById('yes').onclick=function(){SPSite.answer('consent',true).then(function(r){if(r&&r.ok===false)return err(r.error);i=firstOpen();show();});};\n  }\n  function show(){\n    if(i>=Q.trialCount)return about();\n    var t=trial(i);\n    app.innerHTML='<h1>'+esc(Q.title)+'</h1><p>Pair '+(i+1)+' of '+Q.trialCount+' · overall walking comfort, all dimensions together</p><div class=\"progress\" aria-hidden=\"true\"><i style=\"width:'+(100*i/Q.trialCount)+'%\"></i></div>'+\n      '<div class=\"pair\">'+t.im.map(function(m,j){return '<figure><img src=\"'+esc(m.url)+'\" alt=\"Panoramic street view, Image '+(j?'B':'A')+'\"><figcaption>Image '+(j?'B':'A')+'</figcaption></figure>';}).join('')+'</div>'+\n      '<div class=\"choices\"><button class=\"btn\" data-v=\"'+esc(t.im[0].value)+'\">Image A is more comfortable</button>'+\n      (t.tie?'<button class=\"btn ghost\" data-v=\"'+esc(t.tie.value)+'\">'+esc(t.tie.text||'Same level')+'</button>':'')+\n      '<button class=\"btn\" data-v=\"'+esc(t.im[1].value)+'\">Image B is more comfortable</button></div>'+\n      '<details><summary>Rating guideline</summary>'+GUIDE+'</details>'+\n      (i>0?'<div class=\"row\"><button class=\"btn ghost\" id=\"back\">Back</button></div>':'')+'<div class=\"err\"></div>';\n    app.querySelectorAll('[data-v]').forEach(function(b){b.onclick=function(){var k=i;app.querySelectorAll('[data-v]').forEach(function(x){x.disabled=true;});\n      SPSite.answer('more_comfortable',b.getAttribute('data-v'),{trial:k}).then(function(r){\n        if(r&&r.ok===false){err(r.error);app.querySelectorAll('[data-v]').forEach(function(x){x.disabled=false;});return;}\n        done[k]=true;i=k+1;show();});};});\n    var bk=document.getElementById('back');if(bk)bk.onclick=function(){i-=1;show();};\n    window.scrollTo(0,0);\n  }\n  function about(){\n    var q=SPSite.getQuestion('macau_familiarity');\n    app.innerHTML='<h1>One last question</h1><div class=\"card\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"fam\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+\n      '<div class=\"row\"><button class=\"btn\" id=\"finish\">Finish</button></div><div class=\"err\"></div></div>';\n    app.querySelectorAll('input[name=fam]').forEach(function(r){r.onchange=function(){SPSite.answer('macau_familiarity',r.value).then(function(x){if(x&&x.ok===false)err(x.error);});};});\n    document.getElementById('finish').onclick=function(){var btn=this;btn.disabled=true;err('Submitting…');\n      SPSite.complete().then(function(r){if(r&&r.ok===false){btn.disabled=false;var m=r.missing||[];err(r.error||('Please answer: '+m.join(', ')));if(m.indexOf('consent')>=0)intro();else if(m.indexOf('more_comfortable')>=0){i=firstOpen();show();}}});};\n    window.scrollTo(0,0);\n  }\n  SPSite.onReady(function(ctx){\n    Q=SPSite.getQuestion('more_comfortable');\n    var a=(ctx&&ctx.answers)||{},p=a.more_comfortable,list=p&&Array.isArray(p.trials)?p.trials:(Array.isArray(p)?p:[]);\n    list.forEach(function(t,k){var v=t&&typeof t==='object'?t.value:t;if(v!=null&&v!=='')done[k]=true;});\n    if(a.consent===true){i=firstOpen();show();}else intro();\n  });\n})();\n</script>\n</body>\n</html>\n",
