   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Facade Composition Regularity</title>\n<script type=\"application/json\" id=\"sp-scheme\">\n{\n \"format\": \"sp-scheme-package\",\n \"spScheme\": \"2.0\",\n \"survey\": {\n  \"title\": \"Facade Composition Regularity\",\n  \"description\": \"Faithful replication with the original images: twelve abstract graphics of black rectangles on a white background, made by the authors to stand for the six types of facade composition (A-F) of contemporary Polish multifamily residential buildings, two examples per type (A1, A2 ... F1, F2); type A is a fully even grid and type F has elements of varied sizes with random spacing. As in the paper's online questionnaire, participants go through four sets of six graphics, each set showing one example of each composition type at the same time in the order of the paper's Table 1, and rate each graphic on a 6-point scale from 1 (the most irregular) to 6 (the most regular), so that each graphic is rated twice. Gender, age and education are asked at the end. Rebuilt from Malewczyk, Taraszkiewicz & Czyż (2024), Visual Perception of Regularity and the Composition Pattern Type of the Facade, Buildings 14(5): 1389, with the graphics cropped from its Figures 2-7 and the set order and scale from its Section 2.2 and Table 1 (CC BY 4.0). Image ids: A1-F2; answers are in regularity, keyed by set and graphic (e.g. s1_A1 for set 1, graphic A1). Analysis as in the paper: one-way ANOVA of the regularity rating by composition type and by graphic with Dunnett's T3 post hoc tests, mean ratings per type, and a repeated-measures GLM for the two ratings of each graphic; the paper (48 first-year architecture and spatial management students in Gdańsk, Cronbach's alpha .93 over the 24 ratings) found type A rated most regular (M = 5.84), then C (5.16), B (4.05) and D (3.70), which did not differ significantly, E (2.23) and F least regular (1.40). Differences from the original study: (1) the paper ran on QuestionPro for students of one faculty; here anyone can take part; (2) the question wording, the instruction text and the gender, age and education questions are ours (the paper says only that these three were asked); (3) the set order follows Table 1 as printed, in which B2 appears three times and B1 once although the text says each graphic was rated twice; (4) the graphics are the figure copies, cropped to the rectangles and re-centred on a white square, not the 1200 x 1200 px originals.\",\n  \"locale\": \"en\",\n  \"mediaFolders\": [\n   \"compositions\"\n  ],\n  \"pages\": [\n   {\n    \"name\": \"start\",\n    \"elements\": [\n     {\n      \"type\": \"consent\",\n      \"name\": \"consent\",\n      \"title\": \"I agree to take part. Participation is voluntary and my answers are recorded anonymously for research.\",\n      \"isRequired\": true,\n      \"labelTrue\": \"I agree\",\n      \"labelFalse\": \"I do not agree\"\n     }\n    ]\n   },\n   {\n    \"name\": \"sets\",\n    \"elements\": [\n     {\n      \"type\": \"rating\",\n      \"name\": \"regularity\",\n      \"title\": \"How regular is this composition?\",\n      \"isRequired\": true,\n      \"rateValues\": [\n       {\n        \"value\": 1,\n        \"text\": \"Most irregular\"\n       },\n       {\n        \"value\": 2,\n        \"text\": \"2\"\n       },\n       {\n        \"value\": 3,\n        \"text\": \"3\"\n       },\n       {\n        \"value\": 4,\n        \"text\": \"4\"\n       },\n       {\n        \"value\": 5,\n        \"text\": \"5\"\n       },\n       {\n        \"value\": 6,\n        \"text\": \"Most regular\"\n       }\n      ],\n      \"description\": \"Keyed by set and graphic id, e.g. s1_A1.\"\n     }\n    ]\n   },\n   {\n    \"name\": \"about\",\n    \"elements\": [\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"gender\",\n      \"title\": \"Gender\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"female\",\n        \"text\": \"Female\"\n       },\n       {\n        \"value\": \"male\",\n        \"text\": \"Male\"\n       },\n       {\n        \"value\": \"other\",\n        \"text\": \"Other / prefer not to say\"\n       }\n      ]\n     },\n     {\n      \"type\": \"text\",\n      \"name\": \"age\",\n      \"inputType\": \"number\",\n      \"title\": \"Age (years)\",\n      \"isRequired\": true,\n      \"min\": 16,\n      \"max\": 100\n     },\n     {\n      \"type\": \"radiogroup\",\n      \"name\": \"education\",\n      \"title\": \"Highest completed education\",\n      \"isRequired\": true,\n      \"choices\": [\n       {\n        \"value\": \"Primary\",\n        \"text\": \"Primary\"\n       },\n       {\n        \"value\": \"Secondary\",\n        \"text\": \"Secondary\"\n       },\n       {\n        \"value\": \"Higher (university)\",\n        \"text\": \"Higher (university)\"\n       }\n      ]\n     }\n    ]\n   }\n  ]\n }\n}\n</script>\n<script type=\"application/json\" id=\"regularity-original\">{\"source\": \"Malewczyk, Taraszkiewicz & Czyż (2024) Buildings 14: 1389\", \"n\": 48, \"sets\": [[\"A1\", \"C2\", \"F1\", \"B2\", \"D2\", \"E1\"], [\"E2\", \"A2\", \"C1\", \"F2\", \"B2\", \"D1\"], [\"E1\", \"B2\", \"C1\", \"A1\", \"D2\", \"F2\"], [\"C2\", \"F1\", \"D1\", \"A2\", \"E2\", \"B1\"]], \"type_means\": {\"A\": 5.842, \"B\": 4.054, \"C\": 5.163, \"D\": 3.696, \"E\": 2.228, \"F\": 1.402}}</script>\n<style>\n:root{--bg:#f0f1f4;--card:#fff;--ink:#1c1f26;--muted:#5b616d;--accent:#3a4f7a;--line:#d7dbe3;--warn:#b3261e;--sel:#e1e7f3}\n*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:1100px;margin:0 auto;padding:22px 16px 40px}\nh1{font-size:1.5rem;margin:0 0 8px}h2{font-size:1.15rem;margin:0 0 6px}p{margin:0 0 12px;color:var(--muted)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}\n.btn{appearance:none;border:0;border-radius:10px;padding:13px 20px;font:inherit;font-weight:600;cursor:pointer;background:var(--accent);color:#fff}\n.btn:disabled{opacity:.35;cursor:not-allowed}\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;margin-top:14px}\n.b{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px}\n.b img{width:100%;height:auto;display:block;border-radius:8px}\n.b .no{font-weight:700;margin:6px 0 4px}\n.o{display:grid;grid-template-columns:repeat(6,1fr);gap:3px}\n.o label{display:flex;flex-direction:column;align-items:center;gap:2px;border:1px solid var(--line);border-radius:8px;padding:5px 1px;cursor:pointer;font-size:.68rem;line-height:1.15;text-align:center;color:var(--muted)}\n.o label b{font-size:.95rem;color:var(--ink)}\n.o label:has(input:checked){background:var(--sel);border-color:var(--accent);color:var(--ink)}\n.o input{display:none}\n.b.miss{outline:2px solid var(--warn);outline-offset:2px}\n.blk{margin-top:14px}.blk:first-child{margin-top:0}\n.blk.miss{outline:2px solid var(--warn);outline-offset:4px;border-radius:8px}\nlabel.opt{display:flex;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer}\nlabel.opt:has(input:checked){background:var(--sel);border-color:var(--accent)}\n.err{color:var(--warn);margin-top:8px;min-height:1.2em}\n.credit{max-width:1100px;margin:0 auto;padding:0 16px 24px;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<main id=\"app\" aria-live=\"polite\"><p>Loading…</p></main>\n<footer class=\"credit\">Graphics, set order and scale: Malewczyk, Taraszkiewicz &amp; Czyż (2024), Buildings 14(5): 1389, Figures 2–7 and Table 1 (doi:10.3390/buildings14051389, CC BY 4.0).</footer>\n<script>\n(function(){\n  var KEY='facade-regularity:state', ORIG=JSON.parse(document.getElementById('regularity-original').textContent), SETS=ORIG.sets, BG=['gender','age','education'];\n  var app=document.getElementById('app'), Q={}, files={}, st=null;\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function err(m){var e=app.querySelector('.err');if(e)e.textContent=m||'';}\n  function ok(r){return !(r&&r.ok===false);}\n  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}\n  function send(list,b,next){if(b)b.disabled=true;Promise.all(list).then(function(rs){var bad=rs.filter(function(r){return !ok(r);})[0];if(bad){if(b)b.disabled=false;return err(bad.error);}next();});}\n  function intro(){\n    app.innerHTML='<h1>Regularity of facade compositions</h1><p>You will see four sets of six simple black-and-white graphics. Each graphic stands for the way windows, balconies and other elements can be arranged on the facade of an apartment building. Rate how regular each composition looks, from 1 (the most irregular) to 6 (the most regular). There are no right or wrong answers. It takes about 4 minutes.</p>'+\n     '<div class=\"card\"><label class=\"opt\" style=\"margin-top:0\"><input type=\"checkbox\" id=\"ok\"> '+esc(Q.consent.title)+'</label><div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Start</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){if(!document.getElementById('ok').checked)return err('Consent is needed to continue.');\n      send([SPSite.answer('consent',true)],this,function(){st.step='set';st.set=0;save();route();});};\n  }\n  function setPage(){\n    var q=Q.regularity,sc=q.rateValues||[],k=st.set,ids=SETS[k],r=st.r||(st.r={});\n    app.innerHTML='<h2>Set '+(k+1)+' of '+SETS.length+'</h2><p>'+esc(q.title)+' Rate each graphic from 1 (the most irregular) to 6 (the most regular).</p><div class=\"grid\">'+ids.map(function(id,i){var key='s'+(k+1)+'_'+id;\n      return '<div class=\"b\" data-k=\"'+key+'\"><img alt=\"Composition '+(i+1)+'\" src=\"'+esc(files[id].url)+'\"><div class=\"no\">Graphic '+(i+1)+'</div><div class=\"o\">'+sc.map(function(s){return '<label><input type=\"radio\" name=\"r_'+key+'\" value=\"'+s.value+'\"'+(r[key]==s.value?' checked':'')+'><b>'+s.value+'</b>'+(s.value==1||s.value==6?esc(s.text):'&nbsp;')+'</label>';}).join('')+'</div></div>';}).join('')+\n      '</div><div class=\"card\"><button class=\"btn\" id=\"go\">'+(k<SETS.length-1?'Next set':'Continue')+'</button><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){\n      var miss=[],L=[];\n      ids.forEach(function(id){var key='s'+(k+1)+'_'+id,x=app.querySelector('input[name=\"r_'+key+'\"]:checked');if(x)r[key]=Number(x.value);else miss.push(app.querySelector('.b[data-k=\"'+key+'\"]'));});\n      save();\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});miss[0].scrollIntoView({block:'center'});return err('Please rate all six graphics.');}\n      ids.forEach(function(id){var key='s'+(k+1)+'_'+id;L.push(SPSite.answer('regularity',r[key],{key:key,shown:[files[id].name]}));});\n      send(L,this,function(){if(k<SETS.length-1){st.set=k+1;}else st.step='about';save();route();});};\n  }\n  function about(){\n    app.innerHTML='<h2>About you</h2><div class=\"card\">'+BG.map(function(n){var q=Q[n];\n      if(q.type==='text')return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b><div><input type=\"number\" inputmode=\"numeric\" min=\"'+(q.min||0)+'\" max=\"'+(q.max||120)+'\" id=\"in_'+n+'\" style=\"font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:10px;margin-top:6px;width:9em\"></div></div>';\n      return '<div class=\"blk\" data-n=\"'+n+'\"><b>'+esc(q.title)+'</b>'+(q.choices||[]).map(function(c){return '<label class=\"opt\"><input type=\"radio\" name=\"'+n+'\" value=\"'+esc(c.value)+'\"> '+esc(c.text)+'</label>';}).join('')+'</div>';}).join('')+\n      '<div style=\"margin-top:16px\"><button class=\"btn\" id=\"go\">Finish</button></div><div class=\"err\"></div></div>';\n    document.getElementById('go').onclick=function(){var L=[],miss=[];\n      BG.forEach(function(n){var q=Q[n];\n        if(q.type==='text'){var v=Number((document.getElementById('in_'+n)||{}).value);if(v>=(q.min||0)&&v<=(q.max||120)&&String(v)!=='0')L.push(SPSite.answer(n,v));else miss.push(app.querySelector('.blk[data-n=\"'+n+'\"]'));return;}\n        var x=app.querySelector('input[name=\"'+n+'\"]:checked');if(x)L.push(SPSite.answer(n,x.value));else miss.push(app.querySelector('.blk[data-n=\"'+n+'\"]'));});\n      if(miss.length){miss.forEach(function(el){el.classList.add('miss');});return err('Please answer all three questions (age as a number from 16 to 100).');}\n      send(L,this,function(){st.step='done';save();route();});};\n  }\n  function finish(){\n    app.innerHTML='<h1>Thank you!</h1><div class=\"card\"><p id=\"fin\">Submitting…</p><div class=\"err\"></div></div>';\n    SPSite.complete().then(function(r){if(!ok(r)){err(r.error||'Some answers are missing.');setTimeout(function(){st.step='intro';save();route();},1800);}\n      else{try{localStorage.removeItem(KEY);}catch(e){}var s=document.getElementById('fin');if(s)s.textContent='Your answers are saved.';}});\n  }\n  app.addEventListener('input',function(e){var r=e.target.closest&&e.target.closest('.blk');if(r){r.classList.remove('miss');}});\n  app.addEventListener('change',function(e){var r=e.target.closest&&e.target.closest('.b,.blk');if(r){r.classList.remove('miss');if(!app.querySelector('.miss'))err('');}\n    if(e.target.name&&/^r_/.test(e.target.name)){st.r=st.r||{};st.r[e.target.name.slice(2)]=Number(e.target.value);save();}});\n  function route(){var s=st.step;window.scrollTo(0,0);if(s==='set')return setPage();if(s==='about')return about();if(s==='done')return finish();intro();}\n  SPSite.onReady(function(ctx){if(!SPSite.__nm){SPSite.__nm=1;var _gm=SPSite.getMedia;SPSite.getMedia=function(){var r=_gm.apply(SPSite,arguments),fx=function(m){if(!m||!m.name)return m;var c={},k;for(k in m)c[k]=m[k];c.name=String(m.name).replace(/__[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(\\.[A-Za-z0-9]+)$/i,'$1');return c;};if(Array.isArray(r))return r.map(fx);if(r&&typeof r==='object'){var o={},k;for(k in r)o[k]=(r[k]||[]).map(fx);return o;}return r;};}(SPSite.getQuestions()||[]).forEach(function(q){if(q.type==='number'){q.type='text';q.inputType='number';}if(q.isRequired==null)q.isRequired=!!q.required;});\n    ['consent','regularity'].concat(BG).forEach(function(n){Q[n]=SPSite.getQuestion(n)||{};});\n    (SPSite.getMedia('compositions')||[]).forEach(function(f){files[f.name.replace(/\\.[^.]+$/,'')]=f;});\n    var all=['A1','A2','B1','B2','C1','C2','D1','D2','E1','E2','F1','F2'],need=all.filter(function(k){return !files[k];});\n    if(need.length){app.innerHTML='<h1>Images missing</h1><p>Upload '+esc(need.join(', '))+' (.png) to the media folder \"compositions\".</p>';return;}\n    try{st=JSON.parse(localStorage.getItem(KEY));}catch(e){st=null;}\n    var a=(ctx&&ctx.answers)||{};\n    if(!(st&&st.step)||a.consent!==true)st={step:'intro'};\n    save();route();\n  });\n})();\n</script>\n</body>\n</html>\n",
